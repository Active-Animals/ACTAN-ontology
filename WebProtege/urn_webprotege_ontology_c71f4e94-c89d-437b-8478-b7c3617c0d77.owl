        <oboInOwl:creation_date>2024-09-23T20:54:25.455051Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym xml:lang="en">facilitating</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Engineering in which one species alters conditions in a manner that improves the opportunities for another.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">facilitation engineering</rdfs:label>
