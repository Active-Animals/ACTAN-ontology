    <!-- http://purl.obolibrary.org/obo/ACTAN_0000992 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000992">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000455"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000801"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-21T11:23:45.363595Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Constraint that drives another animal out of an aggregation.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>isolating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>isolation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">isolation constraint</rdfs:label>
        <skos:example>&quot;...the flock of teal may release sham attacks by the falcon, resulting in the isolation of a member of the flock.&quot;</skos:example>
        <skos:example>&quot;Thalassoma cupido...
Pair formation begins when the male encounters a female or isolates one by chasing and driving her into the algae.&quot;</skos:example>
        <skos:scopeNote>&quot;For most group-living organisms, social isolation results in stress, which manifests itself in various ways.&quot;</skos:scopeNote>
    </owl:Class>
