    <!-- http://purl.obolibrary.org/obo/ACTAN_0000072 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000203"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000199"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000736"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000058"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000138"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-01-21T16:32:12.545129Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Trot gait that realizes an octapedal pattern.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>alternating tetrapod trotting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>alternating tetrapod slow running</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">alternating-tetrapod-trot gait</rdfs:label>
        <skos:example>&quot;...the ghost crab Ocvpode quadrata (Fabricius)... during sideways locomotion... used a bouncing gait during locomotion at speeds greater than 0.4 m/s... The transition from a slow run to a fast run occurs at nearly the same speed and frequency as the trot-gallop transition in quadrupeds.&quot;</skos:example>
        <skos:scopeNote>&quot;The symmetrical footfall pattern (alternating tetrapod), the linear increase in stride frequency with speed, as well as the time course of the ground reaction force, match the pattern typical of trotting quadrupeds. Crabs obviously can change to a running or bouncing gait, even though no aerial phases are present.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000072"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Trot gait that realizes an octapedal pattern.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.130.1.155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000072"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>alternating tetrapod trotting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1987</dc:date>
        <dc:source>doi:10.1242/jeb.130.1.155</dc:source>
    </owl:Axiom>
