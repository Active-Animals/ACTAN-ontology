        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/group_behaviour"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-27T09:18:45.735896Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Dissociation in which multiple animals move away from each other.

They may reaggregate later.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">asocial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>disaggregating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">dispersal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>scattering</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spreading out</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>anti-social</oboInOwl:hasNarrowSynonym>
        <rdfs:label>dis-aggregation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000376"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000927"/>
        <skos:example>&quot;Haemulon striatum... forage in diurnal schools. At night, schools of these species disperse and individuals are found in resting states among the reef features, or elsewhere on the bottom.&quot;</skos:example>
        <skos:example>&quot;In the solitary phase, individual locusts are asocial and avoid each other.&quot;</skos:example>
        <skos:example>&quot;Life history of C. horridus necessitates large tracts of forest to accommodate seasonal dispersal movements (of up to 7 km) to and from overwintering sites.&quot;</skos:example>
    </owl:Class>
