        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-27T17:16:10.644337Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Stepping gait which is irregular, non-suspensory, and the body is pronograde.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>pronograde clamber</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">scrambling</oboInOwl:hasExactSynonym>
        <rdfs:label>scramble gait</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000728"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000729"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Stepping gait which is irregular, non-suspensory, and the body is pronograde.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/BF02381373</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Scramble (= pronograde clamber): torso-pronograde ( - ) , nonsuspensory quadrupedal progression lacking a regular gait.&quot;</skos:scopeNote>
    </owl:Axiom>
