    <!-- http://purl.obolibrary.org/obo/ACTAN_0000611 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000611">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000609"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000828"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-17T16:01:36.205702Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Groom in which another is enabled to provide the service.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>invitation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>presentation</oboInOwl:hasExactSynonym>
        <rdfs:label>invitation groom</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000613"/>
        <skos:example>&quot;The assumptions of the model were explicitly based on marine cleaning mutualism involving the cleaner wrasse Labroides dimidiatus (the service provider), which feeds on the ectoparasites of other reef fishes (the clients).&quot;</skos:example>
        <skos:example>&quot;Two Whistling Ducks may be preening normally side by side when one will approach the other and either begin nibbling the other&apos;s head or present its own head to be nibbled. In the posture of presentation, the eyes are partly or completely closed and the head is stretched out toward the other bird and held rigid in one position.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000611"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Groom in which another is enabled to provide the service.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/beheco/aru194</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000611"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>invitation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000611"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>presentation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
