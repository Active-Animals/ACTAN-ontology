    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000437"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Many birds have song flights and elaborate aerial displays, including the roding display of the Eurasian woodcock (Scolopax rusticola), the dive and shuttle of Anna’s hummingbird (Calypte anna), and the sky dancing of the Montagu’s harrier (Circus pygargus).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/978-3-319-68576-2_3</dc:source>
    </owl:Axiom>
