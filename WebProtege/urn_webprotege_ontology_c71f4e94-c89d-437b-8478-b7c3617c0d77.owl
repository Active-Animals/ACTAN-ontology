    <!-- http://purl.obolibrary.org/obo/ACTAN_0000891 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000891">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000832"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000860"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-19T16:24:56.974594Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Affiliation that carries out exaggerated contact movements without inflicting damage on the other.

This can look like fighting.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">skirmishing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>affiliative biting</oboInOwl:hasNarrowSynonym>
        <rdfs:label>skirmish affiliation</rdfs:label>
        <skos:example>&quot;Cochlasoma severum...
The fishes are constantly skirmishing with each other, carrying out exaggerated butting, biting and tail beating movements without inflicting the slightest damage on each other. When one of them behaves in such an &quot;aggressive&quot; way the other begins to quiver vigorously.&quot;</skos:example>
        <skos:scopeNote>&quot;Pair-bonded fish exhibit several affiliative behaviors. In cichlids, pair-bonded individuals display parallel swimming, tail beating, circling, greeting, and affiliative bites.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000891"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Affiliation that carries out exaggerated contact movements without inflicting damage on the other.

This can look like fighting.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000891"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">skirmishing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000891"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>affiliative biting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:date>
        <dc:source>doi:10.1016/j.yhbeh.2021.105062</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000891"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>skirmish affiliation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000891"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Cochlasoma severum...
The fishes are constantly skirmishing with each other, carrying out exaggerated butting, biting and tail beating movements without inflicting the slightest damage on each other. When one of them behaves in such an &quot;aggressive&quot; way the other begins to quiver vigorously.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
