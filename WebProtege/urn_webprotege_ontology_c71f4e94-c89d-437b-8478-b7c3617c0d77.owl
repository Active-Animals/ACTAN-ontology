    <!-- http://purl.obolibrary.org/obo/ACTAN_0000104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-17T13:10:10.963504Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that moves an object across another.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>rub</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">rubbing</oboInOwl:hasExactSynonym>
        <rdfs:label>rub kinetics</rdfs:label>
        <skos:example>&quot;Tail rubbing, a behavior found only in large-bodied rattlesnakes, was mostly performed by gravid females. This behavior is associated with cloacal sac discharge and its function appears to be to spread exudates over the body of the snake.&quot;</skos:example>
        <skos:scopeNote>&quot;Occasionally, when a duck appears to have an irritation about the head, it will rub its cheek on its shoulder.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Rub muzzle stained with fruit juice against a shrub, grass stalk, slender vine, or bark of tree or stone in order to wipe off the mess.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The pectoral fins can be rubbed against the body in various ways;&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000104"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics that moves an object across another.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
