        <owl:annotatedTarget xml:lang="en">allogroom cooperation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000582"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The preening is not confined to members of a pair; occasionally three individuals preen one another simultaneously, and interspecific nibbling has been seen between Cuban and White-faced Whistling Ducks...

Preening of the young has been noted in a female Cereopsis. on several occasions this bird nibbled at the backs of her goslings, which were feathered and about three-quarters adult size.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000582"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The social primates are also characterized by complex activities affecting social competition (e.g., social grooming, play, threat, and the establishment of alliances)...&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000583 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000583">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000338"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0008306"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-07T21:23:01.29703Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Experience which has learned to connect costs and benefits to a specific cue.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">associating</oboInOwl:hasExactSynonym>
        <rdfs:label>association experience</rdfs:label>
        <skos:relatedMatch>NBO:0000171</skos:relatedMatch>
        <skos:scopeNote>&quot;An aposematic signal is a form of communication, or advertisement, to a predator or other aggressor that there is a net cost for interference with the signaler. In this way, the predator learns to associate the aposematic cue with a painful experience and will in the future avoid animals that exhibit that signal.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000583"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Experience which has learned to connect costs and benefits to a specific cue.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000583"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">associating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000583"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>association experience</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000583"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;An aposematic signal is a form of communication, or advertisement, to a predator or other aggressor that there is a net cost for interference with the signaler. In this way, the predator learns to associate the aposematic cue with a painful experience and will in the future avoid animals that exhibit that signal.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000584 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000708"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000847"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-05T19:33:38.163746Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Comfort in which gaping precedes the mouth shutting, as the floor of the mouth is depressed and recovered.

In fishes, the operculae are then adducted; the whole sequence is rapid and passes a large volume of water quickly from the mouth out through the gills.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">yawning</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>intention yawning</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>jaw-stretch</oboInOwl:hasRelatedSynonym>
        <rdfs:label>yawn comfort</rdfs:label>
        <skos:closeMatch>NBO:0000074</skos:closeMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000584"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Comfort in which gaping precedes the mouth shutting, as the floor of the mouth is depressed and recovered.

In fishes, the operculae are then adducted; the whole sequence is rapid and passes a large volume of water quickly from the mouth out through the gills.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000584"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">yawning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000584"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>intention yawning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
        <skos:scopeNote>&quot;Intention yawning, consisting of slight gaping... may precede complete yawning.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000584"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>jaw-stretch</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000584"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>yawn comfort</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000585 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000585">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000318"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-08T16:19:02.17755Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Look in which a moving object across the visual field triggers an eye to have a smooth pursuit movement following the object, and a fast saccadic movement resetting the eyes after the object has left the visual field.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">opto-kinetic-reflex</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">tracking look</rdfs:label>
        <skos:closeMatch>NBO:0000574</skos:closeMatch>
        <skos:example>&quot;Even post-larvae, which have been swimming well for only a few days, have been observed to turn the head to one side and fix on tiny moving particles.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000585"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Look in which a moving object across the visual field triggers an eye to have a smooth pursuit movement following the object, and a fast saccadic movement resetting the eyes after the object has left the visual field.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;(OKR): Stereotyped tracking eye movements triggered by moving objects across the visual field. Has two components: a smooth pursuit movement following the object, and a fast saccadic movement resetting the eyes after the object has left the visual field.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000585"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">opto-kinetic-reflex</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000585"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">tracking look</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000585"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Even post-larvae, which have been swimming well for only a few days, have been observed to turn the head to one side and fix on tiny moving particles.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000586 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000586">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000745"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000689"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-08T16:48:14.781315Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>eye tracking</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>visual tracking</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Conjugation in which slower tracking of the eyes keeps a stimulus on the fovea.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">smooth pursuit</oboInOwl:hasExactSynonym>
        <rdfs:label>smooth-pursuit conjugation</rdfs:label>
        <skos:example>&quot;Parotia carolae...
While a male displays below, the female looks on from the main court perch and closely follows the movements of the male.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000586"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>eye tracking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>https://core.ac.uk/download/pdf/85255156.pdf</dc:source>
        <skos:scopeNote>&quot;...the pursuit phase of eye tracking movements...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000586"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>visual tracking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>https://core.ac.uk/download/pdf/85255156.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000586"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Conjugation in which slower tracking of the eyes keeps a stimulus on the fovea.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.ncbi.nlm.nih.gov/books/NBK10991/</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Smooth pursuit movements are much slower tracking movements of the eyes designed to keep a moving stimulus on the fovea.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000586"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">smooth pursuit</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>https://www.ncbi.nlm.nih.gov/books/NBK10991/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000586"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>smooth-pursuit conjugation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000586"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Parotia carolae...
While a male displays below, the female looks on from the main court perch and closely follows the movements of the male.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/auk/123.4.967</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000587 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000587">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000368"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002104"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-08T21:20:59.962879Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Taxis that responds to light.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>photokinesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>dark avoidant</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>dark preference</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>light avoidant</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>light seeking</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">scotophobia</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">scototaxis</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>ultraviolet avoidant</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">photo-taxis</rdfs:label>
        <skos:closeMatch>NBO:0000383</skos:closeMatch>
        <skos:example>&quot;Zebrafish display sensitivity to visible light (positive phototaxis in larval fish...)&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000587"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Taxis that responds to light.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Photokinesis (phototaxis): General movement in response to light, including positive (light seeking/dark avoidance, scotophobia) and negative (light avoidance, dark preference, scototaxis).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000587"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>photokinesis</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
