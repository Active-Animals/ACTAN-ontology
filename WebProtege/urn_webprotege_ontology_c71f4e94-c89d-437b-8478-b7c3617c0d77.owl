    <!-- http://purl.obolibrary.org/obo/ACTAN_0000925 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000925">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001961"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-11-16T11:40:06.767597Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement in which a surface becomes apposed to another.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">apposing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>contact</oboInOwl:hasExactSynonym>
        <rdfs:label>contacting movement</rdfs:label>
        <skos:example>&quot;Nocomis leptocephalus...
As her snout approached vertical she rolled the anterior portion of her body away from the male placing her dorsum in contact with his anterior flank.&quot;</skos:example>
        <skos:example>&quot;Nocomis leptocephalus...
Her snout traversed a 45[degree] arc as the side of her head apposed either the male’s operculum or his anterior flank just above the pectoral fin.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000925"/>
