    <!-- http://humanbehaviourchange.org/ontology/BCIO_050783 -->

    <owl:Class rdf:about="http://humanbehaviourchange.org/ontology/BCIO_050783">
        <obo:IAO_0000112>a loud noise, the sight of a treadmill, the picture of specific foods</obo:IAO_0000112>
        <obo:IAO_0000114>Published</obo:IAO_0000114>
        <obo:IAO_0000115>An &lt;entity&gt; that acts as an input to a perceptual process leading to a thought, feeling or action.</obo:IAO_0000115>
        <rdfs:comment>A stimulus can be naturally occurring or used as component of Behaviour Change Techniques (BCTs). These are part of learning processes and operationalized as part of BCTs.</rdfs:comment>
        <rdfs:label>stimulus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000541"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001561"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-08T20:10:44.888759Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Switch that mitigates against a pressure.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym xml:lang="en">compensation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>neutralising</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">compensation switch</rdfs:label>
        <skos:example>&quot;For example, strategic allocation of courtship effort is observed in male wolf spiders, Schizocosa ocreata, that miss one or two of their forelegs. These males seem to compensate for their lower condition by increasing their courtship displays in comparison to intact males, but they do it more often in response to the draglines of young, receptive females than to those of old, less receptive females.&quot;</skos:example>
        <skos:scopeNote>&quot;...the transverse gallop is the only gallop used at slow rates of travel when other sources of stability must compensate for reduced dynamic stability.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Buoyancy control during ASR [aquatic surface respiration] allows fish to optimize their position (benthic species) or swimming mode (midwater species) and to compensate for O2 loss from the swimbladder (which decreases in volume) that occurs during hypoxic stress.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;prey may be capable of compensating for reduced information via one sensory modality by increasing their reliance on other modalities&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Switch that mitigates against a pressure.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1146/annurev-ecolsys-102209-144712</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Parental compensation hypothesis: when nest concealment alone is insufficient to mitigate against predation pressure, parents compensate for remaining risk by their presence at the nest via plumage camouflage, antipredator behavior, etc.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">compensation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>neutralising</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">compensation switch</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;For example, strategic allocation of courtship effort is observed in male wolf spiders, Schizocosa ocreata, that miss one or two of their forelegs. These males seem to compensate for their lower condition by increasing their courtship displays in comparison to intact males, but they do it more often in response to the draglines of young, receptive females than to those of old, less receptive females.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s00265-010-0980-6</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...the transverse gallop is the only gallop used at slow rates of travel when other sources of stability must compensate for reduced dynamic stability.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Buoyancy control during ASR [aquatic surface respiration] allows fish to optimize their position (benthic species) or swimming mode (midwater species) and to compensate for O2 loss from the swimbladder (which decreases in volume) that occurs during hypoxic stress.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.198.1.79</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;prey may be capable of compensating for reduced information via one sensory modality by increasing their reliance on other modalities&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1238167</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://humanbehaviourchange.org/ontology/BCIO_050783"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-12-08T15:54:02.275571Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Behaviour is: the internally coordinated responses (actions or inactions) of whole living organisms (individuals or groups) to internal and/or external stimuli, excluding responses more easily understood as developmental changes.

While behaviours necessarily rely upon internal information processing by the individual (e.g. cognition and endocrine signalling) we do not consider the processing alone to be a response, and therefore do not include it as behaviour.

In more complex animals, whole organism responses are generally mediated through the central nervous system, and this is often how a strictly physiological process can be transformed into some behaviour.

Often organismal movements and other positive responses are clues that whole body coordination has occurred. However, inactions can also be considered behaviours in some situations. In such cases, this inaction must still be coordinated on the level of the organism.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>behavior</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">behaviour</rdfs:label>
        <skos:closeMatch>NBO:0000313</skos:closeMatch>
        <skos:example>&quot;I allowed an ant to visit them, and it immediately seemed, by its eager way of running about, to be well aware what a rich flock it had discovered; it then began to play with its antennæ on the abdomen first of one aphis and then of another; and each aphis, as soon as it felt the antennæ, immediately lifted up its abdomen and excreted a limpid drop of sweet juice, which was eagerly devoured by the ant. Even the quite young aphides behaved in this manner, showing that the action was instinctive, and not the result of experience.&quot;</skos:example>
        <skos:narrowMatch>GO:0007610</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000002"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Behaviour is: the internally coordinated responses (actions or inactions) of whole living organisms (individuals or groups) to internal and/or external stimuli, excluding responses more easily understood as developmental changes.

While behaviours necessarily rely upon internal information processing by the individual (e.g. cognition and endocrine signalling) we do not consider the processing alone to be a response, and therefore do not include it as behaviour.

In more complex animals, whole organism responses are generally mediated through the central nervous system, and this is often how a strictly physiological process can be transformed into some behaviour.

Often organismal movements and other positive responses are clues that whole body coordination has occurred. However, inactions can also be considered behaviours in some situations. In such cases, this inaction must still be coordinated on the level of the organism.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1016/j.anbehav.2009.03.018</rdfs:isDefinedBy>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000002"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>behavior</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1976</dc:date>
        <dc:source>doi:10.1111/j.1439-0310.1976.tb00970.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000002"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">behaviour</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000002"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;I allowed an ant to visit them, and it immediately seemed, by its eager way of running about, to be well aware what a rich flock it had discovered; it then began to play with its antennæ on the abdomen first of one aphis and then of another; and each aphis, as soon as it felt the antennæ, immediately lifted up its abdomen and excreted a limpid drop of sweet juice, which was eagerly devoured by the ant. Even the quite young aphides behaved in this manner, showing that the action was instinctive, and not the result of experience.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001230"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-12-27T17:31:53.688542Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that involves sudden, rapid, simultaneous, strong, large amplitude movements.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>explosive acceleration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">launch</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>beat</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>kick</oboInOwl:hasNarrowSynonym>
        <rdfs:label>launch kinetics</rdfs:label>
        <skos:example>&quot;During fast displacements spiders did not maintain a constant speed. An explosive acceleration usually characterise the first stride, with the speed constantly decreasing thereafter.&quot;</skos:example>
        <skos:example>&quot;`Ed Mitchell of Apollo 14 and Gene Cernan on Apollo 17 favoured a skipping stride in which they kept one foot always forward, let&apos;s say the left and, as they landed, hit with the trailing foot just a fraction of a second before the leading foot, pushing off with each foot as it hit and launching into the next glide.&quot;</skos:example>
        <skos:scopeNote>&quot;Strikes launched without a brace point, usually from mid- or underwater, exhibited straightening and forward displacement of the anterior two-thirds of the trunk and straightening and backwards displacement of the posterior one-third. When the snake was able to brace a portion of its body against an object in the tank, backwards displacement of the posterior trunk was not observed.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000003"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics that involves sudden, rapid, simultaneous, strong, large amplitude movements.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1242/jeb.021360</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Kick maneuvers were characterized by sudden rapid lateral excursion of the caudal fin and were followed by a forward glide (‘kick-and-glide’)... Whereas separate intrinsic caudal muscles were active at different times during steady swimming, electromyographic recordings of kicks (from 0.4 to 0.5 s) were nearly simultaneous from all muscles. Strong activity in the FD, FV, HL, IC and SC was evident just before the large-amplitude kick.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000003"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>explosive acceleration</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2012</dc:date>
        <dc:source>doi:10.13130/biancardi-carlo-massimo_phd2012-01-31</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000003"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">launch</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>doi:10.1098/rspb.1998.0424</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000003"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>beat</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000003"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>kick</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1242/jeb.021360</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000003"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>launch kinetics</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000003"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;During fast displacements spiders did not maintain a constant speed. An explosive acceleration usually characterise the first stride, with the speed constantly decreasing thereafter.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.13130/biancardi-carlo-massimo_phd2012-01-31</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000003"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;`Ed Mitchell of Apollo 14 and Gene Cernan on Apollo 17 favoured a skipping stride in which they kept one foot always forward, let&apos;s say the left and, as they landed, hit with the trailing foot just a fraction of a second before the leading foot, pushing off with each foot as it hit and launching into the next glide.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1098/rspb.1998.0424</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000003"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Strikes launched without a brace point, usually from mid- or underwater, exhibited straightening and forward displacement of the anterior two-thirds of the trunk and straightening and backwards displacement of the posterior one-third. When the snake was able to brace a portion of its body against an object in the tank, backwards displacement of the posterior trunk was not observed.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.00424</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000051"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-12-28T20:42:55.148928Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Pedestrian mode that uses ten appendages.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>decapedalism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>decapod</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">decaped mode</rdfs:label>
        <skos:scopeNote>&quot;Although decapod crustaceans possess ten legs, only eight are usually used in locomotion. The chelae (which are legs 1 on both sides when numbered anterior to posterior) are not normally used in locomotion in decapod crustaceans.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000004"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Pedestrian mode that uses ten appendages.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000004"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>decapedalism</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2004</dc:date>
        <dc:source>https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
