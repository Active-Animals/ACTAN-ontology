        <oboInOwl:hasBroadSynonym>treating</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Technic that involves the application of a substance to an animal&apos;s own body surface.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">anointing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>anointment</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">anointment technic</rdfs:label>
        <skos:example>&quot;During this observation the adult Bronzed Grackle anointed only the wing feathers, working from the underside, assuming a hunched position.&quot;</skos:example>
    </owl:Class>
