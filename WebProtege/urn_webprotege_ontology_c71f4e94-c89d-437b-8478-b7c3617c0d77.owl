        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000052"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000796"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-01-14T10:45:07.128202Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>peristaltic crawling</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Creeping gait in which radially expanded regions anchor the organisms to the substratum while the radially contracted regions advance over the substratum.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">peristaltic-creeping gait</rdfs:label>
        <skos:example>&quot;The surface-crawling habit of L. terrestris is reflected in its morphology. For example, the bristle-like setae that provide traction for the radially expanded segments are present only on the ventral and lateral surfaces rather than uniformly around the circumference of the worm, as found in purely geophagous earthworms.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000049"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>peristaltic crawling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1242/jeb.202.6.661</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000049"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Creeping gait in which radially expanded regions anchor the organisms to the substratum while the radially contracted regions advance over the substratum.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1242/jeb.202.6.661</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Typically, the radially expanded regions anchor the organisms to the substratum while the radially contracted regions advance over the substratum.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000049"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">peristaltic-creeping gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000049"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The surface-crawling habit of L. terrestris is reflected in its morphology. For example, the bristle-like setae that provide traction for the radially expanded segments are present only on the ventral and lateral surfaces rather than uniformly around the circumference of the worm, as found in purely geophagous earthworms.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.202.6.661</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000050 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000738"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000152"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-12T08:14:56.353461Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Abducting which involves a pelvic fin.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">pelvic-fin abducting</rdfs:label>
        <skos:scopeNote>&quot;...for... similar style of active benthic foraging... in coral reef fishes... pelvic fins were the most frequently adopted fin type during behaviours involving slow-speed movement...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000050"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Abducting which involves a pelvic fin.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000050"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">pelvic-fin abducting</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000050"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...for... similar style of active benthic foraging... in coral reef fishes... pelvic fins were the most frequently adopted fin type during behaviours involving slow-speed movement...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s00227-014-2403-0</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000010"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001790"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-08T11:19:21.67384Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mode that uses appendages for supported activity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>legged</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pedestrian</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>apterous</oboInOwl:hasNarrowSynonym>
        <rdfs:label>pedestrian mode</rdfs:label>
        <skos:example>&quot;At all speeds, P. americana ran using two alternating set(s) of one, two or three legs... At speeds less than 1.0 ms&quot;1, P. americana ran using an alternating tripod stepping pattern.... P. americana attained an aerial phase at the fastest speeds (1.0-1.5ms&quot;1). High-speed video recordings (300 frames s&quot;1) showed that, at these high speeds, the insect raises its body off the substratum (from 0.5 to 1.0 cm) and increases its body&apos;s angle of attack (from 0 to 30° relative to the horizontal). In half of the high-speed runs (N=13), cockroaches used only four legs (i.e. middle and hind legs). In the other half of the high-speed runs, cockroaches ran bipedally, propelling themselves exclusively with their hind legs.&quot;</skos:example>
        <skos:scopeNote>&quot;Pedestrians that vary in leg number and design can generate similar ground reaction force patterns. Running humans, trotting dogs, cockroaches and sideways-running crabs can move their bodies by producing alternating propulsive forces. Two legs in a trotting quadrupedal mammal, three legs in an insect and four legs in a crab can act as one leg does in a biped during ground contact.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000051"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mode that uses appendages for supported activity.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000051"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>legged</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1993</dc:date>
        <dc:source>doi:10.1007/BF00197760</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000051"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pedestrian</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1991</dc:date>
        <dc:source>doi:10.1242/jeb.158.1.369</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000051"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>apterous</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1002/jmor.10788</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000051"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>pedestrian mode</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000051"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;At all speeds, P. americana ran using two alternating set(s) of one, two or three legs... At speeds less than 1.0 ms&quot;1, P. americana ran using an alternating tripod stepping pattern.... P. americana attained an aerial phase at the fastest speeds (1.0-1.5ms&quot;1). High-speed video recordings (300 frames s&quot;1) showed that, at these high speeds, the insect raises its body off the substratum (from 0.5 to 1.0 cm) and increases its body&apos;s angle of attack (from 0 to 30° relative to the horizontal). In half of the high-speed runs (N=13), cockroaches used only four legs (i.e. middle and hind legs). In the other half of the high-speed runs, cockroaches ran bipedally, propelling themselves exclusively with their hind legs.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.156.1.215</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000051"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Pedestrians that vary in leg number and design can generate similar ground reaction force patterns. Running humans, trotting dogs, cockroaches and sideways-running crabs can move their bodies by producing alternating propulsive forces. Two legs in a trotting quadrupedal mammal, three legs in an insect and four legs in a crab can act as one leg does in a biped during ground contact.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.158.1.369</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000051"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-08T11:20:53.074287Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Pedestrian mode that uses no appendages.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">limbless</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">limbless mode</rdfs:label>
        <skos:scopeNote>&quot;...a key advantage of the limbless body plan and behaviors used by snakes in cluttered arboreal habitats may be the small cross-sectional area required for moving.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000052"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Pedestrian mode that uses no appendages.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>This applies to animals which are taxonomic tetrapods, and not to soft-bodied invertebrates with hydrostatic skeltons (i.e. NOT worms or leeches).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000052"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">limbless</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000052"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">limbless mode</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000052"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...a key advantage of the limbless body plan and behaviors used by snakes in cluttered arboreal habitats may be the small cross-sectional area required for moving.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.009050</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000051"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-08T11:24:23.556432Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Pedestrian mode that uses one appendage.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">monoped</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>monopode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>monopod</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>unipedal support</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">monoped mode</rdfs:label>
        <skos:scopeNote>&quot;Therefore, hopping species can be considered functionally monopedal.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000053"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Pedestrian mode that uses one appendage.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.13130/biancardi-carlo-massimo_phd2012-01-31</dc:source>
        <rdfs:comment>This term is functional, i.e. treat bipodal hopping as functionally monpedal (or imagine a single widely bisulcate/cloven foot/hoof).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000053"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
