    <!-- http://purl.obolibrary.org/obo/ACTAN_0000201 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000207"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000304"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-03T16:28:45.87049Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Gallop gait that involves unilateral skips with 25% of the stride period being out-of-phase.

This has a triple beat.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">canter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>slow gallop</oboInOwl:hasExactSynonym>
        <rdfs:label>canter-gallop gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000201"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Gallop gait that involves unilateral skips with 25% of the stride period being out-of-phase.

This has a triple beat.</owl:annotatedTarget>
        <dc:source>doi:10.1098/rspb.1998.0424</dc:source>
        <rdfs:comment>&quot;The comparison between S and G leads to the observation that the canter stride can be considered to comprise two skipping strides, the first performed by the hind limbs and the second by the fore limbs, with about 25% of the stride period being out-of-phase between each other (at the overall illustrated speed)... Thus, cantering horses could be imitated by two humans performing (unilateral) S with 25% of the stride period being out-of-phase.&quot;</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000201"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">canter</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.2307/1379571</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000201"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>slow gallop</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.2307/1379571</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000201"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>canter-gallop gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


