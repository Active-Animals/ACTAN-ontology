            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-04T16:53:10.119852Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Roll that reflexively inclines its dorsal surface toward a light source.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>DLR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">dorsal light reflex</oboInOwl:hasExactSynonym>
        <rdfs:label>dorsal-light-reflex roll</rdfs:label>
        <skos:example>&quot;...commonly observed in teleost fishes.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000564"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Roll that reflexively inclines its dorsal surface toward a light source.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Briefly, illuminated horizontally, the fish inclines its dorsoventral axis and turns dorsal surface toward the light source, with its body tilt corrected antagonistically by the vestibular righting reflex (i.e., the body inclination increases with the illumination intensity but decreases with the gravity).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000564"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>DLR</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000564"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">dorsal light reflex</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000564"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>dorsal-light-reflex roll</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000564"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...commonly observed in teleost fishes.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000565 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000565">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000690"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001653"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-04T17:26:37.668556Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Roll that is normally inclined relative to gravity.

Dorsal uppermost is a common norm.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">righted</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>upright position</oboInOwl:hasExactSynonym>
        <rdfs:label>upright roll</rdfs:label>
        <skos:example>&quot;In the less elaborate technique of worm catching the body remains in the normal upright position...&quot;</skos:example>
        <skos:example>&quot;When 3-5 days after the egg has hatched the yolk has been absorbed, the larva no longer attaches itself to a substrate and from then keeps the ventral side downwards.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000565"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Roll that is normally inclined relative to gravity.

Dorsal uppermost is a common norm.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
        <dc:source>doi:10.1111/eff.12212</dc:source>
        <rdfs:comment>Multi-sourced definition.</rdfs:comment>
        <skos:scopeNote>&quot;(i.e., the body inclination... decreases with the gravity).&quot; (doi:10.1089/zeb.2012.0861)</skos:scopeNote>
        <skos:scopeNote>&quot;Then, the fish turns in a normal position (dorsal fin facing the surface) and after a very short period (up to 1 s) the fish turns upside down again, repeating this pattern up to 3 or 4 times.&quot; (doi:10.1111/eff.12212)</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000565"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">righted</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000565"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>upright position</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000565"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>upright roll</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000565"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In the less elaborate technique of worm catching the body remains in the normal upright position...&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000565"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;When 3-5 days after the egg has hatched the yolk has been absorbed, the larva no longer attaches itself to a substrate and from then keeps the ventral side downwards.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


