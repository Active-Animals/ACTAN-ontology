            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-18T17:00:32.540314Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Breeding that, to varying degrees, defends and feeds the young.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>attending</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">caring</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rearing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">caring breeding</rdfs:label>
        <skos:scopeNote>&quot;...the parent (or companion)...young reared by foster parents or... that had been with their own parents... it is possible to have young reared by foster parents of other species...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000479"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Breeding that, to varying degrees, defends and feeds the young.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.jstor.org/stable/986582</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;This could give females an advantage if correlated, in turn, with greater male strength, which might be reflected in higher genetic quality of the brood, or (if males participate in defense or feeding of the young) in more effective brood care.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000479"/>
