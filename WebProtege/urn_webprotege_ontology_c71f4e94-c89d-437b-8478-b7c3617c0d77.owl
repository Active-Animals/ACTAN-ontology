        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-03T10:24:50.010141Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Zipping in which the wing is not lifted, the bill touching the bird&apos;s back.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">dorsal-preening</oboInOwl:hasExactSynonym>
        <rdfs:label>back-zipping ethotype</rdfs:label>
        <skos:example>&quot;Preen-dorsally occurs in many species before copulation. It is performed repeatedly by both male and female Marbled Teal...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000808"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Zipping in which the wing is not lifted, the bill touching the bird&apos;s back.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853965x00138</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In (2) the wing is not lifted at all, the bill touching the bird&apos;s back.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000808"/>
