        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000325"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In cold regions, snakes often aggregate at denning sites for overwintering, and neonate rattlesnakes appear capable of following the scent trails of adults to locate dens.&quot;</owl:annotatedTarget>
