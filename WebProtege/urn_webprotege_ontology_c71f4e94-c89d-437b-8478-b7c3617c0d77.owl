        <oboInOwl:hasDefinition>Forage in which a cleaner cooperatively removes parasites and dead skin from the surface of a client.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">cleaning</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>service</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>social grooming</oboInOwl:hasNarrowSynonym>
        <rdfs:label>service forage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000582"/>
        <skos:example>&quot;Cleaner wrasse occupy cleaning stations on coral outcrops and remove parasites and dead skin from the surface of client fish.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000607"/>
