    <!-- http://purl.obolibrary.org/obo/ACTAN_0000998 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000998">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000387"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000110"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-23T09:27:02.413033Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Dominance in which an alpha-animal dominates all group members, a beta-animal dominates all group members except alpha, and so on until the omega-animal, which is subordinate to all group members.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>linear dominance hierarchy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pecking order</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>straight line dominance</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">peck dominance</rdfs:label>
        <skos:example>&quot;...the dominant juvenile white-seabream carry out aggressive attacks selectively on fish whose subordination level is immediately inferior to their own. Attacks are more frequently directed at the following individual in the hierarchical order, establishing a peck-dominance hierarchy.&quot;</skos:example>
        <skos:example>&quot;Ardeola ibis...
Fighting and pecking among siblings during feeds is very common, dominance relations being entirely based on their ages. Frequently (57% of 32 feeds), the oldest chick pecks, bites and buffets its sibling and chases it around the nest site., ceasing its attack only when the subordinate chick is well away from the parent.... Chicks never peck
older siblings. This rule is inviolable, so much so that in three-chick broods the middle chick only pecks the youngest, although the latter seldom effectively competes, the oldest sibling grabbing most of the food.&quot;</skos:example>
        <skos:scopeNote>&quot;...many rank orders in fairly small groups (usually with a sparse number of individuals) of animals are linear.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;...the &quot;pecking order&quot; so common in fowls presupposes that members of the same species are bound together by a very positive social reflex...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000998"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Dominance in which an alpha-animal dominates all group members, a beta-animal dominates all group members except alpha, and so on until the omega-animal, which is subordinate to all group members.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1002/(SICI)1098-2337(1998)24:3&lt;197::AID-AB4&gt;3.0.CO;2-I</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Hierarchy structures can vary from linear (an a-animal dominates all group members, a b-animal dominates all group members except a, and so on until the w-animal, which is subordinate to all group members) at one extreme, to the other extreme where one group member dominates all other group members, which are equal in rank (despotism).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000998"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>linear dominance hierarchy</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>doi:10.1002/(SICI)1098-2337(1998)24:3&lt;197::AID-AB4&gt;3.0.CO;2-I</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000998"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pecking order</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000998"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>straight line dominance</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000998"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">peck dominance</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>doi:10.1002/(SICI)1098-2337(1998)24:3&lt;197::AID-AB4&gt;3.0.CO;2-I</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000998"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...the dominant juvenile white-seabream carry out aggressive attacks selectively on fish whose subordination level is immediately inferior to their own. Attacks are more frequently directed at the following individual in the hierarchical order, establishing a peck-dominance hierarchy.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1002/(SICI)1098-2337(1998)24:3&lt;197::AID-AB4&gt;3.0.CO;2-I</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000998"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Ardeola ibis...
Fighting and pecking among siblings during feeds is very common, dominance relations being entirely based on their ages. Frequently (57% of 32 feeds), the oldest chick pecks, bites and buffets its sibling and chases it around the nest site., ceasing its attack only when the subordinate chick is well away from the parent.... Chicks never peck
older siblings. This rule is inviolable, so much so that in three-chick broods the middle chick only pecks the youngest, although the latter seldom effectively competes, the oldest sibling grabbing most of the food.&quot;</owl:annotatedTarget>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000998"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...many rank orders in fairly small groups (usually with a sparse number of individuals) of animals are linear.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1002/(SICI)1098-2337(1998)24:3&lt;197::AID-AB4&gt;3.0.CO;2-I</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000998"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...the &quot;pecking order&quot; so common in fowls presupposes that members of the same species are bound together by a very positive social reflex...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000999 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000999">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000389"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000382"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-23T10:55:01.661639Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Competition in which an attack ascends a hierarchy.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>challenging</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">challenge competition</rdfs:label>
        <skos:example>&quot;Chimpanzee...
...retaliation by a dominant individual to a challenging subordinate...&quot;</skos:example>
        <skos:scopeNote>&quot;...the “boldest” subordinate would always be expected to challenge the dominant fish more than the other subordinates. Thus, this trend would be an automatic outcome of variation in willingness to take risks. We could also deduce that once the dominant fish relinquished the resource (because it was satiated) to the second fish in line, the entire process would begin again with the “boldest” of the remaining subordinates challenging the third fish in line more than the others (and so on).&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000999"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Competition in which an attack ascends a hierarchy.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1002/(SICI)1098-2337(1998)24:3&lt;197::AID-AB4&gt;3.0.CO;2-I</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In the same way, the ascending attacks, although furtive, represent a possibility of ascending in status if they are successful.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000999"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>challenging</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>doi:10.1002/(SICI)1098-2337(1998)24:3&lt;197::AID-AB4&gt;3.0.CO;2-I</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000999"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">challenge competition</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000999"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Chimpanzee...
...retaliation by a dominant individual to a challenging subordinate...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000999"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...the “boldest” subordinate would always be expected to challenge the dominant fish more than the other subordinates. Thus, this trend would be an automatic outcome of variation in willingness to take risks. We could also deduce that once the dominant fish relinquished the resource (because it was satiated) to the second fish in line, the entire process would begin again with the “boldest” of the remaining subordinates challenging the third fish in line more than the others (and so on).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1002/(SICI)1098-2337(1998)24:3&lt;197::AID-AB4&gt;3.0.CO;2-I</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000110"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/group_behaviour"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-27T08:10:44.740756Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Territorialism in which a more contributing, dominant host allows a less contributing, subordinate a limited share of space.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>squatting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>nest associate</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>communal nesting</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">associate territorialism</rdfs:label>
        <skos:example>&quot;...a male N leptocephalus defended a relatively small territory around his spawning pit (i.e., average area was 22% of total available substrate on upstream slope of nest). As a result, up to five subordinate males, termed “squatters,” were able to establish territories over an occupied nest.&quot;</skos:example>
        <skos:example>&quot;Spawning in Nocomis leptocephalus.—In Sinking Creek two males spawned over a single mound nest about 70 cm in diameter and 13 cm high at its center. Each male occupied a spawning pit approximately 4 cm wide, 6 cm long and 2.5 cm deep. The pits were within 10 cm of each other on the upstream slope, one slightly upstream of the other. The larger male (=resident) occupied the more upstream pit and had constructed the nest. Both males concurrently and independently spawned with females over their respective pits; how ever, the resident male participated in the majority of spawns.&quot;</skos:example>
        <skos:scopeNote>&quot;Interaction of host and nest associate is thought to be mutualistic. Eggs and larvae of associates benefit from the parental care of nesting chub, and offspring of both host and associate may benefit from a dilution effect whereby predation risk per egg is reduced in the nest.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001000"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Territorialism in which a more contributing, dominant host allows a less contributing, subordinate a limited share of space.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001000"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>squatting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001000"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>nest associate</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001000"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>communal nesting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001000"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">associate territorialism</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001000"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...a male N leptocephalus defended a relatively small territory around his spawning pit (i.e., average area was 22% of total available substrate on upstream slope of nest). As a result, up to five subordinate males, termed “squatters,” were able to establish territories over an occupied nest.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001000"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Spawning in Nocomis leptocephalus.—In Sinking Creek two males spawned over a single mound nest about 70 cm in diameter and 13 cm high at its center. Each male occupied a spawning pit approximately 4 cm wide, 6 cm long and 2.5 cm deep. The pits were within 10 cm of each other on the upstream slope, one slightly upstream of the other. The larger male (=resident) occupied the more upstream pit and had constructed the nest. Both males concurrently and independently spawned with females over their respective pits; how ever, the resident male participated in the majority of spawns.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001000"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Interaction of host and nest associate is thought to be mutualistic. Eggs and larvae of associates benefit from the parental care of nesting chub, and offspring of both host and associate may benefit from a dilution effect whereby predation risk per egg is reduced in the nest.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000986"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000658"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-27T09:38:23.900265Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Spawn in which a female initiates a quick, short, substratal, accompanied swim.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym>run</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Not to be confused with the migration-type &apos;spawning run&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">run spawn</rdfs:label>
        <skos:example>&quot;...a female N. micropogon initiated her spawning run as the male tilted. Following the contour of the substrate, she swam about 5—10 cm upstream with her dorsum appressed to the male’s anterior flank and her side often crowded against a wall of the trough. The tilted male remained slightly ahead as he accompanied her run with 3—7 distinct tail beats.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Spawn in which a female initiates a quick, short, substratal, accompanied swim.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;A successful spawning run always was initiated by the female. With her body pressed to the substrate, she quickly swam about 3—5 cm upstream while quivering her tail and caudal peduncle. The male remained tilted as he promptly accompanied her short run with rapid tail beats.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>run</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001001"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Not to be confused with the migration-type &apos;spawning run&apos;.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001001"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">run spawn</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
        <skos:scopeNote>&quot;...spawning run...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001001"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...a female N. micropogon initiated her spawning run as the male tilted. Following the contour of the substrate, she swam about 5—10 cm upstream with her dorsum appressed to the male’s anterior flank and her side often crowded against a wall of the trough. The tilted male remained slightly ahead as he accompanied her run with 3—7 distinct tail beats.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000922"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001933"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-27T15:32:22.717477Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Alignment that is alongside another, head-to-tail.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>antiparalleling</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">antiparalleling alignment</rdfs:label>
        <skos:example>&quot;For A. nigricaudus... male presses close to the female, usually in a head-to-tail position...&quot;</skos:example>
        <skos:example>&quot;Zebrafish...
Two fish approach one another in opposite directions and with erected fins, and in an antiparallel position circle each other usually ascending in the water column.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001002"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Alignment that is alongside another, head-to-tail.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1023/A:1011074716758</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001002"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>antiparalleling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2011</dc:date>
        <dc:source>doi:10.1089/zeb.2011.0690</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001002"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">antiparalleling alignment</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001002"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;For A. nigricaudus... male presses close to the female, usually in a head-to-tail position...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1023/A:1011074716758</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001002"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Zebrafish...
Two fish approach one another in opposite directions and with erected fins, and in an antiparallel position circle each other usually ascending in the water column.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2011.0690</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000358"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-28T08:34:03.661574Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Hunt in which a predator catches prey disturbed by its movements.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>flushing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>beating</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">flush hunt</rdfs:label>
        <skos:example>&quot;Smaller juvenile Mycteroperca rosacea and Bodianus diplotaenia both spent more time as associates in foraging associations than larger adults. This is probably because juveniles feed on benthic invertebrates, flushed out by the nuclear species with which they associate, whereas the adults tend to be piscivores.&quot;</skos:example>
        <skos:example>&quot;Three jaegers were seen flying together about 15 m high when a Semipalmated Sandpiper (C. pusilla) flushed beneath them.&quot;</skos:example>
        <skos:example>&quot;When a rabbit found temporary refuge or cover, a flush-and-ambush strategy was employed. Here, the hawks surrounded and alertly watched the location where the quarry disappeared while one or possibly two hawks attempted to penetrate the cover. When the rabbit flushed, one or more of the perched birds pounced and made the kill.&quot;</skos:example>
        <skos:scopeNote>&quot;In multispecies insectivorous bird flocks individuals gain access to insects that are flushed out by the movement or ‘beating’ of the flock as a whole.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001003"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Hunt in which a predator catches prey disturbed by its movements.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.jstor.org/stable/4084834</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In walk quickly, a heron walks through shallow water or fields catching prey disturbed by its movements.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001003"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>flushing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1976</dc:date>
        <dc:source>https://www.jstor.org/stable/4084834</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001003"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>beating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001003"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">flush hunt</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001003"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Smaller juvenile Mycteroperca rosacea and Bodianus diplotaenia both spent more time as associates in foraging associations than larger adults. This is probably because juveniles feed on benthic invertebrates, flushed out by the nuclear species with which they associate, whereas the adults tend to be piscivores.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001003"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Three jaegers were seen flying together about 15 m high when a Semipalmated Sandpiper (C. pusilla) flushed beneath them.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/4161407</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001003"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;When a rabbit found temporary refuge or cover, a flush-and-ambush strategy was employed. Here, the hawks surrounded and alertly watched the location where the quarry disappeared while one or possibly two hawks attempted to penetrate the cover. When the rabbit flushed, one or more of the perched birds pounced and made the kill.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.239.4847.1525</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001003"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In multispecies insectivorous bird flocks individuals gain access to insects that are flushed out by the movement or ‘beating’ of the flock as a whole.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000410"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0015004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-28T09:48:15.32854Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>social foraging</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Indirect-sample which enhances the ability of an individual in a group to locate and consume food, through the transfer of information regarding its location and nature, by cues of success displayed by other individuals in the group.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">forage indirect-sample</rdfs:label>
        <skos:example>&quot;In the Aplomado falcon (Falco femoralis), tandem hunts were less frequent than solo hunts (29% of hunts observed), but social foraging may have resulted in a greater probability of capturing birds.&quot;</skos:example>
        <skos:example>&quot;Movement patterns of multi-species finch flocks in the Mohave Desert indicated that feeding was maximised in areas where flocks travelled while depleted areas were avoided. By contrast when birds fed alone they would often search for food in areas previously visited by other birds.&quot;</skos:example>
        <skos:scopeNote>&quot;Enhanced prey detection can operate on large spatial scales, whereby animals find large prey aggregations, and small spatial scales, when individuals are attracted to food patches through social attraction within a foraging group. The advantages of social foraging are greater to multi-species groups compared with single species groups, as individuals benefit from the combined searching skills of each individual species.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;When navigating, animals inevitably rely on the integration of spatial and social information to decide when and where to move and social foraging presents a clear case where the decisions on movement goals reflect the social environment.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001004"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>social foraging</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1988</dc:date>
        <dc:source>doi:10.1126/science.239.4847.1525</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001004"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Indirect-sample which enhances the ability of an individual in a group to locate and consume food, through the transfer of information regarding its location and nature, by cues of success displayed by other individuals in the group.</owl:annotatedTarget>
        <rdfs:isDefinedBy>ISBN:9789798105975</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Social foraging may enhance the ability of some individuals in a group locate and consume prey through the transfer of information regarding the location and/or the nature of potential food sources. Enhanced prey detection occurs when individuals are attracted to a food source or patch when behavioural cues of successful foraging are displayed by other individuals in the group.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001004"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">forage indirect-sample</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001004"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In the Aplomado falcon (Falco femoralis), tandem hunts were less frequent than solo hunts (29% of hunts observed), but social foraging may have resulted in a greater probability of capturing birds.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.239.4847.1525</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001004"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Movement patterns of multi-species finch flocks in the Mohave Desert indicated that feeding was maximised in areas where flocks travelled while depleted areas were avoided. By contrast when birds fed alone they would often search for food in areas previously visited by other birds.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001004"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Enhanced prey detection can operate on large spatial scales, whereby animals find large prey aggregations, and small spatial scales, when individuals are attracted to food patches through social attraction within a foraging group. The advantages of social foraging are greater to multi-species groups compared with single species groups, as individuals benefit from the combined searching skills of each individual species.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001004"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;When navigating, animals inevitably rely on the integration of spatial and social information to decide when and where to move and social foraging presents a clear case where the decisions on movement goals reflect the social environment.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/brv.12934</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000110"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-28T10:24:46.835477Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Interaction in which behaviour by an individual stimulates similar behaviour in another.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>social facilitation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">facilitation interaction</rdfs:label>
        <skos:example>&quot;Thus the association between the congenerics P. barberinus and P. indicus, may benefit both species through increased access to food, enhanced prey detection and social facilitation, however it may also result in competition between the two species.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001005"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Interaction in which behaviour by an individual stimulates similar behaviour in another.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>ISBN:9789798105975</dc:source>
        <skos:scopeNote>&quot;Social facilitation results when foraging by a number of individuals, stimulates foraging in other group member, thus increasing their food intake.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001005"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>social facilitation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001005"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">facilitation interaction</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001005"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Thus the association between the congenerics P. barberinus and P. indicus, may benefit both species through increased access to food, enhanced prey detection and social facilitation, however it may also result in competition between the two species.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000410"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000576"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-28T11:09:16.260877Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Indirect-sample in which a change to an animal&apos;s vigilance is triggered by a change in behaviour of a group member.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">alarm indirect-sample</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000367"/>
        <skos:example>&quot;Fish interpret conspecifics feeding as a sign that it is safe to feed, thus spend more time feeding and less maintaining antipredator vigilence.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001006"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Indirect-sample in which a change to an animal&apos;s vigilance is triggered by a change in behaviour of a group member.</owl:annotatedTarget>
        <rdfs:isDefinedBy>ISBN:9789798105975</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Alarmed conspecifics trigger a change in behaviour of other group members to increased vigilance or hiding.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001006"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">alarm indirect-sample</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001006"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Fish interpret conspecifics feeding as a sign that it is safe to feed, thus spend more time feeding and less maintaining antipredator vigilence.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000155"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-28T13:02:24.340462Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Forage that involves organic debris.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>scavenging</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">scavenge forage</rdfs:label>
        <skos:example>&quot;...in the Mexican Caribbean, we observed unusual behaviour of a group of Acanthurus chirurgus, which were feeding on a tuna head left on site by travel tour personnel.&quot;</skos:example>
        <skos:example>&quot;...the burying beetles, Nicrophorus ssp... bury carrion (serving as food source for their dependent, larval offspring nearby) to protect it from other scavengers...&quot;</skos:example>
        <skos:example>&quot;Chimpanzee...
Eat the carcass of mammals that have not been killed by oneself or one&apos;s companions.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001007"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Forage that involves organic debris.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1242/jeb.120.1.283</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Usually, by day it is quiescent and at night it descends to the beaches to scavenge organic debris along the moist sand.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001007"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>scavenging</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1986</dc:date>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001007"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">scavenge forage</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001007"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...in the Mexican Caribbean, we observed unusual behaviour of a group of Acanthurus chirurgus, which were feeding on a tuna head left on site by travel tour personnel.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3897/BDJ.8.e53712</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001007"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...the burying beetles, Nicrophorus ssp... bury carrion (serving as food source for their dependent, larval offspring nearby) to protect it from other scavengers...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.anbehav.2026.123487</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001007"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Chimpanzee...
Eat the carcass of mammals that have not been killed by oneself or one&apos;s companions.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000389"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000046"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-30T07:22:37.386434Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Competition which involves indirect negative interaction resulting from using the same, limited resources.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">exploitative competition</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">exploit competition</rdfs:label>
        <skos:example>&quot;...one explanation for the ability of P. siculus to exploit food resources in the presence of the native species may be due to the invasive species’ personality traits. An invasive species can better exploit food resources by being bolder than native species and P. siculus has been shown to be not only bolder, but also more exploratory and neophilic than P. virescens at the same study site.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001008"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Competition which involves indirect negative interaction resulting from using the same, limited resources.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/s00265-020-02893-2</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Exploitative competition refers to indirect negative interactions resulting from species using the same, limited resources, such as food or water.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001008"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">exploitative competition</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2004</dc:date>
        <dc:source>doi:10.1016/j.anbehav.2003.11.017</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001008"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">exploit competition</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001008"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...one explanation for the ability of P. siculus to exploit food resources in the presence of the native species may be due to the invasive species’ personality traits. An invasive species can better exploit food resources by being bolder than native species and P. siculus has been shown to be not only bolder, but also more exploratory and neophilic than P. virescens at the same study site.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s00265-020-02893-2</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000461"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-30T19:55:51.459906Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Crypsis in which an animal resembles some object which is of no interest to its enemy, and in so doing is concealed.

This may be a part of a substratum, a plant, or a sedentary animal such as a sponge or soft coral.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>protective resemblance</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">resemblance crypsis</rdfs:label>
        <skos:example>&quot;...the juvenile labrid Novaculichthys taeniourus, which looks like drifting algae (the deception enhanced by its seemingly disoriented movement);&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001009"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Crypsis in which an animal resembles some object which is of no interest to its enemy, and in so doing is concealed.

This may be a part of a substratum, a plant, or a sedentary animal such as a sponge or soft coral.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In the former an animal resembles some object which is of no interest to its enemy, and in so doing is concealed;

For the purpose of this report, protective resemblance is used for an animal that closely resembles a part of a substratum, a plant, or a sedentary animal such as a sponge or soft coral.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001009"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>protective resemblance</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2005</dc:date>
        <dc:source>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001009"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">resemblance crypsis</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001009"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...the juvenile labrid Novaculichthys taeniourus, which looks like drifting algae (the deception enhanced by its seemingly disoriented movement);&quot;</owl:annotatedTarget>
        <dc:source>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000458"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000463"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-01T08:20:59.127236Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Deception in which an animal resembling another active animal, which is well known and not preyed upon by its enemy, adopts a pattern of behavior to enhance the deception, and in so doing becomes conspicuous.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>Batesian mimicry</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Müllerian mimicry</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">mimicry deception</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001009"/>
        <skos:example>&quot;A small sole from Papua New Guinea, estimated to be 12 mm in length by the photographer, appears to be a juvenile of an undetermined species of Soleichthys. It moves slowly over the bottom like a flatworm and is believed to be a mimic of an undescribed polyclad of the genus Pseudoceros.&quot;</skos:example>
        <skos:example>&quot;Schooling juveniles of the Convictfish Pholidichthys leucotaenia look very much like schools of the juvenile venomous catfish Plotosus lineatus. The catfish aggregate closely for the mutual protection provided by their spines, and Convictfish juveniles may also form dense schools, although they tend to be more dispersed.&quot;</skos:example>
        <skos:scopeNote>“In Batesian mimicry a relatively scarce, palatable, and unprotected species resembles an abundant, relatively unpalatable, or well-protected species, and so becomes disguised. In Müllerian mimicry, on the other hand, a number of different species, all possessing aposematic attributes and appearance, resemble one another, and so become more easily recognized.”</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001010"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Deception in which an animal resembling another active animal, which is well known and not preyed upon by its enemy, adopts a pattern of behavior to enhance the deception, and in so doing becomes conspicuous.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;From observations of the Cleaner Wrasse Labroides dimidiatus and the Mimic Blenny Aspidontus taeniatus, Randall and Randall revised Poulton&apos;s definition of mimicry to ”... an animal resembles an object which is well known and is avoided or not preyed upon by its enemy, and in so doing becomes conspicuous.

Mimicry applies only to animals that resemble active animals. In addition to resemblance in color and morphology, the mimic may adopt a pattern of behavior to enhance the deception.”</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001010"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>Batesian mimicry</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001010"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>Müllerian mimicry</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2005</dc:date>
        <dc:source>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001010"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">mimicry deception</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
        <skos:scopeNote>&quot;Some deceptions, e.g., mimicry...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001010"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;A small sole from Papua New Guinea, estimated to be 12 mm in length by the photographer, appears to be a juvenile of an undetermined species of Soleichthys. It moves slowly over the bottom like a flatworm and is believed to be a mimic of an undescribed polyclad of the genus Pseudoceros.&quot;</owl:annotatedTarget>
        <dc:source>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001010"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Schooling juveniles of the Convictfish Pholidichthys leucotaenia look very much like schools of the juvenile venomous catfish Plotosus lineatus. The catfish aggregate closely for the mutual protection provided by their spines, and Convictfish juveniles may also form dense schools, although they tend to be more dispersed.&quot;</owl:annotatedTarget>
        <dc:source>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001010"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>“In Batesian mimicry a relatively scarce, palatable, and unprotected species resembles an abundant, relatively unpalatable, or well-protected species, and so becomes disguised. In Müllerian mimicry, on the other hand, a number of different species, all possessing aposematic attributes and appearance, resemble one another, and so become more easily recognized.”</owl:annotatedTarget>
        <dc:source>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001010"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000047"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-01T11:38:07.855475Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mimicry in which a normally solitary fish mingles with a similar species for the advantages of aggregating.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym>school-oriented mimicry</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">social mimicry</rdfs:label>
        <skos:example>&quot;...the goatfish Mulloidichthys mimicus from the Marquesas Is. and Line Is.; its species name is in reference to its close resemblance to the snapper Lutjanus kasmira with which it often schools&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001011"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mimicry in which a normally solitary fish mingles with a similar species for the advantages of aggregating.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Dafni and Diamant proposed the term school-oriented mimicry when a normally solitary fish species mingles with a similar aggregating species for the advantage of schooling.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001011"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>school-oriented mimicry</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2005</dc:date>
        <dc:source>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001011"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">social mimicry</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2005</dc:date>
        <dc:source>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001011"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...the goatfish Mulloidichthys mimicus from the Marquesas Is. and Line Is.; its species name is in reference to its close resemblance to the snapper Lutjanus kasmira with which it often schools&quot;</owl:annotatedTarget>
        <dc:source>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000723"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFA_0000555"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-01T14:17:59.982958Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Gape which results from operculum gaping.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>opercular spread</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">operculum gape</rdfs:label>
        <skos:example>&quot;Courtship displays of R. decemdigitatus consisted of 11 steps: ... (v) opercular spread displays, in which the male widely opens and closes the operculum...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001012"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Gape which results from operculum gaping.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001012"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>opercular spread</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2008</dc:date>
        <dc:source>doi:10.1007/s10682-007-9183-7</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001012"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">operculum gape</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001012"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Courtship displays of R. decemdigitatus consisted of 11 steps: ... (v) opercular spread displays, in which the male widely opens and closes the operculum...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10682-007-9183-7</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000669"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002415"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-02T08:27:04.38836Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flaring which involves the tail.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>caudal fin cupping</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>caudal fin flaring</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">tail flaring</rdfs:label>
        <skos:example>&quot;...bluegill sunfish, Lepomis macrochirus...

Braking maneuvers followed acceleration towards prey and were characterized by a rapid flaring of the dorsal and ventral lobes of the caudal fin in opposite directions.&quot;</skos:example>
        <skos:example>&quot;Badis badis...

The caudal fin frequently is compressed and held to one side partially cupped ;&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001013"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flaring which involves the tail.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1242/jeb.021360</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The mean tail height for braking maneuvers was similar initially to the mean tail height during gliding (4.7±0.06cm) and increased by approximately 1 cm when the dorsal and ventral lobes of the tail were fully flared.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001013"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>caudal fin cupping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
        <skos:scopeNote>&quot;...caudal fin... cupped ;&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001013"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>caudal fin flaring</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1242/jeb.021360</dc:source>
        <skos:scopeNote>&quot;...flaring... the caudal fin...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001013"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">tail flaring</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1242/jeb.021360</dc:source>
        <skos:scopeNote>&quot;...tail... flared.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001013"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...bluegill sunfish, Lepomis macrochirus...

Braking maneuvers followed acceleration towards prey and were characterized by a rapid flaring of the dorsal and ventral lobes of the caudal fin in opposite directions.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.021360</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001013"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Badis badis...

The caudal fin frequently is compressed and held to one side partially cupped ;&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000669"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000151"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-02T08:27:18.59266Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flaring which involves a pectoral fin.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>pectoral fin cupping</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">pectoral-fin flaring</rdfs:label>
        <skos:example>&quot;Within a complete stroke cycle, motions of the maneuvering pectoral fins of a forward-sinking parrot cichlid executing a CFP involved sequential fin movements of... (2) rotating and cupping the fin (i.e. stroke reversal)...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001014"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flaring which involves a pectoral fin.</owl:annotatedTarget>
        <rdfs:isDefinedBy>http://www.nativefishlab.net/library/textpdf/15582.pdf</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The pectoral fins tend to be cupped with the concave surface directed anteriolaterally.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001014"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pectoral fin cupping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001014"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">pectoral-fin flaring</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001014"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Within a complete stroke cycle, motions of the maneuvering pectoral fins of a forward-sinking parrot cichlid executing a CFP involved sequential fin movements of... (2) rotating and cupping the fin (i.e. stroke reversal)...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.020263</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000852"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000853"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-02T16:33:03.284974Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Gamete-release in which sperm is transferred.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>insemination</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sperm transfer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>sperm donation</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">insemination gamete-release</rdfs:label>
        <skos:example>&quot;Male guppies are notorious for their sexual vigour. They devote most of their time trying to inseminate females, either by copulating, preceded by courtship, with the female’s consent, or by attempting forced copulations.&quot;</skos:example>
        <skos:example>&quot;Salamanders do not possess an intromittent organ, so insemination is accomplished by sperm transfer via a spermatophore.&quot;</skos:example>
        <skos:scopeNote>&quot;In conditional reciprocity, individuals donate sperm only in exchange for their partner’s sperm. Conditional reciprocity will have a stabilizing effect on hermaphroditism since it prevents the evolution of female-type individuals.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001015"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Gamete-release in which sperm is transferred.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1006/anbe.1995.0166</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;For instance, in many birds lacking a penis, sperm transfer can relatively easily be prevented by the female.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001015"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>insemination</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1023/A:1011074716758</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001015"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>sperm transfer</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001015"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>sperm donation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>doi:10.1086/342821</dc:source>
        <skos:scopeNote>&quot;...to donate sperm.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001015"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">insemination gamete-release</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1007/s00265-010-0980-6</dc:source>
        <skos:scopeNote>&quot;...inseminate... by... copulations.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001015"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Male guppies are notorious for their sexual vigour. They devote most of their time trying to inseminate females, either by copulating, preceded by courtship, with the female’s consent, or by attempting forced copulations.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s00265-010-0980-6</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001015"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Salamanders do not possess an intromittent organ, so insemination is accomplished by sperm transfer via a spermatophore.&quot;</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2003</dc:date>
        <dc:source>ISBN:9781482294347</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000455"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001230"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-03T09:10:23.309971Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Constraint in which continued physical resistance is forcefully overcome.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>restraining</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">restraint constraint</rdfs:label>
        <skos:example>&quot;Salamandrid courtship...

Restraint of the female (FR) using the tail, hind limbs and jaws (Euproctus).&quot;</skos:example>
        <skos:scopeNote>&quot;In crickets... physical restraint leads to the production of vigorous resistance reflexes driven by bursting activity by all excitatory motor neurons.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001016"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Constraint in which continued physical resistance is forcefully overcome.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001016"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>restraining</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001016"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">restraint constraint</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001016"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Salamandrid courtship...

Restraint of the female (FR) using the tail, hind limbs and jaws (Euproctus).&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9781482294347</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001016"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In crickets... physical restraint leads to the production of vigorous resistance reflexes driven by bursting activity by all excitatory motor neurons.&quot;</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2014</dc:date>
        <dc:source>doi:10.1016/j.cub.2014.08.051</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000464"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000441"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-03T10:27:00.313427Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Manipulation in which persistence induces a contestant to give up costly resistance early on.

This may result in a risk reduction for the loser and/or the winner.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>demanding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>harassment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>war of attrition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>begging</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">harassment manipulation</rdfs:label>
        <skos:example>&quot;In a variety of species, females attempt to avoid harassment but will accept matings from harassing males when they cannot escape. For example, female elephant seals that are leaving the harems of dominant bulls readily accept mating attempts by peripheral males and appear to reduce the risks of being injured by doing so.&quot;</skos:example>
        <skos:scopeNote>&quot;Since begging fledglings can commonly supplant their parents, it may be more appropriate to call begging displays “demand behavior.”&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The probable advantages of team hunting include... the ability to harass the intended prey to exhaustion, increasing its vulnerability.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Manipulation in which persistence induces a contestant to give up costly resistance early on.

This may result in a risk reduction for the loser and/or the winner.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>demanding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1980</dc:date>
        <dc:source>doi:10.2307/1367395</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>harassment</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
        <rdfs:comment>&quot;...harassed by another...&quot;</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>war of attrition</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>begging</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1980</dc:date>
        <dc:source>doi:10.2307/1367395</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">harassment manipulation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In a variety of species, females attempt to avoid harassment but will accept matings from harassing males when they cannot escape. For example, female elephant seals that are leaving the harems of dominant bulls readily accept mating attempts by peripheral males and appear to reduce the risks of being injured by doing so.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Since begging fledglings can commonly supplant their parents, it may be more appropriate to call begging displays “demand behavior.”&quot;</owl:annotatedTarget>
        <dc:source>doi:10.2307/1367395</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The probable advantages of team hunting include... the ability to harass the intended prey to exhaustion, increasing its vulnerability.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.239.4847.1525</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000464"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000828"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-03T10:28:09.835155Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Manipulation in which an animal performs an act of punishment, temporarily reducing its own fitness, but with net consequences that are beneficial to the punisher.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>intimidation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>punishing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>punishment</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">intimidation manipulation</rdfs:label>
        <skos:example>&quot;...male White’s skinks (Liopholis whitii) will punish their female partners for extra-pair copulations, evidence of which can be detected through olfactory cues.&quot;</skos:example>
        <skos:example>&quot;Chimpanzee...

At Mahale, an alpha male, Ntologi, did not look at the beta male, Nsaba even if Nsaba continuously followed Ntologi apparently seeking to groom him. Apparently a kind of intimidation signaling that the alpha male does not wish to interact with the beta.&quot;</skos:example>
        <skos:scopeNote>&quot;One mechanism that can contribute to the stability of mutualisms is retribution in response to cheating once it has occurred (e.g. partner switching, punishment).&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Punishment is characteristic of animals living in stable social groups where repeated contests are likely to be common and can have important effects on the evolution of social behaviour.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001018"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Manipulation in which an animal performs an act of punishment, temporarily reducing its own fitness, but with net consequences that are beneficial to the punisher.</owl:annotatedTarget>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
        <rdfs:comment>&quot;Intimidation is temporarily spiteful, since an individual temporarily reduces its own fitness by performing an act of punishment. As in the case of reciprocal altruism, the strategy is maintained by a deferred benefit: in a longer time frame, the net consequences of the action (punishment) are beneficial to the punisher, and punishment represents a selfish strategy.&quot;</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001018"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>intimidation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001018"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>punishing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001018"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>punishment</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001018"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">intimidation manipulation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001018"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...male White’s skinks (Liopholis whitii) will punish their female partners for extra-pair copulations, evidence of which can be detected through olfactory cues.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.yhbeh.2021.105062</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001018"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Chimpanzee...

At Mahale, an alpha male, Ntologi, did not look at the beta male, Nsaba even if Nsaba continuously followed Ntologi apparently seeking to groom him. Apparently a kind of intimidation signaling that the alpha male does not wish to interact with the beta.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001018"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;One mechanism that can contribute to the stability of mutualisms is retribution in response to cheating once it has occurred (e.g. partner switching, punishment).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1098/rsbl.2019.0534</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001018"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Punishment is characteristic of animals living in stable social groups where repeated contests are likely to be common and can have important effects on the evolution of social behaviour.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCIT_C61299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-03T19:37:43.349586Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mating where the benefit of overcoming sexual resistance is high, with substantial costs to the resister.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>coerced mating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sexual coercion</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">coercion mating</rdfs:label>
        <skos:example>&quot;...in a radical reframing of coho salmon mating strategies, Watters hypothesized that females in fact prefer jack males and cooperate in mating with them, whereas less-preferred hooknose males coerce females into mating.&quot;</skos:example>
        <skos:scopeNote>&quot;...sexual coercion should probably be regarded as a third form of sexual selection, on a level with intra-sexual competition and inter-sexual mate choice.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001019"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mating where the benefit of overcoming sexual resistance is high, with substantial costs to the resister.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1006/anbe.1995.0166</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Where the benefits of sexual coercion to males are high, all three male strategies may develop to a point where they have substantial costs to females...

There are theoretical reasons to expect that sexual coercion will be widespread and may often have high costs to females, although in some cases the usual sex roles may be reversed.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001019"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>coerced mating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
        <skos:scopeNote>&quot;...coerce... to mate...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001019"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>sexual coercion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001019"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">coercion mating</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001019"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...in a radical reframing of coho salmon mating strategies, Watters hypothesized that females in fact prefer jack males and cooperate in mating with them, whereas less-preferred hooknose males coerce females into mating.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.anbehav.2019.12.009</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001019"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...sexual coercion should probably be regarded as a third form of sexual selection, on a level with intra-sexual competition and inter-sexual mate choice.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000553"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0015003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-04T09:07:07.670466Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Condition switch when strong local intraspecific competition favors some secondary means of resource procurement.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">facultative switch</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001020"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Condition switch when strong local intraspecific competition favors some secondary means of resource procurement.</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
        <skos:scopeNote>&quot;Indeed, it seems reasonable to hypothesize that, except in special circumstances, selection under strong local intraspecific competition should favor a facultative (rather than genetic) switch to some alternative (secondary) means of resource procurement.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001020"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">facultative switch</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001016"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-04T10:35:46.655706Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Coercion where a superior ability is used to catch and physically restrain a mate while copulating.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>forced copulation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>forced mating</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">force coercion</rdfs:label>
        <skos:example>&quot;For example, in wild orangutans, Pongo pygmaeus, most copulations by subadult males and almost half of all copulations by adult males occur after fierce female resistance has been violently overcome by the male.&quot;</skos:example>
        <skos:example>&quot;Male guppies...

...mating with receptive females can give males an advantage in paternity because males transfer more sperm through courtship copulations than through forced copulations.&quot;</skos:example>
        <skos:scopeNote>&quot;...forced copulation appears to be rare or absent in species where a single male can control mating access to one or more females effectively.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001021"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Coercion where a superior ability is used to catch and physically restrain a mate while copulating.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1006/anbe.1995.0166</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;There are three main forms of sexual coercion: (1) forced copulation, where a male uses superior speed or strength to catch and physically restrain a female while he copulates with her by force;&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001021"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>forced copulation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001021"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>forced mating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1007/s00265-010-0980-6</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001021"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">force coercion</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001021"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;For example, in wild orangutans, Pongo pygmaeus, most copulations by subadult males and almost half of all copulations by adult males occur after fierce female resistance has been violently overcome by the male.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001021"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Male guppies...

...mating with receptive females can give males an advantage in paternity because males transfer more sperm through courtship copulations than through forced copulations.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s00265-010-0980-6</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001021"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...forced copulation appears to be rare or absent in species where a single male can control mating access to one or more females effectively.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001018"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-04T10:36:54.956626Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Coercion which punishes refusal to mate.

This raises the chances that they will accept them as mates at some stage in the future.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>intimidation by punishment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sexual intimidation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">intimidation coercion</rdfs:label>
        <skos:example>&quot;Male hamadryas baboons, Papio hamadryas, that defend harems will initially threaten females that stray with an eyebrow flash, but if they fail to return immediately will bite them on the neck.&quot;</skos:example>
        <skos:scopeNote>&quot;In many social primates, males occasionally attack females for little or no obvious reason. As primatologists have suggested, these attacks may intimidate females so that they are subsequently more likely to accept mating attempts from the aggressor.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001022"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Coercion which punishes refusal to mate.

This raises the chances that they will accept them as mates at some stage in the future.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1006/anbe.1995.0166</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;There are three main forms of sexual coercion:... (3) intimidation, where males punish females that refuse to mate with them, thereby raising the chances that they will accept them as mates at some stage in the future.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001022"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>intimidation by punishment</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001022"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>sexual intimidation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001022"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">intimidation coercion</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001022"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Male hamadryas baboons, Papio hamadryas, that defend harems will initially threaten females that stray with an eyebrow flash, but if they fail to return immediately will bite them on the neck.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001022"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In many social primates, males occasionally attack females for little or no obvious reason. As primatologists have suggested, these attacks may intimidate females so that they are subsequently more likely to accept mating attempts from the aggressor.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000399"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000893"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-04T16:36:14.472232Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Inspection which evaluates some quality.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">resource inspection</rdfs:label>
        <skos:example>&quot;...male guppies (Poecilia reticulata)...

In addition to fecundity, courting males also evaluate female receptivity because it directly affects a male’s probability of mating (i.e. due to females’ motivation to copulate).&quot;</skos:example>
        <skos:example>&quot;In C. anna and Panterpe, females may choose to mate with any male on a superior territory. In effect, they will select the end product of competition among males. This phenomenon may be widespread in species with promiscuous mating systems (including leks) where contact between the sexes is fleeting and territory quality may be more easily assessed than any subtle quality of the male himself.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001023"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Inspection which evaluates some quality.</owl:annotatedTarget>
        <dc:source>doi:10.2307/1367674</dc:source>
        <skos:scopeNote>&quot;Initial contact is made by the female flying to the male’s territory and attempting to feed; she may have previously visited several other territories in order to evaluate territory quality.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001023"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">resource inspection</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001023"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...male guppies (Poecilia reticulata)...

In addition to fecundity, courting males also evaluate female receptivity because it directly affects a male’s probability of mating (i.e. due to females’ motivation to copulate).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s00265-010-0980-6</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001023"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In C. anna and Panterpe, females may choose to mate with any male on a superior territory. In effect, they will select the end product of competition among males. This phenomenon may be widespread in species with promiscuous mating systems (including leks) where contact between the sexes is fleeting and territory quality may be more easily assessed than any subtle quality of the male himself.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.2307/1367674</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000485"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008811"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-05T08:01:56.90419Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Copulation that involves the insertion of a male organ into the female to facilitate insemination.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>intromission</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">intromission copulation</rdfs:label>
        <skos:example>&quot;Hanuman langurs (Semnopithecus entellus)...

...copulation with ejaculation (male mounts female and following intromission and thrusting the male “freezes” on top of the female);&quot;</skos:example>
        <skos:example>&quot;Spiders carry two independent sperm reservoirs in their palps, each typically destined to fill one of the paired female spermathecae. To transfer the full amount of sperm, a male must use both palps, i.e. copulate either in a symmetric position with simultaneous intromission or in alternating two-sided positions. In fact, with the exception of Tidarren, all male spiders do, or at least try to, inseminate both sides of the female.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001024"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Copulation that involves the insertion of a male organ into the female to facilitate insemination.</owl:annotatedTarget>
        <rdfs:comment>&quot;Intromission is a step of sexual reproduction that involves the insertion of a male intromittent organ into the cavity of a female reproductive organ to facilitate insemination and internal fertilization.&quot;</rdfs:comment>
        <rdfs:isDefinedBy>doi:10.1007/978-3-319-47829-6_346-1</rdfs:isDefinedBy>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001024"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>intromission</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001024"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">intromission copulation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001024"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Hanuman langurs (Semnopithecus entellus)...

...copulation with ejaculation (male mounts female and following intromission and thrusting the male “freezes” on top of the female);&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s002650100391</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001024"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Spiders carry two independent sperm reservoirs in their palps, each typically destined to fill one of the paired female spermathecae. To transfer the full amount of sperm, a male must use both palps, i.e. copulate either in a symmetric position with simultaneous intromission or in alternating two-sided positions. In fact, with the exception of Tidarren, all male spiders do, or at least try to, inseminate both sides of the female.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1469-185X.2007.00029.x</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000388"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-05T09:34:13.868431Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym xml:lang="en">interruption competition</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Interference which interrupts another&apos;s reproductive attempt.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>courtship interruption</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>obstructing</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mating interference</rdfs:label>
        <skos:example>&quot;In Kafue lechwe, Kobus leche kafuensis, oestrous females that copulate with non-territorial males in their original herds are more than twice as likely to be interrupted by competing males while copulating compared with those mating with territorial males.&quot;</skos:example>
        <skos:example>&quot;The odd behavior of a small tuberculate male Campostoma anomalum (stoneroller) in breeding color disrupted 10 spawning sequences between the resident male and several female Nocomis leptocephalus (chub)... During six runs, the stoneroller physically obstructed both the female’s retroflexure and the male chub’s clasping motion.&quot;</skos:example>
        <skos:scopeNote>&quot;...the lengthy duration of plethodontid courtships may be costly by increasing the probability of interruptions from rival males...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001025"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget xml:lang="en">interruption competition</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
        <skos:scopeNote>&quot;...interrupted by competing...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001025"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Interference which interrupts another&apos;s reproductive attempt.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/s00265-010-0980-6</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001025"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>courtship interruption</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1007/s00265-010-0980-6</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001025"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>obstructing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001025"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>mating interference</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001025"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In Kafue lechwe, Kobus leche kafuensis, oestrous females that copulate with non-territorial males in their original herds are more than twice as likely to be interrupted by competing males while copulating compared with those mating with territorial males.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001025"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The odd behavior of a small tuberculate male Campostoma anomalum (stoneroller) in breeding color disrupted 10 spawning sequences between the resident male and several female Nocomis leptocephalus (chub)... During six runs, the stoneroller physically obstructed both the female’s retroflexure and the male chub’s clasping motion.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001025"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...the lengthy duration of plethodontid courtships may be costly by increasing the probability of interruptions from rival males...&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9781482294347</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-05T17:06:14.247512Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement that is a complex combinination of abduction, extension, pronation, and adduction.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>circumduction movement</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">circumducting movement</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001026"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement that is a complex combinination of abduction, extension, pronation, and adduction.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/icq147</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The cameras showed that circumduction is a complex movement combining in a very fast sequence abduction, extension and pronation, S-start-type fast-start (defined as torque–thrust), and adduction movements.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001026"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>circumduction movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1093/icb/icq147</dc:source>
        <skos:scopeNote>&quot;...circumduction is a complex movement...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001026"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">circumducting movement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0001027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0001027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001026"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008811"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-10-05T17:06:40.467433Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Circumduction which involves movement of the gonopodium towards the female’s urogenital sinus.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>gonopodial swing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">gonopodium circumduction</rdfs:label>
        <skos:example>&quot;During circumduction of the gonopodium, G. holbrooki as well as G. affinis males pronate the gonopodium prior to making contact with the female’s urogenital sinus. This pronation results in the gonopodium’s achieving its functional position (erect), with the dorsal groove now facing upwards.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001027"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Circumduction which involves movement of the gonopodium towards the female’s urogenital sinus.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/icq147</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In this review we use ‘‘circumduction of the gonopodium’’ versus ‘‘swing and thrust’’ to describe in an anatomically correct manner the movement of the gonopodium towards the female’s urogenital sinus.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001027"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>gonopodial swing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1007/s00265-010-0980-6</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001027"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">gonopodium circumduction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1093/icb/icq147</dc:source>
        <skos:scopeNote>&quot;...circumduction of the gonopodium...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001027"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;During circumduction of the gonopodium, G. holbrooki as well as G. affinis males pronate the gonopodium prior to making contact with the female’s urogenital sinus. This pronation results in the gonopodium’s achieving its functional position (erect), with the dorsal groove now facing upwards.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icq147</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500000"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/MF_0000020"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000105"/>
        <obo:IAO_0000115 xml:lang="en">An entity that exists in full at any time in which it exists at all, persists through time while maintaining its identity and has no temporal parts.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">BFO 2 Reference: Continuant entities are entities which can be sliced to yield parts only along the spatial dimension, yielding for example the parts of your table which we call its legs, its top, its nails. ‘My desk stretches from the window to the door. It has spatial parts, and can be sliced (in space) in two. With respect to time, however, a thing is a continuant.’ [60, p. 240</obo:IAO_0000116>
        <obo:IAO_0000116>Continuant doesn&apos;t have a closure axiom because the subclasses don&apos;t necessarily exhaust all possibilites. For example, in an expansion involving bringing in some of Ceuster&apos;s other portions of reality, questions are raised as to whether universals are continuants</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Continuant doesn&apos;t have a closure axiom because the subclasses don&apos;t necessarily exhaust all possibilites. For example, in an expansion involving bringing in some of Ceuster&apos;s other portions of reality, questions are raised as to whether universals are continuants</obo:IAO_0000116>
        <obo:IAO_0000600>A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity. (axiom label in BFO2 Reference: [008-002])</obo:IAO_0000600>
        <obo:IAO_0000600 xml:lang="en">A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity. (axiom label in BFO2 Reference: [008-002])</obo:IAO_0000600>
        <obo:IAO_0000601>if b is a continuant and if, for some t, c has_continuant_part b at t, then c is a continuant. (axiom label in BFO2 Reference: [126-001])</obo:IAO_0000601>
        <obo:IAO_0000601 xml:lang="en">if b is a continuant and if, for some t, c has_continuant_part b at t, then c is a continuant. (axiom label in BFO2 Reference: [126-001])</obo:IAO_0000601>
        <obo:IAO_0000601>if b is a continuant and if, for some t, cis continuant_part of b at t, then c is a continuant. (axiom label in BFO2 Reference: [009-002])</obo:IAO_0000601>
        <obo:IAO_0000601 xml:lang="en">if b is a continuant and if, for some t, cis continuant_part of b at t, then c is a continuant. (axiom label in BFO2 Reference: [009-002])</obo:IAO_0000601>
        <obo:IAO_0000601>if b is a material entity, then there is some temporal interval (referred to below as a one-dimensional temporal region) during which b exists. (axiom label in BFO2 Reference: [011-002])</obo:IAO_0000601>
        <obo:IAO_0000601 xml:lang="en">if b is a material entity, then there is some temporal interval (referred to below as a one-dimensional temporal region) during which b exists. (axiom label in BFO2 Reference: [011-002])</obo:IAO_0000601>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/bfo/REC/2018/04/bfo-2-0"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label>continuant</rdfs:label>
        <rdfs:label xml:lang="en">continuant</rdfs:label>
        <skos:definition>A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity. [BFO]</skos:definition>
        <skos:prefLabel>continuant</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000116"/>
        <owl:annotatedTarget>Continuant doesn&apos;t have a closure axiom because the subclasses don&apos;t necessarily exhaust all possibilites. For example, in an expansion involving bringing in some of Ceuster&apos;s other portions of reality, questions are raised as to whether universals are continuants</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/0000007"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000116"/>
        <owl:annotatedTarget xml:lang="en">Continuant doesn&apos;t have a closure axiom because the subclasses don&apos;t necessarily exhaust all possibilites. For example, in an expansion involving bringing in some of Ceuster&apos;s other portions of reality, questions are raised as to whether universals are continuants</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/0000007"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000600"/>
        <owl:annotatedTarget>A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity. (axiom label in BFO2 Reference: [008-002])</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/008-002"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000600"/>
        <owl:annotatedTarget xml:lang="en">A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity. (axiom label in BFO2 Reference: [008-002])</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/008-002"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000601"/>
        <owl:annotatedTarget>if b is a continuant and if, for some t, c has_continuant_part b at t, then c is a continuant. (axiom label in BFO2 Reference: [126-001])</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/126-001"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000601"/>
        <owl:annotatedTarget xml:lang="en">if b is a continuant and if, for some t, c has_continuant_part b at t, then c is a continuant. (axiom label in BFO2 Reference: [126-001])</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/126-001"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000601"/>
        <owl:annotatedTarget>if b is a continuant and if, for some t, cis continuant_part of b at t, then c is a continuant. (axiom label in BFO2 Reference: [009-002])</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/009-002"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000601"/>
        <owl:annotatedTarget xml:lang="en">if b is a continuant and if, for some t, cis continuant_part of b at t, then c is a continuant. (axiom label in BFO2 Reference: [009-002])</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/009-002"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
