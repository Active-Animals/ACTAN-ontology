    <!-- http://purl.obolibrary.org/obo/ACTAN_0000199 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001171"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-27T18:46:29.241989Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that temporarily stores kinetic and gravitational potential energy as elastic strain energy in muscles, tendons, and ligaments and then is nearly all recovered during the next movement phase.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">bounce</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>elasticity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pogo stick</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spring</oboInOwl:hasExactSynonym>
        <rdfs:label>bounce kinetics</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000199"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics that temporarily stores kinetic and gravitational potential energy as elastic strain energy in muscles, tendons, and ligaments and then is nearly all recovered during the next movement phase.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1126/science.288.5463.100</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;As a leg strikes the ground in a running gait, kinetic and gravitational potential energy is temporarily stored as elastic strain energy in muscles, tendons, and ligaments and then is nearly all recovered during the propulsive second half of the stance phase.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000199"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">bounce</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000199"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>elasticity</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
    </owl:Axiom>
