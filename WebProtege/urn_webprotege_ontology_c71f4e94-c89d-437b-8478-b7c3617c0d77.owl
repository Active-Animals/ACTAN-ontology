                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000169"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-16T15:00:28.269452Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Swimming-gait in which abdominal muscles produce a powerful tail flick during rare, but critical, escape behaviors.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">tail-flipping</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">tail-flip gait</rdfs:label>
        <skos:example>&quot;In crayfish.... Fighting usually stops when one individual retreats (using a tail flip) or crawls away from the opponent.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000842"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Swimming-gait in which abdominal muscles produce a powerful tail flick during rare, but critical, escape behaviors.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1126/science.288.5463.100</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;40% of the body mass of a shrimp is devoted to the large, tasty abdominal muscles that produce a powerful tail flick during rare, but critical, escape behaviors.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000842"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">tail-flipping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1002/jnr.24550</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000842"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">tail-flip gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000842"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In crayfish.... Fighting usually stops when one individual retreats (using a tail flip) or crawls away from the opponent.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1002/jnr.24550</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000843 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000843">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000639"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002102"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-02T10:50:10.202007Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Abduction that results from forelimb abducting.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>abducted forelimb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>humeral abduction</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>humerus-abducted</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">forelimb abduction</rdfs:label>
        <skos:scopeNote>&quot;The ability of apes and atelines to completely abduct their forelimb during forelimb-suspension has musculoskeletal implications that require that this mode be distinguished from, e.g. quadrupedal grasp-walking or flexed-elbow vertical climbing.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000843"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Abduction that results from forelimb abducting.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1002/ajpa.1330870108</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Suspensory modes in which half or more of the body weight depended on a fully abducted forelimb were pooled under the label “arm-hanging (all modes).”&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000843"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>abducted forelimb</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000843"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>humeral abduction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000843"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>humerus-abducted</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000843"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">forelimb abduction</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000843"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The ability of apes and atelines to completely abduct their forelimb during forelimb-suspension has musculoskeletal implications that require that this mode be distinguished from, e.g. quadrupedal grasp-walking or flexed-elbow vertical climbing.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000844 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000844">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000678"/>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-16T16:53:29.231386Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flick which involves a fin.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>fin flickering</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">flickering the fins</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>flicking of the first dorsal fin</oboInOwl:hasNarrowSynonym>
        <rdfs:label>fin flick</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000708"/>
        <skos:example>&quot;Badis badis...
Comfort movements recorded include fin flickering and rubbing, chafing, flexing the body, coughing, and yawning.&quot;</skos:example>
        <skos:scopeNote>&quot;Flickering the pelvics. With rather great frequency, the pelvics are repeatedly erected a little and brought back again.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000844"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flick which involves a fin.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/s10682-007-9183-7</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Courtship displays of R. decemdigitatus consisted of 11 steps: ... (iv) flicking of the first dorsal fin...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000844"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>fin flickering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000844"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">flickering the fins</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000844"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>flicking of the first dorsal fin</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2008</dc:date>
        <dc:source>doi:10.1007/s10682-007-9183-7</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000844"/>
