        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The triglids, for example, are able to creep slowly over the bottom by means of the free pectoral rays. The motion is produced by placing the tips of the rays in contact with the bottom and pushing backwards.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
