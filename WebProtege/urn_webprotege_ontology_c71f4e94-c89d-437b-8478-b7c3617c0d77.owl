    <!-- http://purl.obolibrary.org/obo/ACTAN_0000863 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000863">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000462"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_21001215"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_environmental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-03T16:37:24.002305Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Camouflaging in which the body surface closest to the ambient light source is darker in colour than the body surface furthest from the light source.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">countershading</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">countershading camouflaging</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000863"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Camouflaging in which the body surface closest to the ambient light source is darker in colour than the body surface furthest from the light source.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1098/rspb.2015.2890</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In countershaded prey, the body surface closest to the ambient light source (often the dorsal surface unless the species rests upside-down) is darker in colour than the body surface furthest from the light source.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000863"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">countershading</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000863"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">countershading camouflaging</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000864 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000864">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000513"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002277"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/colouration"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-03T16:38:52.573726Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Colouration in which a gloss is effected.

This can be due to the arrangement of guanine crystals in skin cells.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>iridescent</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">irising</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>silvering</oboInOwl:hasNarrowSynonym>
        <rdfs:label>iridescence colouration</rdfs:label>
        <skos:example>&quot;Aequidens latifrons...
A great many blue irising spots (&quot;jewels&quot;) distributed over the whole body, and particularly on the throat, gill cover and belly, give the fish a bluish hue (guanocytes of system V).&quot;</skos:example>
        <skos:scopeNote>&quot;Guanocytes may occur in different layers in varying but often high concentrations. They are responsible for certain effects in the total colour appearance of the fish, for instance silverish white, yellow, green, or blue colours, They also build up the irising patches and the bright rings round dark spots.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000864"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Colouration in which a gloss is effected.

This can be due to the arrangement of guanine crystals in skin cells.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000864"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>iridescent</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1993</dc:date>
        <dc:source>ISBN:9780226315737</dc:source>
    </owl:Axiom>
