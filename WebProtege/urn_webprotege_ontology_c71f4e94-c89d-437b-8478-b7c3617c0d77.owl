                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000421"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000534"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000068"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000637"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-18T08:15:37.103958Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flying-gait which is lift-based.

This results in smaller variations in speed.</oboInOwl:hasDefinition>
        <rdfs:label>pitching gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000634"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flying-gait which is lift-based.

This results in smaller variations in speed.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1088/1748-3182/9/1/011001</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;This lift based technique is proven to achieve higher propulsive efficiency than drag based propulsion mechanisms.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000634"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>pitching gait</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2017</dc:date>
        <dc:source>doi:10.1017/jfm.2017.173</dc:source>
        <rdfs:comment>Note that this source uses this term in a broader sense (appendages rotating about their leading edge to attain continuous horizontal thrust) although it retains a focus on wings, whereas we are allowing sufficient up and down to allow for vertical thrust.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000635 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000075"/>
