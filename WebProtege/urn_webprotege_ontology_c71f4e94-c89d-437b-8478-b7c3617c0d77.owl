    <!-- http://purl.obolibrary.org/obo/ACTAN_0000942 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000942">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000941"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002103"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-02T14:25:09.316401Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Retraction that results from hindlimb retracting.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">hindlimb retraction</rdfs:label>
        <skos:example>&quot;...it is likely that two-toed sloths are controlling their center of mass position through the mechanism... in which interlimb coordination is timed so that a protracted propulsive forelimb early in its support phase is synchronized with a retracted ipsilateral braking hind limb late in its support phase.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000942"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Retraction that results from hindlimb retracting.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000942"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">hindlimb retraction</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000942"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...it is likely that two-toed sloths are controlling their center of mass position through the mechanism... in which interlimb coordination is timed so that a protracted propulsive forelimb early in its support phase is synchronized with a retracted ipsilateral braking hind limb late in its support phase.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/jzo.12455</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000943 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000018"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002101"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-02T18:59:51.882855Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Tucking that involves a limb.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>foot burying</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>foot tucking</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>leg tucking</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">limb tucking</rdfs:label>
        <skos:scopeNote>&quot;The function of burying one foot in the flanks is probably, as HEINROTH (1991) suggested, to keep it warm.... Mallards will tuck the feet forward in the flank feathers while flying in sub-zero temperatures...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000943"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Tucking that involves a limb.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000943"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>foot burying</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
        <skos:scopeNote>&quot;...burying one foot...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000943"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>foot tucking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
        <skos:scopeNote>&quot;...tuck the feet...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000943"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>leg tucking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1993</dc:date>
        <dc:source>doi:10.1007/BF00197760</dc:source>
        <skos:scopeNote>&quot;...tuck their legs underneath;&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000943"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">limb tucking</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000943"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The function of burying one foot in the flanks is probably, as HEINROTH (1991) suggested, to keep it warm.... Mallards will tuck the feet forward in the flank feathers while flying in sub-zero temperatures...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000944 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000944">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000018"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-02T19:00:02.460318Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Tucking that involves the head.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">head tucking</rdfs:label>
        <skos:example>&quot;Chimpanzee...
The head is mostly kept rather low and tucked back between the shoulders which are pulled upwards.&quot;</skos:example>
        <skos:scopeNote>&quot;Larger snakes have better venom delivery systems and can first warn a predator. If the predator does not respond to the aposematic signal, they can deliver a few effective bites, then cover up their heads and withstand a brief attack while they wait for the envenomation to repel the attacker.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000944"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Tucking that involves the head.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/auk/123.4.967</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;...tucking head to wrist;&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000944"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">head tucking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2006</dc:date>
        <dc:source>doi:10.1093/auk/123.4.967</dc:source>
        <skos:scopeNote>&quot;...tucking head...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000944"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Chimpanzee...
The head is mostly kept rather low and tucked back between the shoulders which are pulled upwards.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000944"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Larger snakes have better venom delivery systems and can first warn a predator. If the predator does not respond to the aposematic signal, they can deliver a few effective bites, then cover up their heads and withstand a brief attack while they wait for the envenomation to repel the attacker.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000945 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000945">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000018"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002415"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-02T19:00:15.90808Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Tucking that involves the tail.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">tail tucking</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000945"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Tucking that involves the tail.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Or again, the folded wing might be held lower, along side and flank, so that wing tip lay against the ventral surface of the tail, as the tail was tucked under and pressed forward.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000945"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">tail tucking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
        <skos:scopeNote>&quot;...tail was tucked...&quot;</skos:scopeNote>
    </owl:Axiom>
    


