                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000929"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-06T16:43:42.415173Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Swimming-regime that actively approaches the air-water boundary from below.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">surfacing</oboInOwl:hasExactSynonym>
        <rdfs:label>surfacing regime</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000403"/>
        <skos:example>&quot;Mustelus canis when chafed by confinement will often swim up vertically through the surface of the water and hold a position with the fore part of the body exposed for some time by the continued action of the submerged hind portion. Over one-third of the body is often so lifted, and for shorter times even as much as one-half has been noted. This gives a measure of the force exerted, for it is not a matter of momentum as in leaping, but simply a direct and continued “push.”&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000575"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Swimming-regime that actively approaches the air-water boundary from below.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000575"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">surfacing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000575"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>surfacing regime</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000575"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Mustelus canis when chafed by confinement will often swim up vertically through the surface of the water and hold a position with the fore part of the body exposed for some time by the continued action of the submerged hind portion. Over one-third of the body is often so lifted, and for shorter times even as much as one-half has been noted. This gives a measure of the force exerted, for it is not a matter of momentum as in leaping, but simply a direct and continued “push.”&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000576 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000576">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0008306"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-06T20:20:24.584795Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Assessment in which an individual accepts that local risks are low.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">safety</oboInOwl:hasExactSynonym>
        <rdfs:label>safety assessment</rdfs:label>
        <skos:scopeNote>&quot;Much of animal architecture functions as a physical barrier between organisms and a potentially hostile outside environment, thereby enabling critical activities (e.g. sleep, growth, care for offspring, and socializing) within the safety of the architecture.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;We could imagine that living in herds is safer because animals assist each other in watching for enemies...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000576"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Assessment in which an individual accepts that local risks are low.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.3389/fetho.2023.1238167</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000576"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">safety</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000576"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>safety assessment</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000576"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Much of animal architecture functions as a physical barrier between organisms and a potentially hostile outside environment, thereby enabling critical activities (e.g. sleep, growth, care for offspring, and socializing) within the safety of the architecture.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.cub.2021.09.082</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000576"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;We could imagine that living in herds is safer because animals assist each other in watching for enemies...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000577 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000308"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000544"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-06T20:21:58.644093Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Residence that establishes a key location which the animal spends more time in, and repeatedly returns to after exploring.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">home base</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lived in</oboInOwl:hasExactSynonym>
        <rdfs:comment>Puzzle: beds may not always be nests, and dens may not always be bases, if bases must be returned to. More thought about this branch is needed.</rdfs:comment>
        <rdfs:label>basing residence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000294"/>
        <skos:example>&quot;A common bear den is generally composed of three compartments: (1) an entrance; (2) a tunnel that connects the entrance with the resting chamber; and (3) a chamber occupied by the nest, that is, the zone where the bear gathers vegetative material to build a bed.&quot;</skos:example>
        <skos:example>&quot;In coral reef fish communities we find several species foraging in the water column from a &quot;home base&quot; on the reef within a relatively restricted habitat or home range.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000577"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Residence that establishes a key location which the animal spends more time in, and repeatedly returns to after exploring.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000577"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">home base</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1973</dc:date>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000577"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>lived in</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000577"/>
