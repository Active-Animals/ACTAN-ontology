        <oboInOwl:hasDefinition>Trot gait that realizes a quadrupedal, suspended, running pattern.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">running trot</oboInOwl:hasExactSynonym>
