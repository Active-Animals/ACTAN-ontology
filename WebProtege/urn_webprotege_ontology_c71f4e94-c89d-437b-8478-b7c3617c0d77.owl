    <!-- http://purl.obolibrary.org/obo/ACTAN_0000519 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000368"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003942"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-01T14:21:23.941531Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Taxis that is temperature-dependent.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">thermo-taxis</rdfs:label>
        <skos:closeMatch>NBO:0000384</skos:closeMatch>
        <skos:example>&quot;C. elegans senses a wide range of temperature, and execute thermotaxis to stay at a preferred temperature in the ‘innocuous range’ of 13–25 °C, while avoiding extreme ‘noxious’ temperatures.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000519"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Taxis that is temperature-dependent.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1038/s41467-023-38685-1</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Whereas short-lasting processes (second–minutes timescale) underlying temperature-dependent navigation in spatial thermogradient has been extensively studied, we know surprisingly little on temperature-dependent persistent behavioral states and transitions over longer timescales.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000519"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">thermo-taxis</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>doi:10.1038/s41467-023-38685-1</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000519"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;C. elegans senses a wide range of temperature, and execute thermotaxis to stay at a preferred temperature in the ‘innocuous range’ of 13–25 °C, while avoiding extreme ‘noxious’ temperatures.&quot;</owl:annotatedTarget>
        <rdfs:comment>doi:10.1038/s41467-023-38685-1</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000520 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000520">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000368"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005726"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-01T14:21:34.691476Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Taxis that has chemical sensitivity.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>chemoattractant</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">chemo-taxis</rdfs:label>
        <skos:closeMatch>NBO:0000377</skos:closeMatch>
        <skos:example>&quot;... for zebrafish. Chemically-mediated attraction behaviors are diverse and include appetitive olfactory behavior (elicited by L-alanine, food extract and others), chemically mediated kin recognition and sexual aggregating behavior (elicited by sex pheromones). Usually characterized by higher speed as fish follow the increasing concentrations of chemoattractants and by slower speed when fish locate the signal source.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000520"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Taxis that has chemical sensitivity.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/s002850050112</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000520"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>chemoattractant</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>doi:10.1007/s002850050112</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000520"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">chemo-taxis</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>doi:10.1007/s002850050112</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000520"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;... for zebrafish. Chemically-mediated attraction behaviors are diverse and include appetitive olfactory behavior (elicited by L-alanine, food extract and others), chemically mediated kin recognition and sexual aggregating behavior (elicited by sex pheromones). Usually characterized by higher speed as fish follow the increasing concentrations of chemoattractants and by slower speed when fish locate the signal source.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000521 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000521">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000126"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002097"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-07T10:21:16.555706Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Gait pattern in which the skin periodically shortens and lengthens while this portion of the skin oscillates longitudinally relative to the underlying skeleton.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">rectilinear mode</oboInOwl:hasExactSynonym>
        <rdfs:label>rectilinear pattern</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000521"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Gait pattern in which the skin periodically shortens and lengthens while this portion of the skin oscillates longitudinally relative to the underlying skeleton.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/icaa017</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The ventral and ventro-lateral skin of snakes during rectilinear locomotion periodically shortens and lengthens while this portion of the skin oscillates longitudinally relative to the underlying skeleton.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000521"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">rectilinear mode</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1093/icb/icaa017</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000521"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>rectilinear pattern</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000522 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000522">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000690"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-14T09:41:41.228267Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement that is short and intermittent, reducing the smoothness of its trajectory.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">jerking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>jerky movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>jittery</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>twitch</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>twitching</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>jolt</oboInOwl:hasRelatedSynonym>
        <rdfs:label>jerking movement</rdfs:label>
        <skos:example>&quot;...to remove a branch or reed close to the nest the bird grasps it in its beak and violently jerks it back-and-forth.&quot;</skos:example>
        <skos:example>&quot;The head is bent sideways over a small angle and brought back again. Often this movement is repeated to the left and to the right. The centre of the movement lies close behind the operculae (atlas). As long as the movement was carried out when the fish rests in a horizontal position and the tail made no appreciable lateral movements, we call this action jerking. We observed this jerking regularly among the courtship actions of Cichlasoma, Aequidens, Hemichromis and Astronotus. In Pterphyllum we observed a similar attitude during interterritorial flights.&quot;</skos:example>
        <skos:example>&quot;cleaner shrimp... eat healthy client tissue (potentially indicated by a sharp twitch or ‘jolt,’ thought to indicate a painful pinch, to which clients may respond by retaliating... &quot;</skos:example>
        <skos:scopeNote>&quot;Jerking gradually merges into quivering. The position of the fish becomes more vertical (the head downward), the body waves become stronger, and the tail is swept appreciably sideways. In most species a high intensity is marked by the almost vertical position of the longitudinal axis of the fish, and the violent lateral beats of the tail.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000522"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement that is short and intermittent, reducing the smoothness of its trajectory.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
