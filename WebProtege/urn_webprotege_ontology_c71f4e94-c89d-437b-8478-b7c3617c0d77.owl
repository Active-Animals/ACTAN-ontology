        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001711"/>
        <obo:IAO_0000115>A perimeter which is relatively low.</obo:IAO_0000115>
        <rdfs:label>decreased perimeter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001718 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001718">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001296"/>
