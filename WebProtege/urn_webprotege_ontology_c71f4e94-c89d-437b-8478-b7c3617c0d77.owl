        <oboInOwl:hasDefinition>Wash routine in which the bill is put in water and immediately lifted out, with no uptilting.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">bill-dipping</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">bill-dip routine</rdfs:label>
    </owl:Class>
