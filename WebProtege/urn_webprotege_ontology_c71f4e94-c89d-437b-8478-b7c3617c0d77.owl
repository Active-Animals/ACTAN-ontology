    <!-- http://purl.obolibrary.org/obo/ACTAN_0000687 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000687">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000686"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000168"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_manoeuvre"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-07T18:39:01.820614Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Rotation that yawing culminates in.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">sideward</oboInOwl:hasExactSynonym>
        <rdfs:label>yaw rotation</rdfs:label>
        <skos:scopeNote>&quot;...lateral sequence facilitates undulation of the spine, which rotates the girdles and lengthens the step...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;In Ectopsocus briggsi, this sideward turning of the male was interpreted to occur after copulation, as a process that actually terminates copulation.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Positive defense consists of spreading the fins. This may be accompanied by rotating the body slightly, presenting the erect dorsal fin spines to the object eliciting the behavior.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000687"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Rotation that yawing culminates in.</owl:annotatedTarget>
        <rdfs:comment>Directly inferred..</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000687"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">sideward</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2007</dc:date>
        <dc:source>doi:10.1111/j.1469-185X.2007.00029.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000687"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>yaw rotation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000687"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...lateral sequence facilitates undulation of the spine, which rotates the girdles and lengthens the step...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000687"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In Ectopsocus briggsi, this sideward turning of the male was interpreted to occur after copulation, as a process that actually terminates copulation.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1469-185X.2007.00029.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000687"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Positive defense consists of spreading the fins. This may be accompanied by rotating the body slightly, presenting the erect dorsal fin spines to the object eliciting the behavior.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000688 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000688">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000690"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000625"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001653"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-07T18:39:29.855996Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Roll that inverts the normal inclination relative to gravity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">upside-down</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">upside-down roll</rdfs:label>
        <skos:example>&quot;Aequidens latifrons...
When it has come down the larva lies on its back, under the yolk mass.&quot;</skos:example>
        <skos:example>&quot;The hanging parakeets (Loriculus) sleep hanging upsided own, and the related Agapornis pullaria also sometimes sleep in this position.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000688"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Roll that inverts the normal inclination relative to gravity.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
        <dc:source>doi:10.1111/eff.12212</dc:source>
        <skos:scopeNote>&quot;(i.e., the body inclination... decreases with the gravity).&quot; (doi:10.1089/zeb.2012.0861)</skos:scopeNote>
        <skos:scopeNote>&quot;Then, the fish turns in a normal position (dorsal fin facing the surface) and after a very short period (up to 1 s) the fish turns upside down again, repeating this pattern up to 3 or 4 times.&quot; (doi:10.1111/eff.12212)</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000688"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">upside-down</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000688"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">upside-down roll</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000688"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Aequidens latifrons...
When it has come down the larva lies on its back, under the yolk mass.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000688"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The hanging parakeets (Loriculus) sleep hanging upsided own, and the related Agapornis pullaria also sometimes sleep in this position.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000689 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000689">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000563"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000692"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_manoeuvre"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-07T18:41:20.234141Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Tilt that results from pitching.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">pitching</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tipped</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>standing vertically, head downward</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>trim</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">up-ending</oboInOwl:hasNarrowSynonym>
        <rdfs:label>pitch tilt</rdfs:label>
        <skos:example>&quot;&quot;Neck-dipping&quot; is the main pre-copulatory movement of both male and female... In Anser... the birds may also up-end as in feeding or in bringing up food for the young;&quot;</skos:example>
        <skos:example>&quot;Aeoliscus strigatus (Gunther) and other members of this group swim with the axis practically vertical for most part although they may assume any other position.&quot;</skos:example>
        <skos:scopeNote>&quot;Despite the advantages of maintaining horizontal trim for typical fishes, various fishes can swim or float with different orientations.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000689"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Tilt that results from pitching.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
