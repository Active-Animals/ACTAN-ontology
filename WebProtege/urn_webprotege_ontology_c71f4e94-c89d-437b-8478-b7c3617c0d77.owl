        <oboInOwl:hasDefinition>Climbing gait in which a horizontal support is grasped by both hands and the body is lifted by retracting the humerus and flexing the elbow.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>hauling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hoisting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">pull-up</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">pull-up gait</rdfs:label>
    </owl:Class>
