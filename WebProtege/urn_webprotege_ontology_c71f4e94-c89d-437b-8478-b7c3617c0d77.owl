    <!-- http://purl.obolibrary.org/obo/ACTAN_0000738 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000738">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002131"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-06-10T19:32:33.494096Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>opening</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Movement that excurs laterally away from the body.

This represents the up stroke (anterior) in flapping.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>abducing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">abducting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>abduction</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>raising</oboInOwl:hasRelatedSynonym>
        <rdfs:label>abducting movement</rdfs:label>
        <skos:example>&quot;Hawkfish do beat their pectoral fins during swimming. In our recordings pectoral fin movement was always performed in concert with the caudal fin beats and always with symmetrical abduction and adduction between the left and right pectoral fins.&quot;</skos:example>
        <skos:scopeNote>&quot;...inconsistencies concerning the movements characterizing each phase do appear in the literature. Generally, during abduction, the fin is moved away from the body and downwards. It is then brought back to the body surface (adduction phase) and, during refraction, the fin is orientated to its original position by rotation of the leading edge. Due to the subtlety of these movements, the angle of attack for the fin changes during each phase. As a result, the lift forces generated have an elevation as well as a thrust component that causes the body to move up and down during normal forward swimming..&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Even in those filters that are relatively rigid, such as the gill rakers of fishes and the lamellae of birds, the porosity varies as the gill arches abduct and adduct or the jaws open and close, respectively.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000738"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>opening</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000738"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement that excurs laterally away from the body.

This represents the up stroke (anterior) in flapping.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1242/jeb.204.8.1459</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Pectoral fin-beat cycles started with the fins pressed against the body (maximally adducted), moving away (abducting) from the body to some maximum point of excursion and returning (adducting) to the original position...
Since the dorsal and anal fins beat synchronously, this will smooth the lateral forces produced by the motions of the pectoral fins and perhaps balance increasing fluid in the side forces of the dorsal/anal fin complex.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000738"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>abducing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000738"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">abducting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
        <skos:scopeNote>&quot;...the pelvic fins are abducted now and then...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000738"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>abduction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000738"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>raising</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000738"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>abducting movement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000738"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Hawkfish do beat their pectoral fins during swimming. In our recordings pectoral fin movement was always performed in concert with the caudal fin beats and always with symmetrical abduction and adduction between the left and right pectoral fins.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icac061</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000738"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...inconsistencies concerning the movements characterizing each phase do appear in the literature. Generally, during abduction, the fin is moved away from the body and downwards. It is then brought back to the body surface (adduction phase) and, during refraction, the fin is orientated to its original position by rotation of the leading edge. Due to the subtlety of these movements, the angle of attack for the fin changes during each phase. As a result, the lift forces generated have an elevation as well as a thrust component that causes the body to move up and down during normal forward swimming..&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000738"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Even in those filters that are relatively rigid, such as the gill rakers of fishes and the lamellae of birds, the porosity varies as the gill arches abduct and adduct or the jaws open and close, respectively.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9780226315737</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000739 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000739">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002133"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-06-10T19:32:44.509137Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>closing</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>folding</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Movement that returns laterally towards the body.

This represents the down stroke (posterior) in flapping.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>adducing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">adducting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adduction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>clapped against</oboInOwl:hasExactSynonym>
        <rdfs:label>adducting movement</rdfs:label>
        <skos:example>&quot;Hawkfish do beat their pectoral fins during swimming. In our recordings pectoral fin movement was always performed in concert with the caudal fin beats and always with symmetrical abduction and adduction between the left and right pectoral fins.&quot;</skos:example>
        <skos:scopeNote>&quot;...inconsistencies concerning the movements characterizing each phase do appear in the literature. Generally, during abduction, the fin is moved away from the body and downwards. It is then brought back to the body surface (adduction phase) and, during refraction, the fin is orientated to its original position by rotation of the leading edge. Due to the subtlety of these movements, the angle of attack for the fin changes during each phase. As a result, the lift forces generated have an elevation as well as a thrust component that causes the body to move up and down during normal forward swimming..&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Even in those filters that are relatively rigid, such as the gill rakers of fishes and the lamellae of birds, the porosity varies as the gill arches abduct and adduct or the jaws open and close, respectively.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;In most bivalves, contraction of the pedal retractors is accompanied by a quick adduction of the valves, which squeezes water out of the mantle cavity and into the sediment below the shell.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000739"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>closing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000739"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>folding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000739"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement that returns laterally towards the body.

This represents the down stroke (posterior) in flapping.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000739"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>adducing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000739"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">adducting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1991</dc:date>
        <dc:source>doi:10.1111/j.1365-3121.1991.tb00141.x</dc:source>
        <skos:scopeNote>&quot;...the valves are slightly adducted to release their grip...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000739"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>adduction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000739"/>
