        <oboInOwl:id>PATO:0002017</oboInOwl:id>
        <rdfs:label>increased magnitude</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002007"/>
        <obo:IAO_0000115>A convex 3-D shape quality inhering in a bearer by virtue of the bearer&apos;s resembling a cone (a 3-D shape with a round cross section that tapers).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Image:http://upload.wikimedia.org/wikipedia/commons/d/d2/Cone_3d.png</oboInOwl:hasDbXref>
