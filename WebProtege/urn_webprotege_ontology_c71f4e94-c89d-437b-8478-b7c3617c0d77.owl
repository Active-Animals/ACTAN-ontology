        <oboInOwl:creation_date>2025-04-21T12:05:09.342805Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Aggregation which is 3-dimensional, rotating, milling, and has no boundary interactions.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">torus</oboInOwl:hasExactSynonym>
        <rdfs:label>torus aggregation</rdfs:label>
        <skos:scopeNote>&quot;...shiner schools exhibit... a milling state, where each fish moves around the center of the group.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Copepods within a swarm were hopping up and sinking down against the slight water current with their heads diagonally downward.&quot;</skos:scopeNote>
    </owl:Class>
