                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000138"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-01-21T16:31:51.834262Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Walk gait that realizes an octapedal pattern.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">alternating tetrapod gait walking</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">alternating-tetrapod-walk gait</rdfs:label>
        <skos:example>&quot;Fiddler crabs and shore crabs used an alternating tetrapod gait significantly more often than all other gaits combined both on land and underwater.&quot;</skos:example>
    </owl:Class>
