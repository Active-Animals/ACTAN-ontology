    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000346"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Warmer over wintering sites also provide superior thermo regulatory opportunities to pre- and post-emergent snakes, helping prepare individuals for brumation (e.g. purging the gut of food) or ‘kick-starting’ physiological processes (e.g. metabolic rates) for rapid resumption of active season activities.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3354/esr01312</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000347 -->

