    <!-- http://purl.obolibrary.org/obo/PATO_0001652 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001652">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000140"/>
        <oboInOwl:hasDefinition>Definition: A spatial quality inhering in a bearer by virtue of the bearer&apos;s spatial positioning with respect to an additional entity.</oboInOwl:hasDefinition>
        <rdfs:label>alignment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001653 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001653">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001652"/>
        <oboInOwl:hasDefinition>Definition: An alignment quality inhering in a bearer by virtue of the bearer&apos;s being in a proper spatial positioning with respect to an additional entity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>aligned</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>aligned to</oboInOwl:hasRelatedSynonym>
        <rdfs:label>aligned with</rdfs:label>
    </owl:Class>
    


