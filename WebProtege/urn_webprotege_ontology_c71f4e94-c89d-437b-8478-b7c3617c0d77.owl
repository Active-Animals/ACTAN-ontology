                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000530"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-19T21:24:29.941125Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Swimming-regime in which passive gliding descents are interspersed with ascents characteristic of active propulsion.

Marine animals appear at times to face the problem of not having enough ‘effective weight’ to undulate.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>undulating flight in water</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">undulating swimming</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>undulatory swimming</oboInOwl:hasExactSynonym>
        <rdfs:label>undulating-swimming regime</rdfs:label>
        <skos:example>&quot;We found no evidence of intermittent locomotion by elephant seals at depths shallower than ~15 m, probably as a result of animals being near neutral buoyancy, whereas at deeper depths seals would swim intermittently, likely due to their increased overall density.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000532"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Swimming-regime in which passive gliding descents are interspersed with ascents characteristic of active propulsion.

Marine animals appear at times to face the problem of not having enough ‘effective weight’ to undulate.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1038/ncomms1350</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;All four species performed undulating flight, where passive gliding descents are interspersed with ascents characteristic of active propulsion.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000532"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>undulating flight in water</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2011</dc:date>
        <dc:source>doi:10.1038/ncomms1350</dc:source>
    </owl:Axiom>
