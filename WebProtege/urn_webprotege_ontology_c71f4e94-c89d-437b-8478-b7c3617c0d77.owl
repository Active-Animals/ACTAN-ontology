            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000056"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000135"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000187"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-06T15:11:57.126591Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Traversing-gait that is pronograde, suspended, and has a symmetric gait, with musculoskeletal elements in net tension.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>below branch quadrupedal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>inverted quadrupedal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>inverted walking</oboInOwl:hasRelatedSynonym>
        <rdfs:label>inverted-quadrupedal gait</rdfs:label>
        <skos:example>&quot;...unclear what, if any, advantage a DSDC gait might have during inverted walking. Yet, DSDC gaits are present in sloths and primates during below branch quadrupedal locomotion, although their use is highly variable.&quot;</skos:example>
        <skos:scopeNote>&quot;Due to the tendency for sloths to utilize diagonal-couplet gaits and similar contact times in both fore limbs and hindlimbs it is possible that this coordination of equal forces generated by contralateral limbs (e.g. the left forelimb and right hind limb) can act to ‘grip’ the arboreal support in the way observed in other arboreal mammals.&quot;</skos:scopeNote>
        <skos:scopeNote>This mode is often accompanied by the grasp of a prehensile tail in atelines and Cebus (exemplar: lorises).</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000260"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Traversing-gait that is pronograde, suspended, and has a symmetric gait, with musculoskeletal elements in net tension.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000260"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>below branch quadrupedal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2017</dc:date>
        <dc:source>doi:10.1111/jzo.12455</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000260"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>inverted quadrupedal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000260"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>inverted walking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2017</dc:date>
        <dc:source>doi:10.1111/jzo.12455</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000260"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>inverted-quadrupedal gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000260"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...unclear what, if any, advantage a DSDC gait might have during inverted walking. Yet, DSDC gaits are present in sloths and primates during below branch quadrupedal locomotion, although their use is highly variable.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/jzo.12455</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000260"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Due to the tendency for sloths to utilize diagonal-couplet gaits and similar contact times in both fore limbs and hindlimbs it is possible that this coordination of equal forces generated by contralateral limbs (e.g. the left forelimb and right hind limb) can act to ‘grip’ the arboreal support in the way observed in other arboreal mammals.&quot;</owl:annotatedTarget>
        <rdfs:comment>doi:10.1111/jzo.12455</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000260"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>This mode is often accompanied by the grasp of a prehensile tail in atelines and Cebus (exemplar: lorises).</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    


