    <!-- http://purl.obolibrary.org/obo/ACTAN_0000184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000179"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000814"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-23T20:53:34.132498Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mould which takes effect when using a weight bearing structure.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>supported mode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>arboreal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">supported</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>terrestrial</oboInOwl:hasRelatedSynonym>
        <rdfs:label>supported mould</rdfs:label>
        <skos:scopeNote>&quot;&quot;Substrate&quot; is commonly used to refer to a weight bearing structure on top of which a study subject stands or locomotes. Likewise, &quot;superstrate&quot; is a structure from which an animal suspends itself. We use &quot;support&quot; to mean both or either.&quot;</skos:scopeNote>
        <skos:scopeNote>&apos;Terrestrial&apos;, &apos;arboreal&apos;, and &apos;aerial&apos; can have alternate definitions in the context of forest canopy biology.</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000184"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mould which takes effect when using a weight bearing structure.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000184"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>supported mode</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1007/BF02381373</dc:source>
        <rdfs:comment>Although the source distinguishes between supported and suspensory forms of locomotion, it has not teased out the difference between this and the environmental material in use. In doing so, we are facilitating semantic drift towards the use of the term &apos;supported mode&apos; to focus on the environmental material, and pushing the difference into its sub-classes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000184"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>arboreal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000184"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">supported</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000184"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>terrestrial</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000184"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>supported mould</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000184"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;&quot;Substrate&quot; is commonly used to refer to a weight bearing structure on top of which a study subject stands or locomotes. Likewise, &quot;superstrate&quot; is a structure from which an animal suspends itself. We use &quot;support&quot; to mean both or either.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000184"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&apos;Terrestrial&apos;, &apos;arboreal&apos;, and &apos;aerial&apos; can have alternate definitions in the context of forest canopy biology.</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1744-7429.2000.tb00506.x</dc:source>
        <skos:scopeNote>&quot;TERRESTRIAL. Can be used generally to refer to the ground, as opposed to the canopy, or anything existing, forming, or living in the ground (e.g., rooted there), as distinct from something that is aerial (canopy-dwelling, e.g., arboreal or epiphytic). A ground-rooted plant taken as a whole can be described as &quot;terrestrial&quot; {e.g., in comparison to an epiphyte) or its roots can be described as terrestrial and its leaves as aerial. Context should make it clear whether these definitions or one of the other definitions of &quot;terrestrial&quot; or aerial is intended (i.e., land as opposed to &quot;aquatic,&quot; or earth as opposed to &quot;extraterrestrial&quot;).&quot;</skos:scopeNote>
    </owl:Axiom>
    


