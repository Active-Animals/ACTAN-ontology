            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000326"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000089"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-11T09:17:14.599417Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Inspection that involves approaching to gather information about the identity, precise location, and current motivational state of a potential predator.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym>probing</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">predator inspection</rdfs:label>
        <skos:closeMatch>NBO:0020223</skos:closeMatch>
        <skos:example>&quot;Adult ground squirrels (Spermophilus beecheyi), which have some immunity to the bite of northern Pacific rattlesnakes (Crotalus viridis), have been known to kill rattlesnakes and even engage in probing behavior to elicit a snake to rattle apparently because this provides information about the relative danger of an individual snake.&quot;</skos:example>
        <skos:example>&quot;Trinidadian guppies engage in increased predator inspection behaviour (i.e. information gathering) in sites along rivers disturbed by human recreation relative to undisturbed sites.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000400"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Inspection that involves approaching to gather information about the identity, precise location, and current motivational state of a potential predator.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Predator inspection: An exploratory/boldness-related risk-taking behavior in fish associated with either increased or decreased tendency to approach a predator, potentially to gather information about the identity, precise location and/or current motivational state of the predator.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000400"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>probing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000400"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">predator inspection</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>doi:10.3389/fetho.2023.1238167</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000400"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Adult ground squirrels (Spermophilus beecheyi), which have some immunity to the bite of northern Pacific rattlesnakes (Crotalus viridis), have been known to kill rattlesnakes and even engage in probing behavior to elicit a snake to rattle apparently because this provides information about the relative danger of an individual snake.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000400"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Trinidadian guppies engage in increased predator inspection behaviour (i.e. information gathering) in sites along rivers disturbed by human recreation relative to undisturbed sites.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1238167</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000401 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000401">
