    <!-- http://purl.obolibrary.org/obo/ACTAN_0000848 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000848">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000847"/>
