    <!-- http://purl.obolibrary.org/obo/ACTAN_0000381 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000381">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000341"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001912"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-22T20:53:35.667401Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Maintenance which satisfies foundational physiological needs.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">homeostatic property</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>comfort</oboInOwl:hasRelatedSynonym>
        <rdfs:label>homeostasis maintenance</rdfs:label>
        <skos:scopeNote>&quot;...large colony size is likely to be associated with relatively greater homeostatic properties of the colony...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Nest homeostasis provides not only an incubator for the brood, but also a thermal refuge for individuals to use temperature gradients to regulate their own body temperature.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000381"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Maintenance which satisfies foundational physiological needs.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1177/1745691610369469</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Physiological motives The adaptive function of what Maslow called physiological needs is fairly straightforward; he included here homeostatic needs such as hunger and thirst, which are obviously essential for survival. Logically, the satisfaction of such physiological needs is foundational to other motives.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000381"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">homeostatic property</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1093/beheco/12.5.534</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000381"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>comfort</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000381"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>homeostasis maintenance</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000381"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...large colony size is likely to be associated with relatively greater homeostatic properties of the colony...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/beheco/12.5.534</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000381"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Nest homeostasis provides not only an incubator for the brood, but also a thermal refuge for individuals to use temperature gradients to regulate their own body temperature.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1371/journal.pone.0200048</dc:source>
    </owl:Axiom>
    


