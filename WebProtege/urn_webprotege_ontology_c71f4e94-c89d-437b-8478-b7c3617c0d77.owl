    <!-- http://purl.obolibrary.org/obo/ACTAN_0000936 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000936">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000736"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-02T14:22:18.48167Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Retracting that involves an appendage.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>cheliped retraction</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>leg retracting</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">appendage retracting</rdfs:label>
        <skos:example>&quot;C. compressus... The chelae are often not lifted completely free from the substrate during retraction; consequently, they will leave a gouged-out groove in the centre of the crab track as they are dragged along the sand.&quot;</skos:example>
        <skos:scopeNote>&quot;...the gait patterns of many-legged organisms are characterised by stride period (one complete cycle of protraction and retraction of a leg), duty factor, (the ratio of the retracting period over a cycle), step length, (the moving distance during a retraction of a leg), stride length, (the moving distance during a cycle of a leg movement, i.e. stride length = step length / duty factor) and wavenumber (the mean phase difference between successive ipsilateral legs).&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000936"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Retracting that involves an appendage.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000936"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>cheliped retraction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1986</dc:date>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
        <skos:scopeNote>&quot;...chelae are often not lifted completely free from the substrate during retraction;&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000936"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>leg retracting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1986</dc:date>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
        <rdfs:comment>&quot;...left legs are extended and the right retracted.&quot;</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000936"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">appendage retracting</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000936"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;C. compressus... The chelae are often not lifted completely free from the substrate during retraction; consequently, they will leave a gouged-out groove in the centre of the crab track as they are dragged along the sand.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000936"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...the gait patterns of many-legged organisms are characterised by stride period (one complete cycle of protraction and retraction of a leg), duty factor, (the ratio of the retracting period over a cycle), step length, (the moving distance during a retraction of a leg), stride length, (the moving distance during a cycle of a leg movement, i.e. stride length = step length / duty factor) and wavenumber (the mean phase difference between successive ipsilateral legs).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1088/1748-3190/ac482d</dc:source>
    </owl:Axiom>
    


