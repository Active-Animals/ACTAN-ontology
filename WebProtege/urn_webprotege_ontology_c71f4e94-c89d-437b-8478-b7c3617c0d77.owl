    <!-- http://purl.obolibrary.org/obo/ACTAN_0000122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000610"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-17T19:32:35.749699Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>opening</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Movement that opens a bilaterally articulated, curved orifice.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>gape</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">gaping</oboInOwl:hasExactSynonym>
        <rdfs:label>gaping movement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000723"/>
        <skos:example>&quot;Apomorphic characters were the derived mouth-gaping behavior of A. piscivorous and the specialized tail coil and ventral tail exposure of C. pricei.&quot;</skos:example>
        <skos:example>&quot;Nocomis leptocephalus...
As the female moved forward over the upstream rim of the pit, she gaped and abruptly tossed her head vertically into the water column.&quot;</skos:example>
        <skos:example>&quot;The genera Lingula and Glottidia possess antero-posteriorly elongated shells, and live within mucus-lined burrows in soft sediment, with the long pedicles anchored at the bottom of their burrows... After burrowing downward for a while, they curve upward and continue burrowing until they emerge from the substrate with the anterior region of the shell. The valves perform a variety of gaping and shearing movements that are adaptive in displacing the sediment.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000122"/>
