            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-15T08:55:10.668199Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Relativity that involves a higher velocity gap-closing motion.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">lunging</oboInOwl:hasExactSynonym>
        <rdfs:label>lunge relativity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000234"/>
        <skos:example>&quot;As gap distances increase, rather than crawling slowly and continuously, some snake species may lunge, jump, or even glide.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000327"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
