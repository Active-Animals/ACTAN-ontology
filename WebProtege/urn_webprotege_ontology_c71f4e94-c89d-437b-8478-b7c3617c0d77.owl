    <!-- http://purl.obolibrary.org/obo/ACTAN_0000437 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000076"/>
