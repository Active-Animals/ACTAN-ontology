        <owl:annotatedTarget>&quot;Two individuals of Helostoma temmincki often show a ceremony in which, standing opposite each other, they press the maximally opened jaws against those of the opponent. Because of this ceremony the fish has got the popular name (at least in Holland) of kissing-fish.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000572 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000857"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000569"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-06T10:26:12.794847Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mouth-fight in which two fish swim towards each other, briefly touch mouths, and then simultaneously flick away in opposite directions.

Can be repeatedly displayed during fights.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>flick</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">flick mouth-fight</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000572"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mouth-fight in which two fish swim towards each other, briefly touch mouths, and then simultaneously flick away in opposite directions.

Can be repeatedly displayed during fights.</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
        <skos:scopeNote>&quot;Flick (flicking): A specific agonistic behavior observed when two zebrafish swim towards each other, briefly touch mouths, and then simultaneously flick away in opposite directions; can be repeatedly displayed during agonistic interactions (fight).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000572"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>flick</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000572"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">flick mouth-fight</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000573 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000573">
