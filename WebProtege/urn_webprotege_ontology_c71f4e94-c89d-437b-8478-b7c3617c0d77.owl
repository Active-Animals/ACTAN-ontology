    <!-- http://purl.obolibrary.org/obo/ACTAN_0000428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000425"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFA_0000298"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:38:47.316325Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Sound in which a snake expels air from its vent to make a noise.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">cloacal popping</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">cloacal-popping sound</rdfs:label>
        <skos:example>&quot;However, there are two species of corals, M.f fulvius and M. euryxanthus, with an additional, unusual defense mechanism. By raising their tails and writhing, these snakes can expel air from their vents to make a noise called cloacal popping. This sound startles would-be predators, presumably giving them additional warning and time to flee.&quot;</skos:example>
        <skos:scopeNote>&quot;Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000428"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Sound in which a snake expels air from its vent to make a noise.</owl:annotatedTarget>
        <dc:source>doi:10.1580/1080-6032(1996)007[0038:USCS]2.3.CO;2</dc:source>
        <skos:scopeNote>&quot;By raising their tails and writhing, these snakes can expel air from their vents to make a noise called cloacal popping.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000428"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">cloacal popping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1580/1080-6032(1996)007[0038:USCS]2.3.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000428"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">cloacal-popping sound</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000428"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;However, there are two species of corals, M.f fulvius and M. euryxanthus, with an additional, unusual defense mechanism. By raising their tails and writhing, these snakes can expel air from their vents to make a noise called cloacal popping. This sound startles would-be predators, presumably giving them additional warning and time to flee.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1580/1080-6032(1996)007[0038:USCS]2.3.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000428"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000429 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000429">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000421"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0055001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:39:04.378653Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Oscillation that is high frequency and low amplitude.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>quiver</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">quivering</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>shivering</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>trembling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>shuddering</oboInOwl:hasRelatedSynonym>
        <rdfs:label>quiver oscillation</rdfs:label>
        <skos:example>&quot;...sepsid flies (Diptera: Sepsidae)...
Quiver (vibration of entire tarsus without movement of tibia or femur).&quot;</skos:example>
        <skos:example>&quot;Blue Sugarbird (Dacnis cayana)... This species picks up an ant [spraying species] in its bill, and very rapidly it rises in an almost vertical position with spread tail and moves both wings forward so that they touch each other while quivering, and the head is moved downwards among the tips of the wings.”</skos:example>
        <skos:example>&quot;During breeding, the male zebrafish approaches the female and curves body around, positioning his genital pore next to hers (also see Parallel). The male then quivers in an attempt to trigger oviposition in the female; sperm is released simultaneously to fertilize the newly released eggs.&quot;</skos:example>
        <skos:scopeNote>&quot;Jerking gradually merges into quivering. The position of the fish becomes more vertical (the head downward), the body waves become stronger, and the tail is swept appreciably sideways. In most species a high intensity is marked by the almost vertical position of the longitudinal axis of the fish, and the violent lateral beats of the tail.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000429"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Oscillation that is high frequency and low amplitude.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Quiver (quivering): High frequency, low amplitude tail oscillation by a male while aligned against the side of a female;&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000429"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>quiver</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000429"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">quivering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000429"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>shivering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2008</dc:date>
        <dc:source>doi:10.1007/s10682-007-9183-7</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000429"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>trembling</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000429"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>shuddering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000429"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>quiver oscillation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000429"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...sepsid flies (Diptera: Sepsidae)...
Quiver (vibration of entire tarsus without movement of tibia or femur).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000429"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Blue Sugarbird (Dacnis cayana)... This species picks up an ant [spraying species] in its bill, and very rapidly it rises in an almost vertical position with spread tail and moves both wings forward so that they touch each other while quivering, and the head is moved downwards among the tips of the wings.”</owl:annotatedTarget>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000429"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;During breeding, the male zebrafish approaches the female and curves body around, positioning his genital pore next to hers (also see Parallel). The male then quivers in an attempt to trigger oviposition in the female; sperm is released simultaneously to fertilize the newly released eggs.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000429"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Jerking gradually merges into quivering. The position of the fish becomes more vertical (the head downward), the body waves become stronger, and the tail is swept appreciably sideways. In most species a high intensity is marked by the almost vertical position of the longitudinal axis of the fish, and the violent lateral beats of the tail.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000430 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000430">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000860"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002246"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T14:51:02.083568Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Hit that makes a low-force, small surface contact.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">tapping</oboInOwl:hasExactSynonym>
        <rdfs:label>tap hit</rdfs:label>
        <skos:example>&quot;For example, in the small tortoiseshell butterfly, Aglais urticae, males persistently court females, repeatedly tapping with their antennae until the female drops down into the vegetation, followed by the male who may then achieve a mating.&quot;</skos:example>
        <skos:example>&quot;For instance, in S. neocynipsea, males use their midlegs to tap the female head and thorax...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000430"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Hit that makes a low-force, small surface contact.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000430"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">tapping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000430"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>tap hit</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000430"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;For instance, in S. neocynipsea, males use their midlegs to tap the female head and thorax...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000431 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000431">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000117"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000463"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T20:47:54.252607Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Modality that involves visually conspicuous movement and posture.

It is not simply a morphological feature providing an unintentional cue.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>showing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>visual signal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>visual display</oboInOwl:hasRelatedSynonym>
        <rdfs:label>show modality</rdfs:label>
        <skos:example>&quot;In Maevia inclemens, an unusual species with two male morphs, experiments suggested that females have no preference for either morph but simply for the male that moves first. Different morphs appear to use alternative strategies to stimulate different fields of the female visual range, using different postures at different distances from the female.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000431"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Modality that involves visually conspicuous movement and posture.

It is not simply a morphological feature providing an unintentional cue.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000431"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>showing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000431"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>visual signal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2005</dc:date>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000431"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>visual display</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1966</dc:date>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000431"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>show modality</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000431"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In Maevia inclemens, an unusual species with two male morphs, experiments suggested that females have no preference for either morph but simply for the male that moves first. Different morphs appear to use alternative strategies to stimulate different fields of the female visual range, using different postures at different distances from the female.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000432 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000425"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000715"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:39:42.69642Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Sound that is created by forced air.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>vocalisation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vocalising</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">vocalization</oboInOwl:hasExactSynonym>
        <rdfs:label>vocalization sound</rdfs:label>
        <skos:example>&quot;Alaskan humpback whales (Megaptera novaengliae), when hunting Pacific herring, sometimes work as a team to perform two basic subtasks: prey herding and bubble blowing. Most whales perform the herding subtask and search along the sea bottom for herring schools above them. The group then initiates an attack by rushing the prey while issuing loud calls. The herring swim upward in an attempt to escape, but at the same time another whale, the bubble blower, swims in a circle above the school and deploys a curtain of air which both traps the prey and channels them to the surface, whereupon all the whales feed on the herring. Interestingly, this strategy not only involves precise spatiotemporal coordination between the herders and bubble blower, but the bubble blower, vocalizer(s), and herders all appear to specialize in their subtasks.&quot;</skos:example>
        <skos:example>&quot;Female Lyrebirds exhibit an impressive array of elaborate mimetic and species-specific vocalisations, suspected to play an important role in territory defence...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000432"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Sound that is created by forced air.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/brv.12891</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Sound created by ‘forced air’ is used across animals... Other caterpillars ‘vocalise’ when attacked, by forcing air out of their gut.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000432"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>vocalisation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2019</dc:date>
        <dc:source>doi:10.1163/1568539X-00003574</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000432"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>vocalising</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2015</dc:date>
        <dc:source>doi:10.1007/s10071-014-0761-0</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000432"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">vocalization</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1955</dc:date>
        <dc:source>https://www.jstor.org/stable/4081601</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000432"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>vocalization sound</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000432"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Alaskan humpback whales (Megaptera novaengliae), when hunting Pacific herring, sometimes work as a team to perform two basic subtasks: prey herding and bubble blowing. Most whales perform the herding subtask and search along the sea bottom for herring schools above them. The group then initiates an attack by rushing the prey while issuing loud calls. The herring swim upward in an attempt to escape, but at the same time another whale, the bubble blower, swims in a circle above the school and deploys a curtain of air which both traps the prey and channels them to the surface, whereupon all the whales feed on the herring. Interestingly, this strategy not only involves precise spatiotemporal coordination between the herders and bubble blower, but the bubble blower, vocalizer(s), and herders all appear to specialize in their subtasks.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/beheco/12.5.534</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000432"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Female Lyrebirds exhibit an impressive array of elaborate mimetic and species-specific vocalisations, suspected to play an important role in territory defence...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/1568539X-00003574</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000433 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000131"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000398"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000929"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:39:54.72575Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Sound-regime that involves an individual composition of acoustic components.

Some may be non-trivial, or involve a different meaning than the simple combination of meanings.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">singing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>song</oboInOwl:hasExactSynonym>
        <rdfs:label>song regime</rdfs:label>
        <skos:example>&quot;Japanese tits (Parus minor) have ABC calls that raise alarms, D calls that trigger recruitment, and ABC-D calls that are derived from ABC and D by way of non-trivial compositionality, and trigger mobbing of certain predators.&quot;</skos:example>
        <skos:scopeNote>&quot;Here, recent advances in recording and analysis techniques allowed authors to quantify song differences in closely related species and ⁄ or populations and the results suggest that in insects acoustic signals can evolve as quickly as sexually dimorphic structures.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;This variation can either be an adaptive characteristic of a species- or population-specific signal (e.g., a distinct floral scent) or the result of an individual modulating its signal in real time in response to current acoustic or olfactory “clutter” (e.g., modulating a bird song frequency to avoid overlap with noise.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000433"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Sound-regime that involves an individual composition of acoustic components.

Some may be non-trivial, or involve a different meaning than the simple combination of meanings.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/s10988-025-09438-8</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000433"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">singing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000433"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>song</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000433"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>song regime</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000433"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Japanese tits (Parus minor) have ABC calls that raise alarms, D calls that trigger recruitment, and ABC-D calls that are derived from ABC and D by way of non-trivial compositionality, and trigger mobbing of certain predators.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10988-025-09438-8</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000433"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Here, recent advances in recording and analysis techniques allowed authors to quantify song differences in closely related species and ⁄ or populations and the results suggest that in insects acoustic signals can evolve as quickly as sexually dimorphic structures.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000433"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;This variation can either be an adaptive characteristic of a species- or population-specific signal (e.g., a distinct floral scent) or the result of an individual modulating its signal in real time in response to current acoustic or olfactory “clutter” (e.g., modulating a bird song frequency to avoid overlap with noise.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/978-3-319-68576-2_3</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000434 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000432"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000780"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:40:08.914113Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Vocalization that involves the respiratory system.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">calling</oboInOwl:hasExactSynonym>
        <rdfs:label>call vocalization</rdfs:label>
        <skos:example>&quot;Chimpanzee...
...various calls which are linked by audible inhalations and which may be described as vocalized pant.&quot;</skos:example>
        <skos:example>&quot;Lorenz described the &quot;going-away call&quot; of the female Mallard which consisted of a series of &quot;quacks&quot; and is given especially before flight...&quot;</skos:example>
        <skos:scopeNote>&quot;Elaborate courtship behaviours – often involving visual cues – have been described for various groups of salamanders, mammals, birds and fishes while olfactory and tactile signals are particularly important for many mammal species and songs and calls for the mating behaviour of birds and anurans.&quot;</skos:scopeNote>
    </owl:Class>
