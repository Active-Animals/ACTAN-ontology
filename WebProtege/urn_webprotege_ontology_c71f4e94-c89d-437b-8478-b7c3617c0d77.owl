    <!-- http://purl.obolibrary.org/obo/ACTAN_0000610 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000610">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000609"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000398"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-17T15:57:52.927271Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Groom that is egocentric.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">autogrooming</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>groom self</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>self groom</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>preening</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">auto groom</rdfs:label>
        <skos:narrowMatch>NBO:0000451</skos:narrowMatch>
        <skos:scopeNote>&quot;Oiling preening...
Nibbling preening...
Washing: Preening...

...social preening may be functional as a grooming technique...&quot;&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000610"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Groom that is egocentric.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/tops.12554</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Although 80% of the tooling submodes consist of allocentric actions, remarkably the nonprimate mammals, which had a limited number of tooling cases, had a greater proportion of egocentric submodes: self-grooming was their most common purpose for tooling.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000610"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">autogrooming</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
