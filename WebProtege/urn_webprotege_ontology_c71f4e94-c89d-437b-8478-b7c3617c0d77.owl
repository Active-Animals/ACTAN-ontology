        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;SUSPENSION-FEEDING AQUATIC ANIMALS capture planktonic prey as water flows past the feeding apparatus.&quot;</owl:annotatedTarget>
