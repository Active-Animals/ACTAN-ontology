        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">aquatic-lateral-undulating gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000266"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000027"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:nodeID="genid1908"/>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-06T18:51:50.191979Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Aquatic-lateral-undulating gait that consists of a series of sine waves, comprising more than one-half a sine curve, which are passed caudally.

The pivot is at the base of the skull.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">anguilliform axial swim</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>anguilliform mode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>anguilliform motion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>slipping along</oboInOwl:hasRelatedSynonym>
        <rdfs:label>anguilliform gait</rdfs:label>
        <skos:example>&quot;Typical examples of this common locomotion mode are the eel and the lamprey.&quot;</skos:example>
        <skos:scopeNote>&quot;In anguilliform mode, the whole body participates in large amplitude undulations. Since at least one complete wavelength of the propulsive wave is present along the body, lateral forces are adequately cancelled out, minimizing any tendencies for the body to recoil. Many anguilliform swimmers are capable of backward as well as forward swimming by altering the propagation direction of the propulsive wave.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid1908">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002100"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000267"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid1908"/>
        <dc:source>doi:10.1093/icb/36.6.555</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000267"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Aquatic-lateral-undulating gait that consists of a series of sine waves, comprising more than one-half a sine curve, which are passed caudally.

The pivot is at the base of the skull.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.5962/p.203769</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;That form of locomotion exemplified by the Anguillidae {Anguilla). It consists of a series of sine waves (as in the waving of a flag) which are passed caudad by successive contractions and relaxations of the metameral body muscles. More than one-half a sine curve is formed at least. The pivot is at the base of the skull.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000267"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">anguilliform axial swim</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1093/icb/36.6.555</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000267"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>anguilliform mode</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000267"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>anguilliform motion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000267"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>slipping along</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000267"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>anguilliform gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000267"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Typical examples of this common locomotion mode are the eel and the lamprey.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000267"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In anguilliform mode, the whole body participates in large amplitude undulations. Since at least one complete wavelength of the propulsive wave is present along the body, lateral forces are adequately cancelled out, minimizing any tendencies for the body to recoil. Many anguilliform swimmers are capable of backward as well as forward swimming by altering the propagation direction of the propulsive wave.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000266"/>
        <rdfs:subClassOf rdf:nodeID="genid1918"/>
