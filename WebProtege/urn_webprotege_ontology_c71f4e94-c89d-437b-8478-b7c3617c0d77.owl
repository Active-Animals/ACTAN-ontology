    <!-- http://purl.obolibrary.org/obo/ACTAN_0000312 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000308"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000311"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-13T13:29:42.230606Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Residence that involves very sustained immobility.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>sessility</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">sessile</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sessility residence</rdfs:label>
        <skos:example>&quot;The coral system offers many advantages for exploring how synchrony might be achieved on ecological scales. First, corals are sessile and that makes these organisms highly tractable for measuring the synchrony of spawning across the entire population over time.&quot;</skos:example>
    </owl:Class>
