                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000695"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-17T21:05:19.794934Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym xml:lang="en">labriform movement</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Oscillating gait in which the pectoral fins move up and down in a plane that is roughly perpendicular to the main axis of the fish’s body.

No recovery stroke is necessary and lift can be generated during both the upstroke and the downstroke.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>lift based labriform mode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pectoral sculling</oboInOwl:hasExactSynonym>
        <rdfs:label>labriform-lift-based gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000631"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget xml:lang="en">labriform movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000631"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Oscillating gait in which the pectoral fins move up and down in a plane that is roughly perpendicular to the main axis of the fish’s body.

No recovery stroke is necessary and lift can be generated during both the upstroke and the downstroke.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1109/48.757275</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;As a result, in lift-based labriform mode, for the pectoral fins to propel the fish forward, they have to move up and down in a plane that is roughly perpendicular to the main axis of the fish’s body. This implies that no recovery stroke is necessary and lift can be generated during both the upstroke and the downstroke.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000631"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>lift based labriform mode</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000631"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pectoral sculling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1973</dc:date>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000631"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>labriform-lift-based gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000632 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000632">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000016"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003097"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_4000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000695"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-17T21:25:42.669116Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Ribbon-undulation gait that involves both the dorsal and anal fins.

The angular divergence of the two fins from the horizontal is complementary, reducing the reactance to a horizontal resultant.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>balistiform locomotion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">balistiform movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>balistiform undulation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">balistiform gait</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000953"/>
        <skos:example>&quot;...the small, short median fins of R. aculeatus are sufficient for slow grazing using balistiform locomotion...&quot;</skos:example>
        <skos:example>&quot;This is seen mainly in the family Balistidae (e.g., the trigger fish). A typical characteristic is that their median fins are usually inclined relative to each other, while the body is usually flat and compressed laterally.&quot;</skos:example>
        <skos:scopeNote>&quot;Species with long, large median fins and wide caudal peduncles used the balistiform gait alone for a larger percentage of their total critical swimming speed...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000632"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Ribbon-undulation gait that involves both the dorsal and anal fins.

The angular divergence of the two fins from the horizontal is complementary, reducing the reactance to a horizontal resultant.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.5962/p.203769</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;That form of localized anguilliform and intermediate undulation found in the dorsal and anal of the Balistidae (Balistes). The angular divergence of the two fins from the horizontal is complementary, reducing the reactance to a horizontal resultant.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000632"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>balistiform locomotion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000632"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">balistiform movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000632"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>balistiform undulation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;Balistiform. That form of localized anguilliform and intermediate undulation...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000632"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">balistiform gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000632"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...the small, short median fins of R. aculeatus are sufficient for slow grazing using balistiform locomotion...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.194704</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000632"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;This is seen mainly in the family Balistidae (e.g., the trigger fish). A typical characteristic is that their median fins are usually inclined relative to each other, while the body is usually flat and compressed laterally.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000632"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Species with long, large median fins and wide caudal peduncles used the balistiform gait alone for a larger percentage of their total critical swimming speed...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.194704</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000633 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000020"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000069"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000151"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003097"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_4000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000695"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-17T21:26:48.086798Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Oscillating gait in which all fins (pectorals, anal and dorsal, and caudal at higher speeds) move in synchronization at all swimming speeds, including hovering.

Left and right pectoral fins alternate phases; when anal and dorsal fins travel from right to left, the left pectoral fin adducts and the right pectoral fin abducts.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>tetraodontiform movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>localized ostraciiform motion</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">tetraodontiform gait</rdfs:label>
        <skos:example>&quot;Lagocephalus laevigatus most frequently fans its dorsal and anal from side to side (localized ostraciiform motion) in unison, but occasionally alternates them.&quot;</skos:example>
        <skos:example>&quot;Tetraodon schoutedeni swim very steadily at all the swimming speeds of their range, with no changes of angle of attack during any given swimming speed. Ranges of angle of attack (0–4°) were smaller than reported for larger puffers (3–10°). Yaw, roll, and pitch were not detectable in T. schoutedeni, similar to other puffers. However, Hove et al. (2001) reported pitch (up to 5°) and yaw (up to 6°) in boxfish. This result suggests that puffers swim more steadily than boxfish, probably because of their highly synchronized fin movements.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000633"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Oscillating gait in which all fins (pectorals, anal and dorsal, and caudal at higher speeds) move in synchronization at all swimming speeds, including hovering.

Left and right pectoral fins alternate phases; when anal and dorsal fins travel from right to left, the left pectoral fin adducts and the right pectoral fin abducts.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/s10228-002-0153-3</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;As in other puffers, but not as in other multipropulsor swimmers, such as the boxfish Ostracion meleagris, all fins (pectorals, anal and dorsal, and caudal at higher speeds) moved in synchronization at all swimming speeds. This pattern was also observed when puffers hovered slowly in calm water.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000633"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>tetraodontiform movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000633"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">tetraodontiform gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000633"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Lagocephalus laevigatus most frequently fans its dorsal and anal from side to side (localized ostraciiform motion) in unison, but occasionally alternates them.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000633"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Tetraodon schoutedeni swim very steadily at all the swimming speeds of their range, with no changes of angle of attack during any given swimming speed. Ranges of angle of attack (0–4°) were smaller than reported for larger puffers (3–10°). Yaw, roll, and pitch were not detectable in T. schoutedeni, similar to other puffers. However, Hove et al. (2001) reported pitch (up to 5°) and yaw (up to 6°) in boxfish. This result suggests that puffers swim more steadily than boxfish, probably because of their highly synchronized fin movements.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10228-002-0153-3</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000634 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000634">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000075"/>
        <rdfs:subClassOf>
