    <!-- http://purl.obolibrary.org/obo/ACTAN_0000976 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000976">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000970"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-13T16:28:25.133246Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement that involves an eye.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">eye movement</rdfs:label>
        <skos:scopeNote>&quot;Although most organisms have much more limited capacity for eye movements than humans do, brief stabilizations of the eyes are evident in careful recordings of eye and body positions during turns in a number of different taxa.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000976"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement that involves an eye.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://core.ac.uk/download/pdf/85255156.pdf</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The eye movement system is a classical type of servomechanism, exhibiting many of the characteristics common to both biological and mechanical control systems.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000976"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">eye movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>https://core.ac.uk/download/pdf/85255156.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000976"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Although most organisms have much more limited capacity for eye movements than humans do, brief stabilizations of the eyes are evident in careful recordings of eye and body positions during turns in a number of different taxa.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/41.2.137</dc:source>
    </owl:Axiom>
    


