    <!-- http://purl.obolibrary.org/obo/ACTAN_0000777 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000777">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000144"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000553"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-04T14:11:37.875362Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Transition that involves pulling out of a space.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">withdrawal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>removing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>retracting</oboInOwl:hasRelatedSynonym>
        <rdfs:label>withdrawal transition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000029"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000736"/>
        <skos:example>&quot;Pelocoetes exul... live in vertical burrows into which they can withdraw...&quot;</skos:example>
        <skos:scopeNote>&quot;The retractors have two distinct functions. Their slow tonic contraction plays its part in maintaining the shape of the column in concert with the parietals. But on sudden stimulation their rapid contraction leads to withdrawal of the disk and closure of the anemone. In this fast response, the powerful retractors act antagonistically not only to the circular muscle of the column but also to the parietals. The sudden withdrawal of the disk may cause a general bulging outwards of the whole body wall. The concurrent contraction of the marginal sphincter results in the animal passing from a cylindrical to a hemispherical shape.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000777"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Transition that involves pulling out of a space.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
        <dc:source>doi:10.1303/aez.25.383</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000777"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">withdrawal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1922</dc:date>
        <dc:source>doi:10.2307/2939673</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000777"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>removing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1990</dc:date>
        <dc:source>doi:10.1303/aez.25.383</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000777"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>retracting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000777"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>withdrawal transition</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000777"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Pelocoetes exul... live in vertical burrows into which they can withdraw...&quot;</owl:annotatedTarget>
        <dc:source>https://www.researchgate.net/profile/Lina-Barrios-2/post/any_idea_about_these_anemones/attachment/59d61dea79197b807797c41b/AS%3A273509083512833%401442221055505/download/Fautin+et+al+2015-+Sea+anemones+of+Singapore.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000777"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The retractors have two distinct functions. Their slow tonic contraction plays its part in maintaining the shape of the column in concert with the parietals. But on sudden stimulation their rapid contraction leads to withdrawal of the disk and closure of the anemone. In this fast response, the powerful retractors act antagonistically not only to the circular muscle of the column but also to the parietals. The sudden withdrawal of the disk may cause a general bulging outwards of the whole body wall. The concurrent contraction of the marginal sphincter results in the animal passing from a cylindrical to a hemispherical shape.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000778 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000778">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000103"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000776"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-05T14:43:34.066038Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>nibbling movements</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Counter-irritant routine which responds to a localised irritation by using the mouthparts.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>foot-pecking</oboInOwl:hasNarrowSynonym>
        <rdfs:label>nibble routine</rdfs:label>
        <skos:example>&quot;...Mr SCOTT tells me that he has seen foot-pecking in geese as a response to nettle-stings.&quot;</skos:example>
        <skos:scopeNote>&quot;Occasional nibbling movements...

Often the movements are hurried, and I suspect that the bird is attempting to remove a source of irritation (possibly caused by ectoparasites).&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000778"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>nibbling movements</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000778"/>
