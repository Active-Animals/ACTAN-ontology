        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-06T10:53:04.908328Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Swimming-regime that buoyantly maintains some tilt at the water surface.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">floating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hanging</oboInOwl:hasExactSynonym>
        <rdfs:label>float regime</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000403"/>
        <skos:scopeNote>&quot;...intertidal benthic gobies performed ASR in shallow water... hanging vertically from the water surface at positive buoyancy...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
