        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-21T20:06:54.152063Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Look which tries to find something with the eyes.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">visual search</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>inspecting</oboInOwl:hasRelatedSynonym>
        <rdfs:label>searching look</rdfs:label>
        <skos:scopeNote>&quot;In many visual search tasks, the time to locate an item increases with the number of kinds of items being searched for (targets), with the number of non-target items in the field, and with the similarity between non-target and target items.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000850"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Look which tries to find something with the eyes.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Then they try to find it with their eyes, which sense organs also undoubtedly help in the actual catching of the prey.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000850"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">visual search</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1093/icb/41.2.137</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000850"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
