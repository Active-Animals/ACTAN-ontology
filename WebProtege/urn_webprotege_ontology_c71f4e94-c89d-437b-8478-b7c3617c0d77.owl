    <!-- http://purl.obolibrary.org/obo/ACTAN_0000837 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000837">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000463"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000898"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-14T20:01:20.510907Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Cooperation that replaces another in performing a duty.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>relief</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">relieving</oboInOwl:hasExactSynonym>
        <rdfs:label>relief cooperation</rdfs:label>
        <skos:scopeNote>&quot;...fishes... relieving each other when guarding the young.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;In general, the mates alternately lay and fertilize and when relieving each other they usually display and give a formalized tail beat.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000837"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
