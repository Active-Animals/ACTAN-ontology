        <owl:annotatedTarget>O turning</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000508"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Therefore, by markedly up-regulating speed and omega turn rates, starved worms at 25 °C are in a state enabling both local and global search, which we will call glocal search.&quot;</owl:annotatedTarget>
