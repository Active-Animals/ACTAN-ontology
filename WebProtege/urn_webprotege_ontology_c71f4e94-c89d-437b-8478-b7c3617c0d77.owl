    <!-- http://purl.obolibrary.org/obo/ACTAN_0000010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000010">
        <rdfs:subClassOf rdf:resource="http://humanbehaviourchange.org/ontology/BCIO_050416"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-06-12T19:56:05.959335Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Behavioural disposition that is realized in the number of appendages used for a locomotion activity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>locomotor method</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>locomotive mode</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>gait</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>positional mode</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In this ontology, we have tried to tease apart the concepts of gait (a behaviour), gait pattern (a disposition), and locomotion mode (a disposition). Many sources bundle them into a trinity. The uses of varying synonyms makes it even harder to untangle. We have accepted the use of labels which could at least bear, if not incorporate, these concepts. Even if not actively defined as such in the source, we are promoting them to avoid neologisms and instead facilitate transparent semantic drift.</rdfs:comment>
        <rdfs:label xml:lang="en">locomotion-mode</rdfs:label>
        <skos:scopeNote>This concept is not strictly about the number of appendages an animal may have, or even tend to use for propulsion, but rather the number in use in any given observation.</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000010"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Behavioural disposition that is realized in the number of appendages used for a locomotion activity.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000010"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>locomotor method</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000010"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>locomotive mode</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2019</dc:date>
        <dc:source>doi:10.1242/jeb.198226</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000010"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>gait</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2019</dc:date>
        <dc:source>doi:10.1242/jeb.198226</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000010"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>positional mode</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000010"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>In this ontology, we have tried to tease apart the concepts of gait (a behaviour), gait pattern (a disposition), and locomotion mode (a disposition). Many sources bundle them into a trinity. The uses of varying synonyms makes it even harder to untangle. We have accepted the use of labels which could at least bear, if not incorporate, these concepts. Even if not actively defined as such in the source, we are promoting them to avoid neologisms and instead facilitate transparent semantic drift.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
