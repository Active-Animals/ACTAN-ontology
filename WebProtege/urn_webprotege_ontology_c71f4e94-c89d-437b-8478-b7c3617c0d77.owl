    <!-- http://purl.obolibrary.org/obo/ACTAN_0000385 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000384"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MFOEM_000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-05T11:37:13.796791Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>aggression</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Agonism that is oppositional.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">antagonistic tendency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pugnacious</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>quarrelling</oboInOwl:hasRelatedSynonym>
        <rdfs:label>antagonism agonism</rdfs:label>
        <skos:example>&quot;Aggression: Complex behaviors (including approach, fin raise, undulating body movement, mouth opening behavior, body color change, biting, charging, chasing, and circling) directed at conspecifics (or other objects) in adult zebrafish; may appear in the context of defending the territory (territorial behavior), protecting resources (e.g., females) and establishing dominance.&quot;</skos:example>
        <skos:relatedMatch>NBO:0000015</skos:relatedMatch>
        <skos:scopeNote>&quot;This surprised us given the gregarious nature of female rattlesnakes during gestation and maternal attendance of young , as well as the antagonism (including combat) between males during the breeding season , with the latter potentially exacerbating an acute stress response.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000385"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>aggression</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1966</dc:date>
        <dc:source>doi:10.2307/4083155</dc:source>
        <rdfs:comment>INACTIVE TERM
This broad synonym has the potential to be a catch-all for multiple overlapping and even contradictory elements. Whilst it may have linguistic utility, it is problematic as a definitional parent class.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000385"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Agonism that is oppositional.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.jstor.org/stable/986582</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;By adopting an &quot;opposite&quot; or antagonistic alternative an individual in effect alters the contest so that he or she can win.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000385"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">antagonistic tendency</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000385"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pugnacious</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000385"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>quarrelling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000385"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>antagonism agonism</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000385"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Aggression: Complex behaviors (including approach, fin raise, undulating body movement, mouth opening behavior, body color change, biting, charging, chasing, and circling) directed at conspecifics (or other objects) in adult zebrafish; may appear in the context of defending the territory (territorial behavior), protecting resources (e.g., females) and establishing dominance.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000385"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;This surprised us given the gregarious nature of female rattlesnakes during gestation and maternal attendance of young , as well as the antagonism (including combat) between males during the breeding season , with the latter potentially exacerbating an acute stress response.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1181774</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000386 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000386">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000925"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-05T11:37:28.371618Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Antagonism in which short, fast bouts of physical contact are directed at an opponent.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>attack</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">combat</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>molesting</oboInOwl:hasRelatedSynonym>
        <rdfs:label>attack antagonism</rdfs:label>
        <skos:closeMatch>NBO:0020033</skos:closeMatch>
        <skos:example>&quot;It may be difficult, but we ought to admire the savage instinctive hatred of the queen-bee, which urges her instantly to destroy the young queens her daughters as soon as born, or to perish herself in the combat;&quot;</skos:example>
        <skos:example>&quot;Thalassoma cupido...
The lizardfish Synodus variegatus (Lacepede)... was observed to attack with great speed just as the wrasses formed the characteristic close-knit group immediately prior to the upward dash.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000386"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
