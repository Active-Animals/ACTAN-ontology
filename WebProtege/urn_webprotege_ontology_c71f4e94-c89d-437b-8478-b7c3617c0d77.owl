                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000530"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-19T21:19:32.415138Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flying-regime that involves gliding with flexed wings interspersed with active flapping.

Sufficient lift-production during glides is the main criterion allowing birds to undulate.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>undulatory flight</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">undulating-flying regime</rdfs:label>
        <skos:example>&quot;...on the plains of La Plata, where not a tree grows, there is a woodpecker, which in every essential part of its organisation, even in its colouring, in the harsh tone of its voice, and undulatory flight, told me plainly of its close blood-relationship to our common species; yet it is a woodpecker which never climbs a tree!&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000531"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flying-regime that involves gliding with flexed wings interspersed with active flapping.

Sufficient lift-production during glides is the main criterion allowing birds to undulate.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1038/ncomms1350</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Undulating flight is a special form of intermittent locomotion and involves gliding with flexed wings interspersed with active flapping.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000531"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>undulatory flight</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000531"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">undulating-flying regime</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000531"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...on the plains of La Plata, where not a tree grows, there is a woodpecker, which in every essential part of its organisation, even in its colouring, in the harsh tone of its voice, and undulatory flight, told me plainly of its close blood-relationship to our common species; yet it is a woodpecker which never climbs a tree!&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000532 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000532">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000088"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000042"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000152"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
