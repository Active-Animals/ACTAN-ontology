        <oboInOwl:creation_date>2025-10-14T11:07:28.822456Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Avoidance which uses a more peripherally placed group member as a protection against threat.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>other for cover</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">shielded</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>agonistic buffering</oboInOwl:hasNarrowSynonym>
        <rdfs:label>shielded avoidance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000413"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000886"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
