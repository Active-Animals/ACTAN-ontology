        <owl:annotatedTarget>Monty Python&apos;s Holy Grail contains a wonderful scene involving a horseless knight, with added coconut shells, unilaterally skipping one half of a triple beat (transverse) gallop.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000210"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000091"/>
