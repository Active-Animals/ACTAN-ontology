        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Worm-size blind snakes (Typhlopidae), considered overwhelmingly subterranean, have been found several meters high in trees, perhaps following ant columns.&quot;</owl:annotatedTarget>
