        <oboInOwl:hasDefinition>Manoeuvre that involves a change in orientation.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>turn</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>turn maneuver</oboInOwl:hasExactSynonym>
        <rdfs:label>turning manoeuvre</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000645"/>
        <skos:example>&quot;The musculature supporting the seahorse fins is flexible and strong enough to provide additional functionality... These abilities are utilized during turn maneuvers to compensate for the inflexible body of the seahorse.&quot;</skos:example>
    </owl:Class>
