        <owl:annotatedTarget>colliding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1987</dc:date>
        <dc:source>doi:10.11369/jji1950.34.76</dc:source>
    </owl:Axiom>
