        <oboInOwl:creation_date>2026-09-15T20:00:48.391515Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Hunt which harasses prey to exit from holes and crevices in hard substrates.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>dislodging prey</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">dislodge hunt</rdfs:label>
        <skos:example>&quot;In Hawaii Parupeneus cyclostomus... pokes its barbels into holes and crevices in hard substrates to dislodge small animals.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000849"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Hunt which harasses prey to exit from holes and crevices in hard substrates.</owl:annotatedTarget>
        <dc:source>https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download</dc:source>
        <skos:scopeNote>&quot;They can be and are used as an excavating device or for harassing and dislodging prey from holes and crevices in hard substrates.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000849"/>
