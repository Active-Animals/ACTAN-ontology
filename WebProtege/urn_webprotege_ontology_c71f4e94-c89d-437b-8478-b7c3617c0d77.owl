    <!-- http://purl.obolibrary.org/obo/ACTAN_0000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_4000164"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-01-02T16:38:42.555698Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Natatorial mode that uses a laterally bending midline structure for thrust.

BCF propulsion couples muscle segments and can achieve greater thrust and acceleration than MPF propulsion.

The undulatory BCF locomotion modes also reflect changes in the wavelength and the amplitude envelope of the propulsive wave.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">BCF propulsion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>body and/or caudal fin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>slapping</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tail beat</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">BCF mode</rdfs:label>
        <skos:scopeNote>&quot;...many fish... switch to BCF modes at higher speeds, and high acceleration rates.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000026"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Natatorial mode that uses a laterally bending midline structure for thrust.

BCF propulsion couples muscle segments and can achieve greater thrust and acceleration than MPF propulsion.

The undulatory BCF locomotion modes also reflect changes in the wavelength and the amplitude envelope of the propulsive wave.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000026"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">BCF propulsion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000026"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>body and/or caudal fin</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000026"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>slapping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000026"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
