    <!-- http://purl.obolibrary.org/obo/ACTAN_0000866 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000866">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000513"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001301"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/colouration"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-03T17:12:42.625395Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Colouration that changes hue and saturation.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>chromatic</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">colouring</oboInOwl:hasExactSynonym>
        <rdfs:label>chromatics colouration</rdfs:label>
        <skos:example>&quot;Hemichromis bimaculatus...
The principal colour of the fish is red... females were always bright orange-red, the males more violet-red when bearing the reproductive markings... When not reproductively motivated the fishes are brownish red with a greenish hue. However, a change from deep red into bright orange-red can take place in a very short time.&quot;</skos:example>
        <skos:example>&quot;In the Stickleback, in the Centrarchids, and in the Cichlids of the Tilapia-type, there is a marked sexual dichromatism during the breeding season.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000866"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Colouration that changes hue and saturation.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000866"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>chromatic</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000866"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">colouring</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
