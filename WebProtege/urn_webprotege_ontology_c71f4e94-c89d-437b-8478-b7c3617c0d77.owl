    <!-- http://purl.obolibrary.org/obo/ACTAN_0000745 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000745">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000976"/>
