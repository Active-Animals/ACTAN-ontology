    <!-- http://purl.obolibrary.org/obo/ACTAN_0000454 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000454">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000893"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T20:23:06.249145Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Influence which causes an intruder to withdraw.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">repelling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>rejecting</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">repelling influence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000386"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000457"/>
        <skos:example>&quot;...ants prey upon, and their acids repel, ectoparasites;&quot;</skos:example>
        <skos:scopeNote>&quot;Costs of architecture can be divided into three main types: construction costs (the original costs of building the structure); maintenance costs (the costs of keeping the structure intact as well as repairing it in the event of damage); and defense costs (the costs of repelling intruders, including conspecifics who may attempt to take possession of the structure without having paid any of the original construction costs).&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000454"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Influence which causes an intruder to withdraw.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
