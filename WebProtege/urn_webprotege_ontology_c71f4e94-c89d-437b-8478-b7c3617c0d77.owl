        <owl:annotatedTarget>Movement in which a surface becomes apposed to another.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>ISBN:9781482294347</dc:source>
    </owl:Axiom>
