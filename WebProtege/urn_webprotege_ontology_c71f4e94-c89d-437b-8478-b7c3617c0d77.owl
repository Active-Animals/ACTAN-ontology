        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-28T15:41:32.185398Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>nibbling preening</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Waterproofing routine that involves manipulating feathers with the bill.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>feather combing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>zipping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>feather flicking</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>feather washing</oboInOwl:hasRelatedSynonym>
        <rdfs:label>zipping routine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000757"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000815"/>
        <skos:example>&quot;Ardeola ibis... Particularly when longer feathers are being dealt with, nibbling is supplemented by a flicking movement in which the feather is rapidly drawn through the bill.&quot;</skos:example>
        <skos:scopeNote>&quot;While the bathing movements distribute water over the body, it must be mainly the preening, head-rolling, and scratching which wash and clean the individual feathers.&quot;</skos:scopeNote>
    </owl:Class>
