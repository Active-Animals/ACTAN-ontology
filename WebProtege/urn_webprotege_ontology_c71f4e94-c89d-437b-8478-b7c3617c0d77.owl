                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-06T11:46:39.905516Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Feed that engulfs food.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>devouring</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ingestion</oboInOwl:hasExactSynonym>
        <rdfs:label>ingestion feed</rdfs:label>
        <skos:example>&quot;Badis badis...
Suddenly it darts forward with folded fins in a single snap of the trunk, and engulfs the Daphnia. The prey is chewed a few times, apparently by the pharyngeal teeth, before swallowing.&quot;</skos:example>
        <skos:scopeNote>&quot;Continuous Suction Feeders...
No forward body movement, uses suction to engulf prey.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000682"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Feed that engulfs food.</owl:annotatedTarget>
        <rdfs:isDefinedBy>ISBN:9780226315737</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Thus, more than one prey item is typically engulfed during each feeding bout, and some degree of nonselectivity is implied.&quot;</skos:scopeNote>
    </owl:Axiom>
