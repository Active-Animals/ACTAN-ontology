    <!-- http://purl.obolibrary.org/obo/ACTAN_0000564 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000564">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000690"/>
        <rdfs:subClassOf>
            <owl:Restriction>
