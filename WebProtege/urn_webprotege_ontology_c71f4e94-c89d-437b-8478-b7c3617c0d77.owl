    <!-- http://purl.obolibrary.org/obo/ACTAN_0000747 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000747">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000078"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-06-29T16:36:12.085589Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Activity that involves the displacement and orientation of body segments, joint angles, and spatio-temporal gait parameters.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">kinematics</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">kinematics activity</rdfs:label>
        <skos:example>&quot;...control muscles of flies generate little or no mechanical power yet act as controllable springs to direct the forces of much larger power muscles, thus providing the means by which the nervous system can rapidly alter wing kinematics by varying the timing of activation.&quot;</skos:example>
        <skos:narrowMatch>NBO:0000001</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000747"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Activity that involves the displacement and orientation of body segments, joint angles, and spatio-temporal gait parameters.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/icac125</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Kinematics: A technique used to study locomotion; the study of the displacement and orientation of body segments, joint angles, and spatio-temporal gait parameters.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000747"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">kinematics</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1989</dc:date>
        <dc:source>doi:10.1016/0021-9290(89)90224-8</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000747"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">kinematics activity</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000747"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...control muscles of flies generate little or no mechanical power yet act as controllable springs to direct the forces of much larger power muscles, thus providing the means by which the nervous system can rapidly alter wing kinematics by varying the timing of activation.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    


