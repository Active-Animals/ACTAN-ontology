    <!-- http://purl.obolibrary.org/obo/ACTAN_0000567 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000567">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000598"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-04T21:26:15.461859Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement in which an extremity remains hanging downwards.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">drooped</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>drooping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>swooning</oboInOwl:hasRelatedSynonym>
        <rdfs:label>droop placement</rdfs:label>
        <skos:example>&quot;...Red-browed Waxbills (Estrilda temporalis)... would stand on a smoldering log, in the curling wisps of smoke coming up through cracks in the bark, and there perform anting movements “quite distinct from those commonly seen when birds bathe in dust or water”. Each bird would stand upright, with tail as “support” and wings drooping a little forward and downward...&quot;</skos:example>
        <skos:scopeNote>&quot;Droopy (drooping) tail:... can also be part of a normal resting/sleep behavior... In adult zebrafish... which a long-lasting behavior;&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000567"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Placement in which an extremity remains hanging downwards.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000567"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">drooped</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
