    <!-- http://purl.obolibrary.org/obo/ACTAN_0000620 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000620">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000744"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-24T14:43:19.420526Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement that results from expanding.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">expansion placement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000744"/>
        <skos:example>&quot;Most burrowing bivalves differ from Divaricella in that their foot is larger and stronger. Their burrowing method consists of a cycle of push-pull movements. At first, the valves resist back-slippage by opening against the sediment while the foot digs downward . Once the foot expands to gain a hold within the sediment, the valves are slightly adducted to release their grip against the substrate, and the pedal retractor muscles contract, dragging the shell downward.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000620"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Placement that results from expanding.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000620"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">expansion placement</owl:annotatedTarget>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000620"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Most burrowing bivalves differ from Divaricella in that their foot is larger and stronger. Their burrowing method consists of a cycle of push-pull movements. At first, the valves resist back-slippage by opening against the sediment while the foot digs downward . Once the foot expands to gain a hold within the sediment, the valves are slightly adducted to release their grip against the substrate, and the pedal retractor muscles contract, dragging the shell downward.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1365-3121.1991.tb00141.x</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000621 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000621">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000736"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-24T14:44:58.249949Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement that results from retracting.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>retraction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>flexed</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>folded</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pressed down</oboInOwl:hasRelatedSynonym>
        <rdfs:label>retraction placement</rdfs:label>
        <skos:example>&quot;Can we consider the sting of the wasp or of the bee as perfect, which, when used against many attacking animals, cannot be withdrawn, owing to the backward serratures, and so inevitably causes the death of the insect by tearing out its viscera?&quot;</skos:example>
        <skos:example>&quot;The left appendages are folded over the right at the mouth of the shell forming a &apos;false operculum&apos;.&quot;</skos:example>
        <skos:scopeNote>&quot;—the manner in which the wings of insects are folded—&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000621"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Placement that results from retracting.</owl:annotatedTarget>
        <dc:source>https://orcid.org/0000-0002-4277-2151</dc:source>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000621"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>retraction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1986</dc:date>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
    </owl:Axiom>
    <owl:Axiom>
