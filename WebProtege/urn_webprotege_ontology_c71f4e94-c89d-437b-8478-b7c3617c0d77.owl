        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-06T15:10:25.603001Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Traversing-gait in which pendular movement, including phases with less than two grasped appendages, in net tension, propels the animal forward.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>swing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">swinging</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>arm swinging</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>brachiating</oboInOwl:hasNarrowSynonym>
        <rdfs:label>swing gait</rdfs:label>
        <skos:narrowMatch>NBO:0000365</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000254"/>
