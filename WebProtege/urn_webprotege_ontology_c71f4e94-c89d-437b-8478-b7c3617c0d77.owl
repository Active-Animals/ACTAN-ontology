        <oboInOwl:creation_date>2026-09-16T10:46:07.895506Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Bob in which the entire body is moved in alternate directions without losing contact with a substrate, by non-propulsive use of appendages.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">raising bob</rdfs:label>
        <skos:example>&quot;Chimpanzee...
The body bobs up and down as elbows are flexed and straightened.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000984"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Bob in which the entire body is moved in alternate directions without losing contact with a substrate, by non-propulsive use of appendages.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
