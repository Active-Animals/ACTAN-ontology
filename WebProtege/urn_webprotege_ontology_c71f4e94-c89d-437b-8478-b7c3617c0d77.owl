        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000539"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Courtship displays of R. decemdigitatus consisted of 11 steps: ... (vi) lateral displays, in which the male swims close to the female with erect dorsal and pectoral fins, shivering his body...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10682-007-9183-7</dc:source>
    </owl:Axiom>
