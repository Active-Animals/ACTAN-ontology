            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000929"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-26T19:21:08.837768Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Interfacing-regime that involves falling, without adaptive mechanisms to develop a high level of drag.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">ballistic descent</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ballistic fall</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>free-fall</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>sink</oboInOwl:hasNarrowSynonym>
        <rdfs:label>free-fall regime</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000238"/>
        <skos:example>&quot;Free fall can be either accidental, as when an animal is knocked from foliage, or intentional, as when insects descend from trees in a daily cycle.&quot;</skos:example>
        <skos:scopeNote>&quot;...the fish remains immobile (except for the eyes and gills) but changes its position in the water column (moving from top to bottom) without moving any of its fins.&quot;</skos:scopeNote>
    </owl:Class>
