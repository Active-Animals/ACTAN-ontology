    <!-- http://purl.obolibrary.org/obo/ACTAN_0000854 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000854">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000474"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000396"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-30T10:49:34.854918Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>pump oxygen-rich water</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Incubation that behaviourally ventilates with oxygenated water.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">aeration</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">aeration incubation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000676"/>
        <skos:scopeNote>&quot;The eggs and the larvae, as long as they are not able to swim, are aerated by one of the parents. The fish floats over them, constantly moving the fins, thus causing a powerful water current.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000854"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>pump oxygen-rich water</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1093/icb/icq077</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000854"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Incubation that behaviourally ventilates with oxygenated water.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/brv.12317</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;For aquatic ectotherms, including fish such as three-spined sticklebacks (Gasterosteus aculeatus), the selection of a nest site typically reflects a trade-off between taking advantage of water flows to ventilate eggs with oxygenated water, which reduces the energetic demands of behavioural ventilation, and the risk of washout from water currents.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000854"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">aeration</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000854"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">aeration incubation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000854"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The eggs and the larvae, as long as they are not able to swim, are aerated by one of the parents. The fish floats over them, constantly moving the fins, thus causing a powerful water current.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000855 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000855">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000020"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_4000164"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-30T12:53:40.222101Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Oscillating gait that swivels at  the caudal fin base without exhibiting wave formation.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>caudal fin swivel</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>caudal sculling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ostraciiform</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tail sculling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">tail beat</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>thunniform</oboInOwl:hasRelatedSynonym>
        <rdfs:label>ostraciiform-BCF gait</rdfs:label>
        <skos:example>&quot;Some captured sequences of very high speed swimming indicated that the boxfish... bent the peduncular region to a maximal lateral orientation and then executed a single hard beat that had the effect of accelerating the fish forward with considerable force.&quot;</skos:example>
        <skos:scopeNote>&quot;...if the transverse movements of the tail were symmetrical to the direction of movement:... the tail would exert equal pressure forwards and backwards. On the contrary, the transverse movement is symmetrical to the position of the head only, and as the head makes big sideways movements it is still possible that the greater part of the transverse strokes pushes the water backwards.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Interestingly, boxfishes have been the benchmark for classical descriptions of ‘ostraciiform’ locomotion as a BCF mode with minimal body curvature in which a sculling caudal fin is the primary propulsor. Preliminary observations, both in the laboratory and in the field, suggested that boxfishes normally do not swim in this classical mode: they use their median and paired fins as the major propulsors for most of their speed range. Thus, boxfishes should be considered as MPF, not BCF, swimmers.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000855"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Oscillating gait that swivels at  the caudal fin base without exhibiting wave formation.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/icab021</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;At its extreme, the oscillatory motions are confined to a caudal fin that swivels at its base without exhibiting wave formation.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000855"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>caudal fin swivel</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:date>
        <dc:source>doi:10.1093/icb/icab021</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000855"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>caudal sculling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000855"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>ostraciiform</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <rdfs:comment>BCF mode</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000855"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>tail sculling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000855"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">tail beat</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <rdfs:comment>A number of examples of &apos;tail beating&apos; appear to indicate a different behaviour and have not been included to avoid confusion, but they will be added to a future new term using the label &apos;tail beating&apos;.</rdfs:comment>
        <skos:scopeNote>&quot;In the swimming movement a wave passes through the body, in tail beating all myomeres are simultaneously contracted on one side. Therefore, in our opinion, the movement is a &quot;new&quot; action. It is a form by which the fish demonstrates the strength of its tail. so it could be classified as a demonstration movement.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000855"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>thunniform</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2014</dc:date>
        <dc:source>doi:10.1007/s00227-014-2403-0</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000855"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>ostraciiform-BCF gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000855"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Some captured sequences of very high speed swimming indicated that the boxfish... bent the peduncular region to a maximal lateral orientation and then executed a single hard beat that had the effect of accelerating the fish forward with considerable force.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000855"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...if the transverse movements of the tail were symmetrical to the direction of movement:... the tail would exert equal pressure forwards and backwards. On the contrary, the transverse movement is symmetrical to the position of the head only, and as the head makes big sideways movements it is still possible that the greater part of the transverse strokes pushes the water backwards.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000855"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Interestingly, boxfishes have been the benchmark for classical descriptions of ‘ostraciiform’ locomotion as a BCF mode with minimal body curvature in which a sculling caudal fin is the primary propulsor. Preliminary observations, both in the laboratory and in the field, suggested that boxfishes normally do not swim in this classical mode: they use their median and paired fins as the major propulsors for most of their speed range. Thus, boxfishes should be considered as MPF, not BCF, swimmers.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
        <rdfs:comment>Boxfishes are the only fishes which can undertake fully oscillatory BCF mode swimming. The &apos;Ostaciiform&apos; gait term is now preferably applied to asynchronous use of median and pectoral fins. Since both modes are unique to Ostraciiformes, perhaps it would be better to call them &apos;Ostraciiform BCF&apos; and &apos;Ostraciiform MPF&apos; gaits?</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000856 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000856">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000851"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002415"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-30T13:43:13.344336Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flutter which involves the tail.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">tail fluttering</oboInOwl:hasExactSynonym>
        <rdfs:label>tail flutter</rdfs:label>
        <skos:example>&quot;In Hemichromis we many times observed a vertical fluttering of the tail during egg laying...
Once we saw it carried out by a displaying Hemichromis...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000856"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flutter which involves the tail.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;With great frequency the tail is lifted and brought back again.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000856"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">tail fluttering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000856"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>tail flutter</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000856"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In Hemichromis we many times observed a vertical fluttering of the tail during egg laying...
Once we saw it carried out by a displaying Hemichromis...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000857 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000857">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000554"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000165"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-30T16:08:38.220482Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Antagonism in which two fish approach each other and make mouth contact.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">mouth-fighting</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">mouth-fight antagonism</rdfs:label>
        <skos:example>&quot;Cichlids...

The fishes approach each other, displaying frontally... Both adversaries try to grip the jaws of the other one;

Having seized each other firmly, they push and pull, beating heavily with the tails, the pectorals and often with the caudal flaps of the dorsalis and analis also.&quot;</skos:example>
        <skos:example>&quot;P. major sometimes bit each other’s mouth.&quot;</skos:example>
        <skos:example>&quot;The two fish open their mouth widely and press them against each other, acccompanied by up-and-down movements from just above the sea bottom to 10 cm above it. This behavior was observed only in E. japonica.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000857"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Antagonism in which two fish approach each other and make mouth contact.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1590/S1679-62252011005000018</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Mouth fighting: two fish approach each other with mouth opened and touch or bite their jaws. This behavior stops immediately after mouth contact, but in some cases it can lasts about a minute.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000857"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">mouth-fighting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000857"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">mouth-fight antagonism</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000857"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Cichlids...

The fishes approach each other, displaying frontally... Both adversaries try to grip the jaws of the other one;

Having seized each other firmly, they push and pull, beating heavily with the tails, the pectorals and often with the caudal flaps of the dorsalis and analis also.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000857"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;P. major sometimes bit each other’s mouth.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1444-2906.2003.00797.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000857"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The two fish open their mouth widely and press them against each other, acccompanied by up-and-down movements from just above the sea bottom to 10 cm above it. This behavior was observed only in E. japonica.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1444-2906.2003.00797.x</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000858 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000858">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000386"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-30T16:46:56.688367Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Attack which involves rapid movement towards an adversary and ramming it using part of the head.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>head butting</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">butting attack</rdfs:label>
        <skos:example>&quot;A subordinate male stationed over the nest’s rear slope usually did not provoke the resident male N. micropogon, but any movement of a subordinate towards the trough or onto the upstream slope elicited head butting and chasing.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000858"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Attack which involves rapid movement towards an adversary and ramming it using part of the head.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000858"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>head butting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000858"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">butting attack</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000858"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;A subordinate male stationed over the nest’s rear slope usually did not provoke the resident male N. micropogon, but any movement of a subordinate towards the trough or onto the upstream slope elicited head butting and chasing.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000859 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000859">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000372"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000847"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-01T06:51:22.285326Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>strike</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Resistance that involves lunging toward a target, at speed, while mouth opening.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">open-mouth strike</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">mouth-strike resistance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000123"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000512"/>
        <skos:scopeNote>&quot;Smaller snakes, regardless of species, have no choice when confronted by a predator but to strike with less efficient venom delivery systems and engage the predator more actively, not being able to coil up into a defensive posture and withstand a brief attack.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000859"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>strike</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000859"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Resistance that involves lunging toward a target, at speed, while mouth opening.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000859"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">open-mouth strike</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000859"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">mouth-strike resistance</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000859"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Smaller snakes, regardless of species, have no choice when confronted by a predator but to strike with less efficient venom delivery systems and engage the predator more actively, not being able to coil up into a defensive posture and withstand a brief attack.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000860 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000860">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001034"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-01T06:51:52.527002Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics which produces an impact.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>hit</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hitting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>into</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>strike</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">striking</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hit kinetics</rdfs:label>
        <skos:example>&quot;Courtship displays of R. decemdigitatus consisted of 11 steps: ... (ix) biting of the female and swimming into her...&quot;</skos:example>
        <skos:example>&quot;Many nests have their centres less than 2 X 30cm. from their nearest neighbour&apos;s, yet only once in many hundreds of observations has one sitting A. ibis been observed to strike another.&quot;</skos:example>
        <skos:scopeNote>&quot;After pole vaulting, the dog pushes upward and forward simultaneously off this second front foot; both E, and Ekf increase, and the center of mass returns to its original height. An aerial phase usually takes place after this push-off until the first rear foot strikes the ground again and the cycle repeats itself.&quot;</skos:scopeNote>
    </owl:Class>
