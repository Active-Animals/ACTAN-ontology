    <!-- http://purl.obolibrary.org/obo/ACTAN_0000608 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000608">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000326"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-17T15:39:48.479199Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Influence which reunites opponents soon after an aggressive interaction.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">reconciliation</oboInOwl:hasExactSynonym>
        <rdfs:label>reconciliation influence</rdfs:label>
        <skos:closeMatch>NBO:0000296</skos:closeMatch>
        <skos:example>&quot;But the cleaner has a mode of reconciliation; they chase after the distraught client and give them a back rub, thus enticing them to come again.&quot;</skos:example>
        <skos:example>&quot;Chimpanzees...
Two adult males embrace ventro-ventrally and bipedally in the context of reassurance or reconciliation, and one of the males may thrust against another.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000608"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Influence which reunites opponents soon after an aggressive interaction.</owl:annotatedTarget>
        <dc:contributor>doi:10.1163/1568539X-00003176</dc:contributor>
        <skos:scopeNote>&quot;It is known that friendly reunions of opponents soon after an aggressive interaction (reconciliations) are less likely to occur in the context of feeding.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000608"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">reconciliation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000608"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>reconciliation influence</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000608"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;But the cleaner has a mode of reconciliation; they chase after the distraught client and give them a back rub, thus enticing them to come again.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10071-014-0761-0</dc:source>
    </owl:Axiom>
