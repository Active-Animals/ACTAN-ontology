        <oboInOwl:hasDefinition>Crutch gait in which after planting the forelimbs, the hindlimbs of a quadruped are swung though the forelimbs.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">crutch walk</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>crutching</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">crutch-walk gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000216"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Crutch gait in which after planting the forelimbs, the hindlimbs of a quadruped are swung though the forelimbs.</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF02381373</dc:source>
        <skos:scopeNote>&quot;After planting the forelimbs the body and hindlimbs are swung though the forelimbs.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000216"/>
