    <!-- http://purl.obolibrary.org/obo/ACTAN_0000874 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000874">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000553"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-08T10:34:49.687272Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>establishing</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Territorialism that replaces another in an existing territory.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">succeeding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>restoring</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>taking</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">succeeding territorialism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000930"/>
        <skos:example>&quot;...competition for large corals resulting in the displacement of smaller fish by larger individuals, as the reason for the positive relationship between the size of Gobiodon histrio and the size of their host-coral, Acropora nasuta.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000874"/>
