                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002472"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-08T07:10:55.437254Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Search that is area-restricted, consisting of a high frequency of high-angle turns, in the absence of resource cues.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>area-restricted search</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">patrolling</oboInOwl:hasExactSynonym>
        <rdfs:label>local search</rdfs:label>
        <skos:example>&quot;The hermit crabs, Coenobita compressus, were observed frequently along the beach over 2 months. They were very active at night in the intertidal zone patrolling the moist sand in search of food.&quot;</skos:example>
        <skos:example>&quot;The quality or size of the prey consumed is often positively correlated with the duration and intensity of the area-restricted search. For example, predatory bugs used much longer and intense area-restricted search when feeding on a 4th instar aphid rather than a 1st instar aphid.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000304"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Search that is area-restricted, consisting of a high frequency of high-angle turns, in the absence of resource cues.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1534/genetics.120.303539</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000304"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>area-restricted search</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2011</dc:date>
        <dc:source>doi:10.1111/j.1469-185X.2010.00163.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000304"/>
