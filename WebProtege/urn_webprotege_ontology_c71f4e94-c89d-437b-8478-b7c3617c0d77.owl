        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-11T17:51:47.181562Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement that results from adducting.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">adducted</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>clamped down</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>laid against</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pressed against</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tucked</oboInOwl:hasRelatedSynonym>
        <rdfs:label>adduction placement</rdfs:label>
        <skos:scopeNote>&quot;Pectoral fin-beat cycles started with the fins pressed against the body (maximally adducted), moving away (abducting) from the body to some maximum point of excursion and returning (adducting) to the original position.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000630"/>
