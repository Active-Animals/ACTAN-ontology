    <!-- http://purl.obolibrary.org/obo/ACTAN_0000331 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000288"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000303"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-15T09:02:46.196165Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Relativity in which one animal tries to overtake another.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>chase</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>chasing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">pursuing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pursuit</oboInOwl:hasExactSynonym>
        <rdfs:label>pursuit relativity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000325"/>
        <skos:example>&quot;Thalassoma cupido...
Spawning... mild chases contribute to the unstable nature of the aggregations.&quot;</skos:example>
        <skos:narrowMatch>NBO:0020040</skos:narrowMatch>
        <skos:scopeNote>&quot;One possibility is that different stages of the behavior have a different organization. For example, animals might dynamically modulate their movements to adjust to the position of the prey during pursuit, but resort to more stereotyped motor patterns when consuming prey.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The male will follow or chase the female in a jerky swimming motion with his dorsal fin erect... If the male’s advance is unwelcome, the female may chase the male away.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000331"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Relativity in which one animal tries to overtake another.</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <dc:source>https://orcid.org/0000-0002-4277-2151</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000331"/>
