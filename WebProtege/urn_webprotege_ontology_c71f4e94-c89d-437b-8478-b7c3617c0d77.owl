        <owl:annotatedTarget xml:lang="en">displacement switch</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000706"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Wing-touch is obviously a preening movement, since no other activity involves contact between beak and wing. The display contains all the characteristics of a displacement activity, namely an irrelevant movement...&quot;</owl:annotatedTarget>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000707 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000707">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000541"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-14T06:22:48.925476Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Switch in which activities toward a potential object or animal goal, are instead shown toward another.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">redirection</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">redirection switch</rdfs:label>
        <skos:example>&quot;...female A threatened a trespasser, was threatened in return, and a fight developed. Male A then flew down from a perch in the treetop, drove the trespasser from the site, then momentarily redirected his attack against his mate, but within a second their behaviour switched to high-intensity mutual Back Biting.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000707"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Switch in which activities toward a potential object or animal goal, are instead shown toward another.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000707"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">redirection</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1966</dc:date>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000707"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">redirection switch</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000707"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...female A threatened a trespasser, was threatened in return, and a fight developed. Male A then flew down from a perch in the treetop, drove the trespasser from the site, then momentarily redirected his attack against his mate, but within a second their behaviour switched to high-intensity mutual Back Biting.&quot;</owl:annotatedTarget>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000708 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000708">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000341"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000893"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-14T14:41:43.043429Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Maintenance which relieves restlessness.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">comfort movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>toilet</oboInOwl:hasNarrowSynonym>
        <rdfs:label>comfort maintenance</rdfs:label>
        <skos:scopeNote>&quot;Some of these categories (e.g. oiling and bathing) include movements which occur in sequences and form a pattern.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Usually all these movement are carried out alternately, but they have one common feature: before the movement is carried out the animal is restless, but after it, it looks as if it feels more comfortable.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000708"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Maintenance which relieves restlessness.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000708"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">comfort movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000708"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
