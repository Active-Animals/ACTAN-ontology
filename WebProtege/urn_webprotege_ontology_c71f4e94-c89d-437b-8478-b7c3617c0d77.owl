        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000419"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>tactile interaction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2026</dc:date>
        <dc:source>doi:10.1016/j.anbehav.2026.123487</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000419"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>tactile sensory stimulus</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
        <skos:scopeNote>&quot;...sensory stimuli: tactile...</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000419"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>tactile sign stimulus</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1966</dc:date>
        <dc:source>doi:10.2307/4083155</dc:source>
        <skos:scopeNote>&quot;...sign stimuli... tactile ones.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000419"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">tactile signal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2005</dc:date>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000419"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>touch signal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000419"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>touch modality</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000419"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...the territorial Mediterranean rainbow wrasse, Coris julis, which joins producer—scrounger aggregations with a goatfish species, Mullus surmuletus, that disturbs benthic prey during foraging. Wrasse remained within their territories and did not follow producers beyond these boundaries but repeatedly engaged in tactile interactions (brief physical contact using their ventral side and pelvic fins or caudal fin) with goatfish while they were present. Events involving tactile interactions were associated with longer feeding durations of goatfish and therefore, indirectly, a higher overall food uptake for wrasse.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.anbehav.2026.123487</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000419"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Elaborate courtship behaviours – often involving visual cues – have been described for various groups of salamanders, mammals, birds and fishes while olfactory and tactile signals are particularly important for many mammal species and songs and calls for the mating behaviour of birds and anurans.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000419"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;One type of tactile signal apparently ubiquitous in spiders is rhythmical movements of the genitalia during copulation, either in the form of repeated insertions and withdrawals or as rhythmic movements during insertion.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000420 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000420">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000416"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000058"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:31:27.756029Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>olfactory sign stimulus</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">olfactory signal</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Semiochemical that involves a volatile compound.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>scent</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">scent semiochemical</rdfs:label>
        <skos:example>&quot;In addition to olfactory cues emanating from the substrate itself, female D. melanogaster are also attracted and stimulated to lay eggs on particular spots by volatile pheromones deposited on the substrate by other individuals, males or females.&quot;</skos:example>
        <skos:scopeNote>&quot;In addition to visual displays, many acoustic and olfactory breeding signals are transmitted through the air, including an assortment of vocalizations, stridulations, airborne pheromones, and pollinator attractors.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000420"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>olfactory sign stimulus</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1966</dc:date>
        <dc:source>doi:10.2307/4083155</dc:source>
        <skos:scopeNote>&quot;...sign stimuli... olfactory... ones.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000420"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget xml:lang="en">olfactory signal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
