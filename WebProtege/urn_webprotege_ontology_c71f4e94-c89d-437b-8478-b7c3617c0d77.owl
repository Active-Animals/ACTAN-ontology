        <oboInOwl:creation_date>2025-08-13T11:10:16.388311Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Contraction that results from shrivelling contracting.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">shrivelled</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">shrivel contraction</rdfs:label>
        <skos:example>&quot;Metridium senile... The whole anemone may on occasion temporarily assume a shrivelled and contracted condition... which, in fact, is a normal temporary state from which there is comparatively rapid recovery.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000804"/>
