    <!-- http://purl.obolibrary.org/obo/ACTAN_0000311 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000300"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-13T13:29:17.270883Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics in which movement has completely ceased, except for eyes and respiration.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">immobility</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>motionless</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>stationary</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">immobility kinetics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000617"/>
        <skos:example>&quot;...the ability of crayfish (Orconectes virilis) to detect and respond to predator odours is negatively related to current velocity, resulting in reduced foraging activity and increased time spend immobile.&quot;</skos:example>
        <skos:example>&quot;Thalassoma cupido...
Usually she lies nearly motionless in the algae with only her head protruding until emerging to spawn.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000311"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics in which movement has completely ceased, except for eyes and respiration.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
