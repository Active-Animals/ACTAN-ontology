    <!-- http://purl.obolibrary.org/obo/ACTAN_0000534 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000772"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000652"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-20T21:21:36.785234Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flap in which both strokes produce power.

In some configurations, both strokes may also produce lift.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>lift-based</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vorticity method</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>inverted von Kármán vortex street</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>reverse Karman vortex street</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">lift-based flap</rdfs:label>
        <skos:example>&quot;...alcids use a lift based propulsion mechanism in air and water, but during the aquatic phase the bird utilizes an active upstroke; that is lift is produced on the up stroke as well as the down stroke.&quot;</skos:example>
        <skos:example>&quot;In slow starting, the fish appears to change the pitch of the sculling pectoral fins slightly, directing the water current to the rear.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000534"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flap in which both strokes produce power.

In some configurations, both strokes may also produce lift.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1088/1748-3182/9/1/011001</dc:source>
    </owl:Axiom>
