    <!-- http://purl.obolibrary.org/obo/ACTAN_0000622 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000622">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000744"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001154"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002313"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-24T14:46:31.558124Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym xml:lang="en">telescoping</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Expanding which unsheathes one layer stacked inside another resulting in overall lengthening.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>extend like a telescope</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>telescopic elongation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>unsheathe</oboInOwl:hasRelatedSynonym>
        <rdfs:label>telescoping expanding</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000741"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000742"/>
        <skos:example>&quot;The chameleon tongue may have evolved telescoping motion to increase the accuracy of striking a target. Chameleons unsheathe the 10 stacked muscle layers in their tongue to reach far-reaching objects.&quot;</skos:example>
        <skos:scopeNote>&quot;Telescopic elongation may reduce energy use for elephants because of the trunk’s tapered shape.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000622"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
