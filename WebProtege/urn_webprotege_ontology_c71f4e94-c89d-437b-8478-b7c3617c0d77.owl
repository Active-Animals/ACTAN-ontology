    <!-- http://purl.obolibrary.org/obo/ACTAN_0000269 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000269">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000266"/>
        <rdfs:subClassOf rdf:nodeID="genid1935"/>
        <rdfs:subClassOf rdf:nodeID="genid1937"/>
        <rdfs:subClassOf rdf:nodeID="genid1939"/>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-06T18:53:02.390919Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Aquatic-lateral-undulating gait that uses significant lateral movements only at the caudal fin and at the area near the narrow peduncle. 

The body is well streamlined to significantly reduce pressure drag, while the caudal fin is stiff and high, with a crescent-moon shape often referred to as lunate.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>thuniform mode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">thunniform axial swim</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thunniform mode</oboInOwl:hasExactSynonym>
        <rdfs:label>thunniform gait</rdfs:label>
        <skos:example>&quot;In teleost fish, thunniform mode is encountered in scombrids, such as the tuna and the mackerel.&quot;</skos:example>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid1935">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000534"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid1937">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_4000164"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid1939">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFA_0000178"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000269"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid1935"/>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000269"/>
