            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-16T15:05:54.813863Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Contraction that results from buckling contracting.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">buckled</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">buckle contraction</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000084"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
