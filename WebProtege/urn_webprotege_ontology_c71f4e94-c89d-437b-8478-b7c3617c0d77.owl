    <!-- http://purl.obolibrary.org/obo/ACTAN_0000276 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000272"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000616"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-07T08:08:32.721186Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>decorating</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>decoration</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>ornamenting</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Construction that accumulates and retains environmental material that becomes attached to the exterior.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">cobbling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">encasing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>hatting</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>trash-carrying</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>carrying</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cocooning</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>covering</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>masking</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>shield-carrying</oboInOwl:hasRelatedSynonym>
        <rdfs:label>decoration construction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000445"/>
        <skos:example>&quot;For example, the external casings and nets constructed by caddisfly larvae can serve to protect the larva’s soft body and trap food items flowing through streams. And as the larva grows, it can enlarge the casing to accommodate its bigger body.&quot;</skos:example>
        <skos:example>&quot;The most widely studied group of decorators are crabs of the superfamily Majoidea. The group has over 900 species, about 75% of which show decorating over some or all of their body, having specialized hooked setae to attach material from the environment.&quot;</skos:example>
        <skos:scopeNote>&quot;Other forms of animal architecture do not require attaching or cobbling matter together, but rather excavating material from a substrate.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000276"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>decorating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2006</dc:date>
        <dc:source>https://www.researchgate.net/profile/Sarah-Woodin/publication/228674786_Modelling_the_energy-mortality_trade-offs_of_invertebrate_decorating_behaviour/links/5505fb030cf2d60c0e6c825b/Modelling-the-energy-mortality-trade-offs-of-invertebrate-decorating-behaviour.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000276"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>decoration</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2006</dc:date>
        <dc:source>https://www.researchgate.net/profile/Sarah-Woodin/publication/228674786_Modelling_the_energy-mortality_trade-offs_of_invertebrate_decorating_behaviour/links/5505fb030cf2d60c0e6c825b/Modelling-the-energy-mortality-trade-offs-of-invertebrate-decorating-behaviour.pdf</dc:source>
    </owl:Axiom>
