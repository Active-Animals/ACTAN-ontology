        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000814"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-04T15:38:17.764123Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Counter-irritant routine that scrapes a body part across an unyielding external object.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">chafing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>grating</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">chafe routine</rdfs:label>
        <skos:example>&quot;...irritation can lead to rather extreme reactions by the shark, such as... chafing the irritated body part on the bottom...&quot;</skos:example>
        <skos:example>&quot;Less frequently a fish chafes in its usual upright position, with the ventral side over the substrate. Once we saw this in a female Tilapia natalensis carrying young in its mouth. Probably the movements of the young, trying to escape, irritated the fish.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000679"/>
