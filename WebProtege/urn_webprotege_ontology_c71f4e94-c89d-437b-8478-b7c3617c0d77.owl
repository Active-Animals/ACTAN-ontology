        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000878"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Parasitic Jaegers regularly team-hunt in pairs or small groups. Team-hunting occurs as:... two birds hunting cooperatively by assisting each other.&quot;</owl:annotatedTarget>
