        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000229"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>flat-concertina gait</owl:annotatedTarget>
