        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000907"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The Tilapia young are already completely developed some days before they leave the mouth of the female... Now and then a young escapes, but immediately the female tries to catch it... This all suggests that the young are trying to get free, but that the female is not yet willing to let them go.&quot;&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000907"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The leading jaeger forced the sandpiper up, and after a quick series of alternate stoops by both jaegers, 1 caught the sandpiper in its bill, just above the grass. The jaeger carried the flapping sandpiper about 20 m, landed on the tundra and then placed the prey under its feet.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/4161407</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000907"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...forced copulation, where a male uses superior speed or strength to catch and physically restrain a female while he copulates with her by force;&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    


