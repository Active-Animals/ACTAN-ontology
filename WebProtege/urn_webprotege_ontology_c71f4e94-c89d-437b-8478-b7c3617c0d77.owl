        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-03T15:32:04.735509Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Autogroom-constellation which involves diving with open wings, and flapping about on the water surface.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">dashing-and-diving</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>diving play</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>playing chase</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">dash-and-dive constellation</rdfs:label>
        <skos:scopeNote>&quot;This behaviour may be exhibited by a solitary bird but, as all observers have noted, it is contagious and when one or two birds begin others nearby follow suit.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000818"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Autogroom-constellation which involves diving with open wings, and flapping about on the water surface.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853965x00138</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Diving with the wings open is one of the main actions. Then after surfacing from a number of rapid dives the birds flap about on the surface, fly short distances, and dive from the air.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000818"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">dashing-and-diving</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000818"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>diving play</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000818"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>playing chase</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000818"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">dash-and-dive constellation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000818"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;This behaviour may be exhibited by a solitary bird but, as all observers have noted, it is contagious and when one or two birds begin others nearby follow suit.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000819 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000819">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000155"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000150"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000421"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000529"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-07T13:33:34.690338Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Interfacing-gait in which the wings are used simultaneously as oars, with deep alternate strokes of the feet.

Often the foot paddles break the surface of the water. Oaring of wings and upright posture of the head and neck probably keep the birds from being driven underwater by the powerful thrusts of their feet.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">steaming</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">steaming gait</rdfs:label>
        <skos:example>&quot;I have observed the wing-and-leg-stretch in the post-copulation situation in the male European and Barrow&apos;s Goldeneyes, after the characteristic Steaming away from the female.&quot;</skos:example>
        <skos:example>&quot;Preen-back-behind-wing is given by male Goldeneyes and the Hooded Merganser before copulation. It is performed once only, immediately before the male Steams toward the female.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000819"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Interfacing-gait in which the wings are used simultaneously as oars, with deep alternate strokes of the feet.

Often the foot paddles break the surface of the water. Oaring of wings and upright posture of the head and neck probably keep the birds from being driven underwater by the powerful thrusts of their feet.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.jstor.org/stable/4086543</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;We confirmed photographically for T. pteneres that steaming birds use their wings simultanecusly and that the wings are used as oars rather than simply flapped as in a take-off run. Virtually all propulsion and turbulence results from deep alternate strokes of the feet. Often the foot paddles break the surface of the water behind the birds, and the arc of paddle movement sometimes ends above the level of the back, as noted by Reynolds (1934: 351). Oaring of wings and upright posture of the head and neck probably keep the birds from being driven underwater by the powerful thrusts of their feet.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000819"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">steaming</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000819"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">steaming gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000819"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;I have observed the wing-and-leg-stretch in the post-copulation situation in the male European and Barrow&apos;s Goldeneyes, after the characteristic Steaming away from the female.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000819"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Preen-back-behind-wing is given by male Goldeneyes and the Hooded Merganser before copulation. It is performed once only, immediately before the male Steams toward the female.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000820 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000820">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000242"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-07T13:51:24.371382Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Lie that is on the belly.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">prone</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">prone lie</rdfs:label>
        <skos:example>&quot;In Mergini, the female frequently reacts at once to the male&apos;s pre-copulatory behaviour by assuming the Prone posture and remaining immobile until he mounts.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000820"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Lie that is on the belly.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1537/ase.107.141</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Lie prone (LIP) (Type A): Lie on belly.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000820"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
