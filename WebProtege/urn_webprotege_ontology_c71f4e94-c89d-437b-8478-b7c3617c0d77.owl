    <!-- http://purl.obolibrary.org/obo/ACTAN_0000090 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000639"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000152"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-12T09:25:49.428006Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>already abducted fin</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Abduction that results from pelvic abducting.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">pelvic-fin abduction</rdfs:label>
        <skos:example>&quot;In some fishes, one extreme being the pomocentrids of the genus Dascyllus, the pelvic fin, on the side toward which the fish is turning, is lowered and serves as a pivot, or brake.&quot;</skos:example>
        <skos:example>&quot;In such long bodied forms as Esox it is clear that if the low hung pectorals were simply dropped, while they would stop the fish, they would likewise “trip it up,” i. e., cause the caudal portion to raise up because the point of pressure is anterior and low. In order to avoid this the pelvics which in these forms are placed well aft are... thrown down simultaneously at approximately the same angle, thus producing two points of resistance, one forward and the other aft, which causes no tendency for either end to raise.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000090"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>already abducted fin</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000090"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Abduction that results from pelvic abducting.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000090"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">pelvic-fin abduction</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000090"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In some fishes, one extreme being the pomocentrids of the genus Dascyllus, the pelvic fin, on the side toward which the fish is turning, is lowered and serves as a pivot, or brake.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000090"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In such long bodied forms as Esox it is clear that if the low hung pectorals were simply dropped, while they would stop the fish, they would likewise “trip it up,” i. e., cause the caudal portion to raise up because the point of pressure is anterior and low. In order to avoid this the pelvics which in these forms are placed well aft are... thrown down simultaneously at approximately the same angle, thus producing two points of resistance, one forward and the other aft, which causes no tendency for either end to raise.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000091 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000091">
