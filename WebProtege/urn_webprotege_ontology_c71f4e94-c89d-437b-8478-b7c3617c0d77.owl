    <!-- http://purl.obolibrary.org/obo/ACTAN_0000456 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000464"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000414"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T20:23:53.769664Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Manipulation that redirects another&apos;s attention and subsequent behaviour.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>distracting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>distraction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">diverting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>redirection</oboInOwl:hasRelatedSynonym>
        <rdfs:label>distraction manipulation</rdfs:label>
        <skos:example>&quot;Mother grooms infant to divert its attention from sucking from nipples during the weaning period. If the infant is male and he throws temper tantrums in response to his mother&apos;s refusal, she sometimes allows him to copulate with her.&quot;</skos:example>
        <skos:narrowMatch>NBO:0020219</skos:narrowMatch>
        <skos:scopeNote>&quot;Greene (1973) categorized defensive tail displays of snakes into three major functions: 1) to divert attack toward the tail, 2) to inhibit attack with an aposematic display, and 3) to disorient the predator with a flash display.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Thus, an initial victim may benefit most by performing redirected aggression if doing so reduces its total suffering from renewed aggression. By performing redirection, a victim can change its status from victim to aggressor. The bystanders might then shift their attention to the next victim; thus, the initial victim may be able to avoid renewed aggression from them.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000456"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Manipulation that redirects another&apos;s attention and subsequent behaviour.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/1568539X-00003176</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000456"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>distracting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000456"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>distraction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1988</dc:date>
        <dc:source>doi:10.1126/science.239.4847.1525</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000456"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">diverting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000456"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>redirection</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2014</dc:date>
        <dc:source>doi:10.1163/1568539X-00003176</dc:source>
        <rdfs:comment>This class is about redirecting another&apos;s behaviour, which should not be confused with the internal mechanism causing an animal to redirect its own behaviour.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000707"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000456"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>distraction manipulation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000456"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Mother grooms infant to divert its attention from sucking from nipples during the weaning period. If the infant is male and he throws temper tantrums in response to his mother&apos;s refusal, she sometimes allows him to copulate with her.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000456"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Greene (1973) categorized defensive tail displays of snakes into three major functions: 1) to divert attack toward the tail, 2) to inhibit attack with an aposematic display, and 3) to disorient the predator with a flash display.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000456"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Thus, an initial victim may benefit most by performing redirected aggression if doing so reduces its total suffering from renewed aggression. By performing redirection, a victim can change its status from victim to aggressor. The bystanders might then shift their attention to the next victim; thus, the initial victim may be able to avoid renewed aggression from them.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/1568539X-00003176</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000457 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000439"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000553"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T20:24:12.823017Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Warning that represents the potential to attack.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>threat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">threatening</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">threat warning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000386"/>
        <skos:closeMatch>NBO:0020108</skos:closeMatch>
        <skos:example>&quot;Cichlasoma meeki...
Whenever the fish is threatening, seven black vertical bands appear...&quot;</skos:example>
        <skos:example>&quot;Red sea bream Pagrus major and crimson sea bream, Evynnis japonica...

The territory holder threatens the invaders by slightly dipping its head.&quot;</skos:example>
        <skos:scopeNote>&quot;Tools can be used to create and mediate influence interactions: a brandished stick might communicate a more effective threat than a bare fist, for example...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000457"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Warning that represents the potential to attack.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000457"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>threat</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000457"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
