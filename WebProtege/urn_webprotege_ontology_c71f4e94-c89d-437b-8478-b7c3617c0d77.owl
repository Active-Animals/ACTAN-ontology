    <!-- http://purl.obolibrary.org/obo/ACTAN_0000067 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000068"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-01-19T20:41:58.846578Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Winged mode that moves with both wing pairs in roughly independent motion.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>functionally tetrapterous</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tetrapterous</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">four winged</oboInOwl:hasNarrowSynonym>
        <rdfs:label>tetrapterous mode</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000067"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Winged mode that moves with both wing pairs in roughly independent motion.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1002/jmor.10788</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Insects that fly with both pairs moving in roughly independent motion are termed functionally tetrapterous, and are exemplified by the dragonflies (Odonata) and lacewings (Neuroptera).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
