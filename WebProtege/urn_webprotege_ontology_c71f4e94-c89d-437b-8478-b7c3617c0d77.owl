    <!-- http://purl.obolibrary.org/obo/ACTAN_0000163 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000671"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001022"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-14T07:03:30.40683Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Thrust in which a grounded push produces an equal and opposite ground reaction force, causing locomotion.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>push-off</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>GRF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ground reaction force</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">push-off thrust</rdfs:label>
        <skos:example>&quot;Frogfish are operating in a microgravity environment and their “walking” behavior produces GRFs via fin-ground interactions allowing frogfish to maintain their body above the substrate for most of the locomotor cycle or even enter into a suspension phase (where no appendages are in contact with the substrate).&quot;</skos:example>
        <skos:example>&quot;In a running cockroach, hind-leg ground reaction forces propel the animal forward,
whereas each foreleg ground reaction force pushes backward, counter to the animal&apos;s
movement. The middle-leg ground reaction force begins by pushing backward but then
pushes forward at the end of the stance phase. In addition to these fluctuating fore-aft forces, all legs act to push the body toward the midline.&quot;</skos:example>
        <skos:narrowMatch>NBO:0000016</skos:narrowMatch>
        <skos:scopeNote>&quot;Bipedal hop: Torso-orthograde ( [ ) bipedal progression wherein the hindlimbs push off and land roughly simultaneously;&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000163"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Thrust in which a grounded push produces an equal and opposite ground reaction force, causing locomotion.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1126/science.288.5463.100</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;First, consider legged locomotion on land, where each leg pushes against the ground, producing an equal and opposite ground reaction force.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000163"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>push-off</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000163"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GRF</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000163"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ground reaction force</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1987</dc:date>
        <dc:source>doi:10.1242/jeb.130.1.155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000163"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">push-off thrust</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000163"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Frogfish are operating in a microgravity environment and their “walking” behavior produces GRFs via fin-ground interactions allowing frogfish to maintain their body above the substrate for most of the locomotor cycle or even enter into a suspension phase (where no appendages are in contact with the substrate).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000163"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In a running cockroach, hind-leg ground reaction forces propel the animal forward,
whereas each foreleg ground reaction force pushes backward, counter to the animal&apos;s
movement. The middle-leg ground reaction force begins by pushing backward but then
pushes forward at the end of the stance phase. In addition to these fluctuating fore-aft forces, all legs act to push the body toward the midline.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000163"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Bipedal hop: Torso-orthograde ( [ ) bipedal progression wherein the hindlimbs push off and land roughly simultaneously;&quot;</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000164 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000164">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000019"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-14T08:18:52.715528Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Natatorial mode that uses an orifice out of which to direct fluid for thrust.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>nozzle reaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>syringograde</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">nozzle mode</rdfs:label>
        <skos:example>&quot;However, on the sluggish forms a definite demonstration of this force of the exhaled water is a simple matter, the Tetraodonts demonstrating it most clearly, although it must be admitted that here, on account of the rather wide divergence of the exhalant apertures, “nozzle reaction” plays a relatively larger part.&quot;</skos:example>
        <skos:scopeNote>&quot;...the so-called syringograde animals which suck up water slowly and expel it with violence through the same or a nearby aperture, such as the cephalopods, medusae and certain Odonata nymphs. This notoriously inefficient method may be compared to the discredited jet propulsion systems of the past.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Jet propulsion by bullet-shaped jellyfish is more energy efficient than that of dish-shaped jellyfish...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The funnel, too, is more than the simple directional nozzle of fixed cross-section assumed in earlier studies. The... best explanation for the increasing pressure with constant flow at higher speeds is active reduction of the maximum (or possibly average) funnel radius... It is also difficult to explain the prolonged high pressures during an escape response unless funnel radius... continues to decrease under active muscle tension. Squid may well have continuous dynamic control over the funnel orifice allowing them to optimize power output from a given volume change at a given speed, a relatively complex problem.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000164"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Natatorial mode that uses an orifice out of which to direct fluid for thrust.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000164"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>nozzle reaction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000164"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>syringograde</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000164"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">nozzle mode</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000164"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;However, on the sluggish forms a definite demonstration of this force of the exhaled water is a simple matter, the Tetraodonts demonstrating it most clearly, although it must be admitted that here, on account of the rather wide divergence of the exhalant apertures, “nozzle reaction” plays a relatively larger part.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000164"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...the so-called syringograde animals which suck up water slowly and expel it with violence through the same or a nearby aperture, such as the cephalopods, medusae and certain Odonata nymphs. This notoriously inefficient method may be compared to the discredited jet propulsion systems of the past.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000164"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Jet propulsion by bullet-shaped jellyfish is more energy efficient than that of dish-shaped jellyfish...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000164"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The funnel, too, is more than the simple directional nozzle of fixed cross-section assumed in earlier studies. The... best explanation for the increasing pressure with constant flow at higher speeds is active reduction of the maximum (or possibly average) funnel radius... It is also difficult to explain the prolonged high pressures during an escape response unless funnel radius... continues to decrease under active muscle tension. Squid may well have continuous dynamic control over the funnel orifice allowing them to optimize power output from a given volume change at a given speed, a relatively complex problem.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.137.1.421</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000165 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000645"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-14T13:03:23.229621Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Steering which involves asymmetric propulsion.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">propulsion steering</rdfs:label>
        <skos:example>&quot;The families Trygonidae and Myliobatidae have carried the rajiform undulations a step further... Steering is accomplished for the most part by differential action of the pectorals. That is, in curving, the outside “wing” is speeded up or the inside one retarded which swings the animal accordingly.&quot;</skos:example>
        <skos:scopeNote>&quot;Fishes using a simple flapping movement of the dorsal and anal may oscillate them both over to one side,&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Metameral waves may be propagated in greater number or be of larger size on one side than the other, instead of simply alternating uniformly.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Probably the most common method is a single flap of the tail to one side... In this action the tail is expanded to its full extent in making the stroke and contracted on its return to the median position in order to prevent a reverse turning action or any more forward motion than necessary.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Squid... use a... jet which can direct thrust at any angle through a hemisphere below the body plane...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The operculum of one side may be held down tightly, forcing all the water out through the opposite one.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000165"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Steering which involves asymmetric propulsion.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000165"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">propulsion steering</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000165"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The families Trygonidae and Myliobatidae have carried the rajiform undulations a step further... Steering is accomplished for the most part by differential action of the pectorals. That is, in curving, the outside “wing” is speeded up or the inside one retarded which swings the animal accordingly.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000165"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Fishes using a simple flapping movement of the dorsal and anal may oscillate them both over to one side,&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000165"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Metameral waves may be propagated in greater number or be of larger size on one side than the other, instead of simply alternating uniformly.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000165"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Probably the most common method is a single flap of the tail to one side... In this action the tail is expanded to its full extent in making the stroke and contracted on its return to the median position in order to prevent a reverse turning action or any more forward motion than necessary.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000165"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Squid... use a... jet which can direct thrust at any angle through a hemisphere below the body plane...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.137.1.421</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000165"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The operculum of one side may be held down tightly, forcing all the water out through the opposite one.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000166 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000166">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000645"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002326"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-14T14:33:28.5453Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Steering in which part of the animal is held at an angle to the direction of travel, causing unequal drag and inducing a yaw torque.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>rudder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ruddering</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">rudder steering</rdfs:label>
        <skos:example>&quot;Swimming movements in boxfishes were much more complex and varied than classical descriptions indicated. At low to moderate rectilinear swimming speeds (&lt;5 TL s-1, where TL is total body length), they were entirely median- and paired-fin swimmers, apparently using their caudal fins for steering.&quot;</skos:example>
        <skos:scopeNote>&quot;Several myomeres on one side may be held tightly contracted so as to hold the body flexed...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The dorsal and anal may be held over to one side.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The tail may be held rigidly to one side, acting like a rudder.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000166"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Steering in which part of the animal is held at an angle to the direction of travel, causing unequal drag and inducing a yaw torque.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1098/rsos.200129</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000166"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>rudder</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000166"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>ruddering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000166"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">rudder steering</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000166"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Swimming movements in boxfishes were much more complex and varied than classical descriptions indicated. At low to moderate rectilinear swimming speeds (&lt;5 TL s-1, where TL is total body length), they were entirely median- and paired-fin swimmers, apparently using their caudal fins for steering.&quot;</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000166"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Several myomeres on one side may be held tightly contracted so as to hold the body flexed...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000166"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The dorsal and anal may be held over to one side.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000166"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The tail may be held rigidly to one side, acting like a rudder.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000167 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000167">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000174"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000654"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/manoeuvre"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-14T19:42:31.188059Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Turning which happens without perceptibly moving forward, by opposite movements on either side of the body.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>face about</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>turn on a point</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">face-about turning</rdfs:label>
        <skos:example>&quot;...pectoral fin movements... for Lagocephalus will practically turn the fish on a point if no forward motion is being made. In such long bodied forms as Esox and Lepisosteus, the pelvics may be brought into play also to aid in this action.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000167"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Turning which happens without perceptibly moving forward, by opposite movements on either side of the body.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.5962/p.203769</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Fishes at rest may face about without perceptibly moving forward by opposite fin movements on either side of the body.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000167"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>face about</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000167"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>turn on a point</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...practically turn the fish on a point...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000167"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">face-about turning</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000167"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...pectoral fin movements... for Lagocephalus will practically turn the fish on a point if no forward motion is being made. In such long bodied forms as Esox and Lepisosteus, the pelvics may be brought into play also to aid in this action.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000168 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000168">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000013"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000654"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/manoeuvre"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-23T13:24:29.195109Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Rotating that shifts the centre of gravity laterally.

This can happen in a straight line, without circling.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">yawing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>anterior oscillation</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>nose swinging</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>nose wig-wagging</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>swaying</oboInOwl:hasRelatedSynonym>
        <rdfs:label>yawing rotating</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000174"/>
        <skos:example>&quot;Shifts in the centre of gravity are not dramatically evident in large crabs during locomotion. However, in small crabs the shell and abdomen yaw right and left with each step of the third appendages. As R3 extends behind the crab, the shell posterior yaws to the left; as L3 extends in its power thrust, the shell yaws to the right. Such rocking motions may increase the cost of locomotion.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000168"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Rotating that shifts the centre of gravity laterally.

This can happen in a straight line, without circling.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000168"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">yawing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1986</dc:date>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000168"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>anterior oscillation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...oscillation of the anterior part.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000168"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>nose swinging</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...swinging the nose...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000168"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>nose wig-wagging</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000168"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>swaying</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2011</dc:date>
        <dc:source>doi:10.1038/ncomms1350</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000168"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>yawing rotating</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000168"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Shifts in the centre of gravity are not dramatically evident in large crabs during locomotion. However, in small crabs the shell and abdomen yaw right and left with each step of the third appendages. As R3 extends behind the crab, the shell posterior yaws to the left; as L3 extends in its power thrust, the shell yaws to the right. Such rocking motions may increase the cost of locomotion.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000169 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000126"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000690"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-23T15:26:00.946727Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Gait pattern which follows no regular sequence.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">irregularity pattern</rdfs:label>
        <skos:example>&quot;Maximum energy recovery during walking in crabs should occur if all eight &apos;inverted pendulums&apos; were operating in a tightly coupled alternating tetrapod. Yet irregular stepping patterns were used by the ghost crab during normal sideways walking. This indicates that the summed forces from all legs provides a rather consistent lift and acceleration of the body, even though the forces produced by individual legs may vary. Irregular stepping patterns appear to be the rule among free-walking crustaceans, rather than the exception.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000169"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Gait pattern which follows no regular sequence.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/BF02381373</rdfs:isDefinedBy>
        <skos:scopeNote>Irregular gait run: Fast locomotion wherein footfall pattern follows no regular sequence.</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000169"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">irregularity pattern</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1987</dc:date>
        <dc:source>doi:10.1242/jeb.130.1.155</dc:source>
        <skos:scopeNote>&quot;...irregularity of the pattern...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000169"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Maximum energy recovery during walking in crabs should occur if all eight &apos;inverted pendulums&apos; were operating in a tightly coupled alternating tetrapod. Yet irregular stepping patterns were used by the ghost crab during normal sideways walking. This indicates that the summed forces from all legs provides a rather consistent lift and acceleration of the body, even though the forces produced by individual legs may vary. Irregular stepping patterns appear to be the rule among free-walking crustaceans, rather than the exception.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.130.1.155</dc:source>
    </owl:Axiom>
    


