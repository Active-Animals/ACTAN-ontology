    <!-- http://purl.obolibrary.org/obo/ACTAN_0000852 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000852">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000300"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-29T10:22:33.413212Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mating which frees gametes into new surroundings.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">gamete release</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>coition</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">gamete-release mating</rdfs:label>
        <skos:scopeNote>&quot;Typically, male frogs clasp females dorsally and position themselves so as to bring their cloacae in close proximity before coordinated gamete release, a mating posture known as “amplexus”.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000852"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mating which frees gametes into new surroundings.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1016/S0169-5347(99)01744-9</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000852"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">gamete release</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1987</dc:date>
        <dc:source>doi:10.11369/jji1950.34.76</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000852"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>coition</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <rdfs:comment>Pending a more recent source which synonymises this term more narrowly with copulating or even intromission, bear in mind that this was a very early ethological use of a term that changed later.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000852"/>
