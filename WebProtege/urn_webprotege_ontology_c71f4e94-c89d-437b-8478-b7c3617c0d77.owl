        <oboInOwl:creation_date>2026-08-02T14:22:55.361473Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Protracting which involves a hindlimb.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">hindlimb protracting</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000938"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Protracting which involves a hindlimb.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1023/A:1005565304671</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;One of the hind limbs then released the liftoff stem and protracted the distance required to allow the foot to grasp the target lateral stem.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000938"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">hindlimb protracting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1007/BF02381373</dc:source>
        <skos:scopeNote>&quot;The hindlimb is protracted prior to contact.&quot;</skos:scopeNote>
    </owl:Axiom>
    


