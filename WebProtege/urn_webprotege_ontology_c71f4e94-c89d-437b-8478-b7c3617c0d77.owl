    <!-- http://purl.obolibrary.org/obo/ACTAN_0000563 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000563">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000686"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002326"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-04T16:52:38.366477Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Rotation in which inclination changes with reference to gravity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">tilted</oboInOwl:hasExactSynonym>
        <rdfs:label>tilt rotation</rdfs:label>
        <skos:example>&quot;At 3 days old, larval zebrafish show no measurable eye movements in response to body tilts in pitch or roll.&quot;</skos:example>
        <skos:example>&quot;Speed also increases with bipedalism in lizards. As in P. americana, lizards tilt their head end upwards and increase stride length by using long hind legs.&quot;</skos:example>
        <skos:relatedMatch>NBO:0000070</skos:relatedMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000563"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Rotation in which inclination changes with reference to gravity.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000563"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">tilted</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000563"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>tilt rotation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000563"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;At 3 days old, larval zebrafish show no measurable eye movements in response to body tilts in pitch or roll.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.conb.2018.06.004</dc:source>
    </owl:Axiom>
