                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000241"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-06T10:05:37.807691Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Climbing gait in which the body resembles a coiled spring whilst concertinaing, wrapping with nearly all of the body to grip the cylinder.

This absence of alternating bends to the left and right in the propulsive region of the animal is distinct from all other known modes of animal locomotion that use vertebral bending for propulsion.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">concertina with helical wrapping</oboInOwl:hasExactSynonym>
        <rdfs:label>coiled-concertina gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000255"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Climbing gait in which the body resembles a coiled spring whilst concertinaing, wrapping with nearly all of the body to grip the cylinder.

This absence of alternating bends to the left and right in the propulsive region of the animal is distinct from all other known modes of animal locomotion that use vertebral bending for propulsion.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/icaa017</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000255"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">concertina with helical wrapping</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icaa017</dc:source>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</rdfs:comment>
    </owl:Axiom>
