        <oboInOwl:hasDefinition>Stepping gait that is bouncing, and uses a bipedal, asymmetric gait pattern, wherein the hindlimbs push off and land roughly simultaneously.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>hop</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">hopping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>functionally monopedal</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hop gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000145"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Stepping gait that is bouncing, and uses a bipedal, asymmetric gait pattern, wherein the hindlimbs push off and land roughly simultaneously.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF02381373</dc:source>
        <skos:scopeNote>&quot;L4. Bipedal hop: Torso-orthograde ( [ ) bipedal progression wherein the hindlimbs push off and land roughly simultaneously;&quot;</skos:scopeNote>
    </owl:Axiom>
