    <!-- http://purl.obolibrary.org/obo/ACTAN_0000743 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000743">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000596"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-06-11T13:21:18.043122Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movment that changes a shape by displacing its volume.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">contraction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>deflation</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>retraction</oboInOwl:hasRelatedSynonym>
        <rdfs:label>contracting movement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000625"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000665"/>
        <skos:example>&quot;Bunodosoma goanense... Animals sensitive to light: tentacles contract in area where light shines on them.&quot;</skos:example>
        <skos:example>&quot;The same males and females of T. albomaculosus mated repeatedly in pairs on the same day. Although the release of gametes was not visible to the naked eye, the abdomens of the females deflated gradually over the repeated matings.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000743"/>
