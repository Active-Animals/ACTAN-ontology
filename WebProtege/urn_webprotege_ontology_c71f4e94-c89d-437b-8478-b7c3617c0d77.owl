        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-25T16:50:27.016602Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Hunt in which a short but slow, open-mouthed, lateral search is followed by a rapid, directed attack.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>head sweeping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lateral striking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">sideways sweeping</oboInOwl:hasExactSynonym>
        <rdfs:label>sweep roving</rdfs:label>
        <skos:example>&quot;Head sweeping by Thamnophis elegans... As the snake travels forward, the head is swung from side to side primarily by movements of the anterior trunk.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000721"/>
