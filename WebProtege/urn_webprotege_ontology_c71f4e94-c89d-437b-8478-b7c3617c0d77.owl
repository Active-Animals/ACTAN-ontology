    <!-- http://purl.obolibrary.org/obo/ACTAN_0000353 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000353">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000348"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000301"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-21T08:36:22.181077Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Feed which balances the risks and benefits of local resource exploitation versus long-range exploration.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">foraging</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>food seeking</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">forage feed</rdfs:label>
        <skos:example>&quot;A dolphin picks up a marine sponge and uses it as a glove on its rostrum during foraging. The dolphin encounters no stinging animals or sharp surfaces while foraging... 

To the extent that the glove may aid in foraging (currently an open inference), it can be considered a tool: it changes the dynamics of the mechanical interaction between the dolphin’s rostrum and foraging surfaces.&quot;</skos:example>
        <skos:narrowMatch>NBO:0015003</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000353"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Feed which balances the risks and benefits of local resource exploitation versus long-range exploration.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1038/s41467-023-38685-1</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;E.g., animals will use multiple sources of information in order to select between different foraging strategies balancing the risks and benefits of local resource exploitation versus long-range exploration.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000353"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">foraging</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1975</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000353"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>food seeking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000353"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">forage feed</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000353"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;A dolphin picks up a marine sponge and uses it as a glove on its rostrum during foraging. The dolphin encounters no stinging animals or sharp surfaces while foraging... 

To the extent that the glove may aid in foraging (currently an open inference), it can be considered a tool: it changes the dynamics of the mechanical interaction between the dolphin’s rostrum and foraging surfaces.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.anbehav.2007.09.028</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000354 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000354">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000113"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001576"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-21T08:36:36.359364Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym xml:lang="en">cutting</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Bite which penetrates the object&apos;s surface.

It may remove part of the object.</oboInOwl:hasDefinition>
        <rdfs:label>cut bite</rdfs:label>
        <skos:example>&quot;...in the harvester desert termite Anacanthotermes macrocephalus. The termites cut blades of grass and transport them back to the nest.&quot;</skos:example>
        <skos:example>&quot;Among mammals, beavers (genus Castor) modify the environment using huge logs, branches (which they themselves cut) and mud structures to dam streams and create ponds where they build their lodges, also built with branches and mud.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000354"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget xml:lang="en">cutting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:date>
        <dc:source>doi:10.1111/tops.12554</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000354"/>
