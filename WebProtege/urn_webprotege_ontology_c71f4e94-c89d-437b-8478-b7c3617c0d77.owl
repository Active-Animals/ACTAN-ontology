        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000877"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Hemichromis females...
A starts laying... B and C approach and eat the eggs. A chases B, and more particularly C. B also chases C and eats most of the eggs... Later on C begins to lay eggs... B approaches and then &quot;assists&quot; C, just as she formerly &quot;helped&quot; A.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000878 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000878">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000463"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-08T17:03:44.892569Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Cooperation that helps another achieve the other&apos;s purpose.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">assistance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>help</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>joining</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">assistance cooperation</rdfs:label>
        <skos:example>&quot;In Cichlasoma meeki two frontally-fighting fishes were often assisted by territoryless congeners.&quot;</skos:example>
        <skos:example>&quot;Parasitic Jaegers regularly team-hunt in pairs or small groups. Team-hunting occurs as:... two birds hunting cooperatively by assisting each other.&quot;</skos:example>
        <skos:example>&quot;TINBERGEN (1939) describes how the female snow bunting assists the male in driving away intruders from the territory, but without knowing the boundaries of this territory exactly.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000878"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Cooperation that helps another achieve the other&apos;s purpose.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000878"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">assistance</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
