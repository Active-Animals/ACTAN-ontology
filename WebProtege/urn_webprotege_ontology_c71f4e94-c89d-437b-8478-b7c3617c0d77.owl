        <owl:annotatedTarget>profile</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>rules</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>symbolical</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">ritual pattern</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...in Lacerta agilis... The intraterritorial fighting has more the character of a serious fight, but still very much influenced by a number of &quot;playing-rules&quot;.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...mating behaviour is extremely diverse in sepsids with each species having its own mating profile.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;There are many social rituals and displays which have nothing to do with social competition among rivals. Some, like the stereotyped movements preceding &quot;nest relief&quot; of one member of a breeding pair by another in birds, or exchanges of signals prior to copulation, function to regulate or coordinate cooperation between the sexes.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000318 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000335"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002104"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-16T17:28:43.54959Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Perception which attempts to visually locate and fixate on a target.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>fixing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>keeping an eye on</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">looking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tracking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>viewing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>watching</oboInOwl:hasExactSynonym>
        <rdfs:label>look perception</rdfs:label>
        <skos:closeMatch>NBO:0000314</skos:closeMatch>
        <skos:example>&quot;Sarasins minnows look at a familiar individuals with their left eye and use their right eye to view unfamiliar individuals.&quot;</skos:example>
        <skos:scopeNote>&quot;...the stimulus situation by which the young recognise the parents consists of visual characters only... Those characters might be of 6 different kinds, namely characters of movement, size, shape, texture, colour or pattern.&quot;</skos:scopeNote>
    </owl:Class>
