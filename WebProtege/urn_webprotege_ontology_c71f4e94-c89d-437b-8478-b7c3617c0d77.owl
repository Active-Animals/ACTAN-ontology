    <!-- http://purl.obolibrary.org/obo/ACTAN_0000151 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000151">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000149"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000651"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001900"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/manoeuvre"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-23T07:50:21.008447Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>progress</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>progression</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>A manoeuvre that is anterior-first.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>forwards</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">propelling</oboInOwl:hasExactSynonym>
        <rdfs:label>propelling manoeuvre</rdfs:label>
        <skos:example>&quot;In half of the high-speed runs (N=13), cockroaches used only four legs (i.e. middle and hind legs). In the other half of the high-speed runs, cockroaches ran bipedally, propelling themselves exclusively with their hind legs.&quot;</skos:example>
        <skos:scopeNote>&quot;The mechanical efficiency of an aquatic propulsor represents the fraction of the total muscle power generated that is used to produce forward thrust.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000151"/>
