    <!-- http://purl.obolibrary.org/obo/ACTAN_0000590 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000590">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001575"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-09T16:34:33.192936Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that produces negative pressure in a cavity to pump a fluid.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">sucking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>suction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>suctorial specialization</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>sucking pump</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>suction pump</oboInOwl:hasNarrowSynonym>
        <rdfs:label>suction kinetics</rdfs:label>
        <skos:example>&quot;Achirus fasciatus attaches itself to smooth surfaces by pressing the fringing fins downward and raising the central part of the body thus producing considerable suction.&quot;</skos:example>
        <skos:example>&quot;In two species, Emmelichthyops and Schultzea, an additional process is found on the premaxilla which apparently serves in giving support to the large resulting gape between the maxilla and the premaxilla; this gape is covered only by integument when the jaw is shot forward. When feeding, these fishes &quot;shoot&quot; the jaw forward and downward rapidly; this rapid expansion of the oral cavity creates a suction which draws prey into the cavity.&quot;</skos:example>
        <skos:example>&quot;Since a sharksucker is attached to its client most of the time, it also saves energy that would otherwise be used to swim.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000590"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics that produces negative pressure in a cavity to pump a fluid.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>ISBN:9780226315737</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000590"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">sucking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000590"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>suction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000590"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>suctorial specialization</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000590"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>sucking pump</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>https://bioengineering.hyperbook.mcgill.ca/functional-mechanics-of-the-elephant-and-butterfly-proboscis/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000590"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>suction pump</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1993</dc:date>
        <dc:source>ISBN:9780226315737</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000590"/>
