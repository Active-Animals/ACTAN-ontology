        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000685"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In the more complex method of grasping a worm the fish rolls over onto one side, simultaneously forming an S-shape ; the head points down at the worm, and the dorsal fin is usually spread as much as the body curvature allows. After briefly fixing on the prey the Badis badis lunges and seizes the worm.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000685"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Large sturgeon when swimming slowly, especially when starting off, have a noticeable roll...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000685"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Much commoner are the oil-distributing movements in which head and neck are vigorously rubbed and rolled over the back and area around the humerus.&quot;</owl:annotatedTarget>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
