    <!-- http://purl.obolibrary.org/obo/ACTAN_0000332 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000332">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000331"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000690"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-15T09:04:23.742566Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Pursuit which involves a slow phase, unnoticed target observation, and a sudden, fast capture movement.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">stalking</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">stalking pursuit</rdfs:label>
        <skos:closeMatch>NBO:0020160</skos:closeMatch>
        <skos:example>&quot;...a heron moves slowly, stalking prey. Walking becomes slower as the heron examines items or areas of interest, and just before striking the heron may walk so slowly that this behavior merges with stand and wait.&quot;</skos:example>
        <skos:example>&quot;These observations included responses to four large carnivores that commonly kill these prey, including two coursers (wild dog and spotted hyena), a stalker (lion), and one with an intermediate hunting strategy (cheetah).&quot;</skos:example>
        <skos:scopeNote>&quot;...the complete guild of large predators that commonly kill these grazers, including both stalking and coursing predators, remains present in these ecosystems.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000332"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Pursuit which involves a slow phase, unnoticed target observation, and a sudden, fast capture movement.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://www.jstor.org/stable/4084834</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000332"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">stalking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000332"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">stalking pursuit</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000332"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...a heron moves slowly, stalking prey. Walking becomes slower as the heron examines items or areas of interest, and just before striking the heron may walk so slowly that this behavior merges with stand and wait.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/4084834</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000332"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;These observations included responses to four large carnivores that commonly kill these prey, including two coursers (wild dog and spotted hyena), a stalker (lion), and one with an intermediate hunting strategy (cheetah).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1231780</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000332"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...the complete guild of large predators that commonly kill these grazers, including both stalking and coursing predators, remains present in these ecosystems.&quot;</owl:annotatedTarget>
