    <!-- http://purl.obolibrary.org/obo/ACTAN_0000912 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000912">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000272"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000727"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-11-07T10:56:33.042225Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Construction that cleans away detritus from a substrate.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>clearing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">tidying</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>cleaning</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">tidying construction</rdfs:label>
        <skos:example>&quot;Hemichromis bimaculatus...
she usually lays eggs only on the spot cleaned before...&quot;</skos:example>
        <skos:example>&quot;Parotia carolae...
Court clearing. — A male nondisplay court-preparation behavior. A range of activities in which leaves, leaf litter, or other forest debris are removed from the court floor.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000912"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Construction that cleans away detritus from a substrate.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The substrate is thoroughly cleaned by nipping off sand and detritus and carrying it away.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000912"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>clearing</owl:annotatedTarget>
