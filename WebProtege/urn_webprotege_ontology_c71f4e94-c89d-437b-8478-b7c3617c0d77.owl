    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000692"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>tippy</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1980</dc:date>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000692"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>trip up</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...“trip it up”...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000692"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>tumbling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000692"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>pitching rotating</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000692"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;As the female moved forward over the upstream rim of the pit, she gaped and abruptly tossed her head vertically into the water column. She began her upward pitch with body upright and the ventral surface of her caudal peduncle still pressed to the substrate.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000692"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The horizontal fluke of the whale may be brought into play to further control forward pitch or even to extend the head and back. Side-to-side rolling motions and pitching over onto the back are common body motions observed during feeding in rorqual whales.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9780226315737</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000692"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...contraction of dorsal or ventral muscles on the left and right sides in concert serves to rotate fish in the pitch axis...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.conb.2018.06.004</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000693 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000693">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001029"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-11T14:04:52.776228Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that moves an object one way by exerting a counteracting force the opposite way.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">leverage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>prying</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">leverage kinetics</rdfs:label>
        <skos:example>&quot;A prying movement (sometimes called gaping or &quot;Zirkeln&quot;) occurs in at least eight passefine families. The birds stick their bills into the ground, a soft substance, or a crack, and then open them with considerable force.&quot;</skos:example>
        <skos:example>&quot;By lying on one side the fish is able to use its body as a lever. The head is raised, pulling the worm free, while a counteracting force is exerted downward by swimming movements of the tail.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000693"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics that moves an object one way by exerting a counteracting force the opposite way.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000693"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">leverage</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000693"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>prying</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1966</dc:date>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000693"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">leverage kinetics</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000693"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;A prying movement (sometimes called gaping or &quot;Zirkeln&quot;) occurs in at least eight passefine families. The birds stick their bills into the ground, a soft substance, or a crack, and then open them with considerable force.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000693"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;By lying on one side the fish is able to use its body as a lever. The head is raised, pulling the worm free, while a counteracting force is exerted downward by swimming movements of the tail.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000694 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000694">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000286"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000693"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000814"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-11T14:26:49.213544Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Tooling that prys with an object.

This may be to access, autogroom, enlarge, press, or remove.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">pry with an object</oboInOwl:hasExactSynonym>
        <rdfs:label>prying tooling</rdfs:label>
        <skos:example>&quot;The key idea is that in the most familiar examples of tool use (e.g. pounding with a stone, probing with a twig, transporting liquid with a leaf sponge, levering with a sturdy stick) an effect is generated by the dynamic mechanical interaction between the manipulated tool and other objects or organisms in the environment.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000694"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Tooling that prys with an object.

This may be to access, autogroom, enlarge, press, or remove.</owl:annotatedTarget>
        <dc:source>doi:10.1111/tops.12554</dc:source>
        <rdfs:comment>This is a simple source subdivision.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000694"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">pry with an object</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:date>
        <dc:source>doi:10.1111/tops.12554</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000694"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>prying tooling</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000694"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The key idea is that in the most familiar examples of tool use (e.g. pounding with a stone, probing with a twig, transporting liquid with a leaf sponge, levering with a sturdy stick) an effect is generated by the dynamic mechanical interaction between the manipulated tool and other objects or organisms in the environment.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.anbehav.2007.09.028</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000695 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000695">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001576"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-12T06:28:28.254427Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that exerts a sustained contact force away from the subject.

It may be countered by a pulling force from the same subject.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>driving</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pressing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>push</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">pushing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>shove</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>ejecting</oboInOwl:hasRelatedSynonym>
        <rdfs:label>press kinetics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000163"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000233"/>
        <skos:example>&quot;...the young cuckoo ejecting its foster-brothers...&quot;</skos:example>
        <skos:example>&quot;Hemichromis bimaculatus...
The male butts the female vigorously in the flank, the female tries to dodge but is pushed back.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000695"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics that exerts a sustained contact force away from the subject.

It may be countered by a pulling force from the same subject.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
