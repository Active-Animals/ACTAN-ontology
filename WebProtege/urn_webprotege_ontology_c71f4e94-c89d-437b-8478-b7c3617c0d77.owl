    <!-- http://purl.obolibrary.org/obo/ACTAN_0000896 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000896">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000288"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001632"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-20T13:03:26.240496Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Relativity which maintains a short distance ahead, and matches a relatively slow speed of a follower, in the leader&apos;s chosen direction.

It may turn, come back, turn and go forward again.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">guiding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>leading</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>front-running</oboInOwl:hasNarrowSynonym>
        <rdfs:label>leading relativity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000325"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000920"/>
        <skos:example>&quot;...performing prey retrieval in the army ants Eciton burchelli and Dorylus wilverthi.... there are just two subtasks: front-running, involving a single ant at the front, and following, involving one or more ants bringing up the rear. This distinction might seem almost absurdly obvious and trivial, but it is not, as is clear from considering prey retrieval groups such as Formica wood ants that habitually pull in different directions when they attempt jointly to carry a large prey item. In Formica, subtasks within the prey retrieval group are absent, each ant continues to try to take the lead, and they are notoriously inefficient.&quot;</skos:example>
        <skos:example>&quot;In the dwarf-cichlids (Nannacara, Apistogramma), for instance, only the female guards the eggs (which are laid on a substrate) and leads the young.&quot;</skos:example>
        <skos:example>&quot;Tilapia natalensis and T. nilotica...
...the leading action... can be carried out in the normal as well as the displaying attitude, although T. natalensis as a rule always performs it without displaying...&quot;&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000896"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Relativity which maintains a short distance ahead, and matches a relatively slow speed of a follower, in the leader&apos;s chosen direction.

It may turn, come back, turn and go forward again.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000896"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">guiding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000896"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>leading</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000896"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>front-running</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1093/beheco/12.5.534</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000896"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>leading relativity</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000896"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...performing prey retrieval in the army ants Eciton burchelli and Dorylus wilverthi.... there are just two subtasks: front-running, involving a single ant at the front, and following, involving one or more ants bringing up the rear. This distinction might seem almost absurdly obvious and trivial, but it is not, as is clear from considering prey retrieval groups such as Formica wood ants that habitually pull in different directions when they attempt jointly to carry a large prey item. In Formica, subtasks within the prey retrieval group are absent, each ant continues to try to take the lead, and they are notoriously inefficient.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/beheco/12.5.534</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000896"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In the dwarf-cichlids (Nannacara, Apistogramma), for instance, only the female guards the eggs (which are laid on a substrate) and leads the young.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000896"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Tilapia natalensis and T. nilotica...
...the leading action... can be carried out in the normal as well as the displaying attitude, although T. natalensis as a rule always performs it without displaying...&quot;&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000897 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000897">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000583"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000105"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_life_cycle"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-20T16:05:52.68384Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Association that is conditioned at a very early age, and is never forgotten again.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">imprinting</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">imprinting association</rdfs:label>
        <skos:closeMatch>NBO:0000213</skos:closeMatch>
        <skos:example>&quot;Many salmonids breed in cool upland rivers where their eggs are laid in gravel beds. As the eggs develop and hatch, the larvae and emerging young imprint on the chemical signature of their home stream. After spending various lengths of time in freshwater, they migrate to the ocean where they may spend several years growing to adulthood. Once mature, the fish return to their home streams by following chemical plumes from the river and matching it to the template laid down during the imprinting stage.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000897"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Association that is conditioned at a very early age, and is never forgotten again.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The courtship reactions thus seem to be conditioned, and SEITZ was able to show that the learning process had already taken place at a very early age, and was never forgotten again. This type of conditioning has been called by LORENZ (1935), who found it in young birds, &quot;Pragung&quot; (imprinting).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000897"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">imprinting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000897"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">imprinting association</owl:annotatedTarget>
        <dc:source>https://orcid.org/0000-0002-4277-2151</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000897"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Many salmonids breed in cool upland rivers where their eggs are laid in gravel beds. As the eggs develop and hatch, the larvae and emerging young imprint on the chemical signature of their home stream. After spending various lengths of time in freshwater, they migrate to the ocean where they may spend several years growing to adulthood. Once mature, the fish return to their home streams by following chemical plumes from the river and matching it to the template laid down during the imprinting stage.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10071-014-0761-0</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000898 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000898">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000893"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002486"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-20T16:21:43.300276Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Stimulation switch in which each action of one member of a pair evokes a linked reaction in the other, and vice versa.

When one link is omitted the pair does not remain friendly any longer.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">interrogative</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>interaction sequence</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">interrogative switch</rdfs:label>
        <skos:example>&quot;Bluehead Chub, Nocomis leptocephalus...
the sequence of male-female interactions characteristic of a successful spawn... are: interim (male behavior between spawns), approach (female behavior directed towards interim male), alignment (behavior affecting precise orientation of spawning pair over substrate), run (initiated by female, synchronized movement of aligned pair over substrate), clasp (momentary flexure of male’s body about an axis determined by female’s position at the end of her run) and dissociation (pair separation immediately alter the clasp).&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000898"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Stimulation switch in which each action of one member of a pair evokes a linked reaction in the other, and vice versa.

When one link is omitted the pair does not remain friendly any longer.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000898"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">interrogative</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000898"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>interaction sequence</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000898"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">interrogative switch</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000898"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Bluehead Chub, Nocomis leptocephalus...
the sequence of male-female interactions characteristic of a successful spawn... are: interim (male behavior between spawns), approach (female behavior directed towards interim male), alignment (behavior affecting precise orientation of spawning pair over substrate), run (initiated by female, synchronized movement of aligned pair over substrate), clasp (momentary flexure of male’s body about an axis determined by female’s position at the end of her run) and dissociation (pair separation immediately alter the clasp).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000899 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000899">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000860"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001419"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-20T16:41:22.881341Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Hit that is sudden and penetrative, involving a sharp object.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">pricking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stab</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>beak-stabbing</oboInOwl:hasNarrowSynonym>
        <rdfs:label>stab hit</rdfs:label>
        <skos:example>&quot;In the stickleback... Often, when the female does not follow immediately, the male stimulates her by pricking her with the dorsal spines.&quot;</skos:example>
        <skos:example>&quot;The jaeger killed the victim by stabbing with its beak at the head and thorax region;&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000899"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Hit that is sudden and penetrative, involving a sharp object.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000899"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">pricking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000899"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>stab</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
