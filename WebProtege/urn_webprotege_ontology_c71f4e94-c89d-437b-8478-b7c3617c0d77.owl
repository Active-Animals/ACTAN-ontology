        <oboInOwl:hasDefinition>Alarm that involves a complete cessation of movement, except for eyes, and increased respiratory movements.

Generally, a result of high stress, or part of submissive behavior.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">freezing</oboInOwl:hasExactSynonym>
        <rdfs:label>freeze alarm</rdfs:label>
        <skos:example>&quot;As we walk to the edge of a stream, a stickleback freezes...&quot;</skos:example>
        <skos:relatedMatch>NBO:0020175</skos:relatedMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000504"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Alarm that involves a complete cessation of movement, except for eyes, and increased respiratory movements.

Generally, a result of high stress, or part of submissive behavior.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
