            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-18T09:00:48.13245Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flying-gait which is drag based.

This results in larger variations in speed.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym>rowing</oboInOwl:hasRelatedSynonym>
        <rdfs:label>heaving gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000635"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flying-gait which is drag based.

This results in larger variations in speed.</owl:annotatedTarget>
        <rdfs:comment>NB: The quote is about lift based mechanisms, but in this case we are using its reference to the alternative.</rdfs:comment>
        <rdfs:isDefinedBy>doi:10.1088/1748-3182/9/1/011001</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;This lift based technique is proven to achieve higher propulsive efficiency than drag based propulsion mechanisms.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000635"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>rowing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000635"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>heaving gait</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2017</dc:date>
        <dc:source>doi:10.1017/jfm.2017.173</dc:source>
        <rdfs:comment>Note that this source uses this term in a broader sense (appendages going up and down) although it retains a focus on wings, whereas we are adding a measure of rotation (the rowing pattern) to allow for feathering.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000636 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000636">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000126"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001242"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-18T21:40:45.570303Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Gait pattern in which alternating bends are propagated along a continuous structure, as all points along it move simultaneously and have sliding contact where they touch their surroundings.

This may involve the entire animal, or a longitudinal structure.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">undulation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>axial undulating</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>body undulating</oboInOwl:hasNarrowSynonym>
        <rdfs:label>undulation pattern</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000636"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Gait pattern in which alternating bends are propagated along a continuous structure, as all points along it move simultaneously and have sliding contact where they touch their surroundings.

This may involve the entire animal, or a longitudinal structure.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/icaa017</dc:source>
    </owl:Axiom>
