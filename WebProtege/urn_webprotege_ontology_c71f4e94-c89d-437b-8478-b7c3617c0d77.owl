        <oboInOwl:creation_date>2024-10-07T08:09:28.769789Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Construction in which colony members temporarily build using one another as raw material, holding together end-to-end.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">linking</oboInOwl:hasExactSynonym>
        <rdfs:label>linking construction</rdfs:label>
        <skos:example>&quot;Army ants create ‘living architecture’ in which colony members temporarily link themselves end-to-end, holding together as a bridge while others travel atop them.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000279"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
