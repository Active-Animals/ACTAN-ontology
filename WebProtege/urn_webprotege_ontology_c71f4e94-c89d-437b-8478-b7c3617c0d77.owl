    <!-- http://purl.obolibrary.org/obo/ACTAN_0000782 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000286"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000695"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000814"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-05T17:39:11.458857Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Tooling that probes with an object.

This may be to access, allogroom, autogroom, dislodge, or pack.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">probe with an object</oboInOwl:hasExactSynonym>
        <rdfs:label>probing tooling</rdfs:label>
        <skos:example>&quot;Sneeze with stick (SNS) (Type A): Push stick into nostril to stimulate sneeze,which discharges a large amount of nasal mucus. Only one adult male showed this type of tool-use.&quot;</skos:example>
        <skos:scopeNote>&quot;We found that probing was the most frequently referenced mode for the primates, followed by reaching and pounding. For birds, probing was by far the most commonly reported tooling mode.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000782"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Tooling that probes with an object.

This may be to access, allogroom, autogroom, dislodge, or pack.</owl:annotatedTarget>
        <dc:source>doi:10.1111/tops.12554</dc:source>
        <rdfs:comment>This is a simple source subdivision.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000782"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
