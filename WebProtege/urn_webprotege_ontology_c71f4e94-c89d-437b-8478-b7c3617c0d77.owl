    <!-- http://purl.obolibrary.org/obo/ACTAN_0000670 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000670">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000612"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000149"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000671"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-04-28T14:03:49.924121Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Stationing that actively holds the body nearly motionless, without support, in a fluid medium.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">hovering</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>swimming on the spot</oboInOwl:hasNarrowSynonym>
        <rdfs:label>hover stationing</rdfs:label>
        <skos:example>&quot;...a heron hovers over a single spot and reaches down with its bill to remove prey from the water.&quot;</skos:example>
        <skos:example>&quot;I have often watched a tyrant flycatcher (Saurophagus sulphuratus) in South America, hovering over one spot and then proceeding to another, like a kestrel...&quot;</skos:example>
        <skos:example>&quot;Ioglossus, PtereIeotris (Gobidae) and Trimrna tevegae are examples of split-fin gobies engaging in hovering on or near coral reefs;&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000670"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Stationing that actively holds the body nearly motionless, without support, in a fluid medium.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000670"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">hovering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000670"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>swimming on the spot</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000670"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>hover stationing</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000670"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...a heron hovers over a single spot and reaches down with its bill to remove prey from the water.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/4084834</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000670"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;I have often watched a tyrant flycatcher (Saurophagus sulphuratus) in South America, hovering over one spot and then proceeding to another, like a kestrel...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000670"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Ioglossus, PtereIeotris (Gobidae) and Trimrna tevegae are examples of split-fin gobies engaging in hovering on or near coral reefs;&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000671 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000671">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-04-28T15:10:53.722828Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that uses energy to move the body, with a variably oriented force.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>motor effort</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">propulsion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thrust</oboInOwl:hasExactSynonym>
        <rdfs:label>thrust kinetics</rdfs:label>
        <skos:example>&quot;With the hind legs functioning as the primary propulsive units, P. americana may be able to overcome the limitations to stride length imposed by shorter limbs by lifting both front and middle legs off the ground.&quot;</skos:example>
        <skos:scopeNote>&quot;From whale sperm to sperm whales, locomotion is almost always produced by appendages that oscillate or by bodies that undulate, pulse, or undergo peristaltic waves.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000671"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000671"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
