    <!-- http://purl.obolibrary.org/obo/ACTAN_0000709 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000709">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000708"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002204"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002284"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-14T15:41:28.559056Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>general preparatory movements</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Comfort that involves stereotyped placements and muscles in tension.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">stretching movement</oboInOwl:hasExactSynonym>
        <rdfs:label>stretch comfort</rdfs:label>
        <skos:scopeNote>&quot;Stretching movements of two types occur in all carinate birds. One involves the stretching down of one wing and the corresponding leg, typically also with a spreading of the tail. However, Kilham notes that woodpeckers do not stretch the corresponding leg . The other is a stretching of the wings (closed or perhaps somewhat extended) over the back. During this latter, some species spread their tails symmetrically at the same time. Some, such as herons, stretch their neck forward during both types of stretching. The stretching downward of both wings which occurs in some young passerines, has also been reported in some adult parrots and in adult emberizines. The straightening of both legs while the bird is standing (usually without involvement of the wings) occurs in young birds but less frequently in adults.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000709"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>general preparatory movements</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000709"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Comfort that involves stereotyped placements and muscles in tension.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000709"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">stretching movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000709"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>stretch comfort</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000709"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Stretching movements of two types occur in all carinate birds. One involves the stretching down of one wing and the corresponding leg, typically also with a spreading of the tail. However, Kilham notes that woodpeckers do not stretch the corresponding leg . The other is a stretching of the wings (closed or perhaps somewhat extended) over the back. During this latter, some species spread their tails symmetrically at the same time. Some, such as herons, stretch their neck forward during both types of stretching. The stretching downward of both wings which occurs in some young passerines, has also been reported in some adult parrots and in adult emberizines. The straightening of both legs while the bird is standing (usually without involvement of the wings) occurs in young birds but less frequently in adults.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000710 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000710">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001632"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-14T16:43:57.422282Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement in which an appendage goes forwards in the sagittal plane.

In a stride cycle, this will be the swing phase.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>protracting</oboInOwl:hasExactSynonym>
        <rdfs:label>protracting movement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000091"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000730"/>
        <skos:example>&quot;...it is likely that two-toed sloths are controlling their center of mass position through the mechanism initially described by Ishida et al. (1990), in which interlimb coordination is timed so that a protracted propulsive forelimb early in its support phase is synchronized with a retracted ipsilateral braking hind limb late in its support phase.&quot;</skos:example>
        <skos:scopeNote>&quot;While the back and hindlimbs propel the body upward, the forelimbs release the support and are protracted in unison to reach a higher handhold. The motion has a pulsing appearance.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000710"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement in which an appendage goes forwards in the sagittal plane.

In a stride cycle, this will be the swing phase.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
        <dc:source>doi:10.1088/1748-3190/ac482d</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000710"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>protracting</owl:annotatedTarget>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000710"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>protracting movement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000710"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...it is likely that two-toed sloths are controlling their center of mass position through the mechanism initially described by Ishida et al. (1990), in which interlimb coordination is timed so that a protracted propulsive forelimb early in its support phase is synchronized with a retracted ipsilateral braking hind limb late in its support phase.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/jzo.12455</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000710"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;While the back and hindlimbs propel the body upward, the forelimbs release the support and are protracted in unison to reach a higher handhold. The motion has a pulsing appearance.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000711 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000711">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000144"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001598"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-20T07:30:04.021986Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Transition in which parts of an animal are in differently exposed, adjacent spaces.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">protruding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>extension</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>telescopic</oboInOwl:hasRelatedSynonym>
        <rdfs:label>protruding transition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000009"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000028"/>
        <skos:example>&quot;...extension into the water column from a burrow as in the garden eels Taeniconger and Gorgasia (Congridae)...&quot;</skos:example>
        <skos:scopeNote>&quot;...the fish first swims to the protruding tip of the worm.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000711"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Transition in which parts of an animal are in differently exposed, adjacent spaces.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF01609520</dc:source>
