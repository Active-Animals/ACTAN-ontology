    <!-- http://purl.obolibrary.org/obo/ACTAN_0000776 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000776">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000113"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001575"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-05T14:21:24.045758Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Bite which remains on the object&apos;s surface.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">nibbling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>nipping-off</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">nibble bite</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000912"/>
        <skos:example>&quot;Cichlosoma meeki...

The female, passing the male, swims towards an inverted flower pot and there makes nipping-off movements.&quot;</skos:example>
        <skos:example>&quot;Signal movements...
Nipping off a substrate...
...Aequidens and Cichlosoma species make a more formalised movement... The lower jaw is brought down quickly and suddenly and raps on the substrate; immediately after, the fish jumps up a little.&quot;</skos:example>
        <skos:scopeNote>&quot;Nibble (nibbling): Nonaggressive biting on an object (usually, in food seeking or as part of object exploration).&quot;</skos:scopeNote>
    </owl:Class>
