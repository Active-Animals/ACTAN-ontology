    <!-- http://purl.obolibrary.org/obo/ACTAN_0000887 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000878"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000371"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-14T11:31:39.864838Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Assistance in which an animal works with a second in defence against a third.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>cooperative defense</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>number deterrence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">social defence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>mobbing</oboInOwl:hasNarrowSynonym>
        <rdfs:label>deterrence assistance</rdfs:label>
        <skos:example>&quot;...in birds social defence reactions have been described for instance by LORENZ (1935) in jaxckdaws.&quot;</skos:example>
        <skos:example>&quot;Some species, particularly shorebirds, take advantage of the vigilance and predator-mobbing behavior of colonially nesting species and place their nests within a colony of another species, thereby increasing their own nesting success.&quot;</skos:example>
        <skos:scopeNote>&quot;...injury to predators by prey, eg mobbing in birds...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000887"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Assistance in which an animal works with a second in defence against a third.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1016/j.yhbeh.2021.105062</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000887"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>cooperative defense</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:date>
        <dc:source>doi:10.1016/j.yhbeh.2021.105062</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000887"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>number deterrence</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
        <skos:scopeNote>&quot;...numbers per se have a deterrent effect...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000887"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">social defence</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000887"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>mobbing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1966</dc:date>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000887"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>deterrence assistance</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000887"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...in birds social defence reactions have been described for instance by LORENZ (1935) in jaxckdaws.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000887"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Some species, particularly shorebirds, take advantage of the vigilance and predator-mobbing behavior of colonially nesting species and place their nests within a colony of another species, thereby increasing their own nesting success.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1146/annurev-ecolsys-102209-144712</dc:source>
    </owl:Axiom>
