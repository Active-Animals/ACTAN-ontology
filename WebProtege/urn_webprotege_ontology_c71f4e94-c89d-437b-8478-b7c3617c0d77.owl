        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000888"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;If there is an extended suspension of sufficient duration (less common for transverse than for rotary gallopers), then the feet can alternatively be repositioned during that suspension. The forefeet are then the first to assume the new support pattern—possibly an advantage in dodging quickly.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000889 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000889">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000860"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001950"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-15T16:07:44.236694Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Hit that involves brief, non-destabilising contact, using a blunt body prominence.

For many animals this will be the front of the face (e.g. the snout).</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>nudge</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">nudging</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>touching</oboInOwl:hasRelatedSynonym>
        <rdfs:label>nudge hit</rdfs:label>
        <skos:example>&quot;Cichlosoma meeki...
It looks as if she is going to receive a very heavy blow, but just before the male has reached the female, he brakes and only touches her gently.&quot;</skos:example>
        <skos:scopeNote>&quot;Courtship in the ancestral ambystomatid consisted of an approach phase (in which the male rapidly nudged the female) and a tailtapping display (in which the male faced away from the female and tapped her with his tail). The tail-tapping display constitutes an invitation to a cloaca-nudging walk.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000889"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Hit that involves brief, non-destabilising contact, using a blunt body prominence.

For many animals this will be the front of the face (e.g. the snout).</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1643/h2023077</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000889"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>nudge</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2024</dc:date>
        <dc:source>doi:10.1643/h2023077</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000889"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">nudging</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2003</dc:date>
        <dc:source>ISBN:9781482294347</dc:source>
    </owl:Axiom>
