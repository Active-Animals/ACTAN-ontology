    <!-- http://purl.obolibrary.org/obo/ACTAN_0000772 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000772">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000671"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-30T12:01:13.306148Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Thrust in which an appendage needs to operate at a point well above the drag–thrust boundary.

The drag force is experienced by the non-thrust-producing surfaces such as the head, body and the tail.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">active flapping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>wing beating</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>wingbeat</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>stroking</oboInOwl:hasRelatedSynonym>
        <rdfs:label>flap thrust</rdfs:label>
        <skos:scopeNote>&quot;...a pitching wing needs to flap approximately 75% faster than the heaving wing when it needs to cross the drag–thrust boundary.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;This absence of a logarithmic speed/frequency relationship in flying birds may be attributed to the fact that wingbeats not only move the animal forward, but keep it suspended against the force of gravity.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000772"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Thrust in which an appendage needs to operate at a point well above the drag–thrust boundary.

The drag force is experienced by the non-thrust-producing surfaces such as the head, body and the tail.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1017/jfm.2017.173</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Assuming that a bird flies at a constant cruising speed, the thrust force generated by the flapping wings has to be equal to the drag force experienced by the non-thrust-producing aerodynamic surfaces such as the head, body and the tail of the bird. The total drag force, and thus the thrust force, are not insignificant, which suggests that bird wings need to operate at a point well above the drag–thrust boundary.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000772"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">active flapping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2011</dc:date>
        <dc:source>doi:10.1038/ncomms1350</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000772"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>wing beating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1966</dc:date>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000772"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>wingbeat</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000772"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>stroking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000772"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>flap thrust</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000772"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...a pitching wing needs to flap approximately 75% faster than the heaving wing when it needs to cross the drag–thrust boundary.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1017/jfm.2017.173</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000772"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;This absence of a logarithmic speed/frequency relationship in flying birds may be attributed to the fact that wingbeats not only move the animal forward, but keep it suspended against the force of gravity.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000773 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000773">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000751"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0040046"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-03T17:25:45.624065Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>growth</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Context that ontogenetically integrates form and function.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">development</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>ontogeny</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Recognising that ontogeny is generally considered a physiological process, which are not generally within our scope, ontogeny has associated specific behaviours which are.</rdfs:comment>
        <rdfs:label>development context</rdfs:label>
        <skos:example>&quot;Juvenile P. multifasciatus were mostly found in foraging associations with small and medium size P. barberinus, however adults rarely formed foraging associations with P. barberinus, though they did travel together in mixed schools at times. By contrast, adult P. indicus was found predominantly in associations with large P. barberinus, yet juvenile P. indicus rarely formed foraging associations with small and medium P. barberinus. Strand (1988) found similar ontogenetic effects.&quot;</skos:example>
        <skos:scopeNote>&quot;Dimorphic males are reported in many species known or likely to engage in male-male combat, but surprisingly few of them have been investigated to ascertain the developmental basis and functions of the dimorphism...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;I should like to characterise the phenomenon as &quot;change of behaviour machinery during development&quot;. This is not, of course, the same as a change of behaviour during development;&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The energy available to organisms is limited, making it crucial for them to adequately partition their total energy budget into growth, maintenance and reproduction.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000773"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>growth</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000773"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Context that ontogenetically integrates form and function.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.2307/4083155</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The study of the ontogeny of displays is an important but seldom used method of obtaining evidence about derivation and the developmental integration of form and function.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000773"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">development</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1966</dc:date>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000773"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ontogeny</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000773"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Recognising that ontogeny is generally considered a physiological process, which are not generally within our scope, ontogeny has associated specific behaviours which are.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000773"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>development context</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000773"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Juvenile P. multifasciatus were mostly found in foraging associations with small and medium size P. barberinus, however adults rarely formed foraging associations with P. barberinus, though they did travel together in mixed schools at times. By contrast, adult P. indicus was found predominantly in associations with large P. barberinus, yet juvenile P. indicus rarely formed foraging associations with small and medium P. barberinus. Strand (1988) found similar ontogenetic effects.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000773"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Dimorphic males are reported in many species known or likely to engage in male-male combat, but surprisingly few of them have been investigated to ascertain the developmental basis and functions of the dimorphism...&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000773"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;I should like to characterise the phenomenon as &quot;change of behaviour machinery during development&quot;. This is not, of course, the same as a change of behaviour during development;&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1439-0310.1963.tb01161.x</dc:source>
    </owl:Axiom>
    


