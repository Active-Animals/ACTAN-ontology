        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000195"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...a patagium attached the body section... in... the ‘Flying’ Gecko, Ptychozoon kuhli... automatically deploys upon the reptile launching into the air...

...Rhacophorus, are a group of tree frogs that have strong webbing located between their digits.

...the ‘flying’ snakes belonging to the genus group Chrysopelea... prominent body movements are utilized in air rather than simply relying on a fixed wing arrangement.

All the reptile examples detailed above really only exhibit... a parachuting aerial mode, reducing the sinking speed of the animal slightly.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1088/1748-3182/9/1/011001</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000195"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Aequidens latfrons...
After the parents have ejected the young over the pit these sink down slowly with turning movements like maple seeds. The yolk is apparently heavier than the tail which brakes the sinking movement.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000196 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000176"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000183"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-26T19:24:52.557344Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Locomotion that uses a fluid propulsor to produce thrust in an aquatic environment.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">swimming</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">swimming locomotion</rdfs:label>
        <skos:closeMatch>NBO:0000371</skos:closeMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000196"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Locomotion that uses a fluid propulsor to produce thrust in an aquatic environment.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/36.6.555</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000196"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">swimming</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000196"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">swimming locomotion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
