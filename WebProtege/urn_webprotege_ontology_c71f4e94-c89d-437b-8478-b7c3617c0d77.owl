    <!-- http://purl.obolibrary.org/obo/ACTAN_0000719 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000719">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000676"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000590"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-21T19:06:24.33486Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Respiration that sucks.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>breathing in</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>inhalation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">inspiration</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">inspiration respiration</rdfs:label>
        <skos:scopeNote>&quot;At the onset of inspiration, the velum moves forward and the pharynx begins to expand. Enlargement of the central lumen and parabranchial chambers draws some water in through the branchiopore under the still-closing branchial valve, and flow over the gills is medial. Later in inspiration, the gill pores are entirely shut, and the expanding parabranchial chambers draw water laterally again across the filaments.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000719"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Respiration that sucks.</owl:annotatedTarget>
        <dc:source>https://orcid.org/0000-0002-4277-2151</dc:source>
        <rdfs:comment>Compositional definition.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000719"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>breathing in</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
        <skos:scopeNote>&quot;...laborious breathing...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000719"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>inhalation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000719"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">inspiration</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1993</dc:date>
        <dc:source>ISBN:9780226315737</dc:source>
