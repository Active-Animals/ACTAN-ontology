    <!-- http://purl.obolibrary.org/obo/ACTAN_0000920 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000920">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000893"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-12-28T21:26:16.841819Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Courtship in which an animal coaxes another to join in to begin gamete release.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>soliciting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>copulatory solicitation</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">precopulatory display</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>approach</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>coaxing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gliding</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>invitation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">posturing</oboInOwl:hasRelatedSynonym>
        <rdfs:label>solicitation courtship</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000177"/>
        <skos:closeMatch>NBO:0020241</skos:closeMatch>
        <skos:example>&quot;...guppies (Poecilia reticulata)...

...the female ‘glided’, that is, when she swam towards the displaying male using her pectoral fins with a smooth motion; the more courtship a female receives, the more likely the female will glide.&quot;</skos:example>
        <skos:example>&quot;Chimpanzee...
At Mahale, some estrous females approach and touch males on the shoulder, and so on, to solicit copulation.&quot;</skos:example>
        <skos:example>&quot;Chimpanzee...
Goodall&apos;s Male invite: &quot;The male sits with thighs splayed and penile erection, looking toward a female in estrus. Sometimes his hair is erect...&quot; Male  courtship display pattern.&quot;</skos:example>
        <skos:example>&quot;Nocomis leptocephalus...
Head facing upstream, the male hovered 2—4 cm above the pit floor. His dorsal and paired fins remained fully extended and his head was angled slightly downwards such that his body nearly paralleled the nest’s upstream slope. Successful spawning sequences always began with the pit-postured male.&quot;</skos:example>
        <skos:example>&quot;Tilapia natalensis and T. nilotica...
The male swims slowly in front of the partner in the direction of his pit, always trying to show it a flank. If the partner stops, the male stops too and by swimming in front of the head of the partner he tries to coax it along again.&quot;&quot;</skos:example>
        <skos:example>&quot;Zebrafish...
Lead (leading): Returning at least three times to one location...; performed by females during courtship.&quot;</skos:example>
        <skos:example>&quot;Zebrafish...
Present (presenting): Halting and exposing side in front of a male or swimming up and down in front of male; performed by females during courtship.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000920"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Courtship in which an animal coaxes another to join in to begin gamete release.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
