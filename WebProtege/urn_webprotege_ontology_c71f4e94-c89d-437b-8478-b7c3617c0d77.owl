    <!-- http://purl.obolibrary.org/obo/ACTAN_0000805 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000805">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-19T13:04:31.313658Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Ethotype that involves a selection from a variety of ritualized behaviour sequences, prior to flying up.

It may indicate intention in an individual, transmit the flying mood to others, and ensure synchronous flight in the group.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">pre-flight signaling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pre-take-off</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">pre-flight ethotype</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000641"/>
        <skos:example>&quot;Head-shaking is widespread in the pre-flight behaviour of Anatidae... in Greylag Geese... the intensity of the movements gradually increases up to the moment of take-off.&quot;</skos:example>
        <skos:example>&quot;Lorenz described the &quot;going-away call&quot; of the female Mallard which consisted of a series of &quot;quacks&quot; and is given especially before flight...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000805"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Ethotype that involves a selection from a variety of ritualized behaviour sequences, prior to flying up.

It may indicate intention in an individual, transmit the flying mood to others, and ensure synchronous flight in the group.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000805"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">pre-flight signaling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000805"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pre-take-off</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
        <skos:scopeNote>&quot;...precede a take-off...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000805"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">pre-flight ethotype</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000805"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Head-shaking is widespread in the pre-flight behaviour of Anatidae... in Greylag Geese... the intensity of the movements gradually increases up to the moment of take-off.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000805"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Lorenz described the &quot;going-away call&quot; of the female Mallard which consisted of a series of &quot;quacks&quot; and is given especially before flight...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000806 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000806">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000726"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-19T14:13:05.230223Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Extending that aims the head.

It may progressively involve the head, the neck, and the forebody.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>head aiming</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>head and neck pointing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>head pointing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>head raising</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>bill pointing</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">chin-lifting</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>crown pointing</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>head-thrusting</oboInOwl:hasNarrowSynonym>
        <rdfs:label>head extending</rdfs:label>
        <skos:example>&quot;...when two male Purple Grackles were present on two occasions during anting, both birds indulged in the act of raising the head, pointing the bill upward.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000806"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Extending that aims the head.

It may progressively involve the head, the neck, and the forebody.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000806"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>head aiming</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
        <skos:scopeNote>&quot;...aiming movements of the head... such pointing movements...&quot;</skos:scopeNote>
    </owl:Axiom>
