    <!-- http://purl.obolibrary.org/obo/ACTAN_0000240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000093"/>
        <rdfs:subClassOf>
