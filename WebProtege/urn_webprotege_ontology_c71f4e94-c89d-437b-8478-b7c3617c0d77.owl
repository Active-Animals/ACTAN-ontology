    <!-- http://purl.obolibrary.org/obo/ACTAN_0000388 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000388">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000389"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000893"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-05T17:10:00.678316Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Competition which involves direct negative interactions resulting from aggressive behaviour.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">interference</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>detracting</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>disruption</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">interference competition</rdfs:label>
        <skos:example>&quot;...a small tuberculate male Campostoma anomalum (stoneroller) in breeding color disrupted 10 spawning sequences between the resident male and several female Nocomis leptocephalus (chub).&quot;</skos:example>
        <skos:scopeNote>&quot;Bouskila inferred that &apos;the dominant species primarily responds to the distribution of risk from the predator, while the subordinate species appears to respond to both the risk of predation and the risk of interference from the dominant competitor&apos;.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000388"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Competition which involves direct negative interactions resulting from aggressive behaviour.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/s00265-020-02893-2</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Interference competition refers to direct negative interactions resulting from aggressive behaviour.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000388"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">interference</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000388"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>detracting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1976</dc:date>
        <dc:source>doi:10.1111/j.1439-0310.1976.tb00970.x</dc:source>
    </owl:Axiom>
