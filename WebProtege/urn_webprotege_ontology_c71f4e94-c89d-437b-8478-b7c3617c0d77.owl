        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-16T19:27:37.577554Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement in which all feet are off the ground.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">suspension</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>unsupported</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>floating</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>free-floating</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>glide</oboInOwl:hasRelatedSynonym>
        <rdfs:label>suspension placement</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000091"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Placement in which all feet are off the ground.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/20.1.255</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Suspensions (periods in the locomotor cycle when all feet are off of the ground) may be costly in terms of effort.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000091"/>
