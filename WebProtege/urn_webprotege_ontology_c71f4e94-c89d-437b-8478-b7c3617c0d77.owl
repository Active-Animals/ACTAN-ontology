    <!-- http://purl.obolibrary.org/obo/ACTAN_0000804 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000804">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000625"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000623"/>
            </owl:Restriction>
        </rdfs:subClassOf>
