        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000612"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Cleaner wrasse occupy cleaning stations on coral outcrops...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10071-014-0761-0</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000612"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Intermittent locomotion... occurs in water striders holding station in the current.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/41.2.137</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000612"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;A fish was determined to be hunkering if it was able to maintain station by adhering to the bottom of the tunnel without body or caudal fin undulation.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/jfb.12866</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000613 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000613">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-17T16:12:44.835491Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Ethotype in which clients present themselves and perform a stance which signals to the cleaner that they require a service.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">clean-me</oboInOwl:hasExactSynonym>
        <rdfs:comment>If a relevant ontology is developed, this would become a subtype of a maintenance ethotype.</rdfs:comment>
        <rdfs:label xml:lang="en">clean-me ethotype</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000607"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000613"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Ethotype in which clients present themselves and perform a stance which signals to the cleaner that they require a service.</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10071-014-0761-0</dc:source>
        <skos:scopeNote>&quot;The clients present themselves and perform a ‘‘clean me’’ stance which signals to the cleaner that they require a good service.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000613"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">clean-me</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2015</dc:date>
        <dc:source>doi:10.1007/s10071-014-0761-0</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000613"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>If a relevant ontology is developed, this would become a subtype of a maintenance ethotype.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000613"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">clean-me ethotype</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000614 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000614">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MF_0000027"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-17T16:22:16.695868Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Assessment that involves planning.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">prioritisation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>prioritization</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>priority</oboInOwl:hasExactSynonym>
        <rdfs:label>priority assessment</rdfs:label>
        <skos:example>&quot;For instance, in mammals, a risk of predation suppresses roaming when well-fed, but extreme hunger overrides danger perception and results in prioritizing food-seeking behavior.&quot;</skos:example>
        <skos:scopeNote>&quot;If there are a number of clients waiting to be serviced, cleaner fish will prioritise transients, knowing that the locals have nowhere else to go.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000614"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Assessment that involves planning.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Linguistic inference.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000614"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">prioritisation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2015</dc:date>
        <dc:source>doi:10.1007/s10071-014-0761-0</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000614"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>prioritization</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1177/1745691610369469</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000614"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
