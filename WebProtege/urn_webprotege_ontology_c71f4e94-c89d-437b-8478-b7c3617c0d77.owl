    <!-- http://purl.obolibrary.org/obo/ACTAN_0000448 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000409"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PCO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T11:35:14.730572Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Participation that involves the structure of a group&apos;s relationships.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">networking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>social network</oboInOwl:hasExactSynonym>
        <rdfs:label>network participation</rdfs:label>
        <skos:scopeNote>&quot;...territory is socially constructed through interactions among individuals...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000448"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Participation that involves the structure of a group&apos;s relationships.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.3389/fetho.2022.1066186</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Recent advances in social network approaches are now putting us in a position to understand better how networks of signaling relate to networks of other social behavior (such as affiliations or agonistic interactions), and this should help us  better understand how social interactions build into the social relationships that create the structure of groups.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000448"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">networking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.3389/fetho.2022.1066186</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000448"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>social network</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2011</dc:date>
        <dc:source>doi:10.1089/zeb.2011.0690</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000448"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>network participation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
