    <!-- http://purl.obolibrary.org/obo/ACTAN_0000963 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000963">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000739"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_4000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-25T04:02:40.597962Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Adducting in which the anal fin is actively moved towards the midline.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">anal-fin adducting</rdfs:label>
        <skos:example>&quot;The primarily lateral orientation of dorsal fin force in trout induces corresponding roll and yaw moments, which must be countered by forces from the caudal, anal and paired fins.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000963"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Adducting in which the anal fin is actively moved towards the midline.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.01922</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000963"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">anal-fin adducting</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
