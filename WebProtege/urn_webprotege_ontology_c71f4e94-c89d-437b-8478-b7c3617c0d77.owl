        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000255"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>coiled-concertina gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000093"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-06T10:07:00.111334Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Traversing-gait that involves supports angled at more than 45 degrees.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">climbing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>vertical climb</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>scansorial power</oboInOwl:hasRelatedSynonym>
        <rdfs:label>climbing gait</rdfs:label>
        <skos:relatedMatch>NBO:0000368</skos:relatedMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000256"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Traversing-gait that involves supports angled at more than 45 degrees.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/BF02381373</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;L8. Vertical climb:
a. Flexed-elbow vertical climb: Ascent on supports angled at &gt;= 45 degrees...
g. Rump-first descent: (1) Symmetrical rump-first descent: vertical quadrupedal descent of a support angled at &gt;= 45 degrees; rather the kinematic reverse of ascent, but often with more abduction of the forelimb...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000256"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">climbing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1986</dc:date>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000256"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>vertical climb</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
