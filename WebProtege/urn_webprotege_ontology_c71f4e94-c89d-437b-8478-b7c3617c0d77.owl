    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000711"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...extension into the water column from a burrow as in the garden eels Taeniconger and Gorgasia (Congridae)...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
