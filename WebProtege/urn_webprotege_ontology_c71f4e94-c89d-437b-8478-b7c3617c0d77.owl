        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000962"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The ocean sunfish is an extreme example of tetraodontiform swimmer: it has virtually no caudal fin or body musculature and propels itself by synchronized oscillations of its very high dorsal and anal fins.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1109/48.757275</dc:source>
