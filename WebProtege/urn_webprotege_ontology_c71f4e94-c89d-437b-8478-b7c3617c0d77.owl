        <oboInOwl:hasBroadSynonym>peristaltic crawling</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Burrowing-gait in which radially expanded regions anchor the organism to the substratum while the radially contracted regions advance.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym xml:lang="en">worm crawling</oboInOwl:hasRelatedSynonym>
        <rdfs:label>peristaltic-burrowing gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000797"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
