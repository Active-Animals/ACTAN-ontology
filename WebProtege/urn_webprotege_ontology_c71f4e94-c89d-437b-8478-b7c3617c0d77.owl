            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-03T19:26:43.310424Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Traversing-gait in which the body is propelled while the ischia support a substantial proportion of the body weight.

Knee and thigh remain flexed while propelling the body.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">scoot</oboInOwl:hasExactSynonym>
        <rdfs:label>scoot gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000240"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Traversing-gait in which the body is propelled while the ischia support a substantial proportion of the body weight.

Knee and thigh remain flexed while propelling the body.</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF02381373</dc:source>
        <skos:scopeNote>&quot;LI$. Scoot: The body is propelled by sliding while the ischia support a substantial proportion of the body weight; knee and thigh remain flexed while propelling the body.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000240"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">scoot</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
