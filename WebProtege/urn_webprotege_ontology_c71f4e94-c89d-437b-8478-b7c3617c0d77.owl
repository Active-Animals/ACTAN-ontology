        <oboInOwl:hasBroadSynonym xml:lang="en">zigzag</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Swimming-regime that involves multiple darts, during which the direction of movement changes between the darts.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>erratic swimming</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>jumping</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>We are not putting pathological terms in our ontology, or seizures or drug-induced erratic movements might have fitted alongside here.</rdfs:comment>
        <rdfs:label>zigzag-swimming regime</rdfs:label>
        <skos:example>&quot;; for instance, the threespined stickleback, which performs the zig-zag dance.&quot;</skos:example>
        <skos:example>&quot;As we walk to the edge of a stream, a stickleback freezes, then darts away in a series of rapid zig-zags punctuated by brief pauses.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000549"/>
