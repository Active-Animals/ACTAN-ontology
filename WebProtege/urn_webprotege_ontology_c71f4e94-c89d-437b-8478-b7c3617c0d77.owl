        <oboInOwl:hasBroadSynonym>aggregate fruit  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>compound fruit  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>dehiscent fruit  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>diaspore  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>indehiscent fruit  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>multiple fruit  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>propagule  (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>FNA:67fa41ae-b735-4d89-b5db-7631b873ef7a</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FNA:c13b1312-1cc5-4ace-98e2-fde12aec09da</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:76</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>frucht (exact, German)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fruto (exact, Spanish)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>果実 (exact, Japanese)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>coenocarp (narrow)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>syncarp (narrow)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PO:0009001</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Angiosperm"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Arabidopsis"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#Maize"/>
