    <!-- http://purl.obolibrary.org/obo/ACTAN_0000421 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000421">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000080"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:32:33.318292Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>vibrating</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Movement in which a structure swivels repeatedly on its base, with a characteristic frequency and amplitude.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>oscillating motion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>oscillation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>oscillatory motion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>oscillatory movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">vibration</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">oscillation movement</rdfs:label>
        <skos:example>&quot;...sepsid flies (Diptera: Sepsidae)...
Male repeatedly lowers abdomen to stimulate female using the surstylis, either by vibration or by tapping on dorsal surface of female abdomen.&quot;</skos:example>
        <skos:example>&quot;Alcids are capable of competent aerial locomotion using a typical avian flapping technique, then fold their wings during aquatic operations and perform an oscillating motion of the wings in order to propel themselves.&quot;</skos:example>
        <skos:scopeNote>&quot;Andrew describes &quot;feather settling with marked wing vibration&quot; in Emberiza, associated with preening the primaries and oiling after bathing. I have also seen vigorous wing-shaking during oiling in the Semipalmated Plover...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Tail vibration itself, as a distraction away from the head, is also a plesiomorphic character for pitvipers.&quot;</skos:scopeNote>
    </owl:Class>
