        <oboInOwl:creation_date>2025-06-27T11:09:17.840481Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement which pairs the eyes in the same direction.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">conjugate eye movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>version</oboInOwl:hasExactSynonym>
        <rdfs:label>conjugation eye-movement</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000745"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement which pairs the eyes in the same direction.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.ncbi.nlm.nih.gov/books/NBK10981/</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The paired movements of the two eyes in the same direction, as occurs in the vestibulo-ocular reflex.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000745"/>
