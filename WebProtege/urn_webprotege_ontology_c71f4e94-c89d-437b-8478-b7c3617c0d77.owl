        <oboInOwl:creation_date>2026-07-12T10:13:38.29216Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Extension that results from head extending.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">head extension</rdfs:label>
        <skos:example>&quot;Captive Trumpeter Swans often perform vigorous shakes when... they are threatening; at times only the wings are shaken, the head held stiffly forward with the bill pointing vertically downward.&quot;</skos:example>
    </owl:Class>
