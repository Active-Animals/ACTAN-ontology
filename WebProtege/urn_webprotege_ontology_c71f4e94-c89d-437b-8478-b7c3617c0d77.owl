        <oboInOwl:hasDefinition>Flying-regime in which the wings are held close to the body during flight pauses, during which a loss of altitude is experienced.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">bounding flying</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">bounding regime</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000533"/>
