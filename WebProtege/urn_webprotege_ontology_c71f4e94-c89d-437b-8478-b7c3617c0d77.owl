    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000259 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000177"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000060"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/posture"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-06T10:11:32.563847Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Posture that anchors the lower body to a stable, near-vertical support, while the trunk is held rigid and near horizontal.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">cantilever</oboInOwl:hasExactSynonym>
        <rdfs:label>cantilever posture</rdfs:label>
        <skos:example>&quot;a. Extended cantilever: Knees and body are extended, often fully so in lorisids and cheirogaleids.
b. Lean out cantilever: Knees are flexed (exemplar: tarsiers).&quot;</skos:example>
        <skos:scopeNote>&quot;This behavior is quite different from bridging and should not be conflated with it.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000259"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Posture that anchors the lower body to a stable, near-vertical support, while the trunk is held rigid and near horizontal.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/BF02381373</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Cantilever: The feet anchor the lower body to a stable near-vertical support. The trunk is held rigid and near horizontal as the individual reaches out to snatch insects with the forelimbs (Fig. 10).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000259"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">cantilever</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000259"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>cantilever posture</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000259"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;a. Extended cantilever: Knees and body are extended, often fully so in lorisids and cheirogaleids.
b. Lean out cantilever: Knees are flexed (exemplar: tarsiers).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000259"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;This behavior is quite different from bridging and should not be conflated with it.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000093"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000628"/>
            </owl:Restriction>
