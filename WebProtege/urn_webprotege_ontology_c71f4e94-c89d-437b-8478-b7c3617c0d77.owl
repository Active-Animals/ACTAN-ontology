        <oboInOwl:hasRelatedSynonym>elevated</oboInOwl:hasRelatedSynonym>
        <rdfs:label>increased elevation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001689 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001689">
