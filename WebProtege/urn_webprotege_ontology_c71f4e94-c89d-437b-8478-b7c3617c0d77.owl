        <oboInOwl:hasDefinition>Aggregation that maintains single-file, head-to-tail alignment of groups of individuals.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>procession</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">single file</oboInOwl:hasExactSynonym>
        <rdfs:label>procession aggregation</rdfs:label>
        <skos:scopeNote>&quot;Field observations of how the gobies are able to spread out on separate branches on D. gemmacea, compared with being restricted to a single file on J. juncea...&quot;</skos:scopeNote>
    </owl:Class>
