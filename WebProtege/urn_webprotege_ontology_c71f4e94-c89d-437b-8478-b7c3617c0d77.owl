        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-06T15:14:06.353098Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Traversing-regime that involves reaching out to grasp a support on one side of a gap which is pulled toward the animal, pulling the body across the open space, and retaining both grips until a secure position is established on the other side.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">gap-closing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">gap-close regime</rdfs:label>
    </owl:Class>
