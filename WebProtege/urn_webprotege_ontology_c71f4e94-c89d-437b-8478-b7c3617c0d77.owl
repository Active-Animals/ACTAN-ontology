                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-26T17:03:12.765063Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Ethotype in which a strongly reproductively active male&apos;s display consists of a body-shake, head-tossing, and calls.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">throw-up</oboInOwl:hasExactSynonym>
        <rdfs:comment>If a relevant ontology is developed, this would become a subtype of an agonism ethotype.</rdfs:comment>
        <rdfs:label xml:lang="en">throw-up ethotype</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000336"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Ethotype in which a strongly reproductively active male&apos;s display consists of a body-shake, head-tossing, and calls.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853965x00138</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The &quot;Throw-up&quot; of the male Common Shelduck... consists of a body-shake with a very exaggerated upward tossing of the head at the end of the movement, the head-tossing being accompanied by calls... Males perform the Throw-up when they are strongly reproductively active...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000336"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">throw-up</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000336"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>If a relevant ontology is developed, this would become a subtype of an agonism ethotype.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000336"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">throw-up ethotype</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000337 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MFOEM_000028"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-15T15:10:27.789576Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Assessment that involves a prolonged threat.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">vulnerability</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">vulnerability assessment</rdfs:label>
        <skos:scopeNote>&quot;The optimal or adaptive decision, the one that maximises the individual prey’s fitness, depends on a number of factors including the magnitude of the perceived predation threat, the expected payoff of the antipredator response adopted, the prey’s vulnerability to predation, its current condition, its ‘personality’ and constraints imposed by correlated behaviours.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The snakes in the bucket might have perceived less vulnerability when in physical contact with the rope or another conspecific, and therefore rattled less.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000337"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Assessment that involves a prolonged threat.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Linguistic inference.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000337"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">vulnerability</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1988</dc:date>
        <dc:source>doi:10.1126/science.239.4847.1525</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000337"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">vulnerability assessment</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000337"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The optimal or adaptive decision, the one that maximises the individual prey’s fitness, depends on a number of factors including the magnitude of the perceived predation threat, the expected payoff of the antipredator response adopted, the prey’s vulnerability to predation, its current condition, its ‘personality’ and constraints imposed by correlated behaviours.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1238167</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000337"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The snakes in the bucket might have perceived less vulnerability when in physical contact with the rope or another conspecific, and therefore rattled less.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1181774</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000338 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000338">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000335"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0007612"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-15T15:10:44.367291Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Perception which requires an acquired ability to perform an action.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>experience</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">learning</oboInOwl:hasRelatedSynonym>
        <rdfs:label>experience perception</rdfs:label>
        <skos:example>&quot;Fear of any particular enemy is certainly an instinctive quality, as may be seen in nestling birds, though it is strengthened by experience, and by the sight of fear of the same enemy in other animals.&quot;</skos:example>
        <skos:relatedMatch>NBO:0000006</skos:relatedMatch>
        <skos:scopeNote>&quot;In the case of social learning – a capacity shown by many other species – animals learn by imitation in the presence of a conspecific.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;In this way, the predator learns to associate the aposematic cue with a painful experience and will in the future avoid animals that exhibit that signal.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000338"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Perception which requires an acquired ability to perform an action.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
        <skos:scopeNote>&quot;An action, which we ourselves should require experience to enable us to perform, when performed by an animal, more especially by a very young one, without any experience, and when performed by many individuals in the same way, without their knowing for what purpose it is performed, is usually said to be instinctive.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000338"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>experience</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000338"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">learning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1922</dc:date>
        <dc:source>doi:10.2307/2939673</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000338"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>experience perception</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000338"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Fear of any particular enemy is certainly an instinctive quality, as may be seen in nestling birds, though it is strengthened by experience, and by the sight of fear of the same enemy in other animals.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000338"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In the case of social learning – a capacity shown by many other species – animals learn by imitation in the presence of a conspecific.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.4000/ejpap.2324</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000338"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In this way, the predator learns to associate the aposematic cue with a painful experience and will in the future avoid animals that exhibit that signal.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000339 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000338"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0046959"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-15T15:11:03.858973Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Experience that shows a robustly decreased response upon repeated exposure to a novel stimulus.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>accustoming</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">habituating</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">habituation experience</rdfs:label>
        <skos:closeMatch>NBO:0000178</skos:closeMatch>
        <skos:scopeNote>&quot;Since previously injured snakes behaved in the same manner as gravid females and warm snakes, it may be that they were less willirig to proactively engage the enemy. As the ditty goes, &quot;Once bitten, twice shy.&quot; In my study, it is impossible to determine if this learning represents an altered behavioral decision due to a snake&apos;s ability to evaluate and thus, better respond to a predator, or simply a habituated reduction in active behavior due to stress.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000339"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Experience that shows a robustly decreased response upon repeated exposure to a novel stimulus.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Habituation: Tendency to show a robustly decreased response upon repeated exposure to a novel stimulus/environment.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000339"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>accustoming</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000339"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">habituating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000339"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">habituation experience</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000339"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Since previously injured snakes behaved in the same manner as gravid females and warm snakes, it may be that they were less willirig to proactively engage the enemy. As the ditty goes, &quot;Once bitten, twice shy.&quot; In my study, it is impossible to determine if this learning represents an altered behavioral decision due to a snake&apos;s ability to evaluate and thus, better respond to a predator, or simply a habituated reduction in active behavior due to stress.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000340 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000340">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000338"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MF_0000002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-15T15:11:19.450112Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Experience which accepts that its awareness of a present discovery is little different to relatively important knowledge it has of an original discovery.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">recognition</oboInOwl:hasExactSynonym>
        <rdfs:label>recognition experience</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000411"/>
        <skos:closeMatch>NBO:0000550</skos:closeMatch>
        <skos:example>&quot;Eupomacentrus altus, an algal feeding damsel fish, also changed its territorial behavior depending on fish species and feeding habits, and... can recognize the species of invaders.&quot;</skos:example>
        <skos:example>&quot;Female pitvipers frequently aggregate during gestation, with at least one species (Crotalus horridus) forming aggregations consisting of relatives, as pitvipers are capable of kin recognition.&quot;</skos:example>
        <skos:scopeNote>&quot;Grasping involves first recognizing the affordances that an object offers for grasping, moving the grasping appendage toward the object, and preshaping the appendage according to these affordances, and finally enclosing the object at the appropriate areas to establish the grasp.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Similarly, increased water turbidity limits the ability of fathead minnows to generalise the learned recognition of novel predators&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The process of individual recognition and learning plays an important role in the establishment of linear dominance hierarchy in small groups of fish because the  dominant fish is able to differentiate and rank subordinate fish into different categories based on previous encounters among individuals. In the case of resource defense, conspecifics manifest differences in fighting ability...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000340"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Experience which accepts that its awareness of a present discovery is little different to relatively important knowledge it has of an original discovery.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000340"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">recognition</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000340"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>recognition experience</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000340"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Eupomacentrus altus, an algal feeding damsel fish, also changed its territorial behavior depending on fish species and feeding habits, and... can recognize the species of invaders.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1444-2906.2003.00797.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000340"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Female pitvipers frequently aggregate during gestation, with at least one species (Crotalus horridus) forming aggregations consisting of relatives, as pitvipers are capable of kin recognition.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1181774</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000340"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Grasping involves first recognizing the affordances that an object offers for grasping, moving the grasping appendage toward the object, and preshaping the appendage according to these affordances, and finally enclosing the object at the appropriate areas to establish the grasp.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/tops.12554</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000340"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Similarly, increased water turbidity limits the ability of fathead minnows to generalise the learned recognition of novel predators&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1238167</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000340"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The process of individual recognition and learning plays an important role in the establishment of linear dominance hierarchy in small groups of fish because the  dominant fish is able to differentiate and rank subordinate fish into different categories based on previous encounters among individuals. In the case of resource defense, conspecifics manifest differences in fighting ability...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1002/(SICI)1098-2337(1998)24:3&lt;197::AID-AB4&gt;3.0.CO;2-I</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000341 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000751"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-21T08:28:42.751536Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Context that is concerned with the general health and efficiency of the body.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">maintenance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>self maintenance</oboInOwl:hasExactSynonym>
        <rdfs:comment>Some sources sub-locate locomotor activity (sometimes termed locomotion) within maintenance.</rdfs:comment>
        <rdfs:label xml:lang="en">maintenance context</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000176"/>
        <skos:example>&quot;It has been shown that temperature is better regulated in beehives in summer, when there is brood in the hive, than in winter. This is likely due to the important role of temperature in egg development; it is known that at too low (i.e. &lt; 33˚C) or too high (i.e. &gt; 36˚C) temperature eggs, larvae and pupae die. Similarly, maintenance of humidity level is crucial for social insects; it directly affects the proper development of eggs, larvae and pupae, which die when the ambient environment is too dry.&quot;</skos:example>
        <skos:scopeNote>&quot;KORTLAND, in describing the behaviour elements of the Cormorant, distinguishes as a major group the actions having a maintenance function. In this group he for instance classifies feeding behaviour, withdrawing from danger, migration, and resting, but he also distinguishes two further groups... movements serving to remove discomfort... [and] stretching movements... we do not... see a difference in principle... Therefore, we will call all the movements... comfort movements...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000341"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Context that is concerned with the general health and efficiency of the body.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000341"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">maintenance</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000341"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>self maintenance</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000341"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Some sources sub-locate locomotor activity (sometimes termed locomotion) within maintenance.</owl:annotatedTarget>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000341"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">maintenance context</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000341"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;It has been shown that temperature is better regulated in beehives in summer, when there is brood in the hive, than in winter. This is likely due to the important role of temperature in egg development; it is known that at too low (i.e. &lt; 33˚C) or too high (i.e. &gt; 36˚C) temperature eggs, larvae and pupae die. Similarly, maintenance of humidity level is crucial for social insects; it directly affects the proper development of eggs, larvae and pupae, which die when the ambient environment is too dry.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1371/journal.pone.0200048</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000341"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;KORTLAND, in describing the behaviour elements of the Cormorant, distinguishes as a major group the actions having a maintenance function. In this group he for instance classifies feeding behaviour, withdrawing from danger, migration, and resting, but he also distinguishes two further groups... movements serving to remove discomfort... [and] stretching movements... we do not... see a difference in principle... Therefore, we will call all the movements... comfort movements...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000342 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000381"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000146"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-21T08:29:46.184524Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Homeostasis that keeps temperature stable and controlled.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>self-thermoregulating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">thermoregulation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">thermoregulation homeostasis</rdfs:label>
        <skos:closeMatch>NBO:0000051</skos:closeMatch>
        <skos:example>&quot;Ardeola ibis...
The commonest response to high air temperature and solar radiation is gular flutter, which is present from the first day and becomes less frequent as feathering proceeds and insulation improves...
The commonest response to low environmental temperatures is clumping, in which siblings squat on their tarsometatarsi in the centre of their nest, huddling together and facing inwards towards each other.&quot;</skos:example>
        <skos:example>&quot;Warmer over wintering sites also provide superior thermo regulatory opportunities to pre- and post-emergent snakes, helping prepare individuals for brumation (e.g. purging the gut of food) or ‘kick-starting’ physiological processes (e.g. metabolic rates) for rapid resumption of active season activities. Such habitat also provides a thermal mosaic of rocky features for enhanced thermoregulation and a protective cover for predator evasion, optimal for use by gravid females during the summer months.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000342"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Homeostasis that keeps temperature stable and controlled.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1371/journal.pone.0200048</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;As superorganisms, eusocial insects have evolved many strategies to maintain their nest temperature stable and controlled, especially in order to protect the eggs from extreme temperature variations.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000342"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>self-thermoregulating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000342"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">thermoregulation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000342"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
