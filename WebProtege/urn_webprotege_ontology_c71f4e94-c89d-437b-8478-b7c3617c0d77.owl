        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000515"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Swimming-regime that moves forward in a single motion, and coasts to a slow speed from which they burst forward again.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Fish move forward (burst) in a single motion and glide (coast) to a slow speed, or stop from which they burst forward again.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000515"/>
