        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-10T20:57:44.268157Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>skimming</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Interfacing-regime that presses against the aqueous-substrate boundary, while actively propelling.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">substratum skimming</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>pseudofertilizing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pseudolaying</oboInOwl:hasRelatedSynonym>
        <rdfs:label>substrate-skim regime</rdfs:label>
        <skos:example>&quot;Cichlasoma severum...
After having practised some very intensive nipping-off movements, the female for the first time shows an incomplete skimming movement. Then the male too begins &quot;pseudofertlizing&quot;.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000627"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>skimming</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000627"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Interfacing-regime that presses against the aqueous-substrate boundary, while actively propelling.</owl:annotatedTarget>
        <dc:source>doi:10.1111/jfb.12866</dc:source>
        <skos:scopeNote>&quot;Fish that were substratum-skimming (ventrally pressed against the bottom of the lume with active caudal undulation) were not considered to be hunkering.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000627"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">substratum skimming</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2016</dc:date>
        <dc:source>doi:10.1111/jfb.12866</dc:source>
    </owl:Axiom>
