        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
        <owl:annotatedTarget rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000137"/>
        <dc:source>https://apps.dtic.mil/sti/html/tr/AD0675256/</dc:source>
