    <!-- http://purl.obolibrary.org/obo/ACTAN_0000290 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000290">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000178"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
