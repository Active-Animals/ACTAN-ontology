    <!-- http://purl.obolibrary.org/obo/ACTAN_0000264 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
