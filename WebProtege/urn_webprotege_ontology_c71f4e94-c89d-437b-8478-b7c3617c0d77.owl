    <!-- http://purl.obolibrary.org/obo/ACTAN_0000043 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000178"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0015029"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-06T16:27:26.557228Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Travel that relies on suspension in moving fluid surroundings.

The ratio of inertial to viscous forces (measured by the Reynolds number) will be too low to enable independant locomotion, and also allows fluid currents to have a greater impact than gravity or density.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>nature adrift</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>plancton</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>plankter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">plankton</oboInOwl:hasExactSynonym>
        <rdfs:label>plankton travel</rdfs:label>
        <skos:scopeNote>&quot;...planctonic forms with extended surfaces to assist in flotation.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000043"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Travel that relies on suspension in moving fluid surroundings.

The ratio of inertial to viscous forces (measured by the Reynolds number) will be too low to enable independant locomotion, and also allows fluid currents to have a greater impact than gravity or density.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>ISBN:9780226315737</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000043"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>nature adrift</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1973</dc:date>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    <owl:Axiom>
