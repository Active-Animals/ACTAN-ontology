                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000929"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-03T19:26:27.651321Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Interfacing-regime that follows a period of suspension, decelerates the body, absorbs the energy of impact, and is not part of a stride.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>alighting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">landing</oboInOwl:hasExactSynonym>
        <rdfs:label>landing regime</rdfs:label>
        <skos:example>&quot;After alighting on land, wild geese usually shake, normally within 10 to 80 seconds in the case of White-fronted Geese.&quot;</skos:example>
        <skos:scopeNote>&quot;In prehensile-tailed New World monkeys landing may be aided by tail grips.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Quadrupedal landing: Both forelimbs and hindlimbs decelerate the body by flexion, with only a slight difference between the time of contact of fore- and hindlimbs, usually the forelimbs contact first. Not followed by a suspensory bout.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000239"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Interfacing-regime that follows a period of suspension, decelerates the body, absorbs the energy of impact, and is not part of a stride.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000239"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>alighting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
