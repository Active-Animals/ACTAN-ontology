        <owl:annotatedTarget>lateral display</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2008</dc:date>
        <dc:source>doi:10.1007/s10682-007-9183-7</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000539"/>
