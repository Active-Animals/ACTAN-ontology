    <!-- http://purl.obolibrary.org/obo/ACTAN_0000807 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000807">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000399"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MF_0000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-20T07:40:27.028903Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Inspection that involves temporarily raising the head.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">head-high</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">head-high inspection</rdfs:label>
        <skos:scopeNote>&quot;Immediately after landing the birds tends to be alert, standing with heads high.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000807"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Inspection that involves temporarily raising the head.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
