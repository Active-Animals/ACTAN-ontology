        <dc:source>doi:10.1580/1080-6032(1996)007[0038:USCS]2.3.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000100"/>
