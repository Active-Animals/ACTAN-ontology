                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000056"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-30T07:16:57.82809Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Skip gait that is asymmetric, quadrupedal, and combines a forelimb and hindlimb skip in each stride.

In each stride, a slow gallop has no suspension, a moderate gallop has a gathered suspension, and a fast gallop may have both a gathered and an extended suspension.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">gallop</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">gallop gait</rdfs:label>
        <skos:example>Monty Python&apos;s Holy Grail contains a wonderful scene involving a horseless knight, with added coconut shells, unilaterally skipping one half of a triple beat gallop.</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000207"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Skip gait that is asymmetric, quadrupedal, and combines a forelimb and hindlimb skip in each stride.

In each stride, a slow gallop has no suspension, a moderate gallop has a gathered suspension, and a fast gallop may have both a gathered and an extended suspension.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1098/rspb.1998.0424</dc:source>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000207"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">gallop</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000207"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">gallop gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000207"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>Monty Python&apos;s Holy Grail contains a wonderful scene involving a horseless knight, with added coconut shells, unilaterally skipping one half of a triple beat gallop.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000124"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000091"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000199"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000056"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-30T07:17:19.834574Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Stepping gait that is bouncing and suspended, with an asymmetric quadrupedal gait, in which the two hind footfalls are simultaneous, the two fore footfalls are simultaneous, and the timings of the footfalls of the fore and hindfoot pairs are not simultaneous.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">bound</oboInOwl:hasExactSynonym>
        <rdfs:label>bound gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000208"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Stepping gait that is bouncing and suspended, with an asymmetric quadrupedal gait, in which the two hind footfalls are simultaneous, the two fore footfalls are simultaneous, and the timings of the footfalls of the fore and hindfoot pairs are not simultaneous.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
        <skos:scopeNote>&quot;Bound
A quadrupedal gait characterized by (1) synchronous IntraPAP, (2) the two hind footfalls are simultaneous (the timings of the hindfoot footfalls differ by no more than 10% of the entire gait cycle), (3) the two fore footfalls are simultaneous (the timings of the forefoot footfalls differ by no more than 10% of the entire gait cycle), and (4) but the timings of the footfalls of the fore and hindfoot pairs are not simultaneous.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000208"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">bound</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.2307/1379571</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000208"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>bound gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000124"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000091"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000199"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000056"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-30T07:17:55.916173Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Stepping gait that is bouncing and suspended, with an asymmetric quadrupedal gait, with simultaneous hindlimb footfalls, and the timings of the forefoot footfalls differ by more than 10% of the entire gait cycle.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>half bound</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>half-bounding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">halfbound</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">half-bound gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000209"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Stepping gait that is bouncing and suspended, with an asymmetric quadrupedal gait, with simultaneous hindlimb footfalls, and the timings of the forefoot footfalls differ by more than 10% of the entire gait cycle.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
        <skos:scopeNote>&quot;Half-bound
A quadrupedal gait characterized by (1) synchronous IntraPAP, (2) simultaneous hindlimb footfalls(the timings of the hindfoot footfalls differ by no more than 10% of the entire gait cycle), and (3) an evident fore lead (the timings of the forefoot footfalls differ by more than 10% of the entire gait cycle).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000209"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>half bound</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.2307/1379571</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000209"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>half-bounding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000209"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">halfbound</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.2307/1379571</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000209"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">half-bound gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000210 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000210">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000124"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-30T09:05:26.737584Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Stepping gait in which a component of the energy recovery is based on the pendulum-like mechanism, the other being generated by elastic energy release.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">skipping</oboInOwl:hasExactSynonym>
        <rdfs:label>skip gait</rdfs:label>
        <skos:example>&quot;Bipeds such as some birds (rook walk and hop), jerboas, and lemurs (Sifaka hop) for instance, use skipping.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000210"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Stepping gait in which a component of the energy recovery is based on the pendulum-like mechanism, the other being generated by elastic energy release.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1098/rspb.1998.0424</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;As I will discuss, only a component of the energy recovery in S is based on the pendulum-like mechanism, the other being generated by elastic energy release (at a non-symmetrical phase of the stance with respect to the storage).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000210"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">skipping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>doi:10.1098/rspb.1998.0424</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000210"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>skip gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000210"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Bipeds such as some birds (rook walk and hop), jerboas, and lemurs (Sifaka hop) for instance, use skipping.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1098/rspb.1998.0424</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000693"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001023"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-30T09:05:35.894266Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>pendulum</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Leverage that moves the body up and over each stiff leg in an arc, analogous to an inverted pendulum, transforming kinetic energy in the first half of the stance phase into gravitational potential energy, which is partially recovered as the animal’s body falls forward and downward in the second half of the stance phase.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>inverted pendulum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">vaulting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>pivoting</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">vaulting leverage</rdfs:label>
        <skos:scopeNote>&quot;Vaulting over stiffened legs results in up to a 70 % conservation in energy that would otherwise have to be provided by muscles and tendons.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000211"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>pendulum</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000211"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Leverage that moves the body up and over each stiff leg in an arc, analogous to an inverted pendulum, transforming kinetic energy in the first half of the stance phase into gravitational potential energy, which is partially recovered as the animal’s body falls forward and downward in the second half of the stance phase.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1126/science.288.5463.100</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;When animals walk, the body vaults up and over each stiff leg in an arc, analogous to an inverted pendulum (Fig. 1B). Kinetic energy in the first half of the stance phase is transformed into gravitational potential energy, which is partially recovered as the animal’s body falls forward and downward in the second half of the stance phase.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000211"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>inverted pendulum</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000211"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">vaulting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000211"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>pivoting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1987</dc:date>
        <dc:source>doi:10.1242/jeb.130.1.155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000211"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">vaulting leverage</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000211"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Vaulting over stiffened legs results in up to a 70 % conservation in energy that would otherwise have to be provided by muscles and tendons.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.130.1.155</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000212 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000210"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000091"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000199"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000211"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000054"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-30T09:15:46.482074Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Skip gait that involves asymmetric bipedal skipping, and in which one foot is always forward, landing with the trailing foot just a fraction of a second before the leading foot, and pushing off with each foot as it hits.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">unilateral skipping</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">unilateral-skip gait</rdfs:label>
        <skos:example>Monty Python&apos;s Holy Grail contains a wonderful scene involving a horseless knight, with added coconut shells, unilaterally skipping one half of a triple beat (transverse) gallop.</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000212"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Skip gait that involves asymmetric bipedal skipping, and in which one foot is always forward, landing with the trailing foot just a fraction of a second before the leading foot, and pushing off with each foot as it hits.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1098/rspb.1998.0424</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000212"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">unilateral skipping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>doi:10.1098/rspb.1998.0424</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000212"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">unilateral-skip gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000212"/>
