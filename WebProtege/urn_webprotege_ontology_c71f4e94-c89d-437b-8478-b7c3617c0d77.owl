                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-06T15:15:06.355292Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Ethotype that involves a male revolving around a female in a gliding motion, head and thorax leading the change of direction with abdomen bent at an angle.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>circling mating characteristic</oboInOwl:hasExactSynonym>
        <rdfs:comment>If a relevant ontology is developed, this would become a subtype of a mating ethotype.</rdfs:comment>
        <rdfs:label>circling ethotype</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000264"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Ethotype that involves a male revolving around a female in a gliding motion, head and thorax leading the change of direction with abdomen bent at an angle.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/j.1420-9101.2009.01826.x</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;...exclusively precopulatory&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;‘Circling’ - 0: Absent (Male approach without gliding motion); 1: Present (Male circling female in a gliding motion, head and thorax leading the change of direction with abdomen bent at an angle).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000264"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>circling mating characteristic</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
