        <owl:annotatedTarget>wing-beat</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000765"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Wing-shaking is given by White-fronted Geese, Bar-headed Geese, and Barnacle Geese while threatening with the head and neck stretched out toward and opponent.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
