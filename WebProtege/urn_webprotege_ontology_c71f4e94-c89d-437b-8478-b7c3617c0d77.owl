        <oboInOwl:ontology>TAO</oboInOwl:ontology>
        <oboInOwl:source>ZFIN:curator</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001555"/>
