    <!-- http://purl.obolibrary.org/obo/ACTAN_0000968 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000968">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000726"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFA_0000622"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-07T08:14:06.921452Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Extending that involves a barbel.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>barbel lowering</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">barbel extending</rdfs:label>
        <skos:example>&quot;The striped red mullet, Mullus surmuletus, is a benthic feeding goatfish species that uses its barbels to detect and excavate invertebrates from the substrate.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000968"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Extending that involves a barbel.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Contraction of the muscle to the upper ligament lowers the barbel whereas contraction of the muscle to the lower ligament retracts the barbel.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000968"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>barbel lowering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1984</dc:date>
        <dc:source>https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download</dc:source>
        <skos:scopeNote>&quot;...lowers the barbel...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000968"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">barbel extending</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000968"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The striped red mullet, Mullus surmuletus, is a benthic feeding goatfish species that uses its barbels to detect and excavate invertebrates from the substrate.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.anbehav.2026.123487</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000969 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000969">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000732"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFA_0000622"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-07T09:39:07.31639Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flexing that involves a barbel.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>barbel folding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>barbel raising</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>barbel retracting</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">barbel flexing</rdfs:label>
        <skos:example>&quot;When a goatfish is not feeding, the barbels are folded back under the rims of the chin and gill covers.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000969"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flexing that involves a barbel.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Contraction of the muscle to the upper ligament lowers the barbel whereas contraction of the muscle to the lower ligament retracts the barbel.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000969"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>barbel folding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1984</dc:date>
        <dc:source>https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download</dc:source>
        <skos:scopeNote>&quot;...barbels are folded...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000969"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>barbel raising</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1984</dc:date>
        <dc:source>https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download</dc:source>
        <skos:scopeNote>&quot;...raise or lower the barbel...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000969"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>barbel retracting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1984</dc:date>
        <dc:source>https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download</dc:source>
        <skos:scopeNote>&quot;...retracts the barbel.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000969"/>
