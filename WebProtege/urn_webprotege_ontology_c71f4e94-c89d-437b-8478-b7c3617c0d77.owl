    <!-- http://purl.obolibrary.org/obo/ACTAN_0000546 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000304"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0015027"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-26T09:35:59.534071Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>exceptionally slow movement</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Kinetics that is characterized by very slow speeds, and static stability at all times.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>creep</oboInOwl:hasExactSynonym>
        <rdfs:label>creep kinetics</rdfs:label>
        <skos:example>&quot;Chimpanzee...
a fearful subordinate tries to creep from the vicinity of a particular higher ranking individual. The subordinate proceeds with extreme caution, moving slowly while keeping a constant sharp watch on the other...&quot;</skos:example>
        <skos:scopeNote>&quot;Zebrafish... creeping... represent passive slow sliding... without use of fins...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000546"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>exceptionally slow movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000546"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics that is characterized by very slow speeds, and static stability at all times.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/icac125</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;A broad category of walking-like locomotion characterized by (1) very slow speeds, (2) minimal excursions of the COM in directions other than the forward direction, (3) three points of contact with the ground at any given time forming a polygonal Support Pattern, (4) the vertical projection of the COM onto the surface that lies within its Support Pattern at the given time, and (5) has static stability at all times,meaning the animal could halt movement and remain stable at any point in time.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000546"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>creep</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000546"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>creep kinetics</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000546"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Chimpanzee...
a fearful subordinate tries to creep from the vicinity of a particular higher ranking individual. The subordinate proceeds with extreme caution, moving slowly while keeping a constant sharp watch on the other...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000546"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Zebrafish... creeping... represent passive slow sliding... without use of fins...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000547 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000752"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000546"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-26T09:55:01.679492Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Translocation that involves very low speeds.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">creeping</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">creeping translocation</rdfs:label>
        <skos:example>&quot;Zebrafish... Creeping: Very slow swimming during which only the pectoral fins propel the fish forward;&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000547"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Translocation that involves very low speeds.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://apps.dtic.mil/sti/html/tr/AD0675256/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000547"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">creeping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1968</dc:date>
