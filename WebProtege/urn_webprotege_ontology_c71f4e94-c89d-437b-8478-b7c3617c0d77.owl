    <!-- http://purl.obolibrary.org/obo/ACTAN_0000988 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000988">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000047"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002374"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-20T08:07:54.370684Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Formation which dynamically fluctuates between forms of aggregation and dis-aggregation.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>fission and fusion grouping pattern</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fission–fusion dynamics</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">fission-fusion formation</rdfs:label>
        <skos:scopeNote>&quot;...within-group conflicts of interest – differences in the optimal decision, such as when to leave a food patch, among group members – drive group fission. Applying optimal foraging theory predicts that conflicts of interest decrease as environmental conditions become harsh, an explanation for the paradox of why large aggregations of animals can be observed when resources are scarce.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000988"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Formation which dynamically fluctuates between forms of aggregation and dis-aggregation.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1111/brv.12934</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000988"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>fission and fusion grouping pattern</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000988"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>fission–fusion dynamics</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>doi:10.1111/brv.12934</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000988"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">fission-fusion formation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000988"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...within-group conflicts of interest – differences in the optimal decision, such as when to leave a food patch, among group members – drive group fission. Applying optimal foraging theory predicts that conflicts of interest decrease as environmental conditions become harsh, an explanation for the paradox of why large aggregations of animals can be observed when resources are scarce.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/brv.12934</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000989 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000989">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000288"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002107"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-20T09:07:07.589164Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>outskirts</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>periphery</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Relativity in which an animal is positioned on the edge of an aggregation.</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>peripheral male</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">periphery relativity</rdfs:label>
        <skos:example>&quot;Chimpanzee...
...the female is taken to a peripheral part of the community range away from other rival males.&quot;</skos:example>
        <skos:example>&quot;For example, female elephant seals that are leaving the harems of dominant bulls readily accept mating attempts by peripheral males and appear to reduce the risks of being injured by doing so.&quot;</skos:example>
        <skos:example>&quot;In Nephila spp., for example, large males displace smaller ones towards the periphery of the web.&quot;</skos:example>
        <skos:scopeNote>&quot;...&quot;satellite&quot; males which sneak copulations on the periphery of dominant-male territories...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Individuals that prefer to use their left eye to view school mates tend to prefer positions on the right side of the school, while the reverse is true for those who prefer to view school mates with the right eye. In this way, a school might be comprised of an optimal number of fish with various degrees of laterality. Such a school would show faster responses to predators and prey on the periphery of the school while simultaneously rapidly responding to the behaviour of their school mates.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000989"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>outskirts</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000989"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>periphery</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000989"/>
