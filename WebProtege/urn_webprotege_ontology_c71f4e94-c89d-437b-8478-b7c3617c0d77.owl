    <!-- http://purl.obolibrary.org/obo/ACTAN_0000111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000108"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000739"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-05-10T15:31:50.888384Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Membership that is place-based, relatively dense, and mutually interdependent.

It may even involve integration approaching that of cells in a multicellular organism, and  different roles for different members.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym>colony</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">colony membership</rdfs:label>
        <skos:example>&quot;Hovering fishes may form aggregations with colonies of burrows found in some regions of the reef, or adjacent habitats.&quot;</skos:example>
        <skos:example>&quot;Unlike many colonial birds, .notably ground-nesting marine species, A. ibis nests are not built a more or less fixed distance from the nearest neighbour&apos;s, resulting in a uniformly dense colony. Instead, the inter-nest distance (between nest centres) at the time of building varies from 50 cm. to 6 metres, with some new nests continuing to fill in the larger gaps for.the entire duration of nest commencement.&quot;</skos:example>
        <skos:example>&quot;We found that individual corals did not participate in every annual spawning event but the same individual colony of Acropora digitifera could spawn in multiple months and nights. In context of seasonality, the breeding period seems to be a result of differential rates of gamete development. That is, gametes within a colony are ready to spawn at different times but the majority of the gametes in individual corals spawn on a single night.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000111"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Membership that is place-based, relatively dense, and mutually interdependent.

It may even involve integration approaching that of cells in a multicellular organism, and  different roles for different members.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000111"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>colony</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000111"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">colony membership</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000111"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Hovering fishes may form aggregations with colonies of burrows found in some regions of the reef, or adjacent habitats.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000111"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Unlike many colonial birds, .notably ground-nesting marine species, A. ibis nests are not built a more or less fixed distance from the nearest neighbour&apos;s, resulting in a uniformly dense colony. Instead, the inter-nest distance (between nest centres) at the time of building varies from 50 cm. to 6 metres, with some new nests continuing to fill in the larger gaps for.the entire duration of nest commencement.&quot;</owl:annotatedTarget>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000111"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;We found that individual corals did not participate in every annual spawning event but the same individual colony of Acropora digitifera could spawn in multiple months and nights. In context of seasonality, the breeding period seems to be a result of differential rates of gamete development. That is, gametes within a colony are ready to spawn at different times but the majority of the gametes in individual corals spawn on a single night.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/bc60659126ef5c0172c2392d485b0c9b/1?pq-origsite=gscholar&amp;cbl=18750</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MFOEM_000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-05-19T07:36:28.876431Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Influence which works against the adverse effects of worsened conditions.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>buffering</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">buffering influence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000112"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Influence which works against the adverse effects of worsened conditions.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>NB: This class relates to active behaviours, not passive environmental effects such as passive temperature buffering caused by a nest in sunlight for example.</rdfs:comment>
        <rdfs:isDefinedBy>doi:10.1016/j.anbehav.2011.01.007</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Taken together, the studies reviewed here suggest that under fitness challenge, play may (1) giveway to behaviours that are more urgent because of their immediate fitness consequences, (2) increase because it buffers an animal against the adverse effects of worsened conditions now or in the future, or (3) be suppressed initially but increase above baseline under rebound later.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000112"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>buffering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2008</dc:date>
        <dc:source>doi:10.1016/j.anbehav.2007.09.028</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000112"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">buffering influence</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-17T13:42:31.003475Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that involves mouth opening and closing, with physical contact.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>bite</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>nipping</oboInOwl:hasNarrowSynonym>
        <rdfs:label>bite kinetics</rdfs:label>
        <skos:closeMatch>NBO:0000017</skos:closeMatch>
        <skos:example>&quot;Courtship displays of R. decemdigitatus consisted of 11 steps: ... (ix) biting of the female and swimming into her...&quot;</skos:example>
        <skos:example>&quot;Larger snakes have better venom delivery systems and can first warn a predator. If the predator does not respond to the aposematic signal, they can deliver a few effective bites, then cover up their heads and withstand a brief attack while they wait for the envenomation to repel the attacker.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000113"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics that involves mouth opening and closing, with physical contact.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Bite (biting): Quick movement towards target, with mouth opening and closing, with physical contact.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000113"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>bite</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000113"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>nipping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000113"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>bite kinetics</owl:annotatedTarget>
        <dc:source>https://orcid.org/0000-0002-4277-2151</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000113"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Courtship displays of R. decemdigitatus consisted of 11 steps: ... (ix) biting of the female and swimming into her...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10682-007-9183-7</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000113"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Larger snakes have better venom delivery systems and can first warn a predator. If the predator does not respond to the aposematic signal, they can deliver a few effective bites, then cover up their heads and withstand a brief attack while they wait for the envenomation to repel the attacker.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
