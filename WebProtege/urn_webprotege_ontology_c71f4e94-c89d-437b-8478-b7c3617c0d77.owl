    <!-- http://purl.obolibrary.org/obo/ACTAN_0000105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000102"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002416"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-04-21T09:45:33.941801Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Autogroom-routine that conditions a surface structure.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>waterproofing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">waterproofing routine</rdfs:label>
        <skos:scopeNote>&quot;I have seen... individual ducks which had lost the waterproofing quality of their breast feathers, through being in poor condition.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The finely distributed air enclosed between the barbules of the feathers seems to be the main factor in waterproofing but oiling is important indirectly as it helps to maintain feather structure.Elder&apos;s experiments, involving removal of the oil gland from Mallards and Redheads, indicate that the secretion is effective also in maintaining the surface structure of the bill and legs.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000105"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Autogroom-routine that conditions a surface structure.</owl:annotatedTarget>
