    <!-- http://purl.obolibrary.org/obo/ACTAN_0000508 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000174"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002397"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-12-28T20:48:41.246196Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Turning in which the body slowly curves to change its orientation by approximately 180 degrees.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>O-bend</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>omega bend</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">omega turn</oboInOwl:hasExactSynonym>
        <rdfs:label>O turning</rdfs:label>
        <skos:scopeNote>&quot;Therefore, by markedly up-regulating speed and omega turn rates, starved worms at 25 °C are in a state enabling both local and global search, which we will call glocal search.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;When C. elegans animals are removed from food, they display a stereotyped sequence of two consecutive locomotion states. For the first 15 min, they engage in a local search state (also called “area-restricted search”) consisting of a high frequency of high-angle turns and omega bends.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000508"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Turning in which the body slowly curves to change its orientation by approximately 180 degrees.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000508"/>
