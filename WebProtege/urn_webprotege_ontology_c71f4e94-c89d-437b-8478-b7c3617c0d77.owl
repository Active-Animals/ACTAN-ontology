    <!-- http://purl.obolibrary.org/obo/ACTAN_0000779 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000779">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000815"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000780"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-05T16:47:33.439289Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Wash routine in which the nasal passages are moistened, and cleared by blowing.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">nostril blowing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>bill-cleaning</oboInOwl:hasNarrowSynonym>
        <rdfs:label>nose-blow routine</rdfs:label>
        <skos:example>&quot;(Dipping the head under water and blowing out through the nostrils occurs in hostile situations in the Whooper Swan and Trumpeter Swan, but I have not seen the movements repeated rhythmically; possibly these are cases of hostile &quot;hissing&quot; performed under-water).&quot;</skos:example>
        <skos:example>&quot;The bill is almost completely submerged in the water and then the head is jerked back slightly as air is blown out through the nostrils making a staccato noise... I have seen bill-cleaning in all tribes except the Oxyurini... Perhaps the nasal passages are more effectively cleaned when the bill is dipped in water, pressure being built up as air is forced through the nares.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000779"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Wash routine in which the nasal passages are moistened, and cleared by blowing.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000779"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">nostril blowing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
        <skos:scopeNote>&quot;...air is blown out through the nostrils...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000779"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>bill-cleaning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000779"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>nose-blow routine</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000779"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;(Dipping the head under water and blowing out through the nostrils occurs in hostile situations in the Whooper Swan and Trumpeter Swan, but I have not seen the movements repeated rhythmically; possibly these are cases of hostile &quot;hissing&quot; performed under-water).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000779"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The bill is almost completely submerged in the water and then the head is jerked back slightly as air is blown out through the nostrils making a staccato noise... I have seen bill-cleaning in all tribes except the Oxyurini... Perhaps the nasal passages are more effectively cleaned when the bill is dipped in water, pressure being built up as air is forced through the nares.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000780 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000780">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000715"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-05T16:49:29.328646Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Expulsion in which air is forced out of a head orifice, with controlled timing and intensity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">blowing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">blow expulsion</rdfs:label>
        <skos:example>&quot;...elephants can blow air to push objects that are just beyond reach and modulate the air jet on a wall to draw objects closer to themselves.&quot;</skos:example>
        <skos:example>&quot;Alaskan humpback whales (Megaptera novaengliae), when hunting Pacific herring, sometimes work as a team to perform two basic subtasks: prey herding and bubble blowing.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000780"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Expulsion in which air is forced out of a head orifice, with controlled timing and intensity.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000780"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">blowing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000780"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">blow expulsion</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
