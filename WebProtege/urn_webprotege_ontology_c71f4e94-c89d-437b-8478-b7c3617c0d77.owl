    <!-- http://purl.obolibrary.org/obo/ACTAN_0000751 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000751">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-06-30T14:37:43.83941Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Behaviour that occurs in a particular setting, situation or circumstance.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">context</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>functional-context</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>situation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>current utility</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>survival value</oboInOwl:hasRelatedSynonym>
        <rdfs:label>context behaviour</rdfs:label>
        <skos:example>&quot;The Elephant Ethogram:
Context:
Advertisement &amp; Attraction:
Behaviors employed by adult males and adult females in the advertisement of sexual state and the attraction of, and search for, mates.&quot;</skos:example>
        <skos:scopeNote>&quot;Animals often differ from one another in their willingness to take risks in a number of functional contexts related to fitness (e.g. mating, dispersal, and foraging behaviour).&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000751"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Behaviour that occurs in a particular setting, situation or circumstance.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.69649/pachyderm.v62i.462</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;A Context refers to the particular setting, situation or circumstances in which a Behaviour or Constellation occurs.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000751"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
