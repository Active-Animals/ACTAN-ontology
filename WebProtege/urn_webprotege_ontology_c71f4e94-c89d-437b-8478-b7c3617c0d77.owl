        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000927"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Nocomis leptocephalus...
Dissociation. The spawning clasp was completed in about a second and the pair immediately separated.&quot;</owl:annotatedTarget>
