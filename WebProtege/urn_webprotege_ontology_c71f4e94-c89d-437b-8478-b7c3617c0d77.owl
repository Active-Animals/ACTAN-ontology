        <oboInOwl:hasDefinition>Run gait that is diagonal-sequence, diagonal-couplet, and bouncing.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">DSDC run</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>diagonal-sequence, diagonal-couplet run</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">DSDC-run gait</rdfs:label>
        <skos:example>&quot;This gait is typified by the running of the duiker.&quot;</skos:example>
