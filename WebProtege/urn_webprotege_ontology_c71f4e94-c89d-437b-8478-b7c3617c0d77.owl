    <!-- http://purl.obolibrary.org/obo/ACTAN_0000828 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000828">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000108"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-09T13:56:01.280512Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Membership that involves an association between two animals.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">dyad</oboInOwl:hasExactSynonym>
        <rdfs:label>dyad membership</rdfs:label>
        <skos:scopeNote>&quot;...in dyadic fights male zebrafish express highly structured behavior and the outcome of these fights has an impact on their subsequent behavior.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;...many avian researchers apply the term to same-sex dyads...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000828"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Membership that involves an association between two animals.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1016/j.yhbeh.2021.105062</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;For example, pair bonding is often conflated with “pair living”, or even the simple observation of a physical association between two animals.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000828"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">dyad</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2011</dc:date>
        <dc:source>doi:10.1089/zeb.2011.0690</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000828"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>dyad membership</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000828"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...in dyadic fights male zebrafish express highly structured behavior and the outcome of these fights has an impact on their subsequent behavior.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2011.0690</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000828"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...many avian researchers apply the term to same-sex dyads...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.yhbeh.2021.105062</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000829 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000409"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000828"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000498"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-09T13:56:15.464199Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Participation which is selective and exclusive to mature partners and maintained across time.

The relationship MUST be between two sexually mature individuals, last longer than one reproductive cycle, and display strong, partner-restricted behaviours such as territoriality or mate guarding.

They MAY participate in sexual behavior with each other, co-parent, and participate in a coordinated activity together.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>pair living</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">pairing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>bonding</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pair bonding</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pairing participation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000465"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <skos:example>&quot;Whipcoral gobies in the genus Bryaninops are habitat-specialists that live in male-female pairs...&quot;</skos:example>
        <skos:example>&quot;Wood-feeding cockroaches (Salganea taiwanensis) mate and live as pairs; quite notably, after choosing a mate, paired cockroaches chew off each other’s wing. After cannibalizing their pair mate’s non-fleshy wings, paired individuals mate and produce multiple cycles of offspring that are cared for by both parents. Paired woodfeeding cockroaches mate with each other exclusively and for life.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Participation which is selective and exclusive to mature partners and maintained across time.

The relationship MUST be between two sexually mature individuals, last longer than one reproductive cycle, and display strong, partner-restricted behaviours such as territoriality or mate guarding.

They MAY participate in sexual behavior with each other, co-parent, and participate in a coordinated activity together.</owl:annotatedTarget>
        <rdfs:comment>Bear in mind that the definition is essentially that of pair-bonding minus its affective components.</rdfs:comment>
        <rdfs:isDefinedBy>doi:10.1016/j.yhbeh.2021.105062</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Further, a pair bond must endure for a biologically relevant duration of time: we propose that in order to be considered a pair bond, the relationship between two individuals must last longer than one reproductive cycle [e.g., prairie vole, sleepy lizards]. In addition to duration, we posit that pair bonds must have some degree of strength or quality that is measurable, that both individuals must be sexually mature, and that the bond must be specific to a particular individual. Specificity refers to the display of certain behaviors restricted to the pair-bonded partner, including but not limited to territoriality/mate guarding [e.g., cichlids, titi monkeys, albatrosses], separation distress [e.g. titi monkey], partner preference [e.g., titi monkeys, prairie voles], and stress buffering [e.g., titi monkey], which are displayed in association with the chosen partner rather than indiscriminately among conspecifics...

However, the pair must display behavior that is, at minimum, selective and exclusive to a partner and maintained in some way across time and reflective of an affective component to the relationship. It is this last component that is often missing from non-mammalian definitions of pair bonding;&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pair living</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:date>
        <dc:source>doi:10.1016/j.yhbeh.2021.105062</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">pairing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>bonding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>pair bonding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>pairing participation</owl:annotatedTarget>
        <dc:date>https://orcid.org/0000-0002-4277-2151</dc:date>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Whipcoral gobies in the genus Bryaninops are habitat-specialists that live in male-female pairs...&quot;</owl:annotatedTarget>
        <dc:source>https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Wood-feeding cockroaches (Salganea taiwanensis) mate and live as pairs; quite notably, after choosing a mate, paired cockroaches chew off each other’s wing. After cannibalizing their pair mate’s non-fleshy wings, paired individuals mate and produce multiple cycles of offspring that are cared for by both parents. Paired woodfeeding cockroaches mate with each other exclusively and for life.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.yhbeh.2021.105062</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000830 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000830">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000829"/>
        <rdfs:subClassOf rdf:nodeID="genid6256"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MFOEM_000195"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-09T13:56:38.49968Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Pairing that is reflective of an affective component.

This may relate to motivation, stress, or reward, with measurable separation distress, partner preference, and specific stress buffering.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">pair bonding</oboInOwl:hasExactSynonym>
        <rdfs:label>bonding pairing</rdfs:label>
        <skos:example>&quot;Zebra finches have been studied in a wide range of paradigms that have both observationally and experimentally determined that they demonstrate strongly coordinated pair behavior and mate-guarding, preference for the familiar partner, and distress upon separation from the partner.&quot;</skos:example>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid6256">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000447"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000830"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid6256"/>
        <dc:source>doi:10.1016/j.yhbeh.2021.105062</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000830"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Pairing that is reflective of an affective component.

This may relate to motivation, stress, or reward, with measurable separation distress, partner preference, and specific stress buffering.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1016/j.yhbeh.2021.105062</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;However, the pair must display behavior that is, at minimum, selective and exclusive to a partner and maintained in some way across time and reflective of an affective component to the relationship. It is this last component that is often missing from non-mammalian definitions of pair bonding; however, we would argue that a relationship cannot be called a pair bond without some level of engagement of affective systems, whether those be related to motivation, stress, reward, or all of the above. Otherwise, it is difficult to imagine to what the word “bond” is actually referring.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000830"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">pair bonding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000830"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>bonding pairing</owl:annotatedTarget>
        <dc:source>https://orcid.org/0000-0002-4277-2151</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000830"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Zebra finches have been studied in a wide range of paradigms that have both observationally and experimentally determined that they demonstrate strongly coordinated pair behavior and mate-guarding, preference for the familiar partner, and distress upon separation from the partner.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.yhbeh.2021.105062</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000831 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000831">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000829"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000898"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000083"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-10T10:17:52.648537Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Pairing that includes all occurrences from the first meeting of the future partners until a definite sexual bond has been established that can only be broken by the appearance of abnormal conditions.

In some genera, this is the prelude to eventual pair bonding.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">pair formation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>mate changing</oboInOwl:hasNarrowSynonym>
        <rdfs:label>formation pairing</rdfs:label>
        <skos:example>&quot;For example, Willis wrote of early pair formation in Bicolored Antbirds, “She seemed to push him backward in her cringing advance . . . ,” and continued that the male, having been forced off his perch, then went and brought the female some food.&quot;</skos:example>
        <skos:example>&quot;Laetacara araguaiae is a small cichlid species...

The establishment of territory by males preceded pair formation. Adult males established territories and defended them with attacks and threats against intruder fish, especially of conspecific ones. Each male was observed defending only one territory. Pairs were assumed to be formed when female also engaged in territorial defense. After that, male and female alternated among courtship behaviors, nest digging and territorial defense.&quot;</skos:example>
        <skos:scopeNote>&quot;In birds with a long period between pair formation and copulation, displays preceding copulation need not be as specific as those in birds in which copulation occurs at the initial meeting.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Preen-behind-wing occurs in many species during the period of pair-formation...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000831"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Pairing that includes all occurrences from the first meeting of the future partners until a definite sexual bond has been established that can only be broken by the appearance of abnormal conditions.

In some genera, this is the prelude to eventual pair bonding.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;; we think it better to consider as pair formation all occurrences from the first meeting of the future partners until a definite sexual bond has been established that can only be broken by the appearance of abnormal conditions.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000831"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">pair formation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000831"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>mate changing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000831"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>formation pairing</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000831"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;For example, Willis wrote of early pair formation in Bicolored Antbirds, “She seemed to push him backward in her cringing advance . . . ,” and continued that the male, having been forced off his perch, then went and brought the female some food.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.2307/1367395</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000831"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Laetacara araguaiae is a small cichlid species...

The establishment of territory by males preceded pair formation. Adult males established territories and defended them with attacks and threats against intruder fish, especially of conspecific ones. Each male was observed defending only one territory. Pairs were assumed to be formed when female also engaged in territorial defense. After that, male and female alternated among courtship behaviors, nest digging and territorial defense.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1590/S1679-62252011005000018</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000831"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In birds with a long period between pair formation and copulation, displays preceding copulation need not be as specific as those in birds in which copulation occurs at the initial meeting.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000831"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Preen-behind-wing occurs in many species during the period of pair-formation...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000832 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000832">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000829"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000414"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000465"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-10T16:01:46.190802Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Pairing that involves mutual signaling.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>affiliation signaling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">pair-displaying</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>greeting ceremony</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>nest relief</oboInOwl:hasNarrowSynonym>
        <rdfs:label>affiliation pairing</rdfs:label>
        <skos:example>&quot;A female Chiloe Wigeon, alone on the water, gave a loud descrescendo call; immediately a male appeared from behind some reeds and swam toward the female. On meeting, the female performed a Preen and a few seconds later it was given by the male. The two swam away together.&quot;</skos:example>
        <skos:example>&quot;One of the displays of the Andean Goose involves lifting the wings to form an arch over the back. While calling loudly and lifting the wings in this way, both male and female repeatedly give rapid bursts of Tail-wagging.&quot;</skos:example>
        <skos:example>&quot;Pair-bonded fish exhibit several affiliative behaviors. In cichlids, pair-bonded individuals display parallel swimming, tail beating, circling, greeting, and affiliative bites.&quot;</skos:example>
        <skos:narrowMatch>NBO:0020071</skos:narrowMatch>
        <skos:scopeNote>&quot;...the stereotyped movements preceding &quot;nest relief&quot; of one member of a breeding pair by another in birds... function to regulate or coordinate cooperation between the sexes.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The members of a pair may give Preen-behind-wing in several situations. It often occurs when the birds meet after a separation... Another situation is after a hostile encounter... At other times, the display is given by birds which are resting or preening normally side by side... Preen-behind-wing occurs in many species... while the bond is becoming stronger.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000832"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Pairing that involves mutual signaling.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000832"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>affiliation signaling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:date>
        <dc:source>doi:10.1016/j.yhbeh.2021.105062</dc:source>
        <skos:scopeNote>&quot;...higher rates of affiliation relative to aggression signaling...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000832"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">pair-displaying</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000832"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>greeting ceremony</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000832"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>nest relief</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000837"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000832"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>affiliation pairing</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
