    <!-- http://purl.obolibrary.org/obo/ACTAN_0000247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000733"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002415"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-05T15:13:26.460572Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Coil that has ventral support, a raised head, an antrorse, sinuous anterior, a coiled medio-posterior, and a raised tail.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">S-coil</oboInOwl:hasExactSynonym>
        <rdfs:label>elevated-S coil</rdfs:label>
        <skos:example>&quot;The evolution of an aposematic function for the rattle and associated stereotyped behavior such as the elevated S-coil appears to be linked to the coevolution of increased body size in rattlesnakes.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000247"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Coil that has ventral support, a raised head, an antrorse, sinuous anterior, a coiled medio-posterior, and a raised tail.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000247"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">S-coil</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000247"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>elevated-S coil</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000247"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The evolution of an aposematic function for the rattle and associated stereotyped behavior such as the elevated S-coil appears to be linked to the coevolution of increased body size in rattlesnakes.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000248 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000177"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000120"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/posture"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-06T08:47:55.405279Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Posture in which the body weight is borne solely by the feet/foot, with some supporting knees or elbows strongly flexed.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>crouch</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">crouching</oboInOwl:hasExactSynonym>
        <rdfs:label>crouch posture</rdfs:label>
        <skos:example>&quot;Pan troglodytes...
Crouch was rare (&lt; 1% of all behavior)... in this behavior the individual stood quadrupedally on a relatively flat stratum with the elbows flexed. Rarely the knees also were slightly flexed.&quot;</skos:example>
        <skos:example>&quot;Several of the American Robins, performing active anting, sometimes crouched, rotated or rubbed the body or breast upon the ground, or sat as if holding vent to ground.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000248"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Posture in which the body weight is borne solely by the feet/foot, with some supporting knees or elbows strongly flexed.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000248"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>crouch</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000248"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">crouching</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000248"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>crouch posture</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000248"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Several of the American Robins, performing active anting, sometimes crouched, rotated or rubbed the body or breast upon the ground, or sat as if holding vent to ground.&quot;</owl:annotatedTarget>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000189"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002445"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-15T11:18:51.595313Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>plane positioning</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Lift which is generated due to deflection of the fluid and pressure difference between the two surfaces, when canted at an angle to the flow.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>lifting hydrofoil</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">foil lift</rdfs:label>
        <skos:example>&quot;In... the Triglidae, the pectorals are used as gliding planes and... in... the Dactylopteridae, they are carried a step further and the fishes rise from the surface of the water by means of their large “wings, ” somewhat after the manner of the exocoetids, but less successfully.&quot;</skos:example>
        <skos:scopeNote>&quot;Fish swimming in the thunniform mode are characterized by a stiff caudal fin, shaped like a tapered hydrofoil of a moderate sweepback angle with a curved leading edge and a sharp trailing edge. The caudal fin performs a combination of pitching and heaving motions, tracing an oscillating path as the fish moves forward...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;an appropriate movement of the pectorals can deflect a moving fish from a straight line to the right or left so may they by proper twisting cause it to move diagonally upwards or downwards...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000249"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>plane positioning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...position as planes...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000249"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Lift which is generated due to deflection of the fluid and pressure difference between the two surfaces, when canted at an angle to the flow.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www-dr.wcupa.edu/sciences-mathematics/biology/fFish/documents/1998ImaginativeDragReduction.pdf</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;When the hydrofoil is canted at an angle to the water flow (i.e,, angle of attack), a lift is generated due to deflection of the fluid and pressure difference between the two surfaces of the hydrofoil.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000249"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>lifting hydrofoil</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>https://www-dr.wcupa.edu/sciences-mathematics/biology/fFish/documents/1998ImaginativeDragReduction.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000249"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">foil lift</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000249"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In... the Triglidae, the pectorals are used as gliding planes and... in... the Dactylopteridae, they are carried a step further and the fishes rise from the surface of the water by means of their large “wings, ” somewhat after the manner of the exocoetids, but less successfully.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000249"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Fish swimming in the thunniform mode are characterized by a stiff caudal fin, shaped like a tapered hydrofoil of a moderate sweepback angle with a curved leading edge and a sharp trailing edge. The caudal fin performs a combination of pitching and heaving motions, tracing an oscillating path as the fish moves forward...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000249"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;an appropriate movement of the pectorals can deflect a moving fish from a straight line to the right or left so may they by proper twisting cause it to move diagonally upwards or downwards...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000250 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000189"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-15T11:21:35.877279Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>Lift in which the animal&apos;s thrust vector is itself directed upwards or downwards.</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>directed thrust</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">propulsion lift</rdfs:label>
        <skos:example>&quot;In the case of fishes whose undulations are in the vertical plane as with skates and flounders, certain of the methods of body undulation used for turning in other fishes cause ascent or descent.&quot;</skos:example>
        <skos:example>&quot;To generate lift on both strokes, the hummingbird must orient its wings differently on each stroke. During the forward stroke, the wing is angled to generate lift upward. During the return stroke, the wing is flipped and angled differently to again generate lift upward.&quot;</skos:example>
        <skos:scopeNote>&quot;Fishes not actively swimming may use the pectorals somewhat as active paddles and obtain a similar result by twisting them appropriately...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;In squid, jet angle increases with decreasing swimming speed to provide a vertical force to counteract the negative buoyancy of squid.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000250"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Lift in which the animal&apos;s thrust vector is itself directed upwards or downwards.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/icab021</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000250"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>directed thrust</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1988</dc:date>
        <dc:source>doi:10.1242/jeb.137.1.421</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000250"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">propulsion lift</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000250"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In the case of fishes whose undulations are in the vertical plane as with skates and flounders, certain of the methods of body undulation used for turning in other fishes cause ascent or descent.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000250"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;To generate lift on both strokes, the hummingbird must orient its wings differently on each stroke. During the forward stroke, the wing is angled to generate lift upward. During the return stroke, the wing is flipped and angled differently to again generate lift upward.&quot;</owl:annotatedTarget>
        <dc:source>https://www.academia.edu/145444084/The_Figure_8_Pattern_Across_Natural_Systems_A_Critical_Examination_of_Convergent_Geometry</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000250"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Fishes not actively swimming may use the pectorals somewhat as active paddles and obtain a similar result by twisting them appropriately...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000250"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In squid, jet angle increases with decreasing swimming speed to provide a vertical force to counteract the negative buoyancy of squid.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1098/rsos.170467</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000172"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002245"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-15T15:46:21.264774Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Brake that uses resistance to slow down.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>movement resistance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>sea anchor</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">anchor brake</rdfs:label>
        <skos:example>&quot;...an abrupt stop is made by Esox with both pectorals and pelvics used as brakes.&quot;</skos:example>
        <skos:example>&quot;Anguilliform fishes... may suddenly hold themselves rigid in any position and check the motion more gradually.&quot;</skos:example>
        <skos:example>&quot;Braking was the result of contralateral flaring of the dorsal and ventral lobes of the caudal fin, resulting in increased surface area and, presumably, drag.&quot;</skos:example>
        <skos:scopeNote>&quot;Fishes of a carangiform tendency in locomotion are not known to show a reversal of the primary locomotor movements, the pectorals playing an important part instead. These are usually stuck out equally on both sides, thus forming an effective resistance to forward movement.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Head-first descent: (1) Symmetrical head-first descent: similar to quadrupedal walking, except the limbs served a braking function on these steep descents (&gt; 45 degrees) some skidding may occur; (2) head-first scramble descent: as with symmetrical head-first descent, except on multiple supports with odd orientation and sizes, and a less symmetrical gait; and (3) cascade: as with head-first scramble descent, except supports are still smaller, and radically angled. Limbs and tail grasp briefly and in rapid succession to brake descent.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000251"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Brake that uses resistance to slow down.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;...the movement is slower, in accordance with the greater resistance of the tail when spread.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000251"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>movement resistance</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...resistance to forward movement.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000251"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>sea anchor</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000251"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">anchor brake</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000251"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...an abrupt stop is made by Esox with both pectorals and pelvics used as brakes.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000251"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Anguilliform fishes... may suddenly hold themselves rigid in any position and check the motion more gradually.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000251"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Braking was the result of contralateral flaring of the dorsal and ventral lobes of the caudal fin, resulting in increased surface area and, presumably, drag.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.021360</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000251"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Fishes of a carangiform tendency in locomotion are not known to show a reversal of the primary locomotor movements, the pectorals playing an important part instead. These are usually stuck out equally on both sides, thus forming an effective resistance to forward movement.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000251"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Head-first descent: (1) Symmetrical head-first descent: similar to quadrupedal walking, except the limbs served a braking function on these steep descents (&gt; 45 degrees) some skidding may occur; (2) head-first scramble descent: as with symmetrical head-first descent, except on multiple supports with odd orientation and sizes, and a less symmetrical gait; and (3) cascade: as with head-first scramble descent, except supports are still smaller, and radically angled. Limbs and tail grasp briefly and in rapid succession to brake descent.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000252 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000172"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-15T15:52:01.071776Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Brake in which a propulsion mechanism is reversed, quickly neutralising undesirable motion.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>reverse gear</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">gear brake</rdfs:label>
        <skos:example>&quot;Anguilliform fishes may suddenly reverse the direction of the motion of the undulations and by this means quickly check forward movement...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000252"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Brake in which a propulsion mechanism is reversed, quickly neutralising undesirable motion.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000252"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>reverse gear</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...reverse their primary locomotor “gear”...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000252"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">gear brake</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000252"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Anguilliform fishes may suddenly reverse the direction of the motion of the undulations and by this means quickly check forward movement...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000253 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000089"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000251"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000530"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000893"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-06T10:03:40.872713Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Traversing-regime that uses weight as a propulsive mechanism for moving down steep surfaces while holding a static posture and exerting a slight grip to control the speed.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">sliding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>firepole slide</oboInOwl:hasNarrowSynonym>
        <rdfs:label>slide regime</rdfs:label>
        <skos:example>[Re: Chimpanzees]
&quot;Labeled firepole slide, wherein a vertical WBS, usually very large, was grasped by circumducting it with the arms and legs, after which the animal allowed its body to descend by sliding. Sometimes the arms regulated the velocity of the descent with a hand-overhand movement.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000253"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Traversing-regime that uses weight as a propulsive mechanism for moving down steep surfaces while holding a static posture and exerting a slight grip to control the speed.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/icaa017</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;However, some snakes actually take advantage of the forces from their weight by using it as a propulsive mechanism for moving down steep surfaces while holding a static posture and exerting a slight grip to control the speed of sliding.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000253"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">sliding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000253"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>firepole slide</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000253"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>slide regime</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000253"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>[Re: Chimpanzees]
&quot;Labeled firepole slide, wherein a vertical WBS, usually very large, was grasped by circumducting it with the arms and legs, after which the animal allowed its body to descend by sliding. Sometimes the arms regulated the velocity of the descent with a hand-overhand movement.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
    


