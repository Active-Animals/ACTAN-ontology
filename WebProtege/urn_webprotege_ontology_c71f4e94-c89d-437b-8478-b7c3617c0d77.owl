        <rdfs:label>behavioural disposition</rdfs:label>
    </owl:Class>
    


    <!-- http://humanbehaviourchange.org/ontology/BCIO_050654 -->

    <owl:Class rdf:about="http://humanbehaviourchange.org/ontology/BCIO_050654">
