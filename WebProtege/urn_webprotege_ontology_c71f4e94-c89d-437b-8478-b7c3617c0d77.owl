        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-07T11:26:06.839838Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Incubation in which eggs and young are taken into the mouth.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>mouth carrying</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mouth keeping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mouth rearing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mouth taking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>oral breeding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">oral incubation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>egg snapping</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>oral gestation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mouth incubation</rdfs:label>
        <skos:example>&quot;Tilapia natalensis...
The eggs of the fishes of the Tilapia-type are snapped up immediately after they have been spawned... As long as she is carrying eggs the female makes only weak respiratory movements in which the mouth is only slightly opened. These movements having lasted for about one minute, the female makes more intensive chewing movements for about half a minute. In each of these movements the mouth is opened wider than usually and shut completely afterwards; the bottom of the mouth is moved up and down and when the mouth is open the eggs can be seen rolling about in it.&quot;</skos:example>
        <skos:narrowMatch>NBO:0020102</skos:narrowMatch>
        <skos:scopeNote>&quot;As long as the females are carrying eggs or young continuously, they do not take food, although they often fix and approach it, particularly shortly after spawning.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000869"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Incubation in which eggs and young are taken into the mouth.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In the first experiment the eggs and young larvae are treated as own brood, even after they had been taken into the mouth and thus could have been tested chemically.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000869"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>mouth carrying</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <skos:scopeNote>&quot;...carrying young in its mouth.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000869"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>mouth keeping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <skos:scopeNote>&quot;...keeps the eggs in the mouth...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000869"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>mouth rearing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <skos:scopeNote>&quot;...eggs cannot be reared outside the mouth...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000869"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>mouth taking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <skos:scopeNote>&quot;...mouth to the eggs and takes them up.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;...takes into the mouth.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000869"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>oral breeding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <skos:scopeNote>&quot;...oral breeders...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000869"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">oral incubation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <skos:scopeNote>&quot;...oral incubators.&quot;</skos:scopeNote>
