        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-11-07T08:22:40.205691Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Interfacing-regime in which the body is positioned partially on the substratum under water and partially emersed above water.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">beaching</oboInOwl:hasExactSynonym>
        <rdfs:label>beaching regime</rdfs:label>
        <skos:scopeNote>&quot;...intertidal benthic gobies performed ASR in shallow water... by beaching the body with the anterior dorsal surface emersed and the mouth just below the water surface...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000911"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Interfacing-regime in which the body is positioned partially on the substratum under water and partially emersed above water.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.198.1.79</dc:source>
    </owl:Axiom>
    <owl:Axiom>
