    <!-- http://purl.obolibrary.org/obo/ACTAN_0000197 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000086"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000065"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000173"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000183"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-26T19:25:07.233132Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Interfacing-regime that has walking-like locomotor patterns, slow speeds, and suspension phases due to the microgravity of aquatic environments.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">punt</oboInOwl:hasExactSynonym>
        <rdfs:label>punt regime</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000547"/>
        <skos:example>&quot;As seen in hippopotami, skates, and crocodiles.&quot;</skos:example>
        <skos:example>&quot;However, when the tide comes in and the crabs are buoyed up by the water around them, hydrodynamic forces are more important than gravity. Underwater, the animals switch to a gait in which only an occasional push with one or two legs on the substratum is sufficient to keep the animal gliding horizontally.&quot;</skos:example>
        <skos:example>&quot;The angulated paired fins are used as paddles and in many cases resemble feet more than they do fins, the mechanics of which are evident...

Ogcocephalus vespertilio (Linnaeus) and other similar forms are reputed to use the fore and hind “limbs” in a manner reminiscent of frogs, the latter aiding in launching them on their way.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000197"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Interfacing-regime that has walking-like locomotor patterns, slow speeds, and suspension phases due to the microgravity of aquatic environments.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/icac125</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Punt
A characteristic of walking-like locomotor patterns characterized by (1) slow speeds, and (2) suspension phases due to the microgravity of aquatic environments, as seen in hippopotami, skates, and crocodiles.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000197"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">punt</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000197"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>punt regime</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000197"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;As seen in hippopotami, skates, and crocodiles.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000197"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;However, when the tide comes in and the crabs are buoyed up by the water around them, hydrodynamic forces are more important than gravity. Underwater, the animals switch to a gait in which only an occasional push with one or two legs on the substratum is sufficient to keep the animal gliding horizontally.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    


