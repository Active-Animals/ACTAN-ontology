        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>ISBN:9780226315737</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000868"/>
