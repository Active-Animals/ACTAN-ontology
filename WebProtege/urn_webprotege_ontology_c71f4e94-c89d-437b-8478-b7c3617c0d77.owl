        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000335"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002105"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-16T17:28:35.31052Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Perception that actively detects and discriminates between sounds.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">listen</oboInOwl:hasExactSynonym>
        <rdfs:label>listen perception</rdfs:label>
        <skos:closeMatch>NBO:0000316</skos:closeMatch>
        <skos:scopeNote>&quot;Burrows and other excavated dwellings have been hypothesized to act as potential resonating chambers, which might alter sound and vibrational properties to amplify or more effectively broadcast signals to listeners outside the architecture.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000022"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Perception that actively detects and discriminates between sounds.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/41.2.137</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Humans and other species often stop and listen if they need to detect a faint sound or to make a fine auditory discrimination.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000022"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">listen</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000022"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>listen perception</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000022"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Burrows and other excavated dwellings have been hypothesized to act as potential resonating chambers, which might alter sound and vibrational properties to amplify or more effectively broadcast signals to listeners outside the architecture.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.cub.2021.09.082</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000421"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001544"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-07T08:33:24.928391Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Oscillation that involves a flexible, elongate structure.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>flag waving movement</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">flag oscillation</rdfs:label>
        <skos:example>&quot;An unusual example of luring behavior was discovered in the Indo-Pacific scorpionfish,
Iracundus signifer, by Shallenberger and Madden (1973). The dorsal fin looks very much like a small fish. The black spot on the 2nd fin membrane is the eye (which enlarges during luring), the gap between the 1st and 2nd spines is the mouth, and the long 4th dorsal spine is the 1st dorsal spine of the lure. They wrote:“Typically, the lure was snapped from side to side. The first two spines of the spinous dorsal initiated this movement and the rest of the fin followed in a sinuous wave down the back.” The 1st and 2nd dorsal spines are alternately closed together then separated, giving the effect of respiration.&quot;</skos:example>
        <skos:scopeNote>&quot;Fin rays show... different positions relative to their base throughout a sequence of movement... even between adjacent fin rays... suggesting that they have some level of independence from one another despite being connected by a flexible membrane.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000023"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Oscillation that involves a flexible, elongate structure.</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <rdfs:isDefinedBy>&quot;fan in oscillating is analogous to the ostraciiform movement if rigid, but if sufficiently elongate and flexible the same driving power produces an anguilliform (flag waving) movement.&quot;</rdfs:isDefinedBy>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000023"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>flag waving movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000023"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">flag oscillation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000023"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;An unusual example of luring behavior was discovered in the Indo-Pacific scorpionfish,
Iracundus signifer, by Shallenberger and Madden (1973). The dorsal fin looks very much like a small fish. The black spot on the 2nd fin membrane is the eye (which enlarges during luring), the gap between the 1st and 2nd spines is the mouth, and the long 4th dorsal spine is the 1st dorsal spine of the lure. They wrote:“Typically, the lure was snapped from side to side. The first two spines of the spinous dorsal initiated this movement and the rest of the fin followed in a sinuous wave down the back.” The 1st and 2nd dorsal spines are alternately closed together then separated, giving the effect of respiration.&quot;</owl:annotatedTarget>
        <dc:source>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000023"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Fin rays show... different positions relative to their base throughout a sequence of movement... even between adjacent fin rays... suggesting that they have some level of independence from one another despite being connected by a flexible membrane.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.zool.2014.04.004</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000174"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCIT_C60702"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-05T20:22:42.922094Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Turning that is characterized by a change in direction and speed, in a seemingly stochastic manner.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>erratic movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>unpredictable sequence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>meandering</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>wandering</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">zigzag</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">erratic body throw</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>jumping</oboInOwl:hasRelatedSynonym>
        <rdfs:label>erratic turning</rdfs:label>
        <skos:example>&quot;As we walk to the edge of a stream, a stickleback freezes, then darts away in a series of rapid zig-zags punctuated by brief pauses.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000024"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Turning that is characterized by a change in direction and speed, in a seemingly stochastic manner.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000024"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>erratic movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000024"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>unpredictable sequence</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1988</dc:date>
        <dc:source>doi:10.1126/science.239.4847.1525</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000024"/>
