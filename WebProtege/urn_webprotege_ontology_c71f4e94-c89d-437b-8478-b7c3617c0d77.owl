        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Foot-prop sit. Similar to sit-out, but the hindlimbs are flexed at the hips and extended at the knees, with the feet propped against a vertical support. The trunk may also flex at the hips, so that it rests against the hindlimbs. Common sleeping posture in its exemplar, Papio.&quot;</owl:annotatedTarget>
        <rdfs:comment>doi:10.1007/BF02381373</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000060"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The western aquatic garter snake Thamnophis couchii...
When the snake was able to brace a portion of its body against an object in the tank, backwards displacement of the posterior trunk was not observed.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.00424</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001795"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-08T11:39:05.249666Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Coil that is very tight.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">balling</oboInOwl:hasExactSynonym>
        <rdfs:label>ball coil</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000061"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Coil that is very tight.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000061"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">balling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000061"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>ball coil</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000639"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000151"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-12T08:57:41.094934Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>already abducted fin</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Abduction that results from pectoral abducting.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">pectoral-fin abduction</rdfs:label>
        <skos:example>&quot;...the negatively buoyant Notothenia neglecta had refractory periods at maximum abduction...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000062"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>already abducted fin</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000062"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Abduction that results from pectoral abducting.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1242/jeb.204.8.1459</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Maximal dorsal/anal excursions to the left and right are assigned to +90 ° and -90 °, respectively, as are full pectoral abduction and adduction.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000062"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">pectoral-fin abduction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000062"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...the negatively buoyant Notothenia neglecta had refractory periods at maximum abduction...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000063 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000266"/>
        <rdfs:subClassOf rdf:nodeID="genid421"/>
        <rdfs:subClassOf rdf:nodeID="genid423"/>
        <rdfs:subClassOf rdf:nodeID="genid425"/>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-01-04T06:32:06.622794Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym xml:lang="en">intermediate gait</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>intermediate movement</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Aquatic-lateral-undulating gait that uses the posterior third of the body.

Thrust is provided by a rather stiff caudal fin.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>carangiform mode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>carangiform movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>carangiform swimming</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">carangiform gait</rdfs:label>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid421">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000534"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid423">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002100"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid425">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_4000164"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000063"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid421"/>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000063"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid423"/>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000063"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid425"/>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000063"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget xml:lang="en">intermediate gait</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1093/icb/icaa017</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000063"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>intermediate movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;The movements displayed by most typical fishes are intermediate between the two extremes...
“Carangiform” is used here in a comparative sense, as an intermediate between
“Anguilliform” and “Ostraciiform”...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000063"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Aquatic-lateral-undulating gait that uses the posterior third of the body.

Thrust is provided by a rather stiff caudal fin.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1109/48.757275</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;For carangiform swimming, this is even more pronounced, as the body undulations are further confined to the last third of the body length, and thrust is provided by a rather stiff caudal fin.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000063"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>carangiform mode</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000063"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>carangiform movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000063"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>carangiform swimming</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000063"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">carangiform gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000017"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000083"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-01-07T20:12:43.167943Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Pattern which involves phased cycles of repeated activitiy.

Different regimes may involve phases of repeated activity but varying kinematically and kinetically, or different activities altogether.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">regime</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>regimen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>strategy</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">regime pattern</rdfs:label>
        <skos:scopeNote>&quot;Incubation regime influences numerous fundamental characteristics, such as duration of embryonic development, offspring size, posthatching growth rate, locomotor performance, and behavior.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The burst-and-coast regime consists of a cycle with two successive phases, i.e., a phase of active undulation powered by the fish muscles followed by a passive gliding phase.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000064"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Pattern which involves phased cycles of repeated activitiy.

Different regimes may involve phases of repeated activity but varying kinematically and kinetically, or different activities altogether.</owl:annotatedTarget>
        <dc:source>doi:10.1038/s42003-020-01521-z</dc:source>
        <dc:source>https://orcid.org/0000-0002-4277-2151</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000064"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">regime</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1146/annurev-ecolsys-102209-144712</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000064"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>regimen</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2004</dc:date>
        <dc:source>https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000064"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>strategy</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2011</dc:date>
        <dc:source>doi:10.1038/ncomms1350</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000064"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">regime pattern</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000064"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Incubation regime influences numerous fundamental characteristics, such as duration of embryonic development, offspring size, posthatching growth rate, locomotor performance, and behavior.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1146/annurev-ecolsys-102209-144712</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000064"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The burst-and-coast regime consists of a cycle with two successive phases, i.e., a phase of active undulation powered by the fish muscles followed by a passive gliding phase.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1038/s42003-020-01521-z</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000065 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000064"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000689"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-01-14T17:53:10.710941Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Regime pattern in which the force an animal exerts to move itself through space is applied continuously and the pauses last less than the nonpowered phase of a single cycle of limb movement.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>continuous locomotion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>periodic locomotion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">steady locomotion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sustained locomotion</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">steady-locomotion pattern</rdfs:label>
        <skos:example>&quot;Bluegill sunfish...
...sinusoidal mean lateral excursion pattern of the dorsal tip of the caudal fin during steady swimming...&quot;</skos:example>
        <skos:example>&quot;Elephant seals swam almost exclusively continuously at depths shallower than ~15 m, whereas at deeper depths they adopted intermittent locomotion.&quot;</skos:example>
        <skos:scopeNote>&quot;...in continuous swimming... fish basically deal with a two-dimensional parameter space consisting of tail-beat frequency and amplitude...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;...steady locomotion is more the exception than the rule for animals traveling through natural environments...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000065"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Regime pattern in which the force an animal exerts to move itself through space is applied continuously and the pauses last less than the nonpowered phase of a single cycle of limb movement.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/41.2.137</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;We refer to intermittent locomotion when the force an animal exerts to move itself through space is applied discontinuously and the pauses last longer than the nonpowered phase of a single cycle of limb movement. The alternative is continuous locomotion.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000065"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>continuous locomotion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000065"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>periodic locomotion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
        <skos:scopeNote>&quot;Swimming locomotion has been classified into... Periodic (or steady or sustained)...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000065"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">steady locomotion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1986</dc:date>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000065"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>sustained locomotion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
        <skos:scopeNote>&quot;Swimming locomotion has been classified into... Periodic (or steady or sustained)...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000065"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">steady-locomotion pattern</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000065"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Bluegill sunfish...
...sinusoidal mean lateral excursion pattern of the dorsal tip of the caudal fin during steady swimming...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.021360</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000065"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Elephant seals swam almost exclusively continuously at depths shallower than ~15 m, whereas at deeper depths they adopted intermittent locomotion.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1038/ncomms1350</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000065"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...in continuous swimming... fish basically deal with a two-dimensional parameter space consisting of tail-beat frequency and amplitude...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1038/s42003-020-01521-z</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000065"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...steady locomotion is more the exception than the rule for animals traveling through natural environments...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000066 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000068"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-01-19T20:03:49.776419Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Winged mode that uses two functional aerofoils.

Whilst it may have four appendages, only two wing surfaces are effectively being used for flying.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>functionally dipterous</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>dipterous</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>one wing pair</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">two winged</oboInOwl:hasNarrowSynonym>
        <rdfs:label>dipterous mode</rdfs:label>
        <skos:scopeNote>&quot;The hindwings are diminished in... some... and the forewings are diminished in... some... Yet other insects... have a forewing pair that plays no role in generating lift... The remaining... fly as if... each fore- and hindwing is united into a single aerofoil.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000066"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Winged mode that uses two functional aerofoils.

Whilst it may have four appendages, only two wing surfaces are effectively being used for flying.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1002/jmor.10788</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000066"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>functionally dipterous</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1002/jmor.10788</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000066"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>dipterous</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1002/jmor.10788</dc:source>
    </owl:Axiom>
