    <!-- http://purl.obolibrary.org/obo/ACTAN_0000484 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000484">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000485"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000414"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-19T08:12:12.393575Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Copulation that signals to the mate.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">copulatory courting</oboInOwl:hasExactSynonym>
        <rdfs:label>signal copulation</rdfs:label>
        <skos:example>&quot;One phenomenon suggesting the action of sexual selection on chemical signals in spiders is gustatorial courtship. Transfer of male glandular products and possibly of haemolymph to the female mouth during copulation is documented in erigonine (and suggested in linyphiine) linyphiids...&quot;</skos:example>
        <skos:example>&quot;Rapid wing-shaking movements are performed by the male during copulation in several species of Mergini.&quot;</skos:example>
        <skos:example>&quot;Steatoda bipunctata... males of this and related species stridulate not only before but also during copulation...&quot;</skos:example>
        <skos:scopeNote>&quot;The male mid legs are heavily involved in courtship behaviours both prior to and during copulation by either tapping, stroking or rubbing different parts of her body.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000484"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Copulation that signals to the mate.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000484"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">copulatory courting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000484"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>signal copulation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
        <skos:scopeNote>&quot;...signal during copulation...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000484"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;One phenomenon suggesting the action of sexual selection on chemical signals in spiders is gustatorial courtship. Transfer of male glandular products and possibly of haemolymph to the female mouth during copulation is documented in erigonine (and suggested in linyphiine) linyphiids...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000484"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Rapid wing-shaking movements are performed by the male during copulation in several species of Mergini.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000484"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Steatoda bipunctata... males of this and related species stridulate not only before but also during copulation...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000484"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The male mid legs are heavily involved in courtship behaviours both prior to and during copulation by either tapping, stroking or rubbing different parts of her body.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000485 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000485">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000852"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000925"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-19T08:12:26.602778Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Gamete-release that establishes, positions, and separates, contact for direct transfer.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">copulation</oboInOwl:hasExactSynonym>
        <rdfs:label>copulation gamete-release</rdfs:label>
        <skos:example>&quot;Chimpanzee...
Mount in copulation...
Squeal in copulation...&quot;</skos:example>
        <skos:example>&quot;Young (1949) described a male Robin (Turdus migratorius) which tried to copulate with a female but she threatened him each time; the male then &quot;copulated&quot; with a mound of earth and a crumpled newspaper before the female responded sexually.&quot;</skos:example>
        <skos:relatedMatch>NBO:0000060</skos:relatedMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000485"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Gamete-release that establishes, positions, and separates, contact for direct transfer.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000485"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
