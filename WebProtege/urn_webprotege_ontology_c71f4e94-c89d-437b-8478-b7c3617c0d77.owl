        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-06T21:15:26.355646Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Turning in which the body finely reorientates by slightly curving, with a characteristic bend at the tail.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">J-bend</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>J-turn</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>L-shape</oboInOwl:hasExactSynonym>
        <rdfs:label>J turning</rdfs:label>
        <skos:example>&quot;We found that J-turns were initiated when prey lie in the lateral visual field and served to center prey in the anterior visual field.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000578"/>
