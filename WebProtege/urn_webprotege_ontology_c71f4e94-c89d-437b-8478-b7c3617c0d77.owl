    <!-- http://purl.obolibrary.org/obo/UBERON_0001456 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001444"/>
        <obo:IAO_0000115>A subdivision of the head that has as parts the layers deep to the surface of the anterior surface, including the mouth, eyes, and nose (when present). In vertebrates, this includes the facial skeleton and structures superficial to the facial skeleton (cheeks, mouth, eyeballs, skin of face, etc).</obo:IAO_0000115>
        <obo:UBPROP_0000001>Subdivision of head which consists of the viscerocranium and all layers superficial to it. Examples: There is only one face.</obo:UBPROP_0000001>
        <oboInOwl:hasRelatedSynonym>facia/facies</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>visage</oboInOwl:hasRelatedSynonym>
        <rdfs:label>face</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A subdivision of the head that has as parts the layers deep to the surface of the anterior surface, including the mouth, eyes, and nose (when present). In vertebrates, this includes the facial skeleton and structures superficial to the facial skeleton (cheeks, mouth, eyeballs, skin of face, etc).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
