        <oboInOwl:creation_date>2025-11-10T19:56:44.412031Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Quiver that involves the tail.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">tail quivering</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">tail quiver</rdfs:label>
        <skos:example>&quot;As the female chub initiated her run with tail quivering, the stoneroller darted towards her...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000918"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Quiver that involves the tail.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.2307/4083155</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Presence of tail quivering suggests possible relationship among corvids, estrildines, and ploceids.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000918"/>
