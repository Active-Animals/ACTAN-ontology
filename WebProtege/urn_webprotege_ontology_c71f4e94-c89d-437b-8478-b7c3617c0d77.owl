    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000304"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The hermit crabs, Coenobita compressus, were observed frequently along the beach over 2 months. They were very active at night in the intertidal zone patrolling the moist sand in search of food.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000304"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The quality or size of the prey consumed is often positively correlated with the duration and intensity of the area-restricted search. For example, predatory bugs used much longer and intense area-restricted search when feeding on a 4th instar aphid rather than a 1st instar aphid.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1469-185X.2010.00163.x</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000305 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000301"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000374"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-08T13:40:38.425238Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Search that suppresses turning rates, to explore a wider area, in the absence of resource cues.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>dispersal</oboInOwl:hasExactSynonym>
        <rdfs:label>global search</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000305"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Search that suppresses turning rates, to explore a wider area, in the absence of resource cues.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1534/genetics.120.303539</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Then, they transition to a global search state (also referred to as dispersal); where they suppress their turning rates. This behavioral sequence allows them to perform an area-restricted search of the environment immediately after their food source has vanished, but then to broaden their search to a wider area if the local search is unsuccessful.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000305"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>dispersal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2016</dc:date>
        <dc:source>doi:10.1111/1365-2656.12379</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000305"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>global search</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1534/genetics.120.303539</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000306 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000373"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000515"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-13T13:26:47.560093Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Passivity in which an animal does no more than brace and shield itself in place during an attack.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>accepting the blows</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>giving no ground</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>not yielding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>standing against</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">withstanding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>maintaining position</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>shielding</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">withstanding passivity</rdfs:label>
        <skos:example>&quot;Hemichromis bimaculatus...
The more ripe the female is, the more willing she is to accept the blows of the male without leaving her place.&quot;</skos:example>
        <skos:example>&quot;Hemichromis bimaculatus...
The nearer the female approaches oestrus the more inclined she is to stand against the attacks of the male.&quot;</skos:example>
        <skos:scopeNote>&quot;If the predator does not respond to the aposematic signal, they can deliver a few effective bites, then cover up their heads and withstand a brief attack while they wait for the envenomation to repel the attacker.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;When a fish has been pushed back as far as the centre of its territory, it usually posts itself with the hind part on the bottom, the head lifted up and directed against the intruder. At this point it apparently intends to give no more ground away, and it often succeeds in keeping this last position, particularly when it has some shelter at its back.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000306"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Passivity in which an animal does no more than brace and shield itself in place during an attack.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000306"/>
