    <!-- http://purl.obolibrary.org/obo/ACTAN_0000642 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000642">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000529"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000999"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-26T21:03:39.030573Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flap pattern in which the propulsor is brought forward edgewise and back broadside.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">rowing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>striking</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>stroking</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>alternating</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>heaving</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>periodic</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">recovering</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>returning</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>swinging</oboInOwl:hasRelatedSynonym>
        <rdfs:label>rowing pattern</rdfs:label>
        <skos:scopeNote>&quot;Aerial and aquatic modes of locomotion are similar in nature due to the fact that propulsion mechanisms utilize similar characteristics of aero and hydrodynamics in each medium. The key differences between the two are the increased implications of gravity during aerial operations compared to aquatic operations, and the difference in density of the fluids, being approximately 800 times denser in water than air...

...insects typically do not use the same mechanism for locomotion in the different mediums, although many examples exist that utilize both modes of transport. To achieve this insects typically use their hexapod gaits in a rowing motion, utilizing a drag based strategy, and then subsequently use wings during aerial operations.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Rowing animals with single (𝑛=2) pair of appendages hop and sink as opposed to swimming steadily.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000642"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flap pattern in which the propulsor is brought forward edgewise and back broadside.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.5962/p.203769</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Such forms that have comparatively narrow pectorals used to this end, as Abudefduf and Teuthus, may be, in one sense, almost thought of as rowing their way along, in that they bring the fin forward almost edgewise and force it back broadside..&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000642"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">rowing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000642"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>striking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000642"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>stroking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000642"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>alternating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
