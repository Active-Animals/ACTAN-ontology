    <!-- http://purl.obolibrary.org/obo/ACTAN_0000746 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000746">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000976"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001653"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-06-27T11:09:29.126819Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement in which each eye disjunctively aligns the fovea with targets located at different distances from the observer.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">disconjugate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vergence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>fixing on</oboInOwl:hasNarrowSynonym>
        <rdfs:label>vergence eye-movement</rdfs:label>
        <skos:scopeNote>&quot;The vergence movements involve motion of the two eyes in opposite directions in order to maintain binocular fixation...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000746"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement in which each eye disjunctively aligns the fovea with targets located at different distances from the observer.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.ncbi.nlm.nih.gov/books/NBK10991/</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Disjunctive movements of the eyes (convergence or divergence) that align the fovea of each eye with targets located at different distances from the observer.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000746"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
