            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-06T10:10:46.880675Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Climbing gait that uses active ventral flexion during concertinaing, to press medially and form a static grip via a series of curves to the left and right.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">concertina with alternate bends</oboInOwl:hasExactSynonym>
        <rdfs:label>bent-concertina gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000258"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Climbing gait that uses active ventral flexion during concertinaing, to press medially and form a static grip via a series of curves to the left and right.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/icaa017</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000258"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">concertina with alternate bends</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
