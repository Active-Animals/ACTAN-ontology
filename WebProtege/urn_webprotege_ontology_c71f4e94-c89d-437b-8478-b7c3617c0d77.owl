    <!-- http://purl.obolibrary.org/obo/ACTAN_0000847 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000847">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000122"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000165"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-21T12:34:30.248641Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Gaping that involves the mouth.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>jaw distending</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mouth-gaping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">mouth-opening</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mouthing</oboInOwl:hasExactSynonym>
        <rdfs:label>mouth gaping</rdfs:label>
        <skos:example>&quot;Egg predators gathered daily over the spawning site, rushing to white clouds of gametes where they hovered, rapidly opening and closing their mouths... Species observed preying on gamete clouds included the pomacentrids Pomacentrus nagasakiensis, P. coelestis, Chromis flavomaculata, C. chrysura, Amphiprion clarkii, and Dascyllus trimaculatus; the anthiine Anthias squamipinnis; and the pomacanthids Centropyge interruptus and C. tibicen.&quot;</skos:example>
        <skos:example>&quot;There are several valves in tadpoles that control one-way flow. The mouth opens as the buccal floor is depressed and closes just before the buccal floor is elevated.&quot;</skos:example>
        <skos:relatedMatch>NBO:0000007</skos:relatedMatch>
        <skos:scopeNote>&quot;In terms of the frequency, duration, and magnitude of mouth opening, intermittent suction feeding is intermediate between continuous ram feeding and suction feeding on individual prey.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000847"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Gaping that involves the mouth.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Apomorphic characters were the derived mouth-gaping behavior of A. piscivorous and the specialized tail coil and ventral tail exposure of C. pricei.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000847"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>jaw distending</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000847"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>mouth-gaping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000847"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">mouth-opening</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000847"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>mouthing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000847"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>mouth gaping</owl:annotatedTarget>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000847"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Egg predators gathered daily over the spawning site, rushing to white clouds of gametes where they hovered, rapidly opening and closing their mouths... Species observed preying on gamete clouds included the pomacentrids Pomacentrus nagasakiensis, P. coelestis, Chromis flavomaculata, C. chrysura, Amphiprion clarkii, and Dascyllus trimaculatus; the anthiine Anthias squamipinnis; and the pomacanthids Centropyge interruptus and C. tibicen.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.11369/jji1950.34.76</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000847"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;There are several valves in tadpoles that control one-way flow. The mouth opens as the buccal floor is depressed and closes just before the buccal floor is elevated.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9780226315737</dc:source>
    </owl:Axiom>
