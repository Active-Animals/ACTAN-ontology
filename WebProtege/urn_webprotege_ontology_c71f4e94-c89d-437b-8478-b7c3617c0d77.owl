    <!-- http://purl.obolibrary.org/obo/ACTAN_0000283 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000176"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000181"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-07T08:10:42.210296Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Locomotion which involves loose sediments that collapse around the organism as it proceeds through the substrate.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">burrowing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tunneling</oboInOwl:hasExactSynonym>
        <rdfs:label>burrowing locomotion</rdfs:label>
        <skos:example>&quot;In South America, a burrowing rodent, the tuco-tuco, or Ctenomys, is even more subterranean in its habits than the mole;&quot;</skos:example>
        <skos:relatedMatch>NBO:0000071</skos:relatedMatch>
        <skos:scopeNote>&quot;Many animal architects have therefore evolved powerful morphological adaptations for digging and burrowing. Naked mole rats, for example, have large outward-facing incisors, enabling subterranean tunneling through some of the hardest of soils.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000283"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Locomotion which involves loose sediments that collapse around the organism as it proceeds through the substrate.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/j.1365-3121.1991.tb00141.x</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In this paper, the term burrowing is applied to locomotion in loose sediments that collapse around the organism as it proceeds through the substrate.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000283"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">burrowing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000283"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>tunneling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1088/1748-3182/9/1/011001</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000283"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>burrowing locomotion</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000283"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In South America, a burrowing rodent, the tuco-tuco, or Ctenomys, is even more subterranean in its habits than the mole;&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000283"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Many animal architects have therefore evolved powerful morphological adaptations for digging and burrowing. Naked mole rats, for example, have large outward-facing incisors, enabling subterranean tunneling through some of the hardest of soils.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.cub.2021.09.082</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000284 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000284">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000025"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000468"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000469"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000696"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000052"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000796"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-07T08:11:45.230916Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Burrowing-gait in which one part of the organism probes forward, while the rest acts as an anchor that prevents back-slippage; the probing part subsequently becomes anchored within the substrate, and pulls forward the rest of the body.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym xml:lang="en">anchor</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">probe</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">anchor-probe gait</rdfs:label>
        <skos:example>&quot;The genera Lingula and Glottidia possess antero-posteriorly elongated shells, and live within mucus-lined burrows in soft sediment, with the long pedicles anchored at the bottom of their burrows. Representatives of both genera have been observed to reburrow after being extracted from their burrows. Both genera burrow by entering the sediment with shell anteriormost and pedicle trailing behind. After burrowing downward for a while, they curve upward and continue burrowing until they emerge from the substrate with the anterior region of the shell.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000284"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Burrowing-gait in which one part of the organism probes forward, while the rest acts as an anchor that prevents back-slippage; the probing part subsequently becomes anchored within the substrate, and pulls forward the rest of the body.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/j.1365-3121.1991.tb00141.x</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;One part of the organism probes forward, while the rest acts as an anchor that prevents back-slippage. The probing part subsequently becomes anchored within the substrate, and pulls forward the rest of the body.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000284"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget xml:lang="en">anchor</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1991</dc:date>
        <dc:source>doi:10.1111/j.1365-3121.1991.tb00141.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000284"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget xml:lang="en">probe</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1991</dc:date>
        <dc:source>doi:10.1111/j.1365-3121.1991.tb00141.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000284"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">anchor-probe gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000284"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The genera Lingula and Glottidia possess antero-posteriorly elongated shells, and live within mucus-lined burrows in soft sediment, with the long pedicles anchored at the bottom of their burrows. Representatives of both genera have been observed to reburrow after being extracted from their burrows. Both genera burrow by entering the sediment with shell anteriormost and pedicle trailing behind. After burrowing downward for a while, they curve upward and continue burrowing until they emerge from the substrate with the anterior region of the shell.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1365-3121.1991.tb00141.x</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000285 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000285">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000271"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000096"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/technical_realizing_routine"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-07T18:18:44.043213Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Technic in which action, sensing and communicative abilities can be transformed by the physical properties of a tool.

Tooling and nontooling are different, narrower suites of behaviors than tool use in general, of which they are both part.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">mediation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tool using</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tool-use</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>use tool</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">mediation technic</rdfs:label>
        <skos:example>&quot;Neurological studies of the brains of macaque monkeys engaged in tool-using tasks have found evidence that such an integration of a tool into the user’s internal representation of its own body does indeed occur.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000285"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Technic in which action, sensing and communicative abilities can be transformed by the physical properties of a tool.

Tooling and nontooling are different, narrower suites of behaviors than tool use in general, of which they are both part.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1016/j.anbehav.2007.09.028</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;For a human familiar with a specific tool, it seems as if the boundary of the body is extended to encompass the tool, as if not just action but also sensing and sometimes communicative abilities have been transformed by the physical properties of the tool, an experience Clark (2002) describes in terms of ‘transparent equipment’.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000285"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">mediation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2008</dc:date>
        <dc:source>doi:10.1016/j.anbehav.2007.09.028</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000285"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>tool using</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000285"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>tool-use</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000285"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>use tool</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000285"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">mediation technic</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000285"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Neurological studies of the brains of macaque monkeys engaged in tool-using tasks have found evidence that such an integration of a tool into the user’s internal representation of its own body does indeed occur.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.anbehav.2007.09.028</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000286 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000286">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000285"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-07T18:20:02.851035Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mediation that is characterized by the creation of a body-plus-object system that manages a mechanical interface between tool and surface.

Tooling is limited to a narrower suite of behaviors than tool use. It involves “acting with” a tool.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">tooling</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">tooling mediation</rdfs:label>
        <skos:example>&quot;We found that probing was the most frequently referenced mode for the primates, followed by reaching and pounding. For birds, probing was by far the most commonly reported tooling mode.&quot;</skos:example>
        <skos:scopeNote>&quot;...insects... all of the few tooling cases are unusual in that a single type of tooling behavior is shared among related species... These reports hint to the evolution of stereotyped, inflexible tooling, which can be identified by the use of “a single tool for a single purpose in a particular context”, typically in species showing only one type of tooling. How these evolved tooling specializations may fundamentally differ from flexible tooling is unspecified within the current tooling framework.&quot;</skos:scopeNote>
        <skos:scopeNote>brushing-with-object
burning-with-object
clubbing-with-object
cutting-with-object
digging-with-object
dipping-with-object
fishing-with-object
flossing-with-object
hammering-with-object
jabbing-with-object
placing-with-object
* probing-with-object
propelling-with-object
* prying-with-object
pulling-with-object
push-accessing-with-object
reaching-with-object
scooping-with-object
scratching-with-object
stirring-with-object
tickling-with-object
* wiping-with-object

* Given its own class in the ontology</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000286"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mediation that is characterized by the creation of a body-plus-object system that manages a mechanical interface between tool and surface.

Tooling is limited to a narrower suite of behaviors than tool use. It involves “acting with” a tool.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/tops.12554</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In order to provide a more rigorous foundation for research and to advance our understanding of the interrelation between tool use and cognition, we suggest the adoption of Fragaszy and Mangalam’s tooling framework, which is characterized by the creation of a body-plus-object system that manages a mechanical interface between tool and surface.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000286"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">tooling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:date>
        <dc:source>doi:10.1111/tops.12554</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000286"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">tooling mediation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000286"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;We found that probing was the most frequently referenced mode for the primates, followed by reaching and pounding. For birds, probing was by far the most commonly reported tooling mode.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/tops.12554</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000286"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...insects... all of the few tooling cases are unusual in that a single type of tooling behavior is shared among related species... These reports hint to the evolution of stereotyped, inflexible tooling, which can be identified by the use of “a single tool for a single purpose in a particular context”, typically in species showing only one type of tooling. How these evolved tooling specializations may fundamentally differ from flexible tooling is unspecified within the current tooling framework.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/tops.12554</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000286"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
