    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000682">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000348"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000868"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
