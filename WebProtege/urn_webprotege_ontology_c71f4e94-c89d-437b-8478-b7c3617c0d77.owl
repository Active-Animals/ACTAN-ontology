        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-26T19:28:20.32402Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Climbing gait that maintains lateral pressure against the sides of a channel while concertinaing, and axial motor patterns are not propagated along the entire length of the animal.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>concertina by wedging</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">tunnel concertina</oboInOwl:hasNarrowSynonym>
        <rdfs:label>wedged-concertina gait</rdfs:label>
        <skos:scopeNote>&quot;Describes a snake using static points of contact with supports, by wedging its posterior into surface irregularities with short-radius bends, extending its anterior to grasp more irregularities, then pulling up the posterior.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000198"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Climbing gait that maintains lateral pressure against the sides of a channel while concertinaing, and axial motor patterns are not propagated along the entire length of the animal.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/icaa017</dc:source>
        <rdfs:comment>The definition is derived from a description of the tunnel concertina but is broadened with the term &apos;channel&apos; to replace &apos;tunnel&apos; in order to account for semi-exposed uses of this form of locomotion.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000198"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>concertina by wedging</owl:annotatedTarget>
