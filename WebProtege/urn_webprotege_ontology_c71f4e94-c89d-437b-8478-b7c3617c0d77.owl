        <oboInOwl:hasDefinition>Swimming-gait that involves waves of heaving appendages.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>metachronal rowing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>metachronal stroking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">metachronal swimming</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">metachronal-swimming gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
