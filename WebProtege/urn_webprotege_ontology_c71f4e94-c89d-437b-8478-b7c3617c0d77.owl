    <!-- http://purl.obolibrary.org/obo/ACTAN_0000717 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000717">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000355"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000282"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-28T11:07:24.650022Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Graze which removes pieces of the substratum during feeding.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>gouging</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>scraping</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">excavation graze</rdfs:label>
        <skos:example>&quot;The excavators... functional group contains Cetoscarus bicolor, Bolbometopon muricatum and a range of species currently included in the genus Scarus...&quot;</skos:example>
        <skos:scopeNote>&quot;In the field, excavating species take relatively few bites per minute, but each bite is slow and large, and excavates the substratum, leaving distinct scars.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000717"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Graze which removes pieces of the substratum during feeding.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/BF00751035</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The term excavator implies removal of pieces of the substratum during feeding.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000717"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>gouging</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1990</dc:date>
        <dc:source>doi:10.1007/BF00751035</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000717"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>scraping</owl:annotatedTarget>
        <dc:source>doi:10.1111/1365-2435.13457</dc:source>
        <dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:source>
        <rdfs:comment>This source bundles excavating and scraping into a single term &apos;scraping&apos;, although the  earlier defining author is at pains to separate them.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000717"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">excavation graze</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1990</dc:date>
        <dc:source>doi:10.1007/BF00751035</dc:source>
        <skos:scopeNote>&quot;...excavation during grazing...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000717"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The excavators... functional group contains Cetoscarus bicolor, Bolbometopon muricatum and a range of species currently included in the genus Scarus...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF00751035</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000717"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In the field, excavating species take relatively few bites per minute, but each bite is slow and large, and excavates the substratum, leaving distinct scars.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF00751035</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000718 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000718">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000676"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000780"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-21T19:06:13.306559Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Respiration that blows.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>breathing out</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>exhalation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">expiration</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">expiration respiration</rdfs:label>
        <skos:scopeNote>&quot;During expiration, the pharynx contracts and the velum moves posteriorly, forcing water over gill filaments and out the external branchiopore.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000718"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
