        <owl:annotatedTarget>Still hoping to stimulate a new UBERON class that will fit better as a participant.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source rdf:resource="https://github.com/obophenotype/uberon/issues/3124"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000659"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">egg-laying mothering</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000659"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Egg laying impacts reproductive fitness and worms display temporal variations in bouts of egg laying activity, which are impacted by feeding status and other sensory cues.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1038/s41467-023-38685-1</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000659"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;These mechanisms are illustrated by the most highly integrated insect societies, which characteristically have only one, long-lived egglayer (a high degree of genetic uniformity), highly developed pheromonal suppression of egg-laying by competitors (imposed convergence of interests), and highly specialized morphological castes (mutualistic convergence of interests due to task specialization).&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000659"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>This involves the externalization of an internally fertilized ovum.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000660 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000660">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000363"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000590"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000428"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-04-07T16:46:29.524213Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Filter when fishes shoot the jaw forward and downward rapidly; this rapid expansion of the oral cavity creates a suction which draws prey into the cavity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">plankton-picking</oboInOwl:hasExactSynonym>
        <rdfs:label>pick-suction filter</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000512"/>
        <skos:example>&quot;...fish of the genus Bryaninops pick plankton drifting past, by rapidly darting out a short distance into the water column to take a food item before darting back to cling on its associate...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000660"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Filter when fishes shoot the jaw forward and downward rapidly; this rapid expansion of the oral cavity creates a suction which draws prey into the cavity.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/BF01609520</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;When feeding, these fishes &quot;shoot&quot; the jaw forward and downward rapidly; this rapid expansion of the oral cavity creates a suction which draws prey into the cavity.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000660"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">plankton-picking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1973</dc:date>
        <dc:source>doi:10.1007/BF01609520</dc:source>
        <skos:scopeNote>&apos;Plankton picking&apos; is an acknowledged misnomer and is really &apos;plankton sucking&apos;.</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000660"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>pick-suction filter</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000660"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...fish of the genus Bryaninops pick plankton drifting past, by rapidly darting out a short distance into the water column to take a food item before darting back to cling on its associate...&quot;</owl:annotatedTarget>
        <dc:source>https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf</dc:source>
    </owl:Axiom>
    


