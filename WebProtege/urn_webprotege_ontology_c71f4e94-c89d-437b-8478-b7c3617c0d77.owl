        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">undulation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000636"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>axial undulating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1093/icb/36.6.555</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000636"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>body undulating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1093/icb/41.2.137</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000636"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>undulation pattern</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2025</dc:date>
        <dc:source>https://www.academia.edu/145444084/The_Figure_8_Pattern_Across_Natural_Systems_A_Critical_Examination_of_Convergent_Geometry</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000637 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000637">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000529"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000161"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-23T11:49:33.644243Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flap pattern in which the propulsor is pivoted about its leading edge.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">sculling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">oscillating</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pitching</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sculling pattern</rdfs:label>
        <skos:example>&quot;Interestingly, Clepticus, the plankton-picking wrasse, continues to swim like a labrid with &quot;pectoral sculling&quot; in normal swimming.&quot;</skos:example>
        <skos:scopeNote>&quot;In slow starting, the fish appears to change the pitch of the sculling pectoral fins slightly, directing the water current to the rear.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000637"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flap pattern in which the propulsor is pivoted about its leading edge.</owl:annotatedTarget>
        <dc:source>doi:10.1017/jfm.2017.173</dc:source>
        <skos:scopeNote>&quot;In the pitching gait, the wing is flapped or pivoted about its leading edge.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000637"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">sculling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000637"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">oscillating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1093/icb/36.6.555</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000637"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>pitching</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000637"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>sculling pattern</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000637"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Interestingly, Clepticus, the plankton-picking wrasse, continues to swim like a labrid with &quot;pectoral sculling&quot; in normal swimming.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000637"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In slow starting, the fish appears to change the pitch of the sculling pectoral fins slightly, directing the water current to the rear.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000638 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000638">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000020"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000069"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000151"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_4000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000688"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-23T21:11:12.432678Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Oscillating gait in which propulsion is produced by asynchronous use of the anal fin and each pectoral fin.

At low speeds (Pectoral/anal-fin-dominant, or PA), the pectoral fins move with no apparent pattern, and the anal fin moves at low frequency, with relatively uniform amplitude. Higher speeds (Anal/dorsal-fin-dominant, or AD) reveal an asynchronous equivalent to the tetraodontiform gait.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>ostraciiform</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">ostraciiform</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">ostraciiform-MPF gait</rdfs:label>
        <skos:scopeNote>&quot;Interestingly, boxfishes have been the benchmark for classical descriptions of ‘ostraciiform’ locomotion as a BCF mode with minimal body curvature in which a sculling caudal fin is the primary propulsor. Preliminary observations, both in the laboratory and in the field, suggested that boxfishes normally do not swim in this classical mode: they use their median and paired fins as the major propulsors for most of their speed range. Thus, boxfishes should be considered as MPF, not BCF, swimmers.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Ostraciiform locomotion is the only purely oscillatory BCF mode. It is characterized by the pendulum-like oscillation of the (rather stiff) caudal fin, while the body remains essentially rigid. Fish utilizing ostraciiform mode are usually encased in inflexible bodies and forage their (usually complex) habitat using MPF propulsion.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000638"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Oscillating gait in which propulsion is produced by asynchronous use of the anal fin and each pectoral fin.

At low speeds (Pectoral/anal-fin-dominant, or PA), the pectoral fins move with no apparent pattern, and the anal fin moves at low frequency, with relatively uniform amplitude. Higher speeds (Anal/dorsal-fin-dominant, or AD) reveal an asynchronous equivalent to the tetraodontiform gait.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000638"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>ostraciiform</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
        <rdfs:comment>MPF mode</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000638"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">ostraciiform</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <rdfs:comment>BCF mode</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000638"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">ostraciiform-MPF gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000638"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Interestingly, boxfishes have been the benchmark for classical descriptions of ‘ostraciiform’ locomotion as a BCF mode with minimal body curvature in which a sculling caudal fin is the primary propulsor. Preliminary observations, both in the laboratory and in the field, suggested that boxfishes normally do not swim in this classical mode: they use their median and paired fins as the major propulsors for most of their speed range. Thus, boxfishes should be considered as MPF, not BCF, swimmers.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000638"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Ostraciiform locomotion is the only purely oscillatory BCF mode. It is characterized by the pendulum-like oscillation of the (rather stiff) caudal fin, while the body remains essentially rigid. Fish utilizing ostraciiform mode are usually encased in inflexible bodies and forage their (usually complex) habitat using MPF propulsion.&quot;</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1109/48.757275</dc:source>
        <rdfs:comment>Boxfishes are the only fishes which can undertake fully oscillatory BCF mode swimming. The &apos;Ostaciiform&apos; gait term is now preferably applied to asynchronous use of median and pectoral fins. Since both modes are unique to Ostraciiformes, perhaps it would be better to call them &apos;Ostraciiform BCF&apos; and &apos;Ostraciiform MPF&apos; gaits?</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000639 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000639">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
