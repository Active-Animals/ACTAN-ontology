    <!-- http://purl.obolibrary.org/obo/ACTAN_0000735 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000735">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001593"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-28T20:19:09.382796Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement that lessens axial curving.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">straightening</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>reaching</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>uncoiling</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>unfurling</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">straightening movement</rdfs:label>
        <skos:example>&quot;During concertina locomotion snakes have both sliding and static contact, and the head-to-tail distance changes as a convoluted region of the body provides a static anchoring region with subsequent straightening that slides the body forward.&quot;</skos:example>
        <skos:scopeNote>&quot;An exaggerated lateral flexure is made in the body, often as the fish reverses directions. It may immediately straighten out again...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000735"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
