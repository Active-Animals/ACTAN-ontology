        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000924"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...a small tuberculate male Campostoma anomalum (stoneroller)... accompanied nine separate spawning runs, disrupting six. As the female chub initiated her run with tail quivering, the stoneroller darted towards her and became appressed to her flank opposite the male chub.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000924"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
