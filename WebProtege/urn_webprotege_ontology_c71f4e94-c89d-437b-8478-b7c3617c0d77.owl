        <owl:annotatedTarget>&quot;An African black eagle, white-faced capuchins, and elephants engaged in agonism by directed throwing/dropping of objects at or on another individual.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/000579509X12512865686555</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000384"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
