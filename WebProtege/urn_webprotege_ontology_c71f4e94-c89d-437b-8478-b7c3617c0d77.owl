    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000844"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Badis badis...
Comfort movements recorded include fin flickering and rubbing, chafing, flexing the body, coughing, and yawning.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000844"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Flickering the pelvics. With rather great frequency, the pelvics are repeatedly erected a little and brought back again.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000845 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000845">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000683"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001034"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-17T10:11:35.624158Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Power grip which causes strain.

This may lead to deformation, breaking, or expelling.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>squeeze</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">squeezing</oboInOwl:hasExactSynonym>
        <rdfs:label>squeeze grip</rdfs:label>
        <skos:example>&quot;...the Southeast Asian olive frog, Rana adenopleura...

Males regularly squeezed females using their hind legs once females began releasing eggs... The release of eggs often appeared to be concurrent with squeezing by the male.&quot;</skos:example>
        <skos:scopeNote>&quot;...an animal will always be able to squeeze a cylinder harder with gripping arcs of &gt;180° than those &lt;180°, assuming it has the physiological capacity to do so.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000845"/>
