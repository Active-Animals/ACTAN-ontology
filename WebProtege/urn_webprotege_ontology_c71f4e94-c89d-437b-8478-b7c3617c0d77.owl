        <oboInOwl:creation_date>2024-10-05T15:13:02.860713Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Lie that has splayed, lateralized parts.

These could be limbs or axial loops.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>sprawl</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">sprawling</oboInOwl:hasExactSynonym>
        <rdfs:label>sprawl lie</rdfs:label>
        <skos:scopeNote>&quot;Sprawl: Limbs dangled down while resting on belly, usually on a branch; sometimes used to aid cooling.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000246"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Lie that has splayed, lateralized parts.

These could be limbs or axial loops.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
