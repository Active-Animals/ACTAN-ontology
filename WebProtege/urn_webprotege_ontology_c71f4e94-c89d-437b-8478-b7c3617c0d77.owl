        <dc:date>https://orcid.org/0000-0002-4277-2151</dc:date>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000342"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Ardeola ibis...
The commonest response to high air temperature and solar radiation is gular flutter, which is present from the first day and becomes less frequent as feathering proceeds and insulation improves...
The commonest response to low environmental temperatures is clumping, in which siblings squat on their tarsometatarsi in the centre of their nest, huddling together and facing inwards towards each other.&quot;</owl:annotatedTarget>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000342"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Warmer over wintering sites also provide superior thermo regulatory opportunities to pre- and post-emergent snakes, helping prepare individuals for brumation (e.g. purging the gut of food) or ‘kick-starting’ physiological processes (e.g. metabolic rates) for rapid resumption of active season activities. Such habitat also provides a thermal mosaic of rocky features for enhanced thermoregulation and a protective cover for predator evasion, optimal for use by gravid females during the summer months.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3354/esr01312</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000343 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000342"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001734"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_environmental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-21T08:31:19.469607Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Thermoregulation that involves insolation exposure.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">basking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sun-bathing</oboInOwl:hasExactSynonym>
        <rdfs:label>bask thermoregulation</rdfs:label>
        <skos:closeMatch>NBO:0000053</skos:closeMatch>
        <skos:example>&quot;Ardeola ibis chicks...
Sunbathing is infrequent; the bird stands with its back to the sun, wings drooped and slightly spread, all feathers ruffled; first seen at 15 days.&quot;</skos:example>
        <skos:scopeNote>&quot;It is well known that gravid females aggregate at suitable basking sites to maintain elevated body temperatures.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000343"/>
