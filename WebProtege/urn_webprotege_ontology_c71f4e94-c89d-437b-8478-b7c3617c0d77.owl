        <oboInOwl:creation_date>2025-09-01T20:16:18.367901Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Ethotype in which both male and female call loudly, arch the wings, and repeatedly give rapid bursts of tail-wagging.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">Andean Goose display</oboInOwl:hasExactSynonym>
        <rdfs:comment>If a relevant ontology is developed, this would become a subtype of a display ethotype.</rdfs:comment>
        <rdfs:label xml:lang="en">Andean-Goose ethotype</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000811"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Ethotype in which both male and female call loudly, arch the wings, and repeatedly give rapid bursts of tail-wagging.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853965x00138</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;One of the displays of the Andean Goose involves lifting the wings to form an arch over the back. While calling loudly and lifting the wings in this way, both male and female repeatedly give rapid bursts of Tail-wagging.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000811"/>
