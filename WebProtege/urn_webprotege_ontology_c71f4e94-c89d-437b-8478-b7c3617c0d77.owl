        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000276"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>ornamenting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2006</dc:date>
        <dc:source>https://www.researchgate.net/profile/Sarah-Woodin/publication/228674786_Modelling_the_energy-mortality_trade-offs_of_invertebrate_decorating_behaviour/links/5505fb030cf2d60c0e6c825b/Modelling-the-energy-mortality-trade-offs-of-invertebrate-decorating-behaviour.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000276"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Construction that accumulates and retains environmental material that becomes attached to the exterior.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1098/rsbl.2015.0325</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Taking these issues into account, we define a decorator as an organism that (by means of specialist behaviour and/or morphology that has been favoured by selection for that purpose) accumulates and retains environmental material that becomes attached to the exterior of the decorator.&quot;</skos:scopeNote>
    </owl:Axiom>
