    <!-- http://purl.obolibrary.org/obo/ACTAN_0000512 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000512">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000907"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000847"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-12-29T15:38:42.653977Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>striking</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Catch that comprises a highly stereotyped, rapid, large-amplitude depression of the jaw concurrent with cranial elevation.

In water, it may be preceded by an attack swim or S-strike tail movements.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">capture strike maneuver</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>predatory strike</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>S-strike</oboInOwl:hasNarrowSynonym>
        <rdfs:label>strike catch</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000123"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000594"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000660"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000859"/>
        <skos:example>&quot;Badis badis...

While thus fixing on the worm the fish forms a slight Sickle-shape, and then strikes forward grasping the free tip of the worm. Hence this maneuver is the same as that used in capturing free-swimming prey, except it has a different orientation.&quot;</skos:example>
        <skos:scopeNote>&quot;Most commonly, predators will perform an attack swim once prey reach a ‘‘strike zone.’’ If, however, the prey becomes centered in the visual field at a greater distance, [predators] may resort to using their fins to keep the prey centered until it reaches the strike zone and then release an S-strike.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000512"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>striking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000512"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Catch that comprises a highly stereotyped, rapid, large-amplitude depression of the jaw concurrent with cranial elevation.

In water, it may be preceded by an attack swim or S-strike tail movements.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1016/j.cub.2019.11.022</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000512"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">capture strike maneuver</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1016/j.cub.2019.11.022</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000512"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>predatory strike</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2003</dc:date>
        <dc:source>doi:10.1242/jeb.00424</dc:source>
    </owl:Axiom>
