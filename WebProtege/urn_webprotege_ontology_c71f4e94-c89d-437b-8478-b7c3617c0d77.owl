    <!-- http://purl.obolibrary.org/obo/ACTAN_0000759 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000759">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000788"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000155"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-28T16:33:48.491172Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Anointment that applies foreign substances to the plumage.

These substances may be applied with the bill, or the bird may “bathe” or posture among thronging ants which invest its plumage.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">anting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>ant bathing</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">anting anointment</rdfs:label>
        <skos:example>&quot;At least 24 kinds of ants and more than 40 substitute materials have been used by anting birds. These materials include fruits, foliages, raw onion, burning matches or tobacco, gum of grass-tree (Xunthorrhoea preissii) , millipedes (Diplopoda) , various beetles (“weevils”; tenebrionid beetles of the genus Blups) , grasshoppers (Anacridium uegyptium) , earwigs (Forficula) , bugs (Rhynchotu sp., Rhuphigaster nebulosu), wasps, hair tonic, prepared mustard, vinegar, hot chocolate, and moth balls.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000759"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Anointment that applies foreign substances to the plumage.

These substances may be applied with the bill, or the bird may “bathe” or posture among thronging ants which invest its plumage.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Anting may be defined as the application of foreign substances to the plumage and possibly to the skin. These substances may be applied with the bill, or the bird may “bathe” or posture among thronging ants which invest its plumage.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000759"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">anting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1948</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5252&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000759"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>ant bathing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000759"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">anting anointment</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000759"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;At least 24 kinds of ants and more than 40 substitute materials have been used by anting birds. These materials include fruits, foliages, raw onion, burning matches or tobacco, gum of grass-tree (Xunthorrhoea preissii) , millipedes (Diplopoda) , various beetles (“weevils”; tenebrionid beetles of the genus Blups) , grasshoppers (Anacridium uegyptium) , earwigs (Forficula) , bugs (Rhynchotu sp., Rhuphigaster nebulosu), wasps, hair tonic, prepared mustard, vinegar, hot chocolate, and moth balls.&quot;</owl:annotatedTarget>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000760 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000760">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000788"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000063"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-28T17:25:51.903805Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Anointment that involves water.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">water-bathe</oboInOwl:hasExactSynonym>
        <rdfs:label>bathe anointment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000815"/>
        <skos:example>&quot;On the single occasion on which bathing has been seen, an A. ibis standing in shallow water suddenly and briefly plunged its head under water, then gave 4 or 5 typical wing-thrashing movements before resuming immobility. This was repeated 4 times in 9 minutes, during which the bird was joined by another. A noticeable feature of the incident was the total absence of repeated head-dips, ruffling, preening and general excited movement which is characteristic of bathing in other families. Dust-bathing does not occur, which probably  reflects the semi-aquatic origins of the family.&quot;</skos:example>
        <skos:scopeNote>&quot;Records of species which bathe in... dew, snow... are scanty.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000760"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Anointment that involves water.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853965x00138</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Bathing in water occurs in all Anatidae.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000760"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">water-bathe</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000760"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>bathe anointment</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000760"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;On the single occasion on which bathing has been seen, an A. ibis standing in shallow water suddenly and briefly plunged its head under water, then gave 4 or 5 typical wing-thrashing movements before resuming immobility. This was repeated 4 times in 9 minutes, during which the bird was joined by another. A noticeable feature of the incident was the total absence of repeated head-dips, ruffling, preening and general excited movement which is characteristic of bathing in other families. Dust-bathing does not occur, which probably  reflects the semi-aquatic origins of the family.&quot;</owl:annotatedTarget>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000760"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Records of species which bathe in... dew, snow... are scanty.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000761 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000761">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000103"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000786"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002101"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-29T06:34:22.350041Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Counter-irritant routine in which part of a limb is scraped against a defined area of skin, rapidly and in a fixed arc.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">scratching</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">scratch routine</rdfs:label>
        <skos:example>&quot;THE CATTLE EGRET ARDEOLA IBIS
The neck is partly extended and the foot is brought direct (&quot;vornherum&quot;) to the head. Scratching is prolonged and vigorous (20 bouts averaged 16 sec.) and always performed with the pectinated claw of the second toe.&quot;</skos:example>
        <skos:narrowMatch>NBO:0000057</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000761"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Counter-irritant routine in which part of a limb is scraped against a defined area of skin, rapidly and in a fixed arc.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000761"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">scratching</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000761"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">scratch routine</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000761"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;THE CATTLE EGRET ARDEOLA IBIS
The neck is partly extended and the foot is brought direct (&quot;vornherum&quot;) to the head. Scratching is prolonged and vigorous (20 bouts averaged 16 sec.) and always performed with the pectinated claw of the second toe.&quot;</owl:annotatedTarget>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000762 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000762">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000764"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001309"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-29T10:43:30.325526Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Body shake in which the feet paddle hard, raising the breast out of the water.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">swimming-shake</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>introductory shaking</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>preliminary shaking</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">swimming shake</rdfs:label>
        <skos:example>&quot;I have seen this shake given repeatedly by individual ducks which had lost the waterproofing quality of their breast feathers, through being in poor condition.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000762"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Body shake in which the feet paddle hard, raising the breast out of the water.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853965x00138</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In the Mallard, the shake begins with a vigorous tail-wag; the feet paddle hard, raising the breast out of the water; the shake moves forward over the body until the head and neck are stretched out and up and rotated as in the body-shake. After subsiding in the water, the bird wags its tail.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000762"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">swimming-shake</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000762"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>introductory shaking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000762"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>preliminary shaking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000762"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;I have seen this shake given repeatedly by individual ducks which had lost the waterproofing quality of their breast feathers, through being in poor condition.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    


