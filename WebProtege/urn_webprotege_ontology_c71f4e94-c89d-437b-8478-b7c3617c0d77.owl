        <oboInOwl:hasDefinition>Sequence pattern that has the footfalls of a pair of feet evenly spaced in time.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym xml:lang="en">symmetrical gait</oboInOwl:hasRelatedSynonym>
        <rdfs:label>symmetry pattern</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000135"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Sequence pattern that has the footfalls of a pair of feet evenly spaced in time.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.2307/1379571</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;There are two principal classes of gaits, symmetrical and asymmetrical. The former has the footfalls of a pair of feet evenly spaced in time.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000135"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">symmetrical gait</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.2307/1379571</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000135"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>symmetry pattern</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000136 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000136">
