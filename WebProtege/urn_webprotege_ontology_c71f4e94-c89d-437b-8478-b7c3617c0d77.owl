    <!-- http://purl.obolibrary.org/obo/ACTAN_0000949 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000949">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000723"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000165"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-05T10:46:48.6798Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Gape which results from mouth gaping</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">mouth gape</rdfs:label>
        <skos:example>&quot;...the American Opossum (Didelphis virginiana) and hog nosed snake (Heterodon spp.) assume contorted postures with their eyes open and their tongues protruding from gaping mouths.&quot;</skos:example>
        <skos:example>&quot;In two species, Emmelichthyops and Schultzea, an additional process is found on the premaxilla which apparently serves in giving support to the large resulting gape between the maxilla and the premaxilla; this gape is covered only by integument when the jaw is shot forward.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000949"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Gape which results from mouth gaping</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000949"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">mouth gape</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000949"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...the American Opossum (Didelphis virginiana) and hog nosed snake (Heterodon spp.) assume contorted postures with their eyes open and their tongues protruding from gaping mouths.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.cub.2014.08.051</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000949"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In two species, Emmelichthyops and Schultzea, an additional process is found on the premaxilla which apparently serves in giving support to the large resulting gape between the maxilla and the premaxilla; this gape is covered only by integument when the jaw is shot forward.&quot;</owl:annotatedTarget>
