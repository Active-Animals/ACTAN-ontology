        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001652"/>
        <obo:IAO_0000115>An alignment quality inhering in a bearer by virtue of the bearer&apos;s being in a improper spatial positioning with respect to an additional entity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>misaligned</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>unaligned with</oboInOwl:hasExactSynonym>
        <rdfs:label>misaligned with</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001687 -->

