        <oboInOwl:creation_date>2024-10-06T15:13:32.100904Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Posture that involves bridging with the body, by grasping a support on either side of a gap.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>postural bridge</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">spanning</oboInOwl:hasExactSynonym>
        <rdfs:label>span posture</rdfs:label>
    </owl:Class>
