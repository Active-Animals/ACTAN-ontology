    <!-- http://purl.obolibrary.org/obo/ACTAN_0000333 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000333">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000331"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000689"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-15T09:04:47.33194Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Pursuit that is continuous.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">coursing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">coursing pursuit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000152"/>
        <skos:example>&quot;I measured the flight morphology and linear-acceleration capabilities of some coursing aerial insectivores (Chordeiles minor (Common Nighthawk), Chlidonias niger (Black Tern), Cypseloides niger (Black Swift), Aeronautes saxatalis (White-throated Swift), Chaetura vauxi (Vaux’s Swift), Tachycineta bicolor (Tree Swallow), Tachycineta thalassina (Violet–green Swallow), Hirundo rustica (Barn Swallow), and Petrochelidon pyrrhonota (Cliff Swallow)).&quot;</skos:example>
        <skos:example>&quot;These observations included responses to four large carnivores that commonly kill these prey, including two coursers (wild dog and spotted hyena)...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000333"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Pursuit that is continuous.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1139/z98-044</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;I have departed from Ehrlich et al.’s (1992) “aerial forager,” deeming it ambiguous, and have chosen to return to Blake’s (1948) “coursing” (flying continuously in search of insect prey)...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000333"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">coursing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>doi:10.1139/z98-044</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000333"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">coursing pursuit</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000333"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;I measured the flight morphology and linear-acceleration capabilities of some coursing aerial insectivores (Chordeiles minor (Common Nighthawk), Chlidonias niger (Black Tern), Cypseloides niger (Black Swift), Aeronautes saxatalis (White-throated Swift), Chaetura vauxi (Vaux’s Swift), Tachycineta bicolor (Tree Swallow), Tachycineta thalassina (Violet–green Swallow), Hirundo rustica (Barn Swallow), and Petrochelidon pyrrhonota (Cliff Swallow)).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1139/z98-044</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000333"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;These observations included responses to four large carnivores that commonly kill these prey, including two coursers (wild dog and spotted hyena)...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1231780</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000334 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000334">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000270"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MFOEM_000002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-15T15:09:36.318354Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Cognition which appraises incoming stimuli.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">assessment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>evaluating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>judgment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>cognitive appraisal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>treat like</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">assessment cognition</rdfs:label>
        <skos:example>&quot;...Aequidens latifrons treat loose eggs like wriggling young.&quot;</skos:example>
        <skos:scopeNote>&quot;...examples of social interactions, such as territoriality, dominance, and threat, in which individuals compete by &quot;conventional&quot; means—via displays and ritualized aggression rather than overt fighting... is... a means by which individuals may assess their competitive strength relative to others without actually doing battle, in order to adjust their behavior according to their own individual advantage.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Cues involve multiple sensory modalities which may differ in reliability and detectability, potentially giving rise to variability in the quantity and(or) quality of risk assessment...

...prey may be capable of compensating for reduced information via one sensory modality by increasing their reliance on other modalities.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;We describe a ‘landscape of information’ in which prey rely on publicly available risk assessment information to reduce the uncertainty of predation risks associated with variable threats and the potential impact of natural and anthropogenic environmental factors which may limit information availability.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Cognition which appraises incoming stimuli.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1016/j.anbehav.2011.01.007</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;New evidence suggests that cortical mirror neurons may provide a dedicated neural mechanism underlying emotional contagion: these neurons are activated both when an emotionally loaded behaviour is being perceived and when it is being performed. It has been suggested that this neural shortcut bypasses the need for complex cognitive appraisal of incoming stimuli and thereby enables the emotion to be copied very fast, sometimes in fractions of seconds.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">assessment</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>evaluating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1982</dc:date>
        <dc:source>doi:10.2307/1367674</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>judgment</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2004</dc:date>
        <dc:source>doi:10.1111/j.1444-2906.2003.00797.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>cognitive appraisal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1177/1745691610369469</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>treat like</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <skos:scopeNote>&quot;...treat loose eggs like wriggling young.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">assessment cognition</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...Aequidens latifrons treat loose eggs like wriggling young.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...examples of social interactions, such as territoriality, dominance, and threat, in which individuals compete by &quot;conventional&quot; means—via displays and ritualized aggression rather than overt fighting... is... a means by which individuals may assess their competitive strength relative to others without actually doing battle, in order to adjust their behavior according to their own individual advantage.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Cues involve multiple sensory modalities which may differ in reliability and detectability, potentially giving rise to variability in the quantity and(or) quality of risk assessment...

...prey may be capable of compensating for reduced information via one sensory modality by increasing their reliance on other modalities.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1238167</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;We describe a ‘landscape of information’ in which prey rely on publicly available risk assessment information to reduce the uncertainty of predation risks associated with variable threats and the potential impact of natural and anthropogenic environmental factors which may limit information availability.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1238167</dc:source>
