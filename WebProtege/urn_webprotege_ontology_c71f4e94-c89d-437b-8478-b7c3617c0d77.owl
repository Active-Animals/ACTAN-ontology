        <oboInOwl:hasExactSynonym xml:lang="en">aquatic adapted</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>aquatic mode</oboInOwl:hasExactSynonym>
        <rdfs:label>aquatic mould</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000183"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
