        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000553 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000553">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000541"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-27T14:17:01.64865Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Switch that depends on the environmental context present.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>context-dependent response</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dependent switching</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>shaped switching</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>apt</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">conditional</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">condition switch</rdfs:label>
        <skos:example>&quot;Cichlasoma biocellatum...
When the fish is apt to become aggressive, for instance when it is guarding the young...&quot;</skos:example>
        <skos:example>&quot;It is possible to demonstrate the conflict between fleeing, backward or forward, and suppression of movement in a Badis badis by placing it in a small aquarium with inadequate shelter. Tapping on the glass with one&apos;s finger, varying the strength and distance of the tapping, causes the fish to lie still, suddenly jump forward and immediately back, and so forth. Thus the behavior switches back and forth rapidly between the possible outlets of Fright.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000553"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Switch that depends on the environmental context present.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.3389/fnbeh.2010.00049</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000553"/>
