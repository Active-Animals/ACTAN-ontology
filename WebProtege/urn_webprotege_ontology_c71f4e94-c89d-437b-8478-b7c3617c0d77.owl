        <owl:annotatedTarget>&quot;In larval zebrafish, head stimulation generally elicits C-starts, while tail stimulation evokes both C- and S-starts.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000595 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000595">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000174"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002472"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-10T14:11:19.544853Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Turning that is spontaneous, resulting in reorientation, with a large bend angle, only a small portion of the tail bending, a slow angular velocity, and relatively slow turning angles.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>R-turn</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>high-angle turn</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">slow turning</oboInOwl:hasExactSynonym>
        <rdfs:label>routine turning</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000595"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Turning that is spontaneous, resulting in reorientation, with a large bend angle, only a small portion of the tail bending, a slow angular velocity, and relatively slow turning angles.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;R-turn(ing): A slow spontaneous turn (20–30 ms) with a large bend angle (60 degrees) resulting in reorientation of the larva before forward swimming, prey capture; lacks the large counter-bend (shown in escape turns), with only a small portion of the tail bending; has a slow angular velocity with relatively slow turning angles.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000595"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>R-turn</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000595"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>high-angle turn</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1534/genetics.120.303539</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000595"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">slow turning</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000595"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>routine turning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000596 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000596">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000020"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000069"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000642"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000151"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:nodeID="genid4531"/>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-10T15:45:36.531962Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>labriform movement</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Oscillating gait that involves a power stroke, when the fins move posteriorly perpendicular to the body at a high attack angle and with a velocity greater than the overall swimming speed, and a recovery stroke, when the fins are feathered and brought forward.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>drag based labriform mode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">scoot swimming</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>creeping</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>rowing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>slow swimming</oboInOwl:hasRelatedSynonym>
        <rdfs:label>labriform-drag-based gait</rdfs:label>
        <skos:example>&quot;Larval zebrafish slow swimming (scoots) characterized by small bend angles with bend location near the tail. Maximal bending occurs close to the tail; low degree of bending and tail beat frequency; yaw angles are &lt; 3 degrees; pectoral fins are active and alternate right to left between adduction and abduction.&quot;</skos:example>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid4531">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000688"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000596"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid4531"/>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000596"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>labriform movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000596"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Oscillating gait that involves a power stroke, when the fins move posteriorly perpendicular to the body at a high attack angle and with a velocity greater than the overall swimming speed, and a recovery stroke, when the fins are feathered and brought forward.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1109/48.757275</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Rowing action consists of two phases: the power stroke, when the fins move posteriorly perpendicular to the body at a high attack angle and with a velocity greater than the overall swimming speed, and a recovery stroke, when the fins are “feathered” to reduce resistance and brought forward.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000596"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>drag based labriform mode</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000596"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">scoot swimming</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000596"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>creeping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000596"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>rowing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000596"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>slow swimming</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000596"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>labriform-drag-based gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000596"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Larval zebrafish slow swimming (scoots) characterized by small bend angles with bend location near the tail. Maximal bending occurs close to the tail; low degree of bending and tail beat frequency; yaw angles are &lt; 3 degrees; pectoral fins are active and alternate right to left between adduction and abduction.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000597 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000597">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000598"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002415"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-10T17:04:17.390795Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Dipping which drops the tail for a short period of time.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>dipping the tail</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tail dip</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>head upward</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">tail dipping</rdfs:label>
        <skos:example>&quot;...Cleaner Wrasse Labroides dimidiatus...
...unusual mode of swimming of the wrasse, which oscillates the posterior part of its body up and down as if to attract attention...&quot;</skos:example>
        <skos:example>&quot;If badly harassed by another Badis badis, an adult will swim upward as a last resort. Then it usually stands in a corner (head down or up) or among plants (often head up). When a juvenile swims upward or forward in flight, the body normally swings down posteriorly at the end of the flight if the fish is not in contact with the substrate. The body angle, with respect to the bottom, ranges between 45° and 80°.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000597"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Dipping which drops the tail for a short period of time.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;An agonistic behavior during fighting, when one fish slightly drops its tail for a short period of time, to signal its submission and end the confrontation.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000597"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>dipping the tail</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000597"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>tail dip</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000597"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>head upward</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000597"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">tail dipping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000597"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...Cleaner Wrasse Labroides dimidiatus...
...unusual mode of swimming of the wrasse, which oscillates the posterior part of its body up and down as if to attract attention...&quot;</owl:annotatedTarget>
        <dc:source>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000597"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;If badly harassed by another Badis badis, an adult will swim upward as a last resort. Then it usually stands in a corner (head down or up) or among plants (often head up). When a juvenile swims upward or forward in flight, the body normally swings down posteriorly at the end of the flight if the fish is not in contact with the substrate. The body angle, with respect to the bottom, ranges between 45° and 80°.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000598 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000598">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001689"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-10T17:26:41.773068Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement that lowers an extremity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>dip</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">dipping</oboInOwl:hasExactSynonym>
        <rdfs:label>dipping movement</rdfs:label>
        <skos:example>&quot;In dipping, a heron flying low above the water catches prey in the water while continuing in direct flight without hovering.&quot;</skos:example>
        <skos:scopeNote>&quot;Tail dip (tail dipping): An agonistic behavior during fighting, when one fish slightly drops its tail for a short period of time, to signal its submission and end the confrontation.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000598"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement that lowers an extremity.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000598"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>dip</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000598"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">dipping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
