        <oboInOwl:creation_date>2026-07-20T10:16:34.31925Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Extending that involves the dorsal fin.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">dorsal-fin extending</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000295"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Extending that involves the dorsal fin.</owl:annotatedTarget>
        <dc:source>&quot;Schlesinger points out with a diagram that in turning by means of extending a single pectoral the pressure of the water on the extended dorsal and anal swings the fish around with the pectoral somewhat as a pivot.&quot;</dc:source>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
