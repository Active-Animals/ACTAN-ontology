    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000959">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000411"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000348"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000988"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/group_behaviour"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-24T05:35:19.824312Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Aggregation that is characterized by the joining of individuals from two or more species in feeding activity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">feeding aggregation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>foraging association</oboInOwl:hasExactSynonym>
        <rdfs:label>foraging aggregation</rdfs:label>
        <skos:example>&quot;Parupeneus barberinus is an important tropical benthic microcarnivore that forages vigorously over soft sediments adjacent to coral reefs. It has a considerable impact on the soft sediment invertebrate community as it is both common and abundant, and devotes more than 50% of its time budget to foraging. The disturbance it creates in the sediment while foraging exposes prey items and attracts many fish species to engage in foraging associations.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000959"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Aggregation that is characterized by the joining of individuals from two or more species in feeding activity.</owl:annotatedTarget>
        <rdfs:isDefinedBy>http://www.icrs2012.com/proceedings/manuscripts/ICRS2012_13B_2.pdf</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;A foraging association is characterized by the joining of individuals from two or more species in feeding activity, ranging from simple to complex, and from highly transient to obligate.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000959"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">feeding aggregation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2005</dc:date>
        <dc:source>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000959"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>foraging association</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1988</dc:date>
        <dc:source>doi:10.2307/1445875</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000959"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>foraging aggregation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000959"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Parupeneus barberinus is an important tropical benthic microcarnivore that forages vigorously over soft sediments adjacent to coral reefs. It has a considerable impact on the soft sediment invertebrate community as it is both common and abundant, and devotes more than 50% of its time budget to foraging. The disturbance it creates in the sediment while foraging exposes prey items and attracts many fish species to engage in foraging associations.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000960 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000960">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000959"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000996"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-24T06:32:57.193872Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Foraging in which members are mutualistic.

Mixed associations involve nuclear and associate species.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>shoaling association</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">shoaling foraging</rdfs:label>
        <skos:example>&quot;Randall (1998) wrote that herbivorous surgeonfishes of the genus Acanthurus may form feeding aggregations of more than 1 species in order to overcome territorial damselfishes trying to protect their private pastures of benthic algae. He provided an illustration of a mixed school of A. coeruleus and A. chirurgus off the Caribbean coast of Honduras.&quot;</skos:example>
        <skos:scopeNote>&quot;Mixed species shoaling associations are generally larger than attendant associations and may comprise several hundred individuals. The nuclear species generally comprises more individuals than the associate species in the group combined: there may be one or more species of associates.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000960"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Foraging in which members are mutualistic.

Mixed associations involve nuclear and associate species.</owl:annotatedTarget>
        <rdfs:isDefinedBy>ISBN:9789798105975</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Both the nuclear and the associate species are thought to benefit in multi-species shoaling associations, i.e. they are mutualistic associations, by swamping territorial herbivores and gaining access to defended resources.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000960"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>shoaling association</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000960"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">shoaling foraging</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000960"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Randall (1998) wrote that herbivorous surgeonfishes of the genus Acanthurus may form feeding aggregations of more than 1 species in order to overcome territorial damselfishes trying to protect their private pastures of benthic algae. He provided an illustration of a mixed school of A. coeruleus and A. chirurgus off the Caribbean coast of Honduras.&quot;</owl:annotatedTarget>
        <dc:source>https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000960"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Mixed species shoaling associations are generally larger than attendant associations and may comprise several hundred individuals. The nuclear species generally comprises more individuals than the associate species in the group combined: there may be one or more species of associates.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000961 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000961">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000959"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000924"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-24T06:33:21.063886Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Foraging in which associate species are, at best, commensal on nuclear species.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>attendant association</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>producer-scrounger aggregation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>following around</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">attendant foraging</rdfs:label>
        <skos:example>&quot;Indeed, other fishes often take advantage of these mullid barbel activities. Hobson notes that in Hawaii Parupeneus chryserydros (now P. cyclostomus) is frequently followed around by the jack, Caranx melampygus...&quot;</skos:example>
        <skos:example>‘Interspecific joint hunting’ has been described between the elephant wrasse, Gomphosus caeruleus and the yellow goatfish, Parupeneus chryseredros, and between serranids such as Cephalopholis argus and Plectropomus maculatus.&quot;</skos:example>
        <skos:scopeNote>&quot;...Mediterranean rainbow wrasse, Coris julis, which joins producer—scrounger aggregations with a goatfish species, Mullus surmuletus, that disturbs benthic prey during foraging. Wrasse remained within their territories and did not follow producers beyond these boundaries...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Attendant associations are usually small and comprise a maximum of around 10 individuals. They consist of one or two nuclear individuals of one species followed by associates of one or more species.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Ephemeral foraging association... formerly grouped together as nuclear-follower... Brief interactions... Associate species does not move away from its territory to continue the interaction.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;‘Following and scavenging’ associations are by far the most common type of attendant associations.

‘Interspecific joint hunting’ occurs when two species of active predators hunt together.

‘Hunting by riding’ occurs when a predatory associate swims alongside or above a nuclear species that is either non-predatory or feeds on different prey.

...‘aggressive mimicry’ occurs when the associate species is a predator, and it mimics the nuclear species, that is harmless.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000961"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Foraging in which associate species are, at best, commensal on nuclear species.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000961"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>attendant association</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000961"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>producer-scrounger aggregation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2026</dc:date>
        <dc:source>doi:10.1016/j.anbehav.2026.123487</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000961"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>following around</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1984</dc:date>
        <dc:source>https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000961"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">attendant foraging</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2012</dc:date>
        <dc:source>ISBN:978-0-9808572-5-2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000961"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Indeed, other fishes often take advantage of these mullid barbel activities. Hobson notes that in Hawaii Parupeneus chryserydros (now P. cyclostomus) is frequently followed around by the jack, Caranx melampygus...&quot;</owl:annotatedTarget>
        <dc:source>https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000961"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>‘Interspecific joint hunting’ has been described between the elephant wrasse, Gomphosus caeruleus and the yellow goatfish, Parupeneus chryseredros, and between serranids such as Cephalopholis argus and Plectropomus maculatus.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9789798105975</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000961"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
