    <!-- http://purl.obolibrary.org/obo/ACTAN_0000477 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000477">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000475"/>
