            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-11T17:14:48.75578Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Participation that obtains information about various aspects of the  environment by acquiring inadvertent social information from others.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">indirect sampling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>assisted watching</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">indirect-sample participation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000410"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Participation that obtains information about various aspects of the  environment by acquiring inadvertent social information from others.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.3389/fetho.2023.1238167</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Individuals can obtain information about various aspects of their environment either directly via direct sampling (personal information) or indirectly by acquiring inadvertent social information from others.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000410"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">indirect sampling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>doi:10.3389/fetho.2023.1238167</dc:source>
        <skos:scopeNote>&quot;...direct sampling (personal information) or indirectly... from others...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000410"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>assisted watching</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <skos:scopeNote>&quot;...animals assist each other in watching for enemies...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000410"/>
