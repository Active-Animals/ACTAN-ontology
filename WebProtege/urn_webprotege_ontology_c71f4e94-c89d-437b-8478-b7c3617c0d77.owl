            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-03T19:17:16.891622Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Creeping gait that is prone, with substantial contact between the supporting surface and contact points other than the distal portions of the limbs.

This may include knees, elbows, the belly, or the underside of the tail.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">crawl</oboInOwl:hasExactSynonym>
        <rdfs:label>crawl gait</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000137"/>
        <skos:example>&quot;Aequidens latifrons...
The at first the larvae only crawl along the bottom, ascending in this way the slopes of the pit, but after some hours they are able to swim freely at a llittle distance above the bottom.&quot;</skos:example>
        <skos:example>&quot;The triglids, for example, are able to creep slowly over the bottom by means of the free pectoral rays. The motion is produced by placing the tips of the rays in contact with the bottom and pushing backwards.&quot;</skos:example>
        <skos:relatedMatch>NBO:0000363</skos:relatedMatch>
        <skos:scopeNote>&quot;...crawling, in which potential energy (height) varies little.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid1592">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000624"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000228"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid1592"/>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000228"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Creeping gait that is prone, with substantial contact between the supporting surface and contact points other than the distal portions of the limbs.

This may include knees, elbows, the belly, or the underside of the tail.</owl:annotatedTarget>
        <dc:source>&quot;Crawl
A form of creeping locomotion characterized by (1) slow speeds, (2) a prone or sprawling posture, and (3) substantial contact between the supporting surface and contact points other than the distal portions of the limbs (hands or feet), which may include knees, elbows, the belly, or the underside of the tail.&quot;</dc:source>
        <rdfs:isDefinedBy>doi:10.1093/icb/icac125</rdfs:isDefinedBy>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000228"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">crawl</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000228"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>crawl gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
