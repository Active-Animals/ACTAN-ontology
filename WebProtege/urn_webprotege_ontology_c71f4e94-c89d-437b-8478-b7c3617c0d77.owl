    <!-- http://purl.obolibrary.org/obo/ACTAN_0000786 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000786">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000104"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001576"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-06T08:23:35.411484Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Rub that firmly moves a hard object across another.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">scraping</oboInOwl:hasExactSynonym>
        <rdfs:label>scrape rub</rdfs:label>
        <skos:example>&quot;A unique case of male genital asymmetry among the usually symmetric Pyralidae occurs in Syntonarcha iriastis. Directionally asymmetric structures at the bases of the valves and on the 8th sternite are used for stridulation, with the left side providing file and scraper, the right side a complicated ‘‘tracer and groove’’ system.&quot;</skos:example>
        <skos:example>&quot;Abudefduf saxatilis, an ubiquitous form which feeds by benthic scraping on algae and invertebrates...&quot;</skos:example>
        <skos:scopeNote>&quot;Eat phloem or inner bark rich in sugar and protein by scraping outer bark with incisors.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Sperm transfer takes place after a period of sperm displacement, wherein the male uses his secondary genitals to either pack deeply in or scrape out any previous male’s sperm from the female sperm storage organs.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000786"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Rub that firmly moves a hard object across another.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1111/j.1469-185X.2007.00029.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000786"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">scraping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000786"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>scrape rub</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000786"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;A unique case of male genital asymmetry among the usually symmetric Pyralidae occurs in Syntonarcha iriastis. Directionally asymmetric structures at the bases of the valves and on the 8th sternite are used for stridulation, with the left side providing file and scraper, the right side a complicated ‘‘tracer and groove’’ system.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1469-185X.2007.00029.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000786"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Abudefduf saxatilis, an ubiquitous form which feeds by benthic scraping on algae and invertebrates...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000786"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Eat phloem or inner bark rich in sugar and protein by scraping outer bark with incisors.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000786"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Sperm transfer takes place after a period of sperm displacement, wherein the male uses his secondary genitals to either pack deeply in or scrape out any previous male’s sperm from the female sperm storage organs.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.cub.2020.11.002</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000787 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000787">
