    <!-- http://purl.obolibrary.org/obo/ACTAN_0000379 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000376"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000548"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-22T20:52:49.672427Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Avoidance that involves sudden, rapid, locomotion.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">evading</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>evasion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>evasive action</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>evasive movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">dashing</oboInOwl:hasRelatedSynonym>
        <rdfs:label>evasion avoidance</rdfs:label>
        <skos:example>&quot;Aequidens latifrons...
The male often butts the female and she tries to evade these pushes.&quot;</skos:example>
        <skos:scopeNote>&quot;Some types of prey have developed greater manoeuvrability which can be used to evade attacks made by predators with quicker acceleration.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Such habitat also provides a thermal mosaic of rocky features for enhanced thermoregulation and a protective cover for predator evasion, optimal for use by gravid females during the summer months.&quot;</skos:scopeNote>
    </owl:Class>
