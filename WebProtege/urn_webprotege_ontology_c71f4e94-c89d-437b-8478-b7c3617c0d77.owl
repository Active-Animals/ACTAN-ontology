    <!-- http://purl.obolibrary.org/obo/ACTAN_0000515 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000515">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000088"/>
        <rdfs:subClassOf rdf:nodeID="genid3904"/>
        <rdfs:subClassOf rdf:nodeID="genid3906"/>
        <rdfs:subClassOf rdf:nodeID="genid3908"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-12-30T16:12:44.158405Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Swimming-regime that moves forward in a single motion, and coasts to a slow speed from which they burst forward again.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">beat-and-glide</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>burst-and-coast mode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>burst-and-coast regime</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>burst-and-coast swimming</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>burst-coast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>burst-glide</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>kick and glide</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>CBC</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>caudal burst-and-coast</oboInOwl:hasNarrowSynonym>
        <rdfs:label>burst-coast regime</rdfs:label>
        <skos:example>&quot;Bluegill sunfish... Kick maneuvers were characterized by sudden rapid lateral excursion of the caudal fin and were followed by a forward glide (‘kick-and-glide’).&quot;</skos:example>
        <skos:example>&quot;Species that swim by passing waves of bending of the body from head to tail often switch from steady axial undulation to a saltatory &quot;burst-and-coast&quot; mode of propulsion at high speeds.&quot;</skos:example>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid3904">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000042"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid3906">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000150"/>
    </owl:Restriction>
