        <oboInOwl:creation_date>2024-11-10T20:43:01.407687Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Nontooling that uses a water current.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">swim-flush</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>waving</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">flushing nontooling</rdfs:label>
        <skos:example>&quot;...the Centrarchids... nest-pit, which is dug by waving movements of the fish when it stands horizontally over the bottom...&quot;</skos:example>
