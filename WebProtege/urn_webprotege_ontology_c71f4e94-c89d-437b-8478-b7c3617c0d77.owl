        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000966"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Zebrafish...
Following, and perhaps in response to, quivering by the male, the female stalls swimming and twists her trunk slightly; we call this step freezing.&quot;</owl:annotatedTarget>
