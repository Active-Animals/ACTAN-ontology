    <!-- http://purl.obolibrary.org/obo/ACTAN_0000574 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000088"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000311"/>
