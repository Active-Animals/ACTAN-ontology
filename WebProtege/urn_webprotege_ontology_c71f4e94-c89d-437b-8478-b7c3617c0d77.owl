        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000263"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Traversing-regime that involves reaching out to grasp a support on one side of a gap which is pulled toward the animal, pulling the body across the open space, and retaining both grips until a secure position is established on the other side.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
