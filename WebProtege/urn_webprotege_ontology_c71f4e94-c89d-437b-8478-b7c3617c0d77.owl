    <!-- http://purl.obolibrary.org/obo/ACTAN_0000870 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000870">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000288"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000727"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-07T11:36:14.314237Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Relativity in which an animal carries something else.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">carrying</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>transferring</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>transporting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>bringing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>displacing</oboInOwl:hasRelatedSynonym>
        <rdfs:label>transport relativity</rdfs:label>
        <skos:example>&quot;...in the Formica (Polyerges) rufescens... When the old nest is found inconvenient, and they have to migrate, it is the slaves which determine the migration, and actually carry their masters in their jaws...
Formica sanguinea, on the other hand, possesses much fewer slaves, and in the early part of the summer extremely few. The masters determine when and where a new nest shall be formed, and when they migrate, the masters carry the slaves..&quot;</skos:example>
        <skos:example>&quot;Internal mandibular surfaces of nest-building males in at least two species (N. leptoce.phalus and N micropogon) are covered with a layer of keratin which may reduce abrasion during stone carrying.&quot;</skos:example>
        <skos:example>&quot;Southern masked weaverbird (Ploceus velatus)...
Observed building behaviours (e.g., carrying, inserting, and dropping material) used by the same males across multiple nests in one season.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000870"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Relativity in which an animal carries something else.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
