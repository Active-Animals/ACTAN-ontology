            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-07T08:09:13.991287Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Construction which uses stitches to fasten and secure materials.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">weaving</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">weaving construction</rdfs:label>
        <skos:example>&quot;A fitting example is the long entrance tube woven by weaver birds beneath their nest, which not only keeps the nest waterproof but also makes access to the nest difficult for predators.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000278"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Construction which uses stitches to fasten and secure materials.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.3819/ccbr.2016.110005</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The techniques with which birds build their nests have also been described in some detail and are also various: they range... to the weaving of hanging nest baskets using intricate tuck, looping, interlocking, winding, and knotting bill-made stitches to fasten and secure grassy materials.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000278"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">weaving</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2016</dc:date>
        <dc:source>doi:10.3819/ccbr.2016.110005</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000278"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">weaving construction</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000278"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;A fitting example is the long entrance tube woven by weaver birds beneath their nest, which not only keeps the nest waterproof but also makes access to the nest difficult for predators.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.cub.2021.09.082</dc:source>
    </owl:Axiom>
    


