        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000169"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000187"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-27T17:16:00.380386Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Climbing gait in which the body is orthograde, suspended, and various combinations of appendages attach in different ways, in net tension.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>clamber</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">clambering</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">uncoupled movement</oboInOwl:hasExactSynonym>
        <rdfs:label>clamber gait</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000729"/>
        <skos:scopeNote>&quot;Thus, branch spacing dictates step lengths, thereby limiting potential choices in gait patterns and frequently requiring patterns that would be awkward or impractical on the ground. The latter case is best exemplified by the lateral stem gaits that uncouple the movements of the forelimb pair from those of the hind limb pair. The forelimbs first touch down in sequence, then the hind limbs.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000728"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Climbing gait in which the body is orthograde, suspended, and various combinations of appendages attach in different ways, in net tension.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/BF02381373</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;CANT defined the mode as follows: &quot;the body is orthograde with the head superior, and various combinations of all the four appendages attach to substrates in different ways, including suspension by the forelimbs from above.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000728"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>clamber</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000728"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">clambering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000728"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">uncoupled movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1023/A:1005565304671</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000728"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>clamber gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000728"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Thus, branch spacing dictates step lengths, thereby limiting potential choices in gait patterns and frequently requiring patterns that would be awkward or impractical on the ground. The latter case is best exemplified by the lateral stem gaits that uncouple the movements of the forelimb pair from those of the hind limb pair. The forelimbs first touch down in sequence, then the hind limbs.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1023/A:1005565304671</dc:source>
    </owl:Axiom>
    


