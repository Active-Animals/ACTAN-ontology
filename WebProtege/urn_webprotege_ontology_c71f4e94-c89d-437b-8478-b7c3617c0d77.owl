    <!-- http://purl.obolibrary.org/obo/ACTAN_0000895 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000895">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000144"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000428"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-20T10:26:57.013045Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Transition that unadopts and leaves a previously adopted site.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">abandoning</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">abandonment transition</rdfs:label>
        <skos:example>&quot;...the female mockingbird... may abandon her winter territory, and wander until mated.&quot;</skos:example>
        <skos:example>&quot;A. ibis...
For these few days before pairing, each male occupies a small territory in the colony, displaying on it and vigorously defending against intruders an area of two or three metres radius. It is usual for this territory to be abandoned and another nest used for nesting after a mate has been acquired.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000895"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Transition that unadopts and leaves a previously adopted site.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000895"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">abandoning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000895"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">abandonment transition</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
