        <dc:source>doi:10.1016/j.anbehav.2003.11.017</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000409"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">participation interaction</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000409"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Some taxa—particularly snakes—often travel several kilometers from activity season ranges to return to the same hibernaculum each winter. Several high-latitude species also overwinter communally, resulting in large multi-species congregations in a hibernaculum.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3354/esr01312</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000410 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000410">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000409"/>
        <rdfs:subClassOf>
