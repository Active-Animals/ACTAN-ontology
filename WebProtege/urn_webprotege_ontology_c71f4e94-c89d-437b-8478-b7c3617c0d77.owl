    <!-- http://humanbehaviourchange.org/ontology/BCIO_050685 -->

    <owl:Class rdf:about="http://humanbehaviourchange.org/ontology/BCIO_050685">
        <rdfs:subClassOf rdf:resource="http://humanbehaviourchange.org/ontology/BCIO_050783"/>
