    <!-- http://purl.obolibrary.org/obo/ACTAN_0000016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000087"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000023"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000027"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000069"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-07T07:38:33.033754Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Swimming-gait in which parallel rays in a longitudinal fin propogate a wave along the terminal edge of its membrane, by moving the rays serially from side to side.

Waves may be forward or backward and even both ways for very precise manoeuvring.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>localized anguilliform undulation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ribbon‐fin locomotion</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">ribbon-undulation gait</rdfs:label>
        <skos:example>&quot;...in weakly electric fish (e.g., ghost knifefish)... ribbon‐fin locomotion provides increased maneuverability and allows the fish to hold its body rigid while swimming. This reduces modulations of the electric field generated from the body of the fish, thus maximizing electrosensory reception for prey capture, communication, and detecting environmental cues.&quot;</skos:example>
        <skos:scopeNote>&quot;...in such forms as Amiatus and Gymnotus... the longitudinal propellor is practically parallel to the axis of motion...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000016"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Swimming-gait in which parallel rays in a longitudinal fin propogate a wave along the terminal edge of its membrane, by moving the rays serially from side to side.

Waves may be forward or backward and even both ways for very precise manoeuvring.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;In these longitudinal fins the waves are propagated by simply moving the rays from side to side serially in a method analogous to the anguilliform movement.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000016"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>localized anguilliform undulation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000016"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>ribbon‐fin locomotion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1002/jez.1819</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000016"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">ribbon-undulation gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000016"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...in weakly electric fish (e.g., ghost knifefish)... ribbon‐fin locomotion provides increased maneuverability and allows the fish to hold its body rigid while swimming. This reduces modulations of the electric field generated from the body of the fish, thus maximizing electrosensory reception for prey capture, communication, and detecting environmental cues.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1002/jez.1819</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000016"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...in such forms as Amiatus and Gymnotus... the longitudinal propellor is practically parallel to the axis of motion...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000017">
        <rdfs:subClassOf rdf:resource="http://humanbehaviourchange.org/ontology/BCIO_050416"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001564"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-06-30T10:36:22.925935Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Behavioural disposition that is realized in a behavior pattern which expresses a non-random set of structural components.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">behaviour repertoire</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>behavioural profile</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>repertory</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">repertoire-pattern</rdfs:label>
        <skos:example>&quot; Interestingly, the increased forelimb weight-bearing role observed in primates during suspensory locomotion (i.e., both below branch quadrupedal locomotion and arm-swinging) is not present in sloths. This indicates the greater forelimb weight-support is not a mechanical requirement of suspensory locomotion across all mammals, and this pattern may represent a primate-specific configuration.&quot;</skos:example>
        <skos:example>&quot;Defensive behavior in the repertoire of a basic viper includes crypsis, locomotor escape, striking, biting, and envenomation.&quot;</skos:example>
        <skos:example>&quot;Thus, zebrafish larvae have a unique repertoire of bouts reserved for hunting and produce stereotyped and dynamic sequences using these bouts.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000017"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Behavioural disposition that is realized in a behavior pattern which expresses a non-random set of structural components.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2011.0690</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000017"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">behaviour repertoire</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1963</dc:date>
        <dc:source>doi:10.1111/j.1439-0310.1963.tb01161.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000017"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>behavioural profile</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2017</dc:date>
        <dc:source>doi:10.1007/978-3-319-33774-6_5</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000017"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>repertory</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000017"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">repertoire-pattern</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000017"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot; Interestingly, the increased forelimb weight-bearing role observed in primates during suspensory locomotion (i.e., both below branch quadrupedal locomotion and arm-swinging) is not present in sloths. This indicates the greater forelimb weight-support is not a mechanical requirement of suspensory locomotion across all mammals, and this pattern may represent a primate-specific configuration.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/jzo.12455</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000017"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Defensive behavior in the repertoire of a basic viper includes crypsis, locomotor escape, striking, biting, and envenomation.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000017"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Thus, zebrafish larvae have a unique repertoire of bouts reserved for hunting and produce stereotyped and dynamic sequences using these bouts.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.cub.2019.11.022</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000624"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-02-10T10:08:41.214848Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement in which a body part is protectively inserted into a space bordered by another body part.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>tucking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>burying</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>covering up</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">tucking movement</rdfs:label>
        <skos:example>&quot;Orchard Oriole...
...the folded wing might be held lower, along side and flank, so that wing tip lay against the ventral surface of the tail, as the tail was tucked under and pressed forward.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000018"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement in which a body part is protectively inserted into a space bordered by another body part.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000018"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>tucking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000018"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
