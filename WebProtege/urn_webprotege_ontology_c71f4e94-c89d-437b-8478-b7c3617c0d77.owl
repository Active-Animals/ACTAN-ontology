    <!-- http://purl.obolibrary.org/obo/ACTAN_0000044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000409"/>
        <rdfs:subClassOf rdf:nodeID="genid298"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000111"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-07T08:49:46.790524Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Participation which involves an integrated association.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>colonial association</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">colony</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>integration</oboInOwl:hasExactSynonym>
        <rdfs:label>colony participation</rdfs:label>
        <skos:scopeNote>&quot;So we do not believe that the colonies of fish or birds are a result of lack of nesting places;... the tendency is to crowd as much as possible.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Thus, we suggest that monitoring abiotic factors such as humidity and temperature in honeybee hives could be a strategy for identifying colonies having disturbance in their normal functioning as a eusocial community, and help to find the eventual factors leading to the decline of a honeybee colony.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid298">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000577"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000044"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid298"/>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000044"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Participation which involves an integrated association.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.jstor.org/stable/986582</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Colonial associations can reach this degree of integration either via (1) increased genetic homogeneity (genetic convergence of interests), (2) increased efficiency of suppression and control of reproductive competitors (imposed convergence of interests), and/or (3) increased mutual dependence due to a common dependence on the presence of other group members, or mutually exclusive task specialization (mutualistic convergence of interests).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000044"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>colonial association</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000044"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">colony</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000044"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>integration</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000044"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>colony participation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000044"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;So we do not believe that the colonies of fish or birds are a result of lack of nesting places;... the tendency is to crowd as much as possible.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000044"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Thus, we suggest that monitoring abiotic factors such as humidity and temperature in honeybee hives could be a strategy for identifying colonies having disturbance in their normal functioning as a eusocial community, and help to find the eventual factors leading to the decline of a honeybee colony.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1371/journal.pone.0200048</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000177"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000731"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/posture"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-06-17T20:22:17.845321Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Posture that manifests in varying degrees of rigid arching and lifting of the body, legs, and tail, and in which ventral surfaces become visible.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>arched-back posture</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>unken reflex</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">unkenreflex posture</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000626"/>
        <skos:example>&quot;Fire-bellied toads (Bombina spp.), for example, assume contorted postures akin to thanatosis when attacked (the unkenreflex) which reveal bright colours warning of their deterrent taste.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000045"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Posture that manifests in varying degrees of rigid arching and lifting of the body, legs, and tail, and in which ventral surfaces become visible.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/brv.12891</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The ‘unken reflex’, named after the fire-bellied toads ‘Feuerunke’ (Löhner, 1919), is a proximate cause of deimatic behaviour but little is known about its mechanistic underpinnings. Typically only applied to amphibians, it manifests as a rigid arching or lifting of the body, legs, and/or tail in which ventral surfaces become visible and sometimes body parts are ‘hypnotically’ swayed.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000045"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>arched-back posture</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.1111/brv.12891</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000045"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>unken reflex</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.1111/brv.12891</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000045"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">unkenreflex posture</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2014</dc:date>
        <dc:source>doi:10.1016/j.cub.2014.08.051</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000045"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Fire-bellied toads (Bombina spp.), for example, assume contorted postures akin to thanatosis when attacked (the unkenreflex) which reveal bright colours warning of their deterrent taste.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.cub.2014.08.051</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000541"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-08T08:09:49.201971Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Switch which requires a functional property that only occurs when systems interact with each other and the environment.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>emergent behavior</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>emergent paradigm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>synergy</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">emergence switch</rdfs:label>
        <skos:example>&quot;...studies of overt crawling and swimming confirmed that leeches will quickly switch to a crawling mode when encountering shallow water. Furthermore, when fluid levels were ambiguous, a swim-crawl hybrid locomotor pattern emerged... Thus the decision to locomote is hierarchical, made at the level of a single higher-order descending interneuron, but the switching (and selection in this case) of various forms of locomotion is based on the integration of contextual somatosensory cues.&quot;</skos:example>
        <skos:example>&quot;...the characteristic V formations of flocks of geese... is an emergent property of the simultaneous interactions of multiple individuals, it cannot be exhibited by a single individual.&quot;</skos:example>
        <skos:scopeNote>&quot;...numerous studies have shown that tool use is accompanied by its incorporation into the neural representation of the body, and... after extensive training, neurons in monkey area F5 that used to code manual grasping, may also come to code grasps performed with a tool—independently of the hand movements involved. Together, these findings suggest that the capacity to use such simple tools might emerge from experience-dependent changes within cerebral areas involved in the control of manual actions.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000046"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Switch which requires a functional property that only occurs when systems interact with each other and the environment.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1126/science.288.5463.100</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;These systems possess functional properties that emerge only when they interact with each other and the environment.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000046"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>emergent behavior</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2008</dc:date>
        <dc:source>doi:10.1140/epjst/e2008-00633-y</dc:source>
        <skos:scopeNote>&quot;...lead to behavior... in an emergent way.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000046"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>emergent paradigm</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>doi:10.1098/rspb.1998.0424</dc:source>
        <rdfs:comment>&quot;...a different locomotion paradigm emerges...&quot;</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000046"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>synergy</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>https://core.ac.uk/download/pdf/85255156.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000046"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">emergence switch</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000046"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...studies of overt crawling and swimming confirmed that leeches will quickly switch to a crawling mode when encountering shallow water. Furthermore, when fluid levels were ambiguous, a swim-crawl hybrid locomotor pattern emerged... Thus the decision to locomote is hierarchical, made at the level of a single higher-order descending interneuron, but the switching (and selection in this case) of various forms of locomotion is based on the integration of contextual somatosensory cues.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fnbeh.2010.00049</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000046"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...the characteristic V formations of flocks of geese... is an emergent property of the simultaneous interactions of multiple individuals, it cannot be exhibited by a single individual.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.anbehav.2009.03.018</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000046"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...numerous studies have shown that tool use is accompanied by its incorporation into the neural representation of the body, and... after extensive training, neurons in monkey area F5 that used to code manual grasping, may also come to code grasps performed with a tool—independently of the hand movements involved. Together, these findings suggest that the capacity to use such simple tools might emerge from experience-dependent changes within cerebral areas involved in the control of manual actions.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s00426-009-0242-2</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000047">
        <rdfs:subClassOf rdf:resource="http://humanbehaviourchange.org/ontology/BCIO_050416"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PCO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-24T20:24:11.385078Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Behavioural disposition that is realized in a dynamically stable spatio-temporal behavior pattern.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">collective motion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>group self-structuring</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>chevron formation</oboInOwl:hasNarrowSynonym>
        <rdfs:label>collective-formation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000411"/>
        <skos:example>&quot;Locust aggregations will build into major outbreaks only if locally gregarized populations remain together and move collectively into neighboring areas of habitat, where they can recruit further locusts to the growing band.&quot;</skos:example>
        <skos:scopeNote>&quot;The spontaneous emergence of pattern formation is ubiquitous in nature, often arising as a collective phenomenon from interactions among a large number of individual constituents or sub-systems...

...collective properties, such as the spatio-temporal configurations exhibited, may be robust to exactly how behavioral tendencies such as repulsion, alignment and attraction are mediated.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000047"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Behavioural disposition that is realized in a dynamically stable spatio-temporal behavior pattern.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1371/journal.pcbi.1002915</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000047"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">collective motion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2006</dc:date>
        <dc:source>doi:10.1126/science.1125142</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000047"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>group self-structuring</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1371/journal.pcbi.1002915</dc:source>
        <skos:scopeNote>&quot;...self-structuring properties of groups...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000047"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>chevron formation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1093/beheco/12.5.534</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000047"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>collective-formation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000047"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Locust aggregations will build into major outbreaks only if locally gregarized populations remain together and move collectively into neighboring areas of habitat, where they can recruit further locusts to the growing band.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.1125142</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000047"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The spontaneous emergence of pattern formation is ubiquitous in nature, often arising as a collective phenomenon from interactions among a large number of individual constituents or sub-systems...

...collective properties, such as the spatio-temporal configurations exhibited, may be robust to exactly how behavioral tendencies such as repulsion, alignment and attraction are mediated.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1371/journal.pcbi.1002915</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000047"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001654"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-27T11:04:50.31077Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Formation in which individuals aggregate but are locally and globally unaligned.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">disordered motion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>disordered movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>milling</oboInOwl:hasRelatedSynonym>
        <rdfs:label>disorder formation</rdfs:label>
        <skos:example>&quot;Thalassoma cupido...
The groups observed at the spawning site may be best described as loose aggregations of milling fish. The aggregating fish swim an irregular path, frequently changing direction so that individual members often vary in their orientation.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000048"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Formation in which individuals aggregate but are locally and globally unaligned.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1371/journal.pcbi.1002915</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;For example, models representing local repulsion, directional alignment and longer-range attraction among individuals predict that groups in which individuals follow these behavioral rules exhibit only three collective states; a swarm state in which individuals aggregate but are locally and globally disordered, a milling state in which individuals have a high degree of alignment with local neighbors but overall the group exhibits a rotating milling formation (or torus, in threedimensional space) and a polarized state in which individuals tend to be aligned with each other over a long range and consequently the group experiences net movement...

Individuals reaching the wall slow down and tend to become disordered (unaligned) and the group can transition into the swarm state.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000048"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">disordered motion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2006</dc:date>
        <dc:source>doi:10.1126/science.1125142</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000048"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>disordered movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2006</dc:date>
        <dc:source>doi:10.1126/science.1125142</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000048"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>milling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000048"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>disorder formation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000048"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Thalassoma cupido...
The groups observed at the spawning site may be best described as loose aggregations of milling fish. The aggregating fish swim an irregular path, frequently changing direction so that individual members often vary in their orientation.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000049 -->

