        <oboInOwl:hasDefinition>Contraction that results from narrowing contracting.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">narrowed</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">narrow contraction</rdfs:label>
