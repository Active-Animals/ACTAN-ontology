    <!-- http://purl.obolibrary.org/obo/ACTAN_0000438 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://humanbehaviourchange.org/ontology/BCIO_050654"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T11:16:09.991698Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Interaction which attempts to change the behaviour of another.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">influence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>managing</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">influence interaction</rdfs:label>
        <skos:scopeNote>&quot;For some the ‘communication as information’ vs ‘communication as manipulation’ debate is largely one of semantics, for others communication involves both information and manipulation, and for others the debate raises some fundamental ideas about how communicative interactions actually influence behavior and shape interactions and relationships among individuals.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;More complex groups often demand increased social cognition in group members; therefore, in such groups we should expect strong selection for enhanced communicative systems that provide individuals diverse behavioral ways to assess and manage the behavior of others.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Interaction which attempts to change the behaviour of another.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Tilapia natalensis...
Inviting turns into leading when the intruder does not change its attitude. It apparently has no influence on the behaviour of the male whether the intruder shows the non-reproductive markings or the female reproductive markings.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">influence</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>managing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.3389/fetho.2022.1066186</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">influence interaction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
        <skos:scopeNote>&quot;Other kinds of interactions may influence the choice of alternatives.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;For some the ‘communication as information’ vs ‘communication as manipulation’ debate is largely one of semantics, for others communication involves both information and manipulation, and for others the debate raises some fundamental ideas about how communicative interactions actually influence behavior and shape interactions and relationships among individuals.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2022.1066186</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;More complex groups often demand increased social cognition in group members; therefore, in such groups we should expect strong selection for enhanced communicative systems that provide individuals diverse behavioral ways to assess and manage the behavior of others.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2022.1066186</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000439 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000382"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000414"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T11:18:24.420726Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Influence that signals a potential danger.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">warning</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">warning influence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000376"/>
        <skos:scopeNote>&quot;It is admitted that the rattlesnake has a poison-fang for its own defence and for the destruction of its prey; but some authors suppose that at the same time this snake is furnished with a rattle for its own injury, namely, to warn its prey to escape. I would almost as soon believe that the cat curls the end of its tail when preparing to spring, in order to warn the doomed mouse.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;There is also evidence that alarm pheromones found in the discharge might serve to warn conspecifics of a predator threat...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000439"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Influence that signals a potential danger.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The earliest and most currently accepted hypothesis is that the rattle evolved as an aposematic signal to warn potential predators and large, grazing ungulates that might step on the otherwise unnoticed snake of its venomousness and potential danger.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000439"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">warning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000439"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">warning influence</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000439"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;It is admitted that the rattlesnake has a poison-fang for its own defence and for the destruction of its prey; but some authors suppose that at the same time this snake is furnished with a rattle for its own injury, namely, to warn its prey to escape. I would almost as soon believe that the cat curls the end of its tail when preparing to spring, in order to warn the doomed mouse.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000439"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;There is also evidence that alarm pheromones found in the discharge might serve to warn conspecifics of a predator threat...&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000440 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000440">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000439"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000375"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T11:18:56.782875Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Warning that signals alarm of a predator threat.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>conspecific alarm signal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>shreckstoff</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">predator-alarm warning</rdfs:label>
        <skos:closeMatch>NBO:0020015</skos:closeMatch>
        <skos:example>&quot;There is also evidence that alarm pheromones found in the discharge might serve to warn conspecifics of a predator threat (Graves and Duvall, 1988), parallel to the shreckstoff (Mathis and Smith, 1993) found in fishes and chemical communication of stress found in larval salamanders and tadpoles.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000440"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Warning that signals alarm of a predator threat.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000440"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>conspecific alarm signal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000440"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>shreckstoff</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000440"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">predator-alarm warning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
        <skos:scopeNote>&quot;...alarm pheromones found in the discharge might serve to warn conspecifics of a predator threat...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000440"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;There is also evidence that alarm pheromones found in the discharge might serve to warn conspecifics of a predator threat (Graves and Duvall, 1988), parallel to the shreckstoff (Mathis and Smith, 1993) found in fishes and chemical communication of stress found in larval salamanders and tadpoles.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000441 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000441">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000414"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T11:22:19.499717Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Influence which tends to cause another animal to reduce its distance.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>attracting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">attraction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>advertising</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>close proximity display</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>long distance communicative display</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>short distance display</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">appetitive</oboInOwl:hasRelatedSynonym>
        <rdfs:label>attraction influence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000326"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <skos:example>&quot;...T.bifasciatum &quot;loopings&quot; are performed even in the absence of females and apparently serve to announce the presence and location of the territorial male.&quot;</skos:example>
        <skos:example>&quot;A chimpanzee shakes a branch to attract attention or to court.&quot;</skos:example>
        <skos:example>&quot;Amongst birds, the contest is often of a more peaceful character. All those who have attended to the subject, believe that there is the severest rivalry between the males of many species to attract by singing the females. The rock-thrush of Guiana, birds of Paradise, and some others, congregate; and successive males display their gorgeous plumage and perform strange antics before the females, which standing by as spectators, at last choose the most attractive partner.&quot;</skos:example>
        <skos:relatedMatch>NBO:0000280</skos:relatedMatch>
        <skos:scopeNote>&quot;...Diamond (1985) speculated on the possible advantages of luminescent tissue in attracting prey...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Our results contradict previous ideas that the sexual pheromone of receptive female guppies increases courtship and other mating behaviours in males. We suggest that the main function of this pheromone is to attract males to receptive females rather than to stimulate an increase in their mating effort.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000441"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Influence which tends to cause another animal to reduce its distance.</owl:annotatedTarget>
        <dc:source>doi:10.2307/4083155</dc:source>
        <skos:scopeNote>&quot;Distance-reducing displays are particularly important in promoting social bonds between members of a pair, young and parent, etc.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000441"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>attracting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000441"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">attraction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000441"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>advertising</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000441"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>close proximity display</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000441"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>long distance communicative display</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000441"/>
