    <!-- http://purl.obolibrary.org/obo/ACTAN_0000391 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000391">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000271"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000096"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/technical_realizing_routine"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-05T11:40:23.106063Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Technic in which an artifact is pulled apart.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">destruction</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">destruction technic</rdfs:label>
        <skos:example>&quot;...female Superb Lyrebirds (Menura novaehollandiae), a solitary breeding species with very low fecundity and uniparental care, destroy the nests of rival females.&quot;</skos:example>
        <skos:example>&quot;Male bowerbirds construct bowers from interwoven sticks and decorate the fl oor of their courtship arena with all manner of colorful objects, each assembled into discrete piles with great precision, including berries, shells, and even human-made objects, like bottle caps or poker chips. Sometimes these ornamental objects are stolen by competing males, who even attempt to destroy the bowers of rivals.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000391"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Technic in which an artifact is pulled apart.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:isDefinedBy>doi:10.1163/1568539X-00003574</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;By contrast, the nest destruction behaviour in the video shows a female standing on the dome of the nest and pulling it apart with her feet with her head in an upright position.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000391"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">destruction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000391"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">destruction technic</owl:annotatedTarget>
        <dc:source>https://orcid.org/0000-0002-4277-2151</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000391"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...female Superb Lyrebirds (Menura novaehollandiae), a solitary breeding species with very low fecundity and uniparental care, destroy the nests of rival females.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/1568539X-00003574</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000391"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Male bowerbirds construct bowers from interwoven sticks and decorate the fl oor of their courtship arena with all manner of colorful objects, each assembled into discrete piles with great precision, including berries, shells, and even human-made objects, like bottle caps or poker chips. Sometimes these ornamental objects are stolen by competing males, who even attempt to destroy the bowers of rivals.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.cub.2021.09.082</dc:source>
    </owl:Axiom>
    


