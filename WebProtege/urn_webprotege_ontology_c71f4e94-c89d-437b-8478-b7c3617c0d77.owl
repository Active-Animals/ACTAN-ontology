    <!-- http://purl.obolibrary.org/obo/ACTAN_0000291 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000291">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000308"/>
        <rdfs:subClassOf rdf:nodeID="genid2123"/>
        <rdfs:subClassOf rdf:nodeID="genid2125"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-08T07:06:57.377805Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Residence that monopolizes a defined area in a habitat by dominating trespassers.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">territorialism</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">territorialism residence</rdfs:label>
        <skos:example>&quot;...the almost invariable occurrence of wing-flaps, in both chaser and chased bird, immediately after territorial encounters between male Velvet Scoters (Melanitta f. fusca).&quot;</skos:example>
        <skos:example>&quot;For example, young-of-the-year Atlantic salmon defend smaller foraging territories and exhibit reduced reaction distances towards standardised predation threats (i.e. reduced perceived predation risk) in complex versus more homogeneous habitats.&quot;</skos:example>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid2123">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000387"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid2125">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000414"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid2123"/>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid2125"/>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Residence that monopolizes a defined area in a habitat by dominating trespassers.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Territorial behavior: Monopolization and aggressive defense of a defined area in a habitat/tank (e.g., spawning sites are a commonly defended territory in zebrafish). Trespassers into the territory may be chased or bitten by the dominant fish, or can ‘fight’ to challenge its dominance.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">territorialism</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">territorialism residence</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...the almost invariable occurrence of wing-flaps, in both chaser and chased bird, immediately after territorial encounters between male Velvet Scoters (Melanitta f. fusca).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;For example, young-of-the-year Atlantic salmon defend smaller foraging territories and exhibit reduced reaction distances towards standardised predation threats (i.e. reduced perceived predation risk) in complex versus more homogeneous habitats.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1238167</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000292 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000292">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000290"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000576"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-08T07:07:19.687309Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Localization that involves a place of safety.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">refuge</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>cover</oboInOwl:hasRelatedSynonym>
        <rdfs:label>refuge localization</rdfs:label>
        <skos:closeMatch>NBO:0020059</skos:closeMatch>
        <skos:example>&quot;The second and third instances, on 11 August 1977 and 7 August 1979, respectively, both involved chases of Lapland Longspurs (Calcarius lapponicus). In each case the longspur sought refuge near a gravel road and did not flush from the grass despite rapid stoops by both jaegers, who soon gave up the chase.&quot;</skos:example>
        <skos:scopeNote>&quot;For this analysis, vegetation types were classified as ‘grazing’, which were areas dominated by open grassland, ‘cover’, which were areas dominated by trees or shrubs, and ‘grazing-cover’, which were areas with a mixture of grassland and discrete patches of refuge habitat, either woodland edges (obstructive cover) or flooded pans (protective cover into which herbivores can retreat when attacked).&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000292"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Localization that involves a place of safety.</owl:annotatedTarget>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
        <skos:scopeNote>&quot;When the nest is slightly disturbed, the slaves occasionally come out, and like their masters are much agitated and defend the nest: when the nest is much disturbed and the larvæ and pupæ are exposed, the slaves work energetically with their masters in carrying them away to a place of safety.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000292"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">refuge</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1973</dc:date>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000292"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>cover</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000292"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>refuge localization</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000292"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The second and third instances, on 11 August 1977 and 7 August 1979, respectively, both involved chases of Lapland Longspurs (Calcarius lapponicus). In each case the longspur sought refuge near a gravel road and did not flush from the grass despite rapid stoops by both jaegers, who soon gave up the chase.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/4161407</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000292"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;For this analysis, vegetation types were classified as ‘grazing’, which were areas dominated by open grassland, ‘cover’, which were areas dominated by trees or shrubs, and ‘grazing-cover’, which were areas with a mixture of grassland and discrete patches of refuge habitat, either woodland edges (obstructive cover) or flooded pans (protective cover into which herbivores can retreat when attacked).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1231780</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000293 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000293">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000292"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-08T07:07:34.974726Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Refuge which provides a risky environment for unwanted interactions.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">protected station</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>protection</oboInOwl:hasExactSynonym>
        <rdfs:label>protection refuge</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000378"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000834"/>
        <skos:example>&quot;...when a cirripede is parasitic within another and is thus protected, it loses more or less completely its own shell or carapace.&quot;</skos:example>
        <skos:example>&quot;Another advantage a sharksucker gains from being attached to a shark lays in its protection from other predators.&quot;</skos:example>
        <skos:example>&quot;In feral horses, Equus caballus, females living in nonterritorial harems (where harassment is relatively common) are more frequently disturbed by males while feeding and show lower breeding success than females associated with territorial males where territory holders provide effective protection against other males.&quot;</skos:example>
        <skos:scopeNote>&quot;...larger snakes and cooler snakes exhibited more body rubbing behavior, more open-mouth strikes, more tail vibration, more coiled body postures, positioned their tails more lateral to the predator, and had more elevated and protected heads compared with smaller and warmer snakes.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;For this analysis, vegetation types were classified as ‘grazing’, which were areas dominated by open grassland, ‘cover’, which were areas dominated by trees or shrubs, and ‘grazing-cover’, which were areas with a mixture of grassland and discrete patches of refuge habitat, either woodland edges (obstructive cover) or flooded pans (protective cover into which herbivores can retreat when attacked).&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000293"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Refuge which provides a risky environment for unwanted interactions.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1111/brv.12934</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000293"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
