        <oboInOwl:hasDefinition>Zipping in which the bill touches the breast.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">breast-touching</oboInOwl:hasExactSynonym>
        <rdfs:label>breast-zipping ethotype</rdfs:label>
        <skos:example>&quot;...in Mallard drakes during the introductory stage of social courtship on the water.&quot;</skos:example>
