        <oboInOwl:hasDefinition>Regime pattern in which a situation evokes suppression of movement.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">reduced activity</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">reduced-activity pattern</rdfs:label>
        <skos:example>&quot;When satiated, C. elegans stop eating and moving and become quiescent, exhibiting a behavioral sequence of satiety similar to that observed in mammals.&quot;</skos:example>
    </owl:Class>
