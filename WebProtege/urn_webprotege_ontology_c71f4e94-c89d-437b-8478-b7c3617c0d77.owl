                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001813"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T14:50:50.629931Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Nontooling that uses an excavation to alter sound and vibrational properties.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">resonating</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">resonating nontooling</rdfs:label>
        <skos:example>&quot;Burrows and other excavated dwellings have been hypothesized to act as potential resonating chambers.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000427"/>
