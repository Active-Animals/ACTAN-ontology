        <oboInOwl:creation_date>2025-03-24T21:05:27.546437Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement that results from abducting.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">abducted</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>held out</oboInOwl:hasExactSynonym>
        <rdfs:label>abduction placement</rdfs:label>
        <skos:example>&quot;Badis badis...
Movement suppression... The already abducted fins become even more tautly spread.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000639"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Placement that results from abducting.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000639"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
