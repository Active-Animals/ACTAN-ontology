    <!-- http://purl.obolibrary.org/obo/ACTAN_0000628 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000628">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001035"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-11T09:29:52.293806Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>hold fast</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Kinetics that holds an object using voluntary movements, by exerting force.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>clinging</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">grasping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>grip</oboInOwl:hasExactSynonym>
        <rdfs:label>grip kinetics</rdfs:label>
        <skos:example>&quot;Penguins have spines only on their dorsal tongue, which allow them to better grip and swallow slippery fish.&quot;</skos:example>
        <skos:example>&quot;The benthic longhorn sculpin demonstrates different use of dorsal and ventral fin regions during both station holding and swimming behaviors. During station holding, the ventral pectoral fin rays are splayed and contact the bottom surface of the tank, anterior to the dorsal region of the fin, and are believed to be to be gripping the bottom.&quot;</skos:example>
        <skos:scopeNote>&quot;Octopus arms have suction-cup grippers only on the ventral side.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000628"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>hold fast</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
