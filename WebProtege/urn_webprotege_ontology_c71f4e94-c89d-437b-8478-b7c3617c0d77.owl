    <!-- http://purl.obolibrary.org/obo/ACTAN_0000298 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000342"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001306"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-08T07:10:09.967598Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>overwintering</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Thermoregulation that requires a reduction of metabolic mechanisms with the consequent decrease in body temperature and consumption of O2.&quot;</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">hibernation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>brumation</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">hibernation thermoregulation</rdfs:label>
        <skos:example>&quot;In very cold water when Chaenobryttus is in a state of semi-hibernation they may sometimes be observed with no fin movement at all and with both sets of paired fins securely pressed against the sides.&quot;</skos:example>
        <skos:example>&quot;South-facing outcrops are, therefore, thermally superior to C. horridus, permitting potentially longer activity time and shallower hibernating depths (i.e. more available hibernacula).&quot;</skos:example>
        <skos:example>&quot;The metabolic cycle of brown bears, during which body mass variation occurs, can be divided into three stages: (a) gain of lean mass during spring, (b) accumulation of fat during hyperphagia, and (c) weight loss during hibernation. The decrease in body temperature during hibernation ranges from 3 to 5°C with respect to the body temperature of the active state (Hissa, 1997) and begins on average 13 days before den entry, while its recovery begins 63 days before den emergency...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000298"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>overwintering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1146/annurev-ecolsys-102209-144712</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000298"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Thermoregulation that requires a reduction of metabolic mechanisms with the consequent decrease in body temperature and consumption of O2.&quot;</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1002/ece3.6372</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Hibernation requires a reduction of metabolic mechanisms with the consequent decrease in body temperature and consumption of O2.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000298"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">hibernation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...a state of semi-hibernation...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000298"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>brumation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2024</dc:date>
        <dc:source>doi:10.3354/esr01312</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000298"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">hibernation thermoregulation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000298"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In very cold water when Chaenobryttus is in a state of semi-hibernation they may sometimes be observed with no fin movement at all and with both sets of paired fins securely pressed against the sides.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000298"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;South-facing outcrops are, therefore, thermally superior to C. horridus, permitting potentially longer activity time and shallower hibernating depths (i.e. more available hibernacula).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3354/esr01312</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000298"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The metabolic cycle of brown bears, during which body mass variation occurs, can be divided into three stages: (a) gain of lean mass during spring, (b) accumulation of fat during hyperphagia, and (c) weight loss during hibernation. The decrease in body temperature during hibernation ranges from 3 to 5°C with respect to the body temperature of the active state (Hissa, 1997) and begins on average 13 days before den entry, while its recovery begins 63 days before den emergency...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1002/ece3.6372</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000299 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000299">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000752"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000374"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-08T07:10:32.997121Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Translocation in which periodically constrained behaviour turns into a long range directed movement.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">migration</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">migration translocation</rdfs:label>
        <skos:closeMatch>NBO:0070001</skos:closeMatch>
        <skos:example>&quot;...every one understands what is meant, when it is said that instinct impels the cuckoo to migrate...&quot;</skos:example>
        <skos:scopeNote>&quot;...we know from Mr. J. M. Jones’s admirable account of Bermuda, that very many North American birds, during their great annual migrations, visit either periodically or occasionally this island.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000299"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Translocation in which periodically constrained behaviour turns into a long range directed movement.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/1365-2656.12379</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Spatial awareness and memory is a fundamental property of movement, perhaps the clearest example of this is seasonal migration where seasonally constrained behaviour turns into a long range directed behaviour.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000299"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">migration</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000299"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">migration translocation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000299"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
