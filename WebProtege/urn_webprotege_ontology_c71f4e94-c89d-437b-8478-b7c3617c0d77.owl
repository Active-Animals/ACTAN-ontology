        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">flag placement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000955 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000955">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000148"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-12T16:07:11.427994Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Stabilizing which provides dynamic stability in a fluid by the use of mobile control surfaces.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>trim control</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">trim stabilizing</rdfs:label>
        <skos:example>&quot;The shrimpfish use both paddling and hydrostatic control to maintain its position and orientation. Paddling can be used to actively stabilize the body or create maneuvers. In particular, the continuous motions of the pectoral fins could resist perturbations due to changes in flow, which can occur suddenly. Such disturbances can transpire due to wave actions, currents, interactions with conspecifics, and predators.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000955"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Stabilizing which provides dynamic stability in a fluid by the use of mobile control surfaces.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/iob/obz025</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000955"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>trim control</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2019</dc:date>
        <dc:source>doi:10.1093/iob/obz025</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000955"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">trim stabilizing</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000955"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The shrimpfish use both paddling and hydrostatic control to maintain its position and orientation. Paddling can be used to actively stabilize the body or create maneuvers. In particular, the continuous motions of the pectoral fins could resist perturbations due to changes in flow, which can occur suddenly. Such disturbances can transpire due to wave actions, currents, interactions with conspecifics, and predators.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/iob/obz025</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000956 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000956">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000689"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001855"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-16T15:02:42.238487Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Pitch in which the longitudinal axis of a body parallels the horizontal plane.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>horizontal position</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">horizontal trim</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>in trim</oboInOwl:hasNarrowSynonym>
        <rdfs:label>horizontal pitch</rdfs:label>
        <skos:scopeNote>&quot;When the fore and aft of a free-floating body are at the same level so that the gravitational and buoyancy forces are balanced, such an orientation is said to be in trim, which maintains longitudinal stability.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000956"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Pitch in which the longitudinal axis of a body parallels the horizontal plane.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/iob/obz025</rdfs:isDefinedBy>
        <skos:scopeNote>In trim, the longitudinal axis of a body would parallel the horizontal plane.</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000956"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>horizontal position</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000956"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget xml:lang="en">horizontal trim</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2019</dc:date>
        <dc:source>doi:10.1093/iob/obz025</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000956"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>in trim</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2019</dc:date>
        <dc:source>doi:10.1093/iob/obz025</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000956"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>horizontal pitch</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000956"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;When the fore and aft of a free-floating body are at the same level so that the gravitational and buoyancy forces are balanced, such an orientation is said to be in trim, which maintains longitudinal stability.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/iob/obz025</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000957 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000957">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000689"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002328"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-16T15:02:52.749616Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Pitch which lowers the anterior angle below horizontal.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>head down</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>negative trim</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">negative pitch</rdfs:label>
        <skos:example>&quot;The trumpetfish (genus Aulostomus, family Aulostomidae, suborder Syngnathoidei) uses a head-down vertical orientation when hunting.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000957"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Pitch which lowers the anterior angle below horizontal.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000957"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>head down</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000957"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>negative trim</owl:annotatedTarget>
        <dc:contributor>Directly inferred.</dc:contributor>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000957"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">negative pitch</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000957"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The trumpetfish (genus Aulostomus, family Aulostomidae, suborder Syngnathoidei) uses a head-down vertical orientation when hunting.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/iob/obz025</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000958 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000958">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000689"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002327"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-16T15:03:00.97164Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Trim which raises the anterior angle above horizontal.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>head up</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">positive trim</oboInOwl:hasNarrowSynonym>
        <rdfs:label>positive pitch</rdfs:label>
        <skos:example>&quot;Despite the small size of ducklings which places severe limitations on swimming velocity due to hull speed, speeds above hull speed are accomplished by replacing the displacement hull configuration with a planing hull.&quot;</skos:example>
        <skos:example>&quot;The elongate oarfish (Regalecus glesne) was observed to swim in the open ocean in a head-up vertical orientation.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000958"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Trim which raises the anterior angle above horizontal.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://www-dr.wcupa.edu/sciences-mathematics/biology/fFish/documents/1998ImaginativeDragReduction.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000958"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>head up</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000958"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget xml:lang="en">positive trim</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>https://www-dr.wcupa.edu/sciences-mathematics/biology/fFish/documents/1998ImaginativeDragReduction.pdf</dc:source>
        <skos:scopeNote>&quot;...a positive angle of trim...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000958"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>positive pitch</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000958"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Despite the small size of ducklings which places severe limitations on swimming velocity due to hull speed, speeds above hull speed are accomplished by replacing the displacement hull configuration with a planing hull.&quot;</owl:annotatedTarget>
        <dc:source>https://www-dr.wcupa.edu/sciences-mathematics/biology/fFish/documents/1998ImaginativeDragReduction.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000958"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The elongate oarfish (Regalecus glesne) was observed to swim in the open ocean in a head-up vertical orientation.&quot;</owl:annotatedTarget>
