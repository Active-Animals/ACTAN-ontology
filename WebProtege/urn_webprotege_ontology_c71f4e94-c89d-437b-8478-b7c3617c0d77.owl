    <!-- http://purl.obolibrary.org/obo/ACTAN_0000640 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000640">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000740"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-24T21:05:37.183185Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>closed</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Placement that results from furling.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>loosely spread</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>moderately spread</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>compressed</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>depressed</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">furl placement</rdfs:label>
        <skos:scopeNote>&quot;At low swimming speeds, up to approximately 1 TL s-1, boxfish swam using combinations of pectoral and anal fin motions only. The dorsal and caudal fins were typically furled but were occasionally used for single beats.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000640"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>closed</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">doi:10.1163/156853981X00220</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000640"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Placement that results from furling.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000640"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>loosely spread</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000640"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>moderately spread</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000640"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>compressed</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000640"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>depressed</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000640"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">furl placement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000640"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;At low swimming speeds, up to approximately 1 TL s-1, boxfish swam using combinations of pectoral and anal fin motions only. The dorsal and caudal fins were typically furled but were occasionally used for single beats.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000641 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000641">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000086"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000173"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000929"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-03T11:27:48.881284Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Interfacing-regime in which upward impetus involves a combination of a forceful propulsor motion into the new medium, and a recoil push off the substrate.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>flying away</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>flying up</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>take off</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">taking off</oboInOwl:hasExactSynonym>
        <rdfs:label>take-off regime</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000232"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000234"/>
        <skos:example>&quot;A. ibis... takeoff... sequence of skeletal movements is as follows: legs begin to bend, neck is partly retracted and forepart of the body lowered until the main body axis is about 30 [degrees] above the horizontal, simultaneously the wings are raised and extended and as they beat down the legs are extended again.&quot;</skos:example>
        <skos:example>&quot;Terns, and several Waders (Godwit, Plovers) stretch the wings and point them upward before taking off. In the actual take off the upward impetus is chiefly effected by the forceful down stroke of the wings.&quot;</skos:example>
        <skos:scopeNote>&quot;While the structure and orientation of gorgonians that is adapted for capturing plankton, may also provide gobies a take-off platform to access food in the water column.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000641"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Interfacing-regime in which upward impetus involves a combination of a forceful propulsor motion into the new medium, and a recoil push off the substrate.</owl:annotatedTarget>
