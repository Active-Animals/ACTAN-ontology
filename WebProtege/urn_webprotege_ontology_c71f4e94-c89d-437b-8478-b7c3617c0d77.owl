    <!-- http://purl.obolibrary.org/obo/ACTAN_0000766 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000766">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000678"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000023"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-29T11:52:47.917816Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flick that involves a wing.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">wing-flick</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">wing-flicking</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">wing flick</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000765"/>
        <skos:example>&quot;...the peacock butterfly continually flicked its wings to hide and reveal its eyespots.&quot;</skos:example>
        <skos:example>&quot;In wing flicking, a heron walking slowly in an upright posture suddenly extends and retracts wings in a flicking action usually repeated several times.&quot;</skos:example>
        <skos:scopeNote>&quot;In view of the similarity in form between the Wing-flick and a wing-shake I suggest that this comfort movement may represent the true origin;&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000766"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flick that involves a wing.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.jstor.org/stable/4084834</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In wing flicking, a heron walking slowly in an upright posture suddenly extends and retracts wings in a flicking action usually repeated several times.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000766"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">wing-flick</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
