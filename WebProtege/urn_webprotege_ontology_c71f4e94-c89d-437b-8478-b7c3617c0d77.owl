        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-30T09:15:58.347509Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Skip gait that involves symmetric bipedal skipping, and in which the forward foot alternates between strides, landing with the trailing foot just a fraction of a second before the leading foot, and pushing off with each foot as it hits.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">bilateral skipping</oboInOwl:hasExactSynonym>
        <rdfs:label>bilateral-skip gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000213"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Skip gait that involves symmetric bipedal skipping, and in which the forward foot alternates between strides, landing with the trailing foot just a fraction of a second before the leading foot, and pushing off with each foot as it hits.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1098/rspb.1998.0424</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000213"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">bilateral skipping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>doi:10.1098/rspb.1998.0424</dc:source>
    </owl:Axiom>
