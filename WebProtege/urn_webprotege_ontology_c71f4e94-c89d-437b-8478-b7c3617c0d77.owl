    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000326"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;A young, not recently fed, Badis badis catches a Daphnia in the following way. It approaches the prey slowly by sculling forward.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000326"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;For example, observations by Tinbergen and his co-workers showed that a female Black-headed Gull approached a hidden male immediately after an &quot;Oblique-cum-Long-Call&quot; in 13 out of 16 cases; when she failed to do so she was engaged in squabbles with another bird. The female did not approach the male when he was not calling. Thus one can conclude that the function of the call is to induce the female to approach.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
