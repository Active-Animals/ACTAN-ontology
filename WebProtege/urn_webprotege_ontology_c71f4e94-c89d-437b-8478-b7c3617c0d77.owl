        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-27T16:45:26.507579Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Climbing gait in which the forelimbs grasp a support as the hindlimbs are gathered underneath the body by flexion of the knee, hip, and spine; extension of the hindlimbs and back push the body upward.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>bear climbing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">pulse climb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>shinny</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vertical bound</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>trunk climb</oboInOwl:hasNarrowSynonym>
        <rdfs:label>shinny gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000500"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Climbing gait in which the forelimbs grasp a support as the hindlimbs are gathered underneath the body by flexion of the knee, hip, and spine; extension of the hindlimbs and back push the body upward.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/BF02381373</rdfs:isDefinedBy>
    </owl:Axiom>
    <owl:Axiom>
