    <!-- http://purl.obolibrary.org/obo/ACTAN_0000932 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000932">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000939"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002102"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-02T10:51:30.985815Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Protraction that results from forelimb protracting.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>humerus protracted</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">forelimb protraction</rdfs:label>
        <skos:example>&quot;...it is likely that two-toed sloths are controlling their center of mass position through the mechanism... in which interlimb coordination is timed so that a protracted propulsive forelimb early in its support phase is synchronized with a retracted ipsilateral braking hind limb late in its support phase.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000932"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Protraction that results from forelimb protracting.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000932"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>humerus protracted</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
        <skos:scopeNote>&quot;...humerus was protracted...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000932"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">forelimb protraction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2019</dc:date>
        <dc:source>doi:10.1002/ajp.23055</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000932"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...it is likely that two-toed sloths are controlling their center of mass position through the mechanism... in which interlimb coordination is timed so that a protracted propulsive forelimb early in its support phase is synchronized with a retracted ipsilateral braking hind limb late in its support phase.&quot;</owl:annotatedTarget>
