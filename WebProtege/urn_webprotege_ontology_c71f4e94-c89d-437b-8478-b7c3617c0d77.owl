    <!-- http://purl.obolibrary.org/obo/ACTAN_0000731 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000731">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000809"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002208"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:nodeID="genid5524"/>
        <terms:conformsTo>https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality</terms:conformsTo>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-28T09:03:19.500382Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Arch that has an axial concavity, dorsally orientated, in the sagittal plane.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>retroflexed motion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>retroflexing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>retroflexure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>upwards arched</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vertically arched</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>extended</oboInOwl:hasRelatedSynonym>
        <rdfs:label>retroflexure arch</rdfs:label>
        <skos:example>&quot;...intertidal benthic gobies performed ASR in shallow water... in an arched position with the head tilted up, the snout emersed and the mouth at the water surface, with the body resting on the pelvic, anal and caudal fins...&quot;</skos:example>
        <skos:example>&quot;A large female N. micropogon typically arched her anterior body about 30° from the substrate, whereas a small female arched 60-90°.&quot;</skos:example>
        <skos:example>&quot;The horizontal fluke of the whale may be brought into play to further control forward pitch or even to extend the head and back.&quot;</skos:example>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid5524">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002495"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000731"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid5524"/>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
        <skos:scopeNote>&quot;The female’s motion at the end of her run (i.e., frontal head pitch and sagittal twist) is termed “retroflexure”...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000731"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Arch that has an axial concavity, dorsally orientated, in the sagittal plane.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.198.1.79</dc:source>
