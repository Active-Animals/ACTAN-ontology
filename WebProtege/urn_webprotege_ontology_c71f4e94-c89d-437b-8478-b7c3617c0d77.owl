    <!-- http://purl.obolibrary.org/obo/ACTAN_0000816 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000816">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000553"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002486"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-03T13:53:09.358036Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Condition switch when an individual anticipates that the act will be reciprocated.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym xml:lang="en">altruism</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mutual grooming</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">altruism switch</rdfs:label>
        <skos:example>&quot;Mutual grooming. Two chimpanzees groom each other simultaneously.&quot;</skos:example>
        <skos:relatedMatch>NBO:0000288</skos:relatedMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000816"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Condition switch when an individual anticipates that the act will be reciprocated.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/beheco/12.5.534</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;When reciprocal altruism is involved, individuals anticipate that the act will be reciprocated.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000816"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">altruism</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000816"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>mutual grooming</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000816"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">altruism switch</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
