        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:label>increased efficacy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0015009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0015009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001547"/>
        <oboInOwl:hasDefinition>Definition: A quality inhering in air by virtue of the partial pressure exerted by the bearer&apos;s water vapour content.</oboInOwl:hasDefinition>
        <rdfs:label>humidity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0015019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0015019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002008"/>
        <obo:IAO_0000115>A concave 3-D shape quality inhering in a bearer by virtue of the bearer&apos;s being shaped in the form of the letter C.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0015019</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:label>C-shaped</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0015020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0015020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002008"/>
        <obo:IAO_0000115>A concave 3-D shape quality inhering in a bearer by virtue of the bearer&apos;s being shaped in the form of the letter J.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0015020</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:label>J-shaped</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0015026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0015026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000141"/>
        <oboInOwl:hasDefinition>Definition: Quality, state, or degree of being stable.</oboInOwl:hasDefinition>
        <rdfs:label>stability</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0015027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0015027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0015026"/>
        <oboInOwl:hasDefinition>Definition: An increase in stability.</oboInOwl:hasDefinition>
        <rdfs:label>increased stability</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0015029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0015029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002198"/>
        <obo:IAO_0000115>A physical quality inhering in an entity by virtue of the bearer&apos;s solid or liquid constituents being transiently dispersed in a solid, liquid, or gas before settling due to gravity or centrifugal forces.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0015029</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#attribute_slim"/>
        <rdfs:label>quality of a suspension</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0040046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0040046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001236"/>
        <obo:IAO_0000115>The rate or speed of the change in size of an individual entity.</obo:IAO_0000115>
        <oboInOwl:created_by>http://orcid.org/0000-0001-5208-3432</oboInOwl:created_by>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0040046</oboInOwl:id>
        <rdfs:label>single organismal growth rate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0040057 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0040057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001236"/>
        <obo:IAO_0000115>A quality inhering in a process by virtue of that process having a population or part of a population, where population is defined as a collection of individuals from the same taxonomic class distinguished by one or more characteristics, as participants.</obo:IAO_0000115>
        <oboInOwl:created_by>http://orcid.org/0000-0001-5208-3432</oboInOwl:created_by>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0040057</oboInOwl:id>
        <rdfs:label>population process quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0055001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0055001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0010005"/>
        <obo:IAO_0000115>A spatial distribution of a process in which the process occupies a smaller length, area, or volume than the reference process. For example, heterochromatin may form over a shorter length of a chromosome in a mutant than in wild type.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4148-4606"/>
        <oboInOwl:creation_date>2019-07-29T14:22:24Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0055001</oboInOwl:id>
        <rdfs:label>decreased spatial extent of a process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0055002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0055002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0010005"/>
        <obo:IAO_0000115>A spatial distribution of a process in which the process occupies a greater length, area, or volume than the reference process. For example, heterochromatin may form over a shorter length of a chromosome in a mutant than in wild type.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4148-4606"/>
        <oboInOwl:creation_date>2019-07-29T14:23:31Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0055002</oboInOwl:id>
        <rdfs:label>increased spatial extent of a process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0095005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0095005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001236"/>
        <obo:IAO_0000115>A quality of a process that happens during dawn and dusk.</obo:IAO_0000115>
        <dc:creator rdf:resource="http://orcid.org/0000-0002-2908-3327"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-05-17T13:22:18Z</dc:date>
        <rdfs:label>crepuscular</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0000000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000031"/>
        <obo:IAO_0000112>Examples include: population, community, species (meaning the collection of organisms that makes up a species, not the taxonomic rank), and family.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">A material entity that consists of two or more organisms, viruses, or viroids.</obo:IAO_0000115>
        <rdfs:comment>May be of the same or different species.</rdfs:comment>
        <rdfs:label xml:lang="en">collection of organisms</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000000"/>
        <obo:IAO_0000115 xml:lang="en">A material entity that has as parts two or more organisms, viruses, or viroids of the same species and no members of any other species.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">single-species collection of organisms</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000018"/>
        <obo:IAO_0000115 xml:lang="en">A domestic group, or a number of domestic groups linked through descent (demonstrated or stipulated) from a common ancestor, marriage, or adoption.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Needs axioms for family relationships.</obo:IAO_0000116>
        <rdfs:comment>Family membership through marriage or adoption apply primarily to human families. In most species, family membership is defined by common anscestry.</rdfs:comment>
        <rdfs:label xml:lang="en">family</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000000"/>
        <obo:IAO_0000115 xml:lang="en">A collection of organisms that consists of two or more organisms from at least two species.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Need to add axiom to specify that it has at a mimum members of two different species, but not sure how to specify that. Can&apos;t say &quot;(&apos;has member&apos; only (&apos;member of&apos; min 2 &apos;species as a collection of organisms&apos;))&quot;.</obo:IAO_0000116>
        <rdfs:comment xml:lang="en"></rdfs:comment>
        <rdfs:label xml:lang="en">multi-species collection of organisms</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115>A material entity that is one or more organisms, viruses or viroids.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">organismal entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0001000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0001000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000000"/>
        <obo:IAO_0000115 xml:lang="en">A collection of organisms that consists of exactly two organism, viruses, or viroids that are interacting with each other.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">pair of interacting organisms</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PO_0009001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0009001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025496"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <obo:IAO_0000115>A multi-tissue plant structure (PO:0025496) that develops from a gynoecium (PO:0009062), or a single carpel (PO:0009030), and at maturity may have as parts one or more seeds (PO:0009010).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>PO:0020067</oboInOwl:hasAlternativeId>
