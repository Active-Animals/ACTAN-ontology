    <!-- http://purl.obolibrary.org/obo/ACTAN_0000971 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000971">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000242"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002497"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-08T10:56:45.112685Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Lie in which the anatomical dorso-ventral axis is parallel to the substrate.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym>blind side</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">side lie</rdfs:label>
        <skos:example>&quot;It would stand until the insects began crawling up its legs, then would lie down on one side, with fluffed plumage and lifted wing...&quot;</skos:example>
        <skos:scopeNote>&quot;When active a flatfish often keeps its head elevated in an &apos;alert posture&apos; supported by the anterior rays of the median fins and by the blind side pectoral and pelvic fins.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000971"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Lie in which the anatomical dorso-ventral axis is parallel to the substrate.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1002/9781118501153.ch12</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;When swimming in midwater most flatfishes hold the same position as on the bottom (i.e., with the anatomical dorso-ventral axis parallel to the seabed).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000971"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>blind side</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2014</dc:date>
        <dc:source>doi:10.1002/9781118501153.ch12</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000971"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">side lie</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
        <skos:scopeNote>&quot;...lie down on one side...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000971"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;It would stand until the insects began crawling up its legs, then would lie down on one side, with fluffed plumage and lifted wing...&quot;</owl:annotatedTarget>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000971"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;When active a flatfish often keeps its head elevated in an &apos;alert posture&apos; supported by the anterior rays of the median fins and by the blind side pectoral and pelvic fins.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1002/9781118501153.ch12</dc:source>
