        <oboInOwl:creation_date>2026-09-13T11:34:37.930311Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement that rotates an eye backward.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">abducting eye-movement</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000972"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement that rotates an eye backward.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1152/jn.00565.2024</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The positive directions for horizontal, vertical, and torsional eye rotations are respectively adduction (forward), infraduction (downward), and extorsion (CCW: counterclockwise) for the right eye of goldfish, whereas the negative directions are abduction (backward), supraduction (upward), and intorsion (CW: clockwise).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000972"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">abducting eye-movement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


