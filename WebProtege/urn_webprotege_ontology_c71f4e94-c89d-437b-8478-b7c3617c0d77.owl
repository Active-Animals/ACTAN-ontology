    <!-- http://purl.obolibrary.org/obo/ACTAN_0000084 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000625"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
