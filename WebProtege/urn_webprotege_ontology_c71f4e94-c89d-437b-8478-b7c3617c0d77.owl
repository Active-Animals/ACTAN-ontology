        <owl:annotatedTarget>progression</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000151"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>A manoeuvre that is anterior-first.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1098/rsos.170467</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Animals swam with either an anterior-first or posterior-first orientation.&quot;</skos:scopeNote>
    </owl:Axiom>
