    <!-- http://purl.obolibrary.org/obo/ACTAN_0000476 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000476">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000475"/>
        <rdfs:subClassOf>
            <owl:Restriction>
