    <!-- http://purl.obolibrary.org/obo/ACTAN_0000715 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000715">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001576"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-21T09:34:43.235324Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that produces positive pressure in a cavity to pump out a fluid.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>ejecting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>expelling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>expulsion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>extrusion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>force pump</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>exuding</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">secretion</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>ejaculation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>releasing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>squeezing from</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>squeezing out</oboInOwl:hasRelatedSynonym>
        <rdfs:label>expulsion kinetics</rdfs:label>
        <skos:example>&quot;It is easy to imagine how water captured with krill could be extruded from the mouth through the spaces between the cusps on Lobodon&apos;s teeth. Juvenile crabeater seals feeding on fish in captivity sucked them in individually and ejected excess water from the sides of their mouths.&quot;</skos:example>
        <skos:example>&quot;Next to moving their tails up and down, the expelling of water from their mouths by rorqual whales is the most massive, single action taken by any organism that has ever lived.&quot;</skos:example>
        <skos:example>&quot;Thalassoma cupido...
...pair dash rapidly upward, usually about 25-50 cm, where the eggs and milt are released.&quot;</skos:example>
        <skos:scopeNote>&quot;Bodily secretions include saliva, wax, silk and even excrement, all of which can serve as effective glue for cementing external materials together.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;In Cryptobranchus and Andrias, males guard oviposition sites in burrows or under rocks. Females are attracted to these sites and lay large yolky eggs in long strands, as in the anuran genus Bufo. Strands may be extruded from one oviduct or from both oviducts simultaneously. The resident male moves over the strands as they are laid and extrudes white, ropy masses of sperm, fertilizing the eggs.&quot;</skos:scopeNote>
    </owl:Class>
