    <!-- http://purl.obolibrary.org/obo/ACTAN_0000345 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000345">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000025"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000139"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000052"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000528"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-20T14:50:56.055483Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Burrowing-gait which is effected by active swimming with the nose pointed into the sand until a sufficient length is covered to allow the various muscular contractions to obtain a grip on the sand.

After this progress is more rapid, the tail portion then frequently trailing into the burrow passively.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>swimming burrowing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">swim-burrowing gait</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000913"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000345"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Burrowing-gait which is effected by active swimming with the nose pointed into the sand until a sufficient length is covered to allow the various muscular contractions to obtain a grip on the sand.

After this progress is more rapid, the tail portion then frequently trailing into the burrow passively.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.5962/p.203769</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Burrowing is generally effected by an active swimming with the nose pointed into the sand. This is continued until a sufficient length is covered to allow the various muscular contractions to obtain a grip on the sand, after which progress is more rapid, the tail portion then frequently trailing into the burrow passively.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000345"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>swimming burrowing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...not properly to be considered as swimming is burrowing.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000345"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">swim-burrowing gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000346 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000715"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000174"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-21T08:33:11.835439Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Expulsion which involves the deposition of metabolic waste.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>excretion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>defecation</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">purging</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>urination</oboInOwl:hasNarrowSynonym>
        <rdfs:label>excretion expulsion</rdfs:label>
        <skos:example>&quot;But as the excretion is extremely viscid, it is probably a convenience to the aphides to have it removed; and therefore probably the aphides do not instinctively excrete for the sole good of the ants.&quot;</skos:example>
        <skos:scopeNote>&quot;Warmer over wintering sites also provide superior thermo regulatory opportunities to pre- and post-emergent snakes, helping prepare individuals for brumation (e.g. purging the gut of food) or ‘kick-starting’ physiological processes (e.g. metabolic rates) for rapid resumption of active season activities.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000346"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Expulsion which involves the deposition of metabolic waste.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1111/brv.12934</dc:source>
    </owl:Axiom>
