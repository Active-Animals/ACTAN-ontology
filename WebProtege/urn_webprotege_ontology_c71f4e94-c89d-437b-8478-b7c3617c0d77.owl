    <!-- http://purl.obolibrary.org/obo/ACTAN_0000599 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000368"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000925"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003942"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-10T19:38:24.554722Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Taxis that responds to a touch stimulus.</oboInOwl:hasDefinition>
        <rdfs:label>thigmo-taxis</rdfs:label>
        <skos:closeMatch>NBO:0000381</skos:closeMatch>
        <skos:example>&quot;It is clear that thigmotaxis can explain the maintenance of processions of late-instar O. lunifer caterpillars. The findings... reveal that the ability to be followed is more important for the maintenance of processions than the ability to follow.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000599"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Taxis that responds to a touch stimulus.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/j.1365-3032.2009.00697.x</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Thigmotaxis is defined as a locomotory response caused by the stimulus of touch.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000599"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>thigmo-taxis</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000599"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;It is clear that thigmotaxis can explain the maintenance of processions of late-instar O. lunifer caterpillars. The findings... reveal that the ability to be followed is more important for the maintenance of processions than the ability to follow.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1365-3032.2009.00697.x</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000600 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000600">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000334"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-10T20:06:47.457163Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Antagonism in which the larger of two adversaries is successful, without any fighting.

By displaying, not only is the size demonstrated but also the readiness to begin a fight.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">size-up</oboInOwl:hasExactSynonym>
        <rdfs:label>size-up antagonism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000906"/>
        <skos:broadMatch>NBO:0020093</skos:broadMatch>
        <skos:scopeNote>&quot;Spiders confronted by a rival more than 10% bigger than them withdraw without a fight. Spiders signal their size to each other by plucking the web on which the confrontation takes place.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;This behavior is common in fish species, and is likely related to the use of lateral line by fish to size-up the opponent by the waves generated by its movement.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000600"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Antagonism in which the larger of two adversaries is successful, without any fighting.

By displaying, not only is the size demonstrated but also the readiness to begin a fight.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000600"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">size-up</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000600"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>size-up antagonism</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000600"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Spiders confronted by a rival more than 10% bigger than them withdraw without a fight. Spiders signal their size to each other by plucking the web on which the confrontation takes place.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10539-011-9297-8</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000600"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;This behavior is common in fish species, and is likely related to the use of lateral line by fish to size-up the opponent by the waves generated by its movement.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000601 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000601">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000117"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-10T20:07:29.164337Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Modality that uses body movements to stimulate another animal&apos;s sensors, by the waves and wakes generated in the water.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>hydrodynamics signal</oboInOwl:hasExactSynonym>
        <rdfs:label>hydrodynamics modality</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002540"/>
        <skos:example>&quot;Some hypothesized that hydrodynamic signals in the krill propulsion jet might serve as a communication channel which could organize krill within a school.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000601"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Modality that uses body movements to stimulate another animal&apos;s sensors, by the waves and wakes generated in the water.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000601"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>hydrodynamics signal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
        <skos:scopeNote>&quot;hydrodynamic signal&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000601"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>hydrodynamics modality</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000601"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Some hypothesized that hydrodynamic signals in the krill propulsion jet might serve as a communication channel which could organize krill within a school.&quot;</owl:annotatedTarget>
