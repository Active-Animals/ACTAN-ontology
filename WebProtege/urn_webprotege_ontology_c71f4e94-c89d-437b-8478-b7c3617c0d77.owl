        <oboInOwl:hasDefinition>Extending that involves a forelimb.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>arm extending</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>forward leg extending</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>wing extending</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">forelimb extending</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000763"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
