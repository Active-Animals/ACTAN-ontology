                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo>https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity</terms:conformsTo>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-01T20:14:59.244075Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Arch that involves the wings in circular profile above the back.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">arch over the back</oboInOwl:hasExactSynonym>
        <rdfs:label>wing arch</rdfs:label>
        <skos:example>&quot;One of the displays of the Andean Goose involves lifting the wings to form an arch over the back.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000810"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Arch that involves the wings in circular profile above the back.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1676/1559-4491-128.3.628</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In the aggressive posture ‘busking’ of Mute Swans, the wings are arched above the back, with the secondary feathers raised above the head, creating an enlarged circular profile when viewed from the front.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000810"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
