    <!-- http://purl.obolibrary.org/obo/ACTAN_0000861 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000861">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000860"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002245"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-01T13:45:54.310684Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Hit which is destabilising and involves the whole body&apos;s weight.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>colliding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ramming</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>push</oboInOwl:hasRelatedSynonym>
        <rdfs:label>ram hit</rdfs:label>
        <skos:example>&quot;Aequidens latifrons...
The male often butts the female and she tries to evade these pushes.&quot;</skos:example>
        <skos:example>&quot;In Aequidens and Cichlasoma species the contact with the rammed fish is made with a sudden, more or less formalised pushing out of the lower jaw...&quot;</skos:example>
        <skos:example>&quot;Thalassoma cupido...
In fact, on one occasion, an upward dashing labrid aggregation collided into the abdomen of a waiting Pomacentrus nagasakiensis.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000861"/>
