        <oboInOwl:creation_date>2025-09-21T15:19:50.940225Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mouthing which involves repeated biting movements with the mouth half-opened.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">mumbling</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">mumbling gaping</rdfs:label>
        <skos:example>&quot;Tilapia...

It is likely that most of the eggs are fertilized when already in the mouth of the female: she makes mumbling movements by which the eggs will become thoroughly mixed with the sperm.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000848"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mouthing which involves repeated biting movements with the mouth half-opened.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Mumbling. The fish makes repeated biting movements with the mouth half-opened.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000848"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
