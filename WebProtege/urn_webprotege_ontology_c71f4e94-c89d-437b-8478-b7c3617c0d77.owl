        <owl:annotatedTarget>oscillatory</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1093/icb/36.6.555</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000529"/>
