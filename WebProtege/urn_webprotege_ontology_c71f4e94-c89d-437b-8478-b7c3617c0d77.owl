        <oboInOwl:creation_date>2026-04-21T10:41:50.098431Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Twisting in which the head is rolled around on the neck.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>head-rolling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>turning head</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">head twisting</rdfs:label>
        <skos:closeMatch>NBO:0000026</skos:closeMatch>
        <skos:example>&quot;...adult Java Sparrows (Puddu oryzivoru) use headtwisting as an aggressive display in supplanting attacks.&quot;</skos:example>
        <skos:example>&quot;Head-rolling, involving rapid rubbing of one cheek on the back, occurs in the pre-copulation situation in the European, Pacific, King, and Stellar&apos;s Eiders.&quot;</skos:example>
    </owl:Class>
