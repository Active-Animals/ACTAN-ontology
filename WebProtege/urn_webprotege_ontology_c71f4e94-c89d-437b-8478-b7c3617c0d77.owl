        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000590"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Achirus fasciatus attaches itself to smooth surfaces by pressing the fringing fins downward and raising the central part of the body thus producing considerable suction.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000590"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In two species, Emmelichthyops and Schultzea, an additional process is found on the premaxilla which apparently serves in giving support to the large resulting gape between the maxilla and the premaxilla; this gape is covered only by integument when the jaw is shot forward. When feeding, these fishes &quot;shoot&quot; the jaw forward and downward rapidly; this rapid expansion of the oral cavity creates a suction which draws prey into the cavity.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
