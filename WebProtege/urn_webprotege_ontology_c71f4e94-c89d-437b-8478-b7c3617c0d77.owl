    <!-- http://purl.obolibrary.org/obo/ACTAN_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000671"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002244"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-01-02T20:25:51.607392Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Thrust that passes a propulsive wave backward along the body, that increases the momentum of the fluid passing backward, exerting an equal opposing force by the fluid.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>added-mass method</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>push</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">added-mass thrust</rdfs:label>
        <skos:example>&quot;Another derived trait of sea snakes (and A. granulatus), the paddle-shaped tail, emphasizes the importance of the entire height of the snake for pushing against water to provide propulsion, whereas nearly all locomotion of snakes on solid surfaces uses only a fraction of the entire surface area to push against the environment.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000027"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Thrust that passes a propulsive wave backward along the body, that increases the momentum of the fluid passing backward, exerting an equal opposing force by the fluid.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1109/48.757275</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;As the propulsive wave passes backward along the fish, each small body segment (called propulsion element) generates a force that increases the momentum of the water passing backward. An equal opposing force (the reaction force) is subsequently exerted by the water on the propulsive element.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000027"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>added-mass method</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000027"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>push</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1093/icb/icaa017</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000027"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">added-mass thrust</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000027"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Another derived trait of sea snakes (and A. granulatus), the paddle-shaped tail, emphasizes the importance of the entire height of the snake for pushing against water to provide propulsion, whereas nearly all locomotion of snakes on solid surfaces uses only a fraction of the entire surface area to push against the environment.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icaa017</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000144"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000374"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-05T20:35:21.741268Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Transition that involves coming out.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>emergence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>emergency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">emerging</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>exit</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">exit transition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000711"/>
        <skos:example>&quot;BEHAVIOUR OF YOUNG A. IBIS... For 12 hours or more before a chick emerges it gives weak, drawn-out notes, rendered &quot;eeeh&quot;, which after hatching are discomfort notes, given when the chick is cold or roughly handled.&quot;</skos:example>
        <skos:example>&quot;The genera Lingula and Glottidia possess antero-posteriorly elongated shells, and live within mucus-lined burrows in soft sediment, with the long pedicles anchored at the bottom of their burrows... Both genera burrow by entering the sediment with shell anteriormost and pedicle trailing behind. After burrowing downward for a while, they curve upward and continue burrowing until they emerge from the substrate with the anterior region of the shell.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000028"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Transition that involves coming out.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.5962/bhl.title.82303</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;When the nest is slightly disturbed, the slaves occasionally come out, and like their masters are much agitated and defend the nest: when the nest is much disturbed and the larvæ and pupæ are exposed, the slaves work energetically with their masters in carrying them away to a place of safety. Hence, it is clear, that the slaves feel quite at home. During the months of June and July, on three successive years, I have watched for many hours several nests in Surrey and Sussex, and never saw a slave either leave or enter a nest...

One evening I visited another community of F. sanguinea, and found a number of these ants entering their nest, carrying the dead bodies of F. fusca (showing that it was not a migration) and numerous pupæ. I traced the returning file burthened with booty, for about forty yards, to a very thick clump of heath, whence I saw the last individual of F. sanguinea emerge, carrying a pupa; but I was not able to find the desolated nest in the thick heath.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000028"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>emergence</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000028"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>emergency</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1002/ece3.6372</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000028"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">emerging</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000028"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>exit</owl:annotatedTarget>
        <dc:source>doi:10.1023/A:1005565304671</dc:source>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000028"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">exit transition</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000028"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;BEHAVIOUR OF YOUNG A. IBIS... For 12 hours or more before a chick emerges it gives weak, drawn-out notes, rendered &quot;eeeh&quot;, which after hatching are discomfort notes, given when the chick is cold or roughly handled.&quot;</owl:annotatedTarget>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000028"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The genera Lingula and Glottidia possess antero-posteriorly elongated shells, and live within mucus-lined burrows in soft sediment, with the long pedicles anchored at the bottom of their burrows... Both genera burrow by entering the sediment with shell anteriormost and pedicle trailing behind. After burrowing downward for a while, they curve upward and continue burrowing until they emerge from the substrate with the anterior region of the shell.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1365-3121.1991.tb00141.x</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000144"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000375"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-05T20:37:09.991336Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Ttransition that involves going into.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">entering</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>entry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>inserting</oboInOwl:hasRelatedSynonym>
        <rdfs:label>entry transition</rdfs:label>
        <skos:example>&quot;...female Nocomis leptocephalus... entered the pit either by darting directly beneath the male’s tail or by swimming upstream to one side and sidling laterally into the pit.&quot;</skos:example>
        <skos:example>&quot;VHF-radiotelemetry of C. horridus at Principia College in west–central Illinois revealed post-emergent individuals often retreat into hollow trees, logs, and root holes, particularly during periods of colder temperatures.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000029"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Ttransition that involves going into.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1177/10597123211040574</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Λ8 is the whole activity, including preparation of going into water and drying of feathers afterwards.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000029"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">entering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000029"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>entry</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1023/A:1005565304671</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000029"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>inserting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2005</dc:date>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000029"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>entry transition</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000029"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...female Nocomis leptocephalus... entered the pit either by darting directly beneath the male’s tail or by swimming upstream to one side and sidling laterally into the pit.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000029"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;VHF-radiotelemetry of C. horridus at Principia College in west–central Illinois revealed post-emergent individuals often retreat into hollow trees, logs, and root holes, particularly during periods of colder temperatures.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3354/esr01312</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000671"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001839"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-01-02T21:18:55.959799Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Thrust that involves the reaction to an ejected water jet.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>jet propulsion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nozzle reaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reactive jet</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">ejection thrust</rdfs:label>
        <skos:scopeNote>&quot;Jet propulsion by bullet-shaped jellyfish is more energy efficient than that of dish-shaped jellyfish, but the vortices produced by dish-shaped animals carry prey to their tentacles more effectively than the vortices produced by bullet-shaped animals.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000030"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Thrust that involves the reaction to an ejected water jet.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.5962/p.203769</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Fishes in respiring eject water through their gill orifices in a backward direction as pointed out under “Jet propulsion.” It is axiomatic to state that if a jet of any sort whatsoever be ejected at a velocity however low from a body freely suspended, there will be a proportional reaction in the opposite direction.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000030"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>jet propulsion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000030"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>nozzle reaction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000030"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>reactive jet</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000030"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">ejection thrust</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000030"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Jet propulsion by bullet-shaped jellyfish is more energy efficient than that of dish-shaped jellyfish, but the vortices produced by dish-shaped animals carry prey to their tentacles more effectively than the vortices produced by bullet-shaped animals.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000016"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003097"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-07T09:01:05.49186Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Ribbon-undulation gait that involves the dorsal fin.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>amiiform mode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>amiiform undulation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">amiiform gait</rdfs:label>
        <skos:example>&quot;Hippocampus hudsonius... when high speed, for a seahorse, is desired it leans forward with the vertebral column nearly horizontal and undulates the dorsal in localized anguilliform fashion.&quot;</skos:example>
        <skos:example>&quot;The best examples of this characteristic are found among the African freshwater electric eels. The anal and caudal fins are missing, while the dorsal fin extends along most of the body length, tapering to a posterior point, and exhibits a large number of fin-rays (up to 200).&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000031"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Ribbon-undulation gait that involves the dorsal fin.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.5962/p.203769</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Amiatus, dorsal undulation. (Amiiform).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000031"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>amiiform mode</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000031"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>amiiform undulation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;Amiiform. That form of localized anguilliform undulation...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000031"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
