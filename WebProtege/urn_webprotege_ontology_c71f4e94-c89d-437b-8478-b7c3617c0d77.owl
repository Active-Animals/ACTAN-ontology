    <!-- http://purl.obolibrary.org/obo/ACTAN_0000612 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000308"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002272"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-17T16:05:07.159769Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Residence that is static, parallel to a surface.

Propulsion is not always required.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>posting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>station-holding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">stationing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>headquartering</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>standing</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">stationing residence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000311"/>
        <skos:example>&quot;&quot;Headquarters&quot; are also known in other territorial animals;... EVANS found them in the lizard Anolis sagrei, where they chiefly serve as observation-posts.&quot;</skos:example>
        <skos:example>&quot;Cleaner wrasse occupy cleaning stations on coral outcrops...&quot;</skos:example>
        <skos:example>&quot;Intermittent locomotion... occurs in water striders holding station in the current.&quot;</skos:example>
        <skos:scopeNote>&quot;A fish was determined to be hunkering if it was able to maintain station by adhering to the bottom of the tunnel without body or caudal fin undulation.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000612"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
