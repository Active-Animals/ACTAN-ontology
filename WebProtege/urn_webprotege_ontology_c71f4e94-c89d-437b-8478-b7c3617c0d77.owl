    <!-- http://purl.obolibrary.org/obo/UBERON_0000174 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000463"/>
        <oboInOwl:hasDefinition>A portion of organism substance that is the product of an excretion process that will be eliminated from the body. An excretion process is elimination by an organism of the waste products that arise as a result of metabolic activity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>excreted substance</oboInOwl:hasExactSynonym>
        <rdfs:label>excreta</rdfs:label>
    </owl:Class>
    


