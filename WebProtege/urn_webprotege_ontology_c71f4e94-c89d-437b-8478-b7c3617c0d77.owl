    <!-- http://purl.obolibrary.org/obo/ACTAN_0000888 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000888">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000379"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000690"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-14T16:18:26.954Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Evasion that avoids attacks by skilfully and rapidly changing position.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">dodging</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">dodge evasion</rdfs:label>
        <skos:example>&quot;After approximately 250 m the lower jaeger caught up to the sandpiper and grabbed it in its bill as the sandpiper tried to dodge right.&quot;</skos:example>
        <skos:example>&quot;Hemichromis bimaculatus...
The male remains quivering at some distance from the female, then charges on the female, which tries to evade the blow by placing herself rapidly parallel to the male.&quot;</skos:example>
        <skos:scopeNote>&quot;If there is an extended suspension of sufficient duration (less common for transverse than for rotary gallopers), then the feet can alternatively be repositioned during that suspension. The forefeet are then the first to assume the new support pattern—possibly an advantage in dodging quickly.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000888"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Evasion that avoids attacks by skilfully and rapidly changing position.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000888"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">dodging</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
