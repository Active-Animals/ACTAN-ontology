    <!-- http://purl.obolibrary.org/obo/ACTAN_0000753 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000753">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000011"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-08T13:23:15.883644Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Component pattern that is a suite of behaviours that usually occur together.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">constellation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>suite</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">constellation pattern</rdfs:label>
        <skos:example>&quot;Musth-Walk typically includes the Behaviours: Ears-Stiff, Head-High, Chin-In, Purposeful-Walk, Musth-Temporal-Gland-Secretion, Urine-Dribbling.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000753"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Component pattern that is a suite of behaviours that usually occur together.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.69649/pachyderm.v62i.462</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;A Behavioural Constellation, or Constellation, is a suite of Behaviours that usually occur together.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000753"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">constellation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:date>
        <dc:source>doi:10.69649/pachyderm.v62i.462</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000753"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>suite</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000753"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
