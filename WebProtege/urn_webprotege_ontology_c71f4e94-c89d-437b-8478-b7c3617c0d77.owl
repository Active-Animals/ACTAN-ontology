    <!-- http://purl.obolibrary.org/obo/ACTAN_0000469 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001545"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-18T15:06:49.941201Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that temporarily fixes an animal&apos;s position using an inflexibile component against the substrate.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>anchor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>fastening</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>stance</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">wedge</oboInOwl:hasRelatedSynonym>
        <rdfs:label>anchor kinetics</rdfs:label>
        <skos:scopeNote>&quot;...the fish often contacted some firm object, as though using it as an anchor.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Concertina describes a snake using static points of contact with supports, either by progressing between branches in a series of cantilevers using the tail or hind body, or by wedging its posterior into surface irregularities with short-radius bends, extending its anterior to grasp more irregularities, then pulling up the posterior.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;One part of the organism probes forward, while the rest acts as an anchor that prevents back-slippage.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Using lateral stems as horizontal steps, the feet maintained their grasp on the liftoff stem, a lateral stem in this case, as the tail hooked around an even higher lateral stem. Anchored thus, the monkeys dropped downward while reaching with the forelimbs toward the target lateral stem.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000469"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics that temporarily fixes an animal&apos;s position using an inflexibile component against the substrate.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1111/j.1365-3121.1991.tb00141.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000469"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>anchor</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
