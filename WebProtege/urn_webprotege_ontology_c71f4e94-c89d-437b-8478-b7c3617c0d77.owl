    <!-- http://purl.obolibrary.org/obo/ACTAN_0000554 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000554">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000553"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001507"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-27T14:51:05.995843Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Condition switch that involves a variable mixture of phased signals, assessments, antagonism, relative locomotion, and movement bouts, with the potential outcome of winning or losing.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym xml:lang="en">fighting</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">fighting switch</rdfs:label>
        <skos:example>&quot;...the male Haplochromis... in intraterritorial fighting too, the tail beating, butting and gripping the jaws is not performed in a definite order but the fishes apparently use these actions just at the right moment, which may appear at any time. This indicates that their exact timing is a matter of external stimuli.&quot;</skos:example>
        <skos:example>&quot;Agonistic confrontation between two individuals often used to establish social dominance; comprises two distinct phases: the fish first assess each other by exhibiting display, biting/nipping, flicking, and circling behaviors, which continues until the first chase/flee occurs. Next, the ‘winner’ (chaser) initiates all agonistic behaviors, while the ‘loser’ displays fleeing, submission behavior, or freezing.&quot;</skos:example>
        <skos:scopeNote>&quot;...all fighting acts fluctuate together in the natural situation, as do all components of escape... as soon as we begin to analyse the causation of each of them separately, it is pre-judging the issue if we take for granted that each is in itself a causally closely-linked complex of components.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000554"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Condition switch that involves a variable mixture of phased signals, assessments, antagonism, relative locomotion, and movement bouts, with the potential outcome of winning or losing.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000554"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">fighting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000554"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">fighting switch</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000554"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...the male Haplochromis... in intraterritorial fighting too, the tail beating, butting and gripping the jaws is not performed in a definite order but the fishes apparently use these actions just at the right moment, which may appear at any time. This indicates that their exact timing is a matter of external stimuli.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000554"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Agonistic confrontation between two individuals often used to establish social dominance; comprises two distinct phases: the fish first assess each other by exhibiting display, biting/nipping, flicking, and circling behaviors, which continues until the first chase/flee occurs. Next, the ‘winner’ (chaser) initiates all agonistic behaviors, while the ‘loser’ displays fleeing, submission behavior, or freezing.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000554"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...all fighting acts fluctuate together in the natural situation, as do all components of escape... as soon as we begin to analyse the causation of each of them separately, it is pre-judging the issue if we take for granted that each is in itself a causally closely-linked complex of components.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1439-0310.1963.tb01161.x</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000555 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000329"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001193"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-27T20:45:29.293429Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Confrontation that involves lining up parallel to another.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">lateral-display</oboInOwl:hasExactSynonym>
        <rdfs:label>lateral confrontation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000555"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Confrontation that involves lining up parallel to another.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Lateral display: Two fish line up parallel to each other head to tail, raise their dorsal fins (fin raise), extend their caudal fins, darken in color (body color change), and swim in circles (circling), often ascending.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000555"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">lateral-display</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000555"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>lateral confrontation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000556 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000556">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000329"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002448"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-27T20:45:40.981142Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Confrontation in which animals approach each other head to head.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">frontal-display</oboInOwl:hasExactSynonym>
        <rdfs:label>frontal confrontation</rdfs:label>
        <skos:example>&quot;The Tilapia species, when still at some distance from each other open their mouths widely; in Tilapia natalensis the thick white lips are then contrasted with the dark background, and in Tilapia nilotica the pink coloured throat is conspicuous. Astonotus, when still at long distance from its enemy, erects the operculae and the branchiostegal membrance.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000556"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Confrontation in which animals approach each other head to head.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000556"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">frontal-display</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000556"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>frontal confrontation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000556"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The Tilapia species, when still at some distance from each other open their mouths widely; in Tilapia natalensis the thick white lips are then contrasted with the dark background, and in Tilapia nilotica the pink coloured throat is conspicuous. Astonotus, when still at long distance from its enemy, erects the operculae and the branchiostegal membrance.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000557 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000149"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000370"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/manoeuvre"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-27T21:09:07.509414Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>A manoeuvre that is up.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>ascending</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ascent</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rising</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>upwards</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">ascent manoeuvre</rdfs:label>
        <skos:example>&quot;Baboons often ascended by alternately leaping and walking on slightly angled WBS [weight bearing structures], whereas chimpanzees used less saltatory locomotor modes.&quot;</skos:example>
        <skos:example>&quot;Nocomis leptocephalus...
Once released, the female continued to rise vertically into the water column...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000557"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>A manoeuvre that is up.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/j.1744-7429.2000.tb00506.x</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;S. C. Sillett (pers. comm.) has seen a 7-cm earthworm of a predominantly terrestrial species rapidly ascending 60 m up a Sitka spruce trunk.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000557"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>ascending</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
        <skos:scopeNote>&quot;...they ascended...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000557"/>
