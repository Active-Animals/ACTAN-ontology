            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-10T20:42:46.001519Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Nontooling that places an object in a specific location.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">placing</oboInOwl:hasExactSynonym>
        <rdfs:label>placing nontooling</rdfs:label>
        <skos:scopeNote>This may include a/an absorbant, adornment, blockade (to prevent movement), camouflage, comfort, decor, prey detector, float (on self to increase buoyancy), hide (to hide something), landmark/directional marker, mark, other-bandage (on others&apos; injuries), play, presser, protection, rest (to sit on it), scented application, self-bandage (on own injuries), self-hide (to hide in), shelter, sound modifier (to modify vocalizations), thermoregulator, threat (on self to ward off others), wedge.</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000395"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Nontooling that places an object in a specific location.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1111/tops.12554</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000395"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">placing</owl:annotatedTarget>
        <dc:source>doi:10.1111/tops.12554</dc:source>
        <dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000395"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>placing nontooling</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000395"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>This may include a/an absorbant, adornment, blockade (to prevent movement), camouflage, comfort, decor, prey detector, float (on self to increase buoyancy), hide (to hide something), landmark/directional marker, mark, other-bandage (on others&apos; injuries), play, presser, protection, rest (to sit on it), scented application, self-bandage (on own injuries), self-hide (to hide in), shelter, sound modifier (to modify vocalizations), thermoregulator, threat (on self to ward off others), wedge.</owl:annotatedTarget>
        <dc:source>doi:10.1111/tops.12554</dc:source>
    </owl:Axiom>
    


