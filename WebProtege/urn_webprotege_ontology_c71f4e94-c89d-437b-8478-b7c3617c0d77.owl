    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000603 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000603">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000318"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002105"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-10T21:23:07.489192Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Look in which eye movements compensate for linear and angular acceleration, and changes in head position with respect to gravity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">vestibulo-ocular-reflex</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">stabilization look</rdfs:label>
        <skos:closeMatch>NBO:0000416</skos:closeMatch>
        <skos:scopeNote>&quot;For example, if the vestibulo-ocular reflex is tested with continuous rotation and without visual cues about the movement of the image (i.e.,with eyes closed or in the dark), the compensatory eye movements cease after only about 30 seconds of rotation. However, if the same test is performed with visual cues, eye movements persist. The compensatory eye movements in this case are due to the activation of the smooth pursuit system, which relies not on vestibular information but on visual cues indicating motion of the visual field.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000603"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Look in which eye movements compensate for linear and angular acceleration, and changes in head position with respect to gravity.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Vestibulo-ocular reflex (VOR): Compensatory eye movements in zebrafish in response to linear/angular acceleration as well as changes in head position with respect to gravity, in order to stabilize the retinal image.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000603"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">vestibulo-ocular-reflex</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000603"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">stabilization look</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000603"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;For example, if the vestibulo-ocular reflex is tested with continuous rotation and without visual cues about the movement of the image (i.e.,with eyes closed or in the dark), the compensatory eye movements cease after only about 30 seconds of rotation. However, if the same test is performed with visual cues, eye movements persist. The compensatory eye movements in this case are due to the activation of the smooth pursuit system, which relies not on vestibular information but on visual cues indicating motion of the visual field.&quot;</owl:annotatedTarget>
        <dc:source>https://www.ncbi.nlm.nih.gov/books/NBK10991/</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000604 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000604">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000083"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000750"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-03T10:24:31.725184Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Zipping in which the wing is lifted so that the secondaries are fanned out and the speculum exposed, the head being turned sideways so that the bill moves along the underside of the raised wing.

The bill moved quickly over the inside of the wing feathers may produce a rather loud sound. Usually the performing bird orientates its body side-on to the other bird.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">preen-behind-wing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">behind-wing-zipping ethotype</rdfs:label>
        <skos:example>&quot;In the Tufted Duck and Rosybill, it is the primaries which are rattled with the bill to produce the characteristic noise.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000604"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Zipping in which the wing is lifted so that the secondaries are fanned out and the speculum exposed, the head being turned sideways so that the bill moves along the underside of the raised wing.

The bill moved quickly over the inside of the wing feathers may produce a rather loud sound. Usually the performing bird orientates its body side-on to the other bird.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853965x00138</rdfs:isDefinedBy>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000604"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">preen-behind-wing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000604"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">behind-wing-zipping ethotype</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000604"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In the Tufted Duck and Rosybill, it is the primaries which are rattled with the bill to produce the characteristic noise.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000605 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000605">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002445"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-01T05:45:29.226251Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement that involves rotation along a longitudinal axis.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>torsion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>twist</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>twisting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>warping</oboInOwl:hasExactSynonym>
        <rdfs:label>twisting movement</rdfs:label>
        <skos:example>&quot;...adult Java Sparrows (Puddu oryzivoru) use headtwisting as an aggressive display in supplanting attacks.&quot;</skos:example>
        <skos:example>&quot;In N. leptocephalus, a female’s run was abrupt (ca. 3—5 cm) and ended as she arched her head upwards and twisted sagittally (strong retroflexure).&quot;</skos:example>
        <skos:scopeNote>&quot;Pettigrew further writes that the mackerel twists its tail to such a degree as to be “very much after the manner of a screw in a steamship” and thus “to drill the water.” Observation confirms this in no way whatsoever...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;the pre-copulatory &quot;Head-rolling&quot; of the Common Eider is linked with bathing and is probably derived from washing movements.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement that involves rotation along a longitudinal axis.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/j.1469-185X.2007.00029.x</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;We use twist and flexure as proposed by Lamb (1922): the former implies rotation along the longitudinal axis, the latter not.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>torsion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2007</dc:date>
        <dc:source>doi:10.1111/j.1469-185X.2007.00029.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>twist</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2007</dc:date>
        <dc:source>doi:10.1111/j.1469-185X.2007.00029.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>twisting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1980</dc:date>
        <dc:source>doi:10.2307/1367395</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>warping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>twisting movement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...adult Java Sparrows (Puddu oryzivoru) use headtwisting as an aggressive display in supplanting attacks.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.2307/1367395</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In N. leptocephalus, a female’s run was abrupt (ca. 3—5 cm) and ended as she arched her head upwards and twisted sagittally (strong retroflexure).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Pettigrew further writes that the mackerel twists its tail to such a degree as to be “very much after the manner of a screw in a steamship” and thus “to drill the water.” Observation confirms this in no way whatsoever...&quot;</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <rdfs:comment>Breder (1926) severely criticised his many predecessors in, &quot;that so much of the work has been in the nature of abstract philosophical discussion and that relatively so little has been based upon actual experiment and study of living fishes.&quot; Without a source purporting to use actual observation data, I am loathe to enable an assertion of &apos;caudal/tail twisting&apos; to be more than a narrow synonym of &apos;twisting movement&apos;.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;the pre-copulatory &quot;Head-rolling&quot; of the Common Eider is linked with bathing and is probably derived from washing movements.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000606 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000606">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000686"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-01T05:45:56.900956Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Rotation that twisting culminates in.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">twist</oboInOwl:hasExactSynonym>
        <rdfs:label>twist rotation</rdfs:label>
        <skos:example>&quot;In Nabis, a pair of flaps covering the female genitalia may be either left over right (N. flavomarginatus) or right over left (N. limbatus), which is probably correlated with the twisted male abdomen...&quot;</skos:example>
        <skos:example>&quot;What little thrust of a similar nature acts. to press Amiatus downward and Gymnotus upward on account of their dorsal and anal fins (with parallel rays) respectively, is inconsequential because of the difficulty of moving a streamline form at right angles to its intended direction... A slight twist of a fin, practically imperceptible to the eye, would readily offset any such action.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000606"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Rotation that twisting culminates in.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000606"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">twist</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000606"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>twist rotation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000606"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In Nabis, a pair of flaps covering the female genitalia may be either left over right (N. flavomarginatus) or right over left (N. limbatus), which is probably correlated with the twisted male abdomen...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1469-185X.2007.00029.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000606"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;What little thrust of a similar nature acts. to press Amiatus downward and Gymnotus upward on account of their dorsal and anal fins (with parallel rays) respectively, is inconsequential because of the difficulty of moving a streamline form at right angles to its intended direction... A slight twist of a fin, practically imperceptible to the eye, would readily offset any such action.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


