        <oboInOwl:creation_date>2024-10-06T18:52:34.334332Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym xml:lang="en">intermediate gait</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Aquatic-lateral-undulating gait that increases only in the posterior half of the body.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>sub-carangiform locomotion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sub-carangiform method</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sub-carangiform movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sub-carangiform type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>subcarangiform mode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>subcarangiform swimming</oboInOwl:hasExactSynonym>
        <rdfs:label>subcarangiform gait</rdfs:label>
        <skos:example>&quot;...observed in the subcarangiform mode (e.g., trout)...&quot;</skos:example>
        <skos:example>&quot;Arctic charr... to move from one point to another, the fish resorts to a subcarangiform locomotion.&quot;</skos:example>
    </owl:Class>
