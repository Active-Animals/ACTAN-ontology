        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000735"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">straightening</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000735"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>reaching</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000735"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>uncoiling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>https://bioengineering.hyperbook.mcgill.ca/functional-mechanics-of-the-elephant-and-butterfly-proboscis/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000735"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>unfurling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>https://bioengineering.hyperbook.mcgill.ca/functional-mechanics-of-the-elephant-and-butterfly-proboscis/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000735"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">straightening movement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000735"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;During concertina locomotion snakes have both sliding and static contact, and the head-to-tail distance changes as a convoluted region of the body provides a static anchoring region with subsequent straightening that slides the body forward.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icaa017</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000735"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;An exaggerated lateral flexure is made in the body, often as the fish reverses directions. It may immediately straighten out again...&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000736 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000736">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001477"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-06-01T13:19:01.767943Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Moving in which a body part is pulled back inwards.

In a stride cycle, this will be the stance phase.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>retracting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>withdrawing</oboInOwl:hasRelatedSynonym>
        <rdfs:label>retracting movement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000085"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000621"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000777"/>
        <skos:example>&quot;...in Latrodecus revivensis (Theridiidae), it may be the female herself that actively prevents the male from withdrawing the embolus after copulation, thus promoting fracture of the embolus within her genitalia.&quot;</skos:example>
        <skos:example>&quot;In wing flicking, a heron walking slowly in an upright posture suddenly extends and retracts wings in a flicking action usually repeated several times.&quot;</skos:example>
        <skos:scopeNote>&quot;The bird suddenly crouches, with body horizontal, fully flexed legs, slightly raised scapulars, neck retracted and crest positions 7, 8, or 9.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The retraction phase... and the protraction phase... correspond the backward movement during stance... and the swing forward... respectively.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000736"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Moving in which a body part is pulled back inwards.

In a stride cycle, this will be the stance phase.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1088/1748-3190/ac482d</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000736"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>retracting</owl:annotatedTarget>
