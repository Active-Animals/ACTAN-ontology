    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000719"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">inspiration respiration</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000719"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;At the onset of inspiration, the velum moves forward and the pharynx begins to expand. Enlargement of the central lumen and parabranchial chambers draws some water in through the branchiopore under the still-closing branchial valve, and flow over the gills is medial. Later in inspiration, the gill pores are entirely shut, and the expanding parabranchial chambers draw water laterally again across the filaments.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9780226315737</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000720 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000720">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000847"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-25T13:54:22.242338Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mouthing in which the jaws open and close slightly with fast oscillations.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">chattering</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>clapping</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chattering gaping</rdfs:label>
        <skos:example>&quot;...flamingos use their chattering mandibles, morphing feet, and S-curved long necks to self-generate vortical structures spanning from the bottom to the air–water interface.&quot;</skos:example>
        <skos:scopeNote>&quot;...flamingos produce a vertical flow up to ~7 cm/s while “clapping” their mandibles at an oscillation rate of ~12 Hz.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000720"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mouthing in which the jaws open and close slightly with fast oscillations.</owl:annotatedTarget>
        <rdfs:isDefinedBy>ISBN:9780226315737</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;With each cycle, the jaws open and close slightly (maximum and minimum gape during feeding in A. platyrhynchos equal 14 mm and 3 mm. This is accomplished as much by elevation of the maxillae, which rotate through ~ 13° with each cycle, as by depression of the mandible. The fast oscillations of the jaws help suck water into the mouth and give it momentum.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000720"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">chattering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2025</dc:date>
        <dc:source>doi:10.1073/pnas.2503495122</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000720"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>clapping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2025</dc:date>
        <dc:source>doi:10.1073/pnas.2503495122</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000720"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>chattering gaping</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000720"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...flamingos use their chattering mandibles, morphing feet, and S-curved long necks to self-generate vortical structures spanning from the bottom to the air–water interface.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1073/pnas.2503495122</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000720"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...flamingos produce a vertical flow up to ~7 cm/s while “clapping” their mandibles at an oscillation rate of ~12 Hz.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1073/pnas.2503495122</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000721 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000721">
