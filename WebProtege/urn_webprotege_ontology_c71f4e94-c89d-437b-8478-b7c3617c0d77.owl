        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...langur monkeys (Semnopithecus entellus)...
inviting a male by presenting the anogenital region, tail lowered, and simultaneous head shaking;&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s002650100391</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000767"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Ardeola ibis... Head Flick. 

This display consists of rapid, small-amplitude head movements in a horizontal plane, given with the beak closed, and may be performed singly or as rapidly as twice per second.&quot;</owl:annotatedTarget>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
