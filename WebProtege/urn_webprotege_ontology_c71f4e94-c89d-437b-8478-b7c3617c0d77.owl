        <oboInOwl:hasBroadSynonym>accelerated walk</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>lateral sequence, ipsilateral couplet</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>lateral sequence, lateral couplet</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Stepping gait that is ipsilateral-bipodal, bouncing and grounded.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>amble</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ambling</oboInOwl:hasExactSynonym>
