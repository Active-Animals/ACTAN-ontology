    <!-- http://purl.obolibrary.org/obo/ACTAN_0000734 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000734">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002497"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000737"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-28T11:51:53.326115Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement that results from bending in a sagittal plane.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>lateral arch</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>laterally-bent</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>postured sinusoidally</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">laterally flexed</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lateral-bend placement</rdfs:label>
        <skos:example>&quot;Metridium senile is notable for the variety of shapes which it assumes. It may be fully expanded with a narrow or with a wide column. The same anemone may next day be found contracted down to a mere button-like object. It may indulge in a variety of contortions in which it is laterally bent, or possesses deep transverse constrictions locally or completely embracing the column. The whole anemone may on occasion temporarily assume a shrivelled and contracted condition...&quot;</skos:example>
        <skos:scopeNote>&quot;An exaggerated lateral flexure is made in the body, often as the fish reverses directions. It may immediately straighten out again...&quot;</skos:scopeNote>
    </owl:Class>
