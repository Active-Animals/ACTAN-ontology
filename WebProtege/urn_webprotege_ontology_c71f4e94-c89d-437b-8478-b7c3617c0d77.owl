        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000140"/>
        <obo:IAO_0000115>A spatial quality inhering in a bearer by virtue of the bearer&apos;s being located toward the front of an organism relative to another entity.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>preceding</oboInOwl:hasExactSynonym>
