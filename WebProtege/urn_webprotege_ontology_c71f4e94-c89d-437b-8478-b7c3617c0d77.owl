    <!-- http://purl.obolibrary.org/obo/ACTAN_0000865 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000865">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000513"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000327"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/colouration"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-03T16:46:37.464319Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Colouration in which a tint loses its intensity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">fading</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>greying</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>paling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>blanching</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>darkening</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lightening</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">fading colouration</rdfs:label>
        <skos:example>&quot;Cichlasoma meeki...
The branchiostegal membrane, the throat and the ventral part of the abdomen are light vermilion... in the non-reproductive markings the colour often fades to a pinkish hue.&quot;</skos:example>
        <skos:example>&quot;In Haemulon cbrysargyreum diurnal schooling pigmentation correlates with other diurnal schooling grunt species, but nocturnally its pigmentation fades, leaving a blanched fish which feeds over open sand substrates.&quot;</skos:example>
        <skos:example>&quot;In N. leptocephalus, the anterior anal-fin rays become bright white in breeding males compared to pale yellow or cream colored in nonbreeding males.&quot;</skos:example>
        <skos:scopeNote>&quot;...colour of an animal’s tentacles lightens with expansion...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000865"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Colouration in which a tint loses its intensity.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000865"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">fading</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</rdfs:comment>
    </owl:Axiom>
