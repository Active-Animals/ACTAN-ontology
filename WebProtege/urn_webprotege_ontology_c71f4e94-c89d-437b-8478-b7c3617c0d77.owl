        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000436"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Midleg interaction with female thorax - 0: Absent; 1: Midlegs tap lateral surface (singular movements); 2: Midlegs ‘stroke’ lateral surface (extended rubbing); 3: Midlegs ‘stroke’ dorsal surface (extended rubbing).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
