    <!-- http://purl.obolibrary.org/obo/ACTAN_0000114 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000446"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-05-26T14:41:56.400288Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Performance whose atomic meaning cannot be derived from deeper considerations.

In linguistic parlance, it has &apos;lexical&apos; meaning.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>whole signal</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">whole performance</rdfs:label>
        <skos:example>&quot;Pecking, a foraging behaviour used in woodpeckers to excavate prey from tree trunk, has acquired a stereotypical and rhythmic structure, thus exapting into drumming, which holds a communicative function during mating and territorial defence.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000114"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Performance whose atomic meaning cannot be derived from deeper considerations.

In linguistic parlance, it has &apos;lexical&apos; meaning.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/s10988-025-09438-8</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;One includes elementary signals (notably, calls and gestures) whose atomic meaning involves the whole signal, and cannot be derived from deeper considerations (in linguistic parlance, they have &apos;lexical&apos; meanings).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000114"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>whole signal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2025</dc:date>
        <dc:source>doi:10.1007/s10988-025-09438-8</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000114"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">whole performance</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000114"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Pecking, a foraging behaviour used in woodpeckers to excavate prey from tree trunk, has acquired a stereotypical and rhythmic structure, thus exapting into drumming, which holds a communicative function during mating and territorial defence.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1038/s41467-020-18772-3</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000715"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007113"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-17T14:46:05.938233Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Expulsion in which a delivery system directly delivers an effective poison.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">envenomation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">envenomation expulsion</rdfs:label>
        <skos:example>&quot;Larger snakes have better venom delivery systems and can first warn a predator. If the predator does not respond to the aposematic signal, they can deliver a few effective bites, then cover up their heads and withstand a brief attack while they wait for the envenomation to repel the attacker.&quot;</skos:example>
        <skos:scopeNote>&quot;Although these species possess rear fangs and Duvernoy&apos;s gland secretions, the aperture of their mouths and effectiveness of the use of any &quot;venom&quot; is constrained by their small body size.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000115"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Expulsion in which a delivery system directly delivers an effective poison.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
