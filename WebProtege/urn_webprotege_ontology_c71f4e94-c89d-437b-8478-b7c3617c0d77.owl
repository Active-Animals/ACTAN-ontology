        <oboInOwl:hasDefinition>Flutter that involves the anal fin.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">anal-fin-fanning</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">anal-fin flutter</rdfs:label>
