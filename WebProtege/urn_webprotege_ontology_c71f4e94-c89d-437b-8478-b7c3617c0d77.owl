        <oboInOwl:hasDefinition>Extension that results from dorsal fin extending.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">dorsal-fin extension</rdfs:label>
        <skos:scopeNote>&quot;In stopping, the dorsal and anal of most spiny rayed fishes are usually erected to their fullest extent.&quot;</skos:scopeNote>
    </owl:Class>
