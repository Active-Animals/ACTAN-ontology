    <!-- http://purl.obolibrary.org/obo/ACTAN_0000541 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000541">
        <rdfs:subClassOf rdf:resource="http://humanbehaviourchange.org/ontology/BCIO_050416"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002325"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-21T17:53:57.678106Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Behavioural disposition that is realized when an animal transitions between configurations.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">switching</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>starting</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>stopping</oboInOwl:hasRelatedSynonym>
        <rdfs:label>configuration-switch</rdfs:label>
        <skos:example>&quot;The first order question is When is the wolf dispersing (or behaving in a ‘dispersive’ way)?...

This three-step signature, which we might describe as dispersive to exploratory to pseudoterritorial was visible in the sequence of shifts from mid-April... to the end of May...&quot;</skos:example>
        <skos:scopeNote>&quot;As animals explore their environments, their nervous systems transition between behavioral states that influence how sensory information is processed and how actions are generated.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000541"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Behavioural disposition that is realized when an animal transitions between configurations.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1534/genetics.120.303539</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000541"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">switching</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000541"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>starting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000541"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>stopping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000541"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>configuration-switch</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000541"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The first order question is When is the wolf dispersing (or behaving in a ‘dispersive’ way)?...

This three-step signature, which we might describe as dispersive to exploratory to pseudoterritorial was visible in the sequence of shifts from mid-April... to the end of May...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/1365-2656.12379</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000541"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;As animals explore their environments, their nervous systems transition between behavioral states that influence how sensory information is processed and how actions are generated.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1534/genetics.120.303539</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000542 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000541"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCIT_C60702"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-21T17:55:27.312962Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Switch that overcomes uncertainty with a non-deterministic component.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>random</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">stochasticity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>spontaneous departure</oboInOwl:hasNarrowSynonym>
        <rdfs:label>random switch</rdfs:label>
        <skos:example>&quot;C. elegans animals... roaming and dwelling, where animals stochastically switch between the two states...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000542"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Switch that overcomes uncertainty with a non-deterministic component.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1016/j.jtbi.2011.01.001</dc:source>
    </owl:Axiom>
    <owl:Axiom>
