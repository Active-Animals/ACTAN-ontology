        <owl:annotatedTarget xml:lang="en">postural display</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1980</dc:date>
        <dc:source>doi:10.2307/1367395</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000177"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>posture positioning</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000177"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Carrion Crow (Corvus corone) in ordinary passive anting posture typical of certain larger corvids. Note spread tail, somewhat pulled toward left wing, and lifted contour plumage.&quot;</owl:annotatedTarget>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000178 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000751"/>
        <rdfs:subClassOf rdf:nodeID="genid1217"/>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-23T20:50:16.061857Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Context which involves a starting position, a path, and the distance along it.

Being stationary may be considered zero distance travel.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>translocation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>travel</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>travelling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">locomotion</oboInOwl:hasRelatedSynonym>
        <rdfs:label>travel context</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000176"/>
        <skos:scopeNote>&quot;...according to Valenciennes, there is hardly a single group of fishes confined exclusively to fresh water, so that we may imagine that a marine member of a fresh-water group might travel far along the shores of the sea, and subsequently become modified and adapted to the fresh waters of a distant land.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Like other animals, C. elegans exhibit long-lasting behavioral states in which they display different movement patterns. By switching between different locomotion states, animals can alter how they explore their environment, for example searching for food locally vs. more globally...

In each locomotion state, C. elegans animals express a characteristic set of locomotor parameters over a long-lasting, stable time period.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid1217">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000040"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000178"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid1217"/>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000178"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Context which involves a starting position, a path, and the distance along it.

Being stationary may be considered zero distance travel.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
