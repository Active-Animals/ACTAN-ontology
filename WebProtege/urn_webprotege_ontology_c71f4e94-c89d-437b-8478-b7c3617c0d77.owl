        <oboInOwl:creation_date>2024-11-18T17:00:44.109559Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Parenting that involves a female.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">maternal instinct</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mother&apos;s care</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mothering</oboInOwl:hasExactSynonym>
        <rdfs:label>mothering parenting</rdfs:label>
        <skos:closeMatch>NBO:0000150</skos:closeMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000480"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Parenting that involves a female.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.3389/fetho.2023.1181774</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;We further tested for a greater proclivity of social buffering in montane snakes, which overwinter communally, than in lowland snakes, which mostly overwinter alone; and for a greater proclivity in females, which often aggregate during gestation and maternally attend their offspring.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000480"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">maternal instinct</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
        <skos:scopeNote>&quot;...maternal instinct
...maternal love and care
...maternal hatred...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000480"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>mother&apos;s care</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000480"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
