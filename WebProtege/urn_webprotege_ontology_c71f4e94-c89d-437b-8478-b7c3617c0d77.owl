        <owl:annotatedTarget>contact</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000925"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>contacting movement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000925"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Nocomis leptocephalus...
As her snout approached vertical she rolled the anterior portion of her body away from the male placing her dorsum in contact with his anterior flank.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000925"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Nocomis leptocephalus...
Her snout traversed a 45[degree] arc as the side of her head apposed either the male’s operculum or his anterior flank just above the pectoral fin.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000926 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000926">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000628"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002211"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-11-16T21:32:45.296989Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Grip which uses a recurved body part.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>clasp</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">clasping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>prehension</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>spawning clasp</oboInOwl:hasNarrowSynonym>
        <rdfs:label>clasp grip</rdfs:label>
        <skos:example>&quot;Chimpanzees...
&quot;&quot;Sit or lie with arms tightly clasped around self...&quot; Observed at Gombe as &quot;in a relaxed manner during resting.&quot;&quot;</skos:example>
        <skos:example>&quot;Nocomis leptocephalus...
His anterior body (from snout to anal fin) contracted into a semicircle and resembled a horseshoe about the vertically arched female. Facing away from the clasp, the female’s abdominal region was compressed laterally as the male constricted his body.&quot;</skos:example>
    </owl:Class>
