    <!-- http://purl.obolibrary.org/obo/ACTAN_0000679 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000103"/>
