        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000351 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000351">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000358"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000272"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-21T08:35:51.653754Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Hunt that uses a suitably placed, specific construction.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">trapping</oboInOwl:hasExactSynonym>
        <rdfs:label>trap hunt</rdfs:label>
        <skos:closeMatch>NBO:0015002</skos:closeMatch>
        <skos:example>&quot;For example, the external casings and nets constructed by caddisfly larvae can serve to protect the larva’s soft body and trap food items flowing through streams.&quot;</skos:example>
        <skos:scopeNote>&quot;...the behaviour of trap-building predators is not stereotypic or fixed as was once commonly accepted, rather it can vary greatly, depending on the individual’s internal state and its interactions with external environmental factors.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000351"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Hunt that uses a suitably placed, specific construction.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/j.1469-185X.2010.00163.x</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Trap-building (hereafter, TB) arthropod predators, such as pit-building antlions orweb-building spiders, can be classified as sit-and-wait predators, since they invest no energy or time in searching for prey, but need only a suitable place to construct a specific trap.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000351"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">trapping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2011</dc:date>
        <dc:source>doi:10.1111/j.1469-185X.2010.00163.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000351"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>trap hunt</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000351"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;For example, the external casings and nets constructed by caddisfly larvae can serve to protect the larva’s soft body and trap food items flowing through streams.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.cub.2021.09.082</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000351"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...the behaviour of trap-building predators is not stereotypic or fixed as was once commonly accepted, rather it can vary greatly, depending on the individual’s internal state and its interactions with external environmental factors.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1469-185X.2010.00163.x</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000352 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000348"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-21T08:36:05.486744Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Feed in which a live, nourishing resource is tended and protected.

This usually provides mutualistic benefits.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">culturing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>farming</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>milking</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>harvesting</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>resource monopolization</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">farm feed</rdfs:label>
        <skos:example>&quot;Formica sanguinea... In Switzerland the slaves and masters work together, making and bringing materials for the nest: both, but chiefly the slaves, tend, and milk as it may be called, their aphides; and thus both collect food for the community.&quot;</skos:example>
        <skos:example>&quot;I allowed an ant to visit them, and it immediately seemed, by its eager way of running about, to be well aware what a rich flock it had discovered; it then began to play with its antennæ on the abdomen first of one aphis and then of another; and each aphis, as soon as it felt the antennæ, immediately lifted up its abdomen and excreted a limpid drop of sweet juice, which was eagerly devoured by the ant.&quot;</skos:example>
        <skos:example>&quot;Leaf-cutter ants, for example, have chambers deep within their nests where they culture the fungus that feeds their colonies.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000352"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Feed in which a live, nourishing resource is tended and protected.

This usually provides mutualistic benefits.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1016/j.cub.2022.06.072</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000352"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
