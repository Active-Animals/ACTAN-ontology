    <!-- http://purl.obolibrary.org/obo/ACTAN_0000282 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-07T08:10:25.896621Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that penetrates and removes substrate.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">digging</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>burrowing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>excavating</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">dig kinetics</rdfs:label>
        <skos:example>&quot;...Mulloides fiavolineatus... may also burrow into the sand with its snout to retrieve a food item.&quot;</skos:example>
        <skos:example>&quot;Haplochromis starts digging with circling round on a definite place on the bottom, pressing with the abdomen and the tail on the sand. From this position it takes up a mouthful of sand and brings that away.&quot;</skos:example>
        <skos:scopeNote>&quot;In this digging the movements are always very much exaggerated, therefore we call it formalized digging.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Many animal architects have therefore evolved powerful morphological adaptations for digging and burrowing. Naked mole rats, for example, have large outward-facing incisors, enabling subterranean tunneling through some of the hardest of soils.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000282"/>
