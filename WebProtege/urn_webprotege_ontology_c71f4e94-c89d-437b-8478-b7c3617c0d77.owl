    <!-- http://purl.obolibrary.org/obo/ACTAN_0000060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-04T10:26:09.670661Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement in which part of the body leans against a stabilizing support.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>brace</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">prop</oboInOwl:hasExactSynonym>
        <rdfs:label>brace placement</rdfs:label>
        <skos:example>&quot;Foot-prop sit. Similar to sit-out, but the hindlimbs are flexed at the hips and extended at the knees, with the feet propped against a vertical support. The trunk may also flex at the hips, so that it rests against the hindlimbs. Common sleeping posture in its exemplar, Papio.&quot;</skos:example>
        <skos:example>&quot;The western aquatic garter snake Thamnophis couchii...
When the snake was able to brace a portion of its body against an object in the tank, backwards displacement of the posterior trunk was not observed.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000060"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Placement in which part of the body leans against a stabilizing support.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000060"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>brace</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2003</dc:date>
        <dc:source>doi:10.1242/jeb.00424</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000060"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">prop</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000060"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>brace placement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
