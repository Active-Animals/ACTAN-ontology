        <oboInOwl:creation_date>2024-10-06T15:12:38.462914Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Posture in which more than half of the body weight is borne by a support above the animal&apos;s center of mass.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">hang</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>arm-foot hang</oboInOwl:hasNarrowSynonym>
