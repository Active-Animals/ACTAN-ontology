        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000307"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;We chose to use 20 min based on observations of the snake’s behavior (i.e., termination of rattling and settling into a coil).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1181774</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000308 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000308">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000290"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001323"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-13T13:27:29.467269Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Localization in which an animal spends time within a given radius, but allows the individual to leave and return within a prescribed time window as well.&quot;</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>home range</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">residence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>station haunting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>station inhabiting</oboInOwl:hasExactSynonym>
        <rdfs:label>residence localization</rdfs:label>
        <skos:scopeNote>&quot;...I can bring a considerable catalogue of facts, showing that within the same area, varieties of the same animal can long remain distinct, from haunting different stations, from breeding at slightly different seasons, or from varieties of the same kind preferring to pair together.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;RESIDENT - A canopy organism specialized on a particular host plant or plant species (compare tourist) or specialized on a particular plant organ (as in a resident of flowers or bark), often across many plant species.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000308"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Localization in which an animal spends time within a given radius, but allows the individual to leave and return within a prescribed time window as well.&quot;</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/1365-2656.12379</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The residence time (RT), similarly computes the amount of time an animal spends within a given radius, but allows the individual to leave and return within a prescribed time window as well.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000308"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>home range</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1973</dc:date>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000308"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">residence</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
