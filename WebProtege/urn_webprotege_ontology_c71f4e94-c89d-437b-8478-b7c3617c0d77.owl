        <oboInOwl:creation_date>2025-05-20T19:15:36.942522Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Hunt that separates food from surrounding inorganic material and other nonfood particles at the substrate interface.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym xml:lang="en">bottom-feeding</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>snout plough</oboInOwl:hasNarrowSynonym>
        <rdfs:label>plough hunt</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000363"/>
        <skos:example>&quot;In Mullus the absence of teeth in the adult upper jaw suggests a suction feeder, and its habit of ploughing up the mud is in line with such a feeding method.&quot;</skos:example>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid5362">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
