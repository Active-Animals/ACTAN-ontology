    <!-- http://purl.obolibrary.org/obo/ACTAN_0000965 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000965">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002100"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-26T06:49:51.93021Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Twisting which rotates the body sagittally.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>trunk twisting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>abdomen twisting</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>retroflexure</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">body twisting</rdfs:label>
        <skos:example>&quot;A male Anna’s Hummingbird...
...perches on her back, his wings buzzing (again probably for balance). His body is erect as he lowers and twists his abdomen and tail down the female’s side to achieve cloacal apposition.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000965"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Twisting which rotates the body sagittally.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The male then drove his posterior flank into the female’s side as she twisted sagittally.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000965"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>trunk twisting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:date>
        <dc:source>doi:10.1038/s41598-021-99638-6</dc:source>
        <skos:scopeNote>&quot;...twists her trunk...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000965"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>abdomen twisting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1982</dc:date>
        <dc:source>doi:10.2307/1367674</dc:source>
        <skos:scopeNote>&quot;...twists his abdomen...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000965"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>retroflexure</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000965"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">body twisting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
        <skos:scopeNote>&quot;...twists anterior body...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000965"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;A male Anna’s Hummingbird...
...perches on her back, his wings buzzing (again probably for balance). His body is erect as he lowers and twists his abdomen and tail down the female’s side to achieve cloacal apposition.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.2307/1367674</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000966 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000966">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000606"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002100"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-08-26T06:50:19.549256Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Twist that results from body twisting.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>sagittal twist</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>freezing</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">body twist</rdfs:label>
        <skos:example>&quot;Nocomis leptocephalus...
On two occasions the female reversed her sagittal twist and appressed her breast and abdomen to the concave side of the male.&quot;</skos:example>
        <skos:example>&quot;Zebrafish...
Following, and perhaps in response to, quivering by the male, the female stalls swimming and twists her trunk slightly; we call this step freezing.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000966"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Twist that results from body twisting.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000966"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>sagittal twist</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000966"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>freezing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:date>
        <dc:source>doi:10.1038/s41598-021-99638-6</dc:source>
    </owl:Axiom>
    <owl:Axiom>
