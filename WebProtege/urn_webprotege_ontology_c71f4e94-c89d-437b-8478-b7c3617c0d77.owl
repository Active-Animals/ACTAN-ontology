    <!-- http://purl.obolibrary.org/obo/ACTAN_0000325 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000325">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000288"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001633"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-15T08:51:35.834688Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Relativity which is a nonaggressive movement after another.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">following</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">following relativity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000331"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000896"/>
        <skos:example>&quot;...performing prey retrieval in the army ants Eciton burchelli and Dorylus wilverthi.... there are just two subtasks: front-running, involving a single ant at the front, and following, involving one or more ants bringing up the rear.&quot;</skos:example>
        <skos:example>&quot;Thalassoma cupido...
During the onset she holds the leading position, with the male following closely behind.&quot;</skos:example>
        <skos:scopeNote>&quot;In cold regions, snakes often aggregate at denning sites for overwintering, and neonate rattlesnakes appear capable of following the scent trails of adults to locate dens.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Worm-size blind snakes (Typhlopidae), considered overwhelmingly subterranean, have been found several meters high in trees, perhaps following ant columns.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000325"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Relativity which is a nonaggressive movement after another.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Follow (following): Behavior similar to chase, typically a nonaggressive movement towards (after) another fish;&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000325"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">following</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
