    <!-- http://purl.obolibrary.org/obo/ACTAN_0000141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000135"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-22T15:35:21.957629Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Symmetry pattern in which two propulsors operate, one after the other.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym>bipedal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>trotting</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">alternating-monopod pattern</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000141"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Symmetry pattern in which two propulsors operate, one after the other.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF00197760</dc:source>
        <skos:scopeNote>&quot;Gait: Animals of very different design can use similar gaits. Many species can use a regularly symmetrical alternating gait (e.g., a trot). Two sets of propulsers are used, one after the other. The set can differ in the number of legs used (e.g., one for a human, two for a dog, three for a cockroach and four for a crab).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000141"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>bipedal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1993</dc:date>
        <dc:source>doi:10.1007/BF00197760</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000141"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>trotting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1993</dc:date>
        <dc:source>doi:10.1007/BF00197760</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000141"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">alternating-monopod pattern</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1993</dc:date>
        <dc:source>doi:10.1007/BF00197760</dc:source>
        <skos:scopeNote>&quot;...symmetrical alternating gait (e.g., a trot). Two sets of propulsers are used, one after the other. The set can differ in the number of legs used (e.g., one for a human...&quot;</skos:scopeNote>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000142 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000135"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-22T15:36:12.620717Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Symmetry pattern in which two sets of two propulsors, one after the other, combine support by a fore and a hind foot on opposite sides.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">contralateral bipodal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>contralateral bipedal</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">contralateral-bipodal pattern</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000142"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Symmetry pattern in which two sets of two propulsors, one after the other, combine support by a fore and a hind foot on opposite sides.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF00197760</dc:source>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
        <skos:scopeNote>&quot;Further, at slow and moderate speeds, the bipods that combine support by a fore and a hind foot are more often contralateral (more stable) than ipsilateral (less stable) for the transverse gallop than for the rotary gallop.&quot; (doi:10.1093/icb/20.1.255)</skos:scopeNote>
        <skos:scopeNote>&quot;Gait: Animals of very different design can use similar gaits. Many species can use a regularly symmetrical alternating gait (e.g., a trot). Two sets of propulsers are used, one after the other. The set can differ in the number of legs used (e.g., one for a human, two for a dog, three for a cockroach and four for a crab).&quot; (doi:10.1007/BF001977600)</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000142"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">contralateral bipodal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1980</dc:date>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
        <skos:scopeNote>&quot;...the bipods that combine support by a fore and a hind foot are more often contralateral...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000142"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>contralateral bipedal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>doi:10.3390/ani13162557</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000142"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">contralateral-bipodal pattern</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000143 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000135"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-22T15:36:30.687031Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Symmetry pattern in which two sets of two propulsors, one after the other, combine support by a fore and a hind foot on the same side.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">ipsilateral bipod</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">ipsilateral-bipod pattern</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000143"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Symmetry pattern in which two sets of two propulsors, one after the other, combine support by a fore and a hind foot on the same side.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF00197760</dc:source>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
        <skos:scopeNote>&quot;Further, at slow and moderate speeds, the bipods that combine support by a fore and a hind foot are more often contralateral (more stable) than ipsilateral (less stable) for the transverse gallop than for the rotary gallop.&quot; (doi:10.1093/icb/20.1.255)</skos:scopeNote>
        <skos:scopeNote>&quot;Gait: Animals of very different design can use similar gaits. Many species can use a regularly symmetrical alternating gait (e.g., a trot). Two sets of propulsers are used, one after the other. The set can differ in the number of legs used (e.g., one for a human, two for a dog, three for a cockroach and four for a crab).&quot; (doi:10.1007/BF00197760)</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000143"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">ipsilateral bipod</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1980</dc:date>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000143"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">ipsilateral-bipod pattern</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000144 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000290"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000929"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-06-02T13:51:55.532784Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Localization that has a point and moment of change.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym>change location</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>change of habit</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>direction change</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This is an aggregator for better defined changes and NOT recommended simply to log deviations in position or direction.</rdfs:comment>
        <rdfs:label xml:lang="en">transition localization</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000144"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Localization that has a point and moment of change.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.11369/jji1950.34.76</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Invariably they arrived at the point of apex of the spawning rush at about the same moment that the spawning aggregation had returned to the shelter of the algal substratum.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000144"/>
