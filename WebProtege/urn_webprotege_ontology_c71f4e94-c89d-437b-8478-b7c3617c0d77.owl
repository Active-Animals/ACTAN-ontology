    <!-- http://purl.obolibrary.org/obo/PATO_0002445 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002445">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000052"/>
        <obo:IAO_0000115>A shape quality inhering in a bearer by virtue of the bearer&apos;s being twisted or turned.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2061-091X"/>
        <oboInOwl:creation_date>2013-01-29T11:05:26Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>twisted</oboInOwl:hasExactSynonym>
        <rdfs:comment>The word &quot;torsion&quot; has multiple different meanings in different context (e.g. the act of twisting or the morphology of the digestive tract in gastropods). This term refers purely to the resulting shape and is not to be used in the engineering and mechanics sense of torsion. 
Note: kinked PATO:0001798(synonym twisted) is similar to &apos;torsioned&apos;, but it is different in that something that is kinked has sharp twists or turns.</rdfs:comment>
        <rdfs:label>torsioned</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002448 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000133"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2061-091X"/>
        <oboInOwl:creation_date>2013-02-16T02:57:06Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Definition: A quality inhering in a bearer by virtue of the bearer&apos;s being aligned or positioned towards another entity.</oboInOwl:hasDefinition>
        <rdfs:label>oriented towards</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002452 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000141"/>
        <obo:IAO_0000115>A structural quality inhering in a bearer by virtue of the bearer being thinner or more loosely packed.</obo:IAO_0000115>
        <obo:RO_0002604 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001485"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2061-091X"/>
        <oboInOwl:creation_date>2013-04-08T08:43:31Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0002452</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:label>decondensed</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002471 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002242"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2061-091X"/>
        <oboInOwl:creation_date>2013-09-15T12:03:45Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Definition: A physical quality inhering in a bearer by virtue of the bearer&apos;s increased rate of change of the position.</oboInOwl:hasDefinition>
        <rdfs:label>increased velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002472 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002472">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002242"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2061-091X"/>
        <oboInOwl:creation_date>2013-09-15T12:05:06Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Definition: A physical quality inhering in a bearer by virtue of the bearer&apos;s decreased rate of change of the position.</oboInOwl:hasDefinition>
        <rdfs:label>decreased velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002486 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002486">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001236"/>
        <obo:IAO_0000115>A quality inhering in a process by virtue of that process having two or more organisms as participants.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2061-091X"/>
        <oboInOwl:creation_date>2013-10-10T04:08:44Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0002486</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#attribute_slim"/>
        <rdfs:label>multi-organismal process quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002495 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002495">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000133"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2061-091X"/>
        <oboInOwl:creation_date>2013-10-10T05:15:24Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Definition: An orientation quality inhering in a bearer by virtue of the bearer having a position that is directed dorsally.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>dorsally directed</oboInOwl:hasExactSynonym>
        <rdfs:label>dorsal orientation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002497 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000133"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2061-091X"/>
        <oboInOwl:creation_date>2013-10-10T05:16:45Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Definition: An orientation quality inhering in a bearer by virtue of the bearer having a position that is directed laterally.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>laterally directed</oboInOwl:hasExactSynonym>
        <rdfs:label>lateral orientation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002501 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000133"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2061-091X"/>
        <oboInOwl:creation_date>2013-10-10T05:19:22Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Definition: An orientation quality inhering in a bearer by virtue of the bearer having a position that is directed ventrally.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>ventrally directed</oboInOwl:hasExactSynonym>
        <rdfs:label>ventral orientation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002508 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000140"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-9611-1279"/>
        <oboInOwl:creation_date>2014-02-04T01:30:21Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Definition: A positional quality inhering in a bearer by virtue of the bearer being hidden from view.</oboInOwl:hasDefinition>
        <rdfs:label>concealed</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0002523 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000140"/>
        <obo:IAO_0000115>A positional quality inhering in a bearer by virtue of the bearer&apos;s being located at a right angle relative to another entity and to the horizon.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-9611-1279"/>
