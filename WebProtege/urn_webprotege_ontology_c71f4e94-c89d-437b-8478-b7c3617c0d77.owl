        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;With the hind legs functioning as the primary propulsive units, P. americana may be able to overcome the limitations to stride length imposed by shorter limbs by lifting both front and middle legs off the ground.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.156.1.215</dc:source>
