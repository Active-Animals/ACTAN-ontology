    <!-- http://purl.obolibrary.org/obo/ACTAN_0000535 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000535">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000772"/>
        <rdfs:subClassOf rdf:nodeID="genid4081"/>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-20T21:21:47.3013Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flap in which a feathered recovery stroke follows a power stroke.

This results in larger variations in speed.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>drag-based</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">drag-based flap</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000644"/>
        <skos:scopeNote>&quot;It has been found that marine turtles that utilize a lift based propulsive strategy can generate twice the propulsive force as freshwater turtles that utilize a drag based approach, and giving further consideration to additional benefits such as the increased streamlining of the body of the marine turtles, results in a maximum swimming velocity six times higher than the freshwater counterpart.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid4081">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000649"/>
    </owl:Restriction>
