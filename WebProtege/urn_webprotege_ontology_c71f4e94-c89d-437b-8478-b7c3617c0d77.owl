    <!-- http://purl.obolibrary.org/obo/ACTAN_0000873 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000873">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000378"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-08T10:31:02.252035Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Territorialism that retains dominance.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">securing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>territory maintaining</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>one-sided attack</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">one-sided territorialism</rdfs:label>
        <skos:example>&quot;T. cupido... often a male would be forced to stray to the outskirts of his comparatively large territory... Frequently, a male would spend as long as 20 minutes driving off other males while attempting to isolate a female.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000873"/>
