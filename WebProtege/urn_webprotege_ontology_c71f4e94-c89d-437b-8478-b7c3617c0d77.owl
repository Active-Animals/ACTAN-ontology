    <!-- http://purl.obolibrary.org/obo/ACTAN_0000329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000326"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-15T08:56:13.965985Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Antagonism that encounters with hostility.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>agonistic confrontation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">confronting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>hostility</oboInOwl:hasRelatedSynonym>
        <rdfs:label>confrontation antagonism</rdfs:label>
        <skos:scopeNote>&quot;At Mahale adult males also pant hoot when agonistic confrontations are continuing, in which pant hoots may function as a vocal threat.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Smaller snakes, regardless of species, have no choice when confronted by a predator but to strike with less efficient venom delivery systems and engage the predator more actively, not being able to coil up into a defensive posture and withstand a brief attack.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000329"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Antagonism that encounters with hostility.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853965x00138</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Rubbing the cheek on the back is common during hostile encounters between pairs of Chiloe and European Wigeon...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000329"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>agonistic confrontation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000329"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">confronting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000329"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>hostility</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
