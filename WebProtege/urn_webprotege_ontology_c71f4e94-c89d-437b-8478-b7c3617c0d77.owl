    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000270 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000270">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000751"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MF_0000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-07T08:06:04.066196Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Context in which a representational processing capacity is evidenced.

Attention and recognition may be involved.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">cognition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cognitive processes</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">cognition context</rdfs:label>
        <skos:relatedMatch>NBO:0000607</skos:relatedMatch>
        <skos:scopeNote>&quot;Animals also exhibit emotional states, like states of heightened anxiety or depression, as well as cognitive states, for example, in the contexts of attention or working memory.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;In order to provide a more rigorous foundation for research and to advance our understanding of the interrelation between tool use and cognition, we suggest the adoption of Fragaszy and Mangalam’s (2018) tooling framework, which is characterized by the creation of a body-plus-object system that manages a mechanical interface between tool and surface. Tooling is limited to a narrower suite of behaviors than tool use, which might facilitate its neurocognitive investigation. Indeed, evidence in the literature indicates that tooling has distinct neurocognitive underpinnings not shared by other activities typically classified as tool use, at least in primates.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000270"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Context in which a representational processing capacity is evidenced.

Attention and recognition may be involved.</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1093/icb/41.2.137</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000270"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">cognition</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000270"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
