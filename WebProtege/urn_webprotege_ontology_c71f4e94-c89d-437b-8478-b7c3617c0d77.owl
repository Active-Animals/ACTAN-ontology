        <oboInOwl:creation_date>2025-02-04T17:27:03.028018Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Roll that aligns with gravity via a vestibular reflex.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">vestibular righting reflex</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">vestibular-righting-reflex roll</rdfs:label>
        <skos:closeMatch>NBO:0000578</skos:closeMatch>
        <skos:example>&quot;Briefly, illuminated horizontally, the fish inclines its dorsoventral axis and turns dorsal surface toward the light source, with its body tilt corrected antagonistically by the vestibular righting reflex (i.e., the body inclination increases with the illumination intensity but decreases with the gravity).&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000566"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
