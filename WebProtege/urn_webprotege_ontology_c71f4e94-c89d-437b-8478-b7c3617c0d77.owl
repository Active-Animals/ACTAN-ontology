        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000532"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;We found no evidence of intermittent locomotion by elephant seals at depths shallower than ~15 m, probably as a result of animals being near neutral buoyancy, whereas at deeper depths seals would swim intermittently, likely due to their increased overall density.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1038/ncomms1350</dc:source>
    </owl:Axiom>
    


