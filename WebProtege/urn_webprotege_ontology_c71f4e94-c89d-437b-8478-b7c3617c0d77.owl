    <!-- http://purl.obolibrary.org/obo/ACTAN_0000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000016"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000151"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-07T14:35:11.792867Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Ribbon-undulation gait that involves the passing of vertical undulations along the pectorals that are very large, triangular-shaped, and flexible.

The amplitude of the undulations increases from the anterior part to the fin apex and then tapers again toward the posterior.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>rajiform mode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rajiform movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rajiform undulation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>intermediate undulation</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">rajiform gait</rdfs:label>
        <skos:example>&quot;The families Trygonidae and Myliobatidae have carried the rajiform undulations a step further. The tail has become a mere trailing wisp, which, while it may have some slight course-determining action, appears to trail passively after the animal. Steering is accomplished for the most part by differential action of the pectorals. That is, in curving, the outside “wing” is speeded up or the inside one retarded which swings the animal accordingly.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000033"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Ribbon-undulation gait that involves the passing of vertical undulations along the pectorals that are very large, triangular-shaped, and flexible.

The amplitude of the undulations increases from the anterior part to the fin apex and then tapers again toward the posterior.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1109/48.757275</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Thrust generation involves the passing of vertical undulations along the pectorals that are very large, triangularshaped, and flexible. The amplitude of the undulations increases from the anterior part to the fin apex and then tapers again toward the posterior.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000033"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>rajiform mode</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000033"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>rajiform movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000033"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>rajiform undulation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;Rajiform. That form of localized anguilliform or intermediate
undulation...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000033"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>intermediate undulation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
