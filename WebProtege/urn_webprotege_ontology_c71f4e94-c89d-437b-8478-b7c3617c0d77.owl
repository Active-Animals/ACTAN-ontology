    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000256"/>
        <rdfs:subClassOf>
