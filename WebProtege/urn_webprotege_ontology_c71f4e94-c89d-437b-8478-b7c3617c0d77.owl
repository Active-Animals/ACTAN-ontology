        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000567"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...Red-browed Waxbills (Estrilda temporalis)... would stand on a smoldering log, in the curling wisps of smoke coming up through cracks in the bark, and there perform anting movements “quite distinct from those commonly seen when birds bathe in dust or water”. Each bird would stand upright, with tail as “support” and wings drooping a little forward and downward...&quot;</owl:annotatedTarget>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000567"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Droopy (drooping) tail:... can also be part of a normal resting/sleep behavior... In adult zebrafish... which a long-lasting behavior;&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000568 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000568">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000379"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000689"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-05T12:23:19.738635Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Evasion which is unidirectional.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>escape</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">escaping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fleeing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>panicky flight</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>flight</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>panic</oboInOwl:hasRelatedSynonym>
        <rdfs:label>escape evasion</rdfs:label>
        <skos:example>&quot;Fright in Badis badis finds expression in three more or less conflicting kinds of behavior... The most extrewe type of Avoiding is panicky flight ; the behavior has negative valence since the only taxis is away from the stimulus, if the stimulus is located.&quot;</skos:example>
        <skos:example>&quot;We noted Uca pugilator could also travel at 0- 2 km h~&apos; but they could run twice as fast for about 3 min and sprint at much higher speeds for a few seconds. This behaviour is essential if fiddler crabs are to dash back to their burrow to escape predators.&quot;</skos:example>
        <skos:narrowMatch>NBO:0020268</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000568"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Evasion which is unidirectional.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
