        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Common Shelduck... The display-shake consists of a body-shake with a very exaggerated upward tossing of the head at the end of the movement...&quot;</owl:annotatedTarget>
