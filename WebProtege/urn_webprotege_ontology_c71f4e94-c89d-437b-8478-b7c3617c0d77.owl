        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-22T20:54:17.503505Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Assessment that involves an imminent threat.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">danger</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>danger response</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>threat</oboInOwl:hasExactSynonym>
        <rdfs:label>danger assessment</rdfs:label>
        <skos:scopeNote>&quot;Tactile and other somatosensory inputs from a tail that is draped, hooked, or twisted around a branch may provide the brain with information about whole-body orientation relative to absolute space. In the terminal branch setting, this sensory information may enable monkeys to maneuver in three-dimensional space with less danger of losing their balance and falling.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The antagonism between danger and hunger is conserved across animals. For instance, in mammals, a risk of predation suppresses roaming when well-fed, but extreme hunger overrides danger perception and results in prioritizing food-seeking behavior.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000382"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Assessment that involves an imminent threat.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Linguistic inference.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000382"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">danger</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
        <skos:scopeNote>&quot;It is not that chickens have lost all fear, but fear only of dogs and cats, for if the hen gives the danger-chuckle, they will run (more especially young turkeys) from under her, and conceal themselves in the surrounding grass or thickets;&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000382"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>danger response</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000382"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>threat</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000382"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>danger assessment</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000382"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Tactile and other somatosensory inputs from a tail that is draped, hooked, or twisted around a branch may provide the brain with information about whole-body orientation relative to absolute space. In the terminal branch setting, this sensory information may enable monkeys to maneuver in three-dimensional space with less danger of losing their balance and falling.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1023/A:1005565304671</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000382"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The antagonism between danger and hunger is conserved across animals. For instance, in mammals, a risk of predation suppresses roaming when well-fed, but extreme hunger overrides danger perception and results in prioritizing food-seeking behavior.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1534/genetics.120.303539</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000383 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000383">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000751"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-05T11:36:28.179922Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Context that represents a reciprocal change in social behaviour influenced by the presence and actions of others.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>social behavior</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>social interaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">sociality</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>anti-social behaviour</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">interaction context</rdfs:label>
        <skos:example>&quot;These social hermit crabs are the only species that architecturally remodel the interior of shells, creating ‘remodeled homes’, which are superior for use on land and which are reused socially across generations. Architecture for social hermit crabs includes not just an individual’s current shell, but rather the entire ‘housing market’ of remodeled shells, which represent potential future homes an individual may acquire if it navigates the market successfully.&quot;</skos:example>
        <skos:scopeNote>&quot;Individual behavior can be heavily influenced by variation in social context – contextual variables like the density of individuals and the composition of different personalities or behavioral types of individuals within groups or populations.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Individuals of many species engage regularly if not constantly in social behavior – individuals in social species spend large parts of their lives in social groups, in close proximity and often engaging in interactions with conspecifics. Even in species in which  individuals spend most of their lives solitary (e.g., orb weaving spiders), individuals still have to mate, and occasionally have to interact with others in ways that affect social proximity (e.g., territoriality). Furthermore, we are  learning more about the importance to individuals of living in social groups composed of multiple species...

Recent advances in social network approaches are now putting us in a position to understand better how networks of signaling relate to networks of other social behavior (such as affiliations or agonistic interactions), and this should help us better understand how social interactions build into the social relationships that create the structure of groups.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Context that represents a reciprocal change in social behaviour influenced by the presence and actions of others.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
        <skos:scopeNote>&quot;Social interaction: Normal social behavior of zebrafish, represents a reciprocal change in zebrafish behavior influenced by the presence or actions of other conspecifics.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>social behavior</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>social interaction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">sociality</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>anti-social behaviour</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">interaction context</owl:annotatedTarget>
        <dc:date>https://orcid.org/0000-0002-4277-2151</dc:date>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;These social hermit crabs are the only species that architecturally remodel the interior of shells, creating ‘remodeled homes’, which are superior for use on land and which are reused socially across generations. Architecture for social hermit crabs includes not just an individual’s current shell, but rather the entire ‘housing market’ of remodeled shells, which represent potential future homes an individual may acquire if it navigates the market successfully.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.cub.2021.09.082</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Individual behavior can be heavily influenced by variation in social context – contextual variables like the density of individuals and the composition of different personalities or behavioral types of individuals within groups or populations.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2022.1066186</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Individuals of many species engage regularly if not constantly in social behavior – individuals in social species spend large parts of their lives in social groups, in close proximity and often engaging in interactions with conspecifics. Even in species in which  individuals spend most of their lives solitary (e.g., orb weaving spiders), individuals still have to mate, and occasionally have to interact with others in ways that affect social proximity (e.g., territoriality). Furthermore, we are  learning more about the importance to individuals of living in social groups composed of multiple species...

Recent advances in social network approaches are now putting us in a position to understand better how networks of signaling relate to networks of other social behavior (such as affiliations or agonistic interactions), and this should help us better understand how social interactions build into the social relationships that create the structure of groups.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2022.1066186</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MFOEM_000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-05T11:36:56.926219Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Interaction in which an encounter involves degrees of fearful alertness, and aggressive threat.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">agonistic interaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>hostility</oboInOwl:hasRelatedSynonym>
        <rdfs:label>agonism interaction</rdfs:label>
        <skos:closeMatch>NBO:0000121</skos:closeMatch>
        <skos:example>&quot;An African black eagle, white-faced capuchins, and elephants engaged in agonism by directed throwing/dropping of objects at or on another individual.&quot;</skos:example>
        <skos:example>&quot;Male guppies... agonistic interactions... are significant because dominant males have direct access to females and this increases the proportion of the brood males can sire.&quot;</skos:example>
        <skos:scopeNote>&quot;Recent advances in social network approaches are now putting us in a position to understand better how networks of signaling relate to networks of other social behavior (such as affiliations or agonistic interactions), and this should help us better understand how social interactions build into the social relationships that create the structure of groups.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000384"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Interaction in which an encounter involves degrees of fearful alertness, and aggressive threat.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000384"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">agonistic interaction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>doi:10.1002/(SICI)1098-2337(1998)24:3&lt;197::AID-AB4&gt;3.0.CO;2-I</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000384"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>hostility</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1966</dc:date>
