        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000614"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;For instance, in mammals, a risk of predation suppresses roaming when well-fed, but extreme hunger overrides danger perception and results in prioritizing food-seeking behavior.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1534/genetics.120.303539</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000614"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;If there are a number of clients waiting to be serviced, cleaner fish will prioritise transients, knowing that the locals have nowhere else to go.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10071-014-0761-0</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000615 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000615">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000458"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000553"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-17T16:23:05.960577Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Deception in which trust is broken.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">cheat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>defection</oboInOwl:hasExactSynonym>
        <rdfs:label>cheat deception</rdfs:label>
        <skos:example>&quot;Cleaners are also partial to cheating and occasionally they nip the skin of clients to obtain a cheap meal. It is perhaps not surprising that they are far less inclined to perform this behaviour if the client is a predator.&quot;</skos:example>
        <skos:scopeNote>&quot;If a pair of fish inspects a predator, they glide back and forth as they advance towards the predator each taking it in turn to lead. If a partner should defect or cheat in any way, perhaps by hanging back, the other fish will refuse to cooperate with that individual on future encounters.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000615"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Deception in which trust is broken.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/beheco/12.5.534</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000615"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">cheat</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1093/beheco/12.5.534</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000615"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>defection</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10539-011-9297-8</dc:source>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2012</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000615"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>cheat deception</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000615"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Cleaners are also partial to cheating and occasionally they nip the skin of clients to obtain a cheap meal. It is perhaps not surprising that they are far less inclined to perform this behaviour if the client is a predator.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10071-014-0761-0</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000615"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;If a pair of fish inspects a predator, they glide back and forth as they advance towards the predator each taking it in turn to lead. If a partner should defect or cheat in any way, perhaps by hanging back, the other fish will refuse to cooperate with that individual on future encounters.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10071-014-0761-0</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000616 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000616">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001431"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-18T12:34:46.797261Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym xml:lang="en">attachment</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>hold fast</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Kinetics activity which fixes to a substrate.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>adhesion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>appress</oboInOwl:hasRelatedSynonym>
        <rdfs:label>adhesion kinetics</rdfs:label>
        <skos:example>&quot;Aequidens latifrons...
On the foremost part of the head, that lies in this stage closely against the yolk, two adhesive organs are situated one behind the other. They produce a mucoid secrete by which the larva attaches itself to the substrate (sand, plants etc.).&quot;</skos:example>
        <skos:example>&quot;The body wall of Metridium may be divided into three functional regions which are to some extent independent of each other... The region of the pedal disk is concerned with adhesion and locomotion.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000616"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget xml:lang="en">attachment</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2003</dc:date>
        <dc:source>ISBN:9781482294347</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000616"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>hold fast</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000616"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics activity which fixes to a substrate.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The head is still fixed to the substrate with the adhesive organs...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000616"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>adhesion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000616"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>appress</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000616"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>adhesion kinetics</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000616"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Aequidens latifrons...
On the foremost part of the head, that lies in this stage closely against the yolk, two adhesive organs are situated one behind the other. They produce a mucoid secrete by which the larva attaches itself to the substrate (sand, plants etc.).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000616"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The body wall of Metridium may be divided into three functional regions which are to some extent independent of each other... The region of the pedal disk is concerned with adhesion and locomotion.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000617 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000617">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000335"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MF_0000060"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000487"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-18T17:05:56.987892Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Perception that has a temporal pattern related to the predictability of, value of, and competition for, a resource.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">waiting</oboInOwl:hasExactSynonym>
        <rdfs:label>waiting perception</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000311"/>
        <skos:example>&quot;...predators capable of waiting for long periods (e.g. L. piscatorius...) choose to target active (high-energy density) prey that are encountered less frequently because they are more sparsely distributed, or lower in abundance, but that when captured yield a greater net energy gain than more frequent captures of more numerous but less energy-rich prey.&quot;</skos:example>
        <skos:example>&quot;If there are a number of clients waiting to be serviced, cleaner fish will prioritise transients, knowing that the locals have nowhere else to go.&quot;</skos:example>
        <skos:example>&quot;Thus it is possible that the &quot;coyness&quot; of females sometimes represents waiting for a signal that a dominant male&apos;s approach will lead to copulation rather than attack...&quot;</skos:example>
        <skos:relatedMatch>NBO:0000459</skos:relatedMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000617"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Perception that has a temporal pattern related to the predictability of, value of, and competition for, a resource.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1098/rspb.2013.2997</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000617"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">waiting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000617"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>waiting perception</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000617"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...predators capable of waiting for long periods (e.g. L. piscatorius...) choose to target active (high-energy density) prey that are encountered less frequently because they are more sparsely distributed, or lower in abundance, but that when captured yield a greater net energy gain than more frequent captures of more numerous but less energy-rich prey.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1098/rspb.2013.2997</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000617"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;If there are a number of clients waiting to be serviced, cleaner fish will prioritise transients, knowing that the locals have nowhere else to go.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10071-014-0761-0</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000617"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Thus it is possible that the &quot;coyness&quot; of females sometimes represents waiting for a signal that a dominant male&apos;s approach will lead to copulation rather than attack...&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000618 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000618">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000358"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000617"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-18T17:06:19.054679Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Hunt that involves stealthy waiting.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">ambush</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">ambush hunt</rdfs:label>
        <skos:closeMatch>NBO:0015000</skos:closeMatch>
        <skos:example>&quot;The four kills (two by Synodus ulae and two by Scorpaenopsis cirrhosa) were from short ambush attacks (2-10cm) on bobbing labrids that approached too close within the algae to the well camouflaged predators.&quot;</skos:example>
        <skos:scopeNote>&quot;In a foraging context, for example, how long an ambush predator waits in a particular location in the absence of prey encounters before energy is expended in moving to a new location will have an important impact on positive energy balance and hence growth rate.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000618"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Hunt that involves stealthy waiting.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/beheco/12.5.534</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Azteca ants not only overpower prey as groups, but they stealthily ambush prey by lining themselves along the underside margin of leaves and waiting for prey to land on the upper side of the leaf.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000618"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">ambush</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1987</dc:date>
        <dc:source>doi:10.11369/jji1950.34.76</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000618"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">ambush hunt</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000618"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The four kills (two by Synodus ulae and two by Scorpaenopsis cirrhosa) were from short ambush attacks (2-10cm) on bobbing labrids that approached too close within the algae to the well camouflaged predators.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.11369/jji1950.34.76</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000618"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In a foraging context, for example, how long an ambush predator waits in a particular location in the absence of prey encounters before energy is expended in moving to a new location will have an important impact on positive energy balance and hence growth rate.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1098/rspb.2013.2997</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000619 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000619">
