    <!-- http://purl.obolibrary.org/obo/ACTAN_0000152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001817"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-23T07:50:35.502166Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that is long-distance, continuous, steady, and intermediate speed.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>cruise</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cruising</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">endurance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>sustained</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cruise kinetics</rdfs:label>
        <skos:example>&quot;Thus, it seems that hermit crabs have specialized in slow endurance locomotion while carrying a heavy load and have traded off sprinting behaviour for the protection of a mobile home.&quot;</skos:example>
        <skos:scopeNote>&quot;...steady locomotion is more the exception than the rule for animals traveling through natural environments...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Several gregarious predators, like canids, and other fast herbivores, like the pronghorn and some antelopes, need high endurance, that is to maintain the running speed as long as possible.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000152"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics that is long-distance, continuous, steady, and intermediate speed.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/41.2.137</dc:source>
    </owl:Axiom>
