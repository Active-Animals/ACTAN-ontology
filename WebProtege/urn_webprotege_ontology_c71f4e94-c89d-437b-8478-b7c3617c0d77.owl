    <!-- http://purl.obolibrary.org/obo/ACTAN_0000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000017"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-06-20T09:23:37.516063Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Pattern which aggregates repertoire structural elements by scope and scale.</oboInOwl:hasDefinition>
        <oboInOwl:hasRelatedSynonym>resultant</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">component pattern</rdfs:label>
        <skos:scopeNote>&quot;...it takes no little patience to observe clearly and note the motions of the various elements involved, and to resolve the resultant into its often numerous components.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000011"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Pattern which aggregates repertoire structural elements by scope and scale.</owl:annotatedTarget>
        <rdfs:comment>This is an aggregator class: please DON&apos;T use it for annotation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000011"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>resultant</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000011"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">component pattern</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
