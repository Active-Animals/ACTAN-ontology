        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002261"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-08T07:06:43.93759Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Travel that involves absolute spatial information.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">absolute spatial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>localisation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>localization</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>locally attracted</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>navigational</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>place</oboInOwl:hasRelatedSynonym>
        <rdfs:label>localization travel</rdfs:label>
        <skos:scopeNote>&quot;But in the case of an island, or of a country partly surrounded by barriers, into which new and better adapted forms could not freely enter, we should then have places in the economy of nature which would assuredly be better filled up, if some of the original inhabitants were in some manner modified; for, had the area been open to immigration, these same places would have been seized on by intruders.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Primates naturally occupy complex, arboreal habitats in which they navigate discontinuous substrates that vary in height, diameter, inclination, and compliance.&quot;</skos:scopeNote>
        <skos:scopeNote>This class is about locomotion with reference to an external frame. NB: Perching involves minimal locomotion within a reference frame; migrating involves locomotion within a potentially global reference frame.</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000290"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Travel that involves absolute spatial information.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/1365-2656.12379</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Clearly, the lack of absolute spatial information is crippling to the purely relative velocity-based methods.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000290"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">absolute spatial</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2016</dc:date>
