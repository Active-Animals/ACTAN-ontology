        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-12T16:42:27.506332Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Contracting which causes a ring of reducing diameter.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">narrowing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">narrowing contracting</rdfs:label>
        <skos:example>&quot;Anemones expand mainly at night. The column commonly is constricted at the point acontia are emitted.&quot;</skos:example>
        <skos:example>&quot;Metridium...
Constriction of the circular muscle fibres narrows the column.&quot;</skos:example>
    </owl:Class>
