        <oboInOwl:creation_date>2025-08-06T20:16:27.063223Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Waterproofing routine that spreads lipid over the body using hands and feet.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>wiping behaviour</oboInOwl:hasExactSynonym>
        <rdfs:label>wiping routine</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000789"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Waterproofing routine that spreads lipid over the body using hands and feet.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/brv.12010</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;During wiping, frogs spread lipid substances all over their body using their hands and feet.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000789"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
