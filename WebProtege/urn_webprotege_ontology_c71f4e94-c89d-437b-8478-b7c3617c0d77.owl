        <oboInOwl:hasDefinition>Movement that uses an elongated object to detect the contents of a substrate.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>probe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">probing</oboInOwl:hasExactSynonym>
