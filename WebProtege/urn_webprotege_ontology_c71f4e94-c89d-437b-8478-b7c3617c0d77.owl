    <!-- http://purl.obolibrary.org/obo/ACTAN_0000986 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000986">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000526"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000475"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:nodeID="genid7274"/>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/group_behaviour"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-16T16:18:54.81172Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mate-search aggregation which involves spawning.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>aggregate spawning</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>group spawning</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spawning aggregate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">spawning aggregation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">spawn aggregation</rdfs:label>
        <skos:example>&quot;...at the Whyalla spawning grounds, South Australia (32°59′5 S; 137°43′1 E) between the months of May and July... giant Australian cuttlefish aggregate by the thousands to spawn on the hard substrate.&quot;</skos:example>
        <skos:example>&quot;During periods of reproductive activity, large numbers of T.cupido gather in groups of varying sizes at the spawning site. It is estimated that the largest of these groups comprise as many as 150 individuals. Collections from among spawning aggregates revealed a heavy preponderance of males.&quot;</skos:example>
        <skos:scopeNote>&quot;Spawning aggregates are not always well defined, isolated entities; aggregates may merge with neighboring groups or may break into yet smaller units.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid7274">
