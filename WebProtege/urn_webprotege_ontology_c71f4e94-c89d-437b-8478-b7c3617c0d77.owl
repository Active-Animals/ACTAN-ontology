        <oboInOwl:creation_date>2024-10-05T15:12:11.634392Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Posture in which the body weight is borne predominantly by the feet, with supporting legs relatively extended.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">standing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>standing posture</oboInOwl:hasExactSynonym>
        <rdfs:label>stand posture</rdfs:label>
        <skos:example>&quot;The rock-thrush of Guiana, birds of Paradise, and some others, congregate; and successive males display their gorgeous plumage and perform strange antics before the females, which standing by as spectators, at last choose the most attractive partner.&quot;</skos:example>
        <skos:relatedMatch>NBO:0000081</skos:relatedMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000245"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Posture in which the body weight is borne predominantly by the feet, with supporting legs relatively extended.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
