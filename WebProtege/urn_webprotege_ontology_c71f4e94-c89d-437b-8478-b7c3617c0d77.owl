    <!-- http://purl.obolibrary.org/obo/ACTAN_0000742 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000742">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000620"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000622"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-06-11T11:21:02.186885Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement that results from telescoping expanding.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">telescoping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>protruded</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">telescoping expansion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000742"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Placement that results from telescoping expanding.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
