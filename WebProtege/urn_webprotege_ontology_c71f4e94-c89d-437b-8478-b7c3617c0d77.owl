    <!-- http://purl.obolibrary.org/obo/ACTAN_0000602 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000602">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000732"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_4000163"/>
