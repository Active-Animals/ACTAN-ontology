        <dc:source>doi:10.1093/icb/36.6.555</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000363 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000363">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000358"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000063"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-22T11:27:11.860291Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Hunt in which special structures process the surrounding water to retain small food particles.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>filter feeding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">suspension feeding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>plankton feeding</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>sieving</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>harvesting</oboInOwl:hasRelatedSynonym>
        <rdfs:label>filter hunt</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000713"/>
        <skos:scopeNote>&quot;SUSPENSION-FEEDING AQUATIC ANIMALS capture planktonic prey as water flows past the feeding apparatus.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000363"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Hunt in which special structures process the surrounding water to retain small food particles.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.jstor.org/stable/24815071</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The terms &apos;suspension feeding&apos; or &apos;filter feeding&apos; have been coined to designate feeding in aquatic animals that have evolved special structures to process the surrounding water and to retain small suspended particles, including food particles such as phytoplankton cells.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000363"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>filter feeding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1983</dc:date>
        <dc:source>https://www.jstor.org/stable/24815071</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000363"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">suspension feeding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1983</dc:date>
        <dc:source>https://www.jstor.org/stable/24815071</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000363"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
