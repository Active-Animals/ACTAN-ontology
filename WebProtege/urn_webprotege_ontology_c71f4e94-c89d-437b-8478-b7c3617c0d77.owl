    <!-- http://purl.obolibrary.org/obo/ACTAN_0000686 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000686">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_manoeuvre"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-07T18:38:42.859709Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Rotation that yawing culminates in.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">rotated</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rotation</oboInOwl:hasExactSynonym>
        <rdfs:label>rotation placement</rdfs:label>
        <skos:example>&quot;Rotation of the phallus in Lygaeus does not simply result from rotation of the abdomen but from the expansion of a membranous portion of the phallus. These membranes are spirally folded so that their expansion rotates the phallus.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000686"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Rotation that yawing culminates in.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000686"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">rotated</owl:annotatedTarget>
