    <!-- http://purl.obolibrary.org/obo/ACTAN_0000697 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000697">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000355"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000786"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-28T11:06:59.935181Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Graze in which a bite is restricted to removal of material from the surface of the substratum.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>scraping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>gouging</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">scrape graze</rdfs:label>
        <skos:example>&quot;The scrapers... functional group encompasses... Scarus... altipinnis, S. chameleon, S. dimidiatus, S. flavipectoralis... and Hipposcarus longiceps.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000697"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Graze in which a bite is restricted to removal of material from the surface of the substratum.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/BF00751035</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The term scrapers implies a non-excavating bite which is restricted to removal of material from the surface of the substratum.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000697"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
