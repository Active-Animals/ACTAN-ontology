        <oboInOwl:creation_date>2025-04-23T14:00:46.632933Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Homeostasis that can gain and lose volume.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">volume control</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">volume homeostasis</rdfs:label>
        <skos:example>&quot;Metridium senile exhibits a great variety of shapes of the body. These are brought about by continual slow muscular activity... by which the animal itself increases or reduces extension by controlling its coelenteric volume... chiefly through the siphonoglyph, though under certain conditions there may be suction into the coelenteron. Fluid is lost chiefly through reflex opening of the mouth. From time to time Metridium empties itself of fluid, and then refills in a few hours.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000665"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Homeostasis that can gain and lose volume.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1242/jeb.27.3.264</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The animal can control both its gain and loss of coelenteric volume.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000665"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">volume control</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000665"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">volume homeostasis</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000665"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Metridium senile exhibits a great variety of shapes of the body. These are brought about by continual slow muscular activity... by which the animal itself increases or reduces extension by controlling its coelenteric volume... chiefly through the siphonoglyph, though under certain conditions there may be suction into the coelenteron. Fluid is lost chiefly through reflex opening of the mouth. From time to time Metridium empties itself of fluid, and then refills in a few hours.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000666 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000666">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000381"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-04-23T14:51:51.679912Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Homeostasis that provides the tissue pressure necessary for shape and activity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>inflation pressure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">turgor</oboInOwl:hasExactSynonym>
        <rdfs:label>turgor homeostasis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000743"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000744"/>
        <skos:example>&quot;In animals which, like Metridium, possess a hydrostatic skeleton, the high pressure and deformation following maximal retraction for a time disorganize the whole mechanism of response in a way which is without parallel in animals with jointed skeletons, like the Vertebrates... In the hydrostatic skeletal system muscular contraction involves far greater change in length. The contraction of the muscle may be of almost identical extent with the movement of a part, as in the carriage of the prey to the mouth by the contraction of an extended tentacle of Hydra. Such extensive movements cannot be performed without great deformation, and if they are performed quickly there must be great waste of energy in this. The slowness of muscular action in Metridium has been repeatedly illustrated, and in general the hydrostatic skeletal system is characteristic of slow-moving animals. Only in such slow animals can great tissue deformation be executed without great inefficiency.&quot;</skos:example>
        <skos:example>&quot;Turgid female toads give males the slip: a new mechanism of female mate choice in the Anura... inflated female toads are more difficult for males to hold on to, and that the ability of a female to inflate her body facilitates takeovers by larger rival males.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000666"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Homeostasis that provides the tissue pressure necessary for shape and activity.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000666"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>inflation pressure</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1098/rsbl.2009.0938</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000666"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">turgor</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000666"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>turgor homeostasis</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000666"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In animals which, like Metridium, possess a hydrostatic skeleton, the high pressure and deformation following maximal retraction for a time disorganize the whole mechanism of response in a way which is without parallel in animals with jointed skeletons, like the Vertebrates... In the hydrostatic skeletal system muscular contraction involves far greater change in length. The contraction of the muscle may be of almost identical extent with the movement of a part, as in the carriage of the prey to the mouth by the contraction of an extended tentacle of Hydra. Such extensive movements cannot be performed without great deformation, and if they are performed quickly there must be great waste of energy in this. The slowness of muscular action in Metridium has been repeatedly illustrated, and in general the hydrostatic skeletal system is characteristic of slow-moving animals. Only in such slow animals can great tissue deformation be executed without great inefficiency.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000666"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Turgid female toads give males the slip: a new mechanism of female mate choice in the Anura... inflated female toads are more difficult for males to hold on to, and that the ability of a female to inflate her body facilitates takeovers by larger rival males.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1098/rsbl.2009.0938</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000667 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000667">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000479"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PCO_0000020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-04-27T14:15:00</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Caring that involves progeny.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>parental care</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>parenting</oboInOwl:hasExactSynonym>
        <rdfs:label>parenting caring</rdfs:label>
        <skos:broadMatch>NBO:0000044</skos:broadMatch>
        <skos:example>&quot;Several species of foxes have been observed living in bonded pairs sharing parenting duties...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000667"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Caring that involves progeny.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.jstor.org/stable/986582</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In &quot;ordinary&quot; competition of this sort, the better the teeth the better the nutrition and hence, presumably, the greater the number or success of progeny; reproductive success is some simple direct function of quality.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000667"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>parental care</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000667"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>parenting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:date>
        <dc:source>doi:10.1016/j.yhbeh.2021.105062</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000667"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>parenting caring</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000667"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Several species of foxes have been observed living in bonded pairs sharing parenting duties...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.yhbeh.2021.105062</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000668 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000668">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000826"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001309"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-04T12:58:06.476016Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Water inspiration that ventilates the gills with surface water.

Common during hypoxia.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>ASR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">aquatic surface respiration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>surface film inhaling</oboInOwl:hasExactSynonym>
        <rdfs:label>surface-water inspiration</rdfs:label>
        <skos:closeMatch>NBO:0040004</skos:closeMatch>
        <skos:example>&quot;Their bodies were tilted upward anteriorly about 45°, just enough to bring their mouths into contact with the surface. The oxygen-rich surface film was then inhaled arid passed over the gills. The opercular movements appeared to be the same as those seen in normal aquatic respiration. At no time did a Badis badis entrap air bubbles in, or pass them through, the gill chamber.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000668"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Water inspiration that ventilates the gills with surface water.

Common during hypoxia.</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.198.1.79</dc:source>
        <skos:scopeNote>&quot;The role of a buccal gas bubble, held while performing aquatic surface respiration (ASR; ventilating the gills with surface water during hypoxia), was examined in benthic, intertidal Australian gobies.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000668"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>ASR</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1242/jeb.198.1.79</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000668"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">aquatic surface respiration</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1242/jeb.198.1.79</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000668"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>surface film inhaling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
        <skos:scopeNote>&quot;...surface film was then inhaled...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000668"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>surface-water inspiration</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000668"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Their bodies were tilted upward anteriorly about 45°, just enough to bring their mouths into contact with the surface. The oxygen-rich surface film was then inhaled arid passed over the gills. The opercular movements appeared to be the same as those seen in normal aquatic respiration. At no time did a Badis badis entrap air bubbles in, or pass them through, the gill chamber.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000669 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000669">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
