        <owl:annotatedTarget xml:lang="en">ascent manoeuvre</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000557"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Baboons often ascended by alternately leaping and walking on slightly angled WBS [weight bearing structures], whereas chimpanzees used less saltatory locomotor modes.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000557"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Nocomis leptocephalus...
Once released, the female continued to rise vertically into the water column...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000558 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000149"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000365"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/manoeuvre"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-28T11:31:28.062679Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>A manoeuvre that is downward.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>descent</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>downwards</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>falling</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sink</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">descent manoeuvre</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000192"/>
        <skos:example>&quot;Coenobita compressus is a terrestrial hermit crab living in the rocks and grass above high tide in the tropics. Usually, by day it is quiescent and at night it descends to the beaches to scavenge organic debris along the moist sand.&quot;</skos:example>
        <skos:example>&quot;Thalassoma cupido...
Immediately after spawning, the fish move slightly apart and swim downwards with great rapidity.&quot;</skos:example>
        <skos:example>&quot;When approaching a roost from upwing or a feeding area surrounded by tall trees, A. ibis occasionally descend with a rapid side-slipping swerving flight... Swerving flight clearly serves to check the rate of descent when a bird is flying steeply downwards...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000558"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>A manoeuvre that is downward.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/j.1744-7429.2000.tb00506.x</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Gliding and parachuting are most usefully distinguished for species operating at the extremes of descent angle. This is because Oliver&apos;s (1951) 45° demarcation is arbitrary (except at this angle, lift = drag) and frustrating to assess, owing to the unpredictability of air currents and the flexibility available to many organisms in choosing their downward angle and continuously changing this angle during the course of descent.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000558"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>descent</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000558"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>downwards</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
