    <!-- http://purl.obolibrary.org/obo/ACTAN_0000882 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000387"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000457"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-13T17:02:30.102445Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Dominance which extends over all others

It ignores their territories without being resisted. There may be subordinate tyrants.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">tyranny</oboInOwl:hasExactSynonym>
        <rdfs:label>tyranny dominance</rdfs:label>
        <skos:example>&quot;Thalassoma cupido...
Most groups contain a single individual that behaves quite differently towards the other aggregate members, often treating them aggressively. These individuals are positioned at the periphery of the aggregation and have a greater range of movements, swimming around and above the others. They exhibit individualistic behavior, typified by more forceful movements and a distinctive manner of swimming whereby the pectoral fins are fluttered rapidly, conspicuously displaying their blackened tips.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000882"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Dominance which extends over all others

It ignores their territories without being resisted. There may be subordinate tyrants.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;There is, however, one tyrant that dominates over all other members, and ignores the territories without being resisted.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000882"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">tyranny</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <skos:scopeNote>&quot;...the tyrant...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000882"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>tyranny dominance</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000882"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Thalassoma cupido...
Most groups contain a single individual that behaves quite differently towards the other aggregate members, often treating them aggressively. These individuals are positioned at the periphery of the aggregation and have a greater range of movements, swimming around and above the others. They exhibit individualistic behavior, typified by more forceful movements and a distinctive manner of swimming whereby the pectoral fins are fluttered rapidly, conspicuously displaying their blackened tips.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000883 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000883">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000746"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000375"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-14T08:17:32.050503Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Vergence in which adduction draws the intersection of the optical axes closer in.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">con-vergence</rdfs:label>
        <skos:example>&quot;...zebrafish larvae... J-turns, approach swims, and capture strikes occupy the prey capture region of the behavioral space and predominantly occurred when the eyes were converged.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000883"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Vergence in which adduction draws the intersection of the optical axes closer in.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://core.ac.uk/download/pdf/85255156.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000883"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">con-vergence</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>https://core.ac.uk/download/pdf/85255156.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000883"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...zebrafish larvae... J-turns, approach swims, and capture strikes occupy the prey capture region of the behavioral space and predominantly occurred when the eyes were converged.&quot;</owl:annotatedTarget>
        <rdfs:comment>doi:10.1016/j.cub.2019.11.022</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000884 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000884">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000746"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000374"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-14T08:17:41.68751Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Vergence in which abduction draws the intersection of the optical axes further out.

In some animals it can pass the point where optical axes are parallel.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">di-vergence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000884"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Vergence in which abduction draws the intersection of the optical axes further out.

In some animals it can pass the point where optical axes are parallel.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://core.ac.uk/download/pdf/85255156.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000884"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">di-vergence</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>https://core.ac.uk/download/pdf/85255156.pdf</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000885 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000885">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000411"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000182"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000406"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000662"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/group_behaviour"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-14T09:03:32.959655Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Aggregation that is 3-dimensional, polarized and aerial.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">flocking</oboInOwl:hasExactSynonym>
        <rdfs:label>flock aggregation</rdfs:label>
        <skos:example>&quot;The starlings, at least, remained in a dense flock, trying to evade the attacker by manoeuvering as one compact mass.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000885"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Aggregation that is 3-dimensional, polarized and aerial.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000885"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">flocking</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
        <rdfs:comment>NB: As well as birds in flight (3-dimensions: our term meaning), Darwin uses the term for a group of sheep on the ground (2-dimensions: not our term meaning).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000885"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>flock aggregation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000885"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The starlings, at least, remained in a dense flock, trying to evade the attacker by manoeuvering as one compact mass.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000886 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000886">
