        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000264"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>If a relevant ontology is developed, this would become a subtype of a mating ethotype.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
