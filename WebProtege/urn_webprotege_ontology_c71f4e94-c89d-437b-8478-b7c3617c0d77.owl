        <oboInOwl:creation_date>2026-07-07T05:23:37.010802Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Undulation pattern in which a wave passes along the periphery of an elongate structure.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>longitudinal undulation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">longitudinal-undulation pattern</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000015"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Undulation pattern in which a wave passes along the periphery of an elongate structure.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000015"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
