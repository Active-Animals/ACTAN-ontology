    <!-- http://purl.obolibrary.org/obo/ACTAN_0000983 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000983">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000982"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000772"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-16T10:42:56.821611Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Bob in which the entire body is moved steadily in alternating directions in a fluid, by simultaneous strokes of the propulsors.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">flapping bob</rdfs:label>
        <skos:example>&quot;Thalassoma cupido...
The characteristic motor pattern among these fish is a peculiar bobbing motion in which the entire body is moved steadily up and down by simultaneous vertical strokes of the pectoral fins. Bobbing fish swim slowly, sometimes barely moving forward at all, and often brush against the bodies of others swimming below or nearby.&quot;</skos:example>
        <skos:scopeNote>&quot;In the viscous world of microscopic organisms, fluid motions are damped out as soon as an organism stops flapping or undulating, bodies do not coast, and a back-and-forth flap puts you back where you started.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000983"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Bob in which the entire body is moved steadily in alternating directions in a fluid, by simultaneous strokes of the propulsors.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000983"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">flapping bob</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000983"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Thalassoma cupido...
The characteristic motor pattern among these fish is a peculiar bobbing motion in which the entire body is moved steadily up and down by simultaneous vertical strokes of the pectoral fins. Bobbing fish swim slowly, sometimes barely moving forward at all, and often brush against the bodies of others swimming below or nearby.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000983"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In the viscous world of microscopic organisms, fluid motions are damped out as soon as an organism stops flapping or undulating, bodies do not coast, and a back-and-forth flap puts you back where you started.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    


