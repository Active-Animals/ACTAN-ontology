    <!-- http://purl.obolibrary.org/obo/ACTAN_0000810 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000810">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000809"/>
        <rdfs:subClassOf>
