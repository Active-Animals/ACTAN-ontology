    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000810"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>wing arch</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2016</dc:date>
        <dc:source>doi:10.1676/1559-4491-128.3.628</dc:source>
        <skos:scopeNote>&quot;...arched wings...&quot;</skos:scopeNote>
    </owl:Axiom>
