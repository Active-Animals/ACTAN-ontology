    <!-- http://purl.obolibrary.org/obo/ACTAN_0000993 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000993">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000288"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000375"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-21T17:02:11.241753Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Relativity which anticipates the course of another and moves to meet it.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>intercepting</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">interception relativity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000890"/>
        <skos:example>&quot;...a female anuran... approaching quality territories or males may be intercepted by ‘satellite’ males, which attempt to force a mating...&quot;</skos:example>
        <skos:example>&quot;...males in other species of cricket adopt a strategy of silently intercepting females attracted by the calls of other males...&quot;</skos:example>
        <skos:example>&quot;T. cupido... often a male would be forced to stray to the outskirts of his comparatively large territory... and intercept females from passing aggregations.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000993"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Relativity which anticipates the course of another and moves to meet it.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000993"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>intercepting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000993"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">interception relativity</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000993"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...a female anuran... approaching quality territories or males may be intercepted by ‘satellite’ males, which attempt to force a mating...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1098/rsbl.2009.0938</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000993"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...males in other species of cricket adopt a strategy of silently intercepting females attracted by the calls of other males...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10164-009-0176-6</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000993"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;T. cupido... often a male would be forced to stray to the outskirts of his comparatively large territory... and intercept females from passing aggregations.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000994 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000994">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-22T06:21:06.303615Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>alternative mating tactic</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>conditional alternative</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>facultative alternative</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>parasitic tactic</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Mating in which an inferior exploits the investment of a primary-access rival.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>kleptogamy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>parasitic mating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reproductive parasite</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>parasitic spawning</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>satellite</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>sneaking</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>sneaky mating</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>stealing spawning</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>parasitic exploitation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>parasite mating</rdfs:label>
        <skos:example>&quot;...examples are the formation of coalitions in male olive baboons Papio anubis during sneaky matings...&quot;</skos:example>
        <skos:example>&quot;...in N micropogon a subordinate acted like a satellite male and stole spawns from the nest-building male.&quot;</skos:example>
        <skos:example>&quot;Initial phase males of T. bifasciatum may also engage in pair spawning activities by &quot;sneaking&quot;&quot;.</skos:example>
        <skos:scopeNote>&quot;An animal behaviourist mapping the territories of individual males is especially likely to assign the label of ‘sneaker’ to a comparatively smaller male that enters an area assigned as the territory of another (usually larger) male, even if the two males do not interact with one another. Indeed, the term ‘sneaker’ suggests that the first male will behave surreptitiously to avoid interacting with the second male. A ‘sneaker’ thus can be seen as not only a transgressor of territorial boundaries but also a perpetrator of infidelity, reinforcing an underlying assumption that only the dominant, territorial figure has legitimate claim to a space or the contents of that space. 

When nonterritorial or nondominant individuals are defined primarily in terms of their purported transgressions against dominant, territorial males, it can become difficult to interpret their behaviour in any other light.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Courtship plays an essential role in reproduction as it is often required for copulation to occur, with the exception of sneaky and forced copulations.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;However, parasitism clearly results in a significant number of inseminations and has none of the defensive costs of maintaining a territory.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Individuals who lose out or resign under social competition usually do not simply retire from life or sit back and watch the winners take all. They frequently adopt alternative competitive patterns, sometimes involving specialized behavior and morphology, which enable them to salvage some reproductive output even though defeated.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000994"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
