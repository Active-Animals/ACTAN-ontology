        <oboInOwl:creation_date>2026-07-28T11:07:40.836436Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Graze which only removes portions of organisms when feeding.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>cropping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>algal‐cropping</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">crop graze</rdfs:label>
        <skos:example>&quot;Cropping species, primarily members of the Acanthuridae and Siganidae, remove the upper portions of the algae when feeding, which maintains algae in cropped states, promoting coral settlement and preventing transitions to fleshy macroalgae.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000749"/>
