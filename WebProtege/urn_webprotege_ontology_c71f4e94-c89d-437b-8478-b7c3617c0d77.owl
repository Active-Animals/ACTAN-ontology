        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000231"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In some cases, animals were documented to move using only their axial body; for example, the ropefish Erpetoichthys calabaricus, which moves in terrestrial environments using a lateral undulatory motion of the vertebral column, where there is no contact between the appendages and the ground.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
