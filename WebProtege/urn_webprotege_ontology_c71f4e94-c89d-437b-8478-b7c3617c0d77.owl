                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010483"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-07T08:09:59.57035Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Construction that digs a pit.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">excavation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hollow</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>nest-building</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">excavation construction</rdfs:label>
        <skos:example>&quot;...the bees instantly began to excavate minute circular pits in it; and as they deepened these little pits, they made them wider and wider until they were converted into shallow basins...&quot;</skos:example>
        <skos:example>&quot;Campostoina anomalum typically spawns over a pit excavated by the male in riffles where a number of males may guard and maintain spawning pits in close proximity.&quot;</skos:example>
        <skos:scopeNote>&quot;Other forms of animal architecture do not require attaching or cobbling matter together, but rather excavating material from a substrate.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000281"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Construction that digs a pit.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.5962/bhl.title.82303</rdfs:isDefinedBy>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000281"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
