                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000929"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T21:24:42.369963Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flying-regime whose exaggerated, vigorous manoeuvres appear to push the animal to its energetic limits.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">aerobatic display</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>song flights</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">aerobatics regime</rdfs:label>
        <skos:example>&quot;Many birds have song flights and elaborate aerial displays, including the roding display of the Eurasian woodcock (Scolopax rusticola), the dive and shuttle of Anna’s hummingbird (Calypte anna), and the sky dancing of the Montagu’s harrier (Circus pygargus).&quot;</skos:example>
        <skos:scopeNote>&quot;The aerobatic dives and high-energy courtship displays of hummingbirds appear to push males towards the limits of flight performance.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000437"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flying-regime whose exaggerated, vigorous manoeuvres appear to push the animal to its energetic limits.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1002/bies.202000183</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000437"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">aerobatic display</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2021</dc:date>
        <dc:source>doi:10.1002/bies.202000183</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000437"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>song flights</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2017</dc:date>
        <dc:source>doi:10.1007/978-3-319-68576-2_3</dc:source>
    </owl:Axiom>
    <owl:Axiom>
