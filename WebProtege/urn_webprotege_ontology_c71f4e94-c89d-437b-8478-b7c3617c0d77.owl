        <oboInOwl:creation_date>2024-10-02T09:55:53.494896Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Walk gait that is diagonal-sequence, diagonal-couplet, and vaulting.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">DSDC walk</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>diagonal-sequence, diagonal-couplet walk</oboInOwl:hasExactSynonym>
        <rdfs:label>DSDC-walk gait</rdfs:label>
        <skos:example>&quot;Quadrupedal primates are distinguished from other quadrupedal mammals in the common use of diagonal-sequence footfall patterns.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000227"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
