    <!-- http://purl.obolibrary.org/obo/ACTAN_0000879 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000879">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000829"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-13T15:48:05.475425Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Territorialism in which a female remains in the neighbourhood of a male, and will not cross the boundary.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">joining</oboInOwl:hasExactSynonym>
        <rdfs:label>joining territorialism</rdfs:label>
        <skos:example>&quot;In the Hemichromis type the male begins to secure a territory where he is joined by a female, and both take care of the eggs or the young, the latter remain in the territory at least untill they are able to swim.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000879"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Territorialism in which a female remains in the neighbourhood of a male, and will not cross the boundary.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;So if a female joins a boundary fight, it is usually to assist the male and, as she remains in the neighbourhood of the male, she will not cross the boundary.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000879"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">joining</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000879"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>joining territorialism</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000879"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In the Hemichromis type the male begins to secure a territory where he is joined by a female, and both take care of the eggs or the young, the latter remain in the territory at least untill they are able to swim.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000880 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000880">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000385"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0015003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-13T16:17:38.863369Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Territorialism which offers very weak defense against a particular neighbour crossing their boundary.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>accepting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tolerating</oboInOwl:hasExactSynonym>
        <rdfs:label>tolerating territorialism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000881"/>
        <skos:example>&quot;Thalassoma cupido...
The male dominates the area during his presence, actively chasing away some conspecifics. The tolerance with which other conspecifics are treated upon intrusion suggests that territories are defended against competitive males only, in defense of potential spawning partners. Fish that are not attacked apparently pose no threat to the reproductive success of the male.&quot;</skos:example>
        <skos:scopeNote>&quot;...the danger that one member of a pair will tolerate or even mate with a stranger only exists before the eggs have been laid, or in the case of the male, when at the end of the rearing period he is anxious to begin a new breeding cycle.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000880"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Territorialism which offers very weak defense against a particular neighbour crossing their boundary.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000880"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>accepting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000880"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>tolerating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000880"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>tolerating territorialism</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000880"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Thalassoma cupido...
The male dominates the area during his presence, actively chasing away some conspecifics. The tolerance with which other conspecifics are treated upon intrusion suggests that territories are defended against competitive males only, in defense of potential spawning partners. Fish that are not attacked apparently pose no threat to the reproductive success of the male.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000880"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...the danger that one member of a pair will tolerate or even mate with a stranger only exists before the eggs have been laid, or in the case of the male, when at the end of the rearing period he is anxious to begin a new breeding cycle.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000881 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000881">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000552"/>
        <rdfs:subClassOf rdf:nodeID="genid6642"/>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-13T16:35:53.434439Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Ranking which secures a free passage through another&apos;s territory.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">peace making</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>ambivalent behaviour</oboInOwl:hasRelatedSynonym>
        <rdfs:label>peace-making ranking</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000880"/>
        <skos:example>&quot;A Tilapia male, when still in his own territory, will sometimes become pale, cross the boundary, and swim through other territories practically unattacked.&quot;</skos:example>
        <skos:relatedMatch>NBO:0020279</skos:relatedMatch>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid6642">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000881"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid6642"/>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000881"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Ranking which secures a free passage through another&apos;s territory.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;LORENZ reports that the night heron possesses certain signal movements (raising of the crest) that when showed to a neighbour, secure it a free passage through the other one&apos;s territory.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
