    <!-- http://purl.obolibrary.org/obo/ACTAN_0000205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000124"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000091"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000199"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000056"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-30T07:15:30.352937Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Stepping gait that is bouncing, asymmetric, quadrupedal, all footfalls occur at about the same instant, and there is one long suspension that is transitional between gathered and extended.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>pronk</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">stott</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>bound</oboInOwl:hasRelatedSynonym>
        <rdfs:label>stott gait</rdfs:label>
        <skos:closeMatch>NBO:0070004</skos:closeMatch>
        <skos:scopeNote>&quot;This gait is not functional to speed, but is used by the mentioned species as a fitness proof, to damp predators from catching them.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000205"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Stepping gait that is bouncing, asymmetric, quadrupedal, all footfalls occur at about the same instant, and there is one long suspension that is transitional between gathered and extended.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.2307/1379571</dc:source>
        <skos:scopeNote>&quot;If all footfalls occur at about the same instant, the gait is a bound of the kind termed the prank ( or stott). The pronk has one long  suspension that is transitional between gathered and extended.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000205"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pronk</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.2307/1379571</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000205"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">stott</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.2307/1379571</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000205"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>bound</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
        <dc:source>doi:10.2307/1379571</dc:source>
        <rdfs:comment>Hildebrand stated, &quot;the gait is a bound,&quot; (doi:10.2307/1379571), but Struble and Gibb have differentiated between the two, noting that in a bound, &quot;footfalls of the fore and hindfoot pairs are not simultaneous,&quot; (doi:10.1093/icb/icac125).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000205"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>stott gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000205"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;This gait is not functional to speed, but is used by the mentioned species as a fitness proof, to damp predators from catching them.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.13130/biancardi-carlo-massimo_phd2012-01-31</dc:source>
    </owl:Axiom>
    


