    <!-- http://purl.obolibrary.org/obo/ACTAN_0000524 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000524">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000335"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000925"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003942"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-14T15:53:25.844301Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Perception which senses touch cues from the environment.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>feeling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tactile sense</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">touching</oboInOwl:hasExactSynonym>
        <rdfs:label>feel perception</rdfs:label>
        <skos:closeMatch>NBO:0000332</skos:closeMatch>
        <skos:example>&quot;Hemichromis bimaculatus type...

With the ovipositor the female feels all over the substrate; she usually lays eggs only on the spot cleaned before, and only seldom are the eggs laid upon each other.&quot;</skos:example>
        <skos:example>&quot;In both species of Nocomis.... Observations of nocturnal spawning... suggest that coordination of the spawning act is facilitated, at least in part, by tactile cues between the male, female and spawning substrate.&quot;</skos:example>
        <skos:scopeNote>&quot;In arthropods, the leading legs are frequently used like feelers, as if seeking points of contact.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;We first induced a dash with an anterior wave by tapping the centipede’s tail. When it approached the boundary and its antenna touched the plastic surface (t ≈ 0.5 s), it rapidly slowed down for a short time, then started crawling at a slower speed (t ≈ 0.75 s).&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000524"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Perception which senses touch cues from the environment.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1038/s41467-023-38685-1</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;C. elegans can sense and modulate behavioral states in response to a wide range of sensory and physiological cues such as touch, odors, light, sound, oxygen, CO2, and temperature fromthe environment.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000524"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>feeling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000524"/>
