    <!-- http://purl.obolibrary.org/obo/ACTAN_0000539 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000539">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000922"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002272"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-21T12:08:19.983134Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>head to head</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Alignment that is alongside another, head-to-head.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">paralleling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>lateral display</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">paralleling alignment</rdfs:label>
        <skos:example>&quot;Courtship displays of R. decemdigitatus consisted of 11 steps: ... (vi) lateral displays, in which the male swims close to the female with erect dorsal and pectoral fins, shivering his body...&quot;</skos:example>
        <skos:scopeNote>&quot;Pair-bonded fish exhibit several affiliative behaviors. In cichlids, pair-bonded individuals display parallel swimming, tail beating, circling, greeting, and affiliative bites.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000539"/>
