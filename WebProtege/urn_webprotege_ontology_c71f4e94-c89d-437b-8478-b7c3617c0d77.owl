        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In larval zebrafish, head stimulation generally elicits C-starts, while tail stimulation evokes both C- and S-starts.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000518 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000518">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000288"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000154"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002448"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-12-31T21:30:47.895271Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Relativity that involves acceleration towards a second animal.

It may be a dominating movement.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">charging</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>rushing</oboInOwl:hasRelatedSynonym>
        <rdfs:label>charge relativity</rdfs:label>
        <skos:example>&quot;Hemichromis bimaculatus...
Sometimes the male... will rush on to the female... The male may even &quot;demonstratively&quot; swim away first, in order to perform such a charge.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000518"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Relativity that involves acceleration towards a second animal.

It may be a dominating movement.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
