    <!-- http://purl.obolibrary.org/obo/ACTAN_0000313 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000313">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000301"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000508"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002472"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-14T10:19:19.216433Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Search that consists of short bouts of low-velocity forward movement, with a high frequency of short reversals, in the presence of resource cues.

It may indicate satiety, but is not the same as quiescence.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">dwelling</oboInOwl:hasExactSynonym>
        <rdfs:label>dwelling search</rdfs:label>
        <skos:example>&quot;Caenorhabditis elegans...
While the dwelling state is promoted by many of the same mechanisms that promote behavioral quiescence, it is a distinct behavioral state: dwelling animals still move, feed, defecate, and lay eggs.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000313"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Search that consists of short bouts of low-velocity forward movement, with a high frequency of short reversals, in the presence of resource cues.

It may indicate satiety, but is not the same as quiescence.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1534/genetics.120.303539</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In contrast, the dwelling state consists of short bouts of low-velocity forward movement (,0.05 mm/s), with a high frequency of short reversals.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000313"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">dwelling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1534/genetics.120.303539</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000313"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>dwelling search</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000313"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Caenorhabditis elegans...
While the dwelling state is promoted by many of the same mechanisms that promote behavioral quiescence, it is a distinct behavioral state: dwelling animals still move, feed, defecate, and lay eggs.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1534/genetics.120.303539</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000314 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000411"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000662"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-19T20:40:26.070315Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Aggregation which is like schooling, but emerges from laterally restricted, semi-synchronised vertical forays into the water column above closely spaced, fixed retreat sites.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">vertical-foraging aggregation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">pseudo-school aggregation</rdfs:label>
        <skos:example>&quot;The wrasse Clepticus parrai, the serranid Paranthias furcifer and the pomacentrids Chrornus cyaneus and C. muhilineatus have less typical &quot;schools&quot; in the traditional sense, and are more aptly described as having &quot;vertical foraging aggregations&quot;. These species tend to retreat to sites on the reef when pursued.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000314"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Aggregation which is like schooling, but emerges from laterally restricted, semi-synchronised vertical forays into the water column above closely spaced, fixed retreat sites.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000314"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">vertical-foraging aggregation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1973</dc:date>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000314"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">pseudo-school aggregation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000314"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The wrasse Clepticus parrai, the serranid Paranthias furcifer and the pomacentrids Chrornus cyaneus and C. muhilineatus have less typical &quot;schools&quot; in the traditional sense, and are more aptly described as having &quot;vertical foraging aggregations&quot;. These species tend to retreat to sites on the reef when pursued.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000315 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000315">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000301"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000508"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000303"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-08T07:11:33.06691Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Search that up-regulates speed and omega turns, in the absence of resource cues.

This results in a specific exploration strategy, where animals exhaustively sample local environment by making frequent turns while still performing long-range navigation due to marked speed increase.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>pseudo-territorial</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">glocal search</rdfs:label>
        <skos:scopeNote>&quot;At several locations along its track, the wolf appeared to settle into spatially constrained behaviours we refer to as ‘pseudo-territorial’ modes before switching back to a ‘dispersive’ behaviour...

...we might propose a definition of ‘pseudo-territorial behaviour’ as those portions of the trajectory which remain within a 20 km radius for at least 2 weeks... This functional definition is satisfyingly simple and motivated partially by the biology of the animal. This result can be applied more or less indiscriminately to other dispersing wolves in the data base, and the properties of the areas which are selected for pseudo-territorial behaviour analysed with respect to the other available habitat in Finland, for example with respect to forest types and human land use.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Intensive exploration of environment in glocal search mode seems energetically costly and would be expected to come with some compensatory ecological benefits. We hypothesized that animals in glocal search state would more efficiently detect and reach food sources in their surroundings.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000315"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Search that up-regulates speed and omega turns, in the absence of resource cues.

This results in a specific exploration strategy, where animals exhaustively sample local environment by making frequent turns while still performing long-range navigation due to marked speed increase.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1038/s41467-023-38685-1</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Therefore, by markedly up-regulating speed and omega turn rates, starved worms at 25°C are in a state enabling both local and global search, which we will call glocal search.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000315"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pseudo-territorial</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2016</dc:date>
        <dc:source>doi:10.1111/1365-2656.12379</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000315"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">glocal search</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>doi:10.1038/s41467-023-38685-1</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000315"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;At several locations along its track, the wolf appeared to settle into spatially constrained behaviours we refer to as ‘pseudo-territorial’ modes before switching back to a ‘dispersive’ behaviour...

...we might propose a definition of ‘pseudo-territorial behaviour’ as those portions of the trajectory which remain within a 20 km radius for at least 2 weeks... This functional definition is satisfyingly simple and motivated partially by the biology of the animal. This result can be applied more or less indiscriminately to other dispersing wolves in the data base, and the properties of the areas which are selected for pseudo-territorial behaviour analysed with respect to the other available habitat in Finland, for example with respect to forest types and human land use.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/1365-2656.12379</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000315"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Intensive exploration of environment in glocal search mode seems energetically costly and would be expected to come with some compensatory ecological benefits. We hypothesized that animals in glocal search state would more efficiently detect and reach food sources in their surroundings.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1038/s41467-023-38685-1</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000316 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000316">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000301"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000508"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000381"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002471"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-14T10:25:50.924335Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Search that consists of long bouts of high-velocity forward movement, punctuated by infrequent reversals, in the presence of resource cues.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">roaming</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>appetitive olfactory behavior</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>scanning</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>saltatory searching</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">roaming search</rdfs:label>
        <skos:scopeNote>&quot;Detection of additional chemosensory cues also impacts these states: pheromones that signal a higher density of animals inhibit roaming...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;When animals detect an increase in the concentration of food odors, they prolong their roaming state to navigate to the food source. But when the concentration of food odors decreases, they transition to dwelling states.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000316"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Search that consists of long bouts of high-velocity forward movement, punctuated by infrequent reversals, in the presence of resource cues.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1534/genetics.120.303539</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The roaming state consists of long bouts of high-velocity forward movement (~0.1 mm/s), punctuated by infrequent reversals.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000316"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">roaming</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000316"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>appetitive olfactory behavior</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
        <skos:scopeNote>&quot;Increased rate of swimming and distance traveled with frequent directional changes (&gt;90 degree turns) that serve to sample appetitive odor plumes.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000316"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>scanning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>doi:10.1038/s41467-023-38685-1</dc:source>
        <skos:scopeNote>&quot;...warming promotes a specific behavioral state, where animals frequently swap between forward and backward motion to more actively scan their local environment while feeding, without dispersing much faster... scanning animals may better detect and respond to thermal gradients in order to thermotax while feeding.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000316"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>saltatory searching</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1093/icb/41.2.137</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000316"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">roaming search</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000316"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Detection of additional chemosensory cues also impacts these states: pheromones that signal a higher density of animals inhibit roaming...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1534/genetics.120.303539</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000316"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;When animals detect an increase in the concentration of food odors, they prolong their roaming state to navigate to the food source. But when the concentration of food odors decreases, they transition to dwelling states.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1534/genetics.120.303539</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000317 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000317">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000397"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001583"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-27T14:15:31.433792Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Routine pattern that contains modified behaviours which have evolved a secondary signalling function.

Signs of modification include higher than normal frequency, linkage with other displays, and exaggerated forms.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>performance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ritual</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>ceremony</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>demonstrative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>formalized</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>profile</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>rules</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>symbolical</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">ritual pattern</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000540"/>
        <skos:example>&quot;...in Lacerta agilis... The intraterritorial fighting has more the character of a serious fight, but still very much influenced by a number of &quot;playing-rules&quot;.&quot;</skos:example>
        <skos:scopeNote>&quot;...mating behaviour is extremely diverse in sepsids with each species having its own mating profile.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;There are many social rituals and displays which have nothing to do with social competition among rivals. Some, like the stereotyped movements preceding &quot;nest relief&quot; of one member of a breeding pair by another in birds, or exchanges of signals prior to copulation, function to regulate or coordinate cooperation between the sexes.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Routine pattern that contains modified behaviours which have evolved a secondary signalling function.

Signs of modification include higher than normal frequency, linkage with other displays, and exaggerated forms.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>performance</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">ritual</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000317"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
