        <oboInOwl:creation_date>2025-12-29T20:52:25.826763Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Curl which passes 360 degrees of curvature.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>coil</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>coiled</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>coiling</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">coil curl</rdfs:label>
        <skos:example>&quot;The Lepidoptera proboscis is coiled into 4-5 turns in the resting position...&quot;</skos:example>
        <skos:example>&quot;Zebrafish... Embryonic movement describing a full body contraction that brings the tip of the tail to the head (coils);&quot;</skos:example>
    </owl:Class>
