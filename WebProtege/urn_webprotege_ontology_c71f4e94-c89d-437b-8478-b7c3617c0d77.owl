    <!-- http://purl.obolibrary.org/obo/ACTAN_0000451 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000439"/>
        <rdfs:subClassOf rdf:nodeID="genid3455"/>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T12:14:46.960881Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym xml:lang="en">aposematic cue</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Warning that signals to an aggressor that there is a net cost for interference with the signaler.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">aposematic signal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>aposematic warning</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">aposematic display</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>aposematism</oboInOwl:hasRelatedSynonym>
        <rdfs:label>aposematism warning</rdfs:label>
        <skos:closeMatch>NBO:0020287</skos:closeMatch>
        <skos:scopeNote>&quot;In this way, the predator learns to associate the aposematic cue with a painful experience and will in the future avoid animals that exhibit that signal. Or, in the case of a lethal cost to the transgressor, a species may evolve an innate avoidance to the aposematic signal. To fit the criteria for function as an aposematic cue, a signal should be conspicuous, it.must be unambiguously associated with the communicator, and there must be a potential cost to the recipient of the signal.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid3455">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000463"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000451"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid3455"/>
        <dc:source>doi:10.1098/rspb.2015.2890</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000451"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget xml:lang="en">aposematic cue</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000451"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Warning that signals to an aggressor that there is a net cost for interference with the signaler.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;An aposematic signal is a form of communication, or advertisement, to a predator or other aggressor that there is a net cost for interference with the signaler.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000451"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">aposematic signal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000451"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>aposematic warning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2014</dc:date>
        <dc:source>doi:10.1016/j.cub.2014.08.051</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000451"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget xml:lang="en">aposematic display</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000451"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>aposematism</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2005</dc:date>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000451"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>aposematism warning</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000451"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In this way, the predator learns to associate the aposematic cue with a painful experience and will in the future avoid animals that exhibit that signal. Or, in the case of a lethal cost to the transgressor, a species may evolve an innate avoidance to the aposematic signal. To fit the criteria for function as an aposematic cue, a signal should be conspicuous, it.must be unambiguously associated with the communicator, and there must be a potential cost to the recipient of the signal.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000452 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000878"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000446"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T20:02:37.569683Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Assistance that signals the detection of food.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym xml:lang="en">food detection signaling</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">food-detection assistance</rdfs:label>
        <skos:broadMatch>NBO:0020088</skos:broadMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000452"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Assistance that signals the detection of food.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.3389/fetho.2022.1066186</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Unlike cues, signals have evolved for the particular communicative function they serve. As a few examples consider the anti-predatory alarm signals in vervet monkeys, Chlorocebus pygerythrus, mate attraction signals in stalk-eyed flies, Cyrtodiopsis dalmanni, and food detection signals in ravens, Corvus corax...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000452"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget xml:lang="en">food detection signaling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.3389/fetho.2022.1066186</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000452"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">food-detection assistance</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000453 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000453">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000464"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000414"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T20:22:46.529186Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Manipulation in which signaling causes sensory overload in another, hindering its subsequent behaviour.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>bewildering</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>confusion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">disorienting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">confusing</oboInOwl:hasRelatedSynonym>
        <rdfs:label>confusion manipulation</rdfs:label>
        <skos:example>&quot;...gobies on D. gemmacea could take advantage of its complex multiple-branching structure to confuse predators and avoid detection by switching from one branch to another.&quot;</skos:example>
        <skos:narrowMatch>NBO:0020079</skos:narrowMatch>
        <skos:scopeNote>&quot;Greene (1973) categorized defensive tail displays of snakes into three major functions: 1) to divert attack toward the tail, 2) to inhibit attack with an aposematic display, and 3) to disorient the predator with a flash display.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;II. What is deimatic behaviour?...
(7) Mechanisms by which predators respond to initial encounters with deimatic behaviour...
(e) Confusion effect&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The functional importance of synchrony in these ecological and biological systems varies from optimizing  reproduction, reducing energetic costs, confusing predators, and regulating a density profile.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000453"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Manipulation in which signaling causes sensory overload in another, hindering its subsequent behaviour.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1111/brv.12891</dc:source>
