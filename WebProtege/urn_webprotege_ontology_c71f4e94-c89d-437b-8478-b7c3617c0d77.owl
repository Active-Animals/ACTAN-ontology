    <!-- http://purl.obolibrary.org/obo/ACTAN_0000876 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000876">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000872"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-08T11:50:46.365281Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Claiming which involves part of a formerly common territory.

They may still act together sometimes against common enemies.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">dividing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">dividing claiming</rdfs:label>
        <skos:example>&quot;Cichlasoma bimaculatum...
...a female will only succeed in claiming a part of the former common territory if the combativeness of the male is inhibited...
...the male, in this phase, not only considers his mate as a competing neighbour, but also as his partner...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000876"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Claiming which involves part of a formerly common territory.

They may still act together sometimes against common enemies.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;...when the breeding season is over, the female woodpecker claims a part of the common territory for her own. In the mockingbirds (Mimus polyglottus) the MITCHENERS (1935) also observed that at the end of the breeding season and after the moult the male and female of a pair divide the formerly common territory. They may still act together sometimes against common enemies.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000876"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">dividing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000876"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">dividing claiming</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000876"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Cichlasoma bimaculatum...
...a female will only succeed in claiming a part of the former common territory if the combativeness of the male is inhibited...
...the male, in this phase, not only considers his mate as a competing neighbour, but also as his partner...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000877 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000877">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000389"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000464"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-08T16:11:40.461367Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Competition in which cooperation is deceiptfully used to self-advantage.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>&quot;assisting&quot;</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">&quot;helping&quot;</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>subversion</oboInOwl:hasExactSynonym>
        <rdfs:label>subversion competition</rdfs:label>
        <skos:scopeNote>&quot;Cichlid... fishes without territory also often try to take part in the actions of resident males when these are too much occupied to chase them. So they may &quot;help&quot; a territory owner in fighting an intruder or in fertilising the eggs of a female.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Hemichromis females...
A starts laying... B and C approach and eat the eggs. A chases B, and more particularly C. B also chases C and eats most of the eggs... Later on C begins to lay eggs... B approaches and then &quot;assists&quot; C, just as she formerly &quot;helped&quot; A.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000877"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Competition in which cooperation is deceiptfully used to self-advantage.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000877"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>&quot;assisting&quot;</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <rdfs:comment>The use of &quot;inverted commas&quot; in the source appears intended to delegitimate the natural meaning of this term.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000877"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">&quot;helping&quot;</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <rdfs:comment>The use of &quot;inverted commas&quot; in the source appears intended to delegitimate the natural meaning of this term.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000877"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>subversion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1016/j.anbehav.2019.12.009</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000877"/>
