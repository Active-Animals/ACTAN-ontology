    <!-- http://purl.obolibrary.org/obo/ACTAN_0000872 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000872">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000386"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-08T10:27:27.498162Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym xml:lang="en">establishing</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Territorialism that begins to drive others from a certain area.

At first this may be larger than necessary.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>claiming</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reserving</oboInOwl:hasExactSynonym>
        <rdfs:label>claiming territorialism</rdfs:label>
        <skos:example>&quot;Tilapia natalensis...
The pugnacious male first remains with the school, but soon he comes down, claims a territory, and begins to dig a pit.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000872"/>
