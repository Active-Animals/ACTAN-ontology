    <!-- http://purl.obolibrary.org/obo/ACTAN_0000744 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000744">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000595"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-06-11T13:21:28.861498Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement that changes a shape by increasing its volume.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>extrusion</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>inflation</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">expansion</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">expanding movement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000620"/>
        <skos:example>&quot;Specimens of Pelocoetes exul, like those of Stephensonactis ornata, expand mainly at night...&quot;</skos:example>
        <skos:scopeNote>&quot;Great inflation is quite common in nature after feeding. The phenomenal power of anemones to expand in this way is well known.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000744"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement that changes a shape by increasing its volume.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    <owl:Axiom>
