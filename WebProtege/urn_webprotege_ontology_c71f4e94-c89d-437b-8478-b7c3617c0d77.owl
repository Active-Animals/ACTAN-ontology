    <!-- http://purl.obolibrary.org/obo/PATO_0001528 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001528">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001519"/>
        <oboInOwl:hasDefinition>Definition: A sound amplitude which is relatively high.</oboInOwl:hasDefinition>
        <rdfs:label>loud</rdfs:label>
    </owl:Class>
    


