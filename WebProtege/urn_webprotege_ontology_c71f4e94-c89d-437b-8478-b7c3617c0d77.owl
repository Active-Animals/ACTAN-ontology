    <!-- http://purl.obolibrary.org/obo/ACTAN_0000146 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000146">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000091"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000756"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000763"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-22T20:34:05.500204Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Suspension when a quadruped&apos;s feet are extended, forward and backward.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">extended suspension</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">extending suspension</rdfs:label>
        <skos:scopeNote>&quot;...the faster cursors among such animals tend to incorporate the suspensions into a gallop (deer, sheep) whereas the smaller and most agile mammals tend to incorporate the suspension into the bound or half bound (rodents, many mustelids, and felids). The
suspension is commonly 50% of the cycle, and may range up to 80% (pronking deer, Patagonian cavy, jumping mouse).&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000146"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Suspension when a quadruped&apos;s feet are extended, forward and backward.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/20.1.255</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Plots in the lower quadrant represent gaits having one suspension in each cycle, and it occurs when the feet are extended, forward and backward, and the back is dorsoflexed.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000146"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">extended suspension</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1980</dc:date>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000146"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">extending suspension</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000146"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...the faster cursors among such animals tend to incorporate the suspensions into a gallop (deer, sheep) whereas the smaller and most agile mammals tend to incorporate the suspension into the bound or half bound (rodents, many mustelids, and felids). The
suspension is commonly 50% of the cycle, and may range up to 80% (pronking deer, Patagonian cavy, jumping mouse).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000147 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000078"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-22T20:39:30.674958Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>dynamic</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Activity that is about energetic and force patterns.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">kinetics</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>energetics</oboInOwl:hasNarrowSynonym>
        <rdfs:label>kinetics activity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>dynamic</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>https://core.ac.uk/download/pdf/85255156.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Activity that is about energetic and force patterns.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/icac125</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Kinematic (the study of themovement of body parts) and kinetic (the study of energetic and force patterns) analysis techniques are often used to identify functional differences in “gaits,” defined as particular cyclical pattern of movement characteristic of a limited range of speeds in which momentum is conserved across repeated cycles, described by quantities of which one or more change discontinuously at transitions to other gaits.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">kinetics</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>energetics</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1987</dc:date>
        <dc:source>doi:10.1242/jeb.130.1.155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>kinetics activity</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000148 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001035"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-22T20:46:18.611216Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics which acts to minimise a rotation.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>stability</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stabilization</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>steadying</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>destabilizing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>instability</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">stabilising</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>stabilizing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>stable</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>unstable</oboInOwl:hasRelatedSynonym>
        <rdfs:label>stabilizing kinetics</rdfs:label>
        <skos:example>&quot;Among prehensile-tailed New World monkeys many positional modes are stabilized by tail grips.&quot;</skos:example>
        <skos:example>&quot;We conclude that the slow gaits of most tetrapods, including all tippy ones like turtles, should fall in the upper left quadrant of the gait graph. Any exceptions may be expected to be animals for which stability is assured by large feet or a wide stance. This expectation is realized: Animals known to walk in diagonal sequence are primates and the giant armadillo, aardvark, and kinkajou.&quot;</skos:example>
        <skos:scopeNote>&quot;...stable designs not only resist externally imposed changes in an organism’s trajectory, but they also resist changes imposed by the animal itself. In contrast, mechanically unstable bodies that can easily be blown off course are also very responsive to voluntary steering maneuvers.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Destabilizing recoil forces generated by the yaw and sideslip inherent in undulatory body and caudal-fin (BCF) modes of rectilinear fish swimming are thought to produce significantly more drag than is expected in fishes swimming with rigid bodies.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Muscles in crabs and small mammals may function more to stabilize joints and operate as springs.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The stability of fishes in the first place depends on the relative positions of the centres of gravity and of buoyancy (centre of volume). If the former is situated above the latter the equilibrium is unstable; if the centre of gravity, however, lies below the centre of buoyancy or coincides with it, the equilibrium is stable.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000148"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000148"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics which acts to minimise a rotation.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
    </owl:Axiom>
    <owl:Axiom>
