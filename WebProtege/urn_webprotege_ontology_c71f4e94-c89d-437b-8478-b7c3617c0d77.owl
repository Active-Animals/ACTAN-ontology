    <!-- http://purl.obolibrary.org/obo/ACTAN_0000175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000078"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-23T20:46:55.391174Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Activity that links the kinematics and kinetics of the whole body.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">positional mode</oboInOwl:hasExactSynonym>
        <rdfs:label>positioning activity</rdfs:label>
        <skos:scopeNote>&quot;We recommend a nomenclature that is not dedicated to or derived from any one taxonomic subset of the primates. Here we define 32 primate positional modes, divided more finely into 52 postural sub-modes and 74 locomotor sub-modes.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000175"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Activity that links the kinematics and kinetics of the whole body.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1242/jeb.158.1.369</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;More importantly, we attempt to link the kinematics and kinetics of single legs to the whole body movement of a running hexaped.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000175"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">positional mode</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000175"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>positioning activity</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000175"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;We recommend a nomenclature that is not dedicated to or derived from any one taxonomic subset of the primates. Here we define 32 primate positional modes, divided more finely into 52 postural sub-modes and 74 locomotor sub-modes.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    


