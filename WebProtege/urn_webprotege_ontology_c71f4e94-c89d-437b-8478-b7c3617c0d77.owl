        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-06T07:57:53.12252Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Counter-irritant routine which involves a shoulder rub.

This is commonly used against the head.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>shoulder-rubbing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">eye-cleaning</oboInOwl:hasRelatedSynonym>
        <rdfs:label>shoulder-rub routine</rdfs:label>
        <skos:scopeNote>&quot;Shoulder-rubbing... in... Anatidae... is very likely a technique for cleaning the eye.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000785"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Counter-irritant routine which involves a shoulder rub.

This is commonly used against the head.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853965x00138</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Occasionally, when a duck appears to have an irritation about the head, it will rub its cheek on the shoulder.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000785"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>shoulder-rubbing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
