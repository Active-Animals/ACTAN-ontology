        <owl:annotatedTarget>&quot;Typically, male frogs clasp females dorsally and position themselves so as to bring their cloacae in close proximity before coordinated gamete release, a mating posture known as “amplexus”.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1371/journal.pone.0083116</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000853 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000853">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000715"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-30T08:56:37.811207Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Expulsion that involves sperm from male genitalia.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">ejaculating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ejaculation</oboInOwl:hasExactSynonym>
        <rdfs:label>ejaculation expulsion</rdfs:label>
        <skos:example>&quot;...the genus Pan, namely chimpanzees and bonobos...

Ejection of seminal fluid from penis. Males begin to ejaculate at 9 years old at Mahale. Semen is often eaten by both sexes.&quot;</skos:example>
        <skos:example>&quot;Thus they invest heavily in sperm production and ejaculate large volumes to increase their chances of insemination. This pattern has been found in Salmo salar...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000853"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
