        <owl:annotatedTarget xml:lang="en">zigzag</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000549"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Swimming-regime that involves multiple darts, during which the direction of movement changes between the darts.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Stress-induced: erratic movement with multiple darts, during which the direction of movement changes in a seemingly alternating (zigzag-like) manner between the darts.&quot;</skos:scopeNote>
    </owl:Axiom>
