        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000986"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mate-search aggregation which involves spawning.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;During periods of reproductive activity, large numbers of T.cupido gather in groups of varying sizes at the spawning site.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000986"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>aggregate spawning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000986"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>group spawning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1987</dc:date>
        <dc:source>doi:10.11369/jji1950.34.76</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000986"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>spawning aggregate</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000986"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">spawning aggregation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000986"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">spawn aggregation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000986"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...at the Whyalla spawning grounds, South Australia (32°59′5 S; 137°43′1 E) between the months of May and July... giant Australian cuttlefish aggregate by the thousands to spawn on the hard substrate.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s00265-014-1841-5</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000986"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;During periods of reproductive activity, large numbers of T.cupido gather in groups of varying sizes at the spawning site. It is estimated that the largest of these groups comprise as many as 150 individuals. Collections from among spawning aggregates revealed a heavy preponderance of males.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000986"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Spawning aggregates are not always well defined, isolated entities; aggregates may merge with neighboring groups or may break into yet smaller units.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000987 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000987">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000104"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001961"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-17T19:57:57.315702Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Rub which only just makes contact.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>brushing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">brush rub</rdfs:label>
        <skos:example>&quot;...European Jays... ants... swarmed up their legs and into their plumage... the posterior edges of the opened wings just brushing the ground.&quot;</skos:example>
        <skos:example>&quot;Chimpanzee...
...its back almost brushes the ground...&quot;</skos:example>
        <skos:example>&quot;Thalassoma cupido...
...often brush against the bodies of others swimming below or nearby.&quot;</skos:example>
    </owl:Class>
