        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000454"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Costs of architecture can be divided into three main types: construction costs (the original costs of building the structure); maintenance costs (the costs of keeping the structure intact as well as repairing it in the event of damage); and defense costs (the costs of repelling intruders, including conspecifics who may attempt to take possession of the structure without having paid any of the original construction costs).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.cub.2021.09.082</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000455 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000553"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T20:23:32.32715Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Influence that prevents another from probable activity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">constraint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>deterrent</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>inhibition</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>interference</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>retarding</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>preventing</oboInOwl:hasRelatedSynonym>
        <rdfs:label>constraint influence</rdfs:label>
        <skos:example>&quot;Cichlasoma bimaculatum...
...the fact that the mates often know each other personally... is responsible for the inhibition of the hostility in the male.&quot;</skos:example>
        <skos:example>&quot;In the case of. animals which rely largely on olfaction to locate prey, the dirt and stink of a heronry must be an effective deterrent.&quot;</skos:example>
        <skos:scopeNote>&quot;Prey can reduce the risk of predation by moving to habitats where predators are less likely to detect them, less likely to attack, or less likely to succeed. The interaction of such responses to risk with other ecological processes remains relatively unstudied, but in some cases, changes in habitat use to avoid predation may be constrained by competition: larger, dominant competitors should respond freely to predation risk, but the responses of smaller, subordinate competitors may be constrained by the responses of dominant competitors.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000455"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Influence that prevents another from probable activity.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000455"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
