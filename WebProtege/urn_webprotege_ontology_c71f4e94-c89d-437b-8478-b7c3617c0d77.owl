        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000325"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...performing prey retrieval in the army ants Eciton burchelli and Dorylus wilverthi.... there are just two subtasks: front-running, involving a single ant at the front, and following, involving one or more ants bringing up the rear.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/beheco/12.5.534</dc:source>
    </owl:Axiom>
