    <!-- http://purl.obolibrary.org/obo/ACTAN_0000905 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000905">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000396"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001839"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-21T14:41:13.338287Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flushing which increases through flow.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">refresh</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>stirring</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">refresh flushing</rdfs:label>
        <skos:example>&quot;Aequidens latifrons...
By the body movements of the larva, the water in the pit is constantly refreshed.&quot;</skos:example>
        <skos:example>&quot;After mating, T. albomaculosus females left the nest site, whereas males stayed there to care for the eggs. Males flapped their  fins, and they often sucked the sand into their mouths and spat it out on the bottom of the nest. Thus, males cared for the eggs by stirring the sand and accompanying attached eggs.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000905"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flushing which increases through flow.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000905"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">refresh</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000905"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>stirring</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2014</dc:date>
        <dc:source>doi:10.5343/bms.2014.1055</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000905"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">refresh flushing</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000905"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Aequidens latifrons...
By the body movements of the larva, the water in the pit is constantly refreshed.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000905"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;After mating, T. albomaculosus females left the nest site, whereas males stayed there to care for the eggs. Males flapped their  fins, and they often sucked the sand into their mouths and spat it out on the bottom of the nest. Thus, males cared for the eggs by stirring the sand and accompanying attached eggs.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5343/bms.2014.1055</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000906 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000906">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000601"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000139"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-22T09:36:30.137871Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Hydrodynamics in which an undulating body movement stimulates another fish&apos;s lateral line by the pressure waves generated.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">jolting</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">jolting hydrodynamics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000909"/>
        <skos:example>&quot;Calling the young; jolting...
This action is often carried out by Cichlosoma bimaculatum if alarmed when leading its young. The same movement is carried out by Tilapia natalensis males when they have succeeded in bringing a partner to their pit.... Once we saw this movement performed by a female when in the pit.&quot;</skos:example>
        <skos:example>&quot;The diversity of functions the same movement can get in this way is remarkable. in a great number of Cichlids it serves to lead and especially to alarm the young... In Tilapia it serves as a courting activity, probably to stimulate laying. In Pterophyllum we sometimes observed it during frontal fighting and we got the impression that it then served as a threatening activity.&quot;</skos:example>
        <skos:example>&quot;Zebrafish...
This behavior is common in fish species, and is likely related to the use of lateral line by fish to size-up the opponent by the waves generated by its movement. Although less visible in zebrafish (compared to other fishes), their undulating body movement can be observed using high resolution videos (sometimes this behavior is followed by forceful tail beats).&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000906"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Hydrodynamics in which an undulating body movement stimulates another fish&apos;s lateral line by the pressure waves generated.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000906"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">jolting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000906"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">jolting hydrodynamics</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000906"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Calling the young; jolting...
This action is often carried out by Cichlosoma bimaculatum if alarmed when leading its young. The same movement is carried out by Tilapia natalensis males when they have succeeded in bringing a partner to their pit.... Once we saw this movement performed by a female when in the pit.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000906"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The diversity of functions the same movement can get in this way is remarkable. in a great number of Cichlids it serves to lead and especially to alarm the young... In Tilapia it serves as a courting activity, probably to stimulate laying. In Pterophyllum we sometimes observed it during frontal fighting and we got the impression that it then served as a threatening activity.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000906"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Zebrafish...
This behavior is common in fish species, and is likely related to the use of lateral line by fish to size-up the opponent by the waves generated by its movement. Although less visible in zebrafish (compared to other fishes), their undulating body movement can be observed using high resolution videos (sometimes this behavior is followed by forceful tail beats).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000907 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000907">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000455"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCIT_C61299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-22T13:56:37.492675Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Constraint that takes control.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>capturing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">catching</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>restraining</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>controlling</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>taking</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">catch constraint</rdfs:label>
        <skos:example>&quot;Amplexus can prevent other males from controlling the female (Euproctus, Notophthalmus)...&quot;</skos:example>
        <skos:example>&quot;The Tilapia young are already completely developed some days before they leave the mouth of the female... Now and then a young escapes, but immediately the female tries to catch it... This all suggests that the young are trying to get free, but that the female is not yet willing to let them go.&quot;&quot;</skos:example>
        <skos:example>&quot;The leading jaeger forced the sandpiper up, and after a quick series of alternate stoops by both jaegers, 1 caught the sandpiper in its bill, just above the grass. The jaeger carried the flapping sandpiper about 20 m, landed on the tundra and then placed the prey under its feet.&quot;</skos:example>
        <skos:scopeNote>&quot;...forced copulation, where a male uses superior speed or strength to catch and physically restrain a female while he copulates with her by force;&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000907"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Constraint that takes control.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000907"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>capturing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
