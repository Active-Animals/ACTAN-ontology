    <!-- http://purl.obolibrary.org/obo/ACTAN_0000303 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000577"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000381"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-08T07:08:35.734484Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Basing that involves a partially enclosed cavity.

It may have a restricted entrance passage.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">denning</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">hibernaculum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nest denning</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">denning basing</rdfs:label>
        <skos:example>&quot;Brown bears have been reported showing a noticeable plasticity when hibernating, adapting their denning behavior to environmental factors, availability of food during hyperphagia or changing snow conditions during the winter.&quot;</skos:example>
        <skos:example>&quot;In cold regions, snakes often aggregate at denning sites for overwintering, and neonate rattlesnakes appear capable of following the scent trails of adults to locate dens. Arizona black rattlesnakes (Crotalus cerberus) form social networks when aggregating at these communal denning sites, and the existence of social networks in other snakes highlights their potential importance...

Proclivities toward communal overwintering at denning sites appear to be greater in C. helleri populations at higher elevations, presumably resulting in higher levels of conspecific behavioral interactions during fall ingress and spring egress compared to populations at lower elevations that more often overwinter alone.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000303"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Basing that involves a partially enclosed cavity.

It may have a restricted entrance passage.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1002/ece3.6372</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000303"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">denning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1002/ece3.6372</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000303"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">hibernaculum</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>doi:10.3389/fetho.2023.1181774</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000303"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>nest denning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1002/ece3.6372</dc:source>
        <skos:scopeNote>&quot;...nest dens (a nest of needles and branches or other materials deposited on the ground)...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000303"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">denning basing</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000303"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Brown bears have been reported showing a noticeable plasticity when hibernating, adapting their denning behavior to environmental factors, availability of food during hyperphagia or changing snow conditions during the winter.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1002/ece3.6372</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000303"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In cold regions, snakes often aggregate at denning sites for overwintering, and neonate rattlesnakes appear capable of following the scent trails of adults to locate dens. Arizona black rattlesnakes (Crotalus cerberus) form social networks when aggregating at these communal denning sites, and the existence of social networks in other snakes highlights their potential importance...

Proclivities toward communal overwintering at denning sites appear to be greater in C. helleri populations at higher elevations, presumably resulting in higher levels of conspecific behavioral interactions during fall ingress and spring egress compared to populations at lower elevations that more often overwinter alone.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2023.1181774</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000304 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000301"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000508"/>
            </owl:Restriction>
        </rdfs:subClassOf>
