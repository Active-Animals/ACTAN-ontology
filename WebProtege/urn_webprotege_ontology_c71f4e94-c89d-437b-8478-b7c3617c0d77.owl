    <!-- http://purl.obolibrary.org/obo/ACTAN_0000323 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000750"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000916"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-26T16:07:26.926732Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Zipping in which the subject stands side-on to their potential mate, and displays by bending forward assuming the posture of nibbling the belly feathers.

Sometimes the belly feathers are nibbled vigorously or the bill may not touch the body at all merely swinging briefly across above the feet.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">belly-preening</oboInOwl:hasExactSynonym>
        <rdfs:label>belly-zipping ethotype</rdfs:label>
        <skos:example>&quot;...during the period of pair-formation, male Shovelers frequently come out on shore, orientate their body laterally to the female (who may be either standing or swimming close by), and then perform a Shake followed by a Belly-preen.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000323"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Zipping in which the subject stands side-on to their potential mate, and displays by bending forward assuming the posture of nibbling the belly feathers.

Sometimes the belly feathers are nibbled vigorously or the bill may not touch the body at all merely swinging briefly across above the feet.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000323"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">belly-preening</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000323"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>belly-zipping ethotype</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000323"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...during the period of pair-formation, male Shovelers frequently come out on shore, orientate their body laterally to the female (who may be either standing or swimming close by), and then perform a Shake followed by a Belly-preen.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000324 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002495"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-26T16:50:13.331597Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement that involves an extremity and is exaggerated and upward.

This is usually the head.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">tossing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>head-throw</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>head-tossing</oboInOwl:hasNarrowSynonym>
        <rdfs:label>tossing movement</rdfs:label>
        <skos:example>&quot;Common Shelduck... The display-shake consists of a body-shake with a very exaggerated upward tossing of the head at the end of the movement...&quot;</skos:example>
        <skos:example>&quot;Nocomis leptocephalus...
As the female moved forward over the upstream rim of the pit, she gaped and abruptly tossed her head vertically into the water column.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000324"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement that involves an extremity and is exaggerated and upward.

This is usually the head.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000324"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">tossing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000324"/>
