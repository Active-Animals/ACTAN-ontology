        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000780"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...elephants can blow air to push objects that are just beyond reach and modulate the air jet on a wall to draw objects closer to themselves.&quot;</owl:annotatedTarget>
        <dc:source>https://bioengineering.hyperbook.mcgill.ca/functional-mechanics-of-the-elephant-and-butterfly-proboscis/</dc:source>
