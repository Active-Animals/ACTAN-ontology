    <!-- http://purl.obolibrary.org/obo/ACTAN_0000446 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000414"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T20:02:19.482711Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Signal in which a communicative interaction iteratively influences a relationship.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">information flow mediation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>performance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>performing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">performance signal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000446"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Signal in which a communicative interaction iteratively influences a relationship.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:isDefinedBy>doi:10.3389/fetho.2022.1066186</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;For some the ‘communication as information’ vs ‘communication as manipulation’ debate is largely one of semantics, for others communication involves both information and manipulation, and for others the debate raises some fundamental ideas about how communicative interactions actually influence behavior and shape interactions and relationships among individuals.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000446"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">information flow mediation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2008</dc:date>
        <dc:source>doi:10.1016/j.anbehav.2007.09.028</dc:source>
        <skos:scopeNote>&quot;...behaviours that mediate the flow of information...&quot;</skos:scopeNote>
    </owl:Axiom>
