        <oboInOwl:creation_date>2025-09-03T10:25:13.00923Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Zipping in which the bill touches the bird&apos;s back, behind the slightly raised wing.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">preen-back-behind-wing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>display-preening</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mock-preening</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>preen-behind-wing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>wing-preen</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">back-behind-wing-zipping ethotype</rdfs:label>
        <skos:example>&quot;...given by male Goldeneyes and the Hooded Merganser before copulation.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000813"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Zipping in which the bill touches the bird&apos;s back, behind the slightly raised wing.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853965x00138</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In (2) the wing is not lifted at all, the bill touching the bird&apos;s back. In (3) the head posture is similar to that in (2) and the bill moves behind the slightly raised wing.&quot;</skos:scopeNote>
    </owl:Axiom>
