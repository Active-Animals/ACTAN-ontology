        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000157"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Badis badis...
While swimming rapidly forward, the... pelvic fins, are usually folded against the body.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000268"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000151"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-12T14:25:19.494529Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Subcarangiform gait which is augmented by pectoral fin strokes.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>augmented BCF</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>augmented body-caudal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>chaetodontiform mode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>chaetodontiform swimming</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">chaetodontiform gait</rdfs:label>
        <skos:example>&quot;This pectoral-caudal mode was used widely within the chaetodontoids (with the exception of Pomacanthus and Hemitaurichthys, personal observation), and may therefore be referred to as Chaetodontiform swimming...&quot;</skos:example>
        <skos:scopeNote>&quot;...chaetodontiform taxa using augmented BCF propulsion attained close (77.5 cm s–1) to the maximum experimental speeds displayed by labriform taxa (82.4 cm s–1).&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000158"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Subcarangiform gait which is augmented by pectoral fin strokes.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/s00338-007-0195-0</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;A third intermediate mode involved subcarangiform swimming augmented by pectoral fin strokes (simultaneous pectoral-caudal).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000158"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>augmented BCF</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2007</dc:date>
        <dc:source>doi:10.1007/s00338-007-0195-0</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000158"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>augmented body-caudal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2007</dc:date>
        <dc:source>doi:10.1007/s00338-007-0195-0</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000158"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>chaetodontiform mode</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2007</dc:date>
        <dc:source>doi:10.1007/s00338-007-0195-0</dc:source>
        <skos:scopeNote>&quot;...chaetodontiform and subcarangiform modes...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000158"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>chaetodontiform swimming</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2007</dc:date>
        <dc:source>doi:10.1007/s00338-007-0195-0</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000158"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">chaetodontiform gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000158"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;This pectoral-caudal mode was used widely within the chaetodontoids (with the exception of Pomacanthus and Hemitaurichthys, personal observation), and may therefore be referred to as Chaetodontiform swimming...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s00338-007-0195-0</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000158"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...chaetodontiform taxa using augmented BCF propulsion attained close (77.5 cm s–1) to the maximum experimental speeds displayed by labriform taxa (82.4 cm s–1).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s00338-007-0195-0</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000159 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000715"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFA_0005389"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-12T18:30:30.093355Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>squirting</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Expulsion in which a current of water is exhaled through a gill orifice.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>gill ejecting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gill exhaling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>respiratory jet</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">gill expulsion</rdfs:label>
        <skos:example>&quot;very cold water when Chaenobryttus is in a state of semi-hibernation they may sometimes be observed with no fin movement at all and with both sets of paired fins securely pressed against the sides. At such times the respiration is extremely superficial and appears to have little reactive effect. However, after a long period of time it was observed that they do move forward ever so slightly and that very occasionally the pectorals are brought into play to regain the previous position.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000159"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>squirting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000159"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Expulsion in which a current of water is exhaled through a gill orifice.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.5962/p.203769</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;That the force of the water exhaled from the gill orifices of fishes has a reactance which of necessity must be of some aid in sending them forward there can be no doubt.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000159"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>gill ejecting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...ejecting water through the gill orifices...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000159"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>gill exhaling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...exhaled from the gill orifices...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000159"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>respiratory jet</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000159"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">gill expulsion</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000159"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;very cold water when Chaenobryttus is in a state of semi-hibernation they may sometimes be observed with no fin movement at all and with both sets of paired fins securely pressed against the sides. At such times the respiration is extremely superficial and appears to have little reactive effect. However, after a long period of time it was observed that they do move forward ever so slightly and that very occasionally the pectorals are brought into play to regain the previous position.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000087"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000030"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000743"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000164"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000672"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-12T19:23:41.314986Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Swimming-gait that generates a movement reaction to the momentum transferred by a moving plug of water squeezed out through a nozzle.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>jet mode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>blowing along</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">jetting gait</rdfs:label>
        <skos:example>&quot;Mechanisms of producing jets during swimming in Nautilus: (1) by the contraction of the large head retractor muscle; (2) through the rhythmic contraction of the funnel wings.&quot;</skos:example>
        <skos:example>&quot;Scallop swimming provides a simple example of a muscle generating positive work to act as a motor. The cycle begins... when the gape of the shell is maximal. Activation of the muscle... causes a rise in force and subsequent shortening producing the pressure to drive a jet of water that propels the animal.&quot;</skos:example>
        <skos:example>&quot;The semelparous giant Australian cuttlefish, Sepia apama, form short-term mating pairs during the breeding season... Females usually convey receptivity through arm and body postures and convey non-receptivity through direct rejection (e.g., squirming, inking, or jetting)...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000160"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Swimming-gait that generates a movement reaction to the momentum transferred by a moving plug of water squeezed out through a nozzle.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.027771</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000160"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>jet mode</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1242/jeb.027771</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000160"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>blowing along</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <rdfs:comment>&quot;...“blowing” themselves along...&quot;</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000160"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">jetting gait</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2019</dc:date>
        <dc:source>doi:10.1242/jeb.198226</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000160"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Mechanisms of producing jets during swimming in Nautilus: (1) by the contraction of the large head retractor muscle; (2) through the rhythmic contraction of the funnel wings.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1098/rsos.170467</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000160"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Scallop swimming provides a simple example of a muscle generating positive work to act as a motor. The cycle begins... when the gape of the shell is maximal. Activation of the muscle... causes a rise in force and subsequent shortening producing the pressure to drive a jet of water that propels the animal.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000160"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The semelparous giant Australian cuttlefish, Sepia apama, form short-term mating pairs during the breeding season... Females usually convey receptivity through arm and body postures and convey non-receptivity through direct rejection (e.g., squirming, inking, or jetting)...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s00265-014-1841-5</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000161 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000160"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000499"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-13T16:16:33.422308Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>pulsed jetting</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Jetting in which jet cycle period (contraction and refilling phase) decreases with increased speed.

The ejected fluid rolls up into an isolated vortex ring.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>jet mode 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">jet mode I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>short jet pulse</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>starting jet</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>subcritical jetting</oboInOwl:hasRelatedSynonym>
        <rdfs:label>short-pulsed jetting</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000159"/>
        <skos:example>&quot;...brief squid Lolliguncula brevis...
The ratio of jet length based on the vorticity extent (Lω) to jet diameter based on peak vorticity locations (Dω) was &lt;3.0 for jet mode I...&quot;</skos:example>
        <skos:example>&quot;In Nautilus the transition from jet mode 1 to jet mode 2 jets occurred at jet length to diameter ratio (Lj/Dj) of approximately 3 (jet mode 1 Lj/Dj &lt;2.16; jet mode 2 Lj/Dj &gt;3.16), similar to those observed in other jet propulsion swimmers (e.g. squid).&quot;</skos:example>
        <skos:scopeNote>&quot;With the lack of a consistent dependence of jet mode on speed, jet mode I and II do not fall within the purview of classical ‘gaits’ as defined by Alexander. Given the dual mode propulsive system of squids, both the jet and the fins need to be considered for proper identification of gaits (and probably a wider speed range).&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000161"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>pulsed jetting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1242/jeb.027771</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000161"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Jetting in which jet cycle period (contraction and refilling phase) decreases with increased speed.

The ejected fluid rolls up into an isolated vortex ring.</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.027771</dc:source>
        <skos:scopeNote>&quot;Moreover, jet cycle period (contraction and refilling phase) decreased with increased speed for jet mode I (linear regression: d.f.=1, 28, F=36.365, P&lt;0.001, R2=0.547) but jet cycle period increased with increased speed for jet mode II (linear regression: d.f.=1, 27, F=8.562, P=0.007, R2=0.241).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000161"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>jet mode 1</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2018</dc:date>
        <dc:source>doi:10.1098/rsos.170467</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000161"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">jet mode I</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1242/jeb.027771</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000161"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
