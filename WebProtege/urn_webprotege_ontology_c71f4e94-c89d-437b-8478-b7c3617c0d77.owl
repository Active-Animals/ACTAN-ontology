    <!-- http://purl.obolibrary.org/obo/ACTAN_0000754 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000754">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000176"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000184"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-08T14:48:53.351512Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Locomotion that uses a support.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">traversing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">traversing locomotion</rdfs:label>
        <skos:example>&quot;Gobies are generally found underwater perched on sand, mud, rocks, or peeking from shelter, such as crevices in rocks or holes in sand or mud. In some cases, their association with substrate is extreme, such as that seen in the waterfall climbing gobies and mudskippers traversing air-exposed mud flats.&quot;</skos:example>
        <skos:relatedMatch>NBO:0000359</skos:relatedMatch>
        <skos:scopeNote>&quot;...the running walk, rack, broken pace, and broken trot maintain ground contact at all times, with one to three, or even all four, hooves, despite being intermediate speed gaits. This makes them quite comfortable for the rider and useful in maintaining balance when traversing uneven terrain.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000754"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Locomotion that uses a support.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1023/A:1005565304671</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000754"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">traversing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1023/A:1005565304671</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000754"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">traversing locomotion</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000754"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Gobies are generally found underwater perched on sand, mud, rocks, or peeking from shelter, such as crevices in rocks or holes in sand or mud. In some cases, their association with substrate is extreme, such as that seen in the waterfall climbing gobies and mudskippers traversing air-exposed mud flats.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icac061</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000754"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...the running walk, rack, broken pace, and broken trot maintain ground contact at all times, with one to three, or even all four, hooves, despite being intermediate speed gaits. This makes them quite comfortable for the rider and useful in maintaining balance when traversing uneven terrain.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3390/ani13162557</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000755 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000755">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000089"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000628"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000530"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000893"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-09T16:44:07.459309Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Traversing-regime in which appendages grasp briefly and in rapid succession to brake descent.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">cascade</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">cascade regime</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000755"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Traversing-regime in which appendages grasp briefly and in rapid succession to brake descent.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/BF02381373</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Head-first descent: (1) Symmetrical head-first descent: similar to quadrupedal walking, except the limbs served a braking function on these steep descents (&gt; 45 degrees) some skidding may occur; (2) head-first scramble descent: as with symmetrical head-first descent, except on multiple supports with odd orientation and sizes, and a less symmetrical gait; and (3) cascade: as with head-first scramble descent, except supports are still smaller, and radically angled. Limbs and tail grasp briefly and in rapid succession to brake descent.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000755"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">cascade</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1996</dc:date>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000755"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">cascade regime</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000756 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000756">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000794"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002103"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-29T09:16:55.426343Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Extending that involves a hindlimb.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>backward leg extending</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>back foot extending</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>hindlimb extension</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>leg extending</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">hindlimb extending</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000756"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Extending that involves a hindlimb.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1002/ajpa.1330870108</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Instead, retraction of the humerus and extension of the hindlimbs provided most of the propulsive power.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000756"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>backward leg extending</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.2307/1379571</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000756"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>back foot extending</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
        <skos:scopeNote>&quot;...extension of the back foot...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000756"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>hindlimb extension</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1992</dc:date>
        <dc:source>doi:10.1002/ajpa.1330870108</dc:source>
        <skos:scopeNote>&quot;...extension of the hindlimbs...&quot;</skos:scopeNote>
    </owl:Axiom>
