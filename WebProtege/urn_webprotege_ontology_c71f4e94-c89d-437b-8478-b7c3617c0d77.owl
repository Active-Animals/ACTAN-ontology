    <!-- http://purl.obolibrary.org/obo/ACTAN_0000132 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000124"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-22T10:20:19.355027Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Stepping gait that is characterized by a duty factor &lt; 0.5, and no overlapping support periods between alternating support limbs.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">running</oboInOwl:hasExactSynonym>
        <rdfs:label>run gait</rdfs:label>
        <skos:closeMatch>NBO:0000055</skos:closeMatch>
        <skos:example>&quot;Although there are many exceptions, walking and running are characteristic of ground foraging birds. Some species, such as the Song Sparrow (Melospiza melodia), employ both, depending on the environmental conditions.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000132"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Stepping gait that is characterized by a duty factor &lt; 0.5, and no overlapping support periods between alternating support limbs.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.13130/biancardi-carlo-massimo_phd2012-01-31</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Running gaits are characterized by a duty factor &lt; 0.5, that means no overlapping support periods between alternating support limbs.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000132"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">running</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000132"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>run gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000132"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Although there are many exceptions, walking and running are characteristic of ground foraging birds. Some species, such as the Song Sparrow (Melospiza melodia), employ both, depending on the environmental conditions.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.2307/4083155</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000133 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000601"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000716"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-05-31T19:19:52.160409Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Hydrodynamics in which a strong stream of water is pushed perpendicular to the fish, towards the receiver.

There is no propulsive force. To remain stationary, it then gives a counter-beat; if swimming, it will move in a zigzag course.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>tail beat</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">tail-beat hydrodynamics</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000133"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Hydrodynamics in which a strong stream of water is pushed perpendicular to the fish, towards the receiver.

There is no propulsive force. To remain stationary, it then gives a counter-beat; if swimming, it will move in a zigzag course.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000133"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>tail beat</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000133"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">tail-beat hydrodynamics</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000134 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000124"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-22T10:27:56.227208Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Stepping gait that involves an appendage out of phase with the opposing limb in the same girdle, there is always at least one limb acting as ground-support (no suspension phase), the average duty factor of the limbs is always &gt;0.5, and walking animals must elevate the center of mass (COM) from the ground, rather than incorporating prolonged contact between the animal’s belly and the substrate (thereby maintaining forward momentum during both stance and swing phases).</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>walk</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">walking</oboInOwl:hasExactSynonym>
        <rdfs:label>walk gait</rdfs:label>
        <skos:closeMatch>NBO:0000056</skos:closeMatch>
        <skos:example>&quot;...the long toes of grallatores are formed for walking over swamps and floating plants...&quot;</skos:example>
        <skos:scopeNote>&quot;For quadrupedal, hexapedal and octopedal animals, during walking there are periods where three or more feet are contemporary in contact with the ground. For this reason walking is defined a statically stable gait. On contrary, bipedal walking must rely on dynamic equilibrium to achieve balance and stability.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Other terms should be used in place of &apos;walk&apos; for animals that move in ways which do not meet these criteria, including the terms crutching, crawling, creeping, or punting.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000134"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Stepping gait that involves an appendage out of phase with the opposing limb in the same girdle, there is always at least one limb acting as ground-support (no suspension phase), the average duty factor of the limbs is always &gt;0.5, and walking animals must elevate the center of mass (COM) from the ground, rather than incorporating prolonged contact between the animal’s belly and the substrate (thereby maintaining forward momentum during both stance and swing phases).</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000134"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>walk</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000134"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">walking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000134"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>walk gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000134"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...the long toes of grallatores are formed for walking over swamps and floating plants...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000134"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;For quadrupedal, hexapedal and octopedal animals, during walking there are periods where three or more feet are contemporary in contact with the ground. For this reason walking is defined a statically stable gait. On contrary, bipedal walking must rely on dynamic equilibrium to achieve balance and stability.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.13130/biancardi-carlo-massimo_phd2012-01-31</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000134"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Other terms should be used in place of &apos;walk&apos; for animals that move in ways which do not meet these criteria, including the terms crutching, crawling, creeping, or punting.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000135 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000135">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000130"/>
        <rdfs:subClassOf>
