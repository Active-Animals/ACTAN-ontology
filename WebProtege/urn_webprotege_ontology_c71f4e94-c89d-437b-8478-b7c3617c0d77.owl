                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000650"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/manoeuvre"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-23T07:50:50.181182Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>A manoeuvre that is sideways.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>lateral movement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sideslipping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sidling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">crabbing</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>sideways</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sidling manoeuvre</rdfs:label>
        <skos:example>&quot;...female Nocomis leptocephalus... entered the pit either by... swimming upstream to one side and sidling laterally into the pit.&quot;</skos:example>
        <skos:scopeNote>&quot;The long-legged greyhound commonly paces to avoid interference and can trot without crabbing only if moving relatively slowly.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000153"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>A manoeuvre that is sideways.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1242/jeb.120.1.283</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;While other crabs (decapod crustaceans) typically use octapedal locomotion and walk sideways, hermit crabs walk forward using six legs and provide an interesting comparison with other crustaceans as well as insects.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000153"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>lateral movement</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2006</dc:date>
        <dc:source>doi:10.1093/auk/123.4.967</dc:source>
    </owl:Axiom>
