        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>contrast colouration</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000867"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Aequidens latifrons...
When the fish is, for instance, displaying, spawning, or caring for young, the cross bars are intensely dark while the background is nearly white. In the nonreproductive markings the contrast between the bands and the intermediate zones is far less, the bands being lighter and the background darker coloured.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000867"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Zebrafish...
Lateral display: Two fish line up parallel to each other head to tail, raise their dorsal fins (fin raise), extend their caudal fins, darken in color (body color change), and swim in circles (circling), often ascending.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000868 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000868">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001772"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-07T10:42:49.995465Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement that surrounds and separates an object from its ambient environment.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">engulf</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>taking up</oboInOwl:hasExactSynonym>
        <rdfs:label>engulfing movement</rdfs:label>
        <skos:example>&quot;A more common and realistic estimate is that a fullgrown blue whale engulfs 60 m3 or 60 metric tons of water, approximately 50% of its body volume.&quot;</skos:example>
        <skos:example>&quot;Suddenly it darts forward with folded fins in a single snap of the trunk, and engulfs the Daphnia.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000868"/>
