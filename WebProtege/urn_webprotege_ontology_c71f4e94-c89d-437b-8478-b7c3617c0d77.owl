        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-19T21:39:50Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Stationing that minimises exposure to current, by streamlined adherence to substrate, without body or appendage movement.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>hunkering</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>clinging</oboInOwl:hasRelatedSynonym>
