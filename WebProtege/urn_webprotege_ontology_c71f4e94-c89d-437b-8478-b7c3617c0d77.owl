    <!-- http://purl.obolibrary.org/obo/ACTAN_0000069 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002534"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003097"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-01-20T07:30:17.324692Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Natatorial mode that uses a combination of lateral, dorsal, and ventral fins for thrust.

MPF propulsion couples fin rays and can offer greater maneuverability than BCF propulsion.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">MPF propulsion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>median and/or paired fin</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">MPF mode</rdfs:label>
        <skos:scopeNote>&quot;...many fish typically utilize MPF modes for foraging, as these offer greater maneuverability...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000069"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Natatorial mode that uses a combination of lateral, dorsal, and ventral fins for thrust.

MPF propulsion couples fin rays and can offer greater maneuverability than BCF propulsion.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000069"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
