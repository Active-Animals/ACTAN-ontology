    <!-- http://purl.obolibrary.org/obo/ACTAN_0000732 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000732">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002328"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-28T11:37:10.769695Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement that decreases the angle between two joined body parts.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">flexing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>bending</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>collapsing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>folding</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gathered</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lowering</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>raising</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>retracting</oboInOwl:hasRelatedSynonym>
        <rdfs:label>flexing movement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000120"/>
        <skos:example>&quot;Bipedal landing: Hindlimbs land first, flexing to absorb most or all of the energy of impact; used primarily after leaps with vertical cling take-offs.&quot;</skos:example>
        <skos:scopeNote>In the case where an appendage is swung through a dorsal/ventral arc in a transverse plane (e.g. flapping), our terms related to abduction and adduction are preferred.

In the case where an appendage is moved through a dorsal/ventral arc but parallel to the body (alongside/parasagitally), our terms related to protraction and retraction are preferred.</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000732"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Movement that decreases the angle between two joined body parts.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.13130/biancardi-carlo-massimo_phd2012-01-31</dc:source>
