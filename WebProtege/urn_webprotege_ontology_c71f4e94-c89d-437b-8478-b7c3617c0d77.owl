    <!-- http://purl.obolibrary.org/obo/ACTAN_0000722 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000722">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000628"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002246"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-26T09:41:36.744701Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Grip which uses opposed end-effectors and minimal power to manipulate an object.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>precision grasp</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>precision pinch</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">precision grip</rdfs:label>
        <skos:example>&quot;...the acutest observer by examining the dead body of the water-ouzel would never have suspected its sub-aquatic habits; yet this anomalous member of the strictly terrestrial thrush family wholly subsists by diving,—grasping the stones with its feet...&quot;</skos:example>
        <skos:example>&quot;A dominant individual grasps the hand extended to him by a subordinate for reassurance,&quot;</skos:example>
        <skos:example>&quot;The mating position in Lepidoptera is relatively homogenous. The male usually initiates contact in a side-by-side position, bending his highly moveable abdomen up to 180° towards the female until the tip of her abdomen can be grasped by the claspers.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000722"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Grip which uses opposed end-effectors and minimal power to manipulate an object.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/s00426-009-0242-2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000722"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>precision grasp</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1111/brv.12010</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000722"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>precision pinch</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1007/s00426-009-0242-2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000722"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">precision grip</owl:annotatedTarget>
        <dc:source>doi:10.1007/s00426-009-0242-2</dc:source>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000722"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...the acutest observer by examining the dead body of the water-ouzel would never have suspected its sub-aquatic habits; yet this anomalous member of the strictly terrestrial thrush family wholly subsists by diving,—grasping the stones with its feet...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000722"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;A dominant individual grasps the hand extended to him by a subordinate for reassurance,&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000722"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The mating position in Lepidoptera is relatively homogenous. The male usually initiates contact in a side-by-side position, bending his highly moveable abdomen up to 180° towards the female until the tip of her abdomen can be grasped by the claspers.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1469-185X.2007.00029.x</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000723 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000723">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000122"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-26T16:23:20.5588Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement in which the gape is open.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>agape</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">ajar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gaping</oboInOwl:hasExactSynonym>
        <rdfs:label>gape placement</rdfs:label>
        <skos:example>&quot;Scallop swimming provides a simple example of a muscle generating positive work to act as a motor. The cycle begins... when the gape of the shell is maximal.&quot;</skos:example>
        <skos:example>&quot;Suspension-feeding ducks have relatively long and broad bills. The larger, upper bill in these birds bows upward in cross section to canopy completely the lower bill and the tongue when the mouth is closed. A row of keratinized lamellae lines the lateral margins of both beaks. When the mouth is slightly ajar, the lamellae on the upper jaw oppose the lamellae on the lower jaw and may act as sieves for straining particles from the water.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000723"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Placement in which the gape is open.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>ISBN:9780226315737</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000723"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>agape</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>doi:10.1111/mms.13009</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000723"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">ajar</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1993</dc:date>
        <dc:source>ISBN:9780226315737</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000723"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>gaping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000723"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>gape placement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000723"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Scallop swimming provides a simple example of a muscle generating positive work to act as a motor. The cycle begins... when the gape of the shell is maximal.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000723"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Suspension-feeding ducks have relatively long and broad bills. The larger, upper bill in these birds bows upward in cross section to canopy completely the lower bill and the tongue when the mouth is closed. A row of keratinized lamellae lines the lateral margins of both beaks. When the mouth is slightly ajar, the lamellae on the upper jaw oppose the lamellae on the lower jaw and may act as sieves for straining particles from the water.&quot;</owl:annotatedTarget>
        <dc:source>https://orcid.org/0000-0002-4277-2151</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000724 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000724">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000598"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-26T19:15:24.119463Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Dipping which is head down.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>head lowering</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">head-dipping</oboInOwl:hasExactSynonym>
        <rdfs:label>head dipping</rdfs:label>
        <skos:example>&quot;Attitude of inferiority...
C. meeki with the head down...&quot;</skos:example>
        <skos:example>&quot;Spawning in Nocomis leptocephalus...
Pit-digging occurred as the male dipped his head and drove his snout into the pit floor while vigorously beating his tail.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000724"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Dipping which is head down.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/j.1444-2906.2003.00797.x</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Head down threat: a display shown by a territory holder to neighboring invaders near the boundary. The territory holder threatens the invaders by slightly dipping its head.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000724"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>head lowering</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1984</dc:date>
        <dc:source>https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download</dc:source>
        <skos:scopeNote>&quot;...lowering or raising the head...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000724"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">head-dipping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000724"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>head dipping</owl:annotatedTarget>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000724"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Attitude of inferiority...
C. meeki with the head down...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000724"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Spawning in Nocomis leptocephalus...
Pit-digging occurred as the male dipped his head and drove his snout into the pit floor while vigorously beating his tail.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000725 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000725">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000678"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-27T08:30:37.567767Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flick in which the head is jerked, then returned to the resting position.

It may be up, laterally, or rotated around the long axis.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">head-flick</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>rotary-head-shaking</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">head flick</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000767"/>
        <skos:example>&quot;In Cygnus, the head-flick is entirely rotary and the head is not jerked upward... The lateral component seems to be absent or poorly developed in large birds with long necks.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000725"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flick in which the head is jerked, then returned to the resting position.

It may be up, laterally, or rotated around the long axis.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853965x00138</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The head is rapidly jerked up, shaken laterally once or twice, and at the same time rotated around the long axis as in body-shaking, then returned to the resting position.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000725"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">head-flick</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000725"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>rotary-head-shaking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000725"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">head flick</owl:annotatedTarget>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000725"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In Cygnus, the head-flick is entirely rotary and the head is not jerked upward... The lateral component seems to be absent or poorly developed in large birds with long necks.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000726 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000726">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002327"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-27T09:15:46.892233Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement that increases the angle between two joined body parts.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>extending</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">extension</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>putting out</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>erecting</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>erection</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lowering</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>opening</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>raising</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>retraction</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>setting up</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>straightening</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>telescoping</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">extending movement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000083"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000523"/>
        <skos:example>&quot;Ascent on larger supports (e.g. &gt; 20 cm in chimpanzees and baboons) angled &gt;=45 degrees in which the elbow is extended.&quot;</skos:example>
        <skos:scopeNote>&quot;Fin raise (fin extension/erection): Raising the dorsal fin...; common in zebrafish during aggression and courtship.&quot;</skos:scopeNote>
        <skos:scopeNote>In the case where an appendage is swung through a dorsal/ventral arc in a transverse plane (e.g. flapping), our terms related to abduction and adduction are preferred.

In the case where an appendage is moved through a dorsal/ventral arc but parallel to the body (alongside/parasagitally), our terms related to protraction and retraction are preferred.</skos:scopeNote>
    </owl:Class>
