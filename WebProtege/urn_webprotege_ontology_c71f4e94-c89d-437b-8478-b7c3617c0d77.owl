        <oboInOwl:creation_date>2025-08-06T14:15:23.751844Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Tooling that wipes with an object.

This may be to access, allogroom, autogroom, or clear.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">wipe with an object</oboInOwl:hasExactSynonym>
        <rdfs:label>wiping tooling</rdfs:label>
        <skos:scopeNote>&quot;Use of leaves, straw, paper, and so on to wipe dirt (feces, urine, mud, ejaculate, and so on) from self or others...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000787"/>
