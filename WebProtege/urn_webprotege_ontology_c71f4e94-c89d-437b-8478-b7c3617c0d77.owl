    <!-- http://purl.obolibrary.org/obo/ACTAN_0000894 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000894">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000552"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000465"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-20T09:46:40.074034Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Ranking which is somewhat inhibited by recognition of a prior experience of acceptance.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">acquaintance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>friendly behavior</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>ambivalent behaviour</oboInOwl:hasRelatedSynonym>
        <rdfs:label>acquaintance ranking</rdfs:label>
        <skos:example>&quot;Japanese macaques (Macaca fuscata fuscata)...
It is known that friendly reunions of opponents soon after an aggressive interaction (reconciliations) are less likely to occur in the context of feeding.&quot;</skos:example>
        <skos:scopeNote>&quot;In social species of reptiles and amphibians, the chemosensory pathways that regulate self-recognition and recognition of friendly conspecifics (for example, a bonded partner) have been identified.&quot;</skos:scopeNote>
    </owl:Class>
