        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000689"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Aeoliscus strigatus (Gunther) and other members of this group swim with the axis practically vertical for most part although they may assume any other position.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
