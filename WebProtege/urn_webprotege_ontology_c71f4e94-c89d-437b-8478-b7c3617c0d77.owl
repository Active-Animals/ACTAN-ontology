    <!-- http://purl.obolibrary.org/obo/ACTAN_0000915 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000915">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000395"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000146"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-11-07T13:15:52.680542Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placing which keeps temperatures suitable.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">place thermo</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">thermoregulation placing</rdfs:label>
        <skos:example>&quot;Crocodilians have a particularly restricted range of suitable incubation temperatures, and offspring survival is low in areas that lack sufficient open, sunny sites for nest mound construction.&quot;</skos:example>
        <skos:example>&quot;Megapodes construct nest mounds from which the young emerge fully independent of adults, and these birds select mound sites with thick vegetative cover to prevent desiccation of the incubating eggs.&quot;</skos:example>
    </owl:Class>
