    <!-- http://purl.obolibrary.org/obo/ACTAN_0000123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000467"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000327"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-17T19:35:01.62595Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Feigning that moves rapidly toward the opponent, but without physical contacts between them.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>closed mouth striking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">striking</oboInOwl:hasRelatedSynonym>
        <rdfs:label>closed-mouth-strike feigning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000512"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000859"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000123"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Feigning that moves rapidly toward the opponent, but without physical contacts between them.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Strike (striking): An aggression-related behavior, observed in zebrafish when the fish swims rapidly toward the opponent, but without physical contacts between them.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000123"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>closed mouth striking</owl:annotatedTarget>
