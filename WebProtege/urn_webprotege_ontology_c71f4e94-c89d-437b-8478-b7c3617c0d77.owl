    <!-- http://purl.obolibrary.org/obo/ACTAN_0000712 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000712">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000299"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0095005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-20T16:40:23.664067Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym xml:lang="en">vertical migration</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Migration in which diurnal movements involve depth changes.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>diurnal vertical movement</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">daily-vertical migration</rdfs:label>
        <skos:closeMatch>NBO:0070002</skos:closeMatch>
        <skos:example>&quot;The major adaptive function of continuous flat swarms over the bottom - observed for A. clausi in Shijiki Bay and for Oithona oculata in Tanabe Bay - may differ from that of ball-shaped ones: the former swarm type seems to represent aggregations due to extensive vertical migration.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000712"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget xml:lang="en">vertical migration</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1983</dc:date>
        <dc:source>doi:10.3354/meps011165</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000712"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Migration in which diurnal movements involve depth changes.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1098/rsos.170467</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Chambered nautilus (Nautilus pompilius) perform diurnal vertical movements involving depth changes of 500–600 m.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000712"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>diurnal vertical movement</owl:annotatedTarget>
        <dc:source>doi:10.1098/rsos.170467</dc:source>
    </owl:Axiom>
