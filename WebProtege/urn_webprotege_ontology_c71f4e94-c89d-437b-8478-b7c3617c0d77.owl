    <!-- http://purl.obolibrary.org/obo/ACTAN_0000625 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000625">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000743"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-24T22:49:44.97863Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement that results from contracting.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">contracted</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">contraction placement</rdfs:label>
        <skos:example>&quot;Metridium senile is notable for the variety of shapes which it assumes. It may be fully expanded with a narrow or with a wide column. The same anemone may next day be found contracted down to a mere button-like object. It may indulge in a variety of contortions in which it is laterally bent, or possesses deep transverse constrictions locally or completely embracing the column. The whole anemone may on occasion temporarily assume a shrivelled and contracted condition...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000625"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Placement that results from contracting.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000625"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">contracted</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000625"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">contraction placement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000625"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Metridium senile is notable for the variety of shapes which it assumes. It may be fully expanded with a narrow or with a wide column. The same anemone may next day be found contracted down to a mere button-like object. It may indulge in a variety of contortions in which it is laterally bent, or possesses deep transverse constrictions locally or completely embracing the column. The whole anemone may on occasion temporarily assume a shrivelled and contracted condition...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000626 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000626">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000373"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000428"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-03-05T21:36:06.477212Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Passivity that triggers an unlearned avoidance response in the attacker, causing it to slow or stop its attack.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>deimatic behaviour</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">deimatism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>startle behaviour</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">deimatism passivity</rdfs:label>
        <skos:example>&quot;The ‘unken reflex’, named after the fire-bellied toads ‘Feuerunke’ (Löhner, 1919), is a proximate cause of deimatic behaviour but little is known about its mechanistic underpinnings. Typically only applied to amphibians, it manifests as a rigid arching or lifting of the body, legs, and/or tail in which ventral surfaces become visible and sometimes body parts are ‘hypnotically’ swayed.&quot;</skos:example>
        <skos:relatedMatch>NBO:0020117</skos:relatedMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000626"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Passivity that triggers an unlearned avoidance response in the attacker, causing it to slow or stop its attack.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/brv.12891</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Given the overall lack of clarity, but considering the main conceptual points from previous contributions to the field, we suggest the following hypothesis for what constitutes deimatic behaviour: a behaviour performed by a target different from fleeing and retaliation that is triggered by it perceiving threat from an attacker during approach or subjugation, and which can trigger an unlearned avoidance response in the attacker causing it to slow or stop its attack.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000626"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>deimatic behaviour</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.1111/brv.12891</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000626"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">deimatism</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.1111/brv.12891</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000626"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>startle behaviour</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.1111/brv.12891</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000626"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">deimatism passivity</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000626"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The ‘unken reflex’, named after the fire-bellied toads ‘Feuerunke’ (Löhner, 1919), is a proximate cause of deimatic behaviour but little is known about its mechanistic underpinnings. Typically only applied to amphibians, it manifests as a rigid arching or lifting of the body, legs, and/or tail in which ventral surfaces become visible and sometimes body parts are ‘hypnotically’ swayed.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/brv.12891</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000627 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000627">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000086"/>
