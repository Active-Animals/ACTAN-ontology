        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-14T16:53:51.561044Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Ethotype that uses the nose against the tail of another animal.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">tail-nose</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">tail-nose ethotype</rdfs:label>
        <skos:example>&quot;The male will follow or chase the female in a jerky swimming motion with his dorsal fin erect (fin raise), and attempt to tail-nose touch (this happens after the male makes visual contact, since first needs to chemically sense the readiness of female and display sexual aggregating behavior).&quot;</skos:example>
    </owl:Class>
