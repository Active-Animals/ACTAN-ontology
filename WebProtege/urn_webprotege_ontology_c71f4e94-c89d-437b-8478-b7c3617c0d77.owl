    <!-- http://purl.obolibrary.org/obo/ACTAN_0000514 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000514">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000149"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000651"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001901"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/manoeuvre"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-12-30T15:47:34.641164Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>A manoeuvre that is posterior-first.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>backing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>backing maneuver</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">backing-up</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>move backward</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reversal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>travel backward</oboInOwl:hasExactSynonym>
        <rdfs:label>backing manoeuvre</rdfs:label>
        <skos:example>&quot;...in bluegill sunfish, Lepomis macrochirus...

During backing up, the ventral lobe initiated a dorsally directed wave along the distal edge of the caudal fin.&quot;</skos:example>
        <skos:example>&quot;Both the male and female Gryllus bimaculatus used in this study were sexually mature virgins of similar age... the mate guarding intensity (the number of body judders and antennal whips/rotations) was recorded every minute until the male entered into courtship (determined by production of long courtship song whilst backing towards the female;&quot;</skos:example>
        <skos:narrowMatch>NBO:0000101</skos:narrowMatch>
        <skos:scopeNote>&quot;A superficial glance at nearly any typical fish poised quietly in the water should convince anyone that the pectorals are engaged in backing water. That is, the effective thrust is forward, which would tend to move the specimen in a backward direction... However in connection with the effect of the exhaled water it is conceived that the function of this movement of the pectorals is to neutralize its reactive force.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000514"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>A manoeuvre that is posterior-first.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1098/rsos.170467</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Animals swam with either an anterior-first or posterior-first orientation.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000514"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>backing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
