        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000614"/>
