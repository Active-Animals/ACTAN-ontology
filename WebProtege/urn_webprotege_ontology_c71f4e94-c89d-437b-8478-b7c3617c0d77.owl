        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000765"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;I have also seen vigorous wing-shaking during oiling in a Semipalmated Plover (Charadrius hiaticula) and a Song Thrush (Turdus ericetorum).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
