        <oboInOwl:hasDefinition>Agonism in which inequality characterises the way members of a social organisation treat one another.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">hierarchy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ranking</oboInOwl:hasExactSynonym>
        <rdfs:label>ranking agonism</rdfs:label>
        <skos:scopeNote>&quot;Agonistic social behavior used to establish dominance/hierarchy, plays a role in fighting behavior.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The hierarachy is a purely internal phenomenon arising among the members of a society, but it can nevertheless enormously affect their individual expectations of life and reproduction.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000552"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Agonism in which inequality characterises the way members of a social organisation treat one another.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000552"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">hierarchy</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
