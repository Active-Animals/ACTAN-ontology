    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000664">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000411"/>
        <rdfs:subClassOf>
