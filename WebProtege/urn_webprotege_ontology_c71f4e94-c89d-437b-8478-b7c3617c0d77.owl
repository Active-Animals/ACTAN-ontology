    <!-- http://purl.obolibrary.org/obo/ACTAN_0000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000010"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001787"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-03-02T21:05:27.250189Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mode that uses appendages for aquatic activity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>natatorial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>fin-like limbs</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">finned</oboInOwl:hasNarrowSynonym>
        <rdfs:label>natatorial mode</rdfs:label>
        <skos:scopeNote>&quot;Within the basic grouping into MPF and BCF propulsion, further types of swimming... can be identified for each group... These... should be thought of as pronounced points within a continuum, rather than discrete sets. Fish may exhibit more than one... either at the same time or at different speeds.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000019"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
