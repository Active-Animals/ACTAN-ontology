    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000148"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>unstable</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000148"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>stabilizing kinetics</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000148"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Among prehensile-tailed New World monkeys many positional modes are stabilized by tail grips.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/BF02381373</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000148"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;We conclude that the slow gaits of most tetrapods, including all tippy ones like turtles, should fall in the upper left quadrant of the gait graph. Any exceptions may be expected to be animals for which stability is assured by large feet or a wide stance. This expectation is realized: Animals known to walk in diagonal sequence are primates and the giant armadillo, aardvark, and kinkajou.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000148"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...stable designs not only resist externally imposed changes in an organism’s trajectory, but they also resist changes imposed by the animal itself. In contrast, mechanically unstable bodies that can easily be blown off course are also very responsive to voluntary steering maneuvers.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1126/science.288.5463.100</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000148"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Destabilizing recoil forces generated by the yaw and sideslip inherent in undulatory body and caudal-fin (BCF) modes of rectilinear fish swimming are thought to produce significantly more drag than is expected in fishes swimming with rigid bodies.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000148"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Muscles in crabs and small mammals may function more to stabilize joints and operate as springs.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.130.1.155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000148"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The stability of fishes in the first place depends on the relative positions of the centres of gravity and of buoyancy (centre of volume). If the former is situated above the latter the equilibrium is unstable; if the centre of gravity, however, lies below the centre of buoyancy or coincides with it, the equilibrium is stable.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000149 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000747"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
