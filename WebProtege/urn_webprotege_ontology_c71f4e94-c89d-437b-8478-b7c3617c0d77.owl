        <oboInOwl:creation_date>2025-02-06T08:10:43.778037Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mouthing that reflexively opens and closes during exposure to stimuli.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">snapping</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">snapping gaping</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000570"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mouthing that reflexively opens and closes during exposure to stimuli.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Reflexive opening and closing of mouth during exposure to high concentrations of appetitive stimuli (e.g., L-alanine, food extract); signals initiation of ingestive phase during feeding.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000570"/>
