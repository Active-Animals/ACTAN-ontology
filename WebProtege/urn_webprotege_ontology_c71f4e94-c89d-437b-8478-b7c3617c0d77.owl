        <oboInOwl:creation_date>2025-11-18T10:45:34.273435Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Squeeze that involves a full-circle narrowing.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">constriction</oboInOwl:hasExactSynonym>
        <rdfs:label>constriction squeeze</rdfs:label>
        <skos:example>&quot;Metridium...
Constriction of the circular muscle fibre -narrows the column. When this happens the compressed coelenteric fluid enforces an extension of the longitudinal muscles of the column system.&quot;</skos:example>
    </owl:Class>
