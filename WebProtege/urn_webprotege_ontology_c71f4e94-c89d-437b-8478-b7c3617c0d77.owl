    <!-- http://purl.obolibrary.org/obo/ACTAN_0000300 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000726"/>
