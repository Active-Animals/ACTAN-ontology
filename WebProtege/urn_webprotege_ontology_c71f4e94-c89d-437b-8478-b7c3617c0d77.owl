                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-30T07:16:28.758515Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Stepping gait that is vaulting, asymmetric, and involving anterior transverse couplets.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>crutch</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">crutching</oboInOwl:hasRelatedSynonym>
        <rdfs:label>crutch gait</rdfs:label>
        <skos:example>&quot;Lophius piscatorius pushes the body along the bottom at times by kicking back with the ventrals.&quot;</skos:example>
        <skos:example>&quot;Mudskippers use slow-speed movements called &apos;crutching,&apos; where the fish forms transverse couplets in which both fins in the pectoral gridle move in synchrony. Mudskippers can elevate the mid-body during the stance phase of crutching behavior, but the body returns to full contact with the substrate as both pectoral fins are lifted during the swing phase. Because of this, mudskippers undergo marked deceleration when the pectoral fin is in swing phase, which does not permit continuous motion between cycles.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000206"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Stepping gait that is vaulting, asymmetric, and involving anterior transverse couplets.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000206"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>crutch</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000206"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">crutching</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000206"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>crutch gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000206"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Lophius piscatorius pushes the body along the bottom at times by kicking back with the ventrals.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000206"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Mudskippers use slow-speed movements called &apos;crutching,&apos; where the fish forms transverse couplets in which both fins in the pectoral gridle move in synchrony. Mudskippers can elevate the mid-body during the stance phase of crutching behavior, but the body returns to full contact with the substrate as both pectoral fins are lifted during the swing phase. Because of this, mudskippers undergo marked deceleration when the pectoral fin is in swing phase, which does not permit continuous motion between cycles.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000207 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000207">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000210"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000199"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000211"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
