    <!-- http://purl.obolibrary.org/obo/ACTAN_0000927 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000927">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000288"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002233"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-11-17T11:54:03.234156Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>separating</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Relativity in which one separates from another.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">dissociation</oboInOwl:hasExactSynonym>
        <rdfs:label>dissociation relativity</rdfs:label>
        <skos:example>&quot;Apterygote insects transfer sperm indirectly via spermatophores or sperm drops. Spermatophores are usually deposited on the ground or on special silk threads. They are then picked up by the female, sometimes with active male participation and close physical contact between male and female, sometimes in dissociation.&quot;</skos:example>
        <skos:example>&quot;Nocomis leptocephalus...
Dissociation. The spawning clasp was completed in about a second and the pair immediately separated.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000927"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>separating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000927"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Relativity in which one separates from another.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
