        <oboInOwl:hasDefinition>Ingestion that transports a bolus down the esophagus.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>deglutition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">swallowing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>gulping</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">swallow ingestion</rdfs:label>
        <skos:closeMatch>NBO:0000545</skos:closeMatch>
        <skos:example>&quot;Penguins have spines only on their dorsal tongue, which allow them to better grip and swallow slippery fish.&quot;</skos:example>
    </owl:Class>
