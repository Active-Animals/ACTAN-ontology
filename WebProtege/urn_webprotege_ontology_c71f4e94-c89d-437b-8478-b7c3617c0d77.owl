        <owl:annotatedTarget xml:lang="en">indirect-sample participation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000411 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000411">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000409"/>
        <rdfs:subClassOf rdf:nodeID="genid3090"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001164"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-11T17:15:45.403181Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>associating</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Participation in which an animal approaches and continually interacts with others.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>aggregating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>aggregation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>assembling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>congregating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>converging</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>crowding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">grouping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>packing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>herding</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>gregarious</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>kin preference</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>social preference</oboInOwl:hasRelatedSynonym>
        <rdfs:label>aggregation participation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000551"/>
        <skos:closeMatch>NBO:0040000</skos:closeMatch>
        <skos:scopeNote>&quot;Aggregation behavior: Seeking of conspecifics based on chemical, visual or other cues; exploratory approach that then leads to shoaling, schooling, and/or sexual aggregating behavior, where applicable.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Social grouping and social behavior are often constrained by environmental factors, including predation pressure and physical habitat structure.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The congregating of juveniles is a weakly developed type of aggregating.&quot;</skos:scopeNote>
    </owl:Class>
