        <oboInOwl:creation_date>2025-04-18T09:41:37.309415Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Dimension that corresponds to a continuous, flat carpet.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>2-D</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>carpeting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>flat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">two dimensional</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>two-dimensional space</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">two dimension</rdfs:label>
        <skos:example>&quot;The desert locust, Schistocerca gregaria, has a devastating social and economic impact on humans. Before taking flight as adults, wingless juveniles (also called nymphs or hoppers) form coordinated &quot;marching bands&quot; that can extend over many kilometers.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000408"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Dimension that corresponds to a continuous, flat carpet.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.3354/meps011165</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;A. clausi in Shijiki Bay and O. oculata in Tanabe Bay formed continuous flat swarms and carpeted the bottom with copepods.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
