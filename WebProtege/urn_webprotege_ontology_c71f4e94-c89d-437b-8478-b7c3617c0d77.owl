    <!-- http://purl.obolibrary.org/obo/ACTAN_0000150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000303"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001816"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-23T07:49:59.090585Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics which is high-speed, short-term, and over a reduced distance.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>burst</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sprint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">sprinter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>ballistic system</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sprint kinetics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000171"/>
        <skos:example>&quot;The fastest of all terrestrial runners on sprint is considered the cheetah, with a reliable measured speed of 105 km.h-1 (29.2 m.s-1).&quot;</skos:example>
        <skos:example>&quot;We noted Uca pugilator could also travel at 0- 2 km [per hour] but they could run twice as fast for about 3 min and sprint at much higher speeds for a few seconds.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000150"/>
