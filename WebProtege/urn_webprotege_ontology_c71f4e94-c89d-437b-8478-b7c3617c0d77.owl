    <!-- http://purl.obolibrary.org/obo/ACTAN_0000085 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000925"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-16T15:08:38.679206Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement which occurs during the contact phase of a gait.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>stance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">grounding</oboInOwl:hasRelatedSynonym>
        <rdfs:label>stance placement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000736"/>
        <skos:example>&quot;Hermit crabs (Order Anomura) unlike the Brachyura usually move forward rather than sideways. Movement in C. compressus is principally produced by the second and third pairs of thoracic appendages. These walking legs are positioned laterally and appear to provide thrust with both a pulling motion during the early part of the leg cycle as they reach forward, contact the sand and flex, and a pushing motion in the latter phase of the leg cycle when the legs extend to the rear of the crab.&quot;</skos:example>
        <skos:scopeNote>&quot;Compliant walking, groucho run, amble, or grounded run: A quadrupedal or bipedal gait characterized by... (3) no true aerial phase...&quot;
&quot;Step: A progressive motion in which one of the supporting members of the body is lifted from the ground, thrust in the direction of movement, and placed again on the ground.&quot;
&quot;Stance phase: The period of time when the foot is in contact with the ground.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000085"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Placement which occurs during the contact phase of a gait.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000085"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>stance</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1980</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000085"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">grounding</owl:annotatedTarget>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000085"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>stance placement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000085"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Hermit crabs (Order Anomura) unlike the Brachyura usually move forward rather than sideways. Movement in C. compressus is principally produced by the second and third pairs of thoracic appendages. These walking legs are positioned laterally and appear to provide thrust with both a pulling motion during the early part of the leg cycle as they reach forward, contact the sand and flex, and a pushing motion in the latter phase of the leg cycle when the legs extend to the rear of the crab.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000085"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Compliant walking, groucho run, amble, or grounded run: A quadrupedal or bipedal gait characterized by... (3) no true aerial phase...&quot;
&quot;Step: A progressive motion in which one of the supporting members of the body is lifted from the ground, thrust in the direction of movement, and placed again on the ground.&quot;
&quot;Stance phase: The period of time when the foot is in contact with the ground.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    


