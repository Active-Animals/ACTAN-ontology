    <!-- http://purl.obolibrary.org/obo/ACTAN_0000591 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000591">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000677"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001309"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-09T16:36:49.116475Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Buoyancy that involves gulping air at the water surface.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">piping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>air-gulping</oboInOwl:hasRelatedSynonym>
        <rdfs:label>piping buoyancy</rdfs:label>
        <skos:scopeNote>&quot;Buoyancy control during ASR allows fish to optimize their position (benthic species) or swimming mode (midwater species) and to compensate for O2 loss from the swimbladder (which decreases in volume) that occurs during hypoxic stress.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000591"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Buoyancy that involves gulping air at the water surface.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Piping: Gulping air at the water surface; can be indicative of distress (e.g., hypoxia or toxicity), but may also be seen during depth-related adjustment of swim bladder volume (during diving).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000591"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">piping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000591"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>air-gulping</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.198.1.79</dc:source>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000591"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>piping buoyancy</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000591"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Buoyancy control during ASR allows fish to optimize their position (benthic species) or swimming mode (midwater species) and to compensate for O2 loss from the swimbladder (which decreases in volume) that occurs during hypoxic stress.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.198.1.79</dc:source>
