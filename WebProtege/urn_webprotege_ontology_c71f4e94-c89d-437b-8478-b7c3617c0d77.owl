    <!-- http://purl.obolibrary.org/obo/ACTAN_0000543 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000541"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000083"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-21T17:55:40.303416Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Switch which is periodic.

It is likely one manifestation of oscillation of physiology</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>circadian rhythm</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">phase</oboInOwl:hasRelatedSynonym>
        <rdfs:label>phase switch</rdfs:label>
        <skos:example>&quot;Haplochromis multicolor...
In a male in the non-mating phase and particularly in a female carrying young, longitudinal bands develop.&quot;</skos:example>
        <skos:example>&quot;Oscillations of locomotor activity: Sinusoidal aspect of zebrafish locomotion/swimming, with alternating high and lower-velocity phases (usually, with the frequency of 4–5 min) when exposed to novel environments.&quot;</skos:example>
        <skos:example>&quot;When C. elegans animals are removed from food, they display a stereotyped sequence of two consecutive locomotion states. For the first 15 min, they engage in a local search state (also called “area-restricted search”) consisting of a high frequency of high-angle turns and omega bends. Then, they transition to a global search state (also referred to as dispersal); where they suppress their turning rates.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Switch which is periodic.

It is likely one manifestation of oscillation of physiology</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1534/genetics.120.303539</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Periodic display of sleep during lethargus is likely one manifestation of oscillation of physiology during larval development.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>circadian rhythm</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.3389/fnbeh.2010.00049</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">phase</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>phase switch</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Haplochromis multicolor...
In a male in the non-mating phase and particularly in a female carrying young, longitudinal bands develop.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Oscillations of locomotor activity: Sinusoidal aspect of zebrafish locomotion/swimming, with alternating high and lower-velocity phases (usually, with the frequency of 4–5 min) when exposed to novel environments.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;When C. elegans animals are removed from food, they display a stereotyped sequence of two consecutive locomotion states. For the first 15 min, they engage in a local search state (also called “area-restricted search”) consisting of a high frequency of high-angle turns and omega bends. Then, they transition to a global search state (also referred to as dispersal); where they suppress their turning rates.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1534/genetics.120.303539</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000752"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002448"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-22T20:41:12.913824Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Translocation which involves a route going back to a previously visited site.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">returning</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">returning translocation</rdfs:label>
        <skos:example>&quot;Eastern chipmunk (Tamias striatus) returning to burrow with load of seeds.&quot;</skos:example>
        <skos:example>&quot;I traced the returning file burthened with booty, for about forty yards, to a very thick clump of heath, whence I saw the last individual of F. sanguinea emerge, carrying a pupa;&quot;</skos:example>
        <skos:example>&quot;Macaca radiata...
Returning toward the trunk along these steeply sloped longitudinal branches was, effectively, a descent that required careful foot placement and tail braking.&quot;</skos:example>
        <skos:example>&quot;Some taxa—particularly snakes—often travel several kilometers from activity season ranges to return to the same hibernaculum each winter.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000544"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Translocation which involves a route going back to a previously visited site.</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000544"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">returning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000544"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">returning translocation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
