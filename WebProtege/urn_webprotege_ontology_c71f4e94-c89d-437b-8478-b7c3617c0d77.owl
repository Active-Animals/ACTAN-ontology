        <oboInOwl:creation_date>2025-09-29T07:51:00.186318Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Oscillation that is rapid, with a moderate amplitude.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>flutter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">fluttering</oboInOwl:hasExactSynonym>
        <rdfs:label>flutter oscillation</rdfs:label>
        <skos:example>&quot;Astronotus ocellatus...
Suddenly, often when one of the fishes is standing with the tail before the head of the partner, it flutters the tail, thereby demonstrating the conspicuous eye-spot on the base of the tail fin.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
