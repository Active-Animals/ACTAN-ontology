    <!-- http://purl.obolibrary.org/obo/ACTAN_0000228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000225"/>
