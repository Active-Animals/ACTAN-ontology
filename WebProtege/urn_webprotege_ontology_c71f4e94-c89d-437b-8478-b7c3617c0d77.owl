            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000913"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-11-10T12:06:10.818231Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Incubation that covers eggs.

This may  improve embryonic homeostasis and reduce predation.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">burial</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">burial incubation</rdfs:label>
        <skos:example>&quot;After a number of spawns a male N leptocephalus covers the pit with pebbles and excavates another pit for spawning... Eggs become buried and are thought to receive a constant circulation of water and remain well aerated in the clean interstices of the nest.&quot;</skos:example>
        <skos:example>&quot;Crocodilians have a particularly restricted range of suitable incubation temperatures, and offspring survival is low in areas that lack sufficient open, sunny sites for nest mound construction.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000916"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Incubation that covers eggs.

This may  improve embryonic homeostasis and reduce predation.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000916"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">burial</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
