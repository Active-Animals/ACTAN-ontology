    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000449"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...harems are established and a rigid hierarchy is maintained based on the dominance of a single male over a group of females.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000449"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Yet, these single-species studies imply that the courtship in sepsid flies can be quite elaborate and may include male displays and precopulatory guarding.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000450 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000450">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000326"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-17T11:38:45.64893Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>sexual selection</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Mating in which a mate is selected after comparison.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>mate choice</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mate selection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>partner selection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">female choice</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>female consent</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>receptiveness</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>receptivity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>unreceptive</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mate-choice mating</rdfs:label>
        <skos:example>&quot;...in T.bifasciatum, free female mate choice and the need for males to compete for spawnings has led to the development of specific male sexual displays and coloration, and an active role of males in courtship activities. Females, on the other hand, lack a special sexual color pattern and well-developed sexual displays, and play a quiescent role in courtship.&quot;</skos:example>
        <skos:example>&quot;Approach... Nocomis leptocephalus... Although a female might swim towards the nest from any direction, she always approached the postured male from downstream.&quot;</skos:example>
        <skos:scopeNote>&quot;...a bird can recognise whether a member of the opposite sex is ready to pair or not. In most species, sexual receptiveness is signalled by behavioural changes...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Outside of the realms of studies of mate choice related to signal variation and studies of predator behavior related to prey cue variation, most of the focus of research on animal communication had traditionally been on the sender and the signal it produces.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000450"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>sexual selection</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000450"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mating in which a mate is selected after comparison.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Different authors... have suggested that the crowding together of the territories probably offers the female an opportunity to select her mate after comparison.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000450"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>mate choice</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000450"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>mate selection</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <skos:scopeNote>&quot;...select her mate...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000450"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>partner selection</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <skos:scopeNote>&quot;...selecting the right partner...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000450"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget xml:lang="en">female choice</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
