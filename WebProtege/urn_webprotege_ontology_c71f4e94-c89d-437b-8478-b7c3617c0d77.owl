        <owl:annotatedTarget>local search</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2011</dc:date>
        <dc:source>doi:10.1111/j.1469-185X.2010.00163.x</dc:source>
