    <!-- http://purl.obolibrary.org/obo/ACTAN_0000355 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000355">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010504"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-21T08:36:51.436313Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Forage that involves a diet of organisms living on a surface.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">grazing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>vegetation grazing</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>browsing</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">graze forage</rdfs:label>
        <skos:relatedMatch>NBO:0050000</skos:relatedMatch>
        <skos:scopeNote>&quot;Facultative suspension-feeding tadpoles are benthic grazers that have external keratinized beaks and denticles, which they use to reduce detritus, macrophytes, and periphytic films to a size small enough to be brought into the mouth in suspension.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Standing with its shoulders up to 4 m tall, the African elephant relies on its 1.5-m-long trunk to manipulate objects. The trunk is flexible enough to reach down to the ground (grazing) or up into a tree (browsing).&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The remaining 11 species can be classified as benthic grazers, as a large portion of their diet is composed of sessile or slow-moving benthic organisms.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000355"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Forage that involves a diet of organisms living on a surface.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1073/pnas.2122563119</dc:source>
        <dc:source>doi:10.1242/jeb.194704</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000355"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">grazing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000355"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>vegetation grazing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>doi:10.3389/fetho.2023.1231780</dc:source>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ECOCORE_00000099"/>
        <skos:scopeNote>&quot;...vegetation types were classified as ‘grazing’, which were areas dominated by open grassland, ‘cover’, which were areas dominated by trees or shrubs, and ‘grazing-cover’, which were areas with a mixture...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000355"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>browsing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
        <rdfs:comment>Throughout The Origin Of Species, Darwin does not mention grazing, and his mention of turf being &apos;browsed&apos; suggests he did not differentiate the behaviours, or at least not the labels.</rdfs:comment>
        <skos:scopeNote>&quot;...turf closely browsed by quadrupeds...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000355"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">graze forage</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000355"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Facultative suspension-feeding tadpoles are benthic grazers that have external keratinized beaks and denticles, which they use to reduce detritus, macrophytes, and periphytic films to a size small enough to be brought into the mouth in suspension.&quot;</owl:annotatedTarget>
        <dc:source>ISBN:9780226315737</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000355"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Standing with its shoulders up to 4 m tall, the African elephant relies on its 1.5-m-long trunk to manipulate objects. The trunk is flexible enough to reach down to the ground (grazing) or up into a tree (browsing).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1073/pnas.2122563119</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000355"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The remaining 11 species can be classified as benthic grazers, as a large portion of their diet is composed of sessile or slow-moving benthic organisms.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.194704</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000356 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000356">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-21T08:37:03.789586Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Forage that involves larger vegetation.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">browsing</oboInOwl:hasExactSynonym>
        <rdfs:label>browse forage</rdfs:label>
        <skos:example>&quot;As ambient over-winter temperatures have progressively increased with climate change, reductions in snow cover have enabled increased numbers of elk (Cervus canadensis) to occupy North American woodlands throughout the winter months. Browsing activity of these elk populations has reduced the growth of saplings and limited their availability as nesting sites in the subsequent summer months.&quot;</skos:example>
        <skos:scopeNote>&quot;Herbivorous fishes can be categorized into browsers, which remove established macroalgae, and a diverse guild of grazers that feed on surfaces covered with algal turfs...&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Standing with its shoulders up to 4 m tall, the African elephant relies on its 1.5-m-long trunk to manipulate objects. The trunk is flexible enough to reach down to the ground (grazing) or up into a tree (browsing).&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000356"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Forage that involves larger vegetation.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.3389/fetho.2023.1231780</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000356"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">browsing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
        <skos:scopeNote>&quot;But on looking closely between the stems of the heath, I found a multitude of seedlings and little trees, which had been perpetually browsed down by the cattle.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000356"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>browse forage</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000356"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;As ambient over-winter temperatures have progressively increased with climate change, reductions in snow cover have enabled increased numbers of elk (Cervus canadensis) to occupy North American woodlands throughout the winter months. Browsing activity of these elk populations has reduced the growth of saplings and limited their availability as nesting sites in the subsequent summer months.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/brv.12317</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000356"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Herbivorous fishes can be categorized into browsers, which remove established macroalgae, and a diverse guild of grazers that feed on surfaces covered with algal turfs...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/1365-2435.13457</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000356"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Standing with its shoulders up to 4 m tall, the African elephant relies on its 1.5-m-long trunk to manipulate objects. The trunk is flexible enough to reach down to the ground (grazing) or up into a tree (browsing).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1073/pnas.2122563119</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000357 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000893"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001303"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-08T13:23:01.325824Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Switch in which a movement generates a new sensory stimulus for the animal that, itself, serves as a trigger for the next movement.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">flexible behaviour pattern</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>situation-dependent flexibility</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stimulus response loop</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>variable activity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">variable behaviour pattern</oboInOwl:hasExactSynonym>
        <rdfs:label>flexibility switch</rdfs:label>
        <skos:example>&quot;...dolphins, which live in aquatic environments, have the capacity to echo-localize, as well as a flexible and social way of learning.&quot;</skos:example>
        <skos:example>&quot;Hanuman langurs (Semnopithecus entellus)... are not only socially flexible but also able to survive even under poor nutritional conditions... Because females have only behavioral signs of estrus and pregnant females mate regularly, there seems to be ample opportunity for situation-dependent flexibility in mating behavior.&quot;</skos:example>
        <skos:scopeNote>&quot;An even less complete performance of the prey-capturing behavior is commonly observed after the fish has devoured several crustacea in quick succession. The fish simply swims directly to the prey and takes it into its mouth. All intermediates are seen in the degree of completeness of prey-capturing behavior.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;This is necessary in order to distinguish the invariable fixed motor pattern of the activity from the variable orientating element, the taxis.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000357"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Switch in which a movement generates a new sensory stimulus for the animal that, itself, serves as a trigger for the next movement.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1016/j.cub.2019.11.022</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Alternatively, in a stimulus response loop each movement generates a new sensory stimulus for the animal that, itself, serves as a trigger for the next movement in the chain.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000357"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">flexible behaviour pattern</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
        <skos:scopeNote>&quot;...the flexible or variable introductory phase of an instinctive behaviour pattern...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000357"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>situation-dependent flexibility</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1007/s002650100391</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000357"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>stimulus response loop</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1016/j.cub.2019.11.022</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000357"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>variable activity</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000357"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">variable behaviour pattern</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
        <skos:scopeNote>&quot;...the flexible or variable introductory phase of an instinctive behaviour pattern...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000357"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>flexibility switch</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000357"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...dolphins, which live in aquatic environments, have the capacity to echo-localize, as well as a flexible and social way of learning.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.4000/ejpap.2324</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000357"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Hanuman langurs (Semnopithecus entellus)... are not only socially flexible but also able to survive even under poor nutritional conditions... Because females have only behavioral signs of estrus and pregnant females mate regularly, there seems to be ample opportunity for situation-dependent flexibility in mating behavior.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s002650100391</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000357"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;An even less complete performance of the prey-capturing behavior is commonly observed after the fish has devoured several crustacea in quick succession. The fish simply swims directly to the prey and takes it into its mouth. All intermediates are seen in the degree of completeness of prey-capturing behavior.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000357"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;This is necessary in order to distinguish the invariable fixed motor pattern of the activity from the variable orientating element, the taxis.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
