                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/posture"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-12-29T20:53:00.262148Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Posture that is coiled.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>coil</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>helical wrapping</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">coil posture</rdfs:label>
        <skos:example>&quot;...large-bodied Crotalus species that exhibited... loosely coiled body postures...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000007"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Posture that is coiled.</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
        <skos:scopeNote>&quot;Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000007"/>
