    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001619"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A tonicity which is relatively low.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATO:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001630 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000140"/>
        <oboInOwl:hasDefinition>Definition: A positional quality inhering in a bearer by virtue of the bearer&apos;s being distributed or spread over a considerable extent.</oboInOwl:hasDefinition>
        <rdfs:label>dispersed</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001632 -->

