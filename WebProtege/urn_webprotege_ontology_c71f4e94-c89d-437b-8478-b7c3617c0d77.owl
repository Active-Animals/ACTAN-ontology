    <!-- http://purl.obolibrary.org/obo/ACTAN_0000821 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000821">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000485"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002501"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-07T14:20:43.073849Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Copulation in which the ventral surface of the mounter makes contact with the other.

Grasping may be involved.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">mounting</oboInOwl:hasExactSynonym>
        <rdfs:label>mount copulation</rdfs:label>
        <skos:example>&quot;In many ungulates, males sometimes attack mating pairs, trying to dislodge males that are already mounting.&quot;</skos:example>
        <skos:example>&quot;The most striking feature of copulation in A. ibis is the low frequency and intensity of accompanying displays, which suggests that mutual inhibitions against body contact are minimal. Frequently a male mounts his mate and treads for a few seconds without achieving cloacal contact...&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000821"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Copulation in which the ventral surface of the mounter makes contact with the other.

Grasping may be involved.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
        <skos:scopeNote>&quot;Part of the ventral surface of the mounter is in contact with part of the dorsal surface of the other, and the mounter leans forward over the other, usually grasping him/her&quot;.</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000821"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">mounting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000821"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>mount copulation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000821"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In many ungulates, males sometimes attack mating pairs, trying to dislodge males that are already mounting.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000821"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The most striking feature of copulation in A. ibis is the low frequency and intensity of accompanying displays, which suggests that mutual inhibitions against body contact are minimal. Frequently a male mounts his mate and treads for a few seconds without achieving cloacal contact...&quot;</owl:annotatedTarget>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000822 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000822">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000485"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000927"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-07T14:21:13.401549Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Copulation in which coupling is disengaged.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">dismounting</oboInOwl:hasExactSynonym>
        <rdfs:label>dismount copulation</rdfs:label>
        <skos:example>&quot;Copulation in A. ibis is seldom preceded by displaying by either partner... After dismounting, they both perform body shakes then preen, usually paying no further attention to each other.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000822"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Copulation in which coupling is disengaged.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/j.1469-185X.2007.00029.x</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In Tephritidae, disengagement of the coupling occurs as the male dismounts and moves away end-to-end, pulling the phallus from the female aculeus.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000822"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">dismounting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1965</dc:date>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000822"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>dismount copulation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000822"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Copulation in A. ibis is seldom preceded by displaying by either partner... After dismounting, they both perform body shakes then preen, usually paying no further attention to each other.&quot;</owl:annotatedTarget>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    


