        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/gait"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-03T19:19:01.788211Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Traversing-gait in which all normal force contributing to static friction in the anchoring region of the concertina arises passively from the animal’s weight.

Substantial backward slipping can occur in the posterior region of the animal as more anterior regions are sliding forward.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">flat-surface concertina</oboInOwl:hasExactSynonym>
        <rdfs:label>flat-concertina gait</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000100"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000229"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Traversing-gait in which all normal force contributing to static friction in the anchoring region of the concertina arises passively from the animal’s weight.

Substantial backward slipping can occur in the posterior region of the animal as more anterior regions are sliding forward.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/icaa017</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000229"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">flat-surface concertina</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2020</dc:date>
        <dc:source>doi:10.1093/icb/icaa017</dc:source>
    </owl:Axiom>
