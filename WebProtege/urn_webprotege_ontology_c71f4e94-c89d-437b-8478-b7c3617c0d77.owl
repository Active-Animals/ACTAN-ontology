        <dc:source>http://researcharchive.vuw.ac.nz/handle/10063/9442</dc:source>
        <skos:scopeNote>&quot;...parallel (head to head).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000539"/>
