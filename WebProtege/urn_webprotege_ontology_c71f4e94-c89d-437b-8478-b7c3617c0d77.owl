        <oboInOwl:creation_date>2025-08-05T17:21:47.323651Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Expulsion in which air explodes out of a head orifice with limited control.

There may be a simultaneous jerk of the head.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>sneeze</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">sneezing</oboInOwl:hasExactSynonym>
        <rdfs:label>sneeze expulsion</rdfs:label>
        <skos:closeMatch>NBO:0000442</skos:closeMatch>
        <skos:example>&quot;Chimps sneeze in the same way as humans.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
