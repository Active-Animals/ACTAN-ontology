    <!-- http://purl.obolibrary.org/obo/ACTAN_0000737 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000737">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001592"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-06-10T09:16:44.74786Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Movement that increases axial curving.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">bending</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>curving</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>inclination</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>arching</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>coiling</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>contracting</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>flexing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>flexure</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>furling</oboInOwl:hasRelatedSynonym>
        <rdfs:label>bending movement</rdfs:label>
        <skos:example>&quot;During breeding, the male zebrafish approaches the female and curves body around, positioning his genital pore next to hers.&quot;</skos:example>
        <skos:example>&quot;Giraffes are the tallest of all extant land-living species. The extremely long neck, evolved to reach the canopies of savannah trees but constrained by the mammal anatomical limit of seven cervical vertebrae, makes challenging some movements, like bending down to drink...&quot;</skos:example>
        <skos:example>&quot;In Hebrus pusillus, the male bends his genitalia ventrally 180° (but without rotation along the longitudinal axis), again resulting in an inverse correlation between male and female genitalia.&quot;</skos:example>
    </owl:Class>
