    <!-- http://purl.obolibrary.org/obo/ACTAN_0000809 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000809">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001594"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002523"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000737"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-09-01T19:24:32.213653Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement that creates a partially circular, vertically positioned, profile.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>arch</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">arched</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">arching</oboInOwl:hasExactSynonym>
        <rdfs:label>arch placement</rdfs:label>
        <skos:example>&quot;...intertidal benthic gobies performed ASR in shallow water... in an arched position with the head tilted up...&quot;</skos:example>
        <skos:example>&quot;Occasionally a caterpillar, very similar fore and aft, in its efforts to extricate itself from a puddle, will violently bend from side to side so that the arch occurs centrally with no progressional movement at all.&quot;</skos:example>
        <skos:example>&quot;Submersible obtained photographs of B. viridensis reveal that the long pectoral fin rays are spread and arched forward to encircle the head.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
