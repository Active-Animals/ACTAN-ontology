        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000038"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">diodontiform gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000034"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003097"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-07T20:05:43.911989Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Vectoring-undulation gait that involves the back nearly vertical, and the dorsal fin posteriorly positioned.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">seahorse gait</rdfs:label>
        <skos:example>&quot;Hippocampus hudsonius which usually moves with the backbone in a nearly vertical position is necessarily modified accordingly. In rising or falling in the water appropriate localized undulations in the dorsal give the desired motion on account of its position.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000039"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Vectoring-undulation gait that involves the back nearly vertical, and the dorsal fin posteriorly positioned.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.5962/p.203769</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;...“Caudal undulation&apos;&apos;, not of great importance to any fish. This, at times, is similar to the dorsal movements of Hippocampus, and with it completes the list of every known fundamental motion.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000039"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">seahorse gait</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000039"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Hippocampus hudsonius which usually moves with the backbone in a nearly vertical position is necessarily modified accordingly. In rising or falling in the water appropriate localized undulations in the dorsal give the desired motion on account of its position.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000738"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000151"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-12T07:22:23.775029Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Abducting in which a pectoral fin is moving away from the body.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">pectoral extending</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">pectoral-fin abducting</rdfs:label>
        <skos:example>&quot;In Tilapia natalensis the pectoral fins consist of 13 soft furcated fin rays... Contraction of the m. abductores as a whole operates the fin erect &quot;in line&quot;; the fin advances as a flat plane.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000040"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Abducting in which a pectoral fin is moving away from the body.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1242/jeb.204.8.1459</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Pectoral fin-beat cycles started with the fins pressed against the body (maximally adducted), moving away (abducting) from the body to some maximum point of excursion and returning (adducting) to the original position.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000040"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">pectoral extending</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...extending a single pectoral...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000040"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">pectoral-fin abducting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1242/jeb.204.8.1459</dc:source>
        <skos:scopeNote>&quot;Pectoral fin-beat cycles started with the fins pressed against the body (maximally adducted), moving away (abducting) from the body to some maximum point of excursion...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000040"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;In Tilapia natalensis the pectoral fins consist of 13 soft furcated fin rays... Contraction of the m. abductores as a whole operates the fin erect &quot;in line&quot;; the fin advances as a flat plane.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000041 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000039"/>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-06T20:33:45.814629Z</oboInOwl:creation_date>
        <rdfs:comment>This class is a temporary placeholder until it a new term request is accepted by an external ontology. This term will then be obsoleted in favour of that external new term.</rdfs:comment>
        <rdfs:label xml:lang="en">sideways</rdfs:label>
        <skos:scopeNote>&quot;(decapod crustaceans) typically use octapedal locomotion and walk sideways&quot;</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000042 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001023"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-01T21:22:45.531016Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics in which horizontal locomotion continues without propulsion, and with a reduced drag profile.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">coast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>coasting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>glide</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">coast kinetics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000253"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000574"/>
        <skos:example>&quot;...in bluegill sunfish, Lepomis macrochirus...
...forward movement of the fish with the caudal fin rays adducted to reduce surface area and with the tail held in line with the body.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000042"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics in which horizontal locomotion continues without propulsion, and with a reduced drag profile.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1093/icb/41.2.137</dc:source>
    </owl:Axiom>
