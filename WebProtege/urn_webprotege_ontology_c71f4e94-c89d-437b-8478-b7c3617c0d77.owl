The body bobs up and down as elbows are flexed and straightened.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000985 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000985">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000982"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-16T10:50:30.793561Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Bob that alternately fixes the head position and moves it rapidly forward while the body moves forward continuously.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>head bobbing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>intermittent head locomotion</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">stabilizing bob</rdfs:label>
        <skos:scopeNote>&quot;Head movements relative to the body can also stabilize the visual field.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000985"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Bob that alternately fixes the head position and moves it rapidly forward while the body moves forward continuously.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/41.2.137</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Many birds with mobile necks alternately fix the head position and move it rapidly forward while the body moves forward continuously.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000985"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>head bobbing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1093/icb/41.2.137</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000985"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>intermittent head locomotion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1093/icb/41.2.137</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000985"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">stabilizing bob</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
