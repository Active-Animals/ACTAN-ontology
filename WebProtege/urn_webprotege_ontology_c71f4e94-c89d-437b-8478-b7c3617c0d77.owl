    <!-- http://purl.obolibrary.org/obo/ACTAN_0000727 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000727">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001230"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-27T15:15:24.405667Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that vertically accelerates a mass against gravity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>raising</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>hauling</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>hoisting</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>elevation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lift</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">lifting</oboInOwl:hasRelatedSynonym>
        <rdfs:label>raising kinetics</rdfs:label>
        <skos:example>&quot;...each aphis, as soon as it felt the antennæ, immediately lifted up its abdomen and excreted a limpid drop of sweet juice, which was eagerly devoured by the ant.&quot;</skos:example>
        <skos:example>&quot;Nocomis leptocephalus...
seized a pebble with his jaws, lifted his head and swam forward...&quot;</skos:example>
        <skos:example>&quot;Plethodon shermani. The female has stopped over the spermatophore and is lowering her cloaca over it. The male lifting his tail base under the female’s chin as she removes the sperm cap from the spermatophore..&quot;</skos:example>
    </owl:Class>
