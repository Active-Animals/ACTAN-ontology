    <!-- http://purl.obolibrary.org/obo/ACTAN_0000486 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000486">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001023"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-21T10:36:38.32217Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics that extracts momentum from environmental vortices.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>extracting energy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>recycled energy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>slipping</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">recycling kinetics</rdfs:label>
        <skos:scopeNote>&quot;The habit that many smaller fishes have of following larger ones.. may among other advantages, enable them to slip along with less effort than they would otherwise have to make... In a similar manner it would seem probable the lagging members of a school dropping behind from fatigue or exhaustion would be unconsciously helped along by their more sturdy brothers swimming in the van.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000486"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics that extracts momentum from environmental vortices.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1242/jeb.020263</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Since the energy (or momentum) involved in the circulation of the shed vortex was imparted by the fish, the energy was thus probably recycled on trapping the fluid mass, which is functionally similar to the vortex-based extraction of energy by aquatic animals that extracts energy from environmental vortices.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000486"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>extracting energy</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2008</dc:date>
        <dc:source>doi:10.1242/jeb.020263</dc:source>
        <skos:scopeNote>&quot;...extracts energy...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000486"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>recycled energy</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2008</dc:date>
        <dc:source>doi:10.1242/jeb.020263</dc:source>
        <skos:scopeNote>&quot;...energy was thus probably recycled...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000486"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>slipping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000486"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">recycling kinetics</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000486"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The habit that many smaller fishes have of following larger ones.. may among other advantages, enable them to slip along with less effort than they would otherwise have to make... In a similar manner it would seem probable the lagging members of a school dropping behind from fatigue or exhaustion would be unconsciously helped along by their more sturdy brothers swimming in the van.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000487 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000487">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000569"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001350"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-21T12:57:03.995056Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Fast turning that moves abruptly to one side without braking.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>swerving</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">swerve turning</rdfs:label>
        <skos:example>&quot;...when a cheetah chases a blackbuck at 100 km/hr over low vegetation and scattered small rocks, instantly matching every swerve of the prey, the marked variation from stride to stride is evidence of fine tuning almost beyond belief.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000487"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Fast turning that moves abruptly to one side without braking.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.5962/p.203769</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;On this account, sharks are unable to make an abrupt stop, swerving to one side of an obstacle instead, for they are unable to use the pectorals or any other members as “brakes.”&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000487"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>swerving</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000487"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">swerve turning</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000487"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...when a cheetah chases a blackbuck at 100 km/hr over low vegetation and scattered small rocks, instantly matching every swerve of the prey, the marked variation from stride to stride is evidence of fine tuning almost beyond belief.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000488 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000488">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000152"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-21T13:47:18.563654Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Twisting that involves a pelvic fin.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>pelvic warping</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">pelvic-fin twisting</rdfs:label>
        <skos:example>&quot;Cypselurus sp. and related^ “four-winged” forms doubtless have better control of their flight than the “two-winged” species, Halocypselurus, for the reason that the pelvics, which serve as posterior warping planes, give them more purchase for their limited amount of maneuvering.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000488"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Twisting that involves a pelvic fin.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000488"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pelvic warping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...pelvics, which serve as posterior warping planes...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000488"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">pelvic-fin twisting</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000488"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Cypselurus sp. and related^ “four-winged” forms doubtless have better control of their flight than the “two-winged” species, Halocypselurus, for the reason that the pelvics, which serve as posterior warping planes, give them more purchase for their limited amount of maneuvering.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000489 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000489">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000605"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000151"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-21T13:47:38.861376Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Twisting that rotates the leading edge of a pectoral fin.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>pectoral fin refraction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pectoral warping</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">pectoral-fin twisting</rdfs:label>
        <skos:example>&quot;Prionotus evolans and carolinus when ceasing active swimming generally extend their large pectorals and the weight of the fish (although it possesses a swim-bladder) which is heavier than the water generally, enables them to glide forward at will, wheeling about by “warping” the planes.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000489"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Twisting that rotates the leading edge of a pectoral fin.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1109/48.757275</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;...during refraction, the fin is orientated to its original position by rotation of the leading edge.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000489"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pectoral fin refraction</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1109/48.757275</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000489"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pectoral warping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...warping of the pectorals...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000489"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">pectoral-fin twisting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...pectorals can... by proper twisting...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000489"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Prionotus evolans and carolinus when ceasing active swimming generally extend their large pectorals and the weight of the fish (although it possesses a swim-bladder) which is heavier than the water generally, enables them to glide forward at will, wheeling about by “warping” the planes.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


