    <!-- http://purl.obolibrary.org/obo/ACTAN_0000867 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000867">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000513"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001718"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/colouration"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-03T17:13:06.847749Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Colouration that gains brilliance.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>contrast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>brightening</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>darkening</oboInOwl:hasNarrowSynonym>
        <rdfs:label>contrast colouration</rdfs:label>
        <skos:example>&quot;Aequidens latifrons...
When the fish is, for instance, displaying, spawning, or caring for young, the cross bars are intensely dark while the background is nearly white. In the nonreproductive markings the contrast between the bands and the intermediate zones is far less, the bands being lighter and the background darker coloured.&quot;</skos:example>
        <skos:example>&quot;Zebrafish...
Lateral display: Two fish line up parallel to each other head to tail, raise their dorsal fins (fin raise), extend their caudal fins, darken in color (body color change), and swim in circles (circling), often ascending.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000867"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Colouration that gains brilliance.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000867"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>contrast</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000867"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>brightening</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000867"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>darkening</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
