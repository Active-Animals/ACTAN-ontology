        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_life_cycle"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-03T19:38:30.513277Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Development that involves prolonged flapping of the wings, while the animal remains more or less in the same place.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>exercise wing-flapping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">wing-exercise</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">wing-exercise development</rdfs:label>
        <skos:example>&quot;Ardeola ibis...
From 20 days onwards nestlings frequently perform exercise wing-flapping (first seen at 14 days). The bird walks to the edge of its tree and vigorously flaps its wings for a few seconds while holding onto the perch.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000775"/>
