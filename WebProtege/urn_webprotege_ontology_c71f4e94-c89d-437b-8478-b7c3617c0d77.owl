        <owl:annotatedTarget>chemical stimulus</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000416"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>semiochemical communication</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.1016/j.cub.2022.06.072</dc:source>
        <skos:scopeNote>&quot;...communicate, and manipulate each other, via semiochemicals...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000416"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>pheromone</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000416"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>semiochemical modality</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000416"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;It has been shown in Lebistes reticulatus (Peters) and in Rhodeus amarus Boch that the males produces hormones which, when absorbed by the females via the surrounding water, promote the ripening of the ovaries.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000416"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Given the prevalence of noise in most every channel of communication – and the increasing presence of human noise in non-human animal communication – more research on signal and cue perception in the contexts of acoustic, chemical, visual noise is needed.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.3389/fetho.2022.1066186</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000416"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;There is also evidence that alarm pheromones found in the discharge might serve to warn conspecifics of a predator threat, parallel to the shreckstoff found in fishes and chemical communication of stress found in larval salamanders and tadpoles.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000417 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000097"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ZFA_0000298"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:28:21.400859Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Exudation that involves cloacal sac musk discharge.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">musking</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">musk exudation</rdfs:label>
        <skos:scopeNote>&quot;Musking, or cloacal discharge, is a common defensive behavior across many snake taxa that involves the release of a foul-smelling secretion from the cloacal glands, often accompanied by feces and urates, to render the snake unappetizing to potential predators.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000417"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Exudation that involves cloacal sac musk discharge.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000417"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">musking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2014</dc:date>
        <dc:source>doi:10.17161/jnah.vi1.11892</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000417"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">musk exudation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000417"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Musking, or cloacal discharge, is a common defensive behavior across many snake taxa that involves the release of a foul-smelling secretion from the cloacal glands, often accompanied by feces and urates, to render the snake unappetizing to potential predators.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.17161/jnah.vi1.11892</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000418 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000410"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PCO_0000029"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:28:58.448228Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Indirect-sample that attends to the signals of other species.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">eavesdropping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>social foraging</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">eavesdrop indirect-sample</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000418"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Indirect-sample that attends to the signals of other species.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.3389/fetho.2022.1066186</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;We do know that individuals regularly eavesdrop – they perceive and attend to the signals of other species...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000418"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">eavesdropping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.3389/fetho.2022.1066186</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000418"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>social foraging</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1988</dc:date>
        <dc:source>doi:10.1126/science.239.4847.1525</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000418"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">eavesdrop indirect-sample</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000419 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000419">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000117"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000925"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:31:14.02616Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>tactile communication</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>tactile cue</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Modality that is transmitted directly by contact movement.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>tactile interaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tactile sensory stimulus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tactile sign stimulus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">tactile signal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>touch signal</oboInOwl:hasExactSynonym>
        <rdfs:label>touch modality</rdfs:label>
        <skos:example>&quot;...the territorial Mediterranean rainbow wrasse, Coris julis, which joins producer—scrounger aggregations with a goatfish species, Mullus surmuletus, that disturbs benthic prey during foraging. Wrasse remained within their territories and did not follow producers beyond these boundaries but repeatedly engaged in tactile interactions (brief physical contact using their ventral side and pelvic fins or caudal fin) with goatfish while they were present. Events involving tactile interactions were associated with longer feeding durations of goatfish and therefore, indirectly, a higher overall food uptake for wrasse.&quot;</skos:example>
        <skos:scopeNote>&quot;Elaborate courtship behaviours – often involving visual cues – have been described for various groups of salamanders, mammals, birds and fishes while olfactory and tactile signals are particularly important for many mammal species and songs and calls for the mating behaviour of birds and anurans.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;One type of tactile signal apparently ubiquitous in spiders is rhythmical movements of the genitalia during copulation, either in the form of repeated insertions and withdrawals or as rhythmic movements during insertion.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000419"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>tactile communication</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2003</dc:date>
        <dc:source>ISBN:9781482294347</dc:source>
        <skos:scopeNote>&quot;...communication by... tactile mechanisms...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000419"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>tactile cue</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2000</dc:date>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000419"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
