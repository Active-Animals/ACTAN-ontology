    <!-- http://purl.obolibrary.org/obo/ACTAN_0000116 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000113"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000427"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-17T14:54:08.300445Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>grinding</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Bite which repeatedly crushes an item between mouthparts.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">chewing</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">chew bite</rdfs:label>
        <skos:closeMatch>NBO:0000073</skos:closeMatch>
        <skos:example>&quot;Paper wasps, for example, chew up wood and mix it with their saliva to produce the paper from which they build their nests.&quot;</skos:example>
        <skos:example>&quot;While lacking an upper pharyngeal jaw, zebrafish can chew their food by grinding the teeth in their lower jaw against a chewing pad on the base of the skull.&quot;</skos:example>
        <skos:example>&quot;Wood-feeding cockroaches (Salganea taiwanensis) mate and live as pairs; quite notably, after choosing a mate, paired cockroaches chew off each other’s wings. After cannibalizing their pair mate’s non-fleshy wings, paired individuals mate and produce multiple cycles of offspring that are cared for by both parents.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000116"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>grinding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1973</dc:date>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000116"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Bite which repeatedly crushes an item between mouthparts.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000116"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">chewing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000116"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">chew bite</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000116"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Paper wasps, for example, chew up wood and mix it with their saliva to produce the paper from which they build their nests.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.cub.2021.09.082</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000116"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;While lacking an upper pharyngeal jaw, zebrafish can chew their food by grinding the teeth in their lower jaw against a chewing pad on the base of the skull.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000116"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Wood-feeding cockroaches (Salganea taiwanensis) mate and live as pairs; quite notably, after choosing a mate, paired cockroaches chew off each other’s wings. After cannibalizing their pair mate’s non-fleshy wings, paired individuals mate and produce multiple cycles of offspring that are cared for by both parents.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/j.yhbeh.2021.105062</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000117 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000414"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000078"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-05-25T19:59:26.738301Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Signal that works via a particular sensory channel of communication.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>modality</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>multimodal communication</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">modality signal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000117"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Signal that works via a particular sensory channel of communication.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1017/S1464793104006700</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;I will first focus on female choice and male competition working in the various sensory modalities, with the main conclusion that sexual selection in spiders may predominantly work via channels of communication that are not as easily accessible to the human observer as bird plumage, mammal weapons, and insect stridulation.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000117"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>modality</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2005</dc:date>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000117"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>multimodal communication</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2005</dc:date>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
        <skos:scopeNote>&quot;...spider communication also tends to be multimodal...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000117"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">modality signal</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000046"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-05-26T12:56:19.016085Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>behavioral complex</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Behaviour in which a specific combination of activities is characteristic of a particular taxon.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>ethotype</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>display</oboInOwl:hasNarrowSynonym>
        <rdfs:comment>This branch has the potential to overwhelm this ontology, being comprised of a potentially overwhelming number of activity combinations, for different contexts, in different taxa. It might form the root of a future ontology of its own. For now, it contains a small handful of uncategorised example subclasses. NO NEW SUBCLASSES should be added before a strategic approach has been agreed.</rdfs:comment>
        <rdfs:label xml:lang="en">ethotype behaviour</rdfs:label>
        <skos:example>&quot;...in the nest-building minnows, the bluehead chub, Nocomis leptocephalus, and river chub, N. micropogon... a precise sequence of male-female interactions that coordinated a successful spawn. Reproductive behaviors were classified into six sequential categories (interim, approach, alignment, run, clasp, dissociation)...&quot;</skos:example>
        <skos:example>&quot;The Cervidae ancestral ethotype would correspond to an animal who never beats the ground with hindlimbs, who shakes his body, who never digs with forelimbs, who scratches his forelimb with hindlimb, who licks or smells the hindlimbs of its fellows, who avoids fellow by stotting or running, and shakes head during play with a fellow.&quot;</skos:example>
        <skos:example>&quot;The rock-thrush of Guiana, birds of Paradise, and some others, congregate; and successive males display their gorgeous plumage and perform strange antics before the females, which standing by as spectators, at last choose the most attractive partner.&quot;</skos:example>
        <skos:scopeNote>&quot;...the &quot;ritualized&quot; activities or &quot;displays&quot;; i.e. those peculiarly standardized and often exaggerated performances, including all vocalizations and many movements and postures, which have become specialized and modified as social signals...&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>behavioral complex</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2003</dc:date>
        <dc:source>ISBN:9781482294347</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Behaviour in which a specific combination of activities is characteristic of a particular taxon.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1080/08927014.2002.9522740</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>ethotype</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>doi:10.1080/08927014.2002.9522740</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>display</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>This branch has the potential to overwhelm this ontology, being comprised of a potentially overwhelming number of activity combinations, for different contexts, in different taxa. It might form the root of a future ontology of its own. For now, it contains a small handful of uncategorised example subclasses. NO NEW SUBCLASSES should be added before a strategic approach has been agreed.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">ethotype behaviour</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...in the nest-building minnows, the bluehead chub, Nocomis leptocephalus, and river chub, N. micropogon... a precise sequence of male-female interactions that coordinated a successful spawn. Reproductive behaviors were classified into six sequential categories (interim, approach, alignment, run, clasp, dissociation)...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The Cervidae ancestral ethotype would correspond to an animal who never beats the ground with hindlimbs, who shakes his body, who never digs with forelimbs, who scratches his forelimb with hindlimb, who licks or smells the hindlimbs of its fellows, who avoids fellow by stotting or running, and shakes head during play with a fellow.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1080/08927014.2002.9522740</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The rock-thrush of Guiana, birds of Paradise, and some others, congregate; and successive males display their gorgeous plumage and perform strange antics before the females, which standing by as spectators, at last choose the most attractive partner.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000118"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...the &quot;ritualized&quot; activities or &quot;displays&quot;; i.e. those peculiarly standardized and often exaggerated performances, including all vocalizations and many movements and postures, which have become specialized and modified as social signals...&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/4081601</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000446"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001303"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-05-26T14:42:10.982165Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Performance that conveys information about a situation by resembling certain aspects of that situation.

Put more abstractly: if there is a structuring-preserving map from the form of the expression to situations it is true of.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>iconic communication</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>iconic expression</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>iconic signal</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">icon performance</rdfs:label>
        <skos:example>&quot;The most striking example of iconic communication in the animal world involves the waggle dance of bees.&quot;</skos:example>
        <skos:scopeNote>&quot;Iconicity has some &apos;bite&apos; only to the extent that the form can be modified (often gradiently) and yield corresponding changes to the meaning.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000119"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Performance that conveys information about a situation by resembling certain aspects of that situation.

Put more abstractly: if there is a structuring-preserving map from the form of the expression to situations it is true of.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/s10988-025-09438-8</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;By definition, an expression is iconic if it conveys information about a situation by resembling certain aspects of that situation, or more abstractly: if there is a structuring-preserving map from the form of the expression to situations it is true of.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000119"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>iconic communication</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2025</dc:date>
        <dc:source>doi:10.1007/s10988-025-09438-8</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000119"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>iconic expression</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2025</dc:date>
        <dc:source>doi:10.1007/s10988-025-09438-8</dc:source>
        <skos:scopeNote>&quot;...expression is iconic...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000119"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>iconic signal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2025</dc:date>
        <dc:source>doi:10.1007/s10988-025-09438-8</dc:source>
        <skos:scopeNote>&quot;...these signals are genuinely iconic...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000119"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">icon performance</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000119"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The most striking example of iconic communication in the animal world involves the waggle dance of bees.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10988-025-09438-8</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000119"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Iconicity has some &apos;bite&apos; only to the extent that the form can be modified (often gradiently) and yield corresponding changes to the meaning.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s10988-025-09438-8</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000120 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002404"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000732"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/placement_by_movement"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-17T15:02:29.39842Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Placement that results from flexing.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>flexion</oboInOwl:hasExactSynonym>
        <rdfs:label>flexion placement</rdfs:label>
        <skos:example>&quot;For example when the kangaroo decelerates downward and forward, its feet are flexed so that the Achilles tendons are stretched storing elastic energy.&quot;</skos:example>
        <skos:scopeNote>&quot;The dorsal fin collapses from front to rear, and is erected in reverse order, from posterior to anterior.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Undulating flight is a special form of intermittent locomotion and involves gliding with flexed wings interspersed with active flapping.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000120"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Placement that results from flexing.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000120"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>flexion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1980</dc:date>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000120"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>flexion placement</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000120"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;For example when the kangaroo decelerates downward and forward, its feet are flexed so that the Achilles tendons are stretched storing elastic energy.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000120"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The dorsal fin collapses from front to rear, and is erected in reverse order, from posterior to anterior.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000120"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Undulating flight is a special form of intermittent locomotion and involves gliding with flexed wings interspersed with active flapping.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1038/ncomms1350</dc:source>
    </owl:Axiom>
    


