    <!-- http://purl.obolibrary.org/obo/ACTAN_0000225 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000225">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000093"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000546"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-03T19:17:08.003054Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Traversing-gait that involves minimal excursions of the centre of mass (COM) in directions other than forward, three points of contact with the ground at any given time forming a polygonal support pattern, the vertical projection of the COM onto the surface that lies within its support pattern at the given time, and has static stability at all times.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">creeping</oboInOwl:hasExactSynonym>
        <rdfs:label>creeping gait</rdfs:label>
        <skos:scopeNote>&quot;This form of locomotion has been described in hemichordates, echinoderms, snakes, infant rodents,molluscs, reptiles and amphibians.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000225"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Traversing-gait that involves minimal excursions of the centre of mass (COM) in directions other than forward, three points of contact with the ground at any given time forming a polygonal support pattern, the vertical projection of the COM onto the surface that lies within its support pattern at the given time, and has static stability at all times.</owl:annotatedTarget>
        <rdfs:comment>&quot;Creep
A broad category of walking-like locomotion characterized by (1) very slow speeds, (2) minimal excursions of the COM in directions other than the forward direction, (3) three points of contact with the ground at any given time forming a polygonal Support Pattern, (4) the vertical projection of the COM onto the surface that lies within its Support Pattern at the given time, and (5) has static stability at all times,meaning the animal could halt movement and remain stable at any point in time.&quot;</rdfs:comment>
        <rdfs:isDefinedBy>doi:10.1093/icb/icac125</rdfs:isDefinedBy>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000225"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">creeping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000225"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>creeping gait</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1968</dc:date>
        <dc:source>https://apps.dtic.mil/sti/html/tr/AD0675256/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000225"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;This form of locomotion has been described in hemichordates, echinoderms, snakes, infant rodents,molluscs, reptiles and amphibians.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000226 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000226">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000142"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002035"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-02T08:59:26.866685Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Contralateral-bipodal pattern that involves the footfall formula of right hind–right front–(pause)–left hind–left front.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">LSDC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lateral sequence, diagonal couplet</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">LSDC pattern</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000226"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Contralateral-bipodal pattern that involves the footfall formula of right hind–right front–(pause)–left hind–left front.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/icb/icac125</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;LSDC walk
A form of true walking characterized by (1) the footfall formula of right hind–right front–(pause)–left hind–left front, and (2) the animal spends most of its time supported on diagonal pairs of limbs (such as the right hind and left front). This is the most common pattern for slow moving mammals, and potentially other tetrapods as well.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000226"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">LSDC</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2022</dc:date>
        <dc:source>doi:10.1093/icb/icac125</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000226"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>lateral sequence, diagonal couplet</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1980</dc:date>
        <dc:source>doi:10.1093/icb/20.1.255</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000226"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">LSDC pattern</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


