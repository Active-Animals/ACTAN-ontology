    <!-- http://purl.obolibrary.org/obo/ACTAN_0000680 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000680">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000715"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000167"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-04T20:03:16.681903Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>squirting</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Expulsion in which a counter-current of water is flushed through the buccal cavity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>expelling water</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spit</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spitting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spitting-out</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>blowing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>coughing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">flushing</oboInOwl:hasRelatedSynonym>
        <rdfs:label>spit expulsion</rdfs:label>
        <skos:example>&quot;After mating, T. albomaculosus... males stayed there to care for the eggs... The frequencies of parental care behaviors (in bouts per 10 min) were... 0.66 (sucking and spitting)...&quot;</skos:example>
        <skos:example>&quot;Mulloides fiavolineatus... may back off from an item discovered by the barbels and &quot;blow&quot; away sand to uncover it (pers. obs.);&quot;</skos:example>
        <skos:example>&quot;Mullus surmuletus on occasion ploughs up the mud with its snout in feeding and apparently expels water from its mouth while doing so.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000680"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>squirting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000680"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Expulsion in which a counter-current of water is flushed through the buccal cavity.</owl:annotatedTarget>
        <rdfs:isDefinedBy>http://www.nativefishlab.net/library/textpdf/15582.pdf</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Apparently a counter-current of water is flushed through the buccal cavity.&quot;</skos:scopeNote>
    </owl:Axiom>
