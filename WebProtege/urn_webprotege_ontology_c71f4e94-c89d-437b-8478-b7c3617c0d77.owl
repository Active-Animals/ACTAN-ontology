    <!-- http://purl.obolibrary.org/obo/ACTAN_0000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000176"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000179"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-12-30T11:54:30.341593Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Locomotion which involves the boundary between physical habitat types.

These are primarily land–water, land–air, and air–water.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>cross-medium locomotion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mode transition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>gait transitioning</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>habitat interface</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>multi-modal locomotion</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">interfacing locomotion</rdfs:label>
        <skos:example>&quot;The best known gliders amongst mammals are found in three main groups; the flying squirrels (subfamily Petauristinae), the flying phalangers (Acrobates and Petaurus) and the flying lemurs (Cynocephalus)... All the gliding mammals are arboreal in nature, and utilize their gliding ability to travel from tree to tree... Whereas the flying squirrels and the flying phalangers remain relatively competent in terrestrial modes of locomotion, the flying lemurs, which have the most evolved patagium, spanning the entire body, resort to a crude hopping mechanism on land.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000012"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Locomotion which involves the boundary between physical habitat types.

These are primarily land–water, land–air, and air–water.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1007/978-3-319-68576-2_3</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Where obvious transitions between the primary physical habitat types (land–water, land–air, air–water) have received some attention, the ecology of land–water interfaces dominates. Land–air and air–water interfaces are considered hard boundaries with comparatively abrupt transitions.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000012"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>cross-medium locomotion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2023</dc:date>
        <dc:source>doi:10.1007/s42235-023-00418-x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000012"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>mode transition</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1088/1748-3182/9/1/011001</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000012"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>gait transitioning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1088/1748-3182/9/1/011001</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000012"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>habitat interface</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1973</dc:date>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000012"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>multi-modal locomotion</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1088/1748-3182/9/1/011001</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000012"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">interfacing locomotion</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000012"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;The best known gliders amongst mammals are found in three main groups; the flying squirrels (subfamily Petauristinae), the flying phalangers (Acrobates and Petaurus) and the flying lemurs (Cynocephalus)... All the gliding mammals are arboreal in nature, and utilize their gliding ability to travel from tree to tree... Whereas the flying squirrels and the flying phalangers remain relatively competent in terrestrial modes of locomotion, the flying lemurs, which have the most evolved patagium, spanning the entire body, resort to a crude hopping mechanism on land.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1088/1748-3182/9/1/011001</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000149"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000648"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/manoeuvre"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-06-21T15:36:09.276345Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Manoeuvre that involves movement about an axis.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>rotation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">rotating manoeuvre</rdfs:label>
        <skos:closeMatch>NBO:0009001</skos:closeMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000013"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Manoeuvre that involves movement about an axis.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1242/jeb.204.8.1459</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Rotational recoil is rotatory movements about an axis that passes through the center of mass.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000013"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>rotation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000013"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">rotating manoeuvre</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000716"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-06T16:39:49.683824Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Sweeping that involves large lateral excursions of the anterior trunk while the posterior trunk remains relatively static.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>side to side head thrust</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">head sweeping</rdfs:label>
        <skos:example>&quot;Workers have noted similarities in fishing behavior across a diversity of snake groups, including natricines, homalopsines, elapids and viperids, the most notable being that aquatic prey are typically captured using a lateral sweep of the head.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000014"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">head sweeping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2003</dc:date>
        <dc:source>doi:10.1242/jeb.00424</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000014"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Workers have noted similarities in fishing behavior across a diversity of snake groups, including natricines, homalopsines, elapids and viperids, the most notable being that aquatic prey are typically captured using a lateral sweep of the head.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1242/jeb.00424</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000014"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Sweeping that involves large lateral excursions of the anterior trunk while the posterior trunk remains relatively static.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1242/jeb.00424</rdfs:isDefinedBy>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000014"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>side to side head thrust</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...thrust the head from side to side...&quot;</skos:scopeNote>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000015">
