    <!-- http://purl.obolibrary.org/obo/ACTAN_0000409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000383"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000110"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-11T17:14:29.508889Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Interaction which involves a communal association of animals frequenting a shared habitat.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">community</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>participating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>participation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">participation interaction</rdfs:label>
        <skos:scopeNote>&quot;Some taxa—particularly snakes—often travel several kilometers from activity season ranges to return to the same hibernaculum each winter. Several high-latitude species also overwinter communally, resulting in large multi-species congregations in a hibernaculum.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000409"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Interaction which involves a communal association of animals frequenting a shared habitat.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1007/BF01609520</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000409"/>
