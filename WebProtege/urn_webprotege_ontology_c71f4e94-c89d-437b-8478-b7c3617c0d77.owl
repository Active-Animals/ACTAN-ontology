            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-15T08:55:43.032602Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Relativity that is directed one way, with a repetitive turn angle and angular velocity.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">circling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>looping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>wheeling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>curving</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>encircling</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>spiralling</oboInOwl:hasNarrowSynonym>
        <rdfs:label>circling relativity</rdfs:label>
        <skos:closeMatch>NBO:0050002</skos:closeMatch>
        <skos:example>&quot;Thalassoma cupido...
...the male swims... in a roughly circular path above the female... may turn tight semicircles around the female, displaying alternately to her left and right sides.&quot;</skos:example>
        <skos:scopeNote>&quot;Male circling female in a gliding motion, head and thorax leading the change of direction with abdomen bent at an angle.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;Migrating birds drawn into circling illuminated communications towers, particularly those with guy wires, in low cloud conditions die in large numbers.&quot;</skos:scopeNote>
    </owl:Class>
