    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000327 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000288"/>
