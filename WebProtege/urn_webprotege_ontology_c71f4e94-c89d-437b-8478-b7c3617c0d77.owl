        <owl:annotatedTarget>&quot;...gobies on D. gemmacea could take advantage of its complex multiple-branching structure to confuse predators and avoid detection by switching from one branch to another.&quot;</owl:annotatedTarget>
        <dc:source>https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000453"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Greene (1973) categorized defensive tail displays of snakes into three major functions: 1) to divert attack toward the tail, 2) to inhibit attack with an aposematic display, and 3) to disorient the predator with a flash display.&quot;</owl:annotatedTarget>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
