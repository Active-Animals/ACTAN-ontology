    <!-- http://purl.obolibrary.org/obo/ACTAN_0000424 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000424">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000089"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000233"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000645"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000929"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:37:42.677843Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Traversing-regime which changes its precursor movements, including exaggerating their nature, changing its speed of performance, developing rhythmic repetition, and changing its coordination.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">dancing</oboInOwl:hasExactSynonym>
        <rdfs:label>dance regime</rdfs:label>
        <skos:example>&quot;Ballerina dance.—The quintessential high intensity Parotia display. Flank plumes are positioned around the body in a manner resembling a ballerina’s tutu as the bird performs an intricate dance. There are 23 elements, five phases, and three versions.&quot;</skos:example>
        <skos:example>&quot;For example, Hammer (1941) observed individuals of Sepsis duplicata performing an elegant minuet-like dance, with males repeatedly angling themselves towards the females and the females responding likewise.&quot;</skos:example>
        <skos:scopeNote>&quot;...a given rendition of the ballerina dance may terminate abruptly before being expressed to completion, but the abrupt end is always at a phase “break.”&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000424"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Traversing-regime which changes its precursor movements, including exaggerating their nature, changing its speed of performance, developing rhythmic repetition, and changing its coordination.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.2307/4083155</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Changes in the nature of the movement, such as exaggeration, and changes in speed of performance as compared with the precursor also occur. Rhythmic repetition may develop, as in the &quot;dancing&quot; movements of estrildine finches. There are also often changes in coordination as, for example, the simultaneous occurrence of a component of the first phase of take-off (crouching) and one from the second (tail lowering).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000424"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">dancing</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000424"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>dance regime</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000424"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Ballerina dance.—The quintessential high intensity Parotia display. Flank plumes are positioned around the body in a manner resembling a ballerina’s tutu as the bird performs an intricate dance. There are 23 elements, five phases, and three versions.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/auk/123.4.967</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000424"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;For example, Hammer (1941) observed individuals of Sepsis duplicata performing an elegant minuet-like dance, with males repeatedly angling themselves towards the females and the females responding likewise.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000424"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...a given rendition of the ballerina dance may terminate abruptly before being expressed to completion, but the abrupt end is always at a phase “break.”&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/auk/123.4.967</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000425 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000425">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000117"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000094"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:37:57.931868Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Modality that communicates using the frequency, temporal pattern, and intensity of sounds.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">acoustic signal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>auditory signal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sound</oboInOwl:hasExactSynonym>
        <rdfs:label>sound modality</rdfs:label>
        <skos:example>&quot;Most of the evidence for sexual selection acting on spider acoustic signals comes from studies on a lycosid, Hygrolycosa rubrofasciata. Males of this species produce drums by vibrating the abdomen against the ground, preferably on dry leaves. The resulting signal can be heard from a distance of up to several meters (by humans).&quot;</skos:example>
        <skos:scopeNote>&quot;In addition to visual displays, many acoustic and olfactory breeding signals are transmitted through the air, including an assortment of vocalizations, stridulations, airborne pheromones, and pollinator attractors. Many of these signals evolved characteristics that allow them to travel efficiently through the air to receivers, taking forms that propagate with minimal degradation.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000425"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Modality that communicates using the frequency, temporal pattern, and intensity of sounds.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1111/eth.12882</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;In the sand goby (Pomatoschistus minutus), the frequency and temporal pattern of sounds are thought to communicate species identity, whereas call intensity and the visual part of male courtship are more relevant for female choice.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000425"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">acoustic signal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2005</dc:date>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000425"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>auditory signal</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">doi:10.1007/s00265-010-0980-6</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000425"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>sound</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2002</dc:date>
        <dc:source>https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&amp;cbl=18750&amp;diss=y</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000425"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>sound modality</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000425"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Most of the evidence for sexual selection acting on spider acoustic signals comes from studies on a lycosid, Hygrolycosa rubrofasciata. Males of this species produce drums by vibrating the abdomen against the ground, preferably on dry leaves. The resulting signal can be heard from a distance of up to several meters (by humans).&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1017/S1464793104006700</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000425"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In addition to visual displays, many acoustic and olfactory breeding signals are transmitted through the air, including an assortment of vocalizations, stridulations, airborne pheromones, and pollinator attractors. Many of these signals evolved characteristics that allow them to travel efficiently through the air to receivers, taking forms that propagate with minimal degradation.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/978-3-319-68576-2_3</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000426 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000425"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000421"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:38:14.384672Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Sound that is produced by the rapid and repeated impact of knocking hard anatomical components against each other.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">rattle</oboInOwl:hasExactSynonym>
        <rdfs:label>rattle sound</rdfs:label>
        <skos:example>&quot;In the Tufted Duck and Rosybill, it is the primaries which are rattled with the bill to produce the characteristic noise.&quot;</skos:example>
        <skos:example>&quot;Perhaps one of the most notable derived antipredator adaptations in snakes is the rattle, an epidermal, soundproducing structure found on the tip of the tail in 29 species of rattlesnakes.&quot;</skos:example>
        <skos:scopeNote>&quot;Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000426"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Sound that is produced by the rapid and repeated impact of knocking hard anatomical components against each other.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1111/brv.12891</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000426"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">rattle</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
        <skos:scopeNote>&quot;...this snake is furnished with a rattle...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000426"/>
