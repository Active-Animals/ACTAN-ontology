        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-22T20:52:59.748047Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Avoidance in which an animal attempts to conceal itself.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>concealing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">hiding</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>secreting</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">hiding avoidance</rdfs:label>
        <skos:example>&quot;An orang-utan hides from humans or predators behind a detached branch.&quot;</skos:example>
        <skos:example>&quot;The results also indicate that goby size was limited by colony width on J. juncea, which may be from the way B. amplus hides behind it... gobies substantially wider than their host are less capable of using it to avoid detection by predators.&quot;</skos:example>
    </owl:Class>
