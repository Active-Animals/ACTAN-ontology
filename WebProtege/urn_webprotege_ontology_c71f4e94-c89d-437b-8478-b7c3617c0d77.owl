    <!-- http://purl.obolibrary.org/obo/ACTAN_0000307 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000307">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001619"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/kinetics"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-13T13:27:03.750614Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Kinetics in which muscle tone broadly reduces.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>relaxation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">settling</oboInOwl:hasExactSynonym>
        <rdfs:label>relaxation kinetics</rdfs:label>
        <skos:scopeNote>&quot;...play indicates that the subject animal is in a ‘relaxed’ state in the sense of being free from sickness, hunger, injury, predation risk, thermal stress or other challenges to its fitness including lost mating opportunities.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;In order to understand the mechanisms by which the pheromones influence behaviour, it is necessary to understand as fully as possible the baseline structure of lamprey movements, including quantifying the diel patterns of settling and swimming.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;We chose to use 20 min based on observations of the snake’s behavior (i.e., termination of rattling and settling into a coil).&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000307"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Kinetics in which muscle tone broadly reduces.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000307"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>relaxation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1242/jeb.27.3.264</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000307"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">settling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000307"/>
