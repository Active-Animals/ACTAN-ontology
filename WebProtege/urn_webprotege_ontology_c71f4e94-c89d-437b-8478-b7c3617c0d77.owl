        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-29T14:15:39.867273Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Shake in which the head is moved from side to side.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">head shaking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>head-flick</oboInOwl:hasRelatedSynonym>
        <rdfs:label>head shake</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000725"/>
        <skos:closeMatch>NBO:0000023</skos:closeMatch>
        <skos:example>&quot;...langur monkeys (Semnopithecus entellus)...
inviting a male by presenting the anogenital region, tail lowered, and simultaneous head shaking;&quot;</skos:example>
        <skos:example>&quot;Ardeola ibis... Head Flick. 

This display consists of rapid, small-amplitude head movements in a horizontal plane, given with the beak closed, and may be performed singly or as rapidly as twice per second.&quot;</skos:example>
        <skos:example>&quot;The Maned Goose gives very rapid Head-shakes when calling with crest erect and head held high; possibly this display had its origin in pre-flight behaviour, but it provides an example of the incorporation of head-shaking in a highly ritualized pattern.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000767"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Shake in which the head is moved from side to side.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853965x00138</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;The bill is shaken from side to side a few times. The movements vary a great deal in speed and amplitude, but they are always lateral...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000767"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">head shaking</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000767"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>head-flick</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1967</dc:date>
        <dc:source>https://open.uct.ac.za/handle/11427/13101</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000767"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
