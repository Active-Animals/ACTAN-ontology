    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000469"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>stance</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1242/jeb.202.6.661</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000469"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">wedge</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1986</dc:date>
        <dc:source>doi:10.1242/jeb.120.1.283</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000469"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>anchor kinetics</owl:annotatedTarget>
        <dc:source>https://orcid.org/0000-0002-4277-2151</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000469"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;...the fish often contacted some firm object, as though using it as an anchor.&quot;</owl:annotatedTarget>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000469"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Concertina describes a snake using static points of contact with supports, either by progressing between branches in a series of cantilevers using the tail or hind body, or by wedging its posterior into surface irregularities with short-radius bends, extending its anterior to grasp more irregularities, then pulling up the posterior.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1744-7429.2000.tb00506.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000469"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;One part of the organism probes forward, while the rest acts as an anchor that prevents back-slippage.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1365-3121.1991.tb00141.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000469"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Using lateral stems as horizontal steps, the feet maintained their grasp on the liftoff stem, a lateral stem in this case, as the tail hooked around an even higher lateral stem. Anchored thus, the monkeys dropped downward while reaching with the forelimbs toward the target lateral stem.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1023/A:1005565304671</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000470 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000450"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000301"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-18T16:56:34.977248Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mate-choice that attempts to find a potential partner.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">mate search</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>partner search</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>partner finding</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">search mate-choice</rdfs:label>
        <skos:closeMatch>NBO:0020084</skos:closeMatch>
        <skos:example>&quot;We are inclined to believe that societies of courting males are easier for females to find than solitary courting males, scattered over the area. CHAPMAN (1935) expressed the same idea with regard to the courting territories of Manacus vitellinus...&quot;</skos:example>
        <skos:example>&quot;When male C. elegans animals are positioned on a bacterial food lawn without potential mating partners... there is a sharp increase in the probability of the animal persisting in a forward run when it encounters the edge of the bacterial food lawn...

Consistent with the notion that animals balance their mate search and food seeking, males that have been starved for three or more hours reduce their lawn-leaving rates.&quot;</skos:example>
        <skos:scopeNote>&quot;It seems quite effective that the female possesses such a specific knowledge of the colours of the male, so that she will be able to distinguish her own species quickly from the other fishes she meets when wandering about in search of a partner.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000470"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mate-choice that attempts to find a potential partner.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000470"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">mate search</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1093/icb/41.2.137</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000470"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>partner search</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <skos:scopeNote>&quot;...in search of a partner...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000470"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>partner finding</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
        <skos:scopeNote>&quot;...to find their way, their food or their partner;&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000470"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">search mate-choice</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000470"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;We are inclined to believe that societies of courting males are easier for females to find than solitary courting males, scattered over the area. CHAPMAN (1935) expressed the same idea with regard to the courting territories of Manacus vitellinus...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000470"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;When male C. elegans animals are positioned on a bacterial food lawn without potential mating partners... there is a sharp increase in the probability of the animal persisting in a forward run when it encounters the edge of the bacterial food lawn...

Consistent with the notion that animals balance their mate search and food seeking, males that have been starved for three or more hours reduce their lawn-leaving rates.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1534/genetics.120.303539</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000470"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;It seems quite effective that the female possesses such a specific knowledge of the colours of the male, so that she will be able to distinguish her own species quickly from the other fishes she meets when wandering about in search of a partner.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000471 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000443"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000543"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_realization"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-18T16:57:55.327493Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>sexual behavior</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Breeding which involves gonad development, and a disposition to phased, characteristic behaviour.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>courtship and mating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">mating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>post-mating</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>pre-mating</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">mating breeding</rdfs:label>
        <skos:example>&quot;Indeed, it is well known that the displays of courting males often consist of two elements—an aggressive component, presumably involved in the competition with other males which they are potentially disposed to attack; and an appeasement or &quot;sexual&quot; component, which is apparently important in &quot;attracting&quot; females (or, perhaps more accurately, in assuring them that they will not be attacked).&quot;</skos:example>
        <skos:relatedMatch>NBO:0000010</skos:relatedMatch>
        <skos:scopeNote>&quot;The importance of non-morphological mating signals and behaviours is also well appreciated in vertebrates. Elaborate courtship behaviours – often involving visual cues – have been described for various groups of salamanders, mammals, birds and fishes while olfactory and tactile signals are particularly important for many mammal species and songs and calls for the mating behaviour of birds and anurans.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;This process of differential survival Darwin called &quot;natural selection.&quot; However, he observed a number of characters which seemed useless with respect to the &quot;struggle for existence&quot; in the environment, including especially the secondary sexual characters of males (particularly, in man), and showed with a massive collection of examples that such characters often come into play during mating competition—either in fighting or attracting females.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>sexual behavior</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1976</dc:date>
        <dc:source>doi:10.1111/j.1439-0310.1976.tb00970.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Breeding which involves gonad development, and a disposition to phased, characteristic behaviour.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1163/156853981X00220</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;From this we are inclined to believe that the disposition to secure a territory, together with the beginning of the development of the gonads and of the reproductive markings, are characteristics of a pre-mating phase that is concluded by the maturing of the gonads. But just as the reproductive markings are the same before and after the gonads have become mature, so the territorialism will also be the same in the pre-mating and mating phase.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>courtship and mating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2006</dc:date>
        <dc:source>doi:10.1093/auk/123.4.967</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">mating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>post-mating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1086/BBLv224n3p166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>pre-mating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">mating breeding</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Indeed, it is well known that the displays of courting males often consist of two elements—an aggressive component, presumably involved in the competition with other males which they are potentially disposed to attack; and an appeasement or &quot;sexual&quot; component, which is apparently important in &quot;attracting&quot; females (or, perhaps more accurately, in assuring them that they will not be attacked).&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The importance of non-morphological mating signals and behaviours is also well appreciated in vertebrates. Elaborate courtship behaviours – often involving visual cues – have been described for various groups of salamanders, mammals, birds and fishes while olfactory and tactile signals are particularly important for many mammal species and songs and calls for the mating behaviour of birds and anurans.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;This process of differential survival Darwin called &quot;natural selection.&quot; However, he observed a number of characters which seemed useless with respect to the &quot;struggle for existence&quot; in the environment, including especially the secondary sexual characters of males (particularly, in man), and showed with a massive collection of examples that such characters often come into play during mating competition—either in fighting or attracting females.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000472 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000472">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000471"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000438"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-18T16:58:11.16345Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>bourgeois tactic</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Mating which involves a degree of competitive, attractive, and appeasement components.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>amorous maneuvers</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">courting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>courtship</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>love play</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>mating signaling</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>pre-spawning behavior</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>premating courtship</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>mating effort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sexual competition</oboInOwl:hasRelatedSynonym>
        <rdfs:label>courtship mating</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000389"/>
        <skos:example>&quot;Male bicolour damselfish, Stegastes partitus, for example, show higher courtship effort in the presence of larger, more fecund females, independent of the degree of predation risk; however, males do reduce courtship towards small females in the presence of predators.&quot;</skos:example>
        <skos:relatedMatch>NBO:0000077</skos:relatedMatch>
        <skos:scopeNote>&quot;Contest and courtship behavior provide some of the clearest examples of high energy expenditure related to sexual selection. The aerobatic dives and high-energy courtship displays of hummingbirds appear to push males towards the limits of flight performance. Other examples include the vigorous courtship displays of swordtail fish, the energetically demanding drumming display of wolf spiders, the calling of frogs and tree-crickets and the vibratory courtship of treehoppers.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The male tactic of procuring access to female gametes by monopolization has been called ‘bourgeois’... A bourgeois male invests in primary access to a resource (e.g. a spawning female) and behaves as the ‘owner’.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>bourgeois tactic</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1998</dc:date>
        <dc:source>doi:10.1016/S0169-5347(97)01318-9</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mating which involves a degree of competitive, attractive, and appeasement components.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.jstor.org/stable/986582</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Indeed, it is well known that the displays of courting males often consist of two elements—an aggressive component, presumably involved in the competition with other males which they are potentially disposed to attack; and an appeasement or &quot;sexual&quot; component, which is apparently important in &quot;attracting&quot; females (or, perhaps more accurately, in assuring them that they will not be attacked).&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>amorous maneuvers</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">courting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>courtship</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>love play</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>mating signaling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1111/j.1420-9101.2009.01826.x</dc:source>
        <skos:scopeNote>&quot;...mating signals...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>pre-spawning behavior</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>premating courtship</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2008</dc:date>
        <dc:source>doi:10.1007/s10682-007-9183-7</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>mating effort</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2010</dc:date>
        <dc:source>doi:10.1007/s00265-010-0980-6</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>sexual competition</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1979</dc:date>
        <dc:source>https://www.jstor.org/stable/986582</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>courtship mating</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Male bicolour damselfish, Stegastes partitus, for example, show higher courtship effort in the presence of larger, more fecund females, independent of the degree of predation risk; however, males do reduce courtship towards small females in the presence of predators.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1007/s00265-010-0980-6</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Contest and courtship behavior provide some of the clearest examples of high energy expenditure related to sexual selection. The aerobatic dives and high-energy courtship displays of hummingbirds appear to push males towards the limits of flight performance. Other examples include the vigorous courtship displays of swordtail fish, the energetically demanding drumming display of wolf spiders, the calling of frogs and tree-crickets and the vibratory courtship of treehoppers.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1002/bies.202000183</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000472"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The male tactic of procuring access to female gametes by monopolization has been called ‘bourgeois’... A bourgeois male invests in primary access to a resource (e.g. a spawning female) and behaves as the ‘owner’.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1016/S0169-5347(97)01318-9</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000473 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0001017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-18T16:58:26.004698Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Coercion where repeated attempts to copulate have costs to mates which induce them to mate immediately.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>sexual harassment</oboInOwl:hasExactSynonym>
        <rdfs:label>harassment coercion</rdfs:label>
        <skos:closeMatch>NBO:0020254</skos:closeMatch>
        <skos:example>&quot;Fallow bucks, Dama dama, for example, persistently court and attempt to mate with females that initially reject their advances.&quot;</skos:example>
        <skos:example>&quot;Thalassoma cupido...
Rarely, pair spawning is not preceded by the typical courtship display. In these instances, the male vigorously chases the female. The chase terminates when the female abruptly ceases to flee, and spawning immediately follows.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000473"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Coercion where repeated attempts to copulate have costs to mates which induce them to mate immediately.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1006/anbe.1995.0166</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;There are three main forms of sexual coercion: ... (2) harassment, where repeated attempts to copulate by males have costs to females which induce them to mate immediately;&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000473"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>sexual harassment</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000473"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>harassment coercion</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000473"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Fallow bucks, Dama dama, for example, persistently court and attempt to mate with females that initially reject their advances.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000473"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Thalassoma cupido...
Rarely, pair spawning is not preceded by the typical courtship display. In these instances, the male vigorously chases the female. The chase terminates when the female abruptly ceases to flee, and spawning immediately follows.&quot;</owl:annotatedTarget>
        <dc:source>https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000474 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000479"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000381"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-18T16:58:46.942199Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Caring that regulates development.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">incubation</oboInOwl:hasExactSynonym>
        <rdfs:label>incubation caring</rdfs:label>
        <skos:example>&quot;At the time of changing position on the nest incubating Mallards have ten different movements which tend to occur in a certain sequence (e.g. preliminary preening and toying with nest-material, poking among the eggs with the bill, settling movements). A single heard-shake often occurs near the end of the egg-turning sequence, frequently as the final movement.&quot;</skos:example>
        <skos:narrowMatch>NBO:0000045</skos:narrowMatch>
        <skos:scopeNote>&quot;The nest thermoregulation strategies of eusocial insects can be passive (e.g., nest orientation, architecture) or active (e.g., clustering, incubation), depending on the species.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000474"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Caring that regulates development.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1371/journal.pone.0200048</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000474"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">incubation</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000474"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>incubation caring</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000474"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;At the time of changing position on the nest incubating Mallards have ten different movements which tend to occur in a certain sequence (e.g. preliminary preening and toying with nest-material, poking among the eggs with the bill, settling movements). A single heard-shake often occurs near the end of the egg-turning sequence, frequently as the final movement.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000474"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The nest thermoregulation strategies of eusocial insects can be passive (e.g., nest orientation, architecture) or active (e.g., clustering, incubation), depending on the species.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1371/journal.pone.0200048</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000475 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000475">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000852"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000715"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_activity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-18T16:59:00.442107Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Gamete-release that is external to at least one participant.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">spawning</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spawning act</oboInOwl:hasExactSynonym>
        <rdfs:label>spawning gamete-release</rdfs:label>
        <skos:closeMatch>NBO:0020174</skos:closeMatch>
        <skos:example>&quot;During breeding, the male zebrafish approaches the female and curves body around, positioning his genital pore next to hers. The male then quivers in an attempt to trigger oviposition in the female; sperm is released simultaneously to fertilize the newly released eggs.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000475"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Gamete-release that is external to at least one participant.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1111/brv.12018</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000475"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
