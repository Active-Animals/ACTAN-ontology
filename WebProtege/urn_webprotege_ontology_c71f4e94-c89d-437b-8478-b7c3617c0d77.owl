    <!-- http://purl.obolibrary.org/obo/ACTAN_0000423 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000423">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000431"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002425"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-12T11:37:30.010294Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Show which draws attention to a characteristic morphological feature.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">exposing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>exposure</oboInOwl:hasExactSynonym>
        <rdfs:label>exposure show</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000626"/>
        <skos:example>&quot;...the signal movement of a fully ripe stickleback, which shows her swollen abdomen.&quot;</skos:example>
        <skos:example>&quot;C. pricei had derived tail displays of curling their tails and exposing the ventral surface of the tail to the predator.&quot;</skos:example>
        <skos:example>&quot;Chimpanzees...
the corners of lips are drawn back, exposing the lower, or both upper and lower teeth (or teeth and gums).&quot;</skos:example>
    </owl:Class>
