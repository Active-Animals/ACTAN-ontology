        <owl:annotatedTarget>Thermoregulation that involves insolation exposure.</owl:annotatedTarget>
        <dc:source>doi:10.3354/esr01312</dc:source>
        <terms:contributor>https://orcid.org/0000-0002-4277-2151</terms:contributor>
    </owl:Axiom>
