        <oboInOwl:creation_date>2024-11-18T21:06:12.41754Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Aggregation that is localised and stable.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">cluster</oboInOwl:hasExactSynonym>
        <rdfs:label>cluster aggregation</rdfs:label>
        <skos:example>&quot;From all the cells, both those just commenced and those completed, being thus crowned by a strong coping of wax, the bees can cluster and crawl over the comb without injuring the delicate hexagonal walls, which are only about one four-hundredth of an inch in thickness;&quot;</skos:example>
        <skos:scopeNote>&quot;The nest thermoregulation strategies of eusocial insects can be passive (e.g., nest orientation, architecture) or active (e.g., clustering, incubation), depending on the species.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000483"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Aggregation that is localised and stable.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000483"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">cluster</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000483"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>cluster aggregation</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000483"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;From all the cells, both those just commenced and those completed, being thus crowned by a strong coping of wax, the bees can cluster and crawl over the comb without injuring the delicate hexagonal walls, which are only about one four-hundredth of an inch in thickness;&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000483"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;The nest thermoregulation strategies of eusocial insects can be passive (e.g., nest orientation, architecture) or active (e.g., clustering, incubation), depending on the species.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1371/journal.pone.0200048</dc:source>
