    <!-- http://purl.obolibrary.org/obo/ACTAN_0000536 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000536">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000288"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000505"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000632"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-01-20T21:36:47.38576Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Relativity which traces a lemniscate pattern in space, with two lobes separated by a crossing point.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">figure-eight</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lemniscate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">shuttling</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>analemma</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>back and forth</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>up and down</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">figure-eight relativity</rdfs:label>
        <skos:example>&quot;...the specific figure-8 dance of honeybees is not universally optimal for bee communication; rather, it is one solution that works well enough and has been maintained through evolutionary time.&quot;</skos:example>
        <skos:example>&quot;A. ibis...
The male spends much time slowly walking up and down and turning around. on its percb...&quot;</skos:example>
        <skos:example>&quot;SHUTTLE DISPLAY
In this display, a male flies rapidly back and forth in tight arcs 15-25 cm in length above another hummingbird (usually a female C. anna) that is perched ca. 20-30 cm below him. The male holds his body fairly horizontal, his head and bill pointed downward toward the object of the display; at the end of each arc, he reverses direction with a rapid flick of the spread tail (though in this case I have not heard any sound).&quot;</skos:example>
        <skos:example>&quot;Zebrafish...
...a tail sweep and circle along a female’s body resembling a ‘figure eight’;&quot;</skos:example>
        <skos:example>&quot;Zebrafish...
...swimming up and down in front of male; performed by females during courtship.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000536"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Relativity which traces a lemniscate pattern in space, with two lobes separated by a crossing point.</owl:annotatedTarget>
        <rdfs:isDefinedBy>https://www.academia.edu/145444084/The_Figure_8_Pattern_Across_Natural_Systems_A_Critical_Examination_of_Convergent_Geometry</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;When Coupled Oscillations Produce Lemniscates...
The result is a figure-8 pattern traced in space: two lobes separated by a crossing point.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000536"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">figure-eight</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2013</dc:date>
        <dc:source>doi:10.1089/zeb.2012.0861</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000536"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>lemniscate</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2025</dc:date>
        <dc:source>https://www.academia.edu/145444084/The_Figure_8_Pattern_Across_Natural_Systems_A_Critical_Examination_of_Convergent_Geometry</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000536"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget xml:lang="en">shuttling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1982</dc:date>
        <dc:source>doi:10.2307/1367674</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000536"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>analemma</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2025</dc:date>
        <dc:source>https://www.academia.edu/145444084/The_Figure_8_Pattern_Across_Natural_Systems_A_Critical_Examination_of_Convergent_Geometry</dc:source>
