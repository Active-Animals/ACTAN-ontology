        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000594"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>sickle-shape</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1961</dc:date>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
        <skos:scopeNote>&quot;Sickle-shape and S-shape are two extremes and all degrees of intermediacy occur.&quot;</skos:scopeNote>
    </owl:Axiom>
