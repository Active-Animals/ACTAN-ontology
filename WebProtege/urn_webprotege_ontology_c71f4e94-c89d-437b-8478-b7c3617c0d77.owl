                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-11-18T16:59:16.575278Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Spawning that releases male gametes.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>fertilizing act</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>insemination</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>free-swimming sperm</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>sperm trailing</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">sperm spawning</rdfs:label>
        <skos:example>&quot;In gobiids, the accessory gland facilitates sperm to be laid down in a mucous rich ‘sperm trail’ on the spawning substrate allowing insemination to be asynchronous with egg laying and prolonged.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000476"/>
