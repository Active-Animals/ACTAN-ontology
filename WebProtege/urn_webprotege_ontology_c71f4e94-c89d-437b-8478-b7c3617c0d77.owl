    <!-- http://purl.obolibrary.org/obo/ACTAN_0000871 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000871">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000291"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000329"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:nodeID="genid6567"/>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-10-08T07:57:12.971638Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Territorialism in which neighbouring adversaries repeatedly stop, advance and retreat, in and out of each other&apos;s territory, until the centre of oscillation stops shifting, affirming a line of division.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>boundary fight</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">boundary fixing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>mutual attack</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>mutual display</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">mutual territorialism</rdfs:label>
        <skos:example>&quot;Red sea bream Pagrus major and crimson sea bream, Evynnis japonica...

In this case, both fish attack each other toward the mouth, head and belly regions, and then they return to a certain position in their own territories. At the end of these attacks, territorial fish perform a mutual display.&quot;</skos:example>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid6567">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000592"/>
    </owl:Restriction>
