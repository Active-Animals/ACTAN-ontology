    <!-- http://purl.obolibrary.org/obo/ACTAN_0000713 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000713">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000358"/>
