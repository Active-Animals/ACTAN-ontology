    <!-- http://purl.obolibrary.org/obo/ACTAN_0000997 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000997">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000479"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000996"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_composite"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-09-22T10:53:31.856777Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Caring that involves defense against egg predators by swamping them.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>cluster of spawnings</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">clustering caring</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000997"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Caring that involves defense against egg predators by swamping them.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.11369/jji1950.34.76</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;However, swamping of egg predators with clusters of spawnings may be a partially effective defense.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000997"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
