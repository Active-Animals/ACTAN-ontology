        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-20T10:16:48.171597Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Extending that involves the anal fin.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">anal-fin extending</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000300"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Extending that involves the anal fin.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.5962/p.203769</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Schlesinger points out with a diagram that in turning by means of extending a single pectoral the pressure of the water on the extended dorsal and anal swings the fish around with the pectoral somewhat as a pivot.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000300"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">anal-fin extending</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;...extended dorsal and anal...&quot;</skos:scopeNote>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000301 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000290"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000507"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001032"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-10-08T07:11:11.320721Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Localization which explores for, and if possible exploits, a resource.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>detecting</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">locating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>search</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">searching</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>seeking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">search inspection</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">search localization</rdfs:label>
        <skos:example>&quot;Permanent ‘on-demand’ hibernacula are desirable for C. horridus, particularly northern populations, which do not create their hibernacula and whose survival depends on locating these thermally adequate but geographically limited landscape features.&quot;</skos:example>
        <skos:example>&quot;The hermit crabs, Coenobita compressus, were observed frequently along the beach over 2 months. They were very active at night in the intertidal zone patrolling the moist sand in search of food.&quot;</skos:example>
        <skos:example>&quot;To refer once again to cirripedes: the larvæ in the first stage have three pairs of legs, a very simple single eye, and a probosciformed mouth, with which they feed largely, for they increase much in size. In the second stage, answering to the chrysalis stage of butterflies, they have six pairs of beautifully constructed natatory legs, a pair of magnificent compound eyes, and extremely complex antennæ; but they have a closed and imperfect mouth, and cannot feed: their function at this stage is, to search by their well-developed organs of sense, and to reach by their active powers of swimming, a proper place on which to become attached and to undergo their final metamorphosis.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000301"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Localization which explores for, and if possible exploits, a resource.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.3354/esr01312</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;E.g., animals will use multiple sources of information in order to select between different foraging strategies balancing the risks and benefits of local resource exploitation versus long-range exploration.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000301"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>detecting</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1984</dc:date>
        <dc:source>https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download</dc:source>
    </owl:Axiom>
