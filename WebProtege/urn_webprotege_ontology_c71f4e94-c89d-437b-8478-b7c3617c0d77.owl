    <!-- http://purl.obolibrary.org/obo/ACTAN_0000672 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000672">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000126"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002553"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-04-28T16:13:54.133797Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Gait pattern in which water is ejected from a refillable space, through an orifice.</oboInOwl:hasDefinition>
        <rdfs:label>jet pattern</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000672"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Gait pattern in which water is ejected from a refillable space, through an orifice.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1098/rsos.170467</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;If the area of the orifice through which water is drawn and ejected were the same, the required increase in flow rate during refilling would negate the benefits gained during propulsion.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000672"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>jet pattern</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000673 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000673">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000149"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000651"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001028"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/manoeuvre"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-04-28T20:29:50.41247Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Manoeuvre that involves a negative change in speed over a given time course.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">decelerating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>deceleration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>braking maneuver</oboInOwl:hasRelatedSynonym>
        <rdfs:label>deceleration manoeuvre</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000172"/>
        <skos:example>&quot;For example when the kangaroo decelerates downward and forward, its feet are flexed so that the Achilles tendons are stretched storing elastic energy.&quot;</skos:example>
        <skos:example>&quot;Mudskippers can elevate the mid-body during the stance phase of crutching behavior, but the body returns to full contact with the substrate as both pectoral fins are lifted during the swing phase. Because of this, mudskippers undergo marked deceleration when the pectoral fin is in swing phase, which does not permit continuous motion between cycles.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000673"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Manoeuvre that involves a negative change in speed over a given time course.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1242/jeb.130.1.155</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000673"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">decelerating</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1977</dc:date>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000673"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>deceleration</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000673"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>braking maneuver</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>doi:10.1242/jeb.021360</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000673"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>deceleration manoeuvre</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000673"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;For example when the kangaroo decelerates downward and forward, its feet are flexed so that the Achilles tendons are stretched storing elastic energy.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1152/ajpregu.1977.233.5.R243</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000673"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;Mudskippers can elevate the mid-body during the stance phase of crutching behavior, but the body returns to full contact with the substrate as both pectoral fins are lifted during the swing phase. Because of this, mudskippers undergo marked deceleration when the pectoral fin is in swing phase, which does not permit continuous motion between cycles.&quot;</owl:annotatedTarget>
        <rdfs:comment>doi:10.1093/icb/icac125</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000674 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000674">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000120"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_4000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-07-27T08:00:04.987014Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>vertical fin depression</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Flexion that results from anal fin flexing.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">anal-fin flexion</rdfs:label>
        <skos:scopeNote>&quot;In the fastest forms the vertical fins can be depressed so completely as to mar the perfection of the streamline form in no way at all.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000674"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>vertical fin depression</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
        <skos:scopeNote>&quot;... vertical fins can be depressed...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000674"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Flexion that results from anal fin flexing.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <rdfs:comment>Directly inferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000674"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">anal-fin flexion</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000674"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;In the fastest forms the vertical fins can be depressed so completely as to mar the perfection of the streamline form in no way at all.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000675 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000675">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000645"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-04-29T15:17:11.798708Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Steering in which an appendage causes body rotation.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>pinwheeling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">pivot</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">pivot steering</rdfs:label>
        <skos:example>&quot;...in salamandrids: The apparent ancestral mode is to deposit the spermatophore two body lengths in front of the female, while facing her head-to-head. The male and female then pivot about ipsilateral forelimbs, rotating pinwheel (PWT) fashion, so that the female contacts the spermatophore (Salamandrina, Pleurodeles, Tylototriton).&quot;</skos:example>
        <skos:example>&quot;...in turning by means of extending a single pectoral the pressure of the water on the extended dorsal and anal swings the fish around with the pectoral somewhat as a pivot. This is especially noticeable in long bodied forms, such as Esox.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000675"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Steering in which an appendage causes body rotation.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>http://www.nativefishlab.net/library/textpdf/15582.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000675"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pinwheeling</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2003</dc:date>
        <dc:source>ISBN:9781482294347</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000675"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">pivot</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000675"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">pivot steering</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000675"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...in salamandrids: The apparent ancestral mode is to deposit the spermatophore two body lengths in front of the female, while facing her head-to-head. The male and female then pivot about ipsilateral forelimbs, rotating pinwheel (PWT) fashion, so that the female contacts the spermatophore (Salamandrina, Pleurodeles, Tylototriton).&quot;</owl:annotatedTarget>
        <rdfs:comment>ISBN:9781482294347</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000675"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...in turning by means of extending a single pectoral the pressure of the water on the extended dorsal and anal swings the fish around with the pectoral somewhat as a pivot. This is especially noticeable in long bodied forms, such as Esox.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000676 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000676">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000360"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-05-04T13:11:40.776567Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Subsistence which involves gas diffusion across barriers between the environment and the blood.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>breathing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">respiration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ventilation</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">respiration subsistence</rdfs:label>
        <skos:scopeNote>&quot;Diffusion barriers for respiratory organs such as gills or lungs are typically 0.1–10 mm. Diffusion barriers in amphibians, which rely on cutaneous respiration for a significant proportion of O2 uptake, are typically 10–50mm.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;The opercular movements appeared to be the same as those seen in normal aquatic respiration.&quot;</skos:scopeNote>
    </owl:Class>
