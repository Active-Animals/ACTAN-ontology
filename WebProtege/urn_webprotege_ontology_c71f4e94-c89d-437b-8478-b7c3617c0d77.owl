        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-02-10T13:37:25.025516Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Taxis that responds to a current.</oboInOwl:hasDefinition>
        <oboInOwl:hasNarrowSynonym>rheophilic</oboInOwl:hasNarrowSynonym>
        <rdfs:label xml:lang="en">rheo-taxis</rdfs:label>
        <skos:example>&quot;...another reason why colony height is such as important determinant of occupancy is becauae taller colonies reach higher into the water column thus allowing the rheophilic B. amplus better access to zooplankton prey.&quot;</skos:example>
        <skos:scopeNote>&quot;In holding a position in a current, fishes head up stream as this minimizes the frictional resistance of the flow against their bodies by reason of their streamline shape; and in this position they are properly orientated for swimming against it.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000593"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Taxis that responds to a current.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1089/zeb.2012.0861</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;Rheotaxis: A common behavior in aquatic species, includes turning towards a current and a tendency to swim upstream;&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000593"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>rheophilic</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2009</dc:date>
        <dc:source>https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000593"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">rheo-taxis</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1926</dc:date>
        <dc:source>doi:10.5962/p.203769</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000593"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...another reason why colony height is such as important determinant of occupancy is becauae taller colonies reach higher into the water column thus allowing the rheophilic B. amplus better access to zooplankton prey.&quot;</owl:annotatedTarget>
        <dc:source>https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf</dc:source>
    </owl:Axiom>
