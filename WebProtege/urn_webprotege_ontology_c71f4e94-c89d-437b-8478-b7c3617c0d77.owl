        <owl:annotatedTarget>Expanding which unsheathes one layer stacked inside another resulting in overall lengthening.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1073/pnas.2122563119</dc:source>
    </owl:Axiom>
    <owl:Axiom>
