    <!-- http://purl.obolibrary.org/obo/ACTAN_0000154 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000149"/>
        <rdfs:subClassOf rdf:nodeID="genid1021"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000651"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001028"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/manoeuvre"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-09-23T07:51:03.052025Z</oboInOwl:creation_date>
        <oboInOwl:hasBroadSynonym>linear maneuver</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDefinition>Manoeuvre that involves a positive change in speed over a given time course.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>accelerating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">acceleration</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">acceleration manoeuvre</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000003"/>
        <skos:example>&quot;40% of the body mass of a shrimp is devoted to the large, tasty abdominal muscles that produce a powerful tail flick during rare, but critical, escape behaviors. During escape, rapid acceleration, rather than energy minimization, is the relevant aspect of performance.&quot;</skos:example>
        <skos:example>&quot;Goatfishes... To escape , they simply swim off into open water, a system that depends on rapid acceleration and sustained speed among other things.&quot;</skos:example>
        <skos:scopeNote>&quot;At its most fundamental level, locomotion is deceptively simple. An organism exerts a force on the external environment and, through Newton’s laws, accelerates in the opposite direction.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid1021">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000530"/>
    </owl:Restriction>
