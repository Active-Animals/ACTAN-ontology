    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000781 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000781">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000715"/>
        <rdfs:subClassOf>
