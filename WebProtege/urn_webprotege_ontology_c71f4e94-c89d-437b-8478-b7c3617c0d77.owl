    <!-- http://purl.obolibrary.org/obo/ACTAN_0000784 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000784">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000104"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001575"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-08-06T07:55:19.760592Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Rub that gently moves an object across another.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>wipe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">wiping</oboInOwl:hasExactSynonym>
        <rdfs:label>wipe rub</rdfs:label>
        <skos:example>&quot;The most complex limb movements occur during the ‘wiping behaviour’ observed in frogs with opposable digits such as Polypedates maculatus and species of Phyllomedusa. During wiping, frogs spread lipid substances all over their body using their hands and feet.&quot;</skos:example>
        <skos:example>&quot;Wiping is very rare at Mahale, with only a handful of cases of rump wiping with a leaf. Goodall stated that the most common form at Gombe is penis wiping by a male after copulation, but this has never been seen among Mahale chimpanzees.&quot;</skos:example>
        <skos:scopeNote>&quot;...the bird wipes off ant acid, preparatory to eating the ant;&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;When a bird comes out on land to oil, the bill is generally used to wipe some of the water from the breast; the head-shakes which precede use of the oil gland probably serve to remove water which has been transferred to the bill during wiping.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000784"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Rub that gently moves an object across another.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1111/brv.12010</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000784"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>wipe</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1999</dc:date>
        <dc:source>doi:10.1537/ase.107.141</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000784"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">wiping</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1957</dc:date>
        <dc:source>https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&amp;context=wilson_bulletin</dc:source>
