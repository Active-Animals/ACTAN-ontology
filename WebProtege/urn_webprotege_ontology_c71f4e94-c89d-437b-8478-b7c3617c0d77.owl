        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-07-30T12:02:14.987845Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Flying-regime which involves a continuous cycle of active flapping, without climbing or descending.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">level flight</oboInOwl:hasExactSynonym>
        <rdfs:label>level-flying regime</rdfs:label>
        <skos:example>&quot;The first observation, on 1 August 1977, involved 2 dark-phase jaegers and an  immature female Pectoral Sandpiper (Calidris melanotos). When first seen, the jaegers were chasing the sandpiper in level flight.&quot;</skos:example>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000774"/>
