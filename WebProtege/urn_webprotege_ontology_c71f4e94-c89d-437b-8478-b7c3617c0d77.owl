    <!-- http://purl.obolibrary.org/obo/ACTAN_0000427 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000427">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000287"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000094"/>
