    <!-- http://purl.obolibrary.org/obo/ACTAN_0000659 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000659">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000480"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/context_by_entity"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2025-04-07T15:13:22.075797Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Mothering that releases eggs.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym xml:lang="en">laying eggs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ovipositioning</oboInOwl:hasExactSynonym>
        <rdfs:comment>Still hoping to stimulate a new UBERON class that will fit better as a participant.</rdfs:comment>
        <rdfs:label xml:lang="en">egg-laying mothering</rdfs:label>
        <skos:closeMatch>NBO:0020048</skos:closeMatch>
        <skos:scopeNote>&quot;Egg laying impacts reproductive fitness and worms display temporal variations in bouts of egg laying activity, which are impacted by feeding status and other sensory cues.&quot;</skos:scopeNote>
        <skos:scopeNote>&quot;These mechanisms are illustrated by the most highly integrated insect societies, which characteristically have only one, long-lived egglayer (a high degree of genetic uniformity), highly developed pheromonal suppression of egg-laying by competitors (imposed convergence of interests), and highly specialized morphological castes (mutualistic convergence of interests due to task specialization).&quot;</skos:scopeNote>
        <skos:scopeNote>This involves the externalization of an internally fertilized ovum.</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000659"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Mothering that releases eggs.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000659"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">laying eggs</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1859</dc:date>
        <dc:source>doi:10.5962/bhl.title.82303</dc:source>
        <skos:scopeNote>&quot;...lay fertile eggs.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000659"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>ovipositioning</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1950</dc:date>
        <dc:source>doi:10.1163/156853981X00220</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000659"/>
