        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000832"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;A female Chiloe Wigeon, alone on the water, gave a loud descrescendo call; immediately a male appeared from behind some reeds and swam toward the female. On meeting, the female performed a Preen and a few seconds later it was given by the male. The two swam away together.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1163/156853965x00138</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000832"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
