    <!-- http://purl.obolibrary.org/obo/ACTAN_0000107 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000107">
        <rdfs:subClassOf rdf:resource="http://humanbehaviourchange.org/ontology/BCIO_050416"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000117"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:conformsTo rdf:resource="https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-05-06T07:32:10.412193Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Behavioural disposition that is realized in a group behavior pattern&apos;s spatial parameters.</oboInOwl:hasDefinition>
        <rdfs:label xml:lang="en">framework-dimension</rdfs:label>
        <skos:scopeNote>&quot;Nonetheless, given the large sizes of locust swarms the two-dimensional framework we use – and the band-like structure it implies – are likely good approximations for the bulk of a three-dimensional swarm.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000107"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Behavioural disposition that is realized in a group behavior pattern&apos;s spatial parameters.</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
        <dc:source>doi:10.1371/journal.pcbi.1002915</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000107"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="en">framework-dimension</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2008</dc:date>
        <dc:source>doi:10.1140/epjst/e2008-00633-y</dc:source>
        <skos:scopeNote>&quot;...two-dimensional framework...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000107"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;Nonetheless, given the large sizes of locust swarms the two-dimensional framework we use – and the band-like structure it implies – are likely good approximations for the bulk of a three-dimensional swarm.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1140/epjst/e2008-00633-y</dc:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ACTAN_0000108 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ACTAN_0000108">
        <rdfs:subClassOf rdf:resource="http://humanbehaviourchange.org/ontology/BCIO_050416"/>
        <oboInOwl:created_by>Ditch Townsend</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-05-10T15:31:16.148895Z</oboInOwl:creation_date>
        <oboInOwl:hasDefinition>Behavioural disposition that is realized in an individual&apos;s part in a collective.</oboInOwl:hasDefinition>
        <oboInOwl:hasExactSynonym>membership</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>collective abilities</oboInOwl:hasRelatedSynonym>
        <rdfs:label>group-membership</rdfs:label>
        <skos:example>&quot;...lek-breeding ungulates such as fallow deer, Uganda kob and Kafue lechwe which live in large unstable herds of mixed membership...&quot;</skos:example>
        <skos:scopeNote>&quot;These collective abilities, such as the construction of relatively large nests and the ability to overpower prey much larger than themselves, have been well documented in insect societies.&quot;</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000108"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDefinition"/>
        <owl:annotatedTarget>Behavioural disposition that is realized in an individual&apos;s part in a collective.</owl:annotatedTarget>
        <rdfs:isDefinedBy>doi:10.1093/beheco/12.5.534</rdfs:isDefinedBy>
        <skos:scopeNote>&quot;However, with the evolution of eusociality came the opportunity to exploit a new organizational method: highly cooperative and relatively unselfish groups of individuals who, collectively, are able to tackle tasks far beyond the abilities of the individuals themselves.&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000108"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>membership</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1995</dc:date>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
        <skos:scopeNote>&quot;...herds of mixed membership...&quot;</skos:scopeNote>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000108"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>collective abilities</owl:annotatedTarget>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2001</dc:date>
        <dc:source>doi:10.1093/beheco/12.5.534</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000108"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget>group-membership</owl:annotatedTarget>
        <dc:contributor>https://orcid.org/0000-0002-4277-2151</dc:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000108"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#example"/>
        <owl:annotatedTarget>&quot;...lek-breeding ungulates such as fallow deer, Uganda kob and Kafue lechwe which live in large unstable herds of mixed membership...&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1006/anbe.1995.0166</dc:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ACTAN_0000108"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget>&quot;These collective abilities, such as the construction of relatively large nests and the ability to overpower prey much larger than themselves, have been well documented in insect societies.&quot;</owl:annotatedTarget>
        <dc:source>doi:10.1093/beheco/12.5.534</dc:source>
    </owl:Axiom>
    


