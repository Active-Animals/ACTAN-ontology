# Class: obo:ACTAN_0000983 (flapping bob)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000983 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000983 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000983 "2026-09-16T10:42:56.821611Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1126/science.288.5463.100") Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasDefinition obo:ACTAN_0000983 "Bob in which the entire body is moved steadily in alternating directions in a fluid, by simultaneous strokes of the propulsors.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000983 "flapping bob"@en)
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000983 "\"Thalassoma cupido...
The characteristic motor pattern among these fish is a peculiar bobbing motion in which the entire body is moved steadily up and down by simultaneous vertical strokes of the pectoral fins. Bobbing fish swim slowly, sometimes barely moving forward at all, and often brush against the bodies of others swimming below or nearby.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:scopeNote obo:ACTAN_0000983 "\"In the viscous world of microscopic organisms, fluid motions are damped out as soon as an organism stops flapping or undulating, bodies do not coast, and a back-and-forth flap puts you back where you started.\"")
SubClassOf(obo:ACTAN_0000983 obo:ACTAN_0000982)
SubClassOf(obo:ACTAN_0000983 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000772))
SubClassOf(obo:ACTAN_0000983 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000026))

# Class: obo:ACTAN_0000984 (raising bob)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000984 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000984 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000984 "2026-09-16T10:46:07.895506Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasDefinition obo:ACTAN_0000984 "Bob in which the entire body is moved in alternate directions without losing contact with a substrate, by non-propulsive use of appendages.")
AnnotationAssertion(Annotation(rdfs:comment "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000984 "raising bob"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000984 "\"Chimpanzee...
The body bobs up and down as elbows are flexed and straightened.\"")
SubClassOf(obo:ACTAN_0000984 obo:ACTAN_0000982)
SubClassOf(obo:ACTAN_0000984 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000727))
SubClassOf(obo:ACTAN_0000984 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000026))

# Class: obo:ACTAN_0000985 (stabilizing bob)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000985 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000985 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000985 "2026-09-16T10:50:30.793561Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/41.2.137") Annotation(skos:scopeNote "\"Many birds with mobile necks alternately fix the head position and move it rapidly forward while the body moves forward continuously.\"") oboInOwl:hasDefinition obo:ACTAN_0000985 "Bob that alternately fixes the head position and moves it rapidly forward while the body moves forward continuously.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000985 "head bobbing")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000985 "intermittent head locomotion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000985 "stabilizing bob"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/41.2.137") skos:scopeNote obo:ACTAN_0000985 "\"Head movements relative to the body can also stabilize the visual field.\"")
SubClassOf(obo:ACTAN_0000985 obo:ACTAN_0000982)
SubClassOf(obo:ACTAN_0000985 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000148))
SubClassOf(obo:ACTAN_0000985 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000033))

# Class: obo:ACTAN_0000986 (spawn aggregation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000986 <https://github.com/Active-Animals/Ontology/patterns/group_behaviour>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000986 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000986 "2026-09-16T16:18:54.81172Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") Annotation(skos:scopeNote "\"During periods of reproductive activity, large numbers of T.cupido gather in groups of varying sizes at the spawning site.\"") oboInOwl:hasDefinition obo:ACTAN_0000986 "Mate-search aggregation which involves spawning.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000986 "aggregate spawning")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") oboInOwl:hasExactSynonym obo:ACTAN_0000986 "group spawning")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000986 "spawning aggregate")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000986 "spawning aggregation"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000986 "spawn aggregation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00265-014-1841-5") skos:example obo:ACTAN_0000986 "\"...at the Whyalla spawning grounds, South Australia (32°59′5 S; 137°43′1 E) between the months of May and July... giant Australian cuttlefish aggregate by the thousands to spawn on the hard substrate.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000986 "\"During periods of reproductive activity, large numbers of T.cupido gather in groups of varying sizes at the spawning site. It is estimated that the largest of these groups comprise as many as 150 individuals. Collections from among spawning aggregates revealed a heavy preponderance of males.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:scopeNote obo:ACTAN_0000986 "\"Spawning aggregates are not always well defined, isolated entities; aggregates may merge with neighboring groups or may break into yet smaller units.\"")
SubClassOf(obo:ACTAN_0000986 obo:ACTAN_0000526)
SubClassOf(obo:ACTAN_0000986 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000475))
SubClassOf(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") obo:ACTAN_0000986 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000988))

# Class: obo:ACTAN_0000987 (brush rub)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000987 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000987 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000987 "2026-09-17T19:57:57.315702Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasDefinition obo:ACTAN_0000987 "Rub which only just makes contact.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000987 "brushing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000987 "brush rub"@en)
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000987 "\"...European Jays... ants... swarmed up their legs and into their plumage... the posterior edges of the opened wings just brushing the ground.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000987 "\"Chimpanzee...
...its back almost brushes the ground...\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000987 "\"Thalassoma cupido...
...often brush against the bodies of others swimming below or nearby.\"")
SubClassOf(obo:ACTAN_0000987 obo:ACTAN_0000104)
SubClassOf(obo:ACTAN_0000987 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001961))

# Class: obo:ACTAN_0000988 (fission-fusion formation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000988 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000988 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000988 "2026-09-20T08:07:54.370684Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/brv.12934") oboInOwl:hasDefinition obo:ACTAN_0000988 "Formation which dynamically fluctuates between forms of aggregation and dis-aggregation.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000988 "fission and fusion grouping pattern")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.1111/brv.12934") oboInOwl:hasExactSynonym obo:ACTAN_0000988 "fission–fusion dynamics")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000988 "fission-fusion formation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12934") skos:scopeNote obo:ACTAN_0000988 "\"...within-group conflicts of interest – differences in the optimal decision, such as when to leave a food patch, among group members – drive group fission. Applying optimal foraging theory predicts that conflicts of interest decrease as environmental conditions become harsh, an explanation for the paradox of why large aggregations of animals can be observed when resources are scarce.\"")
SubClassOf(obo:ACTAN_0000988 obo:ACTAN_0000047)
SubClassOf(obo:ACTAN_0000988 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002374))

# Class: obo:ACTAN_0000989 (periphery relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000989 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000989 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000989 "2026-09-20T09:07:07.589164Z")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000989 "outskirts")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000989 "periphery")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasNarrowSynonym obo:ACTAN_0000989 "Relativity in which an animal is positioned on the edge of an aggregation.")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasNarrowSynonym obo:ACTAN_0000989 "peripheral male")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000989 "periphery relativity"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000989 "\"Chimpanzee...
...the female is taken to a peripheral part of the community range away from other rival males.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:example obo:ACTAN_0000989 "\"For example, female elephant seals that are leaving the harems of dominant bulls readily accept mating attempts by peripheral males and appear to reduce the risks of being injured by doing so.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1017/S1464793104006700") skos:example obo:ACTAN_0000989 "\"In Nephila spp., for example, large males displace smaller ones towards the periphery of the web.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:scopeNote obo:ACTAN_0000989 "\"...\"satellite\" males which sneak copulations on the periphery of dominant-male territories...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10071-014-0761-0") skos:scopeNote obo:ACTAN_0000989 "\"Individuals that prefer to use their left eye to view school mates tend to prefer positions on the right side of the school, while the reverse is true for those who prefer to view school mates with the right eye. In this way, a school might be comprised of an optimal number of fish with various degrees of laterality. Such a school would show faster responses to predators and prey on the periphery of the school while simultaneously rapidly responding to the behaviour of their school mates.\"")
SubClassOf(obo:ACTAN_0000989 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000989 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002107))

# Class: obo:ACTAN_0000990 (pectoral-fin flutter)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000990 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000990 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000990 "2026-09-20T16:58:24.735351Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") Annotation(skos:scopeNote "\"They exhibit individualistic behavior, typified by more forceful movements and a distinctive manner of swimming whereby the pectoral fins are fluttered rapidly, conspicuously displaying their blackened tips.\"") oboInOwl:hasDefinition obo:ACTAN_0000990 "Flutter which involves a pectoral fin.")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10682-007-9183-7") oboInOwl:hasExactSynonym obo:ACTAN_0000990 "pectoral fin waving")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") Annotation(skos:scopeNote "\"...pectoral fins are fluttered...\"") rdfs:label obo:ACTAN_0000990 "pectoral-fin flutter"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10682-007-9183-7") skos:example obo:ACTAN_0000990 "\"Courtship displays of R. decemdigitatus consisted of 11 steps: ... (vii) pectoral fin waving...\"")
SubClassOf(obo:ACTAN_0000990 obo:ACTAN_0000851)
SubClassOf(obo:ACTAN_0000990 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000151))

# Class: obo:ACTAN_0000991 (rush spawn)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000991 <https://github.com/Active-Animals/Ontology/patterns/group_behaviour>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000991 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000991 "2026-09-21T06:08:30.371888Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") Annotation(skos:scopeNote "\"Immediately prior to spawning, three or more fish abruptly break away from the aggregation, move forward with accelerated fin movements, and come together in a tight group, tilting their bodies upward in a diagonal position. Sometimes this abrupt forward movement is repeated several times in rapid succession. The upward spawning dash then follows, the apex at which the eggs and sperm are released.\"") oboInOwl:hasDefinition obo:ACTAN_0000991 "Spawn In which fish abruptly come together, with a female leading, tilting their bodies upward in a diagonal position, and a dash then follows, at the apex of which the eggs and sperm are released.

It may involve a pair or a group of fishes.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") oboInOwl:hasExactSynonym obo:ACTAN_0000991 "rapid upward spawning rush")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000991 "spawning dash")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") oboInOwl:hasExactSynonym obo:ACTAN_0000991 "spawning rush")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") oboInOwl:hasExactSynonym obo:ACTAN_0000991 "temporary spawning ascent")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") Annotation(skos:scopeNote "\"...upward dashing labrid aggregation...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000991 "upward dashing aggregation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000991 "rush spawn"@en)
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000991 "\"T.bifasciatum and T.lunare... Occasionally, initial phase males of these two species will participate in pair spawning activities, although this occurs in a rather peculiar fashion. An unusual trio is formed as a second male rushes up to join a pair just as gametes are being shed.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000991 "\"Thalassoma cupido...
The height of the upward dash varies considerably, from a minimum of approximately 13 cm to a maximum of about 1.5 m. Immediately after spawning, the fish move slightly apart and swim downwards with great rapidity. The wrasses may reassemble upon returning to the bottom or they may disperse. The entire spawning sequence occurs within the span of about one second.\"")
AnnotationAssertion(Annotation(dc:date "doi:10.11369/jji1950.34.76") skos:scopeNote obo:ACTAN_0000991 "\"...in some species, e.g. ostraciids and pomacanthids, such ascents are extremely slow...\"")
SubClassOf(obo:ACTAN_0000991 obo:ACTAN_0000986)
SubClassOf(obo:ACTAN_0000991 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000923))
SubClassOf(obo:ACTAN_0000991 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000406))

# Class: obo:ACTAN_0000992 (isolation constraint)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000992 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000992 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000992 "2026-09-21T11:23:45.363595Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasDefinition obo:ACTAN_0000992 "Constraint that drives another animal out of an aggregation.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000992 "isolating")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasExactSynonym obo:ACTAN_0000992 "isolation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000992 "isolation constraint"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:example obo:ACTAN_0000992 "\"...the flock of teal may release sham attacks by the falcon, resulting in the isolation of a member of the flock.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000992 "\"Thalassoma cupido...
Pair formation begins when the male encounters a female or isolates one by chasing and driving her into the algae.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.applanim.2022.105623") skos:scopeNote obo:ACTAN_0000992 "\"For most group-living organisms, social isolation results in stress, which manifests itself in various ways.\"")
SubClassOf(obo:ACTAN_0000992 obo:ACTAN_0000455)
SubClassOf(obo:ACTAN_0000992 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000801))

# Class: obo:ACTAN_0000993 (interception relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000993 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000993 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000993 "2026-09-21T17:02:11.241753Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasDefinition obo:ACTAN_0000993 "Relativity which anticipates the course of another and moves to meet it.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000993 "intercepting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000993 "interception relativity"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000993 obo:ACTAN_0000890)
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rsbl.2009.0938") skos:example obo:ACTAN_0000993 "\"...a female anuran... approaching quality territories or males may be intercepted by ‘satellite’ males, which attempt to force a mating...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10164-009-0176-6") skos:example obo:ACTAN_0000993 "\"...males in other species of cricket adopt a strategy of silently intercepting females attracted by the calls of other males...\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000993 "\"T. cupido... often a male would be forced to stray to the outskirts of his comparatively large territory... and intercept females from passing aggregations.\"")
SubClassOf(obo:ACTAN_0000993 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000993 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000375))

# Class: obo:ACTAN_0000994 (parasite mating)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000994 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000994 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000994 "2026-09-22T06:21:06.303615Z")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1011074716758") oboInOwl:hasBroadSynonym obo:ACTAN_0000994 "alternative mating tactic")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasBroadSynonym obo:ACTAN_0000994 "conditional alternative")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasBroadSynonym obo:ACTAN_0000994 "facultative alternative")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1016/S0169-5347(97)01318-9") oboInOwl:hasBroadSynonym obo:ACTAN_0000994 "parasitic tactic")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/S0169-5347(97)01318-9") oboInOwl:hasDefinition obo:ACTAN_0000994 "Mating in which an inferior exploits the investment of a primary-access rival.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1011074716758") oboInOwl:hasExactSynonym obo:ACTAN_0000994 "kleptogamy")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1011074716758") oboInOwl:hasExactSynonym obo:ACTAN_0000994 "parasitic mating")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1016/S0169-5347(97)01318-9") oboInOwl:hasExactSynonym obo:ACTAN_0000994 "reproductive parasite")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1016/S0169-5347(97)01318-9") oboInOwl:hasNarrowSynonym obo:ACTAN_0000994 "parasitic spawning")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasNarrowSynonym obo:ACTAN_0000994 "satellite")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasNarrowSynonym obo:ACTAN_0000994 "sneaking")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/beheco/12.5.534") oboInOwl:hasNarrowSynonym obo:ACTAN_0000994 "sneaky mating")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") Annotation(skos:scopeNote "\"...stole spawns...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000994 "stealing spawning")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1011074716758") Annotation(skos:scopeNote "\"...parasitically exploit other territory holder’s females...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000994 "parasitic exploitation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000994 "parasite mating")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/beheco/12.5.534") skos:example obo:ACTAN_0000994 "\"...examples are the formation of coalitions in male olive baboons Papio anubis during sneaky matings...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000994 "\"...in N micropogon a subordinate acted like a satellite male and stole spawns from the nest-building male.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000994 "\"Initial phase males of T. bifasciatum may also engage in pair spawning activities by \"sneaking\"\".")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2019.12.009") skos:scopeNote obo:ACTAN_0000994 "\"An animal behaviourist mapping the territories of individual males is especially likely to assign the label of ‘sneaker’ to a comparatively smaller male that enters an area assigned as the territory of another (usually larger) male, even if the two males do not interact with one another. Indeed, the term ‘sneaker’ suggests that the first male will behave surreptitiously to avoid interacting with the second male. A ‘sneaker’ thus can be seen as not only a transgressor of territorial boundaries but also a perpetrator of infidelity, reinforcing an underlying assumption that only the dominant, territorial figure has legitimate claim to a space or the contents of that space. 

When nonterritorial or nondominant individuals are defined primarily in terms of their purported transgressions against dominant, territorial males, it can become difficult to interpret their behaviour in any other light.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/eth.12882") skos:scopeNote obo:ACTAN_0000994 "\"Courtship plays an essential role in reproduction as it is often required for copulation to occur, with the exception of sneaky and forced copulations.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1023/A:1011074716758") skos:scopeNote obo:ACTAN_0000994 "\"However, parasitism clearly results in a significant number of inseminations and has none of the defensive costs of maintaining a territory.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:scopeNote obo:ACTAN_0000994 "\"Individuals who lose out or resign under social competition usually do not simply retire from life or sit back and watch the winners take all. They frequently adopt alternative competitive patterns, sometimes involving specialized behavior and morphology, which enable them to salvage some reproductive output even though defeated.\"")
SubClassOf(obo:ACTAN_0000994 obo:ACTAN_0000471)
SubClassOf(obo:ACTAN_0000994 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0001020))

# Class: obo:ACTAN_0000995 (daily-horizontal migration)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000995 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000995 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000995 "2026-09-22T09:36:44.052206Z")
AnnotationAssertion(Annotation(dc:source "doi:10.11369/jji1950.34.76") Annotation(skos:scopeNote "\"This almost certainly results from the fact that spawning sites and times are predictable and that thousands of labrids migrating daily along well-defined pathways to and from the spawning site attract predators.\"") oboInOwl:hasDefinition obo:ACTAN_0000995 "Migration that involves daily movements along well-defined pathways.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") oboInOwl:hasExactSynonym obo:ACTAN_0000995 "migrating daily along")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000995 "daily-horizontal migration"@en)
SubClassOf(obo:ACTAN_0000995 obo:ACTAN_0000299)
SubClassOf(obo:ACTAN_0000995 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001855))

# Class: obo:ACTAN_0000996 (swamping assistance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000996 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000996 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000996 "2026-09-22T10:52:31.185169Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/978-3-319-68576-2_3") oboInOwl:hasDefinition obo:ACTAN_0000996 "Assistance that overwhelms an antagonist's strategy.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") oboInOwl:hasExactSynonym obo:ACTAN_0000996 "swamping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000996 "swamping assistance"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/978-3-319-68576-2_3") skos:example obo:ACTAN_0000996 "\"Hexagenia mayflies from western Lake Erie...
Aerial reproductive swarming of this magnitude also serves as predator defense, as the massive pulse of food for local predators overwhelms the predator community to the point of satiation.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.11369/jji1950.34.76") skos:example obo:ACTAN_0000996 "\"Thalassoma cupido...
...swamping of egg predators with clusters of spawnings may be a partially effective defense.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:scopeNote obo:ACTAN_0000996 "\"...shoaling associations... are mutualistic associations, by swamping territorial herbivores and gaining access to defended resources.\"")
SubClassOf(obo:ACTAN_0000996 obo:ACTAN_0000878)
SubClassOf(obo:ACTAN_0000996 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000110))

# Class: obo:ACTAN_0000997 (clustering caring)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000997 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000997 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000997 "2026-09-22T10:53:31.856777Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.11369/jji1950.34.76") Annotation(skos:scopeNote "\"However, swamping of egg predators with clusters of spawnings may be a partially effective defense.\"") oboInOwl:hasDefinition obo:ACTAN_0000997 "Caring that involves defense against egg predators by swamping them.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") Annotation(skos:scopeNote "\"...clusters of spawnings...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000997 "cluster of spawnings")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000997 "clustering caring"@en)
SubClassOf(obo:ACTAN_0000997 obo:ACTAN_0000479)
SubClassOf(obo:ACTAN_0000997 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000996))

# Class: obo:ACTAN_0000998 (peck dominance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000998 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000998 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000998 "2026-09-23T09:27:02.413033Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") Annotation(skos:scopeNote "\"Hierarchy structures can vary from linear (an a-animal dominates all group members, a b-animal dominates all group members except a, and so on until the w-animal, which is subordinate to all group members) at one extreme, to the other extreme where one group member dominates all other group members, which are equal in rank (despotism).\"") oboInOwl:hasDefinition obo:ACTAN_0000998 "Dominance in which an alpha-animal dominates all group members, a beta-animal dominates all group members except alpha, and so on until the omega-animal, which is subordinate to all group members.")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") oboInOwl:hasExactSynonym obo:ACTAN_0000998 "linear dominance hierarchy")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000998 "pecking order")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000998 "straight line dominance")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") rdfs:label obo:ACTAN_0000998 "peck dominance"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") skos:example obo:ACTAN_0000998 "\"...the dominant juvenile white-seabream carry out aggressive attacks selectively on fish whose subordination level is immediately inferior to their own. Attacks are more frequently directed at the following individual in the hierarchical order, establishing a peck-dominance hierarchy.\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000998 "\"Ardeola ibis...
Fighting and pecking among siblings during feeds is very common, dominance relations being entirely based on their ages. Frequently (57% of 32 feeds), the oldest chick pecks, bites and buffets its sibling and chases it around the nest site., ceasing its attack only when the subordinate chick is well away from the parent.... Chicks never peck
older siblings. This rule is inviolable, so much so that in three-chick broods the middle chick only pecks the youngest, although the latter seldom effectively competes, the oldest sibling grabbing most of the food.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") skos:scopeNote obo:ACTAN_0000998 "\"...many rank orders in fairly small groups (usually with a sparse number of individuals) of animals are linear.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000998 "\"...the \"pecking order\" so common in fowls presupposes that members of the same species are bound together by a very positive social reflex...\"")
SubClassOf(obo:ACTAN_0000998 obo:ACTAN_0000387)
SubClassOf(obo:ACTAN_0000998 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000110))

# Class: obo:ACTAN_0000999 (challenge competition)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000999 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000999 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000999 "2026-09-23T10:55:01.661639Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") Annotation(skos:scopeNote "\"In the same way, the ascending attacks, although furtive, represent a possibility of ascending in status if they are successful.\"") oboInOwl:hasDefinition obo:ACTAN_0000999 "Competition in which an attack ascends a hierarchy.")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") oboInOwl:hasExactSynonym obo:ACTAN_0000999 "challenging")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000999 "challenge competition"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000999 "\"Chimpanzee...
...retaliation by a dominant individual to a challenging subordinate...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") skos:scopeNote obo:ACTAN_0000999 "\"...the “boldest” subordinate would always be expected to challenge the dominant fish more than the other subordinates. Thus, this trend would be an automatic outcome of variation in willingness to take risks. We could also deduce that once the dominant fish relinquished the resource (because it was satiated) to the second fish in line, the entire process would begin again with the “boldest” of the remaining subordinates challenging the third fish in line more than the others (and so on).\"")
SubClassOf(obo:ACTAN_0000999 obo:ACTAN_0000389)
SubClassOf(obo:ACTAN_0000999 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000382))

# Class: obo:ACTAN_0001000 (associate territorialism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001000 <https://github.com/Active-Animals/Ontology/patterns/group_behaviour>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001000 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001000 "2026-09-27T08:10:44.740756Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasDefinition obo:ACTAN_0001000 "Territorialism in which a more contributing, dominant host allows a less contributing, subordinate a limited share of space.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasExactSynonym obo:ACTAN_0001000 "squatting")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasNarrowSynonym obo:ACTAN_0001000 "nest associate")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasRelatedSynonym obo:ACTAN_0001000 "communal nesting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001000 "associate territorialism"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0001000 "\"...a male N leptocephalus defended a relatively small territory around his spawning pit (i.e., average area was 22% of total available substrate on upstream slope of nest). As a result, up to five subordinate males, termed “squatters,” were able to establish territories over an occupied nest.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0001000 "\"Spawning in Nocomis leptocephalus.—In Sinking Creek two males spawned over a single mound nest about 70 cm in diameter and 13 cm high at its center. Each male occupied a spawning pit approximately 4 cm wide, 6 cm long and 2.5 cm deep. The pits were within 10 cm of each other on the upstream slope, one slightly upstream of the other. The larger male (=resident) occupied the more upstream pit and had constructed the nest. Both males concurrently and independently spawned with females over their respective pits; how ever, the resident male participated in the majority of spawns.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:scopeNote obo:ACTAN_0001000 "\"Interaction of host and nest associate is thought to be mutualistic. Eggs and larvae of associates benefit from the parental care of nesting chub, and offspring of both host and associate may benefit from a dilution effect whereby predation risk per egg is reduced in the nest.\"")
SubClassOf(obo:ACTAN_0001000 obo:ACTAN_0000291)
SubClassOf(obo:ACTAN_0001000 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000110))

# Class: obo:ACTAN_0001001 (run spawn)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001001 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001001 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001001 "2026-09-27T09:38:23.900265Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") Annotation(skos:scopeNote "\"A successful spawning run always was initiated by the female. With her body pressed to the substrate, she quickly swam about 3—5 cm upstream while quivering her tail and caudal peduncle. The male remained tilted as he promptly accompanied her short run with rapid tail beats.\"") oboInOwl:hasDefinition obo:ACTAN_0001001 "Spawn in which a female initiates a quick, short, substratal, accompanied swim.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasRelatedSynonym obo:ACTAN_0001001 "run")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:comment obo:ACTAN_0001001 "Not to be confused with the migration-type 'spawning run'.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") Annotation(skos:scopeNote "\"...spawning run...\"") rdfs:label obo:ACTAN_0001001 "run spawn"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0001001 "\"...a female N. micropogon initiated her spawning run as the male tilted. Following the contour of the substrate, she swam about 5—10 cm upstream with her dorsum appressed to the male’s anterior flank and her side often crowded against a wall of the trough. The tilted male remained slightly ahead as he accompanied her run with 3—7 distinct tail beats.\"")
SubClassOf(obo:ACTAN_0001001 obo:ACTAN_0000986)
SubClassOf(obo:ACTAN_0001001 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000658))

# Class: obo:ACTAN_0001002 (antiparalleling alignment)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001002 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001002 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001002 "2026-09-27T15:32:22.717477Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1023/A:1011074716758") oboInOwl:hasDefinition obo:ACTAN_0001002 "Alignment that is alongside another, head-to-tail.")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2011.0690") oboInOwl:hasExactSynonym obo:ACTAN_0001002 "antiparalleling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001002 "antiparalleling alignment"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1023/A:1011074716758") skos:example obo:ACTAN_0001002 "\"For A. nigricaudus... male presses close to the female, usually in a head-to-tail position...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2011.0690") skos:example obo:ACTAN_0001002 "\"Zebrafish...
Two fish approach one another in opposite directions and with erected fins, and in an antiparallel position circle each other usually ascending in the water column.\"")
SubClassOf(obo:ACTAN_0001002 obo:ACTAN_0000922)
SubClassOf(obo:ACTAN_0001002 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001933))

# Class: obo:ACTAN_0001003 (flush hunt)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001003 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001003 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001003 "2026-09-28T08:34:03.661574Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.jstor.org/stable/4084834") Annotation(skos:scopeNote "\"In walk quickly, a heron walks through shallow water or fields catching prey disturbed by its movements.\"") oboInOwl:hasDefinition obo:ACTAN_0001003 "Hunt in which a predator catches prey disturbed by its movements.")
AnnotationAssertion(Annotation(dc:date "1976"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/4084834") oboInOwl:hasExactSynonym obo:ACTAN_0001003 "flushing")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "ISBN:9789798105975") oboInOwl:hasRelatedSynonym obo:ACTAN_0001003 "beating")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001003 "flush hunt"@en)
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:example obo:ACTAN_0001003 "\"Smaller juvenile Mycteroperca rosacea and Bodianus diplotaenia both spent more time as associates in foraging associations than larger adults. This is probably because juveniles feed on benthic invertebrates, flushed out by the nuclear species with which they associate, whereas the adults tend to be piscivores.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4161407") skos:example obo:ACTAN_0001003 "\"Three jaegers were seen flying together about 15 m high when a Semipalmated Sandpiper (C. pusilla) flushed beneath them.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.239.4847.1525") skos:example obo:ACTAN_0001003 "\"When a rabbit found temporary refuge or cover, a flush-and-ambush strategy was employed. Here, the hawks surrounded and alertly watched the location where the quarry disappeared while one or possibly two hawks attempted to penetrate the cover. When the rabbit flushed, one or more of the perched birds pounced and made the kill.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:scopeNote obo:ACTAN_0001003 "\"In multispecies insectivorous bird flocks individuals gain access to insects that are flushed out by the movement or ‘beating’ of the flock as a whole.\"")
SubClassOf(obo:ACTAN_0001003 obo:ACTAN_0000358)
SubClassOf(obo:ACTAN_0001003 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002017))

# Class: obo:ACTAN_0001004 (forage indirect-sample)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001004 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001004 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001004 "2026-09-28T09:48:15.32854Z")
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.1126/science.239.4847.1525") oboInOwl:hasBroadSynonym obo:ACTAN_0001004 "social foraging")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "ISBN:9789798105975") Annotation(skos:scopeNote "\"Social foraging may enhance the ability of some individuals in a group locate and consume prey through the transfer of information regarding the location and/or the nature of potential food sources. Enhanced prey detection occurs when individuals are attracted to a food source or patch when behavioural cues of successful foraging are displayed by other individuals in the group.\"") oboInOwl:hasDefinition obo:ACTAN_0001004 "Indirect-sample which enhances the ability of an individual in a group to locate and consume food, through the transfer of information regarding its location and nature, by cues of success displayed by other individuals in the group.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001004 "forage indirect-sample"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.239.4847.1525") skos:example obo:ACTAN_0001004 "\"In the Aplomado falcon (Falco femoralis), tandem hunts were less frequent than solo hunts (29% of hunts observed), but social foraging may have resulted in a greater probability of capturing birds.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:example obo:ACTAN_0001004 "\"Movement patterns of multi-species finch flocks in the Mohave Desert indicated that feeding was maximised in areas where flocks travelled while depleted areas were avoided. By contrast when birds fed alone they would often search for food in areas previously visited by other birds.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:scopeNote obo:ACTAN_0001004 "\"Enhanced prey detection can operate on large spatial scales, whereby animals find large prey aggregations, and small spatial scales, when individuals are attracted to food patches through social attraction within a foraging group. The advantages of social foraging are greater to multi-species groups compared with single species groups, as individuals benefit from the combined searching skills of each individual species.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12934") skos:scopeNote obo:ACTAN_0001004 "\"When navigating, animals inevitably rely on the integration of spatial and social information to decide when and where to move and social foraging presents a clear case where the decisions on movement goals reflect the social environment.\"")
SubClassOf(obo:ACTAN_0001004 obo:ACTAN_0000410)
SubClassOf(obo:ACTAN_0001004 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0015004))

# Class: obo:ACTAN_0001005 (facilitation interaction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001005 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001005 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001005 "2026-09-28T10:24:46.835477Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "ISBN:9789798105975") Annotation(skos:scopeNote "\"Social facilitation results when foraging by a number of individuals, stimulates foraging in other group member, thus increasing their food intake.\"") oboInOwl:hasDefinition obo:ACTAN_0001005 "Interaction in which behaviour by an individual stimulates similar behaviour in another.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "ISBN:9789798105975") oboInOwl:hasExactSynonym obo:ACTAN_0001005 "social facilitation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001005 "facilitation interaction"@en)
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:example obo:ACTAN_0001005 "\"Thus the association between the congenerics P. barberinus and P. indicus, may benefit both species through increased access to food, enhanced prey detection and social facilitation, however it may also result in competition between the two species.\"")
SubClassOf(obo:ACTAN_0001005 obo:ACTAN_0000383)
SubClassOf(obo:ACTAN_0001005 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000110))

# Class: obo:ACTAN_0001006 (alarm indirect-sample)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001006 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001006 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001006 "2026-09-28T11:09:16.260877Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "ISBN:9789798105975") Annotation(skos:scopeNote "\"Alarmed conspecifics trigger a change in behaviour of other group members to increased vigilance or hiding.\"") oboInOwl:hasDefinition obo:ACTAN_0001006 "Indirect-sample in which a change to an animal's vigilance is triggered by a change in behaviour of a group member.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001006 "alarm indirect-sample"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0001006 obo:ACTAN_0000367)
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:example obo:ACTAN_0001006 "\"Fish interpret conspecifics feeding as a sign that it is safe to feed, thus spend more time feeding and less maintaining antipredator vigilence.\"")
SubClassOf(obo:ACTAN_0001006 obo:ACTAN_0000410)
SubClassOf(obo:ACTAN_0001006 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000576))

# Class: obo:ACTAN_0001007 (scavenge forage)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001007 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001007 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001007 "2026-09-28T13:02:24.340462Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.120.1.283") Annotation(skos:scopeNote "\"Usually, by day it is quiescent and at night it descends to the beaches to scavenge organic debris along the moist sand.\"") oboInOwl:hasDefinition obo:ACTAN_0001007 "Forage that involves organic debris.")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0001007 "scavenging")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001007 "scavenge forage"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.3897/BDJ.8.e53712") skos:example obo:ACTAN_0001007 "\"...in the Mexican Caribbean, we observed unusual behaviour of a group of Acanthurus chirurgus, which were feeding on a tuna head left on site by travel tour personnel.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2026.123487") skos:example obo:ACTAN_0001007 "\"...the burying beetles, Nicrophorus ssp... bury carrion (serving as food source for their dependent, larval offspring nearby) to protect it from other scavengers...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0001007 "\"Chimpanzee...
Eat the carcass of mammals that have not been killed by oneself or one's companions.\"")
SubClassOf(obo:ACTAN_0001007 obo:ACTAN_0000353)
SubClassOf(obo:ACTAN_0001007 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01000155))

# Class: obo:ACTAN_0001008 (exploit competition)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001008 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001008 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001008 "2026-09-30T07:22:37.386434Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/s00265-020-02893-2") Annotation(skos:scopeNote "\"Exploitative competition refers to indirect negative interactions resulting from species using the same, limited resources, such as food or water.\"") oboInOwl:hasDefinition obo:ACTAN_0001008 "Competition which involves indirect negative interaction resulting from using the same, limited resources.")
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2003.11.017") oboInOwl:hasExactSynonym obo:ACTAN_0001008 "exploitative competition"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001008 "exploit competition"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00265-020-02893-2") skos:example obo:ACTAN_0001008 "\"...one explanation for the ability of P. siculus to exploit food resources in the presence of the native species may be due to the invasive species’ personality traits. An invasive species can better exploit food resources by being bolder than native species and P. siculus has been shown to be not only bolder, but also more exploratory and neophilic than P. virescens at the same study site.\"")
SubClassOf(obo:ACTAN_0001008 obo:ACTAN_0000389)
SubClassOf(obo:ACTAN_0001008 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000046))

# Class: obo:ACTAN_0001009 (resemblance crypsis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001009 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001009 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001009 "2026-09-30T19:55:51.459906Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") Annotation(skos:scopeNote "\"In the former an animal resembles some object which is of no interest to its enemy, and in so doing is concealed;

For the purpose of this report, protective resemblance is used for an animal that closely resembles a part of a substratum, a plant, or a sedentary animal such as a sponge or soft coral.\"") oboInOwl:hasDefinition obo:ACTAN_0001009 "Crypsis in which an animal resembles some object which is of no interest to its enemy, and in so doing is concealed.

This may be a part of a substratum, a plant, or a sedentary animal such as a sponge or soft coral.")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0001009 "protective resemblance")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001009 "resemblance crypsis"@en)
AnnotationAssertion(Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") skos:example obo:ACTAN_0001009 "\"...the juvenile labrid Novaculichthys taeniourus, which looks like drifting algae (the deception enhanced by its seemingly disoriented movement);\"")
SubClassOf(obo:ACTAN_0001009 obo:ACTAN_0000461)
SubClassOf(obo:ACTAN_0001009 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00010483))

# Class: obo:ACTAN_0001010 (mimicry deception)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001010 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001010 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001010 "2026-10-01T08:20:59.127236Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") Annotation(skos:scopeNote "\"From observations of the Cleaner Wrasse Labroides dimidiatus and the Mimic Blenny Aspidontus taeniatus, Randall and Randall revised Poulton's definition of mimicry to ”... an animal resembles an object which is well known and is avoided or not preyed upon by its enemy, and in so doing becomes conspicuous.

Mimicry applies only to animals that resemble active animals. In addition to resemblance in color and morphology, the mimic may adopt a pattern of behavior to enhance the deception.”") oboInOwl:hasDefinition obo:ACTAN_0001010 "Deception in which an animal resembling another active animal, which is well known and not preyed upon by its enemy, adopts a pattern of behavior to enhance the deception, and in so doing becomes conspicuous.")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasNarrowSynonym obo:ACTAN_0001010 "Batesian mimicry")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0001010 "Müllerian mimicry")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") Annotation(skos:scopeNote "\"Some deceptions, e.g., mimicry...\"") rdfs:label obo:ACTAN_0001010 "mimicry deception"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0001010 obo:ACTAN_0001009)
AnnotationAssertion(Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") skos:example obo:ACTAN_0001010 "\"A small sole from Papua New Guinea, estimated to be 12 mm in length by the photographer, appears to be a juvenile of an undetermined species of Soleichthys. It moves slowly over the bottom like a flatworm and is believed to be a mimic of an undescribed polyclad of the genus Pseudoceros.\"")
AnnotationAssertion(Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") skos:example obo:ACTAN_0001010 "\"Schooling juveniles of the Convictfish Pholidichthys leucotaenia look very much like schools of the juvenile venomous catfish Plotosus lineatus. The catfish aggregate closely for the mutual protection provided by their spines, and Convictfish juveniles may also form dense schools, although they tend to be more dispersed.\"")
AnnotationAssertion(Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") skos:scopeNote obo:ACTAN_0001010 "“In Batesian mimicry a relatively scarce, palatable, and unprotected species resembles an abundant, relatively unpalatable, or well-protected species, and so becomes disguised. In Müllerian mimicry, on the other hand, a number of different species, all possessing aposematic attributes and appearance, resemble one another, and so become more easily recognized.”")
SubClassOf(obo:ACTAN_0001010 obo:ACTAN_0000458)
SubClassOf(obo:ACTAN_0001010 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000463))

# Class: obo:ACTAN_0001011 (social mimicry)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001011 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001011 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001011 "2026-10-01T11:38:07.855475Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") Annotation(skos:scopeNote "\"Dafni and Diamant proposed the term school-oriented mimicry when a normally solitary fish species mingles with a similar aggregating species for the advantage of schooling.\"") oboInOwl:hasDefinition obo:ACTAN_0001011 "Mimicry in which a normally solitary fish mingles with a similar species for the advantages of aggregating.")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0001011 "school-oriented mimicry")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") rdfs:label obo:ACTAN_0001011 "social mimicry"@en)
AnnotationAssertion(Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") skos:example obo:ACTAN_0001011 "\"...the goatfish Mulloidichthys mimicus from the Marquesas Is. and Line Is.; its species name is in reference to its close resemblance to the snapper Lutjanus kasmira with which it often schools\"")
SubClassOf(obo:ACTAN_0001011 obo:ACTAN_0001010)
SubClassOf(obo:ACTAN_0001011 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000047))

# Class: obo:ACTAN_0001012 (operculum gape)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001012 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001012 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001012 "2026-10-01T14:17:59.982958Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0001012 "Gape which results from operculum gaping.")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10682-007-9183-7") oboInOwl:hasExactSynonym obo:ACTAN_0001012 "opercular spread")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001012 "operculum gape"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10682-007-9183-7") skos:example obo:ACTAN_0001012 "\"Courtship displays of R. decemdigitatus consisted of 11 steps: ... (v) opercular spread displays, in which the male widely opens and closes the operculum...\"")
SubClassOf(obo:ACTAN_0001012 obo:ACTAN_0000723)
SubClassOf(obo:ACTAN_0001012 ObjectSomeValuesFrom(obo:RO_0000057 obo:ZFA_0000555))

# Class: obo:ACTAN_0001013 (tail flaring)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001013 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001013 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001013 "2026-10-02T08:27:04.38836Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.021360") Annotation(skos:scopeNote "\"The mean tail height for braking maneuvers was similar initially to the mean tail height during gliding (4.7±0.06cm) and increased by approximately 1 cm when the dorsal and ventral lobes of the tail were fully flared.\"") oboInOwl:hasDefinition obo:ACTAN_0001013 "Flaring which involves the tail.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(skos:scopeNote "\"...caudal fin... cupped ;\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0001013 "caudal fin cupping")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.021360") Annotation(skos:scopeNote "\"...flaring... the caudal fin...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0001013 "caudal fin flaring")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.021360") Annotation(skos:scopeNote "\"...tail... flared.\"") rdfs:label obo:ACTAN_0001013 "tail flaring"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.021360") skos:example obo:ACTAN_0001013 "\"...bluegill sunfish, Lepomis macrochirus...

Braking maneuvers followed acceleration towards prey and were characterized by a rapid flaring of the dorsal and ventral lobes of the caudal fin in opposite directions.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0001013 "\"Badis badis...

The caudal fin frequently is compressed and held to one side partially cupped ;\"")
SubClassOf(obo:ACTAN_0001013 obo:ACTAN_0000669)
SubClassOf(obo:ACTAN_0001013 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002415))

# Class: obo:ACTAN_0001014 (pectoral-fin flaring)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001014 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001014 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001014 "2026-10-02T08:27:18.59266Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(skos:scopeNote "\"The pectoral fins tend to be cupped with the concave surface directed anteriolaterally.\"") oboInOwl:hasDefinition obo:ACTAN_0001014 "Flaring which involves a pectoral fin.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0001014 "pectoral fin cupping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001014 "pectoral-fin flaring"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.020263") skos:example obo:ACTAN_0001014 "\"Within a complete stroke cycle, motions of the maneuvering pectoral fins of a forward-sinking parrot cichlid executing a CFP involved sequential fin movements of... (2) rotating and cupping the fin (i.e. stroke reversal)...\"")
SubClassOf(obo:ACTAN_0001014 obo:ACTAN_0000669)
SubClassOf(obo:ACTAN_0001014 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000151))

# Class: obo:ACTAN_0001015 (insemination gamete-release)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001015 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001015 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001015 "2026-10-02T16:33:03.284974Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1006/anbe.1995.0166") Annotation(skos:scopeNote "\"For instance, in many birds lacking a penis, sperm transfer can relatively easily be prevented by the female.\"") oboInOwl:hasDefinition obo:ACTAN_0001015 "Gamete-release in which sperm is transferred.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1011074716758") oboInOwl:hasExactSynonym obo:ACTAN_0001015 "insemination")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasExactSynonym obo:ACTAN_0001015 "sperm transfer")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "doi:10.1086/342821") Annotation(skos:scopeNote "\"...to donate sperm.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0001015 "sperm donation")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00265-010-0980-6") Annotation(skos:scopeNote "\"...inseminate... by... copulations.\"") rdfs:label obo:ACTAN_0001015 "insemination gamete-release"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00265-010-0980-6") skos:example obo:ACTAN_0001015 "\"Male guppies are notorious for their sexual vigour. They devote most of their time trying to inseminate females, either by copulating, preceded by courtship, with the female’s consent, or by attempting forced copulations.\"")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "ISBN:9781482294347") skos:example obo:ACTAN_0001015 "\"Salamanders do not possess an intromittent organ, so insemination is accomplished by sperm transfer via a spermatophore.\"")
AnnotationAssertion(skos:scopeNote obo:ACTAN_0001015 "\"In conditional reciprocity, individuals donate sperm only in exchange for their partner’s sperm. Conditional reciprocity will have a stabilizing effect on hermaphroditism since it prevents the evolution of female-type individuals.\"")
SubClassOf(obo:ACTAN_0001015 obo:ACTAN_0000852)
SubClassOf(obo:ACTAN_0001015 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000853))

# Class: obo:ACTAN_0001016 (restraint catch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001016 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001016 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001016 "2026-10-03T09:10:23.309971Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasDefinition obo:ACTAN_0001016 "Catch in which continued physical resistance is forcefully overcome.")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasExactSynonym obo:ACTAN_0001016 "restraining")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001016 "restraint catch"@en)
AnnotationAssertion(Annotation(dc:source "ISBN:9781482294347") skos:example obo:ACTAN_0001016 "\"Salamandrid courtship...

Restraint of the female (FR) using the tail, hind limbs and jaws (Euproctus).\"")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2014.08.051") skos:scopeNote obo:ACTAN_0001016 "\"In crickets... physical restraint leads to the production of vigorous resistance reflexes driven by bursting activity by all excitatory motor neurons.\"")
SubClassOf(obo:ACTAN_0001016 obo:ACTAN_0000907)
SubClassOf(obo:ACTAN_0001016 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001230))

# Class: obo:ACTAN_0001017 (harassment manipulation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001017 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001017 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001017 "2026-10-03T10:27:00.313427Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasDefinition obo:ACTAN_0001017 "Manipulation in which persistence induces a contestant to give up costly resistance early on.

This may result in a risk reduction for the loser and/or the winner.")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1367395") oboInOwl:hasExactSynonym obo:ACTAN_0001017 "demanding")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(rdfs:comment "\"...harassed by another...\"") oboInOwl:hasExactSynonym obo:ACTAN_0001017 "harassment")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasExactSynonym obo:ACTAN_0001017 "war of attrition")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1367395") oboInOwl:hasNarrowSynonym obo:ACTAN_0001017 "begging")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001017 "harassment manipulation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:example obo:ACTAN_0001017 "\"In a variety of species, females attempt to avoid harassment but will accept matings from harassing males when they cannot escape. For example, female elephant seals that are leaving the harems of dominant bulls readily accept mating attempts by peripheral males and appear to reduce the risks of being injured by doing so.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/1367395") skos:scopeNote obo:ACTAN_0001017 "\"Since begging fledglings can commonly supplant their parents, it may be more appropriate to call begging displays “demand behavior.”\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.239.4847.1525") skos:scopeNote obo:ACTAN_0001017 "\"The probable advantages of team hunting include... the ability to harass the intended prey to exhaustion, increasing its vulnerability.\"")
SubClassOf(obo:ACTAN_0001017 obo:ACTAN_0000464)
SubClassOf(obo:ACTAN_0001017 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000441))

# Class: obo:ACTAN_0001018 (intimidation manipulation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001018 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001018 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001018 "2026-10-03T10:28:09.835155Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") Annotation(rdfs:comment "\"Intimidation is temporarily spiteful, since an individual temporarily reduces its own fitness by performing an act of punishment. As in the case of reciprocal altruism, the strategy is maintained by a deferred benefit: in a longer time frame, the net consequences of the action (punishment) are beneficial to the punisher, and punishment represents a selfish strategy.\"") oboInOwl:hasDefinition obo:ACTAN_0001018 "Manipulation in which an animal performs an act of punishment, temporarily reducing its own fitness, but with net consequences that are beneficial to the punisher.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0001018 "intimidation")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasRelatedSynonym obo:ACTAN_0001018 "punishing")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasRelatedSynonym obo:ACTAN_0001018 "punishment")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001018 "intimidation manipulation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") skos:example obo:ACTAN_0001018 "\"...male White’s skinks (Liopholis whitii) will punish their female partners for extra-pair copulations, evidence of which can be detected through olfactory cues.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0001018 "\"Chimpanzee...

At Mahale, an alpha male, Ntologi, did not look at the beta male, Nsaba even if Nsaba continuously followed Ntologi apparently seeking to groom him. Apparently a kind of intimidation signaling that the alpha male does not wish to interact with the beta.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rsbl.2019.0534") skos:scopeNote obo:ACTAN_0001018 "\"One mechanism that can contribute to the stability of mutualisms is retribution in response to cheating once it has occurred (e.g. partner switching, punishment).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:scopeNote obo:ACTAN_0001018 "\"Punishment is characteristic of animals living in stable social groups where repeated contests are likely to be common and can have important effects on the evolution of social behaviour.\"")
SubClassOf(obo:ACTAN_0001018 obo:ACTAN_0000464)
SubClassOf(obo:ACTAN_0001018 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000828))

# Class: obo:ACTAN_0001019 (coercion mating)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001019 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001019 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001019 "2026-10-03T19:37:43.349586Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1006/anbe.1995.0166") Annotation(skos:scopeNote "\"Where the benefits of sexual coercion to males are high, all three male strategies may develop to a point where they have substantial costs to females...

There are theoretical reasons to expect that sexual coercion will be widespread and may often have high costs to females, although in some cases the usual sex roles may be reversed.\"") oboInOwl:hasDefinition obo:ACTAN_0001019 "Mating where the benefit of overcoming sexual resistance is high, with substantial costs to the resister.")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") Annotation(skos:scopeNote "\"...coerce... to mate...\"") oboInOwl:hasExactSynonym obo:ACTAN_0001019 "coerced mating")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasExactSynonym obo:ACTAN_0001019 "sexual coercion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001019 "coercion mating"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2019.12.009") skos:example obo:ACTAN_0001019 "\"...in a radical reframing of coho salmon mating strategies, Watters hypothesized that females in fact prefer jack males and cooperate in mating with them, whereas less-preferred hooknose males coerce females into mating.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:scopeNote obo:ACTAN_0001019 "\"...sexual coercion should probably be regarded as a third form of sexual selection, on a level with intra-sexual competition and inter-sexual mate choice.\"")
SubClassOf(obo:ACTAN_0001019 obo:ACTAN_0000471)
SubClassOf(obo:ACTAN_0001019 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000438))

# Class: obo:ACTAN_0001020 (facultative switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001020 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001020 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001020 "2026-10-04T09:07:07.670466Z")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") Annotation(skos:scopeNote "\"Indeed, it seems reasonable to hypothesize that, except in special circumstances, selection under strong local intraspecific competition should favor a facultative (rather than genetic) switch to some alternative (secondary) means of resource procurement.\"") oboInOwl:hasDefinition obo:ACTAN_0001020 "Condition switch when strong local intraspecific competition favors some secondary means of resource procurement.")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") rdfs:label obo:ACTAN_0001020 "facultative switch"@en)
SubClassOf(obo:ACTAN_0001020 obo:ACTAN_0000553)
SubClassOf(obo:ACTAN_0001020 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0015003))

# Class: obo:ACTAN_0001021 (force coercion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001021 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001021 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001021 "2026-10-04T10:35:46.655706Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1006/anbe.1995.0166") Annotation(skos:scopeNote "\"There are three main forms of sexual coercion: (1) forced copulation, where a male uses superior speed or strength to catch and physically restrain a female while he copulates with her by force;\"") oboInOwl:hasDefinition obo:ACTAN_0001021 "Coercion where a superior ability is used to catch and physically restrain a mate while copulating.")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasExactSynonym obo:ACTAN_0001021 "forced copulation")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00265-010-0980-6") oboInOwl:hasExactSynonym obo:ACTAN_0001021 "forced mating")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001021 "force coercion"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:example obo:ACTAN_0001021 "\"For example, in wild orangutans, Pongo pygmaeus, most copulations by subadult males and almost half of all copulations by adult males occur after fierce female resistance has been violently overcome by the male.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00265-010-0980-6") skos:example obo:ACTAN_0001021 "\"Male guppies...

...mating with receptive females can give males an advantage in paternity because males transfer more sperm through courtship copulations than through forced copulations.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:scopeNote obo:ACTAN_0001021 "\"...forced copulation appears to be rare or absent in species where a single male can control mating access to one or more females effectively.\"")
SubClassOf(obo:ACTAN_0001021 obo:ACTAN_0001019)
SubClassOf(obo:ACTAN_0001021 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0001016))

# Class: obo:ACTAN_0001022 (intimidation coercion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001022 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001022 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001022 "2026-10-04T10:36:54.956626Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1006/anbe.1995.0166") Annotation(skos:scopeNote "\"There are three main forms of sexual coercion:... (3) intimidation, where males punish females that refuse to mate with them, thereby raising the chances that they will accept them as mates at some stage in the future.\"") oboInOwl:hasDefinition obo:ACTAN_0001022 "Coercion which punishes refusal to mate.

This raises the chances that they will accept them as mates at some stage in the future.")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasExactSynonym obo:ACTAN_0001022 "intimidation by punishment")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasExactSynonym obo:ACTAN_0001022 "sexual intimidation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001022 "intimidation coercion"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:example obo:ACTAN_0001022 "\"Male hamadryas baboons, Papio hamadryas, that defend harems will initially threaten females that stray with an eyebrow flash, but if they fail to return immediately will bite them on the neck.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:scopeNote obo:ACTAN_0001022 "\"In many social primates, males occasionally attack females for little or no obvious reason. As primatologists have suggested, these attacks may intimidate females so that they are subsequently more likely to accept mating attempts from the aggressor.\"")
SubClassOf(obo:ACTAN_0001022 obo:ACTAN_0001019)
SubClassOf(obo:ACTAN_0001022 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0001018))

# Class: obo:ACTAN_0001023 (resource inspection)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001023 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001023 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001023 "2026-10-04T16:36:14.472232Z")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/1367674") Annotation(skos:scopeNote "\"Initial contact is made by the female flying to the male’s territory and attempting to feed; she may have previously visited several other territories in order to evaluate territory quality.\"") oboInOwl:hasDefinition obo:ACTAN_0001023 "Inspection which evaluates some quality.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001023 "resource inspection"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00265-010-0980-6") skos:example obo:ACTAN_0001023 "\"...male guppies (Poecilia reticulata)...

In addition to fecundity, courting males also evaluate female receptivity because it directly affects a male’s probability of mating (i.e. due to females’ motivation to copulate).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/1367674") skos:example obo:ACTAN_0001023 "\"In C. anna and Panterpe, females may choose to mate with any male on a superior territory. In effect, they will select the end product of competition among males. This phenomenon may be widespread in species with promiscuous mating systems (including leks) where contact between the sexes is fleeting and territory quality may be more easily assessed than any subtle quality of the male himself.\"")
SubClassOf(obo:ACTAN_0001023 obo:ACTAN_0000399)
SubClassOf(obo:ACTAN_0001023 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000893))

# Class: obo:ACTAN_0001024 (intromission copulation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001024 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001024 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001024 "2026-10-05T08:01:56.90419Z")
AnnotationAssertion(Annotation(rdfs:comment "\"Intromission is a step of sexual reproduction that involves the insertion of a male intromittent organ into the cavity of a female reproductive organ to facilitate insemination and internal fertilization.\"") Annotation(rdfs:isDefinedBy "doi:10.1007/978-3-319-47829-6_346-1") oboInOwl:hasDefinition obo:ACTAN_0001024 "Copulation that involves the insertion of a male organ into the female to facilitate insemination.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0001024 "intromission")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001024 "intromission copulation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s002650100391") skos:example obo:ACTAN_0001024 "\"Hanuman langurs (Semnopithecus entellus)...

...copulation with ejaculation (male mounts female and following intromission and thrusting the male “freezes” on top of the female);\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") skos:example obo:ACTAN_0001024 "\"Spiders carry two independent sperm reservoirs in their palps, each typically destined to fill one of the paired female spermathecae. To transfer the full amount of sperm, a male must use both palps, i.e. copulate either in a symmetric position with simultaneous intromission or in alternating two-sided positions. In fact, with the exception of Tidarren, all male spiders do, or at least try to, inseminate both sides of the female.\"")
SubClassOf(obo:ACTAN_0001024 obo:ACTAN_0000485)
SubClassOf(obo:ACTAN_0001024 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0008811))

# Class: obo:ACTAN_0001025 (mating interference)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001025 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001025 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001025 "2026-10-05T09:34:13.868431Z")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") Annotation(skos:scopeNote "\"...interrupted by competing...\"") oboInOwl:hasBroadSynonym obo:ACTAN_0001025 "interruption competition"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/s00265-010-0980-6") oboInOwl:hasDefinition obo:ACTAN_0001025 "Interference which interrupts another's reproductive attempt.")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00265-010-0980-6") oboInOwl:hasNarrowSynonym obo:ACTAN_0001025 "courtship interruption")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasRelatedSynonym obo:ACTAN_0001025 "obstructing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001025 "mating interference")
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:example obo:ACTAN_0001025 "\"In Kafue lechwe, Kobus leche kafuensis, oestrous females that copulate with non-territorial males in their original herds are more than twice as likely to be interrupted by competing males while copulating compared with those mating with territorial males.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0001025 "\"The odd behavior of a small tuberculate male Campostoma anomalum (stoneroller) in breeding color disrupted 10 spawning sequences between the resident male and several female Nocomis leptocephalus (chub)... During six runs, the stoneroller physically obstructed both the female’s retroflexure and the male chub’s clasping motion.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9781482294347") skos:scopeNote obo:ACTAN_0001025 "\"...the lengthy duration of plethodontid courtships may be costly by increasing the probability of interruptions from rival males...\"")
SubClassOf(obo:ACTAN_0001025 obo:ACTAN_0000388)
SubClassOf(obo:ACTAN_0001025 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000471))

# Class: obo:ACTAN_0001026 (circumducting movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001026 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001026 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001026 "2026-10-05T17:06:14.247512Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icq147") Annotation(skos:scopeNote "\"The cameras showed that circumduction is a complex movement combining in a very fast sequence abduction, extension and pronation, S-start-type fast-start (defined as torque–thrust), and adduction movements.\"") oboInOwl:hasDefinition obo:ACTAN_0001026 "Movement that is a complex combinination of abduction, extension, pronation, and adduction.")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icq147") Annotation(skos:scopeNote "\"...circumduction is a complex movement...\"") oboInOwl:hasExactSynonym obo:ACTAN_0001026 "circumduction movement")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001026 "circumducting movement"@en)
SubClassOf(obo:ACTAN_0001026 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0001026 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002021))

# Class: obo:ACTAN_0001027 (gonopodium circumduction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001027 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001027 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001027 "2026-10-05T17:06:40.467433Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icq147") Annotation(skos:scopeNote "\"In this review we use ‘‘circumduction of the gonopodium’’ versus ‘‘swing and thrust’’ to describe in an anatomically correct manner the movement of the gonopodium towards the female’s urogenital sinus.\"") oboInOwl:hasDefinition obo:ACTAN_0001027 "Circumduction which involves movement of the gonopodium towards the female’s urogenital sinus.")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00265-010-0980-6") oboInOwl:hasExactSynonym obo:ACTAN_0001027 "gonopodial swing")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icq147") Annotation(skos:scopeNote "\"...circumduction of the gonopodium...\"") rdfs:label obo:ACTAN_0001027 "gonopodium circumduction"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icq147") skos:example obo:ACTAN_0001027 "\"During circumduction of the gonopodium, G. holbrooki as well as G. affinis males pronate the gonopodium prior to making contact with the female’s urogenital sinus. This pronation results in the gonopodium’s achieving its functional position (erect), with the dorsal groove now facing upwards.\"")
SubClassOf(obo:ACTAN_0001027 obo:ACTAN_0001026)
SubClassOf(obo:ACTAN_0001027 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0008811))

# Class: obo:ACTAN_0001028 (mutual assessment)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001028 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001028 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001028 "2026-10-06T16:44:45.319688Z")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasBroadSynonym obo:ACTAN_0001028 "fighting behavior")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2011.0690") Annotation(skos:scopeNote "\"Dyadic fights among male zebrafish have two distinct phases. The first phase consists mainly of mutual assessment behaviors, with fish assessing each other by exhibiting display, circle, and bite behaviors to determine the other fish’s relative fighting ability.\"") oboInOwl:hasDefinition obo:ACTAN_0001028 "Assessment in which a dyad determines each other’s relative fighting ability.")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2011.0690") rdfs:label obo:ACTAN_0001028 "mutual assessment"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12539") skos:scopeNote obo:ACTAN_0001028 "\"Alternatively, if size is used to assess fighting ability and the presence of the autotomizable appendage makes an individual appear larger, autotomy may compromise social/fighting status.\"")
SubClassOf(obo:ACTAN_0001028 obo:ACTAN_0000334)
SubClassOf(obo:ACTAN_0001028 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000554))
SubClassOf(obo:ACTAN_0001028 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000828))

# Class: obo:ACTAN_0001029 (olfaction perception)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001029 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001029 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001029 "2026-10-07T06:47:24.239345Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Olfactory response (olfactory behavior): Complex, odorant-evoked behavioral activity.\"") oboInOwl:hasDefinition obo:ACTAN_0001029 "Perception that responds actively to an odorant.")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00265-010-0980-6") oboInOwl:hasExactSynonym obo:ACTAN_0001029 "olfaction")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2011.0690") oboInOwl:hasExactSynonym obo:ACTAN_0001029 "olfactory response")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001029 "olfaction perception"@en)
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0001029 "\"...both odor and taste probably influence food choice in the Bob-white (Colirzus virginianus).\"")
AnnotationAssertion(skos:example obo:ACTAN_0001029 "\"Caenorhabditis elegans...

When animals detect an increase in the concentration of food odors, they prolong their roaming state to navigate to the food source. But when the concentration of food odors decreases, they transition to dwelling states.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2011.0690") skos:example obo:ACTAN_0001029 "\"In another teleost fish (i.e., tilapia, Oreochromis mossambicus)... the urine of dominants can be discriminated from that of subordinates at the levels of the olfactory organ with that of the dominants eliciting a higher olfactory response.\"")
SubClassOf(obo:ACTAN_0001029 obo:ACTAN_0000335)
SubClassOf(obo:ACTAN_0001029 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0005725))

# Class: obo:ACTAN_0001030 (timing perception)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001030 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001030 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001030 "2026-10-07T08:47:45.105787Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1098/rspb.2013.2997") Annotation(skos:scopeNote "\"The temporal structuring of behaviour may be strongly influenced by natural selection, and so it seems probable that general ‘rules’ of behaviour operate in stochastic biological systems and have naturally evolved to be optimal in specific situations or environments.\"") oboInOwl:hasDefinition obo:ACTAN_0001030 "Perception that responds by temporally structuring behaviour.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0001030 "timing")
AnnotationAssertion(Annotation(dc:date "2017"^^xsd:decimal) Annotation(dc:source "doi:10.1007/978-3-319-68576-2_3") oboInOwl:hasRelatedSynonym obo:ACTAN_0001030 "phenology")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001030 "timing perception"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/1365-2656.12640") skos:example obo:ACTAN_0001030 "\"We showed that female flycatchers preferred settling in plots with early breeding resident tits, and that this effect increased later in the season.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12891") skos:scopeNote obo:ACTAN_0001030 "\"Responses to deimatic behaviour seem to occur very quickly (i.e. reflex-like), and may use specific neural systems that do not involve time-consuming identification of the approaching stimulus in order to enable rapid life-saving responses.\"")
SubClassOf(obo:ACTAN_0001030 obo:ACTAN_0000335)
SubClassOf(obo:ACTAN_0001030 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0036255))

# Class: obo:ACTAN_0001031 (temporal switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001031 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001031 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001031 "2026-10-07T09:10:15.469918Z")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2009.09.015") rdfs:label obo:ACTAN_0001031 "temporal switch"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/j.anbehav.2009.09.015") skos:definition obo:ACTAN_0001031 "Switch that affects the timing of a behaviour.")
AnnotationAssertion(Annotation(dc:source "doi:10.1038/s41467-023-38685-1") skos:scopeNote obo:ACTAN_0001031 "\"Animals show transient or persistent modifications in their behavioral state based on shift in integrated valence of the context to ensure survival and maximize their fitness.\"")
SubClassOf(obo:ACTAN_0001031 obo:ACTAN_0000541)
SubClassOf(obo:ACTAN_0001031 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002323))

# Class: obo:ACTAN_0001032 (transience timing)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001032 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001032 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001032 "2026-10-07T11:48:45.132116Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3389/fetho.2023.1231780") Annotation(skos:scopeNote "\"Observation of short-term changes in habitat selection in response to the immediate presence or absence of predators are well suited to resolving some of this ambiguity.\"") oboInOwl:hasDefinition obo:ACTAN_0001032 "Timing which involves a short-term response.")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "doi:10.1554/06-246.1") oboInOwl:hasExactSynonym obo:ACTAN_0001032 "ephemeral condition")
AnnotationAssertion(Annotation(dc:date "2017"^^xsd:decimal) Annotation(dc:source "doi:10.1111/1365-2656.12640") oboInOwl:hasExactSynonym obo:ACTAN_0001032 "limited time")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "doi:10.1017/S1464793104006700") oboInOwl:hasExactSynonym obo:ACTAN_0001032 "short-term")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0001032 "transient")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "doi:10.1111/eth.12027") Annotation(skos:scopeNote "\"...ephemeral colour displays...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0001032 "ephemeral display")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") oboInOwl:hasNarrowSynonym obo:ACTAN_0001032 "rush")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001032 "transience timing"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.11369/jji1950.34.76") skos:example obo:ACTAN_0001032 "\"...the rapidly of the spawning rush of T. cupido serves as an excellent defense against piscivores...\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0001032 "\"Thalassoma cupido...

...transient mating pairs are formed which endure for only the short period of fertilization.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12317") skos:scopeNote obo:ACTAN_0001032 "\"...amphibians nesting in ephemeral pools and terrestrial habitats respond more strongly to precipitation which maintains their breeding sites.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/1365-2656.12640") skos:scopeNote obo:ACTAN_0001032 "\"For migratory animals with limited time to sample the environment themselves, resident heterospecifics provide information that is otherwise costly to obtain. For example, due to their earlier phenology, heterospecific residents might have completed broods, the size of which is used as an information source for settlement decisions by migrants.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/eth.12027") skos:scopeNote obo:ACTAN_0001032 "\"In schooling fish, sexually dichromatic displays might be ephemeral rather than permanent to avoid standing out in the crowd.\"")
SubClassOf(obo:ACTAN_0001032 obo:ACTAN_0001030)
SubClassOf(obo:ACTAN_0001032 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0001031))

# Class: obo:ACTAN_0001033 (mouth dig)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001033 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001033 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001033 "2026-10-12T09:08:39.680102Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1590/S1679-62252011005000018") Annotation(skos:scopeNote "\"Fish dig the substrate, catching substrate particles with its mouth and releasing them at the edge of the nest.\"") oboInOwl:hasDefinition obo:ACTAN_0001033 "Dig that involves the mouth.")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") Annotation(skos:scopeNote "\"...Mouth digging:...\"") rdfs:label obo:ACTAN_0001033 "mouth dig"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0001033 "\"Haplochromis starts digging with circling round on a definite place on the bottom, pressing with the abdomen and the tail on the sand. From this position it takes up a mouthful of sand and brings that away.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0001033 "\"Many animal architects have therefore evolved powerful morphological adaptations for digging and burrowing. Naked mole rats, for example, have large outward-facing incisors, enabling subterranean tunneling through some of the hardest of soils.\"")
SubClassOf(obo:ACTAN_0001033 obo:ACTAN_0000282)
SubClassOf(obo:ACTAN_0001033 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000165))

# Class: obo:ACTAN_0001034 (hydraulics excavation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001034 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001034 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001034 "2026-10-12T13:28:16.691131Z")
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") Annotation(rdfs:comment "\"...sediment to become fluidized, and facilitates burrowing.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0001034 "fluidization facilitated burrowing")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") oboInOwl:hasNarrowSynonym obo:ACTAN_0001034 "undulation digging")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001034 "hydraulics excavation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0001034 "\"...South American cichlid Laetacara araguaiae...

The ventral portion of the body is pressed against the substrate as the fish moves forward with fast tail beating and body undulations causing dispersion of the substrate.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") skos:scopeNote obo:ACTAN_0001034 "\"In most bivalves, contraction of the pedal retractors is accompanied by a quick adduction of the valves, which squeezes water out of the mantle cavity and into the sediment below the shell. This causes the sediment to become fluidized, and facilitates burrowing.\"")
SubClassOf(obo:ACTAN_0001034 obo:ACTAN_0000281)
SubClassOf(obo:ACTAN_0001034 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000396))
SubClassOf(obo:ACTAN_0001034 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0015029))

# Class: obo:ACTAN_0001035 (hydraulics engineering)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001035 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001035 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001035 "2026-10-12T14:02:31.618367Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1016/j.cub.2021.09.082") Annotation(skos:scopeNote "\"Like hydraulic engineers, these powerful aquatic rodents can regulate the water level by felling and moving large trees and by relocating sticks and mud.\"") oboInOwl:hasDefinition obo:ACTAN_0001035 "Engineering which regulates water levels.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") Annotation(skos:scopeNote "\"...hydraulic engineers...\"") rdfs:label obo:ACTAN_0001035 "hydraulics engineering"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0001035 "\"Beaver dams represent a conspicuous example: by modifying the pattern of water fl ow in rivers, beaver dams ultimately create large ponds, which contain an altered abundance and composition of plants and animals.\"")
SubClassOf(obo:ACTAN_0001035 obo:ACTAN_0000180)
SubClassOf(obo:ACTAN_0001035 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00002006))

# Class: obo:ACTAN_0001036 (body quiver)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001036 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001036 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001036 "2026-10-12T14:25:04.829427Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1590/S1679-62252011005000018") Annotation(skos:scopeNote "\"Quivering: fish performing repeated short and quick body undulations when near to the mate.\"") oboInOwl:hasDefinition obo:ACTAN_0001036 "Quiver that involves the body.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0001036 "body quivering")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001036 "body quiver"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0001036 "\"During breeding, the male zebrafish approaches the female and curves body around, positioning his genital pore next to hers (also see Parallel). The male then quivers in an attempt to trigger oviposition in the female; sperm is released simultaneously to fertilize the newly released eggs.\"")
SubClassOf(obo:ACTAN_0001036 obo:ACTAN_0000429)
SubClassOf(obo:ACTAN_0001036 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002100))

# Class: obo:ACTAN_0001037 (moving territorialism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0001037 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0001037 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0001037 "2026-10-13T07:14:36.04657Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1590/S1679-62252011005000018") Annotation(skos:scopeNote "\"The reduction in the frequency of threats emitted by males during the fry phase overlaps disappearance of the territory, during which the pair jointly stays close to the fry defending a moving space around the offspring, and not a well delimited physical space.\"") oboInOwl:hasDefinition obo:ACTAN_0001037 "Territorialism which defends a moving, not well delimited, physical space.

It may overlap disappearance of a territory.")
AnnotationAssertion(Annotation(dc:date "2016"^^xsd:decimal) Annotation(dc:source "doi:10.1111/1365-2656.12379") oboInOwl:hasExactSynonym obo:ACTAN_0001037 "pseudo-territorial")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0001037 "moving territorialism"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/1365-2656.12379") skos:example obo:ACTAN_0001037 "\"At several locations along its track, the wolf appeared to settle into spatially constrained behaviours we refer to as ‘pseudo-territorial’ modes before switching back to a ‘dispersive’ behaviour.\"")
SubClassOf(obo:ACTAN_0001037 obo:ACTAN_0000291)
SubClassOf(Annotation(dc:source "doi:10.1111/1365-2656.12379") obo:ACTAN_0001037 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000315))

# Class: obo:BFO_0000002 (continuant)

AnnotationAssertion(obo:IAO_0000115 obo:BFO_0000002 "An entity that exists in full at any time in which it exists at all, persists through time while maintaining its identity and has no temporal parts."@en)
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000002 "BFO 2 Reference: Continuant entities are entities which can be sliced to yield parts only along the spatial dimension, yielding for example the parts of your table which we call its legs, its top, its nails. ‘My desk stretches from the window to the door. It has spatial parts, and can be sliced (in space) in two. With respect to time, however, a thing is a continuant.’ [60, p. 240"@en)
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/0000007>) obo:IAO_0000116 obo:BFO_0000002 "Continuant doesn't have a closure axiom because the subclasses don't necessarily exhaust all possibilites. For example, in an expansion involving bringing in some of Ceuster's other portions of reality, questions are raised as to whether universals are continuants")
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/0000007>) obo:IAO_0000116 obo:BFO_0000002 "Continuant doesn't have a closure axiom because the subclasses don't necessarily exhaust all possibilites. For example, in an expansion involving bringing in some of Ceuster's other portions of reality, questions are raised as to whether universals are continuants"@en)
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/008-002>) obo:IAO_0000600 obo:BFO_0000002 "A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity. (axiom label in BFO2 Reference: [008-002])")
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/008-002>) obo:IAO_0000600 obo:BFO_0000002 "A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity. (axiom label in BFO2 Reference: [008-002])"@en)
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/126-001>) obo:IAO_0000601 obo:BFO_0000002 "if b is a continuant and if, for some t, c has_continuant_part b at t, then c is a continuant. (axiom label in BFO2 Reference: [126-001])")
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/126-001>) obo:IAO_0000601 obo:BFO_0000002 "if b is a continuant and if, for some t, c has_continuant_part b at t, then c is a continuant. (axiom label in BFO2 Reference: [126-001])"@en)
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/009-002>) obo:IAO_0000601 obo:BFO_0000002 "if b is a continuant and if, for some t, cis continuant_part of b at t, then c is a continuant. (axiom label in BFO2 Reference: [009-002])")
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/009-002>) obo:IAO_0000601 obo:BFO_0000002 "if b is a continuant and if, for some t, cis continuant_part of b at t, then c is a continuant. (axiom label in BFO2 Reference: [009-002])"@en)
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/011-002>) obo:IAO_0000601 obo:BFO_0000002 "if b is a material entity, then there is some temporal interval (referred to below as a one-dimensional temporal region) during which b exists. (axiom label in BFO2 Reference: [011-002])")
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/011-002>) obo:IAO_0000601 obo:BFO_0000002 "if b is a material entity, then there is some temporal interval (referred to below as a one-dimensional temporal region) during which b exists. (axiom label in BFO2 Reference: [011-002])"@en)
AnnotationAssertion(rdfs:isDefinedBy obo:BFO_0000002 <http://purl.allotrope.org/voc/bfo/REC/2018/04/bfo-2-0>)
AnnotationAssertion(rdfs:isDefinedBy obo:BFO_0000002 obo:bfo.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000002 "continuant")
AnnotationAssertion(rdfs:label obo:BFO_0000002 "continuant"@en)
AnnotationAssertion(skos:definition obo:BFO_0000002 "A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity. [BFO]")
AnnotationAssertion(skos:prefLabel obo:BFO_0000002 "continuant")
DisjointClasses(obo:BFO_0000002 obo:ENVO_02500000)
DisjointClasses(obo:BFO_0000002 obo:MF_0000020)
DisjointClasses(obo:BFO_0000002 obo:UBERON_0000105)

# Class: obo:BFO_0000003 (occurrent)

AnnotationAssertion(obo:BFO_0000179 obo:BFO_0000003 "occurrent")
AnnotationAssertion(obo:BFO_0000180 obo:BFO_0000003 "Occurrent")
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000003 "BFO 2 Reference: every occurrent that is not a temporal or spatiotemporal region is s-dependent on some independent continuant that is not a spatial region"@en)
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000003 "BFO 2 Reference: s-dependence obtains between every process and its participants in the sense that, as a matter of necessity, this process could not have existed unless these or those participants existed also. A process may have a succession of participants at different phases of its unfolding. Thus there may be different players on the field at different times during the course of a football game; but the process which is the entire game s-depends_on all of these players nonetheless. Some temporal parts of this process will s-depend_on on only some of the players."@en)
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000003 "Occurrent doesn't have a closure axiom because the subclasses don't necessarily exhaust all possibilites. An example would be the sum of a process and the process boundary of another process."@en)
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000003 "Simons uses different terminology for relations of occurrents to regions: Denote the spatio-temporal location of a given occurrent e by 'spn[e]' and call this region its span. We may say an occurrent is at its span, in any larger region, and covers any smaller region. Now suppose we have fixed a frame of reference so that we can speak not merely of spatio-temporal but also of spatial regions (places) and temporal regions (times). The spread of an occurrent, (relative to a frame of reference) is the space it exactly occupies, and its spell is likewise the time it exactly occupies. We write 'spr[e]' and `spl[e]' respectively for the spread and spell of e, omitting mention of the frame.")
AnnotationAssertion(obo:IAO_0000600 obo:BFO_0000003 "An occurrent is an entity that unfolds itself in time or it is the instantaneous boundary of such an entity (for example a beginning or an ending) or it is a temporal or spatiotemporal region which such an entity occupies_temporal_region or occupies_spatiotemporal_region. (axiom label in BFO2 Reference: [077-002])"@en)
AnnotationAssertion(obo:IAO_0000601 obo:BFO_0000003 "Every occurrent occupies_spatiotemporal_region some spatiotemporal region. (axiom label in BFO2 Reference: [108-001])"@en)
AnnotationAssertion(obo:IAO_0000601 obo:BFO_0000003 "b is an occurrent entity iff b is an entity that has temporal parts. (axiom label in BFO2 Reference: [079-001])"@en)
AnnotationAssertion(obo:IAO_0000602 obo:BFO_0000003 "(forall (x) (if (Occurrent x) (exists (r) (and (SpatioTemporalRegion r) (occupiesSpatioTemporalRegion x r))))) // axiom label in BFO2 CLIF: [108-001] ")
AnnotationAssertion(obo:IAO_0000602 obo:BFO_0000003 "(forall (x) (iff (Occurrent x) (and (Entity x) (exists (y) (temporalPartOf y x))))) // axiom label in BFO2 CLIF: [079-001] ")
AnnotationAssertion(rdfs:isDefinedBy obo:BFO_0000003 obo:bfo.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000003 "occurrent"@en)

# Class: obo:BFO_0000004 (independent continuant)

AnnotationAssertion(obo:BFO_0000179 obo:BFO_0000004 "ic")
AnnotationAssertion(obo:BFO_0000180 obo:BFO_0000004 "IndependentContinuant")
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000004 "a chair"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000004 "a heart"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000004 "a leg"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000004 "a molecule"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000004 "a spatial region"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000004 "an atom"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000004 "an orchestra."@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000004 "an organism"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000004 "the bottom right portion of a human torso"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000004 "the interior of your mouth"@en)
AnnotationAssertion(obo:IAO_0000115 obo:BFO_0000004 "b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t. (axiom label in BFO2 Reference: [017-002])"@en)
AnnotationAssertion(obo:IAO_0000601 obo:BFO_0000004 "For any independent continuant b and any time t there is some spatial region r such that b is located_in r at t. (axiom label in BFO2 Reference: [134-001])"@en)
AnnotationAssertion(obo:IAO_0000601 obo:BFO_0000004 "For every independent continuant b and time t during the region of time spanned by its life, there are entities which s-depends_on b during t. (axiom label in BFO2 Reference: [018-002])"@en)
AnnotationAssertion(obo:IAO_0000602 obo:BFO_0000004 "(forall (x t) (if (IndependentContinuant x) (exists (r) (and (SpatialRegion r) (locatedInAt x r t))))) // axiom label in BFO2 CLIF: [134-001] ")
AnnotationAssertion(obo:IAO_0000602 obo:BFO_0000004 "(forall (x t) (if (and (IndependentContinuant x) (existsAt x t)) (exists (y) (and (Entity y) (specificallyDependsOnAt y x t))))) // axiom label in BFO2 CLIF: [018-002] ")
AnnotationAssertion(obo:IAO_0000602 obo:BFO_0000004 "(iff (IndependentContinuant a) (and (Continuant a) (not (exists (b t) (specificallyDependsOnAt a b t))))) // axiom label in BFO2 CLIF: [017-002] ")
AnnotationAssertion(rdfs:isDefinedBy obo:BFO_0000004 obo:bfo.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000004 "independent continuant"@en)
SubClassOf(obo:BFO_0000004 obo:BFO_0000002)

# Class: obo:BFO_0000015 (process)

AnnotationAssertion(obo:BFO_0000179 obo:BFO_0000015 "process")
AnnotationAssertion(obo:BFO_0000180 obo:BFO_0000015 "Process")
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000015 "a process of cell-division, \\ a beating of the heart"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000015 "a process of meiosis"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000015 "a process of sleeping"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000015 "the course of a disease"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000015 "the flight of a bird"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000015 "the life of an organism"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000015 "your process of aging."@en)
AnnotationAssertion(obo:IAO_0000115 obo:BFO_0000015 "p is a process = Def. p is an occurrent that has temporal proper parts and for some time t, p s-depends_on some material entity at t. (axiom label in BFO2 Reference: [083-003])"@en)
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000015 "BFO 2 Reference: The realm of occurrents is less pervasively marked by the presence of natural units than is the case in the realm of independent continuants. Thus there is here no counterpart of ‘object’. In BFO 1.0 ‘process’ served as such a counterpart. In BFO 2.0 ‘process’ is, rather, the occurrent counterpart of ‘material entity’. Those natural – as contrasted with engineered, which here means: deliberately executed – units which do exist in the realm of occurrents are typically either parasitic on the existence of natural units on the continuant side, or they are fiat in nature. Thus we can count lives; we can count football games; we can count chemical reactions performed in experiments or in chemical manufacturing. We cannot count the processes taking place, for instance, in an episode of insect mating behavior.Even where natural units are identifiable, for example cycles in a cyclical process such as the beating of a heart or an organism’s sleep/wake cycle, the processes in question form a sequence with no discontinuities (temporal gaps) of the sort that we find for instance where billiard balls or zebrafish or planets are separated by clear spatial gaps. Lives of organisms are process units, but they too unfold in a continuous series from other, prior processes such as fertilization, and they unfold in turn in continuous series of post-life processes such as post-mortem decay. Clear examples of boundaries of processes are almost always of the fiat sort (midnight, a time of death as declared in an operating theater or on a death certificate, the initiation of a state of war)"@en)
AnnotationAssertion(obo:IAO_0000602 obo:BFO_0000015 "(iff (Process a) (and (Occurrent a) (exists (b) (properTemporalPartOf b a)) (exists (c t) (and (MaterialEntity c) (specificallyDependsOnAt a c t))))) // axiom label in BFO2 CLIF: [083-003] ")
AnnotationAssertion(rdfs:isDefinedBy obo:BFO_0000015 obo:bfo.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000015 "process"@en)
SubClassOf(obo:BFO_0000015 obo:BFO_0000003)

# Class: obo:BFO_0000016 (disposition)

AnnotationAssertion(obo:BFO_0000179 obo:BFO_0000016 "disposition")
AnnotationAssertion(obo:BFO_0000180 obo:BFO_0000016 "Disposition")
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000016 "an atom of element X has the disposition to decay to an atom of element Y"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000016 "certain people have a predisposition to colon cancer"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000016 "children are innately disposed to categorize objects in certain ways."@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000016 "the cell wall is disposed to filter chemicals in endocytosis and exocytosis"@en)
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000016 "BFO 2 Reference: Dispositions exist along a strength continuum. Weaker forms of disposition are realized in only a fraction of triggering cases. These forms occur in a significant number of cases of a similar type."@en)
AnnotationAssertion(obo:IAO_0000600 obo:BFO_0000016 "b is a disposition means: b is a realizable entity & b’s bearer is some material entity & b is such that if it ceases to exist, then its bearer is physically changed, & b’s realization occurs when and because this bearer is in some special physical circumstances, & this realization occurs in virtue of the bearer’s physical make-up. (axiom label in BFO2 Reference: [062-002])"@en)
AnnotationAssertion(obo:IAO_0000601 obo:BFO_0000016 "If b is a realizable entity then for all t at which b exists, b s-depends_on some material entity at t. (axiom label in BFO2 Reference: [063-002])"@en)
AnnotationAssertion(obo:IAO_0000602 obo:BFO_0000016 "(forall (x t) (if (and (RealizableEntity x) (existsAt x t)) (exists (y) (and (MaterialEntity y) (specificallyDepends x y t))))) // axiom label in BFO2 CLIF: [063-002] ")
AnnotationAssertion(obo:IAO_0000602 obo:BFO_0000016 "(forall (x) (if (Disposition x) (and (RealizableEntity x) (exists (y) (and (MaterialEntity y) (bearerOfAt x y t)))))) // axiom label in BFO2 CLIF: [062-002] ")
AnnotationAssertion(rdfs:isDefinedBy obo:BFO_0000016 obo:bfo.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000016 "disposition"@en)
SubClassOf(obo:BFO_0000016 obo:BFO_0000017)
DisjointClasses(obo:BFO_0000016 obo:BFO_0000023)

# Class: obo:BFO_0000017 (realizable entity)

AnnotationAssertion(obo:IAO_0000115 obo:BFO_0000017 "A specifically dependent continuant  that inheres in continuant  entities and are not exhibited in full at every time in which it inheres in an entity or group of entities. The exhibition or actualization of a realizable entity is a particular manifestation, functioning or process that occurs under certain circumstances."@en)
AnnotationAssertion(obo:IAO_0000117 obo:BFO_0000017 "https://orcid.org/0000-0001-8815-0078")
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/058-002>) obo:IAO_0000600 obo:BFO_0000017 "To say that b is a realizable entity is to say that b is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region and is of a type instances of which are realized in processes of a correlated type. (axiom label in BFO2 Reference: [058-002])"@en)
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/060-002>) obo:IAO_0000601 obo:BFO_0000017 "All realizable dependent continuants have independent continuants that are not spatial regions as their bearers. (axiom label in BFO2 Reference: [060-002])"@en)
AnnotationAssertion(rdfs:isDefinedBy obo:BFO_0000017 obo:bfo.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000017 "realizable entity"@en)
SubClassOf(obo:BFO_0000017 obo:BFO_0000002)
DisjointClasses(obo:BFO_0000017 obo:PATO_0000001)

# Class: obo:BFO_0000023 (role)

AnnotationAssertion(obo:IAO_0000115 obo:BFO_0000023 "A realizable entity  the manifestation of which brings about some result or end that is not essential to a continuant  in virtue of the kind of thing that it is but that can be served or participated in by that kind of continuant  in some kinds of natural, social or institutional contexts."@en)
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/061-001>) obo:IAO_0000600 obo:BFO_0000023 "b is a role means: b is a realizable entity & b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be& b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed. (axiom label in BFO2 Reference: [061-001])"@en)
AnnotationAssertion(rdfs:isDefinedBy obo:BFO_0000023 obo:bfo.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000023 "role"@en)
SubClassOf(obo:BFO_0000023 obo:BFO_0000017)

# Class: obo:BFO_0000034 (function)

AnnotationAssertion(obo:BFO_0000179 obo:BFO_0000034 "function")
AnnotationAssertion(obo:BFO_0000180 obo:BFO_0000034 "Function")
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000034 "the function of a hammer to drive in nails"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000034 "the function of a heart pacemaker to regulate the beating of a heart through electricity"@en)
AnnotationAssertion(obo:IAO_0000112 obo:BFO_0000034 "the function of amylase in saliva to break down starch into sugar"@en)
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000034 "BFO 2 Reference: In the past, we have distinguished two varieties of function, artifactual function and biological function. These are not asserted subtypes of BFO:function however, since the same function – for example: to pump, to transport – can exist both in artifacts and in biological entities. The asserted subtypes of function that would be needed in order to yield a separate monoheirarchy are not artifactual function, biological function, etc., but rather transporting function, pumping function, etc."@en)
AnnotationAssertion(obo:IAO_0000600 obo:BFO_0000034 "A function is a disposition that exists in virtue of the bearer’s physical make-up and this physical make-up is something the bearer possesses because it came into being, either through evolution (in the case of natural biological entities) or through intentional design (in the case of artifacts), in order to realize processes of a certain sort. (axiom label in BFO2 Reference: [064-001])"@en)
AnnotationAssertion(obo:IAO_0000602 obo:BFO_0000034 "(forall (x) (if (Function x) (Disposition x))) // axiom label in BFO2 CLIF: [064-001] ")
AnnotationAssertion(rdfs:isDefinedBy obo:BFO_0000034 obo:bfo.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000034 "function"@en)
SubClassOf(obo:BFO_0000034 obo:BFO_0000016)

# Class: obo:BFO_0000040 (material entity)

AnnotationAssertion(obo:IAO_0000115 obo:BFO_0000040 "An independent continuant that is spatially extended whose identity is independent of that of other entities and can be maintained through time."@en)
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000040 "BFO 2 Reference: Material entities (continuants) can preserve their identity even while gaining and losing material parts. Continuants are contrasted with occurrents, which unfold themselves in successive temporal parts or phases [60"@en)
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000040 "BFO 2 Reference: Object, Fiat Object Part and Object Aggregate are not intended to be exhaustive of Material Entity. Users are invited to propose new subcategories of Material Entity."@en)
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000040 "BFO 2 Reference: ‘Matter’ is intended to encompass both mass and energy (we will address the ontological treatment of portions of energy in a later version of BFO). A portion of matter is anything that includes elementary particles among its proper or improper parts: quarks and leptons, including electrons, as the smallest particles thus far discovered; baryons (including protons and neutrons) at a higher level of granularity; atoms and molecules at still higher levels, forming the cells, organs, organisms and other material entities studied by biologists, the portions of rock studied by geologists, the fossils studied by paleontologists, and so on.Material entities are three-dimensional entities (entities extended in three spatial dimensions), as contrasted with the processes in which they participate, which are four-dimensional entities (entities extended also along the dimension of time).According to the FMA, material entities may have immaterial entities as parts – including the entities identified below as sites; for example the interior (or ‘lumen’) of your small intestine is a part of your body. BFO 2.0 embodies a decision to follow the FMA here."@en)
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/019-002>) obo:IAO_0000600 obo:BFO_0000040 "A material entity is an independent continuant that has some portion of matter as proper or improper continuant part. (axiom label in BFO2 Reference: [019-002])"@en)
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/020-002>) obo:IAO_0000601 obo:BFO_0000040 "Every entity which has a material entity as continuant part is a material entity. (axiom label in BFO2 Reference: [020-002])"@en)
AnnotationAssertion(Annotation(obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/021-002>) obo:IAO_0000601 obo:BFO_0000040 "every entity of which a material entity is continuant part is also a material entity. (axiom label in BFO2 Reference: [021-002])"@en)
AnnotationAssertion(rdfs:isDefinedBy obo:BFO_0000040 obo:bfo.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000040 "material entity"@en)
SubClassOf(obo:BFO_0000040 obo:BFO_0000004)

# Class: obo:BFO_0000140 (continuant fiat boundary)

AnnotationAssertion(obo:BFO_0000179 obo:BFO_0000140 "cf-boundary")
AnnotationAssertion(obo:BFO_0000180 obo:BFO_0000140 "ContinuantFiatBoundary")
AnnotationAssertion(obo:IAO_0000115 obo:BFO_0000140 "b is a continuant fiat boundary = Def. b is an immaterial entity that is of zero, one or two dimensions and does not include a spatial region as part. (axiom label in BFO2 Reference: [029-001])"@en)
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000140 "BFO 2 Reference: In BFO 1.1 the assumption was made that the external surface of a material entity such as a cell could be treated as if it were a boundary in the mathematical sense. The new document propounds the view that when we talk about external surfaces of material objects in this way then we are talking about something fiat. To be dealt with in a future version: fiat boundaries at different levels of granularity.More generally, the focus in discussion of boundaries in BFO 2.0 is now on fiat boundaries, which means: boundaries for which there is no assumption that they coincide with physical discontinuities. The ontology of boundaries becomes more closely allied with the ontology of regions."@en)
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000140 "BFO 2 Reference: a continuant fiat boundary is a boundary of some material entity (for example: the plane separating the Northern and Southern hemispheres; the North Pole), or it is a boundary of some immaterial entity (for example of some portion of airspace). Three basic kinds of continuant fiat boundary can be distinguished (together with various combination kinds [29"@en)
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000140 "Continuant fiat boundary doesn't have a closure axiom because the subclasses don't necessarily exhaust all possibilites. An example would be the mereological sum of two-dimensional continuant fiat boundary and a one dimensional continuant fiat boundary that doesn't overlap it. The situation is analogous to temporal and spatial regions."@en)
AnnotationAssertion(obo:IAO_0000601 obo:BFO_0000140 "Every continuant fiat boundary is located at some spatial region at every time at which it exists"@en)
AnnotationAssertion(obo:IAO_0000602 obo:BFO_0000140 "(iff (ContinuantFiatBoundary a) (and (ImmaterialEntity a) (exists (b) (and (or (ZeroDimensionalSpatialRegion b) (OneDimensionalSpatialRegion b) (TwoDimensionalSpatialRegion b)) (forall (t) (locatedInAt a b t)))) (not (exists (c t) (and (SpatialRegion c) (continuantPartOfAt c a t)))))) // axiom label in BFO2 CLIF: [029-001] ")
AnnotationAssertion(rdfs:isDefinedBy obo:BFO_0000140 obo:bfo.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000140 "continuant fiat boundary"@en)
SubClassOf(obo:BFO_0000140 obo:BFO_0000141)

# Class: obo:BFO_0000141 (immaterial entity)

AnnotationAssertion(obo:BFO_0000179 obo:BFO_0000141 "immaterial")
AnnotationAssertion(obo:BFO_0000180 obo:BFO_0000141 "ImmaterialEntity")
AnnotationAssertion(obo:IAO_0000116 obo:BFO_0000141 "BFO 2 Reference: Immaterial entities are divided into two subgroups:boundaries and sites, which bound, or are demarcated in relation, to material entities, and which can thus change location, shape and size and as their material hosts move or change shape or size (for example: your nasal passage; the hold of a ship; the boundary of Wales (which moves with the rotation of the Earth) [38, 7, 10"@en)
AnnotationAssertion(rdfs:isDefinedBy obo:BFO_0000141 obo:bfo.owl)
AnnotationAssertion(rdfs:label obo:BFO_0000141 "immaterial entity"@en)
SubClassOf(obo:BFO_0000141 obo:BFO_0000004)

