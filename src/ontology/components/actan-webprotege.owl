# Class: obo:ACTAN_0000241 (concertina pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000241 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000241 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000241 "2024-10-04T10:24:19.26324Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icaa017") Annotation(skos:scopeNote "\"During concertina locomotion snakes have both sliding and static contact, and the head-to-tail distance changes as a convoluted region of the body provides a static anchoring region with subsequent straightening that slides the body forward.\"") oboInOwl:hasDefinition obo:ACTAN_0000241 "Gait pattern which has both sliding and static contact, and the head-to-tail distance changes as a convoluted region of the body provides a static anchoring region with subsequent straightening that slides the body forward.

In all types of concertina locomotion, the convolutions that anchor the snake via static contact are created from anterior to posterior.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") oboInOwl:hasExactSynonym obo:ACTAN_0000241 "concertina"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000241 "concertina pattern")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.009050") skos:scopeNote obo:ACTAN_0000241 "\"On horizontal and uphill perches snakes performed a variant of concertina locomotion with periodic stopping and gripping.\"")
SubClassOf(obo:ACTAN_0000241 obo:ACTAN_0000126)
SubClassOf(obo:ACTAN_0000241 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0013701))

# Class: obo:ACTAN_0000242 (lie posture)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000242 <https://github.com/Active-Animals/Ontology/patterns/posture>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000242 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000242 "2024-10-05T15:10:35.836844Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"P13. Lie: Torso orthograde posture on a relatively horizontal supporting stratum, body weight borne principally by the torso. When an individual grasps a support, the extremity bears little more than its own weight. When lying on a side an individual may support the upper body with an elbow.\"") oboInOwl:hasDefinition obo:ACTAN_0000242 "Posture that is on a relatively horizontal supporting stratum, body weight borne principally by the torso.

When an individual grasps a support, the extremity bears little more than its own weight. When lying on a side an individual may support the upper body with an elbow.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000242 "lying"@en)
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000242 "lying down")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000242 "reclining")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000242 "lie posture"@en)
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000242 "\"Liihrl (1956) said that Carrion Crows “often close their eyes with pleasure when they are lying in an ant hill.”")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000242 "\"Phycis regius has been observed to bury itself in sand and reclining on its side with the head protruding, watch the movements of other fishes with apparent interest.\"")
SubClassOf(obo:ACTAN_0000242 obo:ACTAN_0000177)
SubClassOf(obo:ACTAN_0000242 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000563))
SubClassOf(obo:ACTAN_0000242 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))

# Class: obo:ACTAN_0000243 (sit posture)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000243 <https://github.com/Active-Animals/Ontology/patterns/posture>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000243 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000243 "2024-10-05T15:10:57.053778Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"A posture in which the ischia bear substantial portion (usually more than half) of the body weight; the torso is relatively orthograde ( I ).\"") oboInOwl:hasDefinition obo:ACTAN_0000243 "Posture in which the ischia bear a substantial portion of the body weight, and the torso is relatively orthograde.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...to sit...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000243 "sitting"@en)
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") rdfs:label obo:ACTAN_0000243 "sit posture")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000243 "NBO:0000080")
SubClassOf(obo:ACTAN_0000243 obo:ACTAN_0000177)
SubClassOf(obo:ACTAN_0000243 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000565))
SubClassOf(obo:ACTAN_0000243 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))
SubClassOf(obo:ACTAN_0000243 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0001274))

# Class: obo:ACTAN_0000244 (squat crouch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000244 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000244 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000244 "2024-10-05T15:11:22.930865Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000244 "Crouch that is bipedal and orthograde.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000244 "squat")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000244 "squatting"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000244 "squat crouch")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000244 "\"The sitting bird looks up, begins to Rick-rack as its mate walks towards the nest, points its head and neck upwards in a low intensity Stretch movement then squats downwards, simultaneously giving the harsh \"roo\" call.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ajpa.1330870108") skos:example obo:ACTAN_0000244 "[Re: Chimpanzees]
\"Squatting was observed often on vertical and subvertical (i.e., near-vertical) WBS. The WBS was grasped with the feet and the upper body was stabilized with an arm. Fruit found in small trees was harvested most often by squatting, perhaps because the trunk itself was the largest and most stable perch from which to feed.\"")
SubClassOf(obo:ACTAN_0000244 obo:ACTAN_0000248)
SubClassOf(obo:ACTAN_0000244 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002103))

# Class: obo:ACTAN_0000245 (stand posture)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000245 <https://github.com/Active-Animals/Ontology/patterns/posture>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000245 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000245 "2024-10-05T15:12:11.634392Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000245 "Posture in which the body weight is borne predominantly by the feet, with supporting legs relatively extended.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000245 "standing"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000245 "standing posture")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000245 "stand posture")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000245 "\"The rock-thrush of Guiana, birds of Paradise, and some others, congregate; and successive males display their gorgeous plumage and perform strange antics before the females, which standing by as spectators, at last choose the most attractive partner.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000245 "NBO:0000081")
SubClassOf(obo:ACTAN_0000245 obo:ACTAN_0000177)
SubClassOf(obo:ACTAN_0000245 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000523))
SubClassOf(obo:ACTAN_0000245 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))

# Class: obo:ACTAN_0000246 (sprawl lie)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000246 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000246 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000246 "2024-10-05T15:13:02.860713Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000246 "Lie that has splayed, lateralized parts.

These could be limbs or axial loops.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000246 "sprawl")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000246 "sprawling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000246 "sprawl lie")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:scopeNote obo:ACTAN_0000246 "\"Sprawl: Limbs dangled down while resting on belly, usually on a branch; sometimes used to aid cooling.\"")
SubClassOf(obo:ACTAN_0000246 obo:ACTAN_0000242)
SubClassOf(obo:ACTAN_0000246 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000626))

# Class: obo:ACTAN_0000247 (elevated-S coil)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000247 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000247 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000247 "2024-10-05T15:13:26.460572Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasDefinition obo:ACTAN_0000247 "Coil that has ventral support, a raised head, an antrorse, sinuous anterior, a coiled medio-posterior, and a raised tail.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000247 "S-coil"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000247 "elevated-S coil")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000247 "\"The evolution of an aposematic function for the rattle and associated stereotyped behavior such as the elevated S-coil appears to be linked to the coevolution of increased body size in rattlesnakes.\"")
SubClassOf(obo:ACTAN_0000247 obo:ACTAN_0000007)
SubClassOf(obo:ACTAN_0000247 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000733))
SubClassOf(obo:ACTAN_0000247 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000033))
SubClassOf(obo:ACTAN_0000247 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002415))

# Class: obo:ACTAN_0000248 (crouch posture)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000248 <https://github.com/Active-Animals/Ontology/patterns/posture>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000248 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000248 "2024-10-06T08:47:55.405279Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000248 "Posture in which the body weight is borne solely by the feet/foot, with some supporting knees or elbows strongly flexed.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000248 "crouch")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000248 "crouching"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000248 "crouch posture")
AnnotationAssertion(skos:example obo:ACTAN_0000248 "\"Pan troglodytes...
Crouch was rare (< 1% of all behavior)... in this behavior the individual stood quadrupedally on a relatively flat stratum with the elbows flexed. Rarely the knees also were slightly flexed.\"")
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000248 "\"Several of the American Robins, performing active anting, sometimes crouched, rotated or rubbed the body or breast upon the ground, or sat as if holding vent to ground.\"")
SubClassOf(obo:ACTAN_0000248 obo:ACTAN_0000177)
SubClassOf(obo:ACTAN_0000248 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000120))
SubClassOf(obo:ACTAN_0000248 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))

# Class: obo:ACTAN_0000249 (foil lift)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000249 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000249 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000249 "2026-07-15T11:18:51.595313Z")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...position as planes...\"") oboInOwl:hasBroadSynonym obo:ACTAN_0000249 "plane positioning")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www-dr.wcupa.edu/sciences-mathematics/biology/fFish/documents/1998ImaginativeDragReduction.pdf") Annotation(skos:scopeNote "\"When the hydrofoil is canted at an angle to the water flow (i.e,, angle of attack), a lift is generated due to deflection of the fluid and pressure difference between the two surfaces of the hydrofoil.\"") oboInOwl:hasDefinition obo:ACTAN_0000249 "Lift which is generated due to deflection of the fluid and pressure difference between the two surfaces, when canted at an angle to the flow.")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "https://www-dr.wcupa.edu/sciences-mathematics/biology/fFish/documents/1998ImaginativeDragReduction.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000249 "lifting hydrofoil")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000249 "foil lift"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000249 "\"In... the Triglidae, the pectorals are used as gliding planes and... in... the Dactylopteridae, they are carried a step further and the fishes rise from the surface of the water by means of their large “wings, ” somewhat after the manner of the exocoetids, but less successfully.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:scopeNote obo:ACTAN_0000249 "\"Fish swimming in the thunniform mode are characterized by a stiff caudal fin, shaped like a tapered hydrofoil of a moderate sweepback angle with a curved leading edge and a sharp trailing edge. The caudal fin performs a combination of pitching and heaving motions, tracing an oscillating path as the fish moves forward...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000249 "\"an appropriate movement of the pectorals can deflect a moving fish from a straight line to the right or left so may they by proper twisting cause it to move diagonally upwards or downwards...\"")
SubClassOf(obo:ACTAN_0000249 obo:ACTAN_0000189)
SubClassOf(obo:ACTAN_0000249 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002445))

# Class: obo:ACTAN_0000250 (propulsion lift)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000250 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000250 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000250 "2026-07-15T11:21:35.877279Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icab021") oboInOwl:hasExactSynonym obo:ACTAN_0000250 "Lift in which the animal's thrust vector is itself directed upwards or downwards.")
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.137.1.421") oboInOwl:hasExactSynonym obo:ACTAN_0000250 "directed thrust")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000250 "propulsion lift"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000250 "\"In the case of fishes whose undulations are in the vertical plane as with skates and flounders, certain of the methods of body undulation used for turning in other fishes cause ascent or descent.\"")
AnnotationAssertion(Annotation(dc:source "https://www.academia.edu/145444084/The_Figure_8_Pattern_Across_Natural_Systems_A_Critical_Examination_of_Convergent_Geometry") skos:example obo:ACTAN_0000250 "\"To generate lift on both strokes, the hummingbird must orient its wings differently on each stroke. During the forward stroke, the wing is angled to generate lift upward. During the return stroke, the wing is flipped and angled differently to again generate lift upward.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000250 "\"Fishes not actively swimming may use the pectorals somewhat as active paddles and obtain a similar result by twisting them appropriately...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rsos.170467") skos:scopeNote obo:ACTAN_0000250 "\"In squid, jet angle increases with decreasing swimming speed to provide a vertical force to counteract the negative buoyancy of squid.\"")
SubClassOf(obo:ACTAN_0000250 obo:ACTAN_0000189)
SubClassOf(obo:ACTAN_0000250 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001024))

# Class: obo:ACTAN_0000251 (anchor brake)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000251 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000251 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000251 "2026-07-15T15:46:21.264774Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...the movement is slower, in accordance with the greater resistance of the tail when spread.\"") oboInOwl:hasDefinition obo:ACTAN_0000251 "Brake that uses resistance to slow down.")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...resistance to forward movement.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000251 "movement resistance")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasNarrowSynonym obo:ACTAN_0000251 "sea anchor")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000251 "anchor brake"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000251 "\"...an abrupt stop is made by Esox with both pectorals and pelvics used as brakes.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000251 "\"Anguilliform fishes... may suddenly hold themselves rigid in any position and check the motion more gradually.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.021360") skos:example obo:ACTAN_0000251 "\"Braking was the result of contralateral flaring of the dorsal and ventral lobes of the caudal fin, resulting in increased surface area and, presumably, drag.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000251 "\"Fishes of a carangiform tendency in locomotion are not known to show a reversal of the primary locomotor movements, the pectorals playing an important part instead. These are usually stuck out equally on both sides, thus forming an effective resistance to forward movement.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:scopeNote obo:ACTAN_0000251 "\"Head-first descent: (1) Symmetrical head-first descent: similar to quadrupedal walking, except the limbs served a braking function on these steep descents (> 45 degrees) some skidding may occur; (2) head-first scramble descent: as with symmetrical head-first descent, except on multiple supports with odd orientation and sizes, and a less symmetrical gait; and (3) cascade: as with head-first scramble descent, except supports are still smaller, and radically angled. Limbs and tail grasp briefly and in rapid succession to brake descent.\"")
SubClassOf(obo:ACTAN_0000251 obo:ACTAN_0000172)
SubClassOf(obo:ACTAN_0000251 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002245))

# Class: obo:ACTAN_0000252 (gear brake)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000252 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000252 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000252 "2026-07-15T15:52:01.071776Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000252 "Brake in which a propulsion mechanism is reversed, quickly neutralising undesirable motion.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...reverse their primary locomotor “gear”...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000252 "reverse gear")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000252 "gear brake"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000252 "\"Anguilliform fishes may suddenly reverse the direction of the motion of the undulations and by this means quickly check forward movement...\"")
SubClassOf(obo:ACTAN_0000252 obo:ACTAN_0000172)
SubClassOf(obo:ACTAN_0000252 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001024))

# Class: obo:ACTAN_0000253 (slide regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000253 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000253 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000253 "2024-10-06T10:03:40.872713Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icaa017") Annotation(skos:scopeNote "\"However, some snakes actually take advantage of the forces from their weight by using it as a propulsive mechanism for moving down steep surfaces while holding a static posture and exerting a slight grip to control the speed of sliding.\"") oboInOwl:hasDefinition obo:ACTAN_0000253 "Traversing-regime that uses weight as a propulsive mechanism for moving down steep surfaces while holding a static posture and exerting a slight grip to control the speed.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000253 "sliding"@en)
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasNarrowSynonym obo:ACTAN_0000253 "firepole slide")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000253 "slide regime")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ajpa.1330870108") skos:example obo:ACTAN_0000253 "[Re: Chimpanzees]
\"Labeled firepole slide, wherein a vertical WBS, usually very large, was grasped by circumducting it with the arms and legs, after which the animal allowed its body to descend by sliding. Sometimes the arms regulated the velocity of the descent with a hand-overhand movement.\"")
SubClassOf(obo:ACTAN_0000253 obo:ACTAN_0000089)
SubClassOf(obo:ACTAN_0000253 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000251))
SubClassOf(obo:ACTAN_0000253 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))
SubClassOf(obo:ACTAN_0000253 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000530))
SubClassOf(obo:ACTAN_0000253 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000893))

# Class: obo:ACTAN_0000254 (swing gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000254 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000254 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000254 "2024-10-06T15:10:25.603001Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000254 "Traversing-gait in which pendular movement, including phases with less than two grasped appendages, in net tension, propels the animal forward.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000254 "swing")
