# Class: obo:UBERON_0000167 (oral cavity)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "ISBN:0073040584") Annotation(oboInOwl:hasDbXref "https://github.com/obophenotype/uberon/wiki/The-digestive-tract") Annotation(oboInOwl:hasDbXref "https://orcid.org/0000-0002-6601-2165") obo:IAO_0000115 obo:UBERON_0000167 "Anatomical cavity at the start of the digestive tract that that is enclosed by the mouth. The boundaries and contents vary depending on the species. In vertebrates, the boundaries are the oral opening, the cheeks, the palate and (if present) the palatoglossal arch - if this is not present then the mouth and pharynx form the oropharyngeal cavity. The buccal cavity contains the teeth, tongue and palate (when present).")
AnnotationAssertion(Annotation(oboInOwl:date_retrieved "2012-06-20") Annotation(oboInOwl:external_class "AAO:0000960") Annotation(oboInOwl:ontology "AAO") Annotation(oboInOwl:source "AAO:EJS") obo:UBPROP_0000001 obo:UBERON_0000167 "Anatomical cavity bounded anteriorly by the mouth and posteriorly by the derivatives of the branchial arches.[AAO]")
AnnotationAssertion(Annotation(oboInOwl:date_retrieved "2012-09-17") Annotation(oboInOwl:external_class "VHOG:0000188") Annotation(oboInOwl:ontology "VHOG") Annotation(oboInOwl:source "http://bgee.unil.ch/") Annotation(oboInOwl:source "http://medical-dictionary.thefreedictionary.com/oral+cavity") obo:UBPROP_0000001 obo:UBERON_0000167 "The cavity of the mouth, bounded by the jaw bones and associated structures (muscles and mucosa). [TFD][VHOG]")
AnnotationAssertion(Annotation(oboInOwl:date_retrieved "2012-09-17") Annotation(oboInOwl:external_class "VHOG:0000188") Annotation(oboInOwl:ontology "VHOG") Annotation(oboInOwl:source "ISBN:978-0030223693 Liem KF, Bemis WE, Walker WF, Grande L, Functional Anatomy of the Vertebrates: An Evolutionary Perspective (2001) p.32") Annotation(oboInOwl:source "http://bgee.unil.ch/") obo:UBPROP_0000003 obo:UBERON_0000167 "Echinoderms, hemichordates, and chordates are called deuterostomes because the mouth arises not from the blastopore but from a second invagination at the anterior end of the larva that pushes in to connect with the archenteron.[well established][VHOG]")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:20292") Annotation(oboInOwl:hasDbXref "ISBN:0073040584") oboInOwl:hasExactSynonym obo:UBERON_0000167 "buccal cavity")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:UBERON_0000167 "cavity of mouth")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:UBERON_0000167 "bucca")
AnnotationAssertion(rdfs:label obo:UBERON_0000167 "oral cavity")
SubClassOf(obo:UBERON_0000167 obo:UBERON_0002553)

