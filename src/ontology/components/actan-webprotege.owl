AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasNarrowSynonym obo:ACTAN_0000261 "quadrumanous-suspend")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasNarrowSynonym obo:ACTAN_0000261 "tail-hang")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000261 "hang posture")
SubClassOf(obo:ACTAN_0000261 obo:ACTAN_0000177)
SubClassOf(obo:ACTAN_0000261 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000523))
SubClassOf(obo:ACTAN_0000261 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000187))

