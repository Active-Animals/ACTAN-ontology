SubClassOf(obo:ACTAN_0000070 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000226))

# Class: obo:ACTAN_0000071 (alternating-tetrapod-walk gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000071 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000071 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000071 "2026-01-21T16:31:51.834262Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasDefinition obo:ACTAN_0000071 "Walk gait that realizes an octapedal pattern.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasExactSynonym obo:ACTAN_0000071 "alternating tetrapod gait walking"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000071 "alternating-tetrapod-walk gait"@en)
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000071 "\"Fiddler crabs and shore crabs used an alternating tetrapod gait significantly more often than all other gaits combined both on land and underwater.\"")
SubClassOf(obo:ACTAN_0000071 obo:ACTAN_0000134)
