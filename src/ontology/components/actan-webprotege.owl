AnnotationAssertion(terms:conformsTo obo:ACTAN_0000224 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000224 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000224 "2024-10-02T09:55:41.96859Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasDefinition obo:ACTAN_0000224 "Run gait that is diagonal-sequence, diagonal-couplet, and bouncing.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000224 "DSDC run"@en)
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000224 "diagonal-sequence, diagonal-couplet run")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000224 "DSDC-run gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") skos:example obo:ACTAN_0000224 "\"This gait is typified by the running of the duiker.\"")
