# Class: obo:ACTAN_0000655 (preference assessment)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000655 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000655 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000655 "2025-04-02T20:15:26.5441Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") oboInOwl:hasDefinition obo:ACTAN_0000655 "Assessment that chooses between resources in a pattern significantly different to the pattern of their availability.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000655 "preference"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000655 "discrimination")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000655 "distinguishing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000655 "preference assessment")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10682-007-9183-7") skos:example obo:ACTAN_0000655 "\"...R. whero females have a preference for smaller males... Larger males are often preferred in species with female mate choice due to the competitive advantage of large males incontests over mates... exceptions include moorhens, where small, fat males are preferred by females...\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000655 "\"Badis badis is strictly carnivorous... They seem to prefer these \"worms,\" such as Tubifex, Enchytraeus, and many aquatic insect larvae, to crustacea. If sufficient \"worms\" are available to the juveniles and adults, crustacea are taken only sporadically.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/1379571") skos:example obo:ACTAN_0000655 "\"The rotary sequence tends to be preferred to the transverse sequence by the fastest and most maneuverable cursors (Acinonyx, Antilope, and Gazella), and limited evidence indicates that some artiodactyls may tend to change from the transverse to the rotary gallop as speed increases.\"")
AnnotationAssertion(Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") skos:scopeNote obo:ACTAN_0000655 "\"Since B. amplus are not exclusive to artificial structures that resemble the elongated cylindrical shape of whipcorals, it is likely that their common association with specific host gorgonian species is linked to the suitability of the physical structure and the size of these host species itself, unlike some anemone fish which select their host based on an innate host-species preference.\"")
SubClassOf(obo:ACTAN_0000655 obo:ACTAN_0000334)
SubClassOf(obo:ACTAN_0000655 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0001023))

# Class: obo:ACTAN_0000656 (dorsal-fin flexion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000656 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000656 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000656 "2026-07-27T07:59:51.463909Z")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"... vertical fins can be depressed...\"") oboInOwl:hasBroadSynonym obo:ACTAN_0000656 "vertical fin depression")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000656 "Flexion that results from dorsal fin flexing.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000656 "dorsal-fin flexion"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000656 "\"In the fastest forms the vertical fins can be depressed so completely as to mar the perfection of the streamline form in no way at all.\"")
SubClassOf(obo:ACTAN_0000656 obo:ACTAN_0000120)
SubClassOf(obo:ACTAN_0000656 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0003097))

# Class: obo:ACTAN_0000657 (nesting basing)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000657 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000657 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000657 "2025-04-07T06:54:10.900312Z")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000657 "2025-09-14T19:33:44.00345Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1098/rstb.2022.0138") Annotation(skos:scopeNote "\"However, it is known that mammals construct a variety of structures many of which involve burrowing into the ground to form a network of tunnels, described by Hancocks as ‘construction by subtraction’. These burrows may be lined with plant materials simply piled up in chambers, which may provide physical comfort or affect the microenvironment in the burrow, but often such structures are resting sites. This review is not, however, concerned with the organization of these relatively simple nest structures but rather it focuses on ‘construction by addition’, where the nest involves production of a structure following some form of construction behaviour by the individual.\"") oboInOwl:hasDefinition obo:ACTAN_0000657 "Basing that involves any kind of construction.

This could be ‘construction by subtraction’ or ‘construction by addition’, and simple or complex.")
AnnotationAssertion(Annotation(dc:date "1922"^^xsd:decimal) Annotation(dc:source "doi:10.2307/2939673") oboInOwl:hasExactSynonym obo:ACTAN_0000657 "nesting"@en)
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ece3.6372") Annotation(skos:scopeNote "\"...the nest, that is, the zone where the bear gathers vegetative material to build a bed.\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000657 "bed building")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000657 "nest building"@en)
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasRelatedSynonym obo:ACTAN_0000657 "nest construction")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000657 "nesting basing"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0000657 "\"...South American cichlid Laetacara araguaiae...

Males and females built circular nests (50 to 100 mm of diameter) inside the territory on the sand bottom in shallow waters near roots or macrophyte leaves. Nests were used as a spawning site and also for care of egg and wriggler stages of the brood. At the beginning, the pairs dug several nests (two to four), but spawning occurred only in one of them. We observed, in some cases, parental fish moving brood to another previously built nest..\"")
AnnotationAssertion(Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") skos:example obo:ACTAN_0000657 "\"...taller wire-corals may provide a greater surface area for egg laying, and hence increasing wire-coral size heightens the suitability of the host as a nest-site since B. yongei are demersal spawners that lay their eggs near the tip of their host.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ajpa.1330870108") skos:example obo:ACTAN_0000657 "\"Sometimes chimpanzees carried a branch laden with fruit to a day nest or large trunk where they could lie, or fed lethargically on nearby fruit while lying in a day bed.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000657 "NBO:0000156")
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pone.0200048") skos:scopeNote obo:ACTAN_0000657 "\"Nest homeostasis provides not only an incubator for the brood, but also a thermal refuge for individuals to use temperature gradients to regulate their own body temperature.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pone.0200048") skos:scopeNote obo:ACTAN_0000657 "\"Sociality has brought many advantages to various hymenoptera species, including their ability of regulating physical factors in their nest (e.g., temperature).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3819/ccbr.2016.110005") skos:scopeNote obo:ACTAN_0000657 "\"The techniques with which birds build their nests have also been described in some detail and are also various: they range from the sculpting of burrows or cavities from substrate excavation, through the moulding of mud or salivary mucus by vibrating head and/or shaping breast and feet movements, the piling up of materials where subsequent bill manipulations, coupled with side-to-side shaking movements, may be made in order to entangle or intertwine nest components, to the weaving of hanging nest baskets using intricate tuck, looping, interlocking, winding, and knotting bill-made stitches to fasten and secure grassy materials.\"")
SubClassOf(obo:ACTAN_0000657 obo:ACTAN_0000577)
SubClassOf(obo:ACTAN_0000657 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000272))

# Class: obo:ACTAN_0000658 (demersal spawning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000658 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000658 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000658 "2025-04-07T15:03:41.596728Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5343/bms.2014.1055") Annotation(skos:scopeNote "\"Females deposit demersal eggs on the substrate, and males fertilize the eggs soon after that.\"") oboInOwl:hasDefinition obo:ACTAN_0000658 "Spawning in which eggs are deposited on the substrate.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasNarrowSynonym obo:ACTAN_0000658 "spawning run")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1011074716758") rdfs:label obo:ACTAN_0000658 "demersal spawning"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000658 obo:ACTAN_0000627)
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0000658 "\"...South American cichlid Laetacara araguaiae...

The female followed a circular path, pressed the belly against the substrate and vibrated the posterior portion of the body when entering in the nest. During these movements, female released the adhesive oocytes.\"")
AnnotationAssertion(Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") skos:example obo:ACTAN_0000658 "\"...taller wire-corals may provide a greater surface area for egg laying, and hence increasing wire-coral size heightens the suitability of the host as a nest-site since B. yongei are demersal spawners that lay their eggs near the tip of their host.\"")
SubClassOf(obo:ACTAN_0000658 obo:ACTAN_0000475)
SubClassOf(obo:ACTAN_0000658 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000659))
SubClassOf(obo:ACTAN_0000658 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00000501))

# Class: obo:ACTAN_0000659 (egg-laying mothering)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000659 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000659 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000659 "2025-04-07T15:13:22.075797Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasDefinition obo:ACTAN_0000659 "Mothering that releases eggs.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...lay fertile eggs.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000659 "laying eggs"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000659 "ovipositioning")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source <https://github.com/obophenotype/uberon/issues/3124>) rdfs:comment obo:ACTAN_0000659 "Still hoping to stimulate a new UBERON class that will fit better as a participant.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000659 "egg-laying mothering"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000659 "NBO:0020048")
AnnotationAssertion(Annotation(dc:source "doi:10.1038/s41467-023-38685-1") skos:scopeNote obo:ACTAN_0000659 "\"Egg laying impacts reproductive fitness and worms display temporal variations in bouts of egg laying activity, which are impacted by feeding status and other sensory cues.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:scopeNote obo:ACTAN_0000659 "\"These mechanisms are illustrated by the most highly integrated insect societies, which characteristically have only one, long-lived egglayer (a high degree of genetic uniformity), highly developed pheromonal suppression of egg-laying by competitors (imposed convergence of interests), and highly specialized morphological castes (mutualistic convergence of interests due to task specialization).\"")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") skos:scopeNote obo:ACTAN_0000659 "This involves the externalization of an internally fertilized ovum.")
SubClassOf(obo:ACTAN_0000659 obo:ACTAN_0000480)
SubClassOf(obo:ACTAN_0000659 ObjectSomeValuesFrom(obo:RO_0000057 obo:CL_0000025))

# Class: obo:ACTAN_0000660 (pick-suction filter)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000660 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000660 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000660 "2025-04-07T16:46:29.524213Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF01609520") Annotation(skos:scopeNote "\"When feeding, these fishes \"shoot\" the jaw forward and downward rapidly; this rapid expansion of the oral cavity creates a suction which draws prey into the cavity.\"") oboInOwl:hasDefinition obo:ACTAN_0000660 "Filter when fishes shoot the jaw forward and downward rapidly; this rapid expansion of the oral cavity creates a suction which draws prey into the cavity.")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") Annotation(skos:scopeNote "'Plankton picking' is an acknowledged misnomer and is really 'plankton sucking'.") oboInOwl:hasExactSynonym obo:ACTAN_0000660 "plankton-picking"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000660 "pick-suction filter")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000660 obo:ACTAN_0000512)
AnnotationAssertion(Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") skos:example obo:ACTAN_0000660 "\"...fish of the genus Bryaninops pick plankton drifting past, by rapidly darting out a short distance into the water column to take a food item before darting back to cling on its associate...\"")
SubClassOf(obo:ACTAN_0000660 obo:ACTAN_0000363)
SubClassOf(obo:ACTAN_0000660 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000590))
SubClassOf(obo:ACTAN_0000660 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000428))

# Class: obo:ACTAN_0000661 (procession aggregation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000661 <https://github.com/Active-Animals/Ontology/patterns/group_behaviour>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000661 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000661 "2025-04-07T19:54:16.839741Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1365-3032.2009.00697.x") oboInOwl:hasDefinition obo:ACTAN_0000661 "Aggregation that maintains single-file, head-to-tail alignment of groups of individuals.")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1365-3032.2009.00697.x") oboInOwl:hasExactSynonym obo:ACTAN_0000661 "procession")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000661 "single file"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000661 "procession aggregation")
AnnotationAssertion(Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") skos:scopeNote obo:ACTAN_0000661 "\"Field observations of how the gobies are able to spread out on separate branches on D. gemmacea, compared with being restricted to a single file on J. juncea...\"")
SubClassOf(obo:ACTAN_0000661 obo:ACTAN_0000411)
SubClassOf(obo:ACTAN_0000661 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000406))
SubClassOf(obo:ACTAN_0000661 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000407))

