# Class: obo:ACTAN_0000534 (lift-based flap)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000534 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000534 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000534 "2025-01-20T21:21:36.785234Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasDefinition obo:ACTAN_0000534 "Flap in which both strokes produce power.

In some configurations, both strokes may also produce lift.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000534 "lift-based")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000534 "vorticity method")
AnnotationAssertion(Annotation(dc:date "2017"^^xsd:decimal) Annotation(dc:source "doi:10.1017/jfm.2017.173") oboInOwl:hasRelatedSynonym obo:ACTAN_0000534 "inverted von Kármán vortex street")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasRelatedSynonym obo:ACTAN_0000534 "reverse Karman vortex street")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000534 "lift-based flap"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") skos:example obo:ACTAN_0000534 "\"...alcids use a lift based propulsion mechanism in air and water, but during the aquatic phase the bird utilizes an active upstroke; that is lift is produced on the up stroke as well as the down stroke.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000534 "\"In slow starting, the fish appears to change the pitch of the sculling pectoral fins slightly, directing the water current to the rear.\"")
SubClassOf(obo:ACTAN_0000534 obo:ACTAN_0000772)
SubClassOf(obo:ACTAN_0000534 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000652))

# Class: obo:ACTAN_0000535 (drag-based flap)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000535 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000535 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000535 "2025-01-20T21:21:47.3013Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasDefinition obo:ACTAN_0000535 "Flap in which a feathered recovery stroke follows a power stroke.

This results in larger variations in speed.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000535 "drag-based")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000535 "drag-based flap"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000535 obo:ACTAN_0000644)
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") skos:scopeNote obo:ACTAN_0000535 "\"It has been found that marine turtles that utilize a lift based propulsive strategy can generate twice the propulsive force as freshwater turtles that utilize a drag based approach, and giving further consideration to additional benefits such as the increased streamlining of the body of the marine turtles, results in a maximum swimming velocity six times higher than the freshwater counterpart.\"")
SubClassOf(obo:ACTAN_0000535 obo:ACTAN_0000772)
SubClassOf(Annotation(dc:source "doi:10.1109/48.757275") obo:ACTAN_0000535 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000649))

# Class: obo:ACTAN_0000536 (figure-eight relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000536 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000536 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000536 "2025-01-20T21:36:47.38576Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.academia.edu/145444084/The_Figure_8_Pattern_Across_Natural_Systems_A_Critical_Examination_of_Convergent_Geometry") Annotation(skos:scopeNote "\"When Coupled Oscillations Produce Lemniscates...
The result is a figure-8 pattern traced in space: two lobes separated by a crossing point.\"") oboInOwl:hasDefinition obo:ACTAN_0000536 "Relativity which traces a lemniscate pattern in space, with two lobes separated by a crossing point.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000536 "figure-eight"@en)
AnnotationAssertion(Annotation(dc:date "2025"^^xsd:decimal) Annotation(dc:source "https://www.academia.edu/145444084/The_Figure_8_Pattern_Across_Natural_Systems_A_Critical_Examination_of_Convergent_Geometry") oboInOwl:hasExactSynonym obo:ACTAN_0000536 "lemniscate")
AnnotationAssertion(Annotation(dc:date "1982"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1367674") oboInOwl:hasNarrowSynonym obo:ACTAN_0000536 "shuttling"@en)
AnnotationAssertion(Annotation(dc:date "2025"^^xsd:decimal) Annotation(dc:source "https://www.academia.edu/145444084/The_Figure_8_Pattern_Across_Natural_Systems_A_Critical_Examination_of_Convergent_Geometry") oboInOwl:hasRelatedSynonym obo:ACTAN_0000536 "analemma")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasRelatedSynonym obo:ACTAN_0000536 "back and forth")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasRelatedSynonym obo:ACTAN_0000536 "up and down")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000536 "figure-eight relativity"@en)
AnnotationAssertion(Annotation(dc:source "https://www.academia.edu/145444084/The_Figure_8_Pattern_Across_Natural_Systems_A_Critical_Examination_of_Convergent_Geometry") skos:example obo:ACTAN_0000536 "\"...the specific figure-8 dance of honeybees is not universally optimal for bee communication; rather, it is one solution that works well enough and has been maintained through evolutionary time.\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000536 "\"A. ibis...
The male spends much time slowly walking up and down and turning around. on its percb...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/1367674") skos:example obo:ACTAN_0000536 "\"SHUTTLE DISPLAY
In this display, a male flies rapidly back and forth in tight arcs 15-25 cm in length above another hummingbird (usually a female C. anna) that is perched ca. 20-30 cm below him. The male holds his body fairly horizontal, his head and bill pointed downward toward the object of the display; at the end of each arc, he reverses direction with a rapid flick of the spread tail (though in this case I have not heard any sound).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000536 "\"Zebrafish...
...a tail sweep and circle along a female’s body resembling a ‘figure eight’;\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000536 "\"Zebrafish...
...swimming up and down in front of male; performed by females during courtship.\"")
SubClassOf(obo:ACTAN_0000536 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000536 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000505))
SubClassOf(obo:ACTAN_0000536 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000632))

