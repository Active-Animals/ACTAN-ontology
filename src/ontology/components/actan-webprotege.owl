SubClassOf(obo:ACTAN_0000954 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000023))

# Class: obo:ACTAN_0000955 (trim stabilizing)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000955 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000955 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000955 "2026-08-12T16:07:11.427994Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/iob/obz025") oboInOwl:hasDefinition obo:ACTAN_0000955 "Stabilizing which provides dynamic stability in a fluid by the use of mobile control surfaces.")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1093/iob/obz025") oboInOwl:hasExactSynonym obo:ACTAN_0000955 "trim control")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000955 "trim stabilizing"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/iob/obz025") skos:example obo:ACTAN_0000955 "\"The shrimpfish use both paddling and hydrostatic control to maintain its position and orientation. Paddling can be used to actively stabilize the body or create maneuvers. In particular, the continuous motions of the pectoral fins could resist perturbations due to changes in flow, which can occur suddenly. Such disturbances can transpire due to wave actions, currents, interactions with conspecifics, and predators.\"")
SubClassOf(obo:ACTAN_0000955 obo:ACTAN_0000148)
SubClassOf(obo:ACTAN_0000955 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000026))

# Class: obo:ACTAN_0000956 (horizontal pitch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000956 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000956 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000956 "2026-08-16T15:02:42.238487Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/iob/obz025") Annotation(skos:scopeNote "In trim, the longitudinal axis of a body would parallel the horizontal plane.") oboInOwl:hasDefinition obo:ACTAN_0000956 "Pitch in which the longitudinal axis of a body parallels the horizontal plane.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000956 "horizontal position")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1093/iob/obz025") oboInOwl:hasNarrowSynonym obo:ACTAN_0000956 "horizontal trim"@en)
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1093/iob/obz025") oboInOwl:hasNarrowSynonym obo:ACTAN_0000956 "in trim")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000956 "horizontal pitch")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/iob/obz025") skos:scopeNote obo:ACTAN_0000956 "\"When the fore and aft of a free-floating body are at the same level so that the gravitational and buoyancy forces are balanced, such an orientation is said to be in trim, which maintains longitudinal stability.\"")
SubClassOf(obo:ACTAN_0000956 obo:ACTAN_0000689)
SubClassOf(obo:ACTAN_0000956 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001855))

# Class: obo:ACTAN_0000957 (negative pitch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000957 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000957 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000957 "2026-08-16T15:02:52.749616Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000957 "Pitch which lowers the anterior angle below horizontal.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000957 "head down")
AnnotationAssertion(Annotation(dc:contributor "Directly inferred.") Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") oboInOwl:hasNarrowSynonym obo:ACTAN_0000957 "negative trim")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000957 "negative pitch"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/iob/obz025") skos:example obo:ACTAN_0000957 "\"The trumpetfish (genus Aulostomus, family Aulostomidae, suborder Syngnathoidei) uses a head-down vertical orientation when hunting.\"")
SubClassOf(obo:ACTAN_0000957 obo:ACTAN_0000689)
SubClassOf(obo:ACTAN_0000957 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002328))

# Class: obo:ACTAN_0000958 (positive pitch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000958 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000958 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000958 "2026-08-16T15:03:00.97164Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www-dr.wcupa.edu/sciences-mathematics/biology/fFish/documents/1998ImaginativeDragReduction.pdf") oboInOwl:hasDefinition obo:ACTAN_0000958 "Trim which raises the anterior angle above horizontal.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000958 "head up")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "https://www-dr.wcupa.edu/sciences-mathematics/biology/fFish/documents/1998ImaginativeDragReduction.pdf") Annotation(skos:scopeNote "\"...a positive angle of trim...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000958 "positive trim"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000958 "positive pitch")
AnnotationAssertion(Annotation(dc:source "https://www-dr.wcupa.edu/sciences-mathematics/biology/fFish/documents/1998ImaginativeDragReduction.pdf") skos:example obo:ACTAN_0000958 "\"Despite the small size of ducklings which places severe limitations on swimming velocity due to hull speed, speeds above hull speed are accomplished by replacing the displacement hull configuration with a planing hull.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/iob/obz025") skos:example obo:ACTAN_0000958 "\"The elongate oarfish (Regalecus glesne) was observed to swim in the open ocean in a head-up vertical orientation.\"")
SubClassOf(obo:ACTAN_0000958 obo:ACTAN_0000689)
SubClassOf(obo:ACTAN_0000958 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002327))

# Class: obo:ACTAN_0000959 (foraging aggregation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000959 <https://github.com/Active-Animals/Ontology/patterns/group_behaviour>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000959 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000959 "2026-08-24T05:35:19.824312Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "http://www.icrs2012.com/proceedings/manuscripts/ICRS2012_13B_2.pdf") Annotation(skos:scopeNote "\"A foraging association is characterized by the joining of individuals from two or more species in feeding activity, ranging from simple to complex, and from highly transient to obligate.\"") oboInOwl:hasDefinition obo:ACTAN_0000959 "Aggregation that is characterized by the joining of individuals from two or more species in feeding activity.")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000959 "feeding aggregation"@en)
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "http://www.icrs2012.com/proceedings/manuscripts/ICRS2012_13B_2.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000959 "feeding association")
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1445875") oboInOwl:hasExactSynonym obo:ACTAN_0000959 "foraging association")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000959 "foraging aggregation")
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:example obo:ACTAN_0000959 "\"Parupeneus barberinus is an important tropical benthic microcarnivore that forages vigorously over soft sediments adjacent to coral reefs. It has a considerable impact on the soft sediment invertebrate community as it is both common and abundant, and devotes more than 50% of its time budget to foraging. The disturbance it creates in the sediment while foraging exposes prey items and attracts many fish species to engage in foraging associations.\"")
SubClassOf(obo:ACTAN_0000959 obo:ACTAN_0000411)
SubClassOf(obo:ACTAN_0000959 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000348))
SubClassOf(obo:ACTAN_0000959 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000988))

# Class: obo:ACTAN_0000960 (shoaling foraging)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000960 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000960 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000960 "2026-08-24T06:32:57.193872Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "ISBN:9789798105975") Annotation(skos:scopeNote "\"Both the nuclear and the associate species are thought to benefit in multi-species shoaling associations, i.e. they are mutualistic associations, by swamping territorial herbivores and gaining access to defended resources.\"") oboInOwl:hasDefinition obo:ACTAN_0000960 "Foraging in which members are mutualistic.

Mixed associations involve nuclear and associate species.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "ISBN:9789798105975") oboInOwl:hasExactSynonym obo:ACTAN_0000960 "shoaling association")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000960 "shoaling foraging"@en)
AnnotationAssertion(Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") skos:example obo:ACTAN_0000960 "\"Randall (1998) wrote that herbivorous surgeonfishes of the genus Acanthurus may form feeding aggregations of more than 1 species in order to overcome territorial damselfishes trying to protect their private pastures of benthic algae. He provided an illustration of a mixed school of A. coeruleus and A. chirurgus off the Caribbean coast of Honduras.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:scopeNote obo:ACTAN_0000960 "\"Mixed species shoaling associations are generally larger than attendant associations and may comprise several hundred individuals. The nuclear species generally comprises more individuals than the associate species in the group combined: there may be one or more species of associates.\"")
SubClassOf(obo:ACTAN_0000960 obo:ACTAN_0000959)
SubClassOf(obo:ACTAN_0000960 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000996))

# Class: obo:ACTAN_0000961 (attendant foraging)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000961 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000961 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000961 "2026-08-24T06:33:21.063886Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "ISBN:9789798105975") oboInOwl:hasDefinition obo:ACTAN_0000961 "Foraging in which associate species are, at best, commensal on nuclear species.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "ISBN:9789798105975") oboInOwl:hasExactSynonym obo:ACTAN_0000961 "attendant association")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "http://www.icrs2012.com/proceedings/manuscripts/ICRS2012_13B_2.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000961 "nuclear-follower association")
AnnotationAssertion(Annotation(dc:date "2026"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2026.123487") oboInOwl:hasExactSynonym obo:ACTAN_0000961 "producer-scrounger aggregation")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "http://www.icrs2012.com/proceedings/manuscripts/ICRS2012_13B_2.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000961 "EFA")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "http://www.icrs2012.com/proceedings/manuscripts/ICRS2012_13B_2.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000961 "ephemeral foraging association")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "ISBN:9789798105975") oboInOwl:hasNarrowSynonym obo:ACTAN_0000961 "following and scavenging association")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "http://www.icrs2012.com/proceedings/manuscripts/ICRS2012_13B_2.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000961 "nuclear-following association")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") oboInOwl:hasRelatedSynonym obo:ACTAN_0000961 "following around")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "ISBN:978-0-9808572-5-2") rdfs:label obo:ACTAN_0000961 "attendant foraging"@en)
AnnotationAssertion(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") skos:example obo:ACTAN_0000961 "\"Indeed, other fishes often take advantage of these mullid barbel activities. Hobson notes that in Hawaii Parupeneus chryserydros (now P. cyclostomus) is frequently followed around by the jack, Caranx melampygus...\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:example obo:ACTAN_0000961 "‘Interspecific joint hunting’ has been described between the elephant wrasse, Gomphosus caeruleus and the yellow goatfish, Parupeneus chryseredros, and between serranids such as Cephalopholis argus and Plectropomus maculatus.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2026.123487") skos:scopeNote obo:ACTAN_0000961 "\"...Mediterranean rainbow wrasse, Coris julis, which joins producer—scrounger aggregations with a goatfish species, Mullus surmuletus, that disturbs benthic prey during foraging. Wrasse remained within their territories and did not follow producers beyond these boundaries...\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:scopeNote obo:ACTAN_0000961 "\"Attendant associations are usually small and comprise a maximum of around 10 individuals. They consist of one or two nuclear individuals of one species followed by associates of one or more species.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:978-0-9808572-5-2") skos:scopeNote obo:ACTAN_0000961 "\"Ephemeral foraging association... formerly grouped together as nuclear-follower... Brief interactions... Associate species does not move away from its territory to continue the interaction.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:scopeNote obo:ACTAN_0000961 "\"‘Following and scavenging’ associations are by far the most common type of attendant associations.

‘Interspecific joint hunting’ occurs when two species of active predators hunt together.

‘Hunting by riding’ occurs when a predatory associate swims alongside or above a nuclear species that is either non-predatory or feeds on different prey.

...‘aggressive mimicry’ occurs when the associate species is a predator, and it mimics the nuclear species, that is harmless.\"")
SubClassOf(obo:ACTAN_0000961 obo:ACTAN_0000959)
SubClassOf(obo:ACTAN_0000961 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000924))

# Class: obo:ACTAN_0000962 (anal-fin abducting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000962 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000962 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000962 "2026-08-25T04:02:18.307694Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"Lagocephalus laevigatus most frequently fans its dorsal and anal from side to side (localized ostraciiform motion) in unison, but occasionally alternates them.\"") oboInOwl:hasDefinition obo:ACTAN_0000962 "Abducting in which the anal fin is actively moved from side to side.")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.01922") oboInOwl:hasExactSynonym obo:ACTAN_0000962 "anal fin beating")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10228-002-0153-3") Annotation(skos:scopeNote "\"...lateral stroke of the anal and dorsal fins...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000962 "anal fin lateral stroke")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") Annotation(rdfs:comment "\"...anal from side to side (localized ostraciiform motion)...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000962 "anal ostraciiform motion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000962 "anal-fin abducting"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.204.8.1459") skos:example obo:ACTAN_0000962 "\"Ostracion meleagris... 
At low swimming speeds, up to approximately 1 TL s-1, boxfish swam using combinations of pectoral and anal fin motions only.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:example obo:ACTAN_0000962 "\"The ocean sunfish is an extreme example of tetraodontiform swimmer: it has virtually no caudal fin or body musculature and propels itself by synchronized oscillations of its very high dorsal and anal fins.\"")
AnnotationAssertion(skos:scopeNote obo:ACTAN_0000962 "\"...the anal fin should exhibit in-phase movement with the dorsal fin (i.e. simultaneous ipsilateral excursion) in species subject to roll moments around the body’s center of mass resulting from laterally directed dorsal fin forces.\"")
SubClassOf(obo:ACTAN_0000962 obo:ACTAN_0000738)
SubClassOf(obo:ACTAN_0000962 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_4000163))

# Class: obo:ACTAN_0000963 (anal-fin adducting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000963 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000963 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000963 "2026-08-25T04:02:40.597962Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.01922") oboInOwl:hasDefinition obo:ACTAN_0000963 "Adducting in which the anal fin is actively moved towards the midline.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000963 "anal-fin adducting"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.01922") skos:example obo:ACTAN_0000963 "\"The primarily lateral orientation of dorsal fin force in trout induces corresponding roll and yaw moments, which must be countered by forces from the caudal, anal and paired fins.\"")
SubClassOf(obo:ACTAN_0000963 obo:ACTAN_0000739)
SubClassOf(obo:ACTAN_0000963 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_4000163))

# Class: obo:ACTAN_0000964 (anal-fin abduction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000964 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000964 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000964 "2026-08-25T04:03:18.856669Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000964 "Adduction that results from anal fin abducting.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000964 "anal-fin abduction"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/iob/obz025") skos:example obo:ACTAN_0000964 "\"The shrimpfish (Aeoliscus punctulatus) maintains a vertical orientation with the head
pointed downward... The median fins (dorsal, caudal, anal) are positioned along the venter of the body and are beat or used as a passive rudder...\"")
SubClassOf(obo:ACTAN_0000964 obo:ACTAN_0000639)
SubClassOf(obo:ACTAN_0000964 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_4000163))

# Class: obo:ACTAN_0000965 (body twisting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000965 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000965 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000965 "2026-08-26T06:49:51.93021Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") Annotation(skos:scopeNote "\"The male then drove his posterior flank into the female’s side as she twisted sagittally.\"") oboInOwl:hasDefinition obo:ACTAN_0000965 "Twisting which rotates the body sagittally.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1038/s41598-021-99638-6") Annotation(skos:scopeNote "\"...twists her trunk...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000965 "trunk twisting")
AnnotationAssertion(Annotation(dc:date "1982"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1367674") Annotation(skos:scopeNote "\"...twists his abdomen...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000965 "abdomen twisting")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasRelatedSynonym obo:ACTAN_0000965 "retroflexure")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") Annotation(skos:scopeNote "\"...twists anterior body...\"") rdfs:label obo:ACTAN_0000965 "body twisting"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.2307/1367674") skos:example obo:ACTAN_0000965 "\"A male Anna’s Hummingbird...
...perches on her back, his wings buzzing (again probably for balance). His body is erect as he lowers and twists his abdomen and tail down the female’s side to achieve cloacal apposition.\"")
SubClassOf(obo:ACTAN_0000965 obo:ACTAN_0000605)
SubClassOf(obo:ACTAN_0000965 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002100))

# Class: obo:ACTAN_0000966 (body twist)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000966 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000966 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000966 "2026-08-26T06:50:19.549256Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000966 "Twist that results from body twisting.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasExactSynonym obo:ACTAN_0000966 "sagittal twist")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1038/s41598-021-99638-6") oboInOwl:hasRelatedSynonym obo:ACTAN_0000966 "freezing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000966 "body twist"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000966 "\"Nocomis leptocephalus...
On two occasions the female reversed her sagittal twist and appressed her breast and abdomen to the concave side of the male.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1038/s41598-021-99638-6") skos:example obo:ACTAN_0000966 "\"Zebrafish...
Following, and perhaps in response to, quivering by the male, the female stalls swimming and twists her trunk slightly; we call this step freezing.\"")
SubClassOf(obo:ACTAN_0000966 obo:ACTAN_0000606)
SubClassOf(obo:ACTAN_0000966 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002100))

