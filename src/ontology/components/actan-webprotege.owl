# Class: obo:ACTAN_0000001 (compensation switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000001 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000001 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000001 "2024-09-08T20:10:44.888759Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1146/annurev-ecolsys-102209-144712") Annotation(skos:scopeNote "\"Parental compensation hypothesis: when nest concealment alone is insufficient to mitigate against predation pressure, parents compensate for remaining risk by their presence at the nest via plumage camouflage, antipredator behavior, etc.\"") oboInOwl:hasDefinition obo:ACTAN_0000001 "Switch that mitigates against a pressure.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000001 "compensation"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000001 "neutralising")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000001 "compensation switch"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00265-010-0980-6") skos:example obo:ACTAN_0000001 "\"For example, strategic allocation of courtship effort is observed in male wolf spiders, Schizocosa ocreata, that miss one or two of their forelegs. These males seem to compensate for their lower condition by increasing their courtship displays in comparison to intact males, but they do it more often in response to the draglines of young, receptive females than to those of old, less receptive females.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/20.1.255") skos:scopeNote obo:ACTAN_0000001 "\"...the transverse gallop is the only gallop used at slow rates of travel when other sources of stability must compensate for reduced dynamic stability.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.198.1.79") skos:scopeNote obo:ACTAN_0000001 "\"Buoyancy control during ASR [aquatic surface respiration] allows fish to optimize their position (benthic species) or swimming mode (midwater species) and to compensate for O2 loss from the swimbladder (which decreases in volume) that occurs during hypoxic stress.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1238167") skos:scopeNote obo:ACTAN_0000001 "\"prey may be capable of compensating for reduced information via one sensory modality by increasing their reliance on other modalities\"")
SubClassOf(obo:ACTAN_0000001 obo:ACTAN_0000541)
SubClassOf(obo:ACTAN_0000001 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001561))

# Class: obo:ACTAN_0000002 (behaviour)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000002 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000002 "2025-12-08T15:54:02.275571Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1016/j.anbehav.2009.03.018") oboInOwl:hasDefinition obo:ACTAN_0000002 "Behaviour is: the internally coordinated responses (actions or inactions) of whole living organisms (individuals or groups) to internal and/or external stimuli, excluding responses more easily understood as developmental changes.

While behaviours necessarily rely upon internal information processing by the individual (e.g. cognition and endocrine signalling) we do not consider the processing alone to be a response, and therefore do not include it as behaviour.

In more complex animals, whole organism responses are generally mediated through the central nervous system, and this is often how a strictly physiological process can be transformed into some behaviour.

Often organismal movements and other positive responses are clues that whole body coordination has occurred. However, inactions can also be considered behaviours in some situations. In such cases, this inaction must still be coordinated on the level of the organism.")
AnnotationAssertion(Annotation(dc:date "1976"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1439-0310.1976.tb00970.x") oboInOwl:hasExactSynonym obo:ACTAN_0000002 "behavior")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") rdfs:label obo:ACTAN_0000002 "behaviour"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000002 "NBO:0000313")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000002 "\"I allowed an ant to visit them, and it immediately seemed, by its eager way of running about, to be well aware what a rich flock it had discovered; it then began to play with its antennæ on the abdomen first of one aphis and then of another; and each aphis, as soon as it felt the antennæ, immediately lifted up its abdomen and excreted a limpid drop of sweet juice, which was eagerly devoured by the ant. Even the quite young aphides behaved in this manner, showing that the action was instinctive, and not the result of experience.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000002 "GO:0007610")
SubClassOf(obo:ACTAN_0000002 obo:BFO_0000015)
SubClassOf(obo:ACTAN_0000002 ObjectSomeValuesFrom(obo:RO_0002404 <http://humanbehaviourchange.org/ontology/BCIO_050783>))

# Class: obo:ACTAN_0000003 (launch kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000003 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000003 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000003 "2025-12-27T17:31:53.688542Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.021360") Annotation(skos:scopeNote "\"Kick maneuvers were characterized by sudden rapid lateral excursion of the caudal fin and were followed by a forward glide (‘kick-and-glide’)... Whereas separate intrinsic caudal muscles were active at different times during steady swimming, electromyographic recordings of kicks (from 0.4 to 0.5 s) were nearly simultaneous from all muscles. Strong activity in the FD, FV, HL, IC and SC was evident just before the large-amplitude kick.\"") oboInOwl:hasDefinition obo:ACTAN_0000003 "Kinetics that involves sudden, rapid, simultaneous, strong, large amplitude movements.")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") oboInOwl:hasExactSynonym obo:ACTAN_0000003 "explosive acceleration")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rspb.1998.0424") oboInOwl:hasExactSynonym obo:ACTAN_0000003 "launch"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000003 "beat")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.021360") oboInOwl:hasNarrowSynonym obo:ACTAN_0000003 "kick")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000003 "launch kinetics")
AnnotationAssertion(Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") skos:example obo:ACTAN_0000003 "\"During fast displacements spiders did not maintain a constant speed. An explosive acceleration usually characterise the first stride, with the speed constantly decreasing thereafter.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rspb.1998.0424") skos:example obo:ACTAN_0000003 "\"`Ed Mitchell of Apollo 14 and Gene Cernan on Apollo 17 favoured a skipping stride in which they kept one foot always forward, let's say the left and, as they landed, hit with the trailing foot just a fraction of a second before the leading foot, pushing off with each foot as it hit and launching into the next glide.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.00424") skos:scopeNote obo:ACTAN_0000003 "\"Strikes launched without a brace point, usually from mid- or underwater, exhibited straightening and forward displacement of the anterior two-thirds of the trunk and straightening and backwards displacement of the posterior one-third. When the snake was able to brace a portion of its body against an object in the tank, backwards displacement of the posterior trunk was not observed.\"")
SubClassOf(obo:ACTAN_0000003 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000003 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001230))

# Class: obo:ACTAN_0000004 (decaped mode)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000004 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000004 "2025-12-28T20:42:55.148928Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Inferred.") oboInOwl:hasDefinition obo:ACTAN_0000004 "Pedestrian mode that uses ten appendages.")
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000004 "decapedalism")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasRelatedSynonym obo:ACTAN_0000004 "decapod")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000004 "decaped mode"@en)
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000004 "\"Although decapod crustaceans possess ten legs, only eight are usually used in locomotion. The chelae (which are legs 1 on both sides when numbered anterior to posterior) are not normally used in locomotion in decapod crustaceans.\"")
SubClassOf(obo:ACTAN_0000004 obo:ACTAN_0000051)

# Class: obo:ACTAN_0000005 (metachronal-stepping gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000005 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000005 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000005 "2025-12-28T20:45:23.159806Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasDefinition obo:ACTAN_0000005 "Stepping gait that is multiped and involves a metachronal wave.")
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000005 "metachronal stepping")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3190/ac482d") oboInOwl:hasExactSynonym obo:ACTAN_0000005 "multipedal walking")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000005 "metachronal-stepping gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/9781118501153.ch12") skos:example obo:ACTAN_0000005 "\"Metamorphosed flatfishes... When moving in contact with the bottom, locomotion is affected by antero-posterior movements of the dorsal and anal fin rays, which lever the fish over the substratum.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000005 "\"Pseudopleuronectes americanus as well as others, in slow movement over the bottom undulate the marginal dorsal and anal with the tips of the rays in contact with the solid substratum thereby securing greater thrust.\"")
SubClassOf(obo:ACTAN_0000005 obo:ACTAN_0000124)
SubClassOf(obo:ACTAN_0000005 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000233))
SubClassOf(obo:ACTAN_0000005 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000710))
SubClassOf(obo:ACTAN_0000005 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000059))
SubClassOf(obo:ACTAN_0000005 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000128))

# Class: obo:ACTAN_0000006 (coil curl)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000006 "https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality")
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000006 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000006 "2025-12-29T20:52:25.826763Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "ISBN:9781482294347") oboInOwl:hasDefinition obo:ACTAN_0000006 "Curl which passes 360 degrees of curvature.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "https://bioengineering.hyperbook.mcgill.ca/functional-mechanics-of-the-elephant-and-butterfly-proboscis/") oboInOwl:hasExactSynonym obo:ACTAN_0000006 "coil")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000006 "coiled")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000006 "coiling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000006 "coil curl"@en)
AnnotationAssertion(Annotation(dc:source "https://bioengineering.hyperbook.mcgill.ca/functional-mechanics-of-the-elephant-and-butterfly-proboscis/") skos:example obo:ACTAN_0000006 "\"The Lepidoptera proboscis is coiled into 4-5 turns in the resting position...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000006 "\"Zebrafish... Embryonic movement describing a full body contraction that brings the tip of the tail to the head (coils);\"")
SubClassOf(obo:ACTAN_0000006 obo:ACTAN_0000121)
SubClassOf(obo:ACTAN_0000006 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000404))

# Class: obo:ACTAN_0000007 (coil posture)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000007 <https://github.com/Active-Animals/Ontology/patterns/posture>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000007 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000007 "2025-12-29T20:53:00.262148Z")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.\"") oboInOwl:hasDefinition obo:ACTAN_0000007 "Posture that is coiled.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1181774") oboInOwl:hasExactSynonym obo:ACTAN_0000007 "coil")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasNarrowSynonym obo:ACTAN_0000007 "helical wrapping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000007 "coil posture"@en)
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000007 "\"...large-bodied Crotalus species that exhibited... loosely coiled body postures...\"")
SubClassOf(obo:ACTAN_0000007 obo:ACTAN_0000177)
SubClassOf(obo:ACTAN_0000007 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000006))
SubClassOf(obo:ACTAN_0000007 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))

# Class: obo:ACTAN_0000008 (reflex switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000008 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000008 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000008 "2026-01-28T11:06:15.639403Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1126/science.288.5463.100") oboInOwl:hasDefinition obo:ACTAN_0000008 "Stimulation switch which involves automatic neural feedback.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000008 "reflex"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000008 "reflex switch"@en)
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000008 "\"I have described the oriole’s way of treating the distal portion of the tail in a follow-through of applications first made directly to undertail coverts and basal portions of rectrices. Could this extended dabbing, out along the ventral side of the tail, possibly be reflexive action, due to ant substances warming the skin of the undertail region?\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000008 "NBO:0000389")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:scopeNote obo:ACTAN_0000008 "\"This preflexive mechanical feedback provides an additional component that functions in parallel with reflexive neural feedback and feedforward control from motor circuits.\"")
SubClassOf(obo:ACTAN_0000008 obo:ACTAN_0000893)
SubClassOf(obo:ACTAN_0000008 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0001032))

# Class: obo:ACTAN_0000009 (protrusion expanding)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000009 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000009 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000009 "2026-02-03T09:28:49.218474Z")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasBroadSynonym obo:ACTAN_0000009 "elongation")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1073/pnas.2122563119") Annotation(skos:scopeNote "\"In octopus arms and most mammalian tongues, elongation occurred uniformly across the appendage length.\"") oboInOwl:hasDefinition obo:ACTAN_0000009 "Expanding that causes uniform elongation.")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000009 "protrusion")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasNarrowSynonym obo:ACTAN_0000009 "extrusion")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasRelatedSynonym obo:ACTAN_0000009 "extension")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000009 "protrusion expanding"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") skos:example obo:ACTAN_0000009 "\"A more striking example of this effect is seen in the extrusion of the proboscis in the Nemertine worms where a small contraction of the circular musculature leads to the extrusion of a proboscis several times the length of the animal...\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:example obo:ACTAN_0000009 "\"While the basking shark has slightly protrusile jaws, megamouth can protrude its jaws forward to expand the oral orifice well in front of the snout.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") skos:scopeNote obo:ACTAN_0000009 "\"Thus the limit of extension of the column is reached when the sheet of its circular muscle is extended to form a single unfolded layer of muscle fibres.\"")
SubClassOf(obo:ACTAN_0000009 obo:ACTAN_0000744)
SubClassOf(obo:ACTAN_0000009 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001154))
SubClassOf(obo:ACTAN_0000009 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002124))

# Class: obo:ACTAN_0000010 (locomotion-mode)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000010 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000010 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000010 "2026-06-12T19:56:05.959335Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasDefinition obo:ACTAN_0000010 "Behavioural disposition that is realized in the number of appendages used for a locomotion activity.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000010 "locomotor method")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.198226") oboInOwl:hasNarrowSynonym obo:ACTAN_0000010 "locomotive mode")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.198226") oboInOwl:hasRelatedSynonym obo:ACTAN_0000010 "gait")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasRelatedSynonym obo:ACTAN_0000010 "positional mode")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:comment obo:ACTAN_0000010 "In this ontology, we have tried to tease apart the concepts of gait (a behaviour), gait pattern (a disposition), and locomotion mode (a disposition). Many sources bundle them into a trinity. The uses of varying synonyms makes it even harder to untangle. We have accepted the use of labels which could at least bear, if not incorporate, these concepts. Even if not actively defined as such in the source, we are promoting them to avoid neologisms and instead facilitate transparent semantic drift.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") rdfs:label obo:ACTAN_0000010 "locomotion-mode"@en)
AnnotationAssertion(Annotation(skos:scopeNote "https://orcid.org/0000-0002-4277-2151") skos:scopeNote obo:ACTAN_0000010 "This concept is not strictly about the number of appendages an animal may have, or even tend to use for propulsion, but rather the number in use in any given observation.")
SubClassOf(obo:ACTAN_0000010 <http://humanbehaviourchange.org/ontology/BCIO_050416>)
SubClassOf(obo:ACTAN_0000010 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0000026))

# Class: obo:ACTAN_0000011 (component pattern)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000011 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000011 "2026-06-20T09:23:37.516063Z")
AnnotationAssertion(Annotation(rdfs:comment "This is an aggregator class: please DON'T use it for annotation.") oboInOwl:hasDefinition obo:ACTAN_0000011 "Pattern which aggregates repertoire structural elements by scope and scale.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000011 "resultant")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000011 "component pattern"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000011 "\"...it takes no little patience to observe clearly and note the motions of the various elements involved, and to resolve the resultant into its often numerous components.\"")
SubClassOf(obo:ACTAN_0000011 obo:ACTAN_0000017)

# Class: obo:ACTAN_0000012 (interfacing locomotion)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000012 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000012 "2025-12-30T11:54:30.341593Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/978-3-319-68576-2_3") Annotation(skos:scopeNote "\"Where obvious transitions between the primary physical habitat types (land–water, land–air, air–water) have received some attention, the ecology of land–water interfaces dominates. Land–air and air–water interfaces are considered hard boundaries with comparatively abrupt transitions.\"") oboInOwl:hasDefinition obo:ACTAN_0000012 "Locomotion which involves the boundary between physical habitat types.

These are primarily land–water, land–air, and air–water.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s42235-023-00418-x") oboInOwl:hasExactSynonym obo:ACTAN_0000012 "cross-medium locomotion")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasExactSynonym obo:ACTAN_0000012 "mode transition")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasRelatedSynonym obo:ACTAN_0000012 "gait transitioning")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasRelatedSynonym obo:ACTAN_0000012 "habitat interface")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasRelatedSynonym obo:ACTAN_0000012 "multi-modal locomotion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000012 "interfacing locomotion"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") skos:example obo:ACTAN_0000012 "\"The best known gliders amongst mammals are found in three main groups; the flying squirrels (subfamily Petauristinae), the flying phalangers (Acrobates and Petaurus) and the flying lemurs (Cynocephalus)... All the gliding mammals are arboreal in nature, and utilize their gliding ability to travel from tree to tree... Whereas the flying squirrels and the flying phalangers remain relatively competent in terrestrial modes of locomotion, the flying lemurs, which have the most evolved patagium, spanning the entire body, resort to a crude hopping mechanism on land.\"")
SubClassOf(obo:ACTAN_0000012 obo:ACTAN_0000176)
SubClassOf(obo:ACTAN_0000012 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000179))

# Class: obo:ACTAN_0000013 (rotating manoeuvre)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000013 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000013 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000013 "2026-06-21T15:36:09.276345Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.204.8.1459") Annotation(skos:scopeNote "\"Rotational recoil is rotatory movements about an axis that passes through the center of mass.\"") oboInOwl:hasDefinition obo:ACTAN_0000013 "Manoeuvre that involves movement about an axis.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000013 "rotation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000013 "rotating manoeuvre"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000013 "NBO:0009001")
SubClassOf(obo:ACTAN_0000013 obo:ACTAN_0000149)
SubClassOf(obo:ACTAN_0000013 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000648))

# Class: obo:ACTAN_0000014 (head sweeping)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000014 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000014 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000014 "2026-07-06T16:39:49.683824Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.00424") oboInOwl:hasDefinition obo:ACTAN_0000014 "Sweeping that involves large lateral excursions of the anterior trunk while the posterior trunk remains relatively static.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...thrust the head from side to side...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000014 "side to side head thrust")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.00424") rdfs:label obo:ACTAN_0000014 "head sweeping"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.00424") skos:example obo:ACTAN_0000014 "\"Workers have noted similarities in fishing behavior across a diversity of snake groups, including natricines, homalopsines, elapids and viperids, the most notable being that aquatic prey are typically captured using a lateral sweep of the head.\"")
SubClassOf(obo:ACTAN_0000014 obo:ACTAN_0000716)
SubClassOf(obo:ACTAN_0000014 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000033))

# Class: obo:ACTAN_0000015 (longitudinal-undulation pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000015 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000015 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000015 "2026-07-07T05:23:37.010802Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000015 "Undulation pattern in which a wave passes along the periphery of an elongate structure.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000015 "longitudinal undulation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000015 "longitudinal-undulation pattern"@en)
SubClassOf(obo:ACTAN_0000015 obo:ACTAN_0000636)
SubClassOf(obo:ACTAN_0000015 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0008897))

# Class: obo:ACTAN_0000016 (ribbon-undulation gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000016 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000016 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000016 "2026-07-07T07:38:33.033754Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"In these longitudinal fins the waves are propagated by simply moving the rays from side to side serially in a method analogous to the anguilliform movement.\"") oboInOwl:hasDefinition obo:ACTAN_0000016 "Swimming-gait in which parallel rays in a longitudinal fin propogate a wave along the terminal edge of its membrane, by moving the rays serially from side to side.

Waves may be forward or backward and even both ways for very precise manoeuvring.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000016 "localized anguilliform undulation")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1002/jez.1819") oboInOwl:hasExactSynonym obo:ACTAN_0000016 "ribbon‐fin locomotion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000016 "ribbon-undulation gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1002/jez.1819") skos:example obo:ACTAN_0000016 "\"...in weakly electric fish (e.g., ghost knifefish)... ribbon‐fin locomotion provides increased maneuverability and allows the fish to hold its body rigid while swimming. This reduces modulations of the electric field generated from the body of the fish, thus maximizing electrosensory reception for prey capture, communication, and detecting environmental cues.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000016 "\"...in such forms as Amiatus and Gymnotus... the longitudinal propellor is practically parallel to the axis of motion...\"")
SubClassOf(obo:ACTAN_0000016 obo:ACTAN_0000087)
SubClassOf(obo:ACTAN_0000016 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000023))
SubClassOf(obo:ACTAN_0000016 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000027))
SubClassOf(obo:ACTAN_0000016 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000015))
SubClassOf(obo:ACTAN_0000016 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000069))

# Class: obo:ACTAN_0000017 (repertoire-pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000017 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000017 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000017 "2025-06-30T10:36:22.925935Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2011.0690") oboInOwl:hasDefinition obo:ACTAN_0000017 "Behavioural disposition that is realized in a behavior pattern which expresses a non-random set of structural components.")
AnnotationAssertion(Annotation(dc:date "1963"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1439-0310.1963.tb01161.x") oboInOwl:hasExactSynonym obo:ACTAN_0000017 "behaviour repertoire"@en)
AnnotationAssertion(Annotation(dc:date "2017"^^xsd:decimal) Annotation(dc:source "doi:10.1007/978-3-319-33774-6_5") oboInOwl:hasExactSynonym obo:ACTAN_0000017 "behavioural profile")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000017 "repertory")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000017 "repertoire-pattern"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/jzo.12455") skos:example obo:ACTAN_0000017 "\" Interestingly, the increased forelimb weight-bearing role observed in primates during suspensory locomotion (i.e., both below branch quadrupedal locomotion and arm-swinging) is not present in sloths. This indicates the greater forelimb weight-support is not a mechanical requirement of suspensory locomotion across all mammals, and this pattern may represent a primate-specific configuration.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000017 "\"Defensive behavior in the repertoire of a basic viper includes crypsis, locomotor escape, striking, biting, and envenomation.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") skos:example obo:ACTAN_0000017 "\"Thus, zebrafish larvae have a unique repertoire of bouts reserved for hunting and produce stereotyped and dynamic sequences using these bouts.\"")
SubClassOf(obo:ACTAN_0000017 <http://humanbehaviourchange.org/ontology/BCIO_050416>)
SubClassOf(obo:ACTAN_0000017 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001564))

# Class: obo:ACTAN_0000018 (tucking movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000018 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000018 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000018 "2026-02-10T10:08:41.214848Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000018 "Movement in which a body part is protectively inserted into a space bordered by another body part.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000018 "tucking")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000018 "burying")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasRelatedSynonym obo:ACTAN_0000018 "covering up")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000018 "tucking movement"@en)
AnnotationAssertion(Annotation(rdfs:comment "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000018 "\"Orchard Oriole...
...the folded wing might be held lower, along side and flank, so that wing tip lay against the ventral surface of the tail, as the tail was tucked under and pressed forward.\"")
SubClassOf(obo:ACTAN_0000018 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000018 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000624))

# Class: obo:ACTAN_0000019 (natatorial mode)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000019 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000019 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000019 "2026-03-02T21:05:27.250189Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasDefinition obo:ACTAN_0000019 "Mode that uses appendages for aquatic activity.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000019 "natatorial")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasNarrowSynonym obo:ACTAN_0000019 "fin-like limbs")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasNarrowSynonym obo:ACTAN_0000019 "finned"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000019 "natatorial mode")
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:scopeNote obo:ACTAN_0000019 "\"Within the basic grouping into MPF and BCF propulsion, further types of swimming... can be identified for each group... These... should be thought of as pronounced points within a continuum, rather than discrete sets. Fish may exhibit more than one... either at the same time or at different speeds.\"")
SubClassOf(obo:ACTAN_0000019 obo:ACTAN_0000010)
SubClassOf(obo:ACTAN_0000019 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ENVO_01001787))

# Class: obo:ACTAN_0000020 (oscillating gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000020 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000020 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000020 "2026-03-03T12:20:04.725275Z")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasBroadSynonym obo:ACTAN_0000020 "oscillatory propulsion")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1109/48.757275") Annotation(skos:scopeNote "\"...in oscillatory motions the propulsive structure swivels on its base without exhibiting a wave formation.\"") oboInOwl:hasDefinition obo:ACTAN_0000020 "Swimming-gait in which a propulsive structure uses oscillatory motions.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasExactSynonym obo:ACTAN_0000020 "fin oscillation")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000020 "localized ostraciiform undulation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000020 "oscillating gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.204.8.1459") skos:example obo:ACTAN_0000020 "\"The pectoral fin bases of O. meleagris are inclined at nearly -45 ° with respect to the horizontal, a common orientation for tetraodontiform fishes. The anal and dorsal fins oscillated back and forth in a highly compressed ‘figure-of-eight’ normal to the body axis.\"")
SubClassOf(obo:ACTAN_0000020 obo:ACTAN_0000087)
SubClassOf(obo:ACTAN_0000020 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000421))
SubClassOf(obo:ACTAN_0000020 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000772))
SubClassOf(obo:ACTAN_0000020 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000019))
SubClassOf(obo:ACTAN_0000020 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000529))

# Class: obo:ACTAN_0000021 (tail flick)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000021 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000021 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000021 "2026-03-04T20:09:30.072052Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1126/science.288.5463.100") Annotation(skos:scopeNote "\"For example, 40% of the body mass of a shrimp is devoted to the large, tasty abdominal muscles that produce a powerful tail flick during rare, but critical, escape behaviors.\"") oboInOwl:hasDefinition obo:ACTAN_0000021 "Flick that involves the tail.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1126/science.288.5463.100") rdfs:label obo:ACTAN_0000021 "tail flick"@en)
SubClassOf(obo:ACTAN_0000021 obo:ACTAN_0000678)
SubClassOf(obo:ACTAN_0000021 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002415))

# Class: obo:ACTAN_0000022 (listen perception)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000022 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000022 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000022 "2025-02-16T17:28:35.31052Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/41.2.137") Annotation(skos:scopeNote "\"Humans and other species often stop and listen if they need to detect a faint sound or to make a fine auditory discrimination.\"") oboInOwl:hasDefinition obo:ACTAN_0000022 "Perception that actively detects and discriminates between sounds.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000022 "listen"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000022 "listen perception")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000022 "NBO:0000316")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:scopeNote obo:ACTAN_0000022 "\"Burrows and other excavated dwellings have been hypothesized to act as potential resonating chambers, which might alter sound and vibrational properties to amplify or more effectively broadcast signals to listeners outside the architecture.\"")
SubClassOf(obo:ACTAN_0000022 obo:ACTAN_0000335)
SubClassOf(obo:ACTAN_0000022 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002105))

# Class: obo:ACTAN_0000023 (flag oscillation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000023 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000023 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000023 "2026-07-07T08:33:24.928391Z")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") Annotation(rdfs:isDefinedBy "\"fan in oscillating is analogous to the ostraciiform movement if rigid, but if sufficiently elongate and flexible the same driving power produces an anguilliform (flag waving) movement.\"") oboInOwl:hasDefinition obo:ACTAN_0000023 "Oscillation that involves a flexible, elongate structure.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000023 "flag waving movement")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000023 "flag oscillation"@en)
AnnotationAssertion(Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") skos:example obo:ACTAN_0000023 "\"An unusual example of luring behavior was discovered in the Indo-Pacific scorpionfish,
Iracundus signifer, by Shallenberger and Madden (1973). The dorsal fin looks very much like a small fish. The black spot on the 2nd fin membrane is the eye (which enlarges during luring), the gap between the 1st and 2nd spines is the mouth, and the long 4th dorsal spine is the 1st dorsal spine of the lure. They wrote:“Typically, the lure was snapped from side to side. The first two spines of the spinous dorsal initiated this movement and the rest of the fin followed in a sinuous wave down the back.” The 1st and 2nd dorsal spines are alternately closed together then separated, giving the effect of respiration.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.zool.2014.04.004") skos:scopeNote obo:ACTAN_0000023 "\"Fin rays show... different positions relative to their base throughout a sequence of movement... even between adjacent fin rays... suggesting that they have some level of independence from one another despite being connected by a flexible membrane.\"")
SubClassOf(obo:ACTAN_0000023 obo:ACTAN_0000421)
SubClassOf(obo:ACTAN_0000023 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001544))

# Class: obo:ACTAN_0000024 (erratic turning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000024 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000024 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000024 "2024-09-05T20:22:42.922094Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000024 "Turning that is characterized by a change in direction and speed, in a seemingly stochastic manner.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000024 "erratic movement")
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.1126/science.239.4847.1525") oboInOwl:hasExactSynonym obo:ACTAN_0000024 "unpredictable sequence")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000024 "meandering")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000024 "wandering")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000024 "zigzag"@en)
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasRelatedSynonym obo:ACTAN_0000024 "erratic body throw"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000024 "jumping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000024 "erratic turning")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000024 "\"As we walk to the edge of a stream, a stickleback freezes, then darts away in a series of rapid zig-zags punctuated by brief pauses.\"")
SubClassOf(obo:ACTAN_0000024 obo:ACTAN_0000174)
SubClassOf(obo:ACTAN_0000024 ObjectSomeValuesFrom(obo:RO_0000086 obo:NCIT_C60702))

# Class: obo:ACTAN_0000025 (burrowing-gait)

