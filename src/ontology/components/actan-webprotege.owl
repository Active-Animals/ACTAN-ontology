AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000504 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000504 "2024-12-28T09:28:38.784502Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000504 "Alarm that involves a complete cessation of movement, except for eyes, and increased respiratory movements.

Generally, a result of high stress, or part of submissive behavior.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000504 "freezing"@en)
