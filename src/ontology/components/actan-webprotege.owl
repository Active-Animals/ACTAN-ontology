SubClassOf(obo:ACTAN_0000748 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000736))
SubClassOf(obo:ACTAN_0000748 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000056))
