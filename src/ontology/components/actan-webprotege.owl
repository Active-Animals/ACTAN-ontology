AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.3390/ani13162557") oboInOwl:hasDefinition obo:ACTAN_0000055 "Pedestrian mode that uses three appendages.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasRelatedSynonym obo:ACTAN_0000055 "tripedal standing")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3390/ani13162557") oboInOwl:hasRelatedSynonym obo:ACTAN_0000055 "tripedal support")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasRelatedSynonym obo:ACTAN_0000055 "tripod")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000055 "triped mode"@en)
SubClassOf(obo:ACTAN_0000055 obo:ACTAN_0000051)

# Class: obo:ACTAN_0000056 (quadruped mode)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000056 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000056 "2024-09-08T11:27:19.490964Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") oboInOwl:hasDefinition obo:ACTAN_0000056 "Pedestrian mode that uses four appendages.")
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.158.1.369"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000056 "four-legged")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000056 "quadruped"@en)
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000056 "quadrupedalism")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000056 "quadruped mode"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") skos:example obo:ACTAN_0000056 "\"...quadrupedal mammals which walk, trot, and gallop (dog, monkey, and ram);\"")
SubClassOf(obo:ACTAN_0000056 obo:ACTAN_0000051)

# Class: obo:ACTAN_0000057 (hexaped mode)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000057 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000057 "2024-09-08T11:28:07.382022Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Inferred.") oboInOwl:hasDefinition obo:ACTAN_0000057 "Pedestrian mode that uses six appendages.")
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.158.1.369") oboInOwl:hasExactSynonym obo:ACTAN_0000057 "hexaped"@en)
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000057 "hexapedalism")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000057 "six-legged")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasRelatedSynonym obo:ACTAN_0000057 "hexapod")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000057 "hexaped mode"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.158.1.369") skos:example obo:ACTAN_0000057 "\"The six-legged locomotion of the hermit crab, Coenobita compressus, resembles the typical insect pattern. The hermit crab moves forward like other crustaceans, such as the lobster and crayfish, rather than sideways, and it has an alternating tripod gait:...\"")
SubClassOf(obo:ACTAN_0000057 obo:ACTAN_0000051)

# Class: obo:ACTAN_0000058 (octaped mode)

