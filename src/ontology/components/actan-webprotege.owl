AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasDefinition obo:ACTAN_0000528 "Undulation pattern in which the body moves alternately between left and right.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000528 "lateral undulation")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000528 "serpentine")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1038/ncomms1350") oboInOwl:hasNarrowSynonym obo:ACTAN_0000528 "sway")
