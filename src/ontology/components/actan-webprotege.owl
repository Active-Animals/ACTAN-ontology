# Class: obo:ACTAN_0000784 (wipe rub)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000784 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000784 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000784 "2025-08-06T07:55:19.760592Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/brv.12010") oboInOwl:hasDefinition obo:ACTAN_0000784 "Rub that gently moves an object across another.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000784 "wipe")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000784 "wiping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000784 "wipe rub")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12010") skos:example obo:ACTAN_0000784 "\"The most complex limb movements occur during the ‘wiping behaviour’ observed in frogs with opposable digits such as Polypedates maculatus and species of Phyllomedusa. During wiping, frogs spread lipid substances all over their body using their hands and feet.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000784 "\"Wiping is very rare at Mahale, with only a handful of cases of rump wiping with a leaf. Goodall stated that the most common form at Gombe is penis wiping by a male after copulation, but this has never been seen among Mahale chimpanzees.\"")
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:scopeNote obo:ACTAN_0000784 "\"...the bird wipes off ant acid, preparatory to eating the ant;\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000784 "\"When a bird comes out on land to oil, the bill is generally used to wipe some of the water from the breast; the head-shakes which precede use of the oil gland probably serve to remove water which has been transferred to the bill during wiping.\"")
SubClassOf(obo:ACTAN_0000784 obo:ACTAN_0000104)
SubClassOf(obo:ACTAN_0000784 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001575))

# Class: obo:ACTAN_0000785 (shoulder-rub routine)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000785 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000785 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000785 "2025-08-06T07:57:53.12252Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"Occasionally, when a duck appears to have an irritation about the head, it will rub its cheek on the shoulder.\"") oboInOwl:hasDefinition obo:ACTAN_0000785 "Counter-irritant routine which involves a shoulder rub.

This is commonly used against the head.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000785 "shoulder-rubbing")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000785 "eye-cleaning"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000785 "shoulder-rub routine")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000785 "\"Shoulder-rubbing... in... Anatidae... is very likely a technique for cleaning the eye.\"")
SubClassOf(obo:ACTAN_0000785 obo:ACTAN_0000103)
SubClassOf(obo:ACTAN_0000785 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000784))
SubClassOf(obo:ACTAN_0000785 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0001467))

# Class: obo:ACTAN_0000786 (scrape rub)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000786 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000786 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000786 "2025-08-06T08:23:35.411484Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") oboInOwl:hasDefinition obo:ACTAN_0000786 "Rub that firmly moves a hard object across another.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000786 "scraping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000786 "scrape rub")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") skos:example obo:ACTAN_0000786 "\"A unique case of male genital asymmetry among the usually symmetric Pyralidae occurs in Syntonarcha iriastis. Directionally asymmetric structures at the bases of the valves and on the 8th sternite are used for stridulation, with the left side providing file and scraper, the right side a complicated ‘‘tracer and groove’’ system.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF01609520") skos:example obo:ACTAN_0000786 "\"Abudefduf saxatilis, an ubiquitous form which feeds by benthic scraping on algae and invertebrates...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:scopeNote obo:ACTAN_0000786 "\"Eat phloem or inner bark rich in sugar and protein by scraping outer bark with incisors.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2020.11.002") skos:scopeNote obo:ACTAN_0000786 "\"Sperm transfer takes place after a period of sperm displacement, wherein the male uses his secondary genitals to either pack deeply in or scrape out any previous male’s sperm from the female sperm storage organs.\"")
SubClassOf(obo:ACTAN_0000786 obo:ACTAN_0000104)
SubClassOf(obo:ACTAN_0000786 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001576))

# Class: obo:ACTAN_0000787 (wiping tooling)

