AnnotationAssertion(terms:conformsTo obo:ACTAN_0000411 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000411 "Ditch Townsend")
