AnnotationAssertion(obo:IAO_0000115 obo:PATO_0055001 "A spatial distribution of a process in which the process occupies a smaller length, area, or volume than the reference process. For example, heterochromatin may form over a shorter length of a chromosome in a mutant than in wild type.")
AnnotationAssertion(terms:contributor obo:PATO_0055001 <https://orcid.org/0000-0003-4148-4606>)
AnnotationAssertion(oboInOwl:creation_date obo:PATO_0055001 "2019-07-29T14:22:24Z")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PATO_0055001 "quality")
AnnotationAssertion(oboInOwl:id obo:PATO_0055001 "PATO:0055001")
AnnotationAssertion(rdfs:label obo:PATO_0055001 "decreased spatial extent of a process")
SubClassOf(obo:PATO_0055001 obo:PATO_0010005)

# Class: obo:PATO_0055002 (increased spatial extent of a process)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0055002 "A spatial distribution of a process in which the process occupies a greater length, area, or volume than the reference process. For example, heterochromatin may form over a shorter length of a chromosome in a mutant than in wild type.")
AnnotationAssertion(terms:contributor obo:PATO_0055002 <https://orcid.org/0000-0003-4148-4606>)
AnnotationAssertion(oboInOwl:creation_date obo:PATO_0055002 "2019-07-29T14:23:31Z")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PATO_0055002 "quality")
AnnotationAssertion(oboInOwl:id obo:PATO_0055002 "PATO:0055002")
AnnotationAssertion(rdfs:label obo:PATO_0055002 "increased spatial extent of a process")
SubClassOf(obo:PATO_0055002 obo:PATO_0010005)

# Class: obo:PATO_0095005 (crepuscular)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0095005 "A quality of a process that happens during dawn and dusk.")
AnnotationAssertion(dc:creator obo:PATO_0095005 <http://orcid.org/0000-0002-2908-3327>)
AnnotationAssertion(dc:date obo:PATO_0095005 "2021-05-17T13:22:18Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:PATO_0095005 "crepuscular")
SubClassOf(obo:PATO_0095005 obo:PATO_0001236)

# Class: obo:PATO_0102001 (modifier characteristic)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://github.com/pato-ontology/pato/issues/602") obo:IAO_0000115 obo:PATO_0102001 "A characteristic used to describe another characteristic.")
AnnotationAssertion(oboInOwl:created_by obo:PATO_0102001 "https://orcid.org/0000-0002-7356-1779")
AnnotationAssertion(oboInOwl:creation_date obo:PATO_0102001 "2026-05-05T00:00:00Z")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PATO_0102001 "quality")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "OBO:earlier-draft") oboInOwl:hasRelatedSynonym obo:PATO_0102001 "meta characteristic")
AnnotationAssertion(oboInOwl:id obo:PATO_0102001 "PATO:0102001")
AnnotationAssertion(rdfs:comment obo:PATO_0102001 "Instances of modifier characteristic should NOT be linked to their bearers via 'characteristic of' (RO:0000052) or its inverse 'has characteristic' (RO:0000053). Use 'has modifier' (RO:0002573) to connect a modifier characteristic to the characteristic it modifies. This keeps 'characteristic of' / 'has characteristic' restricted to entity-or-process-to-characteristic relations.")
AnnotationAssertion(rdfs:label obo:PATO_0102001 "modifier characteristic")
SubClassOf(obo:PATO_0102001 obo:PATO_0000001)

# Class: obo:PCO_0000000 (collection of organisms)

AnnotationAssertion(obo:IAO_0000112 obo:PCO_0000000 "Examples include: population, community, species (meaning the collection of organisms that makes up a species, not the taxonomic rank), and family.")
AnnotationAssertion(obo:IAO_0000115 obo:PCO_0000000 "A material entity that consists of two or more organisms, viruses, or viroids."@en)
AnnotationAssertion(rdfs:comment obo:PCO_0000000 "May be of the same or different species.")
AnnotationAssertion(rdfs:label obo:PCO_0000000 "collection of organisms"@en)
SubClassOf(obo:PCO_0000000 obo:PCO_0000031)

# Class: obo:PCO_0000018 (single-species collection of organisms)

AnnotationAssertion(obo:IAO_0000115 obo:PCO_0000018 "A material entity that has as parts two or more organisms, viruses, or viroids of the same species and no members of any other species."@en)
AnnotationAssertion(rdfs:label obo:PCO_0000018 "single-species collection of organisms"@en)
SubClassOf(obo:PCO_0000018 obo:PCO_0000000)

# Class: obo:PCO_0000020 (family)

AnnotationAssertion(obo:IAO_0000115 obo:PCO_0000020 "A domestic group, or a number of domestic groups linked through descent (demonstrated or stipulated) from a common ancestor, marriage, or adoption."@en)
AnnotationAssertion(obo:IAO_0000116 obo:PCO_0000020 "Needs axioms for family relationships."@en)
AnnotationAssertion(rdfs:comment obo:PCO_0000020 "Family membership through marriage or adoption apply primarily to human families. In most species, family membership is defined by common anscestry.")
AnnotationAssertion(rdfs:label obo:PCO_0000020 "family"@en)
SubClassOf(obo:PCO_0000020 obo:PCO_0000018)

# Class: obo:PCO_0000029 (multi-species collection of organisms)

AnnotationAssertion(obo:IAO_0000115 obo:PCO_0000029 "A collection of organisms that consists of two or more organisms from at least two species."@en)
AnnotationAssertion(obo:IAO_0000116 obo:PCO_0000029 "Need to add axiom to specify that it has at a mimum members of two different species, but not sure how to specify that. Can't say \"('has member' only ('member of' min 2 'species as a collection of organisms'))\"."@en)
AnnotationAssertion(rdfs:comment obo:PCO_0000029 ""@en)
AnnotationAssertion(rdfs:label obo:PCO_0000029 "multi-species collection of organisms"@en)
SubClassOf(obo:PCO_0000029 obo:PCO_0000000)

# Class: obo:PCO_0000031 (organismal entity)

AnnotationAssertion(obo:IAO_0000114 obo:PCO_0000031 obo:IAO_0000120)
AnnotationAssertion(obo:IAO_0000115 obo:PCO_0000031 "A material entity that is one or more organisms, viruses or viroids.")
AnnotationAssertion(rdfs:label obo:PCO_0000031 "organismal entity"@en)
SubClassOf(obo:PCO_0000031 obo:BFO_0000040)

# Class: obo:PCO_0001000 (pair of interacting organisms)

AnnotationAssertion(obo:IAO_0000115 obo:PCO_0001000 "A collection of organisms that consists of exactly two organism, viruses, or viroids that are interacting with each other."@en)
AnnotationAssertion(rdfs:label obo:PCO_0001000 "pair of interacting organisms"@en)
SubClassOf(obo:PCO_0001000 obo:PCO_0000000)

