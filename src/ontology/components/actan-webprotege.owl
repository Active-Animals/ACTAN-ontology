AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000058 "octaped"@en)
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000058 "octapedalism")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000058 "octaped mode"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:scopeNote obo:ACTAN_0000058 "\"...(decapod crustaceans) typically use octapedal locomotion and walk sideways...\"")
SubClassOf(obo:ACTAN_0000058 obo:ACTAN_0000051)

# Class: obo:ACTAN_0000059 (multiped mode)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000059 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000059 "2024-09-08T11:31:35.782174Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") oboInOwl:hasDefinition obo:ACTAN_0000059 "Pedestrian mode that uses more than ten appendages.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3190/ac482d") oboInOwl:hasExactSynonym obo:ACTAN_0000059 "multi-leg")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3190/ac482d") oboInOwl:hasExactSynonym obo:ACTAN_0000059 "multiped"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000059 "multiped mode"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3190/ac482d") skos:example obo:ACTAN_0000059 "\"Scolopocryptops rubiginosus... centipedes have 23 paired legs... The foremost and hindmost leg pairs are not walking legs; they are used for feeding and stabilisation during locomotion, respectively.\"")
SubClassOf(obo:ACTAN_0000059 obo:ACTAN_0000051)

# Class: obo:ACTAN_0000060 (brace placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000060 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000060 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000060 "2025-03-04T10:26:09.670661Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000060 "Placement in which part of the body leans against a stabilizing support.")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.00424") oboInOwl:hasExactSynonym obo:ACTAN_0000060 "brace")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000060 "prop"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000060 "brace placement")
AnnotationAssertion(Annotation(rdfs:comment "doi:10.1007/BF02381373") skos:example obo:ACTAN_0000060 "\"Foot-prop sit. Similar to sit-out, but the hindlimbs are flexed at the hips and extended at the knees, with the feet propped against a vertical support. The trunk may also flex at the hips, so that it rests against the hindlimbs. Common sleeping posture in its exemplar, Papio.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.00424") skos:example obo:ACTAN_0000060 "\"The western aquatic garter snake Thamnophis couchii...
When the snake was able to brace a portion of its body against an object in the tank, backwards displacement of the posterior trunk was not observed.\"")
SubClassOf(obo:ACTAN_0000060 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000060 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000148))

# Class: obo:ACTAN_0000061 (ball coil)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000061 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000061 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000061 "2024-09-08T11:39:05.249666Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.\"") oboInOwl:hasDefinition obo:ACTAN_0000061 "Coil that is very tight.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000061 "balling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000061 "ball coil")
SubClassOf(obo:ACTAN_0000061 obo:ACTAN_0000007)
SubClassOf(obo:ACTAN_0000061 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001795))

# Class: obo:ACTAN_0000062 (pectoral-fin abduction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000062 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000062 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000062 "2026-07-12T08:57:41.094934Z")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasBroadSynonym obo:ACTAN_0000062 "already abducted fin")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.204.8.1459") Annotation(skos:scopeNote "\"Maximal dorsal/anal excursions to the left and right are assigned to +90 ° and -90 °, respectively, as are full pectoral abduction and adduction.\"") oboInOwl:hasDefinition obo:ACTAN_0000062 "Abduction that results from pectoral abducting.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") rdfs:label obo:ACTAN_0000062 "pectoral-fin abduction"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.204.8.1459") skos:example obo:ACTAN_0000062 "\"...the negatively buoyant Notothenia neglecta had refractory periods at maximum abduction...\"")
SubClassOf(obo:ACTAN_0000062 obo:ACTAN_0000639)
SubClassOf(obo:ACTAN_0000062 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000151))

# Class: obo:ACTAN_0000063 (carangiform gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000063 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000063 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000063 "2026-01-04T06:32:06.622794Z")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasBroadSynonym obo:ACTAN_0000063 "intermediate gait"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"The movements displayed by most typical fishes are intermediate between the two extremes...
“Carangiform” is used here in a comparative sense, as an intermediate between
“Anguilliform” and “Ostraciiform”...\"") oboInOwl:hasBroadSynonym obo:ACTAN_0000063 "intermediate movement")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1109/48.757275") Annotation(skos:scopeNote "\"For carangiform swimming, this is even more pronounced, as the body undulations are further confined to the last third of the body length, and thrust is provided by a rather stiff caudal fin.\"") oboInOwl:hasDefinition obo:ACTAN_0000063 "Aquatic-lateral-undulating gait that uses the posterior third of the body.

Thrust is provided by a rather stiff caudal fin.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000063 "carangiform mode")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000063 "carangiform movement")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000063 "carangiform swimming")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000063 "carangiform gait"@en)
SubClassOf(obo:ACTAN_0000063 obo:ACTAN_0000266)
SubClassOf(Annotation(dc:source "doi:10.1109/48.757275") obo:ACTAN_0000063 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000534))
SubClassOf(Annotation(dc:source "doi:10.1109/48.757275") obo:ACTAN_0000063 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002100))
SubClassOf(Annotation(dc:source "doi:10.1109/48.757275") obo:ACTAN_0000063 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_4000164))

# Class: obo:ACTAN_0000064 (regime pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000064 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000064 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000064 "2026-01-07T20:12:43.167943Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1038/s42003-020-01521-z") Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") oboInOwl:hasDefinition obo:ACTAN_0000064 "Pattern which involves phased cycles of repeated activitiy.

Different regimes may involve phases of repeated activity but varying kinematically and kinetically, or different activities altogether.")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1146/annurev-ecolsys-102209-144712") oboInOwl:hasExactSynonym obo:ACTAN_0000064 "regime"@en)
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000064 "regimen")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1038/ncomms1350") oboInOwl:hasRelatedSynonym obo:ACTAN_0000064 "strategy")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000064 "regime pattern"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1146/annurev-ecolsys-102209-144712") skos:scopeNote obo:ACTAN_0000064 "\"Incubation regime influences numerous fundamental characteristics, such as duration of embryonic development, offspring size, posthatching growth rate, locomotor performance, and behavior.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1038/s42003-020-01521-z") skos:scopeNote obo:ACTAN_0000064 "\"The burst-and-coast regime consists of a cycle with two successive phases, i.e., a phase of active undulation powered by the fish muscles followed by a passive gliding phase.\"")
SubClassOf(obo:ACTAN_0000064 obo:ACTAN_0000017)
SubClassOf(obo:ACTAN_0000064 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000083))

# Class: obo:ACTAN_0000065 (steady-locomotion pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000065 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000065 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000065 "2026-01-14T17:53:10.710941Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/41.2.137") Annotation(skos:scopeNote "\"We refer to intermittent locomotion when the force an animal exerts to move itself through space is applied discontinuously and the pauses last longer than the nonpowered phase of a single cycle of limb movement. The alternative is continuous locomotion.\"") oboInOwl:hasDefinition obo:ACTAN_0000065 "Regime pattern in which the force an animal exerts to move itself through space is applied continuously and the pauses last less than the nonpowered phase of a single cycle of limb movement.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1126/science.288.5463.100") oboInOwl:hasExactSynonym obo:ACTAN_0000065 "continuous locomotion")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") Annotation(skos:scopeNote "\"Swimming locomotion has been classified into... Periodic (or steady or sustained)...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000065 "periodic locomotion")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000065 "steady locomotion"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") Annotation(skos:scopeNote "\"Swimming locomotion has been classified into... Periodic (or steady or sustained)...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000065 "sustained locomotion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000065 "steady-locomotion pattern"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.021360") skos:example obo:ACTAN_0000065 "\"Bluegill sunfish...
...sinusoidal mean lateral excursion pattern of the dorsal tip of the caudal fin during steady swimming...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1038/ncomms1350") skos:example obo:ACTAN_0000065 "\"Elephant seals swam almost exclusively continuously at depths shallower than ~15 m, whereas at deeper depths they adopted intermittent locomotion.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1038/s42003-020-01521-z") skos:scopeNote obo:ACTAN_0000065 "\"...in continuous swimming... fish basically deal with a two-dimensional parameter space consisting of tail-beat frequency and amplitude...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:scopeNote obo:ACTAN_0000065 "\"...steady locomotion is more the exception than the rule for animals traveling through natural environments...\"")
SubClassOf(obo:ACTAN_0000065 obo:ACTAN_0000064)
SubClassOf(obo:ACTAN_0000065 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000689))

# Class: obo:ACTAN_0000066 (dipterous mode)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000066 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000066 "2026-01-19T20:03:49.776419Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1002/jmor.10788") oboInOwl:hasDefinition obo:ACTAN_0000066 "Winged mode that uses two functional aerofoils.

Whilst it may have four appendages, only two wing surfaces are effectively being used for flying.")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1002/jmor.10788") oboInOwl:hasExactSynonym obo:ACTAN_0000066 "functionally dipterous")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1002/jmor.10788") oboInOwl:hasNarrowSynonym obo:ACTAN_0000066 "dipterous")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1002/jmor.10788") oboInOwl:hasNarrowSynonym obo:ACTAN_0000066 "one wing pair")
AnnotationAssertion(Annotation(dc:date "2018"^^xsd:decimal) Annotation(dc:source "doi:10.1186/s12915-018-0494-7") oboInOwl:hasNarrowSynonym obo:ACTAN_0000066 "two winged"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000066 "dipterous mode")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/jmor.10788") skos:scopeNote obo:ACTAN_0000066 "\"The hindwings are diminished in... some... and the forewings are diminished in... some... Yet other insects... have a forewing pair that plays no role in generating lift... The remaining... fly as if... each fore- and hindwing is united into a single aerofoil.\"")
SubClassOf(obo:ACTAN_0000066 obo:ACTAN_0000068)

# Class: obo:ACTAN_0000067 (tetrapterous mode)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000067 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000067 "2026-01-19T20:41:58.846578Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1002/jmor.10788") Annotation(skos:scopeNote "\"Insects that fly with both pairs moving in roughly independent motion are termed functionally tetrapterous, and are exemplified by the dragonflies (Odonata) and lacewings (Neuroptera).\"") oboInOwl:hasDefinition obo:ACTAN_0000067 "Winged mode that moves with both wing pairs in roughly independent motion.")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1002/jmor.10788") oboInOwl:hasExactSynonym obo:ACTAN_0000067 "functionally tetrapterous")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1002/jmor.10788") oboInOwl:hasExactSynonym obo:ACTAN_0000067 "tetrapterous")
AnnotationAssertion(Annotation(dc:date "2018"^^xsd:decimal) Annotation(dc:source "doi:10.1002/jmor.10788") oboInOwl:hasNarrowSynonym obo:ACTAN_0000067 "four winged"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000067 "tetrapterous mode")
SubClassOf(obo:ACTAN_0000067 obo:ACTAN_0000068)

