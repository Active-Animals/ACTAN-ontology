# Class: obo:ACTAN_0000264 (circling ethotype)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000264 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000264 "2024-10-06T15:15:06.355292Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/j.1420-9101.2009.01826.x") Annotation(skos:scopeNote "\"...exclusively precopulatory\"") Annotation(skos:scopeNote "\"‘Circling’ - 0: Absent (Male approach without gliding motion); 1: Present (Male circling female in a gliding motion, head and thorax leading the change of direction with abdomen bent at an angle).\"") oboInOwl:hasDefinition obo:ACTAN_0000264 "Ethotype that involves a male revolving around a female in a gliding motion, head and thorax leading the change of direction with abdomen bent at an angle.")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") oboInOwl:hasExactSynonym obo:ACTAN_0000264 "circling mating characteristic")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:comment obo:ACTAN_0000264 "If a relevant ontology is developed, this would become a subtype of a mating ethotype.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000264 "circling ethotype")
SubClassOf(obo:ACTAN_0000264 obo:ACTAN_0000118)
SubClassOf(obo:ACTAN_0000264 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000124))
