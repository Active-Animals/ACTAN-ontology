# Class: obo:ACTAN_0000816 (altruism switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000816 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000816 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000816 "2025-09-03T13:53:09.358036Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/beheco/12.5.534") Annotation(skos:scopeNote "\"When reciprocal altruism is involved, individuals anticipate that the act will be reciprocated.\"") oboInOwl:hasDefinition obo:ACTAN_0000816 "Condition switch when an individual anticipates that the act will be reciprocated.")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasRelatedSynonym obo:ACTAN_0000816 "altruism"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasRelatedSynonym obo:ACTAN_0000816 "mutual grooming")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000816 "altruism switch"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000816 "\"Mutual grooming. Two chimpanzees groom each other simultaneously.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000816 "NBO:0000288")
SubClassOf(obo:ACTAN_0000816 obo:ACTAN_0000553)
SubClassOf(obo:ACTAN_0000816 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002486))

# Class: obo:ACTAN_0000817 (contagion switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000817 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000817 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000817 "2025-09-03T14:01:46.164092Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"Performance of these movements by one bird transmits the flying mood to others and ensures synchronous flight in the group.\"") oboInOwl:hasDefinition obo:ACTAN_0000817 "Stimulation switch when one transmits a mood to others.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000817 "contagious"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000817 "infectious")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000817 "contagion switch")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000817 "\"...a wild Mallard reacts to an alarming stimulus by suddenly raising its head to assume a very erect posture. This reaction of alarm functions as an important signal transmitting fleeing mood within a group of birds.\"")
SubClassOf(obo:ACTAN_0000817 obo:ACTAN_0000893)
SubClassOf(obo:ACTAN_0000817 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0040057))

# Class: obo:ACTAN_0000818 (dash-and-dive constellation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000818 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000818 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000818 "2025-09-03T15:32:04.735509Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"Diving with the wings open is one of the main actions. Then after surfacing from a number of rapid dives the birds flap about on the surface, fly short distances, and dive from the air.\"") oboInOwl:hasDefinition obo:ACTAN_0000818 "Autogroom-constellation which involves diving with open wings, and flapping about on the water surface.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000818 "dashing-and-diving"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000818 "diving play")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000818 "playing chase")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000818 "dash-and-dive constellation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000818 "\"This behaviour may be exhibited by a solitary bird but, as all observers have noted, it is contagious and when one or two birds begin others nearby follow suit.\"")
SubClassOf(obo:ACTAN_0000818 obo:ACTAN_0000101)
SubClassOf(obo:ACTAN_0000818 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000190))
SubClassOf(obo:ACTAN_0000818 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000239))
