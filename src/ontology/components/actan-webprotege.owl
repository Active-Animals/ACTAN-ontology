# Class: obo:ACTAN_0000976 (eye movement)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000976 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000976 "2026-09-13T16:28:25.133246Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://core.ac.uk/download/pdf/85255156.pdf") Annotation(skos:scopeNote "\"The eye movement system is a classical type of servomechanism, exhibiting many of the characteristics common to both biological and mechanical control systems.\"") oboInOwl:hasDefinition obo:ACTAN_0000976 "Movement that involves an eye.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") rdfs:label obo:ACTAN_0000976 "eye movement"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/41.2.137") skos:scopeNote obo:ACTAN_0000976 "\"Although most organisms have much more limited capacity for eye movements than humans do, brief stabilizations of the eyes are evident in careful recordings of eye and body positions during turns in a number of different taxa.\"")
SubClassOf(obo:ACTAN_0000976 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000976 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000970))

