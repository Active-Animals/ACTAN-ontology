# Class: obo:ACTAN_0000949 (mouth gape)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000949 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000949 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000949 "2026-08-05T10:46:48.6798Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000949 "Gape which results from mouth gaping")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") rdfs:label obo:ACTAN_0000949 "mouth gape"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2014.08.051") skos:example obo:ACTAN_0000949 "\"...the American Opossum (Didelphis virginiana) and hog nosed snake (Heterodon spp.) assume contorted postures with their eyes open and their tongues protruding from gaping mouths.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF01609520") skos:example obo:ACTAN_0000949 "\"In two species, Emmelichthyops and Schultzea, an additional process is found on the premaxilla which apparently serves in giving support to the large resulting gape between the maxilla and the premaxilla; this gape is covered only by integument when the jaw is shot forward.\"")
SubClassOf(obo:ACTAN_0000949 obo:ACTAN_0000723)
SubClassOf(obo:ACTAN_0000949 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000165))

# Class: obo:ACTAN_0000950 (dorsal-fin abducting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000950 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000950 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000950 "2026-08-09T16:10:21.927074Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.01922") oboInOwl:hasDefinition obo:ACTAN_0000950 "Abducting in which dorsal fin rays are actively moved laterally.")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.01922") Annotation(skos:scopeNote "\"...erect the dorsal fin and unilaterally abduct it...\"") rdfs:label obo:ACTAN_0000950 "dorsal-fin abducting"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.01922") skos:example obo:ACTAN_0000950 "\"At the onset of a turn, trout erect the dorsal fin and unilaterally abduct it to the side of the body towards which the... stimulus is directed.\"")
SubClassOf(obo:ACTAN_0000950 obo:ACTAN_0000738)
SubClassOf(obo:ACTAN_0000950 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0003097))

# Class: obo:ACTAN_0000951 (dorsal-fin adducting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000951 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000951 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000951 "2026-08-09T16:10:44.819293Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.01922") oboInOwl:hasDefinition obo:ACTAN_0000951 "Adducting in which dorsal fin rays are actively moved towards the midline.")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.01922") Annotation(skos:scopeNote "\"...dorsal fin abduction and following adduction...\"") Annotation(skos:scopeNote "2005"^^xsd:decimal) oboInOwl:hasRelatedSynonym obo:ACTAN_0000951 "dorsal fin adduction")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000951 "dorsal-fin adducting"@en)
SubClassOf(obo:ACTAN_0000951 obo:ACTAN_0000739)
SubClassOf(obo:ACTAN_0000951 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0003097))

# Class: obo:ACTAN_0000952 (dorsal-fin abduction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000952 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000952 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000952 "2026-08-09T16:11:16.855333Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000952 "Abduction that results from dorsal fin abducting.")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.01922") rdfs:label obo:ACTAN_0000952 "dorsal-fin abduction"@en)
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000952 "\"Badis badis...
The loosely expanded lobe of the dorsal fin is brought into use as a rudder.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.01922") skos:scopeNote obo:ACTAN_0000952 "\"On both sides of the body, dorsal inclinator muscles arise from the fascia overlying the epaxial myomeres and insert onto the lateral base of each flexible dorsal fin ray, thereby enabling fin abduction.\"")
SubClassOf(obo:ACTAN_0000952 obo:ACTAN_0000639)
SubClassOf(obo:ACTAN_0000952 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0003097))

# Class: obo:ACTAN_0000953 (M-BCF gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000953 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000953 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000953 "2026-08-09T16:18:49.246275Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.01922") Annotation(skos:scopeNote "\"Simultaneous recruitment of anterior median fin propulsion together with body and caudal fin locomotion define an aquatic gait we term M–BCF.\"") oboInOwl:hasDefinition obo:ACTAN_0000953 "Subcarangiform gait which recruits an anterior median fin.")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.01922") rdfs:label obo:ACTAN_0000953 "M-BCF gait"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000953 obo:ACTAN_0000632)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.01922") skos:example obo:ACTAN_0000953 "\"...in trout swimming steadily at low to intermediate speeds, the combined use of dorsal fin oscillation and axial undulation without continuous concomitant pectoral fin motion.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.01922") skos:scopeNote obo:ACTAN_0000953 "\"A similar fin-use pattern has been observed for balistiform swimmers at high speed.\"")
SubClassOf(obo:ACTAN_0000953 obo:ACTAN_0000268)
SubClassOf(obo:ACTAN_0000953 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0003097))

