AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000748 "Climbing gait in which a horizontal support is grasped by both hands and the body is lifted by retracting the humerus and flexing the elbow.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000748 "hauling")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000748 "hoisting")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000748 "pull-up"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000748 "pull-up gait"@en)
SubClassOf(obo:ACTAN_0000748 obo:ACTAN_0000256)
