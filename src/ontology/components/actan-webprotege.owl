# Class: obo:ACTAN_0000281 (excavation construction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000281 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000281 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000281 "2024-10-07T08:09:59.57035Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/bhl.title.82303") oboInOwl:hasDefinition obo:ACTAN_0000281 "Construction that digs a pit.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000281 "excavation"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000281 "hollow")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasRelatedSynonym obo:ACTAN_0000281 "nest-building")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000281 "excavation construction"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000281 "\"...the bees instantly began to excavate minute circular pits in it; and as they deepened these little pits, they made them wider and wider until they were converted into shallow basins...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000281 "\"Campostoina anomalum typically spawns over a pit excavated by the male in riffles where a number of males may guard and maintain spawning pits in close proximity.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:scopeNote obo:ACTAN_0000281 "\"Other forms of animal architecture do not require attaching or cobbling matter together, but rather excavating material from a substrate.\"")
SubClassOf(obo:ACTAN_0000281 obo:ACTAN_0000272)
SubClassOf(obo:ACTAN_0000281 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000282))
SubClassOf(obo:ACTAN_0000281 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00010483))

# Class: obo:ACTAN_0000282 (dig kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000282 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000282 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000282 "2024-10-07T08:10:25.896621Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000282 "Kinetics that penetrates and removes substrate.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000282 "digging"@en)
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") oboInOwl:hasRelatedSynonym obo:ACTAN_0000282 "burrowing")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") oboInOwl:hasRelatedSynonym obo:ACTAN_0000282 "excavating")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000282 "dig kinetics"@en)
AnnotationAssertion(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") skos:example obo:ACTAN_0000282 "\"...Mulloides fiavolineatus... may also burrow into the sand with its snout to retrieve a food item.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000282 "\"In this digging the movements are always very much exaggerated, therefore we call it formalized digging.\"")
SubClassOf(obo:ACTAN_0000282 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000282 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00010483))
SubClassOf(obo:ACTAN_0000282 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001026))

# Class: obo:ACTAN_0000283 (burrowing locomotion)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000283 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000283 "2024-10-07T08:10:42.210296Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/j.1365-3121.1991.tb00141.x") Annotation(skos:scopeNote "\"In this paper, the term burrowing is applied to locomotion in loose sediments that collapse around the organism as it proceeds through the substrate.\"") oboInOwl:hasDefinition obo:ACTAN_0000283 "Locomotion which involves loose sediments that collapse around the organism as it proceeds through the substrate.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000283 "burrowing"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasExactSynonym obo:ACTAN_0000283 "tunneling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000283 "burrowing locomotion")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000283 "\"In South America, a burrowing rodent, the tuco-tuco, or Ctenomys, is even more subterranean in its habits than the mole;\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000283 "NBO:0000071")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:scopeNote obo:ACTAN_0000283 "\"Many animal architects have therefore evolved powerful morphological adaptations for digging and burrowing. Naked mole rats, for example, have large outward-facing incisors, enabling subterranean tunneling through some of the hardest of soils.\"")
SubClassOf(obo:ACTAN_0000283 obo:ACTAN_0000176)
SubClassOf(obo:ACTAN_0000283 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000181))

# Class: obo:ACTAN_0000284 (anchor-probe gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000284 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000284 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000284 "2024-10-07T08:11:45.230916Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/j.1365-3121.1991.tb00141.x") Annotation(skos:scopeNote "\"One part of the organism probes forward, while the rest acts as an anchor that prevents back-slippage. The probing part subsequently becomes anchored within the substrate, and pulls forward the rest of the body.\"") oboInOwl:hasDefinition obo:ACTAN_0000284 "Burrowing-gait in which one part of the organism probes forward, while the rest acts as an anchor that prevents back-slippage; the probing part subsequently becomes anchored within the substrate, and pulls forward the rest of the body.")
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") oboInOwl:hasNarrowSynonym obo:ACTAN_0000284 "anchor"@en)
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") oboInOwl:hasNarrowSynonym obo:ACTAN_0000284 "probe"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000284 "anchor-probe gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") skos:example obo:ACTAN_0000284 "\"The genera Lingula and Glottidia possess antero-posteriorly elongated shells, and live within mucus-lined burrows in soft sediment, with the long pedicles anchored at the bottom of their burrows. Representatives of both genera have been observed to reburrow after being extracted from their burrows. Both genera burrow by entering the sediment with shell anteriormost and pedicle trailing behind. After burrowing downward for a while, they curve upward and continue burrowing until they emerge from the substrate with the anterior region of the shell.\"")
SubClassOf(obo:ACTAN_0000284 obo:ACTAN_0000025)
SubClassOf(obo:ACTAN_0000284 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000468))
SubClassOf(obo:ACTAN_0000284 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000469))
SubClassOf(obo:ACTAN_0000284 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000696))
SubClassOf(obo:ACTAN_0000284 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000052))
SubClassOf(obo:ACTAN_0000284 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000796))

# Class: obo:ACTAN_0000285 (mediation technic)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000285 <https://github.com/Active-Animals/Ontology/patterns/technical_realizing_routine>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000285 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000285 "2024-10-07T18:18:44.043213Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1016/j.anbehav.2007.09.028") Annotation(skos:scopeNote "\"For a human familiar with a specific tool, it seems as if the boundary of the body is extended to encompass the tool, as if not just action but also sensing and sometimes communicative abilities have been transformed by the physical properties of the tool, an experience Clark (2002) describes in terms of ‘transparent equipment’.\"") oboInOwl:hasDefinition obo:ACTAN_0000285 "Technic in which action, sensing and communicative abilities can be transformed by the physical properties of a tool.

Tooling and nontooling are different, narrower suites of behaviors than tool use in general, of which they are both part.")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") oboInOwl:hasExactSynonym obo:ACTAN_0000285 "mediation"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000285 "tool using")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000285 "tool-use")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000285 "use tool")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000285 "mediation technic"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") skos:example obo:ACTAN_0000285 "\"Neurological studies of the brains of macaque monkeys engaged in tool-using tasks have found evidence that such an integration of a tool into the user’s internal representation of its own body does indeed occur.\"")
SubClassOf(obo:ACTAN_0000285 obo:ACTAN_0000271)
SubClassOf(obo:ACTAN_0000285 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000096))

# Class: obo:ACTAN_0000286 (tooling mediation)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000286 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000286 "2024-10-07T18:20:02.851035Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/tops.12554") Annotation(skos:scopeNote "\"In order to provide a more rigorous foundation for research and to advance our understanding of the interrelation between tool use and cognition, we suggest the adoption of Fragaszy and Mangalam’s tooling framework, which is characterized by the creation of a body-plus-object system that manages a mechanical interface between tool and surface.\"") oboInOwl:hasDefinition obo:ACTAN_0000286 "Mediation that is characterized by the creation of a body-plus-object system that manages a mechanical interface between tool and surface.

Tooling is limited to a narrower suite of behaviors than tool use. It involves “acting with” a tool.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1111/tops.12554") oboInOwl:hasExactSynonym obo:ACTAN_0000286 "tooling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000286 "tooling mediation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/tops.12554") skos:example obo:ACTAN_0000286 "\"We found that probing was the most frequently referenced mode for the primates, followed by reaching and pounding. For birds, probing was by far the most commonly reported tooling mode.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/tops.12554") skos:scopeNote obo:ACTAN_0000286 "\"...insects... all of the few tooling cases are unusual in that a single type of tooling behavior is shared among related species... These reports hint to the evolution of stereotyped, inflexible tooling, which can be identified by the use of “a single tool for a single purpose in a particular context”, typically in species showing only one type of tooling. How these evolved tooling specializations may fundamentally differ from flexible tooling is unspecified within the current tooling framework.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/tops.12554") skos:scopeNote obo:ACTAN_0000286 "brushing-with-object
burning-with-object
clubbing-with-object
cutting-with-object
digging-with-object
dipping-with-object
fishing-with-object
flossing-with-object
hammering-with-object
jabbing-with-object
placing-with-object
* probing-with-object
propelling-with-object
* prying-with-object
pulling-with-object
push-accessing-with-object
reaching-with-object
scooping-with-object
scratching-with-object
stirring-with-object
tickling-with-object
* wiping-with-object

* Given its own class in the ontology")
SubClassOf(obo:ACTAN_0000286 obo:ACTAN_0000285)

# Class: obo:ACTAN_0000287 (nontooling mediation)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000287 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000287 "2024-10-07T18:20:26.923124Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/tops.12554") oboInOwl:hasDefinition obo:ACTAN_0000287 "Mediation that involves acquired skills for “acting on” a nontooling object.")
