# Class: obo:ACTAN_0000297 (ingress entry)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000297 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000297 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000297 "2024-10-08T07:09:52.918914Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.3354/esr01312") oboInOwl:hasDefinition obo:ACTAN_0000297 "Entry in which an individual begins hibernation.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ece3.6372") oboInOwl:hasExactSynonym obo:ACTAN_0000297 "den entry")
AnnotationAssertion(Annotation(dc:date "2024"^^xsd:decimal) Annotation(dc:source "doi:10.3354/esr01312") Annotation(skos:scopeNote "\"...entering the hibernacula...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000297 "hibernacula entering")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1181774") oboInOwl:hasExactSynonym obo:ACTAN_0000297 "ingress"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000297 "ingress entry")
AnnotationAssertion(Annotation(dc:source "doi:10.3354/esr01312") skos:example obo:ACTAN_0000297 "\"...C. horridus hibernacula and population... surveys should be conducted on
warmer days (daytime temperatures >15–20°C) during the fall ingress and spring egress periods, when individuals congregate at or near hibernacula habitat...\"")
SubClassOf(obo:ACTAN_0000297 obo:ACTAN_0000029)
SubClassOf(obo:ACTAN_0000297 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000303))

# Class: obo:ACTAN_0000298 (hibernation thermoregulation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000298 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000298 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000298 "2024-10-08T07:10:09.967598Z")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1146/annurev-ecolsys-102209-144712") oboInOwl:hasBroadSynonym obo:ACTAN_0000298 "overwintering")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1002/ece3.6372") Annotation(skos:scopeNote "\"Hibernation requires a reduction of metabolic mechanisms with the consequent decrease in body temperature and consumption of O2.\"") oboInOwl:hasDefinition obo:ACTAN_0000298 "Thermoregulation that requires a reduction of metabolic mechanisms with the consequent decrease in body temperature and consumption of O2.\"")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...a state of semi-hibernation...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000298 "hibernation"@en)
AnnotationAssertion(Annotation(dc:date "2024"^^xsd:decimal) Annotation(dc:source "doi:10.3354/esr01312") oboInOwl:hasNarrowSynonym obo:ACTAN_0000298 "brumation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000298 "hibernation thermoregulation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000298 "\"In very cold water when Chaenobryttus is in a state of semi-hibernation they may sometimes be observed with no fin movement at all and with both sets of paired fins securely pressed against the sides.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3354/esr01312") skos:example obo:ACTAN_0000298 "\"South-facing outcrops are, therefore, thermally superior to C. horridus, permitting potentially longer activity time and shallower hibernating depths (i.e. more available hibernacula).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ece3.6372") skos:example obo:ACTAN_0000298 "\"The metabolic cycle of brown bears, during which body mass variation occurs, can be divided into three stages: (a) gain of lean mass during spring, (b) accumulation of fat during hyperphagia, and (c) weight loss during hibernation. The decrease in body temperature during hibernation ranges from 3 to 5°C with respect to the body temperature of the active state (Hissa, 1997) and begins on average 13 days before den entry, while its recovery begins 63 days before den emergency...\"")
SubClassOf(obo:ACTAN_0000298 obo:ACTAN_0000342)
SubClassOf(obo:ACTAN_0000298 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0001031))
SubClassOf(obo:ACTAN_0000298 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001306))

# Class: obo:ACTAN_0000299 (migration translocation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000299 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000299 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000299 "2024-10-08T07:10:32.997121Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/1365-2656.12379") Annotation(skos:scopeNote "\"Spatial awareness and memory is a fundamental property of movement, perhaps the clearest example of this is seasonal migration where seasonally constrained behaviour turns into a long range directed behaviour.\"") oboInOwl:hasDefinition obo:ACTAN_0000299 "Translocation in which periodically constrained behaviour turns into a long range directed movement.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000299 "migration"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000299 "migration translocation"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000299 "NBO:0070001")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000299 "\"...every one understands what is meant, when it is said that instinct impels the cuckoo to migrate...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:scopeNote obo:ACTAN_0000299 "\"...we know from Mr. J. M. Jones’s admirable account of Bermuda, that very many North American birds, during their great annual migrations, visit either periodically or occasionally this island.\"")
SubClassOf(obo:ACTAN_0000299 obo:ACTAN_0000752)
SubClassOf(obo:ACTAN_0000299 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0001031))
SubClassOf(obo:ACTAN_0000299 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000374))

# Class: obo:ACTAN_0000300 (anal-fin extending)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000300 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000300 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000300 "2026-07-20T10:16:48.171597Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"Schlesinger points out with a diagram that in turning by means of extending a single pectoral the pressure of the water on the extended dorsal and anal swings the fish around with the pectoral somewhat as a pivot.\"") oboInOwl:hasDefinition obo:ACTAN_0000300 "Extending that involves the anal fin.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...extended dorsal and anal...\"") rdfs:label obo:ACTAN_0000300 "anal-fin extending"@en)
SubClassOf(obo:ACTAN_0000300 obo:ACTAN_0000726)
SubClassOf(obo:ACTAN_0000300 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_4000163))

# Class: obo:ACTAN_0000301 (search localization)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000301 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000301 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000301 "2024-10-08T07:11:11.320721Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3354/esr01312") Annotation(skos:scopeNote "\"E.g., animals will use multiple sources of information in order to select between different foraging strategies balancing the risks and benefits of local resource exploitation versus long-range exploration.\"") oboInOwl:hasDefinition obo:ACTAN_0000301 "Localization which explores for, and if possible exploits, a resource.")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") oboInOwl:hasExactSynonym obo:ACTAN_0000301 "detecting")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") oboInOwl:hasExactSynonym obo:ACTAN_0000301 "locating"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000301 "search")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000301 "searching"@en)
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") oboInOwl:hasExactSynonym obo:ACTAN_0000301 "seeking")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "This was the label of a merged redundant term.") oboInOwl:hasRelatedSynonym obo:ACTAN_0000301 "search inspection"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000301 "search localization"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.3354/esr01312") skos:example obo:ACTAN_0000301 "\"Permanent ‘on-demand’ hibernacula are desirable for C. horridus, particularly northern populations, which do not create their hibernacula and whose survival depends on locating these thermally adequate but geographically limited landscape features.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000301 "\"The hermit crabs, Coenobita compressus, were observed frequently along the beach over 2 months. They were very active at night in the intertidal zone patrolling the moist sand in search of food.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000301 "\"To refer once again to cirripedes: the larvæ in the first stage have three pairs of legs, a very simple single eye, and a probosciformed mouth, with which they feed largely, for they increase much in size. In the second stage, answering to the chrysalis stage of butterflies, they have six pairs of beautifully constructed natatory legs, a pair of magnificent compound eyes, and extremely complex antennæ; but they have a closed and imperfect mouth, and cannot feed: their function at this stage is, to search by their well-developed organs of sense, and to reach by their active powers of swimming, a proper place on which to become attached and to undergo their final metamorphosis.\"")
SubClassOf(obo:ACTAN_0000301 obo:ACTAN_0000290)
SubClassOf(obo:ACTAN_0000301 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000507))
SubClassOf(obo:ACTAN_0000301 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0001032))

# Class: obo:ACTAN_0000302 (dorsal-fin extension)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000302 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000302 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000302 "2026-07-20T10:58:51.1114Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000302 "Extension that results from dorsal fin extending.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000302 "dorsal-fin extension"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000302 "\"In stopping, the dorsal and anal of most spiny rayed fishes are usually erected to their fullest extent.\"")
SubClassOf(obo:ACTAN_0000302 obo:ACTAN_0000523)
SubClassOf(obo:ACTAN_0000302 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0003097))

# Class: obo:ACTAN_0000303 (denning basing)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000303 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000303 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000303 "2024-10-08T07:08:35.734484Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1002/ece3.6372") oboInOwl:hasDefinition obo:ACTAN_0000303 "Basing that involves a partially enclosed cavity.

It may have a restricted entrance passage.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ece3.6372") oboInOwl:hasExactSynonym obo:ACTAN_0000303 "denning"@en)
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1181774") oboInOwl:hasRelatedSynonym obo:ACTAN_0000303 "hibernaculum"@en)
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ece3.6372") Annotation(skos:scopeNote "\"...nest dens (a nest of needles and branches or other materials deposited on the ground)...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000303 "nest denning")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000303 "denning basing"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ece3.6372") skos:example obo:ACTAN_0000303 "\"Brown bears have been reported showing a noticeable plasticity when hibernating, adapting their denning behavior to environmental factors, availability of food during hyperphagia or changing snow conditions during the winter.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:example obo:ACTAN_0000303 "\"In cold regions, snakes often aggregate at denning sites for overwintering, and neonate rattlesnakes appear capable of following the scent trails of adults to locate dens. Arizona black rattlesnakes (Crotalus cerberus) form social networks when aggregating at these communal denning sites, and the existence of social networks in other snakes highlights their potential importance...

Proclivities toward communal overwintering at denning sites appear to be greater in C. helleri populations at higher elevations, presumably resulting in higher levels of conspecific behavioral interactions during fall ingress and spring egress compared to populations at lower elevations that more often overwinter alone.\"")
SubClassOf(obo:ACTAN_0000303 obo:ACTAN_0000577)
SubClassOf(obo:ACTAN_0000303 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000381))

# Class: obo:ACTAN_0000304 (local search)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000304 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000304 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000304 "2024-10-08T07:10:55.437254Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1534/genetics.120.303539") oboInOwl:hasDefinition obo:ACTAN_0000304 "Search that is area-restricted, consisting of a high frequency of high-angle turns, in the absence of resource cues.")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1469-185X.2010.00163.x") oboInOwl:hasExactSynonym obo:ACTAN_0000304 "area-restricted search")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000304 "patrolling"@en)
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1469-185X.2010.00163.x") rdfs:label obo:ACTAN_0000304 "local search")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000304 "\"The hermit crabs, Coenobita compressus, were observed frequently along the beach over 2 months. They were very active at night in the intertidal zone patrolling the moist sand in search of food.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1469-185X.2010.00163.x") skos:example obo:ACTAN_0000304 "\"The quality or size of the prey consumed is often positively correlated with the duration and intensity of the area-restricted search. For example, predatory bugs used much longer and intense area-restricted search when feeding on a 4th instar aphid rather than a 1st instar aphid.\"")
SubClassOf(obo:ACTAN_0000304 obo:ACTAN_0000301)
SubClassOf(obo:ACTAN_0000304 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000508))
SubClassOf(obo:ACTAN_0000304 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000380))
SubClassOf(obo:ACTAN_0000304 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002472))

# Class: obo:ACTAN_0000305 (global search)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000305 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000305 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000305 "2024-10-08T13:40:38.425238Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1534/genetics.120.303539") Annotation(skos:scopeNote "\"Then, they transition to a global search state (also referred to as dispersal); where they suppress their turning rates. This behavioral sequence allows them to perform an area-restricted search of the environment immediately after their food source has vanished, but then to broaden their search to a wider area if the local search is unsuccessful.\"") oboInOwl:hasDefinition obo:ACTAN_0000305 "Search that suppresses turning rates, to explore a wider area, in the absence of resource cues.")
AnnotationAssertion(Annotation(dc:date "2016"^^xsd:decimal) Annotation(dc:source "doi:10.1111/1365-2656.12379") oboInOwl:hasExactSynonym obo:ACTAN_0000305 "dispersal")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1534/genetics.120.303539") rdfs:label obo:ACTAN_0000305 "global search")
SubClassOf(obo:ACTAN_0000305 obo:ACTAN_0000301)
SubClassOf(obo:ACTAN_0000305 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000374))

# Class: obo:ACTAN_0000306 (withstanding passivity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000306 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000306 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000306 "2024-10-13T13:26:47.560093Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000306 "Passivity in which an animal does no more than brace and shield itself in place during an attack.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000306 "accepting the blows")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000306 "giving no ground")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000306 "not yielding")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000306 "standing against")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000306 "withstanding"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000306 "maintaining position")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasRelatedSynonym obo:ACTAN_0000306 "shielding")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000306 "withstanding passivity"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000306 "\"Hemichromis bimaculatus...
The more ripe the female is, the more willing she is to accept the blows of the male without leaving her place.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000306 "\"Hemichromis bimaculatus...
The nearer the female approaches oestrus the more inclined she is to stand against the attacks of the male.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000306 "\"If the predator does not respond to the aposematic signal, they can deliver a few effective bites, then cover up their heads and withstand a brief attack while they wait for the envenomation to repel the attacker.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000306 "\"When a fish has been pushed back as far as the centre of its territory, it usually posts itself with the hind part on the bottom, the head lifted up and directed against the intruder. At this point it apparently intends to give no more ground away, and it often succeeds in keeping this last position, particularly when it has some shelter at its back.\"")
SubClassOf(obo:ACTAN_0000306 obo:ACTAN_0000373)
SubClassOf(obo:ACTAN_0000306 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000515))

# Class: obo:ACTAN_0000307 (relaxation kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000307 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000307 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000307 "2024-10-13T13:27:03.750614Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasDefinition obo:ACTAN_0000307 "Kinetics in which muscle tone broadly reduces.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000307 "relaxation")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000307 "settling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000307 "relaxation kinetics")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2011.01.007") skos:scopeNote obo:ACTAN_0000307 "\"...play indicates that the subject animal is in a ‘relaxed’ state in the sense of being free from sickness, hunger, injury, predation risk, thermal stress or other challenges to its fitness including lost mating opportunities.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/1365-2656.12379") skos:scopeNote obo:ACTAN_0000307 "\"In order to understand the mechanisms by which the pheromones influence behaviour, it is necessary to understand as fully as possible the baseline structure of lamprey movements, including quantifying the diel patterns of settling and swimming.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:scopeNote obo:ACTAN_0000307 "\"We chose to use 20 min based on observations of the snake’s behavior (i.e., termination of rattling and settling into a coil).\"")
SubClassOf(obo:ACTAN_0000307 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000307 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001619))

# Class: obo:ACTAN_0000308 (residence localization)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000308 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000308 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000308 "2024-10-13T13:27:29.467269Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/1365-2656.12379") Annotation(skos:scopeNote "\"The residence time (RT), similarly computes the amount of time an animal spends within a given radius, but allows the individual to leave and return within a prescribed time window as well.\"") oboInOwl:hasDefinition obo:ACTAN_0000308 "Localization in which an animal spends time within a given radius, but allows the individual to leave and return within a prescribed time window as well.\"")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasExactSynonym obo:ACTAN_0000308 "home range")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000308 "residence"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...haunting different stations...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000308 "station haunting")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...inhabiting new stations...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000308 "station inhabiting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000308 "residence localization")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:scopeNote obo:ACTAN_0000308 "\"...I can bring a considerable catalogue of facts, showing that within the same area, varieties of the same animal can long remain distinct, from haunting different stations, from breeding at slightly different seasons, or from varieties of the same kind preferring to pair together.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") skos:scopeNote obo:ACTAN_0000308 "\"RESIDENT - A canopy organism specialized on a particular host plant or plant species (compare tourist) or specialized on a particular plant organ (as in a resident of flowers or bark), often across many plant species.\"")
SubClassOf(obo:ACTAN_0000308 obo:ACTAN_0000290)
SubClassOf(obo:ACTAN_0000308 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001323))

# Class: obo:ACTAN_0000309 (sleep rest)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000309 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000309 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000309 "2024-10-13T13:28:06.036961Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1534/genetics.120.303539") Annotation(skos:scopeNote "\"Reduced responsiveness during sleep Arguably the most mysterious property of sleep is the reduction of responsiveness to sensory stimuli since it would seem to be maladaptive from an evolutionary standpoint. The reduction in responsiveness is not absolute: strong stimulation will wake up even a deeply sleeping animal.\"") oboInOwl:hasDefinition obo:ACTAN_0000309 "Rest that involves reduced responsiveness.

The reduction in responsiveness is not absolute: strong stimulation will wake up even a deeply sleeping animal.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000309 "sleeping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000309 "sleep rest")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000309 "NBO:0000024")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:example obo:ACTAN_0000309 "\"In sleeping some birds (e.g., passerines) place the bill under the scapulars while many others (e.g., pigeons) draw their heads between their shoulders. Diverse sleeping postures are found in other groups, some of them apparent adaptations to peculiar anatomical features. For example, herons place the bill between the bend of the wing and the body. The hanging parakeets (Loriculus) sleep hanging upside down, and the related Agapornis pullaria also sometimes sleep in this position.\"")
SubClassOf(obo:ACTAN_0000309 obo:ACTAN_0000310)
SubClassOf(obo:ACTAN_0000309 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001194))

# Class: obo:ACTAN_0000310 (rest homeostasis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000310 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000310 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000310 "2024-10-13T13:28:33.989797Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(dc:source "doi:10.1534/genetics.120.303539") Annotation(rdfs:comment "Multi-source definition.") oboInOwl:hasDefinition obo:ACTAN_0000310 "Homeostasis that involves a reduced respiratory rate, and the reversible absence of feeding, movement, excretion, and breeding.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000310 "quiescence"@en)
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000310 "relaxing")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000310 "rest")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000310 "rest homeostasis")
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000310 "\"Carrion Crow...
in relaxed attitude, head tilted downward, tail drooped, and both wings hanging in front of, and well below, the perch.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000310 "\"Typical rest behavior in larval zebrafish includes floating with head down.\"")
SubClassOf(obo:ACTAN_0000310 obo:ACTAN_0000381)
SubClassOf(obo:ACTAN_0000310 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000307))
SubClassOf(obo:ACTAN_0000310 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000289))

# Class: obo:ACTAN_0000311 (immobility kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000311 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000311 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000311 "2024-10-13T13:29:17.270883Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000311 "Kinetics in which movement has completely ceased, except for eyes and respiration.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000311 "immobility"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000311 "motionless")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000311 "stationary")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000311 "immobility kinetics"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000311 obo:ACTAN_0000617)
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1238167") skos:example obo:ACTAN_0000311 "\"...the ability of crayfish (Orconectes virilis) to detect and respond to predator odours is negatively related to current velocity, resulting in reduced foraging activity and increased time spend immobile.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000311 "\"Thalassoma cupido...
Usually she lies nearly motionless in the algae with only her head protruding until emerging to spawn.\"")
SubClassOf(obo:ACTAN_0000311 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000311 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000300))

# Class: obo:ACTAN_0000312 (sessility residence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000312 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000312 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000312 "2024-10-13T13:29:42.230606Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1554/06-246.1") oboInOwl:hasDefinition obo:ACTAN_0000312 "Residence that involves very sustained immobility.")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "doi:10.1554/06-246.1") oboInOwl:hasExactSynonym obo:ACTAN_0000312 "sessility")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000312 "sessile"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000312 "sessility residence")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/bc60659126ef5c0172c2392d485b0c9b/1?pq-origsite=gscholar&cbl=18750") skos:example obo:ACTAN_0000312 "\"The coral system offers many advantages for exploring how synchrony might be achieved on ecological scales. First, corals are sessile and that makes these organisms highly tractable for measuring the synchrony of spawning across the entire population over time.\"")
SubClassOf(obo:ACTAN_0000312 obo:ACTAN_0000308)
SubClassOf(obo:ACTAN_0000312 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000311))

# Class: obo:ACTAN_0000313 (dwelling search)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000313 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000313 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000313 "2024-10-14T10:19:19.216433Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1534/genetics.120.303539") Annotation(skos:scopeNote "\"In contrast, the dwelling state consists of short bouts of low-velocity forward movement (,0.05 mm/s), with a high frequency of short reversals.\"") oboInOwl:hasDefinition obo:ACTAN_0000313 "Search that consists of short bouts of low-velocity forward movement, with a high frequency of short reversals, in the presence of resource cues.

It may indicate satiety, but is not the same as quiescence.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1534/genetics.120.303539") oboInOwl:hasExactSynonym obo:ACTAN_0000313 "dwelling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000313 "dwelling search")
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:example obo:ACTAN_0000313 "\"Caenorhabditis elegans...
While the dwelling state is promoted by many of the same mechanisms that promote behavioral quiescence, it is a distinct behavioral state: dwelling animals still move, feed, defecate, and lay eggs.\"")
SubClassOf(obo:ACTAN_0000313 obo:ACTAN_0000301)
SubClassOf(obo:ACTAN_0000313 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000508))
SubClassOf(obo:ACTAN_0000313 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000380))
SubClassOf(obo:ACTAN_0000313 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002472))

# Class: obo:ACTAN_0000314 (pseudo-school aggregation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000314 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000314 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000314 "2025-05-19T20:40:26.070315Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasDefinition obo:ACTAN_0000314 "Aggregation which is like schooling, but emerges from laterally restricted, semi-synchronised vertical forays into the water column above closely spaced, fixed retreat sites.")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasExactSynonym obo:ACTAN_0000314 "vertical-foraging aggregation"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000314 "pseudo-school aggregation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF01609520") skos:example obo:ACTAN_0000314 "\"The wrasse Clepticus parrai, the serranid Paranthias furcifer and the pomacentrids Chrornus cyaneus and C. muhilineatus have less typical \"schools\" in the traditional sense, and are more aptly described as having \"vertical foraging aggregations\". These species tend to retreat to sites on the reef when pursued.\"")
SubClassOf(obo:ACTAN_0000314 obo:ACTAN_0000411)
SubClassOf(obo:ACTAN_0000314 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000044))
SubClassOf(obo:ACTAN_0000314 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000662))

# Class: obo:ACTAN_0000315 (glocal search)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000315 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000315 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000315 "2024-10-08T07:11:33.06691Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1038/s41467-023-38685-1") Annotation(skos:scopeNote "\"Therefore, by markedly up-regulating speed and omega turn rates, starved worms at 25°C are in a state enabling both local and global search, which we will call glocal search.\"") oboInOwl:hasDefinition obo:ACTAN_0000315 "Search that up-regulates speed and omega turns, in the absence of resource cues.

This results in a specific exploration strategy, where animals exhaustively sample local environment by making frequent turns while still performing long-range navigation due to marked speed increase.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.1038/s41467-023-38685-1") rdfs:label obo:ACTAN_0000315 "glocal search"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/1365-2656.12379") skos:scopeNote obo:ACTAN_0000315 "\"At several locations along its track, the wolf appeared to settle into spatially constrained behaviours we refer to as ‘pseudo-territorial’ modes before switching back to a ‘dispersive’ behaviour...

...we might propose a definition of ‘pseudo-territorial behaviour’ as those portions of the trajectory which remain within a 20 km radius for at least 2 weeks... This functional definition is satisfyingly simple and motivated partially by the biology of the animal. This result can be applied more or less indiscriminately to other dispersing wolves in the data base, and the properties of the areas which are selected for pseudo-territorial behaviour analysed with respect to the other available habitat in Finland, for example with respect to forest types and human land use.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1038/s41467-023-38685-1") skos:scopeNote obo:ACTAN_0000315 "\"Intensive exploration of environment in glocal search mode seems energetically costly and would be expected to come with some compensatory ecological benefits. We hypothesized that animals in glocal search state would more efficiently detect and reach food sources in their surroundings.\"")
SubClassOf(obo:ACTAN_0000315 obo:ACTAN_0000301)
SubClassOf(obo:ACTAN_0000315 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000508))
SubClassOf(obo:ACTAN_0000315 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000303))
SubClassOf(obo:ACTAN_0000315 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000380))

# Class: obo:ACTAN_0000316 (roaming search)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000316 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000316 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000316 "2024-10-14T10:25:50.924335Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1534/genetics.120.303539") Annotation(skos:scopeNote "\"The roaming state consists of long bouts of high-velocity forward movement (~0.1 mm/s), punctuated by infrequent reversals.\"") oboInOwl:hasDefinition obo:ACTAN_0000316 "Search that consists of long bouts of high-velocity forward movement, punctuated by infrequent reversals, in the presence of resource cues.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000316 "roaming"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Increased rate of swimming and distance traveled with frequent directional changes (>90 degree turns) that serve to sample appetitive odor plumes.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000316 "appetitive olfactory behavior")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.1038/s41467-023-38685-1") Annotation(skos:scopeNote "\"...warming promotes a specific behavioral state, where animals frequently swap between forward and backward motion to more actively scan their local environment while feeding, without dispersing much faster... scanning animals may better detect and respond to thermal gradients in order to thermotax while feeding.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000316 "scanning")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasRelatedSynonym obo:ACTAN_0000316 "saltatory searching")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000316 "roaming search"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:scopeNote obo:ACTAN_0000316 "\"Detection of additional chemosensory cues also impacts these states: pheromones that signal a higher density of animals inhibit roaming...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:scopeNote obo:ACTAN_0000316 "\"When animals detect an increase in the concentration of food odors, they prolong their roaming state to navigate to the food source. But when the concentration of food odors decreases, they transition to dwelling states.\"")
SubClassOf(obo:ACTAN_0000316 obo:ACTAN_0000301)
SubClassOf(obo:ACTAN_0000316 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000508))
SubClassOf(obo:ACTAN_0000316 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000381))
SubClassOf(obo:ACTAN_0000316 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002471))

# Class: obo:ACTAN_0000317 (ritual pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000317 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000317 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000317 "2025-08-27T14:15:31.433792Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000317 "Routine pattern that contains modified behaviours which have evolved a secondary signalling function.

Signs of modification include higher than normal frequency, linkage with other displays, and exaggerated forms.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000317 "performance")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000317 "ritual"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000317 "ceremony")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000317 "demonstrative")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000317 "formalized")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") oboInOwl:hasRelatedSynonym obo:ACTAN_0000317 "profile")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000317 "rules")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000317 "symbolical")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000317 "ritual pattern"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000317 obo:ACTAN_0000540)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000317 "\"...in Lacerta agilis... The intraterritorial fighting has more the character of a serious fight, but still very much influenced by a number of \"playing-rules\".\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:scopeNote obo:ACTAN_0000317 "\"...mating behaviour is extremely diverse in sepsids with each species having its own mating profile.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:scopeNote obo:ACTAN_0000317 "\"There are many social rituals and displays which have nothing to do with social competition among rivals. Some, like the stereotyped movements preceding \"nest relief\" of one member of a breeding pair by another in birds, or exchanges of signals prior to copulation, function to regulate or coordinate cooperation between the sexes.\"")
SubClassOf(obo:ACTAN_0000317 obo:ACTAN_0000397)
SubClassOf(obo:ACTAN_0000317 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001583))

# Class: obo:ACTAN_0000318 (look perception)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000318 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000318 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000318 "2025-02-16T17:28:43.54959Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") oboInOwl:hasDefinition obo:ACTAN_0000318 "Perception which attempts to visually locate and fixate on a target.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000318 "fixing")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000318 "keeping an eye on")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000318 "looking"@en)
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000318 "tracking")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10071-014-0761-0") oboInOwl:hasExactSynonym obo:ACTAN_0000318 "viewing")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000318 "watching")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000318 "look perception")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000318 "NBO:0000314")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10071-014-0761-0") skos:example obo:ACTAN_0000318 "\"Sarasins minnows look at a familiar individuals with their left eye and use their right eye to view unfamiliar individuals.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000318 "\"...the stimulus situation by which the young recognise the parents consists of visual characters only... Those characters might be of 6 different kinds, namely characters of movement, size, shape, texture, colour or pattern.\"")
SubClassOf(obo:ACTAN_0000318 obo:ACTAN_0000335)
SubClassOf(obo:ACTAN_0000318 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002104))

# Class: obo:ACTAN_0000319 (balance perception)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000319 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000319 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000319 "2025-08-20T14:31:28.809775Z")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000319 "equilibrium")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1023/A:1005565304671") oboInOwl:hasDefinition obo:ACTAN_0000319 "Perception that adequately stabilises locomotor and postural behaviour.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000319 "balancing"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasNarrowSynonym obo:ACTAN_0000319 "counterbalancing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000319 "balance perception")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000319 "NBO:0000318")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000319 "\"Acanthopterygians that have the bases of the pectorals and pelvics usually placed rather close together and are comparatively long bodied also usually have the tips of the dorsal and anal lobate. These are frequently brought “hard over” to check movement. The genera Micropterus, Epinephelus and Micteroperca quite commonly employ the tail in this manner, virtually forming a sea anchor. Any tendency caused by this to bring about undesirable deflection to one side is counterbalanced by an appropriate pectoral movement. Lepomis and Micropterus at times curve their tails to one side and the dorsal and anal lobes to the other, thus checking movement and avoiding deflection.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000319 "\"C. compressus uses a basic alternating tripod gait... The crab's abdomen and the centre of gravity of the mollusc shell are displaced to the right of the crab's midline. In order to maintain balance, the crab has compensated behaviourally and morphologically. The behavioural change is the alignment of the legs. The left legs are extended and the right retracted.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000319 "\"In fishes and other animals that live under water the (locomotory) movements are more closely connected with the problem of maintaining the equilibrium than in animals living on land.\"")
SubClassOf(obo:ACTAN_0000319 obo:ACTAN_0000335)
SubClassOf(obo:ACTAN_0000319 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000148))

# Class: obo:ACTAN_0000320 (comfort-related ethotype)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000320 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000320 "2025-08-31T15:04:15.322717Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000320 "Ethotype which involves a display, varying by species, involving ritualized sequences of comfort movements.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000320 "comfort related"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:comment obo:ACTAN_0000320 "This is a potential parent category for a litany of rituals.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000320 "comfort-related ethotype")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000320 "\"In the Common Eider and King Eider, one of the commonest pre-copulatory sequences is Bathe + Wing-flap + Shake; this may be repeated many times, along with other displays, before the male finally mounts.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000320 "\"The White-winged Scoter male gives movements resembling Bill-dip associated with Drink and Preen-behind-wing.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000320 "\"The male Andean Goose has two displays which appear to have been derived from oiling. In the first, the head is suddenly thrown backward and the crown is rolled on the middle of the back with a jerky motion. At other times, the male approaches the female with feathers depressed all over the body; on reaching her he suddenly erects all the body feathers and rolls the chin sideways over the breast.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000320 "\"The only instance I recorded of head-flicks in the pre-copulation situation was in a male Red-crested Pochard. Dipping the bill to the water several times was followed by Head-flick and Preen-dorsally, the whole sequence being repeated many times before mounting occurred.\"")
SubClassOf(obo:ACTAN_0000320 obo:ACTAN_0000118)
SubClassOf(Annotation(dc:source "doi:10.1163/156853965x00138") obo:ACTAN_0000320 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000431))
SubClassOf(Annotation(dc:source "doi:10.1163/156853965x00138") obo:ACTAN_0000320 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000610))
SubClassOf(Annotation(dc:source "doi:10.1163/156853965x00138") obo:ACTAN_0000320 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000709))
SubClassOf(Annotation(dc:source "doi:10.1163/156853965x00138") obo:ACTAN_0000320 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000757))
SubClassOf(Annotation(dc:source "doi:10.1163/156853965x00138") obo:ACTAN_0000320 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000760))
SubClassOf(Annotation(dc:source "doi:10.1163/156853965x00138") obo:ACTAN_0000320 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000795))
SubClassOf(Annotation(dc:source "doi:10.1163/156853965x00138") obo:ACTAN_0000320 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000812))

# Class: obo:ACTAN_0000321 (social courtship)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000321 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000321 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000321 "2025-08-26T14:16:12.839615Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000321 "Courtship in which a suitor gathers with others performing displays around a potential mate.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"...courting party behaviour
...courting party activity
...courting party situation
...courting party display...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000321 "courting party behaviour"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") rdfs:label obo:ACTAN_0000321 "social courtship")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000321 "\"Head-shakes commonly occur in duck courting parties... Certain displays are normally preceded or followed by a head-shake; for example the sequence: Head-shake + Head-flick + Head-throw is common in the Greater Scaup, Tufted Duck, and Southern Pochard.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000321 "\"JOHNSGARD records Wing-flaps in courting parties of Common and Barrow's Goldeneyes, Hooded Merganser, Smew, Red-breasted Merganser and Goosander, stressing that the movement is especially well developed in the Bufflehead.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000321 "\"The Belly-preen... may be given during courting party activity or when a drake is alone beside his female... I have seen a male move away from courting party on the water to run out on the nearby shore, perform the Shake + Preen laterally to the female, and then rush back into the water to join the group.\"\"")
SubClassOf(obo:ACTAN_0000321 obo:ACTAN_0000472)
SubClassOf(obo:ACTAN_0000321 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000411))

# Class: obo:ACTAN_0000322 (temperature perception)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000322 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000322 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000322 "2024-10-14T16:11:44.877575Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1038/s41467-023-38685-1") oboInOwl:hasDefinition obo:ACTAN_0000322 "Perception that responds to heat and cold.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.1038/s41467-023-38685-1") oboInOwl:hasExactSynonym obo:ACTAN_0000322 "temperature-evoked behavior")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.1038/s41467-023-38685-1") oboInOwl:hasExactSynonym obo:ACTAN_0000322 "thermosensory sensory experience")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.1038/s41467-023-38685-1") oboInOwl:hasRelatedSynonym obo:ACTAN_0000322 "thermodetection")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.1038/s41467-023-38685-1") oboInOwl:hasRelatedSynonym obo:ACTAN_0000322 "thermosensation")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1146/annurev-ecolsys-102209-144712") oboInOwl:hasRelatedSynonym obo:ACTAN_0000322 "thermosensitive")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000322 "temperature perception")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000322 "NBO:0000326")
SubClassOf(obo:ACTAN_0000322 obo:ACTAN_0000335)
SubClassOf(obo:ACTAN_0000322 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0003942))

# Class: obo:ACTAN_0000323 (belly-zipping ethotype)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000323 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000323 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000323 "2025-08-26T16:07:26.926732Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000323 "Zipping in which the subject stands side-on to their potential mate, and displays by bending forward assuming the posture of nibbling the belly feathers.

Sometimes the belly feathers are nibbled vigorously or the bill may not touch the body at all merely swinging briefly across above the feet.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000323 "belly-preening"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000323 "belly-zipping ethotype")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000323 "\"...during the period of pair-formation, male Shovelers frequently come out on shore, orientate their body laterally to the female (who may be either standing or swimming close by), and then perform a Shake followed by a Belly-preen.\"")
SubClassOf(obo:ACTAN_0000323 obo:ACTAN_0000118)
SubClassOf(obo:ACTAN_0000323 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000750))
SubClassOf(obo:ACTAN_0000323 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000916))

# Class: obo:ACTAN_0000324 (tossing movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000324 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000324 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000324 "2025-08-26T16:50:13.331597Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000324 "Movement that involves an extremity and is exaggerated and upward.

This is usually the head.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000324 "tossing"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000324 "head-throw")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000324 "head-tossing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000324 "tossing movement")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000324 "\"Common Shelduck... The display-shake consists of a body-shake with a very exaggerated upward tossing of the head at the end of the movement...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000324 "\"Nocomis leptocephalus...
As the female moved forward over the upstream rim of the pit, she gaped and abruptly tossed her head vertically into the water column.\"")
SubClassOf(obo:ACTAN_0000324 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000324 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002495))

# Class: obo:ACTAN_0000325 (following relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000325 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000325 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000325 "2024-10-15T08:51:35.834688Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Follow (following): Behavior similar to chase, typically a nonaggressive movement towards (after) another fish;\"") oboInOwl:hasDefinition obo:ACTAN_0000325 "Relativity which is a nonaggressive movement after another.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000325 "following"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000325 "following relativity"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000325 obo:ACTAN_0000331)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000325 obo:ACTAN_0000896)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/beheco/12.5.534") skos:example obo:ACTAN_0000325 "\"...performing prey retrieval in the army ants Eciton burchelli and Dorylus wilverthi.... there are just two subtasks: front-running, involving a single ant at the front, and following, involving one or more ants bringing up the rear.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000325 "\"Thalassoma cupido...
During the onset she holds the leading position, with the male following closely behind.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:scopeNote obo:ACTAN_0000325 "\"In cold regions, snakes often aggregate at denning sites for overwintering, and neonate rattlesnakes appear capable of following the scent trails of adults to locate dens.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") skos:scopeNote obo:ACTAN_0000325 "\"Worm-size blind snakes (Typhlopidae), considered overwhelmingly subterranean, have been found several meters high in trees, perhaps following ant columns.\"")
SubClassOf(obo:ACTAN_0000325 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000325 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001633))

# Class: obo:ACTAN_0000326 (approach relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000326 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000326 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000326 "2024-10-15T08:54:46.483907Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000326 "Relativity that involves lower velocity movement towards an object.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000326 "advancing towards")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000326 "approach")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000326 "approaching"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000326 "approach relativity")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000326 obo:ACTAN_0000441)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000326 obo:ACTAN_0000507)
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000326 "\"A young, not recently fed, Badis badis catches a Daphnia in the following way. It approaches the prey slowly by sculling forward.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:example obo:ACTAN_0000326 "\"For example, observations by Tinbergen and his co-workers showed that a female Black-headed Gull approached a hidden male immediately after an \"Oblique-cum-Long-Call\" in 13 out of 16 cases; when she failed to do so she was engaged in squabbles with another bird. The female did not approach the male when he was not calling. Thus one can conclude that the function of the call is to induce the female to approach.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") skos:example obo:ACTAN_0000326 "\"In response to the gorilla’s behaviour, an intruder, although discouraged from approaching, may decide not to retreat but to remain in its location.\"")
SubClassOf(obo:ACTAN_0000326 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000326 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002448))
SubClassOf(obo:ACTAN_0000326 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002472))

# Class: obo:ACTAN_0000327 (lunge relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000327 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000327 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000327 "2024-10-15T08:55:10.668199Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasDefinition obo:ACTAN_0000327 "Relativity that involves a higher velocity gap-closing motion.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000327 "lunging"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000327 "lunge relativity")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000327 obo:ACTAN_0000234)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icaa017") skos:example obo:ACTAN_0000327 "\"As gap distances increase, rather than crawling slowly and continuously, some snake species may lunge, jump, or even glide.\"")
SubClassOf(obo:ACTAN_0000327 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000327 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000003))

# Class: obo:ACTAN_0000328 (circling relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000328 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000328 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000328 "2024-10-15T08:55:43.032602Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000328 "Relativity that is directed one way, with a repetitive turn angle and angular velocity.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000328 "circling"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000328 "looping")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000328 "wheeling")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000328 "curving")
AnnotationAssertion(Annotation(dc:date "2017"^^xsd:decimal) Annotation(dc:source "doi:10.1146/annurev-neuro-071714-033857") Annotation(rdfs:comment "No description in the source, but an illustration suggests encircling involves a stationary centre (e.g. a partner), whilst circling involves out of phase components (e.g. opponents circling each other head-tail).") oboInOwl:hasNarrowSynonym obo:ACTAN_0000328 "encircling")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(rdfs:seeAlso obo:ACTAN_0000685) oboInOwl:hasNarrowSynonym obo:ACTAN_0000328 "spiralling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000328 "circling relativity")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000328 "NBO:0050002")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000328 "\"Thalassoma cupido...
...the male swims... in a roughly circular path above the female... may turn tight semicircles around the female, displaying alternately to her left and right sides.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:scopeNote obo:ACTAN_0000328 "\"Male circling female in a gliding motion, head and thorax leading the change of direction with abdomen bent at an angle.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/978-3-319-68576-2_3") skos:scopeNote obo:ACTAN_0000328 "\"Migrating birds drawn into circling illuminated communications towers, particularly those with guy wires, in low cloud conditions die in large numbers.\"")
SubClassOf(obo:ACTAN_0000328 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000328 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001413))
SubClassOf(obo:ACTAN_0000328 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001904))
SubClassOf(obo:ACTAN_0000328 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002326))

# Class: obo:ACTAN_0000329 (confrontation antagonism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000329 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000329 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000329 "2024-10-15T08:56:13.965985Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"Rubbing the cheek on the back is common during hostile encounters between pairs of Chiloe and European Wigeon...\"") oboInOwl:hasDefinition obo:ACTAN_0000329 "Antagonism that encounters with hostility.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000329 "agonistic confrontation")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000329 "confronting"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000329 "hostility")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000329 "confrontation antagonism")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:scopeNote obo:ACTAN_0000329 "\"At Mahale adult males also pant hoot when agonistic confrontations are continuing, in which pant hoots may function as a vocal threat.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000329 "\"Smaller snakes, regardless of species, have no choice when confronted by a predator but to strike with less efficient venom delivery systems and engage the predator more actively, not being able to coil up into a defensive posture and withstand a brief attack.\"")
SubClassOf(obo:ACTAN_0000329 obo:ACTAN_0000385)
SubClassOf(obo:ACTAN_0000329 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000326))

# Class: obo:ACTAN_0000330 (trailing translocation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000330 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000330 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000330 "2024-10-15T08:57:39.809739Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.jstor.org/stable/3892539") oboInOwl:hasDefinition obo:ACTAN_0000330 "Translocation that navigates by following laid-down chemical cues.")
AnnotationAssertion(Annotation(dc:date "1983"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/3892539") oboInOwl:hasExactSynonym obo:ACTAN_0000330 "trailing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000330 "trailing translocation")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:example obo:ACTAN_0000330 "\"...neonate rattlesnakes appear capable of following the scent trails of adults to locate dens.\"")
SubClassOf(obo:ACTAN_0000330 obo:ACTAN_0000752)
SubClassOf(obo:ACTAN_0000330 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000325))
SubClassOf(obo:ACTAN_0000330 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000399))

# Class: obo:ACTAN_0000331 (pursuit relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000331 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000331 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000331 "2024-10-15T09:02:46.196165Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") oboInOwl:hasDefinition obo:ACTAN_0000331 "Relativity in which one animal tries to overtake another.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000331 "chase")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000331 "chasing")
AnnotationAssertion(Annotation(dc:date "1922"^^xsd:decimal) Annotation(dc:source "doi:10.2307/2939673") oboInOwl:hasExactSynonym obo:ACTAN_0000331 "pursuing"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000331 "pursuit")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000331 "pursuit relativity")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000331 obo:ACTAN_0000325)
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000331 "\"Thalassoma cupido...
Spawning... mild chases contribute to the unstable nature of the aggregations.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000331 "NBO:0020040")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") skos:scopeNote obo:ACTAN_0000331 "\"One possibility is that different stages of the behavior have a different organization. For example, animals might dynamically modulate their movements to adjust to the position of the prey during pursuit, but resort to more stereotyped motor patterns when consuming prey.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:scopeNote obo:ACTAN_0000331 "\"The male will follow or chase the female in a jerky swimming motion with his dorsal fin erect... If the male’s advance is unwelcome, the female may chase the male away.\"")
SubClassOf(obo:ACTAN_0000331 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000331 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000303))

# Class: obo:ACTAN_0000332 (stalking pursuit)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000332 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000332 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000332 "2024-10-15T09:04:23.742566Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.jstor.org/stable/4084834") oboInOwl:hasDefinition obo:ACTAN_0000332 "Pursuit which involves a slow phase, unnoticed target observation, and a sudden, fast capture movement.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000332 "stalking"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000332 "stalking pursuit"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000332 "NBO:0020160")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4084834") skos:example obo:ACTAN_0000332 "\"...a heron moves slowly, stalking prey. Walking becomes slower as the heron examines items or areas of interest, and just before striking the heron may walk so slowly that this behavior merges with stand and wait.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1231780") skos:example obo:ACTAN_0000332 "\"These observations included responses to four large carnivores that commonly kill these prey, including two coursers (wild dog and spotted hyena), a stalker (lion), and one with an intermediate hunting strategy (cheetah).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1231780") skos:scopeNote obo:ACTAN_0000332 "\"...the complete guild of large predators that commonly kill these grazers, including both stalking and coursing predators, remains present in these ecosystems.\"")
SubClassOf(obo:ACTAN_0000332 obo:ACTAN_0000331)
SubClassOf(obo:ACTAN_0000332 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000690))

# Class: obo:ACTAN_0000333 (coursing pursuit)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000333 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000333 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000333 "2024-10-15T09:04:47.33194Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1139/z98-044") Annotation(skos:scopeNote "\"I have departed from Ehrlich et al.’s (1992) “aerial forager,” deeming it ambiguous, and have chosen to return to Blake’s (1948) “coursing” (flying continuously in search of insect prey)...\"") oboInOwl:hasDefinition obo:ACTAN_0000333 "Pursuit that is continuous.")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1139/z98-044") oboInOwl:hasExactSynonym obo:ACTAN_0000333 "coursing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000333 "coursing pursuit"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000333 obo:ACTAN_0000152)
AnnotationAssertion(Annotation(dc:source "doi:10.1139/z98-044") skos:example obo:ACTAN_0000333 "\"I measured the flight morphology and linear-acceleration capabilities of some coursing aerial insectivores (Chordeiles minor (Common Nighthawk), Chlidonias niger (Black Tern), Cypseloides niger (Black Swift), Aeronautes saxatalis (White-throated Swift), Chaetura vauxi (Vaux’s Swift), Tachycineta bicolor (Tree Swallow), Tachycineta thalassina (Violet–green Swallow), Hirundo rustica (Barn Swallow), and Petrochelidon pyrrhonota (Cliff Swallow)).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1231780") skos:example obo:ACTAN_0000333 "\"These observations included responses to four large carnivores that commonly kill these prey, including two coursers (wild dog and spotted hyena)...\"")
SubClassOf(obo:ACTAN_0000333 obo:ACTAN_0000331)
SubClassOf(obo:ACTAN_0000333 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000689))

# Class: obo:ACTAN_0000334 (assessment cognition)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000334 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000334 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000334 "2024-10-15T15:09:36.318354Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1016/j.anbehav.2011.01.007") Annotation(skos:scopeNote "\"New evidence suggests that cortical mirror neurons may provide a dedicated neural mechanism underlying emotional contagion: these neurons are activated both when an emotionally loaded behaviour is being perceived and when it is being performed. It has been suggested that this neural shortcut bypasses the need for complex cognitive appraisal of incoming stimuli and thereby enables the emotion to be copied very fast, sometimes in fractions of seconds.\"") oboInOwl:hasDefinition obo:ACTAN_0000334 "Cognition which appraises incoming stimuli.")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasExactSynonym obo:ACTAN_0000334 "assessment"@en)
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasExactSynonym obo:ACTAN_0000334 "discriminating")
AnnotationAssertion(Annotation(dc:date "1982"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1367674") oboInOwl:hasExactSynonym obo:ACTAN_0000334 "evaluating")
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1444-2906.2003.00797.x") oboInOwl:hasExactSynonym obo:ACTAN_0000334 "judgment")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1177/1745691610369469") oboInOwl:hasRelatedSynonym obo:ACTAN_0000334 "cognitive appraisal")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...treat loose eggs like wriggling young.\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000334 "treat like")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000334 "assessment cognition"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000334 "\"...Aequidens latifrons treat loose eggs like wriggling young.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/eth.12027") skos:example obo:ACTAN_0000334 "\"...female zebrafish discriminate the sexes using visual cues, and colour is critical:\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:scopeNote obo:ACTAN_0000334 "\"...examples of social interactions, such as territoriality, dominance, and threat, in which individuals compete by \"conventional\" means—via displays and ritualized aggression rather than overt fighting... is... a means by which individuals may assess their competitive strength relative to others without actually doing battle, in order to adjust their behavior according to their own individual advantage.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1238167") skos:scopeNote obo:ACTAN_0000334 "\"Cues involve multiple sensory modalities which may differ in reliability and detectability, potentially giving rise to variability in the quantity and(or) quality of risk assessment...

...prey may be capable of compensating for reduced information via one sensory modality by increasing their reliance on other modalities.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1238167") skos:scopeNote obo:ACTAN_0000334 "\"We describe a ‘landscape of information’ in which prey rely on publicly available risk assessment information to reduce the uncertainty of predation risks associated with variable threats and the potential impact of natural and anthropogenic environmental factors which may limit information availability.\"")
SubClassOf(obo:ACTAN_0000334 obo:ACTAN_0000270)
SubClassOf(obo:ACTAN_0000334 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000335))
SubClassOf(obo:ACTAN_0000334 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MFOEM_000002))

# Class: obo:ACTAN_0000335 (perception context)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000335 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000335 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000335 "2024-10-15T15:09:54.34483Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1016/j.cub.2019.11.022") Annotation(skos:scopeNote "\"The continuous integration of sensory information is necessary to structure the behavior...

...in a stimulus-response loop each movement generates a new sensory stimulus for the animal that, itself, serves as a trigger for the next movement in the chain.\"") oboInOwl:hasDefinition obo:ACTAN_0000335 "Context in which the integration of sensory information structures subsequent behavior.

In a stimulus-response loop each movement may generate a new sensory stimulus for the animal that, itself, serves as a trigger for the next movement in the chain.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000335 "perceiving"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000335 "perception context")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000335 "\"Considering how flexible thin wax is, I do not see that there is any difficulty in the bees, whilst at work on the two sides of a strip of wax, perceiving when they have gnawed the wax away to the proper thinness, and then stopping their work.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:example obo:ACTAN_0000335 "\"Tinbergen (1953), using models, showed that in Herring Gulls the red spot on the parent's bill is the primary releaser of the pecking response of the chick. Neither the background color of the bill or head color are releasers; in fact, the presence of the head is not even necessary.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000335 "NBO:0000308")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") skos:scopeNote obo:ACTAN_0000335 "\"...their fractal scale of perception (i.e., what may be a distinct space or barrier to one organism may be perceived as a continuum to another larger or differently adapted organism)...\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/bc60659126ef5c0172c2392d485b0c9b/1?pq-origsite=gscholar&cbl=18750") skos:scopeNote obo:ACTAN_0000335 "\"Given that corals may be sensing chromaticity differences from either solar or lunar irradiance, the dynamics of specific wavelengths may have a significant effect on how corals perceive spectral shifts.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.4000/ejpap.2324") skos:scopeNote obo:ACTAN_0000335 "\"When the agent faces a problematic situation, in the first instance, it only perceives and acts, but if the action does not solve the situation, then the normal situation becomes an occasion for inquiry.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") skos:scopeNote obo:ACTAN_0000335 "\"‘A tool is an extension of the hand in both a physical and a perceptual sense’...

...we treat what an organism perceives in the environment as information.\"")
SubClassOf(obo:ACTAN_0000335 obo:ACTAN_0000751)
SubClassOf(obo:ACTAN_0000335 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000077))
SubClassOf(obo:ACTAN_0000335 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0001032))

# Class: obo:ACTAN_0000336 (throw-up ethotype)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000336 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000336 "2025-08-26T17:03:12.765063Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"The \"Throw-up\" of the male Common Shelduck... consists of a body-shake with a very exaggerated upward tossing of the head at the end of the movement, the head-tossing being accompanied by calls... Males perform the Throw-up when they are strongly reproductively active...\"") oboInOwl:hasDefinition obo:ACTAN_0000336 "Ethotype in which a strongly reproductively active male's display consists of a body-shake, head-tossing, and calls.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000336 "throw-up"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:comment obo:ACTAN_0000336 "If a relevant ontology is developed, this would become a subtype of an agonism ethotype.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000336 "throw-up ethotype"@en)
SubClassOf(obo:ACTAN_0000336 obo:ACTAN_0000118)
SubClassOf(obo:ACTAN_0000336 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000324))
SubClassOf(obo:ACTAN_0000336 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000434))
SubClassOf(obo:ACTAN_0000336 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000764))
SubClassOf(obo:ACTAN_0000336 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000317))

# Class: obo:ACTAN_0000337 (vulnerability assessment)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000337 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000337 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000337 "2024-10-15T15:10:27.789576Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Linguistic inference.") oboInOwl:hasDefinition obo:ACTAN_0000337 "Assessment that involves a prolonged threat.")
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.1126/science.239.4847.1525") oboInOwl:hasExactSynonym obo:ACTAN_0000337 "vulnerability"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000337 "vulnerability assessment"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1238167") skos:scopeNote obo:ACTAN_0000337 "\"The optimal or adaptive decision, the one that maximises the individual prey’s fitness, depends on a number of factors including the magnitude of the perceived predation threat, the expected payoff of the antipredator response adopted, the prey’s vulnerability to predation, its current condition, its ‘personality’ and constraints imposed by correlated behaviours.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:scopeNote obo:ACTAN_0000337 "\"The snakes in the bucket might have perceived less vulnerability when in physical contact with the rope or another conspecific, and therefore rattled less.\"")
SubClassOf(obo:ACTAN_0000337 obo:ACTAN_0000334)
SubClassOf(obo:ACTAN_0000337 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MFOEM_000028))

# Class: obo:ACTAN_0000338 (experience perception)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000338 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000338 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000338 "2024-10-15T15:10:44.367291Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"An action, which we ourselves should require experience to enable us to perform, when performed by an animal, more especially by a very young one, without any experience, and when performed by many individuals in the same way, without their knowing for what purpose it is performed, is usually said to be instinctive.\"") oboInOwl:hasDefinition obo:ACTAN_0000338 "Perception which requires an acquired ability to perform an action.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000338 "experience")
AnnotationAssertion(Annotation(dc:date "1922"^^xsd:decimal) Annotation(dc:source "doi:10.2307/2939673") oboInOwl:hasRelatedSynonym obo:ACTAN_0000338 "learning"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000338 "experience perception")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000338 "\"Fear of any particular enemy is certainly an instinctive quality, as may be seen in nestling birds, though it is strengthened by experience, and by the sight of fear of the same enemy in other animals.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2011.0690") skos:example obo:ACTAN_0000338 "\"Zebrafish...

...escalation decreases in losers in subsequent fights, suggesting an experience-driven change in the self-assessment of their own fighting ability...\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000338 "NBO:0000006")
AnnotationAssertion(Annotation(dc:source "doi:10.4000/ejpap.2324") skos:scopeNote obo:ACTAN_0000338 "\"In the case of social learning – a capacity shown by many other species – animals learn by imitation in the presence of a conspecific.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000338 "\"In this way, the predator learns to associate the aposematic cue with a painful experience and will in the future avoid animals that exhibit that signal.\"")
SubClassOf(obo:ACTAN_0000338 obo:ACTAN_0000335)
SubClassOf(obo:ACTAN_0000338 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0007612))

# Class: obo:ACTAN_0000339 (habituation experience)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000339 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000339 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000339 "2024-10-15T15:11:03.858973Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Habituation: Tendency to show a robustly decreased response upon repeated exposure to a novel stimulus/environment.\"") oboInOwl:hasDefinition obo:ACTAN_0000339 "Experience that shows a robustly decreased response upon repeated exposure to a novel stimulus.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000339 "accustoming")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000339 "habituating"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000339 "habituation experience"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000339 "NBO:0000178")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000339 "\"Since previously injured snakes behaved in the same manner as gravid females and warm snakes, it may be that they were less willirig to proactively engage the enemy. As the ditty goes, \"Once bitten, twice shy.\" In my study, it is impossible to determine if this learning represents an altered behavioral decision due to a snake's ability to evaluate and thus, better respond to a predator, or simply a habituated reduction in active behavior due to stress.\"")
SubClassOf(obo:ACTAN_0000339 obo:ACTAN_0000338)
SubClassOf(obo:ACTAN_0000339 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0046959))

# Class: obo:ACTAN_0000340 (recognition experience)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000340 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000340 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000340 "2024-10-15T15:11:19.450112Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000340 "Experience which accepts that its awareness of a present discovery is little different to relatively important knowledge it has of an original discovery.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000340 "recognition"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000340 "recognition experience")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000340 obo:ACTAN_0000411)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000340 "NBO:0000550")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1444-2906.2003.00797.x") skos:example obo:ACTAN_0000340 "\"Eupomacentrus altus, an algal feeding damsel fish, also changed its territorial behavior depending on fish species and feeding habits, and... can recognize the species of invaders.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:example obo:ACTAN_0000340 "\"Female pitvipers frequently aggregate during gestation, with at least one species (Crotalus horridus) forming aggregations consisting of relatives, as pitvipers are capable of kin recognition.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/tops.12554") skos:scopeNote obo:ACTAN_0000340 "\"Grasping involves first recognizing the affordances that an object offers for grasping, moving the grasping appendage toward the object, and preshaping the appendage according to these affordances, and finally enclosing the object at the appropriate areas to establish the grasp.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1238167") skos:scopeNote obo:ACTAN_0000340 "\"Similarly, increased water turbidity limits the ability of fathead minnows to generalise the learned recognition of novel predators\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") skos:scopeNote obo:ACTAN_0000340 "\"The process of individual recognition and learning plays an important role in the establishment of linear dominance hierarchy in small groups of fish because the  dominant fish is able to differentiate and rank subordinate fish into different categories based on previous encounters among individuals. In the case of resource defense, conspecifics manifest differences in fighting ability...\"")
SubClassOf(obo:ACTAN_0000340 obo:ACTAN_0000338)
SubClassOf(obo:ACTAN_0000340 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MF_0000002))

# Class: obo:ACTAN_0000341 (maintenance context)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000341 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000341 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000341 "2024-10-21T08:28:42.751536Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasDefinition obo:ACTAN_0000341 "Context that is concerned with the general health and efficiency of the body.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000341 "maintenance"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000341 "self maintenance")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") rdfs:comment obo:ACTAN_0000341 "Some sources sub-locate locomotor activity (sometimes termed locomotion) within maintenance.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000341 "maintenance context"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000341 obo:ACTAN_0000176)
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pone.0200048") skos:example obo:ACTAN_0000341 "\"It has been shown that temperature is better regulated in beehives in summer, when there is brood in the hive, than in winter. This is likely due to the important role of temperature in egg development; it is known that at too low (i.e. < 33˚C) or too high (i.e. > 36˚C) temperature eggs, larvae and pupae die. Similarly, maintenance of humidity level is crucial for social insects; it directly affects the proper development of eggs, larvae and pupae, which die when the ambient environment is too dry.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000341 "\"KORTLAND, in describing the behaviour elements of the Cormorant, distinguishes as a major group the actions having a maintenance function. In this group he for instance classifies feeding behaviour, withdrawing from danger, migration, and resting, but he also distinguishes two further groups... movements serving to remove discomfort... [and] stretching movements... we do not... see a difference in principle... Therefore, we will call all the movements... comfort movements...\"")
SubClassOf(obo:ACTAN_0000341 obo:ACTAN_0000751)
SubClassOf(obo:ACTAN_0000341 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000077))

# Class: obo:ACTAN_0000342 (thermoregulation homeostasis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000342 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000342 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000342 "2024-10-21T08:29:46.184524Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1371/journal.pone.0200048") Annotation(skos:scopeNote "\"As superorganisms, eusocial insects have evolved many strategies to maintain their nest temperature stable and controlled, especially in order to protect the eggs from extreme temperature variations.\"") oboInOwl:hasDefinition obo:ACTAN_0000342 "Homeostasis that keeps temperature stable and controlled.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000342 "self-thermoregulating")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000342 "thermoregulation"@en)
AnnotationAssertion(Annotation(dc:date "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000342 "thermoregulation homeostasis"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000342 "NBO:0000051")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000342 "\"Ardeola ibis...
The commonest response to high air temperature and solar radiation is gular flutter, which is present from the first day and becomes less frequent as feathering proceeds and insulation improves...
The commonest response to low environmental temperatures is clumping, in which siblings squat on their tarsometatarsi in the centre of their nest, huddling together and facing inwards towards each other.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3354/esr01312") skos:example obo:ACTAN_0000342 "\"Warmer over wintering sites also provide superior thermo regulatory opportunities to pre- and post-emergent snakes, helping prepare individuals for brumation (e.g. purging the gut of food) or ‘kick-starting’ physiological processes (e.g. metabolic rates) for rapid resumption of active season activities. Such habitat also provides a thermal mosaic of rocky features for enhanced thermoregulation and a protective cover for predator evasion, optimal for use by gravid females during the summer months.\"")
SubClassOf(obo:ACTAN_0000342 obo:ACTAN_0000381)
SubClassOf(obo:ACTAN_0000342 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000146))

# Class: obo:ACTAN_0000343 (bask thermoregulation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000343 <https://github.com/Active-Animals/Ontology/patterns/context_by_environmental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000343 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000343 "2024-10-21T08:31:19.469607Z")
AnnotationAssertion(Annotation(dc:source "doi:10.3354/esr01312") Annotation(terms:contributor "https://orcid.org/0000-0002-4277-2151") oboInOwl:hasDefinition obo:ACTAN_0000343 "Thermoregulation that involves insolation exposure.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000343 "basking"@en)
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000343 "sun-bathing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000343 "bask thermoregulation")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000343 "NBO:0000053")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000343 "\"Ardeola ibis chicks...
Sunbathing is infrequent; the bird stands with its back to the sun, wings drooped and slightly spread, all feathers ruffled; first seen at 15 days.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000343 "\"It is well known that gravid females aggregate at suitable basking sites to maintain elevated body temperatures.\"")
SubClassOf(obo:ACTAN_0000343 obo:ACTAN_0000342)
SubClassOf(obo:ACTAN_0000343 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ENVO_01001734))

# Class: obo:ACTAN_0000344 (hygroregulation homeostasis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000344 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000344 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000344 "2024-10-21T08:32:21.230701Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1371/journal.pone.0200048") oboInOwl:hasDefinition obo:ACTAN_0000344 "Homeostasis that keeps humidity stable and controlled.")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1371/journal.pone.0200048") oboInOwl:hasExactSynonym obo:ACTAN_0000344 "hygroregulation"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000344 "hygroregulation homeostasis"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pone.0200048") skos:scopeNote obo:ACTAN_0000344 "\"...considering the colony as a superorganism, its expression of hygroregulation can be different according to different factors like environment of subspecies.\"")
SubClassOf(obo:ACTAN_0000344 obo:ACTAN_0000381)
SubClassOf(obo:ACTAN_0000344 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0015009))

# Class: obo:ACTAN_0000345 (swim-burrowing gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000345 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000345 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000345 "2026-07-20T14:50:56.055483Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"Burrowing is generally effected by an active swimming with the nose pointed into the sand. This is continued until a sufficient length is covered to allow the various muscular contractions to obtain a grip on the sand, after which progress is more rapid, the tail portion then frequently trailing into the burrow passively.\"") oboInOwl:hasDefinition obo:ACTAN_0000345 "Burrowing-gait which is effected by active swimming with the nose pointed into the sand until a sufficient length is covered to allow the various muscular contractions to obtain a grip on the sand.

After this progress is more rapid, the tail portion then frequently trailing into the burrow passively.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...not properly to be considered as swimming is burrowing.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000345 "swimming burrowing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000345 "swim-burrowing gait"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000345 obo:ACTAN_0000913)
SubClassOf(obo:ACTAN_0000345 obo:ACTAN_0000025)
SubClassOf(obo:ACTAN_0000345 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000139))
SubClassOf(obo:ACTAN_0000345 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000163))
SubClassOf(obo:ACTAN_0000345 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000052))
SubClassOf(obo:ACTAN_0000345 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000528))

# Class: obo:ACTAN_0000346 (excretion expulsion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000346 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000346 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000346 "2024-10-21T08:33:11.835439Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/brv.12934") oboInOwl:hasDefinition obo:ACTAN_0000346 "Expulsion which involves the deposition of metabolic waste.")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(rdfs:comment "1859"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000346 "excretion")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icq077") oboInOwl:hasNarrowSynonym obo:ACTAN_0000346 "defecation")
AnnotationAssertion(Annotation(dc:date "2024"^^xsd:decimal) Annotation(dc:source "doi:10.3354/esr01312") oboInOwl:hasNarrowSynonym obo:ACTAN_0000346 "purging"@en)
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2014.08.051") oboInOwl:hasNarrowSynonym obo:ACTAN_0000346 "urination")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000346 "excretion expulsion")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000346 "\"But as the excretion is extremely viscid, it is probably a convenience to the aphides to have it removed; and therefore probably the aphides do not instinctively excrete for the sole good of the ants.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3354/esr01312") skos:scopeNote obo:ACTAN_0000346 "\"Warmer over wintering sites also provide superior thermo regulatory opportunities to pre- and post-emergent snakes, helping prepare individuals for brumation (e.g. purging the gut of food) or ‘kick-starting’ physiological processes (e.g. metabolic rates) for rapid resumption of active season activities.\"")
SubClassOf(obo:ACTAN_0000346 obo:ACTAN_0000715)
SubClassOf(obo:ACTAN_0000346 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000174))

