AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasDefinition obo:ACTAN_0000533 "Flying-regime in which the wings are held close to the body during flight pauses, during which a loss of altitude is experienced.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000533 "bounding flying"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000533 "bounding regime"@en)
