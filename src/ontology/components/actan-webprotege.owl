AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasNarrowSynonym obo:ACTAN_0000934 "overhead anterior reach")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"...forelimbs release the support and are protracted...\"") rdfs:label obo:ACTAN_0000934 "forelimb protracting"@en)
