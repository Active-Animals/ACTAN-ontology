# Class: obo:ACTAN_0000571 (mouth-mouth ethotype)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000571 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000571 "2025-02-06T10:25:56.873471Z")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") oboInOwl:hasBroadSynonym obo:ACTAN_0000571 "kissing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000571 "Ethotype that involves two animal mouths.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000571 "mouth-mouth"@en)
