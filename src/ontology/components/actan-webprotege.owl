# Class: obo:ACTAN_0000072 (alternating-tetrapod-trot gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000072 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000072 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000072 "2026-01-21T16:32:12.545129Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasDefinition obo:ACTAN_0000072 "Trot gait that realizes an octapedal pattern.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasExactSynonym obo:ACTAN_0000072 "alternating tetrapod trotting")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasRelatedSynonym obo:ACTAN_0000072 "alternating tetrapod slow running")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000072 "alternating-tetrapod-trot gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.130.1.155") skos:example obo:ACTAN_0000072 "\"...the ghost crab Ocvpode quadrata (Fabricius)... during sideways locomotion... used a bouncing gait during locomotion at speeds greater than 0.4 m/s... The transition from a slow run to a fast run occurs at nearly the same speed and frequency as the trot-gallop transition in quadrupeds.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.130.1.155") skos:scopeNote obo:ACTAN_0000072 "\"The symmetrical footfall pattern (alternating tetrapod), the linear increase in stride frequency with speed, as well as the time course of the ground reaction force, match the pattern typical of trotting quadrupeds. Crabs obviously can change to a running or bouncing gait, even though no aerial phases are present.\"")
SubClassOf(obo:ACTAN_0000072 obo:ACTAN_0000203)
SubClassOf(obo:ACTAN_0000072 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000199))
SubClassOf(obo:ACTAN_0000072 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000736))
SubClassOf(obo:ACTAN_0000072 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000058))
SubClassOf(obo:ACTAN_0000072 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000138))

# Class: obo:ACTAN_0000073 (alternating-tripod-walk gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000073 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000073 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000073 "2026-01-21T21:08:24.812441Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasDefinition obo:ACTAN_0000073 "Walk gait that realizes a hexapedal pattern.")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000073 "alternating tripod gait")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000073 "alternating-tripod-walk gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000073 "\"The six-legged locomotion of the hermit crab, Coenobita compressus, resembles the typical insect pattern. The hermit crab moves forward like other crustaceans, such as the lobster and crayfish, rather than sideways, and it has an alternating tripod gait...\"")
SubClassOf(obo:ACTAN_0000073 obo:ACTAN_0000134)
SubClassOf(obo:ACTAN_0000073 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000211))
SubClassOf(obo:ACTAN_0000073 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000736))
SubClassOf(obo:ACTAN_0000073 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000057))
SubClassOf(obo:ACTAN_0000073 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000140))

# Class: obo:ACTAN_0000074 (alternating-tripod-trot gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000074 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000074 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000074 "2026-01-21T21:08:40.044888Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.158.1.369") oboInOwl:hasDefinition obo:ACTAN_0000074 "Trot gait that realizes a hexapedal pattern.")
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.158.1.369") oboInOwl:hasExactSynonym obo:ACTAN_0000074 "alternating tripod running gait")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000074 "alternating-tripod-trot gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.158.1.369") skos:example obo:ACTAN_0000074 "\"The six-legged cockroach B. discoidalis used an alternating tripod gait similar to other symmetrical gaits... Even though an aerial phase is absent, this gait has been characterized as a running or bouncing gait.\"")
SubClassOf(obo:ACTAN_0000074 obo:ACTAN_0000203)
SubClassOf(obo:ACTAN_0000074 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000199))
SubClassOf(obo:ACTAN_0000074 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000736))
SubClassOf(obo:ACTAN_0000074 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000057))
SubClassOf(obo:ACTAN_0000074 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000140))

