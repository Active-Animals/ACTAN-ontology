# Class: obo:ACTAN_0000811 (Andean-Goose ethotype)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000811 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000811 "2025-09-01T20:16:18.367901Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"One of the displays of the Andean Goose involves lifting the wings to form an arch over the back. While calling loudly and lifting the wings in this way, both male and female repeatedly give rapid bursts of Tail-wagging.\"") oboInOwl:hasDefinition obo:ACTAN_0000811 "Ethotype in which both male and female call loudly, arch the wings, and repeatedly give rapid bursts of tail-wagging.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000811 "Andean Goose display"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:comment obo:ACTAN_0000811 "If a relevant ontology is developed, this would become a subtype of a display ethotype.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000811 "Andean-Goose ethotype"@en)
SubClassOf(obo:ACTAN_0000811 obo:ACTAN_0000118)
