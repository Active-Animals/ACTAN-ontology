# Class: obo:ACTAN_0000572 (flick mouth-fight)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000572 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000572 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000572 "2025-02-06T10:26:12.794847Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Flick (flicking): A specific agonistic behavior observed when two zebrafish swim towards each other, briefly touch mouths, and then simultaneously flick away in opposite directions; can be repeatedly displayed during agonistic interactions (fight).\"") oboInOwl:hasDefinition obo:ACTAN_0000572 "Mouth-fight in which two fish swim towards each other, briefly touch mouths, and then simultaneously flick away in opposite directions.

Can be repeatedly displayed during fights.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000572 "flick")
