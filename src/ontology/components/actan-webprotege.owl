AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1002/jmor.10788") oboInOwl:hasDefinition obo:ACTAN_0000068 "Mode that uses appendages for aerial activity.")
AnnotationAssertion(Annotation(dc:date "1906"^^xsd:decimal) Annotation(dc:source "doi:10.1086/278651") oboInOwl:hasExactSynonym obo:ACTAN_0000068 "volant")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000068 "winged"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000068 "winged mode"@en)
