AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01001311 "A surface layer which is composed primarily of solid environmental material.")
AnnotationAssertion(rdfs:label obo:ENVO_01001311 "solid surface layer"@en)
SubClassOf(obo:ENVO_01001311 obo:ENVO_00010504)

# Class: obo:ENVO_01001476 (body of liquid)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01001476 "A liquid astronomical body part which is continuous and is delimited by physical discontinuities or non-liquid boundaries."@en)
AnnotationAssertion(oboInOwl:created_by obo:ENVO_01001476 <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(rdfs:label obo:ENVO_01001476 "body of liquid"@en)
SubClassOf(obo:ENVO_01001476 obo:ENVO_01001477)

# Class: obo:ENVO_01001477 (liquid astronomical body part)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01001477 "A part of an astronomical body which is primarily composed of liquid material."@en)
AnnotationAssertion(oboInOwl:created_by obo:ENVO_01001477 <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(rdfs:label obo:ENVO_01001477 "liquid astronomical body part"@en)
SubClassOf(obo:ENVO_01001477 obo:ENVO_01001479)

