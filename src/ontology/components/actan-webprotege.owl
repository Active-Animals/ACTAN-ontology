# Class: obo:UBERON_0002540 (lateral line system)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "ISBN:0471209627") Annotation(oboInOwl:hasDbXref "ISBN:0815318960") Annotation(oboInOwl:hasDbXref "Wikipedia:Lateral_line_system") Annotation(oboInOwl:hasDbXref "http://orcid.org/0000-0002-6601-2165") obo:IAO_0000115 obo:UBERON_0002540 "A line of sensory organs and associated structures along the sides of fish and amphibia that detect vibrations and pressure changes.")
AnnotationAssertion(obo:IAO_0000116 obo:UBERON_0002540 "we model this as being potentially inclusive of lateral line scales, and thus overlapping with the skeletal system. This is to accomodate TAO")
AnnotationAssertion(Annotation(oboInOwl:source "http://tolweb.org/Amniota") obo:RO_0002161 obo:UBERON_0002540 obo:NCBITaxon_32524)
AnnotationAssertion(Annotation(oboInOwl:date_retrieved "2012-08-14") Annotation(oboInOwl:external_class "TAO:0000034") Annotation(oboInOwl:ontology "TAO") Annotation(oboInOwl:source "ZFIN:curator") obo:UBPROP_0000001 obo:UBERON_0002540 "A sensory system on the surface of the fish, consisting of small sensory patches (neuromasts) distributed in discrete lines over the body surface. The lateral line system is stimulated by local water displacements and vibrations, and detects propulsion of the fish through the water, as well as facilitating shoaling, prey capture, and predator and obstacle avoidance. (See Anatomical Atlas entry for lateral line by T. Whitfield.)[TAO]")
AnnotationAssertion(Annotation(oboInOwl:date_retrieved "2012-06-20") Annotation(oboInOwl:external_class "AAO:0000975") Annotation(oboInOwl:ontology "AAO") Annotation(oboInOwl:source "AAO:EJS") obo:UBPROP_0000001 obo:UBERON_0002540 "Sensory system which develops from a specialized series of dorsolateral ectodermal placodes named lateral line placodes.[AAO]")
AnnotationAssertion(Annotation(oboInOwl:date_retrieved "2012-06-20") Annotation(oboInOwl:external_class "AAO:0000975") Annotation(oboInOwl:ontology "AAO") obo:UBPROP_0000002 obo:UBERON_0002540 "relationship loss: is_formed_by lateral line receptor organ (AAO:0001001)[AAO]")
AnnotationAssertion(Annotation(oboInOwl:date_retrieved "2012-09-17") Annotation(oboInOwl:external_class "VHOG:0001243") Annotation(oboInOwl:ontology "VHOG") Annotation(oboInOwl:source "ISBN:978-0471210054 Butler AB and Hodos W, Comparative vertebrate neuroanatomy: Evolution and Adaptation (2005) p.195") Annotation(oboInOwl:source "http://bgee.unil.ch/") obo:UBPROP_0000003 obo:UBERON_0002540 "The mechanosensory lateral line system is widely distributed in aquatic anamniotes. It was apparently present in the earliest vertebrates, as it has been identified in agnathans, cartilaginous fishes, bony fishes, lungfishes, the crossopterygian Latimeria, and aquatic amphibians.[well established][VHOG]")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002540 "AAO:0000269")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002540 "AAO:0000975")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002540 "EFO:0000941")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002540 "MAT:0000249")
AnnotationAssertion(Annotation(pav:authoredBy <https://orcid.org/0000-0001-9439-5346>) Annotation(sssom:mapping_justification <https://w3id.org/semapv/vocab/ManualMappingCuration>) oboInOwl:hasDbXref obo:UBERON_0002540 "MESH:D053403")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002540 "MIAA:0000249")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002540 "TAO:0000034")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002540 "VHOG:0001243")
