# Class: obo:ACTAN_0000348 (feed maintenance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000348 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000348 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000348 "2024-10-21T08:35:07.758569Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Feeding: Behaviors related to consumption of food;\"") oboInOwl:hasDefinition obo:ACTAN_0000348 "Maintenance that is related to consumption of food.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000348 "feeding"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000348 "feed maintenance")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000348 obo:ACTAN_0000846)
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ajpa.1330870108") skos:example obo:ACTAN_0000348 "\"Although lying was not a common feeding posture, when chimpanzees fed while lying the food item was most often fruit or insects.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000348 "NBO:0000079")
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:scopeNote obo:ACTAN_0000348 "\"Since feeding is essential for survival, it impacts numerous processes and decisions throughout an animal’s life. In C. elegans, feeding controls not only growth rate, body size, fat accumulation, brood size, and lifespan, but also behaviors and decisions such as various forms of taxis, dauer decision, and egg-laying. In most cases, sensory perception of food is integrated into the worm’s metabolic status and influences the animal’s behavioral output to maximize its fitness.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:scopeNote obo:ACTAN_0000348 "\"What a struggle between the several kinds of trees must here have gone on during long centuries, each annually scattering its seeds by the thousand; what war between insect and insect—between insects, snails, and other animals with birds and beasts of prey—all striving to increase, and all feeding on each other or on the trees or their seeds and seedlings, or on the other plants which first clothed the ground and thus checked the growth of the trees!\"")
SubClassOf(obo:ACTAN_0000348 obo:ACTAN_0000341)
SubClassOf(Annotation(rdfs:comment "'Bout' used here as a synonym for 'routine'.") Annotation(skos:scopeNote "\"However, if both the upright and on-the-side approaches occur in the same feeding bout the on-the-side technique more often appears first and subsequently is replaced by the upright method.\"

http://www.nativefishlab.net/library/textpdf/15582.pdf") obo:ACTAN_0000348 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000397))

# Class: obo:ACTAN_0000349 (storage feed)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000349 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000349 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000349 "2024-10-21T08:35:23.624748Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1016/j.beproc.2014.10.001") Annotation(skos:scopeNote "\"Food caching, also labeled food storing or food hoarding, is a common behavior in many species of birds and mammals, with the general purpose of concealment and protection of food.\"") oboInOwl:hasDefinition obo:ACTAN_0000349 "Feed which conceals and protects food.")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.beproc.2014.10.001") oboInOwl:hasExactSynonym obo:ACTAN_0000349 "caching")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.beproc.2014.10.001") oboInOwl:hasExactSynonym obo:ACTAN_0000349 "hoarding")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.beproc.2014.10.001") oboInOwl:hasExactSynonym obo:ACTAN_0000349 "storage")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000349 "store"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000349 "storage feed")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000349 obo:ACTAN_0000913)
AnnotationAssertion(skos:broadMatch obo:ACTAN_0000349 "NBO:0020068")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000349 "\"...Tachytes nigra generally makes its own burrow and stores it with paralysed prey for its own larvæ to feed on...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10071-014-0761-0") skos:example obo:ACTAN_0000349 "\"Clark’s nutcrackers are often considered to be the animal champions of long-term spatial memory and can retrieve cached food hordes at least 285 days after they were stashed but a fair degree of forgetting starts to set in after 183 days.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000349 "\"Honeybees, for example, build hexagonal beeswax combs, in which they store honey and raise future generations.\"")
SubClassOf(obo:ACTAN_0000349 obo:ACTAN_0000348)
SubClassOf(obo:ACTAN_0000349 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000301))

# Class: obo:ACTAN_0000350 (handle feed)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000350 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000350 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000350 "2024-10-21T08:35:36.583825Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.2307/3565418") oboInOwl:hasDefinition obo:ACTAN_0000350 "Feed that counters a food hazard by using a careful risk minimization technique.")
AnnotationAssertion(Annotation(dc:date "1989"^^xsd:decimal) Annotation(dc:source "doi:10.2307/3565418") oboInOwl:hasExactSynonym obo:ACTAN_0000350 "handling"@en)
AnnotationAssertion(Annotation(dc:date "1989"^^xsd:decimal) Annotation(dc:source "doi:10.2307/3565418") oboInOwl:hasNarrowSynonym obo:ACTAN_0000350 "prey handling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000350 "handle feed"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.2307/3565418") skos:example obo:ACTAN_0000350 "\"Ictalurid catfish possess locking spines which make them dangerous to gape-limited predators such as herons and grebes, but not to ospreys (Pandion haliaetus) which dismember prey. Herons and grebes handled ictalurids longer than prey without locking spines, but osprey did not.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/3565418") skos:scopeNote obo:ACTAN_0000350 "\"Some prey are risky to eat, as defensive structures of prey (e.g., spines, thorns, claws) may injure or kill a predator during ingestion. But predators may counter these defenses with a variety of handling behaviours (e.g., dismemberment, crushing, stabbing) which serve to kill or incpacitate prey.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000350 "\"The derived venom delivery systems of elapids and viperids most likely evolved first as an adaptation to aid in the capture, handling, and digestion of prey.\"")
SubClassOf(obo:ACTAN_0000350 obo:ACTAN_0000348)
SubClassOf(obo:ACTAN_0000350 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000801))
SubClassOf(obo:ACTAN_0000350 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000498))

# Class: obo:ACTAN_0000351 (trap hunt)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000351 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000351 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000351 "2024-10-21T08:35:51.653754Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/j.1469-185X.2010.00163.x") Annotation(skos:scopeNote "\"Trap-building (hereafter, TB) arthropod predators, such as pit-building antlions orweb-building spiders, can be classified as sit-and-wait predators, since they invest no energy or time in searching for prey, but need only a suitable place to construct a specific trap.\"") oboInOwl:hasDefinition obo:ACTAN_0000351 "Hunt that uses a suitably placed, specific construction.")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1469-185X.2010.00163.x") oboInOwl:hasExactSynonym obo:ACTAN_0000351 "trapping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000351 "trap hunt")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000351 "NBO:0015002")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000351 "\"For example, the external casings and nets constructed by caddisfly larvae can serve to protect the larva’s soft body and trap food items flowing through streams.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1469-185X.2010.00163.x") skos:scopeNote obo:ACTAN_0000351 "\"...the behaviour of trap-building predators is not stereotypic or fixed as was once commonly accepted, rather it can vary greatly, depending on the individual’s internal state and its interactions with external environmental factors.\"")
SubClassOf(obo:ACTAN_0000351 obo:ACTAN_0000358)
SubClassOf(obo:ACTAN_0000351 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000272))

# Class: obo:ACTAN_0000352 (farm feed)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000352 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000352 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000352 "2024-10-21T08:36:05.486744Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/j.cub.2022.06.072") oboInOwl:hasDefinition obo:ACTAN_0000352 "Feed in which a live, nourishing resource is tended and protected.

This usually provides mutualistic benefits.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasExactSynonym obo:ACTAN_0000352 "culturing"@en)
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2022.06.072") oboInOwl:hasExactSynonym obo:ACTAN_0000352 "farming")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasNarrowSynonym obo:ACTAN_0000352 "milking")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2022.06.072") oboInOwl:hasRelatedSynonym obo:ACTAN_0000352 "harvesting")
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2003.11.017") oboInOwl:hasRelatedSynonym obo:ACTAN_0000352 "resource monopolization")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000352 "farm feed"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000352 "\"Formica sanguinea... In Switzerland the slaves and masters work together, making and bringing materials for the nest: both, but chiefly the slaves, tend, and milk as it may be called, their aphides; and thus both collect food for the community.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000352 "\"I allowed an ant to visit them, and it immediately seemed, by its eager way of running about, to be well aware what a rich flock it had discovered; it then began to play with its antennæ on the abdomen first of one aphis and then of another; and each aphis, as soon as it felt the antennæ, immediately lifted up its abdomen and excreted a limpid drop of sweet juice, which was eagerly devoured by the ant.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000352 "\"Leaf-cutter ants, for example, have chambers deep within their nests where they culture the fungus that feeds their colonies.\"")
SubClassOf(obo:ACTAN_0000352 obo:ACTAN_0000348)
SubClassOf(obo:ACTAN_0000352 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000291))

# Class: obo:ACTAN_0000353 (forage feed)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000353 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000353 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000353 "2024-10-21T08:36:22.181077Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1038/s41467-023-38685-1") Annotation(skos:scopeNote "\"E.g., animals will use multiple sources of information in order to select between different foraging strategies balancing the risks and benefits of local resource exploitation versus long-range exploration.\"") oboInOwl:hasDefinition obo:ACTAN_0000353 "Feed which balances the risks and benefits of local resource exploitation versus long-range exploration.")
AnnotationAssertion(Annotation(dc:date "1975"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000353 "foraging"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000353 "food seeking")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000353 "forage feed"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") skos:example obo:ACTAN_0000353 "\"A dolphin picks up a marine sponge and uses it as a glove on its rostrum during foraging. The dolphin encounters no stinging animals or sharp surfaces while foraging... 

To the extent that the glove may aid in foraging (currently an open inference), it can be considered a tool: it changes the dynamics of the mechanical interaction between the dolphin’s rostrum and foraging surfaces.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000353 "NBO:0015003")
SubClassOf(obo:ACTAN_0000353 obo:ACTAN_0000348)
SubClassOf(obo:ACTAN_0000353 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000301))

# Class: obo:ACTAN_0000354 (cut bite)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000354 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000354 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000354 "2024-10-21T08:36:36.359364Z")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1111/tops.12554") oboInOwl:hasBroadSynonym obo:ACTAN_0000354 "cutting"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.4000/ejpap.2324") oboInOwl:hasDefinition obo:ACTAN_0000354 "Bite which penetrates the object's surface.

It may remove part of the object.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000354 "cut bite")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/beheco/12.5.534") skos:example obo:ACTAN_0000354 "\"...in the harvester desert termite Anacanthotermes macrocephalus. The termites cut blades of grass and transport them back to the nest.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.4000/ejpap.2324") skos:example obo:ACTAN_0000354 "\"Among mammals, beavers (genus Castor) modify the environment using huge logs, branches (which they themselves cut) and mud structures to dam streams and create ponds where they build their lodges, also built with branches and mud.\"")
SubClassOf(obo:ACTAN_0000354 obo:ACTAN_0000113)
SubClassOf(obo:ACTAN_0000354 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001576))

# Class: obo:ACTAN_0000355 (graze forage)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000355 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000355 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000355 "2024-10-21T08:36:51.436313Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1073/pnas.2122563119") Annotation(dc:source "doi:10.1242/jeb.194704") oboInOwl:hasDefinition obo:ACTAN_0000355 "Forage that involves a diet of organisms living on a surface.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000355 "grazing"@en)
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1231780") Annotation(rdfs:seeAlso obo:ECOCORE_00000099) Annotation(skos:scopeNote "\"...vegetation types were classified as ‘grazing’, which were areas dominated by open grassland, ‘cover’, which were areas dominated by trees or shrubs, and ‘grazing-cover’, which were areas with a mixture...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000355 "vegetation grazing")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(rdfs:comment "Throughout The Origin Of Species, Darwin does not mention grazing, and his mention of turf being 'browsed' suggests he did not differentiate the behaviours, or at least not the labels.") Annotation(skos:scopeNote "\"...turf closely browsed by quadrupeds...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000355 "browsing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000355 "graze forage"@en)
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000355 "NBO:0050000")
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:scopeNote obo:ACTAN_0000355 "\"Facultative suspension-feeding tadpoles are benthic grazers that have external keratinized beaks and denticles, which they use to reduce detritus, macrophytes, and periphytic films to a size small enough to be brought into the mouth in suspension.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1073/pnas.2122563119") skos:scopeNote obo:ACTAN_0000355 "\"Standing with its shoulders up to 4 m tall, the African elephant relies on its 1.5-m-long trunk to manipulate objects. The trunk is flexible enough to reach down to the ground (grazing) or up into a tree (browsing).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.194704") skos:scopeNote obo:ACTAN_0000355 "\"The remaining 11 species can be classified as benthic grazers, as a large portion of their diet is composed of sessile or slow-moving benthic organisms.\"")
SubClassOf(obo:ACTAN_0000355 obo:ACTAN_0000353)
SubClassOf(obo:ACTAN_0000355 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00010504))

# Class: obo:ACTAN_0000356 (browse forage)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000356 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000356 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000356 "2024-10-21T08:37:03.789586Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.3389/fetho.2023.1231780") oboInOwl:hasDefinition obo:ACTAN_0000356 "Forage that involves larger vegetation.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"But on looking closely between the stems of the heath, I found a multitude of seedlings and little trees, which had been perpetually browsed down by the cattle.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000356 "browsing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000356 "browse forage")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12317") skos:example obo:ACTAN_0000356 "\"As ambient over-winter temperatures have progressively increased with climate change, reductions in snow cover have enabled increased numbers of elk (Cervus canadensis) to occupy North American woodlands throughout the winter months. Browsing activity of these elk populations has reduced the growth of saplings and limited their availability as nesting sites in the subsequent summer months.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/1365-2435.13457") skos:scopeNote obo:ACTAN_0000356 "\"Herbivorous fishes can be categorized into browsers, which remove established macroalgae, and a diverse guild of grazers that feed on surfaces covered with algal turfs...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1073/pnas.2122563119") skos:scopeNote obo:ACTAN_0000356 "\"Standing with its shoulders up to 4 m tall, the African elephant relies on its 1.5-m-long trunk to manipulate objects. The trunk is flexible enough to reach down to the ground (grazing) or up into a tree (browsing).\"")
SubClassOf(obo:ACTAN_0000356 obo:ACTAN_0000353)
SubClassOf(obo:ACTAN_0000356 ObjectSomeValuesFrom(obo:RO_0000057 obo:PO_0009011))

# Class: obo:ACTAN_0000357 (flexibility switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000357 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000357 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000357 "2025-07-08T13:23:01.325824Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1016/j.cub.2019.11.022") Annotation(skos:scopeNote "\"Alternatively, in a stimulus response loop each movement generates a new sensory stimulus for the animal that, itself, serves as a trigger for the next movement in the chain.\"") oboInOwl:hasDefinition obo:ACTAN_0000357 "Switch in which a movement generates a new sensory stimulus for the animal that, itself, serves as a trigger for the next movement.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") Annotation(skos:scopeNote "\"...the flexible or variable introductory phase of an instinctive behaviour pattern...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000357 "flexible behaviour pattern"@en)
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s002650100391") oboInOwl:hasExactSynonym obo:ACTAN_0000357 "situation-dependent flexibility")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") oboInOwl:hasExactSynonym obo:ACTAN_0000357 "stimulus response loop")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000357 "variable activity")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") Annotation(skos:scopeNote "\"...the flexible or variable introductory phase of an instinctive behaviour pattern...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000357 "variable behaviour pattern"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000357 "flexibility switch")
AnnotationAssertion(Annotation(dc:source "doi:10.4000/ejpap.2324") skos:example obo:ACTAN_0000357 "\"...dolphins, which live in aquatic environments, have the capacity to echo-localize, as well as a flexible and social way of learning.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s002650100391") skos:example obo:ACTAN_0000357 "\"Hanuman langurs (Semnopithecus entellus)... are not only socially flexible but also able to survive even under poor nutritional conditions... Because females have only behavioral signs of estrus and pregnant females mate regularly, there seems to be ample opportunity for situation-dependent flexibility in mating behavior.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:scopeNote obo:ACTAN_0000357 "\"An even less complete performance of the prey-capturing behavior is commonly observed after the fish has devoured several crustacea in quick succession. The fish simply swims directly to the prey and takes it into its mouth. All intermediates are seen in the degree of completeness of prey-capturing behavior.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000357 "\"This is necessary in order to distinguish the invariable fixed motor pattern of the activity from the variable orientating element, the taxis.\"")
SubClassOf(obo:ACTAN_0000357 obo:ACTAN_0000893)
SubClassOf(obo:ACTAN_0000357 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001303))

# Class: obo:ACTAN_0000358 (hunt forage)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000358 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000358 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000358 "2024-10-21T08:37:28.561529Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3389/fetho.2023.1231780") Annotation(skos:scopeNote "\"These patterns remained consistent in models that controlled for differences in the hunting mode of the predator (stalking, coursing, or intermediate) and for differences among ecosystems.\"") oboInOwl:hasDefinition obo:ACTAN_0000358 "Forage that involves a predatory mode.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000358 "hunting"@en)
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasRelatedSynonym obo:ACTAN_0000358 "predation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000358 "hunt forage")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(rdfs:comment "1961"^^xsd:decimal) skos:example obo:ACTAN_0000358 "\"The most significant characteristic of hunting behavior in Badis badis is that catching and eating each prey produces steadily increasing parsimony of behavior in capturing the next, if this is done at once.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000358 "NBO:0009003")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1238167") skos:scopeNote obo:ACTAN_0000358 "\"Predation is a pervasive and unforgiving selection pressure on prey populations. A large and diverse body of research has explored the impacts of predation on the life history, morphology, physiology and behaviour of prey on both ecological and evolutionary time scales. Predators can exert adverse effects on their prey either directly by killing them or indirectly by instilling ‘fear’ in them, which induces behavioural, physiological and neurobiological costs on individuals attempting to avoid predation.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1231780") skos:scopeNote obo:ACTAN_0000358 "\"Predators can affect prey not only by killing them, but also by causing them to alter their behavior, including patterns of habitat selection.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") skos:scopeNote obo:ACTAN_0000358 "\"Thus, zebrafish larvae have a unique repertoire of bouts reserved for hunting and produce stereotyped and dynamic sequences using these bouts.\"")
SubClassOf(obo:ACTAN_0000358 obo:ACTAN_0000353)
SubClassOf(obo:ACTAN_0000358 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000907))
SubClassOf(obo:ACTAN_0000358 ObjectSomeValuesFrom(obo:RO_0000057 obo:ECOCORE_00000148))

# Class: obo:ACTAN_0000359 (roving hunt)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000359 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000359 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000359 "2024-10-21T08:37:40.517299Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000359 "Hunt in which a predator moves relative to its prey.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000359 "capture"@en)
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.1126/science.239.4847.1525") Annotation(skos:scopeNote "\"...the lagomorph harvest...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000359 "harvest")
AnnotationAssertion(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") Annotation(dc:source "1984"^^xsd:decimal) Annotation(skos:scopeNote "\"...a roving method of hunting...\"") rdfs:label obo:ACTAN_0000359 "roving hunt")
AnnotationAssertion(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") skos:example obo:ACTAN_0000359 "\"...roving predators such as the bonefish (Albula) and the pompano (Trachinotus)...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") skos:scopeNote obo:ACTAN_0000359 "\"Here, we use unsupervised methods to study behavioral sequences in zebrafish larvae. We generate a map of swim bouts, revealing that fish modulate their tail movements along a continuum. During prey capture, larvae produce stereotyped sequences using a subset of bouts from a broader behavioral repertoire...

Capturing prey is an innate and essential behavior for the survival of many animals.\"")
SubClassOf(obo:ACTAN_0000359 obo:ACTAN_0000358)
SubClassOf(obo:ACTAN_0000359 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000288))

# Class: obo:ACTAN_0000360 (subsistence homeostasis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000360 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000360 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000360 "2024-10-21T20:03:37.22132Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1177/10597123211040574") oboInOwl:hasDefinition obo:ACTAN_0000360 "Homeostasis by which the organism takes physical substance from the environment and incorporates it into its own body, and the reverse – active removal from the body and deposition into the environment.

Consumption includes taking in oxygen, water, amino acids, fats, other sources of energy and minerals. Excretion includes urination, CO2 release, defecation, vomiting.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1177/10597123211040574") oboInOwl:hasExactSynonym obo:ACTAN_0000360 "physical exchange")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000360 "subsistence")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasNarrowSynonym obo:ACTAN_0000360 "consuming"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasNarrowSynonym obo:ACTAN_0000360 "excreting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000360 "subsistence homeostasis")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000360 "\"...thus the alimentary canal respires, digests, and excretes in the larva of the dragon-fly and in the fish Cobites.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1177/10597123211040574") skos:scopeNote obo:ACTAN_0000360 "\"For many homeostatic resources (like water and oxygen), the organism will die in the long run if a subsistence level of consumption is not maintained, and it is in this sense that the organism needs these resources.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:scopeNote obo:ACTAN_0000360 "\"Male lawn-leaving depends on several sensory inputs that reflect the animal balancing its reproductive drive with its need to consume food.\"")
SubClassOf(obo:ACTAN_0000360 obo:ACTAN_0000381)
SubClassOf(obo:ACTAN_0000360 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00010483))

# Class: obo:ACTAN_0000361 (harvest forage)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000361 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000361 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000361 "2024-10-21T19:07:16.164855Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasDefinition obo:ACTAN_0000361 "Forage in which fruit is removed from vegetation.

This includes seed.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000361 "harvesting"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasRelatedSynonym obo:ACTAN_0000361 "cropping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000361 "harvest forage"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000361 "\"Chimpanzee...
Crop fruits in a tree, from shrubs on the ground...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ajpa.1330870108") skos:scopeNote obo:ACTAN_0000361 "\"Fruit found in small trees was harvested most often by squatting, perhaps because the trunk itself was the largest and most stable perch from which to feed.\"")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") skos:scopeNote obo:ACTAN_0000361 "The term 'harvest' is often used synonymously for different forms of farming and foraging, but is used selectively here.")
SubClassOf(obo:ACTAN_0000361 obo:ACTAN_0000353)
SubClassOf(obo:ACTAN_0000361 ObjectSomeValuesFrom(obo:RO_0000057 obo:PO_0009001))

# Class: obo:ACTAN_0000362 (continuous-ram filter)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000362 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000362 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000362 "2024-10-22T10:37:09.89192Z")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasBroadSynonym obo:ACTAN_0000362 "ram-feeding"@en)
AnnotationAssertion(Annotation(rdfs:isDefinedBy "ISBN:9780226315737") Annotation(skos:scopeNote "\"Ram feeders engulf a volume of water by swimming forward with an open mouth (figs. 2.1, 2.2). Continuous ram feeders allow water to escape posteriorly from the mouth as they swim, maintaining an open mouth for sustained periods of time.\"") oboInOwl:hasDefinition obo:ACTAN_0000362 "Filter that engulfs a volume of water by swimming forward with an open mouth, allowing water to escape posteriorly from the mouth, for sustained periods of time.")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000362 "continuous-ram"@en)
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000362 "skimming")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000362 "tow-net filter feeding")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000362 "continuous-ram filter"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/36.6.555") skos:example obo:ACTAN_0000362 "\"Members of the Amphistichinae are found in structurally simple habitats (e.g., open water above a sandy ocean floor) and exhibit ram feeding.\"")
SubClassOf(obo:ACTAN_0000362 obo:ACTAN_0000363)
SubClassOf(obo:ACTAN_0000362 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000723))
SubClassOf(obo:ACTAN_0000362 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000689))

# Class: obo:ACTAN_0000363 (filter hunt)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000363 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000363 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000363 "2024-10-22T11:27:11.860291Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.jstor.org/stable/24815071") Annotation(skos:scopeNote "\"The terms 'suspension feeding' or 'filter feeding' have been coined to designate feeding in aquatic animals that have evolved special structures to process the surrounding water and to retain small suspended particles, including food particles such as phytoplankton cells.\"") oboInOwl:hasDefinition obo:ACTAN_0000363 "Hunt in which special structures process the surrounding water to retain small food particles.")
AnnotationAssertion(Annotation(dc:date "1983"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/24815071") oboInOwl:hasExactSynonym obo:ACTAN_0000363 "filter feeding")
AnnotationAssertion(Annotation(dc:date "1983"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/24815071") oboInOwl:hasExactSynonym obo:ACTAN_0000363 "suspension feeding"@en)
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasNarrowSynonym obo:ACTAN_0000363 "plankton feeding")
AnnotationAssertion(Annotation(dc:date "1983"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/24815071") oboInOwl:hasNarrowSynonym obo:ACTAN_0000363 "sieving")
AnnotationAssertion(Annotation(dc:date "2025"^^xsd:decimal) Annotation(dc:source "doi:10.1073/pnas.2503495122") oboInOwl:hasRelatedSynonym obo:ACTAN_0000363 "harvesting")
AnnotationAssertion(Annotation(rdfs:comment "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000363 "filter hunt")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000363 obo:ACTAN_0000713)
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:scopeNote obo:ACTAN_0000363 "\"SUSPENSION-FEEDING AQUATIC ANIMALS capture planktonic prey as water flows past the feeding apparatus.\"")
SubClassOf(obo:ACTAN_0000363 obo:ACTAN_0000358)
SubClassOf(obo:ACTAN_0000363 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00000063))

# Class: obo:ACTAN_0000364 (continuous-suction filter)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000364 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000364 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000364 "2024-10-22T11:30:02.923272Z")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasBroadSynonym obo:ACTAN_0000364 "pump filter feeding")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "ISBN:9780226315737") Annotation(skos:scopeNote "\"Continuous Suction Feeders. An odd collection of animals comes under this heading: ammocoetes, tadpoles, certain ducks, and flamingos (table 2.4). What these organisms share is a dependence on an oscillating buccopharyngeal pump to generate feeding currents. Continuous suction feeders remain relatively stationary when feeding and thus, unlike most other suspension feeders, their locomotor capability is not directly linked to their feeding morphology.\"") oboInOwl:hasDefinition obo:ACTAN_0000364 "Filter that depends on an oscillating buccopharyngeal pump to generate feeding currents.

Continuous suction feeders remain relatively stationary when feeding.")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000364 "continuous suction"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000364 "continuous-suction filter"@en)
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:example obo:ACTAN_0000364 "\"Ammocoetes and tadpoles, are small benthic or midwater forms for which mucus entrapment and ciliary transport are essential components of their suspension-feeding mechanism. They all have gill slits with internal entrapment surfaces that are part of their gill system.

The second group, containing suspension-feeding birds, is made up of air breathers that are restricted to feeding in either shallow water or at the water's surface. They lack gill slits and have lamellae at the margins of their jaws that form the filters.\"")
SubClassOf(obo:ACTAN_0000364 obo:ACTAN_0000363)
SubClassOf(obo:ACTAN_0000364 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000590))
SubClassOf(obo:ACTAN_0000364 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000689))

# Class: obo:ACTAN_0000365 (intermittent-ram filter)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000365 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000365 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000365 "2024-10-22T11:40:03.385211Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "ISBN:9780226315737") Annotation(skos:scopeNote "\"Ram feeders engulf a volume of water by swimming forward with an open mouth (figs. 2.1, 2.2)... Intermittent ram feeders use their forward velocity to force their mouths open widely (fig. 2.3) and fill their buccal cavity in a single pulse... In order for intermittent ram feeding to work, the inertial forces must be very high and the buccal floor compliant, otherwise the pressure head anterior to the animal would push water and food away.\"") oboInOwl:hasDefinition obo:ACTAN_0000365 "Filter that engulfs a volume of water by swimming forward with an open mouth, and fill the buccal cavity in a single pulse.

In order for intermittent ram feeding to work, the inertial forces must be very high and the buccal floor compliant, otherwise the pressure head anterior to the animal would push water and food away.")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000365 "intermittent ram"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000365 "intermittent-ram filter"@en)
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:example obo:ACTAN_0000365 "\"The rorqual whales direct their attacks on schools of fishes or local concentrations of krill. Complex herding behaviors may be used to further concentrate prey in front of the whales before they open their mouths.\"")
SubClassOf(obo:ACTAN_0000365 obo:ACTAN_0000363)
SubClassOf(obo:ACTAN_0000365 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000122))
SubClassOf(obo:ACTAN_0000365 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000427))

# Class: obo:ACTAN_0000366 (intermittent-suction filter)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000366 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000366 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000366 "2024-10-22T11:45:12.871656Z")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasBroadSynonym obo:ACTAN_0000366 "pump filter feeding")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "ISBN:9780226315737") Annotation(skos:scopeNote "\"Compared to continuous suction feeders, species in this category generate suction with aperiodic pulses... The way water is transported into the mouth by intermittent suction feeders is similar to that used by the myriad of planktivorous fishes that visually locate, attack, and engulf individual prey items using suction. However, during suspension feeding, the predator does not usually alter its swimming speed or direction to focus attention on individual plankters.\"") oboInOwl:hasDefinition obo:ACTAN_0000366 "Filter that generates aperiodic pulses of water into the mouth, but does not usually alter its swimming speed or direction to focus attention on individual plankters.

A predator with a gape that is large enough to engulf more than one prey at a time may use intermittent suction feeding when the prey are not dense enough or are too large to elicit continuous ram feeding.")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000366 "gulping")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000366 "intermittent suction"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000366 "intermittent-suction filter"@en)
SubClassOf(obo:ACTAN_0000366 obo:ACTAN_0000363)
SubClassOf(obo:ACTAN_0000366 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000590))
SubClassOf(obo:ACTAN_0000366 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000427))

# Class: obo:ACTAN_0000367 (alarm maintenance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000367 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000367 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000367 "2024-10-22T20:33:29.855664Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3389/fetho.2023.1181774") Annotation(skos:scopeNote "\"Acute stressors are short-term, such as a storm, or an encounter with a predator or aggressive conspecific, resulting in immediate physiological or behavioral responses modulated by the sympathetic nervous system, which temporarily suspend normal life functions.\"") oboInOwl:hasDefinition obo:ACTAN_0000367 "Maintenance in which an immediate behavioral response is modulated by the sympathetic nervous system, which temporarily suspends normal life functions.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1181774") oboInOwl:hasExactSynonym obo:ACTAN_0000367 "acute stress")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...animals not being much alarmed by danger...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000367 "alarm")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000367 "fear-like")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasNarrowSynonym obo:ACTAN_0000367 "fear")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasNarrowSynonym obo:ACTAN_0000367 "fright")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000367 "anxiety")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1002/jnr.24550") oboInOwl:hasRelatedSynonym obo:ACTAN_0000367 "anxiety-like")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000367 "alarm maintenance")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000367 obo:ACTAN_0000382)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000367 "NBO:0000470")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000367 "\"Alarm reaction may also include freezing with frequent opercular movements, changes in shoaling (e.g., rapid 1–2 s decreases of shoal cohesion followed by longer-lasting, up to several minutes, increase of shoal cohesion) and diving.\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000367 "\"Ardeola ibis...
Birds will often respond to Alert in one of their numbers by following suit, so that the attitude acts as an alarm signal.\"")
SubClassOf(obo:ACTAN_0000367 obo:ACTAN_0000341)
SubClassOf(obo:ACTAN_0000367 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MF_0000003))

# Class: obo:ACTAN_0000368 (taxis travel)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000368 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000368 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000368 "2024-11-05T11:34:06.006575Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1038/s41467-023-38685-1") oboInOwl:hasDefinition obo:ACTAN_0000368 "Travel that is oriented along a perceived environmental gradient.

This may have positive or negative valence.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000368 "taxis"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000368 "taxis travel"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000368 "NBO:0000375")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") skos:example obo:ACTAN_0000368 "\"Short integration windows for deciding the next behavior have been observed in thermal navigation of larvae and social affiliation of juvenile zebrafish.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000368 "\"The most extreme type of Avoiding is panicky flight ; the behavior has negative valence since the only taxis is away from the stimulus, if the stimulus is located.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000368 "\"This is necessary in order to distinguish the invariable fixed motor pattern of the activity from the variable orientating element, the taxis.\"")
SubClassOf(obo:ACTAN_0000368 obo:ACTAN_0000178)
SubClassOf(obo:ACTAN_0000368 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001769))

# Class: obo:ACTAN_0000369 (autotomy alarm)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000369 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000369 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000369 "2024-10-22T20:48:53.274472Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/brv.12539") Annotation(skos:scopeNote "\"Herein, we simply define autotomy as the self-controlled loss of a body part at a predetermined breakage location.\"") oboInOwl:hasDefinition obo:ACTAN_0000369 "Alarm which involves the self-controlled loss of a body part at a predetermined breakage location.")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000369 "autotomy"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000369 "autotomy alarm")
AnnotationAssertion(skos:broadMatch obo:ACTAN_0000369 "NBO:0070000")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:scopeNote obo:ACTAN_0000369 "\"...many arthropods have limbs that may be autotomized. The animals frequently regenerate such appendages, but in the meantime, they must adjust their locomotion to compensate for imbalances created by the loss of such limbs.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12539") skos:scopeNote obo:ACTAN_0000369 "\"To differentiate autotomy from moulting/shedding, we also specify that autotomy should not be restricted to a certain climatic season or transitional period during development. We find this purely descriptive definition to be suitable for numerous reasons. First, autotomy has additional benefits beyond that of escaping predation, thus whether an individual uses autotomy in an anti-predatory context should not be incorporated into the definition. Second, by removing adaptive benefits from the definition, we can also begin to move away from a purely adaptive perspective and therefore broaden our scope, and hopefully our understanding, of autotomy.\"")
SubClassOf(obo:ACTAN_0000369 obo:ACTAN_0000367)
SubClassOf(obo:ACTAN_0000369 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0010000))

# Class: obo:ACTAN_0000370 (true autotomy)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000370 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000370 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000370 "2024-10-22T20:49:26.032133Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"Morphological adaptations include cryptic as well as brilliant coloration and specialized structures such as the skeletal, vascular, and muscular arrangement found in lizards that have true tail autotomy - behaviorally controlled tail-loss.\"") oboInOwl:hasDefinition obo:ACTAN_0000370 "Autotomy that is behaviorally controlled.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"...true tail autotomy...\"") rdfs:label obo:ACTAN_0000370 "true autotomy"@en)
SubClassOf(obo:ACTAN_0000370 obo:ACTAN_0000369)
SubClassOf(obo:ACTAN_0000370 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000931))

# Class: obo:ACTAN_0000371 (defence alarm)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000371 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000371 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000371 "2024-10-22T20:49:45.086337Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"Howver. many animals that defend a territory live in colonies (gulls, terns, herons, the lizard Anolis sagrei, Centrarchid fish etc); they apparently seek each other's company when establishing a nesting place, but they do not like their fellows to approach them beyond certain limits.\"") oboInOwl:hasDefinition obo:ACTAN_0000371 "Alarm that responds in place to an overly close approach.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000371 "defence")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000371 "defense"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000371 "defence alarm")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000371 "\"Positive defense consists of spreading the fins. This may be accompanied by rotating the body slightly, presenting the erect dorsal fin spines to the object eliciting the behavior.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000371 "\"The ostrich indeed inhabits continents and is exposed to danger from which it cannot escape by flight, but by kicking it can defend itself from enemies, as well as any of the smaller quadrupeds.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000371 "NBO:0000636")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:scopeNote obo:ACTAN_0000371 "\"Defensive behavior can also be used to indicate the level of acute stress and can be readily measured in rattlesnakes, which are known for their elaborate defensive displays that include head-elevated coiling, tailrattling, striking, and venomous bites.\"")
SubClassOf(obo:ACTAN_0000371 obo:ACTAN_0000367)
SubClassOf(obo:ACTAN_0000371 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001638))

# Class: obo:ACTAN_0000372 (resistance defence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000372 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000372 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000372 "2024-10-22T20:50:06.918618Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3389/fetho.2023.1238167") Annotation(skos:scopeNote "\"Antipredator behavioural responses to perceived acute predation threats (i.e. fear of predation) include increased vigilance, grouping behaviour, avoidance (through camouflage, reduced activity, seeking refuge or fleeing, for example), deterrence behaviour and aggressive defence.\"") oboInOwl:hasDefinition obo:ACTAN_0000372 "Defence that is aggressive.")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rsbl.2015.0325") oboInOwl:hasExactSynonym obo:ACTAN_0000372 "active defence")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000372 "active defense")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1238167") oboInOwl:hasExactSynonym obo:ACTAN_0000372 "aggressive defence")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000372 "aggressive defense")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasExactSynonym obo:ACTAN_0000372 "aggressively defending"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000372 "resistance")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000372 "resistance defence")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12018") skos:example obo:ACTAN_0000372 "\"In scorpions, it is speculated that the injection of a pre-venom into the female’s body tranquilises females and so reduces physical resistance to mating.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000372 "\"Nocomis also exhibits extreme sexual dimorphism during the breeding season. Nuptial males develop sharp cephalic tubercles and aggressively defend their spawning sites from conspecific intruders and potential egg predators such as suckers.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000372 "NBO:0020230")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1238167") skos:scopeNote obo:ACTAN_0000372 "\"Antipredator behavioural responses to perceived acute predation threats (i.e. fear of predation) include increased vigilance, grouping behaviour, avoidance (through camouflage, reduced activity, seeking refuge or fleeing, for example), deterrence behaviour and aggressive defence.\"")
SubClassOf(obo:ACTAN_0000372 obo:ACTAN_0000371)
SubClassOf(obo:ACTAN_0000372 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000385))

# Class: obo:ACTAN_0000373 (passivity defence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000373 "https://github.com/Active-Animals/Ontology/patterns/context_by_realization")
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000373 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000373 "2024-10-22T20:50:23.027927Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"An alternative hypothesis is that being gravid more severely constrains a snake's ability to physically perform active defense than to escape by fast locomotion, so a gravid female has no choice but to flee. Instead of an active defense, a gravid female before flight may rely on more passive defensive behavior, such as chemical defense.\"") oboInOwl:hasDefinition obo:ACTAN_0000373 "Defence which uses other methods than physical activity or escape.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000373 "passive defensive"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000373 "passivity defence")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000373 "\"An alternative hypothesis is that being gravid more severely constrains a snake's ability to physically perform active defense than to escape by fast locomotion, so a gravid female has no choice but to flee. Instead of an active defense, a gravid female before flight may rely on more passive defensive behavior, such as chemical defense.\"")
SubClassOf(obo:ACTAN_0000373 obo:ACTAN_0000371)
SubClassOf(obo:ACTAN_0000373 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000289))

# Class: obo:ACTAN_0000374 (startle switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000374 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000374 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000374 "2024-10-22T20:51:15.047604Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Startle response: An evolutionarily conserved, adaptive behavior in response to sudden, usually aversive, stimuli, such as vibration, light, sound, or touching;\"") oboInOwl:hasDefinition obo:ACTAN_0000374 "Stimulation switch that is in response to sudden stimuli.")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1177/1745691610369469") oboInOwl:hasExactSynonym obo:ACTAN_0000374 "startle response")
AnnotationAssertion(Annotation(dc:date "1922"^^xsd:decimal) Annotation(dc:source "doi:10.2307/2939673") oboInOwl:hasRelatedSynonym obo:ACTAN_0000374 "startle"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000374 "startle switch")
SubClassOf(obo:ACTAN_0000374 obo:ACTAN_0000893)
SubClassOf(obo:ACTAN_0000374 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001912))

# Class: obo:ACTAN_0000375 (antipredation switch)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000375 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000375 "2024-10-22T20:51:45.067338Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12891") Annotation(skos:scopeNote "\"For clarity, we use the phrase ‘antipredator strategy’ to mean the combination of defences an animal uses such as crypsis, masquerade, aposematism, deimatism, and/or types of mimicry, each of which may be encountered by predators or deployed by prey at different stages of the predation sequence and may be multimodal and/or multicomponent. We expand the primary/secondary defences dichotomy to recognise that an antipredator strategy can be a sequence of any length – primary, secondary, tertiary, quaternary, quinery, etc.\"") oboInOwl:hasDefinition obo:ACTAN_0000375 "Condition switch that strategically combines defences an animal uses at different stages of the predation sequence.

It may be multimodal and/or multicomponent. An antipredator strategy can be a sequence of any length – primary, secondary, tertiary, quaternary, quinery, etc.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasRelatedSynonym obo:ACTAN_0000375 "antipredator"@en)
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasRelatedSynonym obo:ACTAN_0000375 "resistant prey")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000375 "antipredation switch"@en)
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000375 "\"Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000375 "NBO:0015001")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:scopeNote obo:ACTAN_0000375 "\"...an anti-predatory response exhibited in the context of fear-inducing stimulation (e.g., chemical alarm cue or visual predator exposure).\"")
SubClassOf(obo:ACTAN_0000375 obo:ACTAN_0000553)

# Class: obo:ACTAN_0000376 (avoidance alarm)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000376 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000376 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000376 "2024-10-22T20:52:01.215832Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"1.12. Avoidance: Increased movement away and/or time spent away from an object or a stimulus (e.g., predator, bright light);\"") oboInOwl:hasDefinition obo:ACTAN_0000376 "Alarm that shows an increased amount of movement and time spent away from something.

It may be an object or a stimulus.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") oboInOwl:hasExactSynonym obo:ACTAN_0000376 "avoidance"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000376 "avoidance alarm"@en)
AnnotationAssertion(skos:broadMatch obo:ACTAN_0000376 "NBO:0000635")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000376 "\"Behavioral adaptations to predation in squamates range from avoidance tactics such as locomotor escape, cryptic locomotion patterns, differing degrees of wariness and shifted times of activity to specialized and stereotyped behavior such as elaborate tail displays, postures, and sounds.\"")
SubClassOf(obo:ACTAN_0000376 obo:ACTAN_0000367)
SubClassOf(obo:ACTAN_0000376 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000927))

# Class: obo:ACTAN_0000377 (flush-bury crypsis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000377 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000377 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000377 "2026-07-20T15:35:07.271924Z")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") Annotation(skos:scopeNote "\"...bury themselves...\"") oboInOwl:hasBroadSynonym obo:ACTAN_0000377 "self burying")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000377 "Crypsis which conceals with wafted substrate.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...throw the sand over...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000377 "over throw")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000377 "flush-bury crypsis"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000377 obo:ACTAN_0000913)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000377 "\"...skates and flounders generally throw the sand over themselves...\"")
SubClassOf(obo:ACTAN_0000377 obo:ACTAN_0000461)
SubClassOf(obo:ACTAN_0000377 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000396))

# Class: obo:ACTAN_0000378 (monopolization alarm)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000378 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000378 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000378 "2024-10-22T20:52:37.920668Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") oboInOwl:hasDefinition obo:ACTAN_0000378 "Alarm that agonistically defends a resource.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000378 "guarding")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000378 "protection"@en)
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2003.11.017") oboInOwl:hasExactSynonym obo:ACTAN_0000378 "resource defence")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") oboInOwl:hasExactSynonym obo:ACTAN_0000378 "resource defense")
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2003.11.017") oboInOwl:hasExactSynonym obo:ACTAN_0000378 "resource monopolization")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000378 "on the watch")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000378 "monopolization alarm"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000378 obo:ACTAN_0000293)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000378 "\"...even the tiger in India most rarely dares to attack a young elephant protected by its dam.\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000378 "\"It is not known whether this high percentage of attentiveness occurs in other Ardeidae, but its function in A. ibis is almost certainly to_protect the eggs and young from predators and the nest itself from stick-stealing birds.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:example obo:ACTAN_0000378 "\"Where males defend territories, receptive females commonly show a strong preference both for joining territorial males rather than nonterritorial males and for joining males that are already defending large harems rather than those without females or with small harems. Some of the clearest evidence here comes from studies of lek-breeding ungulates such as fallow deer, Uganda kob and Kafue lechwe which live in large unstable herds of mixed membership, lacking a consistent male dominance hierarchy.\"")
SubClassOf(obo:ACTAN_0000378 obo:ACTAN_0000367)
SubClassOf(obo:ACTAN_0000378 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MF_0000060))

# Class: obo:ACTAN_0000379 (evasion avoidance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000379 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000379 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000379 "2024-10-22T20:52:49.672427Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasDefinition obo:ACTAN_0000379 "Avoidance that involves sudden, rapid, locomotion.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.202.6.661") oboInOwl:hasExactSynonym obo:ACTAN_0000379 "evading"@en)
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2014.08.051") oboInOwl:hasExactSynonym obo:ACTAN_0000379 "evasion")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000379 "evasive action")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000379 "evasive movement")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasRelatedSynonym obo:ACTAN_0000379 "dashing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000379 "evasion avoidance")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000379 "\"Aequidens latifrons...
The male often butts the female and she tries to evade these pushes.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") skos:scopeNote obo:ACTAN_0000379 "\"Some types of prey have developed greater manoeuvrability which can be used to evade attacks made by predators with quicker acceleration.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3354/esr01312") skos:scopeNote obo:ACTAN_0000379 "\"Such habitat also provides a thermal mosaic of rocky features for enhanced thermoregulation and a protective cover for predator evasion, optimal for use by gravid females during the summer months.\"")
SubClassOf(obo:ACTAN_0000379 obo:ACTAN_0000376)
SubClassOf(obo:ACTAN_0000379 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000548))

# Class: obo:ACTAN_0000380 (hiding avoidance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000380 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000380 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000380 "2024-10-22T20:52:59.748047Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasDefinition obo:ACTAN_0000380 "Avoidance in which an animal attempts to conceal itself.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000380 "concealing")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000380 "hiding"@en)
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000380 "secreting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000380 "hiding avoidance"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") skos:example obo:ACTAN_0000380 "\"An orang-utan hides from humans or predators behind a detached branch.\"")
AnnotationAssertion(Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") skos:example obo:ACTAN_0000380 "\"The results also indicate that goby size was limited by colony width on J. juncea, which may be from the way B. amplus hides behind it... gobies substantially wider than their host are less capable of using it to avoid detection by predators.\"")
SubClassOf(obo:ACTAN_0000380 obo:ACTAN_0000376)
SubClassOf(obo:ACTAN_0000380 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002508))

# Class: obo:ACTAN_0000381 (homeostasis maintenance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000381 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000381 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000381 "2024-10-22T20:53:35.667401Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1177/1745691610369469") Annotation(skos:scopeNote "\"Physiological motives The adaptive function of what Maslow called physiological needs is fairly straightforward; he included here homeostatic needs such as hunger and thirst, which are obviously essential for survival. Logically, the satisfaction of such physiological needs is foundational to other motives.\"") oboInOwl:hasDefinition obo:ACTAN_0000381 "Maintenance which satisfies foundational physiological needs.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/beheco/12.5.534") oboInOwl:hasExactSynonym obo:ACTAN_0000381 "homeostatic property"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000381 "comfort")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000381 "homeostasis maintenance")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/beheco/12.5.534") skos:scopeNote obo:ACTAN_0000381 "\"...large colony size is likely to be associated with relatively greater homeostatic properties of the colony...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pone.0200048") skos:scopeNote obo:ACTAN_0000381 "\"Nest homeostasis provides not only an incubator for the brood, but also a thermal refuge for individuals to use temperature gradients to regulate their own body temperature.\"")
SubClassOf(obo:ACTAN_0000381 obo:ACTAN_0000341)
SubClassOf(obo:ACTAN_0000381 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001912))

# Class: obo:ACTAN_0000382 (danger assessment)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000382 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000382 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000382 "2024-10-22T20:54:17.503505Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Linguistic inference.") oboInOwl:hasDefinition obo:ACTAN_0000382 "Assessment that involves an imminent threat.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"It is not that chickens have lost all fear, but fear only of dogs and cats, for if the hen gives the danger-chuckle, they will run (more especially young turkeys) from under her, and conceal themselves in the surrounding grass or thickets;\"") oboInOwl:hasExactSynonym obo:ACTAN_0000382 "danger"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000382 "danger response")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000382 "threat")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000382 "danger assessment")
AnnotationAssertion(Annotation(dc:source "doi:10.1023/A:1005565304671") skos:scopeNote obo:ACTAN_0000382 "\"Tactile and other somatosensory inputs from a tail that is draped, hooked, or twisted around a branch may provide the brain with information about whole-body orientation relative to absolute space. In the terminal branch setting, this sensory information may enable monkeys to maneuver in three-dimensional space with less danger of losing their balance and falling.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:scopeNote obo:ACTAN_0000382 "\"The antagonism between danger and hunger is conserved across animals. For instance, in mammals, a risk of predation suppresses roaming when well-fed, but extreme hunger overrides danger perception and results in prioritizing food-seeking behavior.\"")
SubClassOf(obo:ACTAN_0000382 obo:ACTAN_0000334)
SubClassOf(obo:ACTAN_0000382 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MFOEM_000026))

# Class: obo:ACTAN_0000383 (interaction context)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000383 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000383 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000383 "2024-11-05T11:36:28.179922Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Social interaction: Normal social behavior of zebrafish, represents a reciprocal change in zebrafish behavior influenced by the presence or actions of other conspecifics.\"") oboInOwl:hasDefinition obo:ACTAN_0000383 "Context that represents a reciprocal change in social behaviour influenced by the presence and actions of others.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000383 "social behavior")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000383 "social interaction")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasExactSynonym obo:ACTAN_0000383 "sociality"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000383 "anti-social behaviour")
AnnotationAssertion(Annotation(dc:date "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000383 "interaction context"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000383 "\"These social hermit crabs are the only species that architecturally remodel the interior of shells, creating ‘remodeled homes’, which are superior for use on land and which are reused socially across generations. Architecture for social hermit crabs includes not just an individual’s current shell, but rather the entire ‘housing market’ of remodeled shells, which represent potential future homes an individual may acquire if it navigates the market successfully.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2022.1066186") skos:scopeNote obo:ACTAN_0000383 "\"Individual behavior can be heavily influenced by variation in social context – contextual variables like the density of individuals and the composition of different personalities or behavioral types of individuals within groups or populations.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2022.1066186") skos:scopeNote obo:ACTAN_0000383 "\"Individuals of many species engage regularly if not constantly in social behavior – individuals in social species spend large parts of their lives in social groups, in close proximity and often engaging in interactions with conspecifics. Even in species in which  individuals spend most of their lives solitary (e.g., orb weaving spiders), individuals still have to mate, and occasionally have to interact with others in ways that affect social proximity (e.g., territoriality). Furthermore, we are  learning more about the importance to individuals of living in social groups composed of multiple species...

Recent advances in social network approaches are now putting us in a position to understand better how networks of signaling relate to networks of other social behavior (such as affiliations or agonistic interactions), and this should help us better understand how social interactions build into the social relationships that create the structure of groups.\"")
SubClassOf(obo:ACTAN_0000383 obo:ACTAN_0000751)
SubClassOf(obo:ACTAN_0000383 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000077))

# Class: obo:ACTAN_0000384 (agonism interaction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000384 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000384 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000384 "2024-11-05T11:36:56.926219Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasDefinition obo:ACTAN_0000384 "Interaction in which an encounter involves degrees of fearful alertness, and aggressive threat.")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") oboInOwl:hasExactSynonym obo:ACTAN_0000384 "agonistic interaction"@en)
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasRelatedSynonym obo:ACTAN_0000384 "hostility")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000384 "agonism interaction")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000384 "NBO:0000121")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/000579509X12512865686555") skos:example obo:ACTAN_0000384 "\"An African black eagle, white-faced capuchins, and elephants engaged in agonism by directed throwing/dropping of objects at or on another individual.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00265-010-0980-6") skos:example obo:ACTAN_0000384 "\"Male guppies... agonistic interactions... are significant because dominant males have direct access to females and this increases the proportion of the brood males can sire.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2022.1066186") skos:scopeNote obo:ACTAN_0000384 "\"Recent advances in social network approaches are now putting us in a position to understand better how networks of signaling relate to networks of other social behavior (such as affiliations or agonistic interactions), and this should help us better understand how social interactions build into the social relationships that create the structure of groups.\"")
SubClassOf(obo:ACTAN_0000384 obo:ACTAN_0000383)
SubClassOf(obo:ACTAN_0000384 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MFOEM_000001))

# Class: obo:ACTAN_0000385 (antagonism agonism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000385 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000385 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000385 "2024-11-05T11:37:13.796791Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") Annotation(rdfs:comment "This broad synonym has the potential to be a catch-all for multiple overlapping elements. Whilst it may have linguistic utility, and is often used in behavioural literature, it is problematic as a definitional parent class.") oboInOwl:hasBroadSynonym obo:ACTAN_0000385 "aggression")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.jstor.org/stable/986582") Annotation(skos:scopeNote "\"By adopting an \"opposite\" or antagonistic alternative an individual in effect alters the contest so that he or she can win.\"") oboInOwl:hasDefinition obo:ACTAN_0000385 "Agonism that is oppositional.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000385 "antagonistic tendency"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000385 "pugnacious")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000385 "quarrelling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000385 "antagonism agonism")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000385 "\"Aggression: Complex behaviors (including approach, fin raise, undulating body movement, mouth opening behavior, body color change, biting, charging, chasing, and circling) directed at conspecifics (or other objects) in adult zebrafish; may appear in the context of defending the territory (territorial behavior), protecting resources (e.g., females) and establishing dominance.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000385 "NBO:0000015")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:scopeNote obo:ACTAN_0000385 "\"This surprised us given the gregarious nature of female rattlesnakes during gestation and maternal attendance of young , as well as the antagonism (including combat) between males during the breeding season , with the latter potentially exacerbating an acute stress response.\"")
SubClassOf(obo:ACTAN_0000385 obo:ACTAN_0000384)
SubClassOf(obo:ACTAN_0000385 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MFOEM_000009))

# Class: obo:ACTAN_0000386 (attack antagonism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000386 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000386 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000386 "2024-11-05T11:37:28.371618Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000386 "Antagonism in which short, fast bouts of physical contact are directed at an opponent.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000386 "attack")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000386 "combat"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000386 "molesting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000386 "attack antagonism")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000386 "NBO:0020033")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000386 "\"It may be difficult, but we ought to admire the savage instinctive hatred of the queen-bee, which urges her instantly to destroy the young queens her daughters as soon as born, or to perish herself in the combat;\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000386 "\"Thalassoma cupido...
The lizardfish Synodus variegatus (Lacepede)... was observed to attack with great speed just as the wrasses formed the characteristic close-knit group immediately prior to the upward dash.\"")
SubClassOf(obo:ACTAN_0000386 obo:ACTAN_0000385)
SubClassOf(obo:ACTAN_0000386 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000925))

# Class: obo:ACTAN_0000387 (dominance ranking)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000387 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000387 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000387 "2024-11-05T11:37:49.970574Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000387 "Ranking that manages its position by maintaining control of a resource.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000387 "dominance"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000387 "mastering")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000387 "superiorism")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000387 "superiority")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000387 "dominance ranking")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") rdfs:seeAlso obo:ACTAN_0000387 obo:ACTAN_0000385)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000387 obo:ACTAN_0001028)
AnnotationAssertion(Annotation(dc:source "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") skos:example obo:ACTAN_0000387 "\"...white-seabream...
...the dominant fish relinquished the resource (because it was satiated) to the second fish in line...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1231780") skos:scopeNote obo:ACTAN_0000387 "\"Bouskila found a strong shift out of dangerous microhabitats by competitively dominant D. deserti when the predator was present, and a weaker shift into dangerous microhabitats by competitively subordinate D. merriami.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:scopeNote obo:ACTAN_0000387 "\"During the mating season, males engage in male-male combat to establish dominance, with the dominant male gaining priority access to mate with the female.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") skos:scopeNote obo:ACTAN_0000387 "\"In the case of resource defense, conspecifics manifest differences in fighting ability, and, thus, the energy invested by the owner specimens to keep all the competitors at bay from the resource will not be equally distributed (i.e., either the degree of agonistic interactions with each competitor or the duration of the contests).\"")
SubClassOf(obo:ACTAN_0000387 obo:ACTAN_0000552)
SubClassOf(obo:ACTAN_0000387 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000382))

# Class: obo:ACTAN_0000388 (interference competition)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000388 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000388 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000388 "2024-11-05T17:10:00.678316Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/s00265-020-02893-2") Annotation(skos:scopeNote "\"Interference competition refers to direct negative interactions resulting from aggressive behaviour.\"") oboInOwl:hasDefinition obo:ACTAN_0000388 "Competition which involves direct negative interactions resulting from aggressive behaviour.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000388 "interference"@en)
AnnotationAssertion(Annotation(dc:date "1976"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1439-0310.1976.tb00970.x") oboInOwl:hasNarrowSynonym obo:ACTAN_0000388 "detracting")
AnnotationAssertion(Annotation(dc:date "1976"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1439-0310.1976.tb00970.x") oboInOwl:hasRelatedSynonym obo:ACTAN_0000388 "disruption")
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2003.11.017") rdfs:label obo:ACTAN_0000388 "interference competition"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000388 "\"...a small tuberculate male Campostoma anomalum (stoneroller) in breeding color disrupted 10 spawning sequences between the resident male and several female Nocomis leptocephalus (chub).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1231780") skos:scopeNote obo:ACTAN_0000388 "\"Bouskila inferred that 'the dominant species primarily responds to the distribution of risk from the predator, while the subordinate species appears to respond to both the risk of predation and the risk of interference from the dominant competitor'.\"")
SubClassOf(obo:ACTAN_0000388 obo:ACTAN_0000389)
SubClassOf(obo:ACTAN_0000388 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000893))

# Class: obo:ACTAN_0000389 (competition agonism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000389 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000389 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000389 "2024-11-05T11:38:21.811703Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"Amongst birds, the contest is often of a more peaceful character. All those who have attended to the subject, believe that there is the severest rivalry between the males of many species to attract by singing the females.\"") oboInOwl:hasDefinition obo:ACTAN_0000389 "Agonism that involves rivalry.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000389 "competition"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000389 "contest")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000389 "competition agonism")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/978-3-319-68576-2_3") skos:example obo:ACTAN_0000389 "\"Bats and common nighthawks (Chordeiles minor) have been observed in competitive interaction over insects at a human light source.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1231780") skos:scopeNote obo:ACTAN_0000389 "\"...changes in habitat use to avoid predationmay be constrained by competition: larger, dominant competitors should respond freely to predation risk, but the responses of smaller, subordinate competitors may be constrained by the responses of dominant competitors.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1231780") skos:scopeNote obo:ACTAN_0000389 "\"Many factors other than predation risk affect habitat selection. Notably, population density alters habitat selection within a species or foraging guild. At low density, all individuals can occupy high quality patches with little competition, but as competitors accumulate in high quality habitat patches, changing cost-benefit ratios favor the use of lower quality patches, particularly by subordinate competitors.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:scopeNote obo:ACTAN_0000389 "\"Thalassoma cupido...
Yet under favorable conditions, initial phase males will also compete for access to single females.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1238167") skos:scopeNote obo:ACTAN_0000389 "\"The potential fitness benefits to an individual expressing one or more of these antipredator behaviours is increased survivorship and reproductive success, but at the potential fitness-related costs of expended energy and lost behavioural opportunities such as foraging, mating, parental care and territorial defence. Vice versa, engaging in any of the latter competing behavioural activities may increase an individual’s susceptibility to predation.\"")
SubClassOf(obo:ACTAN_0000389 obo:ACTAN_0000384)
SubClassOf(obo:ACTAN_0000389 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000553))

# Class: obo:ACTAN_0000390 (symbolizing nontooling)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000390 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000390 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000390 "2024-11-05T11:40:01.722615Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/tops.12554") oboInOwl:hasDefinition obo:ACTAN_0000390 "Nontooling that symbolizes an object.

This may include communication and play symbols.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1111/tops.12554") oboInOwl:hasExactSynonym obo:ACTAN_0000390 "symbolizing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000390 "symbolizing nontooling"@en)
SubClassOf(obo:ACTAN_0000390 obo:ACTAN_0000287)
SubClassOf(obo:ACTAN_0000390 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000628))
SubClassOf(obo:ACTAN_0000390 ObjectSomeValuesFrom(obo:RO_0000057 obo:BFO_0000040))

# Class: obo:ACTAN_0000391 (destruction technic)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000391 <https://github.com/Active-Animals/Ontology/patterns/technical_realizing_routine>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000391 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000391 "2024-11-05T11:40:23.106063Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:isDefinedBy "doi:10.1163/1568539X-00003574") Annotation(skos:scopeNote "\"By contrast, the nest destruction behaviour in the video shows a female standing on the dome of the nest and pulling it apart with her feet with her head in an upright position.\"") oboInOwl:hasDefinition obo:ACTAN_0000391 "Technic in which an artifact is pulled apart.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000391 "destruction"@en)
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000391 "destruction technic"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/1568539X-00003574") skos:example obo:ACTAN_0000391 "\"...female Superb Lyrebirds (Menura novaehollandiae), a solitary breeding species with very low fecundity and uniparental care, destroy the nests of rival females.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000391 "\"Male bowerbirds construct bowers from interwoven sticks and decorate the fl oor of their courtship arena with all manner of colorful objects, each assembled into discrete piles with great precision, including berries, shells, and even human-made objects, like bottle caps or poker chips. Sometimes these ornamental objects are stolen by competing males, who even attempt to destroy the bowers of rivals.\"")
SubClassOf(obo:ACTAN_0000391 obo:ACTAN_0000271)
SubClassOf(obo:ACTAN_0000391 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000096))

