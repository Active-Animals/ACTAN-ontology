# Class: obo:UBERON_0001137 (dorsum)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "BSPO:0000063") Annotation(oboInOwl:hasDbXref "UBERONREF:0000006") Annotation(oboInOwl:hasDbXref "Wikipedia:Dorsum_(anatomy)") obo:IAO_0000115 obo:UBERON_0001137 "A major subdivision of an organism that is the entire part of the organism dorsal to a horizontal plane and bounded on one side by the same transverse plane. In vertebrares this includes the vertebral column..")
AnnotationAssertion(obo:UBPROP_0000007 obo:UBERON_0001137 "dorsal")
AnnotationAssertion(obo:UBPROP_0000008 obo:UBERON_0001137 "In humans, called the back, a large posterior area of the human body, rising from the top of the buttocks to the back of the neck and the shoulders. It is the surface opposite to the chest, its height being defined by the vertebral column (commonly referred to as the spine or backbone) and its breadth being supported by the ribcage and shoulders. The spinal canal runs through the spine and provides nerves to the rest of the body")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0001137 "BTO:0001713")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0001137 "CALOHA:TS-2223")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0001137 "EFO:0001405")
