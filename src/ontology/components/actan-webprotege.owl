# Class: obo:ACTAN_0000942 (hindlimb retraction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000942 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000942 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000942 "2026-08-02T14:25:09.316401Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000942 "Retraction that results from hindlimb retracting.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000942 "hindlimb retraction"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/jzo.12455") skos:example obo:ACTAN_0000942 "\"...it is likely that two-toed sloths are controlling their center of mass position through the mechanism... in which interlimb coordination is timed so that a protracted propulsive forelimb early in its support phase is synchronized with a retracted ipsilateral braking hind limb late in its support phase.\"")
SubClassOf(obo:ACTAN_0000942 obo:ACTAN_0000941)
SubClassOf(obo:ACTAN_0000942 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002103))

# Class: obo:ACTAN_0000943 (limb tucking)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000943 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000943 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000943 "2026-08-02T18:59:51.882855Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000943 "Tucking that involves a limb.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"...burying one foot...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000943 "foot burying")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"...tuck the feet...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000943 "foot tucking")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF00197760") Annotation(skos:scopeNote "\"...tuck their legs underneath;\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000943 "leg tucking")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000943 "limb tucking"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000943 "\"The function of burying one foot in the flanks is probably, as HEINROTH (1991) suggested, to keep it warm.... Mallards will tuck the feet forward in the flank feathers while flying in sub-zero temperatures...\"")
SubClassOf(obo:ACTAN_0000943 obo:ACTAN_0000018)
SubClassOf(obo:ACTAN_0000943 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002101))

# Class: obo:ACTAN_0000944 (head tucking)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000944 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000944 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000944 "2026-08-02T19:00:02.460318Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/auk/123.4.967") Annotation(skos:scopeNote "\"...tucking head to wrist;\"") oboInOwl:hasDefinition obo:ACTAN_0000944 "Tucking that involves the head.")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "doi:10.1093/auk/123.4.967") Annotation(skos:scopeNote "\"...tucking head...\"") rdfs:label obo:ACTAN_0000944 "head tucking"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000944 "\"Chimpanzee...
The head is mostly kept rather low and tucked back between the shoulders which are pulled upwards.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000944 "\"Larger snakes have better venom delivery systems and can first warn a predator. If the predator does not respond to the aposematic signal, they can deliver a few effective bites, then cover up their heads and withstand a brief attack while they wait for the envenomation to repel the attacker.\"")
SubClassOf(obo:ACTAN_0000944 obo:ACTAN_0000018)
SubClassOf(obo:ACTAN_0000944 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000033))

# Class: obo:ACTAN_0000945 (tail tucking)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000945 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000945 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000945 "2026-08-02T19:00:15.90808Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") Annotation(skos:scopeNote "\"Or again, the folded wing might be held lower, along side and flank, so that wing tip lay against the ventral surface of the tail, as the tail was tucked under and pressed forward.\"") oboInOwl:hasDefinition obo:ACTAN_0000945 "Tucking that involves the tail.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") Annotation(skos:scopeNote "\"...tail was tucked...\"") rdfs:label obo:ACTAN_0000945 "tail tucking"@en)
SubClassOf(obo:ACTAN_0000945 obo:ACTAN_0000018)
SubClassOf(obo:ACTAN_0000945 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002415))

