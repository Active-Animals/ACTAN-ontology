AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Photokinesis (phototaxis): General movement in response to light, including positive (light seeking/dark avoidance, scotophobia) and negative (light avoidance, dark preference, scototaxis).\"") oboInOwl:hasDefinition obo:ACTAN_0000587 "Taxis that responds to light.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000587 "photokinesis")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000587 "dark avoidant")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000587 "dark preference")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000587 "light avoidant")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000587 "light seeking")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000587 "scotophobia"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000587 "scototaxis"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000587 "ultraviolet avoidant")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") rdfs:label obo:ACTAN_0000587 "photo-taxis"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000587 "NBO:0000383")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000587 "\"Zebrafish display sensitivity to visible light (positive phototaxis in larval fish...)\"")
SubClassOf(obo:ACTAN_0000587 obo:ACTAN_0000368)
