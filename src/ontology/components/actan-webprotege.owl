# Class: obo:ACTAN_0000968 (barbel extending)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000968 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000968 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000968 "2026-09-07T08:14:06.921452Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") Annotation(skos:scopeNote "\"Contraction of the muscle to the upper ligament lowers the barbel whereas contraction of the muscle to the lower ligament retracts the barbel.\"") oboInOwl:hasDefinition obo:ACTAN_0000968 "Extending that involves a barbel.")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") Annotation(skos:scopeNote "\"...lowers the barbel...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000968 "barbel lowering")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000968 "barbel extending"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2026.123487") skos:example obo:ACTAN_0000968 "\"The striped red mullet, Mullus surmuletus, is a benthic feeding goatfish species that uses its barbels to detect and excavate invertebrates from the substrate.\"")
SubClassOf(obo:ACTAN_0000968 obo:ACTAN_0000726)
SubClassOf(obo:ACTAN_0000968 ObjectSomeValuesFrom(obo:RO_0000057 obo:ZFA_0000622))

# Class: obo:ACTAN_0000969 (barbel flexing)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000969 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000969 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000969 "2026-09-07T09:39:07.31639Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") Annotation(skos:scopeNote "\"Contraction of the muscle to the upper ligament lowers the barbel whereas contraction of the muscle to the lower ligament retracts the barbel.\"") oboInOwl:hasDefinition obo:ACTAN_0000969 "Flexing that involves a barbel.")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") Annotation(skos:scopeNote "\"...barbels are folded...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000969 "barbel folding")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") Annotation(skos:scopeNote "\"...raise or lower the barbel...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000969 "barbel raising")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") Annotation(skos:scopeNote "\"...retracts the barbel.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000969 "barbel retracting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000969 "barbel flexing"@en)
AnnotationAssertion(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") skos:example obo:ACTAN_0000969 "\"When a goatfish is not feeding, the barbels are folded back under the rims of the chin and gill covers.\"")
