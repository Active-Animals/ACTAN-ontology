# Class: obo:ACTAN_0000743 (contracting movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000743 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000743 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000743 "2025-06-11T13:21:18.043122Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasDefinition obo:ACTAN_0000743 "Movment that changes a shape by displacing its volume.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000743 "contraction"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasNarrowSynonym obo:ACTAN_0000743 "deflation")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasRelatedSynonym obo:ACTAN_0000743 "retraction")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000743 "contracting movement")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000743 obo:ACTAN_0000625)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000743 obo:ACTAN_0000665)
AnnotationAssertion(Annotation(dc:source "https://www.researchgate.net/profile/Lina-Barrios-2/post/any_idea_about_these_anemones/attachment/59d61dea79197b807797c41b/AS%3A273509083512833%401442221055505/download/Fautin+et+al+2015-+Sea+anemones+of+Singapore.pdf") skos:example obo:ACTAN_0000743 "\"Bunodosoma goanense... Animals sensitive to light: tentacles contract in area where light shines on them.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5343/bms.2014.1055") skos:example obo:ACTAN_0000743 "\"The same males and females of T. albomaculosus mated repeatedly in pairs on the same day. Although the release of gametes was not visible to the naked eye, the abdomens of the females deflated gradually over the repeated matings.\"")
SubClassOf(obo:ACTAN_0000743 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000743 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000596))

# Class: obo:ACTAN_0000744 (expanding movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000744 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000744 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000744 "2025-06-11T13:21:28.861498Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasDefinition obo:ACTAN_0000744 "Movement that changes a shape by increasing its volume.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") Annotation(skos:scopeNote "\"...extrusion of acontia.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000744 "extrusion")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasNarrowSynonym obo:ACTAN_0000744 "inflation")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasRelatedSynonym obo:ACTAN_0000744 "expansion"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000744 "expanding movement"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000744 obo:ACTAN_0000620)
AnnotationAssertion(Annotation(dc:source "https://www.researchgate.net/profile/Lina-Barrios-2/post/any_idea_about_these_anemones/attachment/59d61dea79197b807797c41b/AS%3A273509083512833%401442221055505/download/Fautin+et+al+2015-+Sea+anemones+of+Singapore.pdf") skos:example obo:ACTAN_0000744 "\"Specimens of Pelocoetes exul, like those of Stephensonactis ornata, expand mainly at night...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") skos:scopeNote obo:ACTAN_0000744 "\"Great inflation is quite common in nature after feeding. The phenomenal power of anemones to expand in this way is well known.\"")
SubClassOf(obo:ACTAN_0000744 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000744 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000595))

