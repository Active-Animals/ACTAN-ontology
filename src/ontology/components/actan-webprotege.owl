# Class: obo:ACTAN_0000255 (coiled-concertina gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000255 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000255 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000255 "2024-10-06T10:05:37.807691Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasDefinition obo:ACTAN_0000255 "Climbing gait in which the body resembles a coiled spring whilst concertinaing, wrapping with nearly all of the body to grip the cylinder.

This absence of alternating bends to the left and right in the propulsive region of the animal is distinct from all other known modes of animal locomotion that use vertebral bending for propulsion.")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icaa017") Annotation(rdfs:comment "2020"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000255 "concertina with helical wrapping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000255 "coiled-concertina gait")
SubClassOf(obo:ACTAN_0000255 obo:ACTAN_0000256)
SubClassOf(obo:ACTAN_0000255 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000006))
SubClassOf(obo:ACTAN_0000255 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000926))
SubClassOf(obo:ACTAN_0000255 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000052))
