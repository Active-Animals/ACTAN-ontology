AnnotationAssertion(Annotation(oboInOwl:date_retrieved "2012-09-17") Annotation(oboInOwl:external_class "VHOG:0000342") Annotation(oboInOwl:ontology "VHOG") Annotation(oboInOwl:source "ISBN:978-0072528305 Kardong KV, Vertebrates: Comparative Anatomy, Function, Evolution (2006) p.332") Annotation(oboInOwl:source "http://bgee.unil.ch/") obo:UBPROP_0000003 obo:UBERON_0001467 "(...) endochondral elements of the early tetrapod shoulder develop from two centers of ossification, giving rise to a scapula and a 'coracoid'.[well established][VHOG]")
