# Class: obo:ACTAN_0000837 (relief cooperation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000837 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000837 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000837 "2025-09-14T20:01:20.510907Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000837 "Cooperation that replaces another in performing a duty.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000837 "relief")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000837 "relieving"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000837 "relief cooperation")
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0000837 "\"...South American cichlid Laetacara araguaiae... After spawning, male and female alternate between rearing eggs and defending nest in the territory.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000837 "\"...fishes... relieving each other when guarding the young.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000837 "\"In general, the mates alternately lay and fertilize and when relieving each other they usually display and give a formalized tail beat.\"")
SubClassOf(obo:ACTAN_0000837 obo:ACTAN_0000463)
SubClassOf(obo:ACTAN_0000837 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000898))

# Class: obo:ACTAN_0000838 (intention initiator)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000838 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000838 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000838 "2025-09-15T10:07:36.588495Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.2307/4083155") Annotation(skos:scopeNote "\"Animals sometimes start to perform a movement but do not complete it. Heinroth termed these intention movements because they indicate to the observer what the animal is going to do.\"") oboInOwl:hasDefinition obo:ACTAN_0000838 "Initiator in which an animal starts to perform a movement but does not complete it.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...reversal of the impulse...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000838 "impulse reversal")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000838 "incipient")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasRelatedSynonym obo:ACTAN_0000838 "intention movement"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000838 "preparatory")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000838 "intention initiator")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000838 "\"Another may be seen in Amiatus which at times will start a series of waves in the dorsal at its anterior end preparatory to moving forward, but before the inertia is overcome, some negative impulse causes the initiation of a similar series from the posterior end, effectively checking the reaction of the first; these opposing series meet at about half way between, and then die out.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.11369/jji1950.34.76") skos:example obo:ACTAN_0000838 "\"We suggest that the agitated milling behavior just prior to the spawning rush excited the potential predator and the rapid upward dash that followed elicited an attack response. Close observations of the piscivores Synodus ulae and Sebasticus marmoratus disclosed that during the bobbing stage, these predators remained motionless, but while the labrids were milling, \"nervous\" twitches of the caudal fins of the predators were common. Also during milling, S. marmoratus often moved slightly forward, and S. ulae frequently \"danced\" in its pelvic fins. At the first moment of the upward rush, these predators dashed forward toward the spawning aggregations from distances varying from 60cm to 3m.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000838 "\"They indicate the inclination of the animal to perform a definite activity.\"")
SubClassOf(obo:ACTAN_0000838 obo:ACTAN_0000698)
SubClassOf(obo:ACTAN_0000838 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001558))

# Class: obo:ACTAN_0000839 (awakening initiator)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000839 <https://github.com/Active-Animals/Ontology/patterns/historical_disposition>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000839 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000839 "2025-09-15T10:07:55.482515Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"These are incomplete movements, often released by inadequate stimuli situations, which will gradually become complete when the secretion of the influencing hormones has reached a higher level.\"") oboInOwl:hasDefinition obo:ACTAN_0000839 "Intention initiator in which incomplete movements only gradually become complete.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000839 "awakening"@en)
AnnotationAssertion(rdfs:comment obo:ACTAN_0000839 "HISTORICAL TERM

This term is part of a historical ethological perspective which is no longer mainstream.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000839 "awakening initiator")
AnnotationAssertion(Annotation(dc:contributor "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000839 "\"...the incomplete nesting movements in gulls in early spring as the awakening of reproductive behaviour...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000839 "\"We wonder if the distinction between awakening movements and incipient movements is quite sharp.\"")
SubClassOf(obo:ACTAN_0000839 obo:ACTAN_0000838)

# Class: obo:ACTAN_0000840 (demonstration exposure)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000840 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000840 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000840 "2025-09-15T10:16:05.615983Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"So we will call a demonstration movement a movement that serves a conspicuous structure and that is not in the same form shown in any other part of the behaviour of the animal in question or of related species.\"") oboInOwl:hasDefinition obo:ACTAN_0000840 "Exposure that serves a conspicuous structure.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000840 "demonstration movement"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000840 "demonstration exposure"@en)
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") skos:example obo:ACTAN_0000840 "\"A discussion of displays as indicators of quality would be incomplete without comment on the hypothesis that handicaps might evolve as concrete demonstrations to females of the superiority of individual males, the idea being that males able to survive in spite of some burdensome visible character can thereby both prove and signal their superiority over males with lesser handicaps.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000840 "\"Thalassoma cupido...
...a distinctive manner of swimming whereby the pectoral fins are fluttered rapidly, conspicuously displaying their blackened tips.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000840 "\"...we think we have to understand a coordination of muscle contractions that did not exist before. It seems rather unlikely that such a coordination has developed without making use of existing patterns and structures, and that will make it very difficult to decide whether it is really new or not.\"")
SubClassOf(obo:ACTAN_0000840 obo:ACTAN_0000423)
SubClassOf(obo:ACTAN_0000840 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002305))

# Class: obo:ACTAN_0000841 (flap-and-turn routine)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000841 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000841 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000841 "2025-09-16T11:51:46.116147Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"The pectoral is laid against the body and, while flapping, turned around. This movement might serve to clean the corresponding area of the flank.\"") oboInOwl:hasDefinition obo:ACTAN_0000841 "Wash routine in which an appendage is laid against the body and, while flapping, turned around.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000841 "flapping and turning"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000841 "flap-and-turn routine"@en)
SubClassOf(obo:ACTAN_0000841 obo:ACTAN_0000815)
SubClassOf(Annotation(rdfs:comment "In due course, this might be better given the part of 'brushing' (akin to brushing crumbs off ones chest with the fingers) when a relevant term is encountered in the literature and created.") obo:ACTAN_0000841 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000784))
SubClassOf(obo:ACTAN_0000841 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000026))

# Class: obo:ACTAN_0000842 (tail-flip gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000842 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000842 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000842 "2025-09-16T15:00:28.269452Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1126/science.288.5463.100") Annotation(skos:scopeNote "\"40% of the body mass of a shrimp is devoted to the large, tasty abdominal muscles that produce a powerful tail flick during rare, but critical, escape behaviors.\"") oboInOwl:hasDefinition obo:ACTAN_0000842 "Swimming-gait in which abdominal muscles produce a powerful tail flick during rare, but critical, escape behaviors.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1002/jnr.24550") oboInOwl:hasExactSynonym obo:ACTAN_0000842 "tail-flipping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000842 "tail-flip gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1002/jnr.24550") skos:example obo:ACTAN_0000842 "\"In crayfish.... Fighting usually stops when one individual retreats (using a tail flip) or crawls away from the opponent.\"")
SubClassOf(obo:ACTAN_0000842 obo:ACTAN_0000087)
SubClassOf(obo:ACTAN_0000842 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000003))
SubClassOf(obo:ACTAN_0000842 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000021))
SubClassOf(obo:ACTAN_0000842 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000052))
SubClassOf(obo:ACTAN_0000842 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000169))

# Class: obo:ACTAN_0000843 (forelimb abduction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000843 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000843 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000843 "2026-08-02T10:50:10.202007Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1002/ajpa.1330870108") Annotation(skos:scopeNote "\"Suspensory modes in which half or more of the body weight depended on a fully abducted forelimb were pooled under the label “arm-hanging (all modes).”\"") oboInOwl:hasDefinition obo:ACTAN_0000843 "Abduction that results from forelimb abducting.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000843 "abducted forelimb")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasNarrowSynonym obo:ACTAN_0000843 "humeral abduction")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasNarrowSynonym obo:ACTAN_0000843 "humerus-abducted")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000843 "forelimb abduction"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:scopeNote obo:ACTAN_0000843 "\"The ability of apes and atelines to completely abduct their forelimb during forelimb-suspension has musculoskeletal implications that require that this mode be distinguished from, e.g. quadrupedal grasp-walking or flexed-elbow vertical climbing.\"")
SubClassOf(obo:ACTAN_0000843 obo:ACTAN_0000639)
SubClassOf(obo:ACTAN_0000843 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002102))

# Class: obo:ACTAN_0000844 (fin flick)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000844 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000844 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000844 "2025-09-16T16:53:29.231386Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/s10682-007-9183-7") Annotation(skos:scopeNote "\"Courtship displays of R. decemdigitatus consisted of 11 steps: ... (iv) flicking of the first dorsal fin...\"") oboInOwl:hasDefinition obo:ACTAN_0000844 "Flick which involves a fin.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000844 "fin flickering")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000844 "flickering the fins"@en)
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10682-007-9183-7") oboInOwl:hasNarrowSynonym obo:ACTAN_0000844 "flicking of the first dorsal fin")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000844 "fin flick")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000844 obo:ACTAN_0000708)
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000844 "\"Badis badis...
Comfort movements recorded include fin flickering and rubbing, chafing, flexing the body, coughing, and yawning.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000844 "\"Flickering the pelvics. With rather great frequency, the pelvics are repeatedly erected a little and brought back again.\"")
SubClassOf(obo:ACTAN_0000844 obo:ACTAN_0000678)

# Class: obo:ACTAN_0000845 (squeeze grip)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000845 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000845 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000845 "2025-09-17T10:11:35.624158Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") oboInOwl:hasDefinition obo:ACTAN_0000845 "Power grip which causes strain.

This may lead to deformation, breaking, or expelling.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000845 "squeeze")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000845 "squeezing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000845 "squeeze grip")
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pone.0083116") skos:example obo:ACTAN_0000845 "\"...the Southeast Asian olive frog, Rana adenopleura...

Males regularly squeezed females using their hind legs once females began releasing eggs... The release of eggs often appeared to be concurrent with squeezing by the male.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.009050") skos:scopeNote obo:ACTAN_0000845 "\"...an animal will always be able to squeeze a cylinder harder with gripping arcs of >180° than those <180°, assuming it has the physiological capacity to do so.\"")
SubClassOf(obo:ACTAN_0000845 obo:ACTAN_0000683)
SubClassOf(obo:ACTAN_0000845 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001034))

# Class: obo:ACTAN_0000846 (eat subsistence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000846 "https://github.com/Active-Animals/Ontology/patterns/context_composite")
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000846 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000846 "2025-09-17T16:59:47.009091Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1177/10597123211040574") oboInOwl:hasDefinition obo:ACTAN_0000846 "Subsistence that consumes food.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000846 "eating"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000846 "feed")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000846 "eat subsistence")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000846 "NBO:0000134")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.239.4847.1525") skos:example obo:ACTAN_0000846 "\"In the class Aves cooperative hunting has been alleged for some bird-eating falcons, Harris' hawks (Parduteo unicinctus), and golden eagles (Aquila chysmtos).\"")
SubClassOf(obo:ACTAN_0000846 obo:ACTAN_0000360)
SubClassOf(obo:ACTAN_0000846 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000682))

# Class: obo:ACTAN_0000847 (mouth gaping)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000847 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000847 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000847 "2025-09-21T12:34:30.248641Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"Apomorphic characters were the derived mouth-gaping behavior of A. piscivorous and the specialized tail coil and ventral tail exposure of C. pricei.\"") oboInOwl:hasDefinition obo:ACTAN_0000847 "Gaping that involves the mouth.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000847 "jaw distending")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000847 "mouth-gaping")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000847 "mouth-opening"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000847 "mouthing")
AnnotationAssertion(rdfs:label obo:ACTAN_0000847 "mouth gaping")
AnnotationAssertion(Annotation(dc:source "doi:10.11369/jji1950.34.76") skos:example obo:ACTAN_0000847 "\"Egg predators gathered daily over the spawning site, rushing to white clouds of gametes where they hovered, rapidly opening and closing their mouths... Species observed preying on gamete clouds included the pomacentrids Pomacentrus nagasakiensis, P. coelestis, Chromis flavomaculata, C. chrysura, Amphiprion clarkii, and Dascyllus trimaculatus; the anthiine Anthias squamipinnis; and the pomacanthids Centropyge interruptus and C. tibicen.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:example obo:ACTAN_0000847 "\"There are several valves in tadpoles that control one-way flow. The mouth opens as the buccal floor is depressed and closes just before the buccal floor is elevated.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000847 "NBO:0000007")
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:scopeNote obo:ACTAN_0000847 "\"In terms of the frequency, duration, and magnitude of mouth opening, intermittent suction feeding is intermediate between continuous ram feeding and suction feeding on individual prey.\"")
SubClassOf(obo:ACTAN_0000847 obo:ACTAN_0000122)
SubClassOf(obo:ACTAN_0000847 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000165))

# Class: obo:ACTAN_0000848 (mumbling gaping)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000848 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000848 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000848 "2025-09-21T15:19:50.940225Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"Mumbling. The fish makes repeated biting movements with the mouth half-opened.\"") oboInOwl:hasDefinition obo:ACTAN_0000848 "Mouthing which involves repeated biting movements with the mouth half-opened.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000848 "mumbling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000848 "mumbling gaping"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000848 "\"Tilapia...

It is likely that most of the eggs are fertilized when already in the mouth of the female: she makes mumbling movements by which the eggs will become thoroughly mixed with the sperm.\"")
SubClassOf(obo:ACTAN_0000848 obo:ACTAN_0000847)
SubClassOf(obo:ACTAN_0000848 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000609))

# Class: obo:ACTAN_0000849 (dislodge hunt)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000849 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000849 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000849 "2026-09-15T20:00:48.391515Z")
AnnotationAssertion(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") Annotation(skos:scopeNote "\"They can be and are used as an excavating device or for harassing and dislodging prey from holes and crevices in hard substrates.\"") oboInOwl:hasDefinition obo:ACTAN_0000849 "Hunt which harasses prey to exit from holes and crevices in hard substrates.")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") oboInOwl:hasExactSynonym obo:ACTAN_0000849 "dislodging prey")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000849 "dislodge hunt"@en)
AnnotationAssertion(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") skos:example obo:ACTAN_0000849 "\"In Hawaii Parupeneus cyclostomus... pokes its barbels into holes and crevices in hard substrates to dislodge small animals.\"")
SubClassOf(obo:ACTAN_0000849 obo:ACTAN_0000358)
SubClassOf(obo:ACTAN_0000849 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000394))

# Class: obo:ACTAN_0000850 (searching look)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000850 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000850 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000850 "2025-09-21T20:06:54.152063Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"Then they try to find it with their eyes, which sense organs also undoubtedly help in the actual catching of the prey.\"") oboInOwl:hasDefinition obo:ACTAN_0000850 "Look which tries to find something with the eyes.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000850 "visual search"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000850 "inspecting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000850 "searching look")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/41.2.137") skos:scopeNote obo:ACTAN_0000850 "\"In many visual search tasks, the time to locate an item increases with the number of kinds of items being searched for (targets), with the number of non-target items in the field, and with the similarity between non-target and target items.\"")
SubClassOf(obo:ACTAN_0000850 obo:ACTAN_0000318)
SubClassOf(obo:ACTAN_0000850 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000301))

# Class: obo:ACTAN_0000851 (flutter oscillation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000851 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000851 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000851 "2025-09-29T07:51:00.186318Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000851 "Oscillation that is rapid, with a moderate amplitude.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000851 "flutter")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000851 "fluttering"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000851 "flutter oscillation")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000851 "\"Astronotus ocellatus...
Suddenly, often when one of the fishes is standing with the tail before the head of the partner, it flutters the tail, thereby demonstrating the conspicuous eye-spot on the base of the tail fin.\"")
SubClassOf(obo:ACTAN_0000851 obo:ACTAN_0000421)
SubClassOf(obo:ACTAN_0000851 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000380))
SubClassOf(obo:ACTAN_0000851 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0055002))

# Class: obo:ACTAN_0000852 (gamete-release mating)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000852 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000852 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000852 "2025-09-29T10:22:33.413212Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/S0169-5347(99)01744-9") oboInOwl:hasDefinition obo:ACTAN_0000852 "Mating which frees gametes into new surroundings.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") oboInOwl:hasExactSynonym obo:ACTAN_0000852 "gamete release"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(rdfs:comment "Pending a more recent source which synonymises this term more narrowly with copulating or even intromission, bear in mind that this was a very early ethological use of a term that changed later.") oboInOwl:hasRelatedSynonym obo:ACTAN_0000852 "coition")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000852 "gamete-release mating"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pone.0083116") skos:scopeNote obo:ACTAN_0000852 "\"Typically, male frogs clasp females dorsally and position themselves so as to bring their cloacae in close proximity before coordinated gamete release, a mating posture known as “amplexus”.\"")
SubClassOf(obo:ACTAN_0000852 obo:ACTAN_0000471)
SubClassOf(obo:ACTAN_0000852 ObjectSomeValuesFrom(obo:RO_0000057 obo:CL_0000300))

# Class: obo:ACTAN_0000853 (ejaculation expulsion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000853 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000853 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000853 "2025-09-30T08:56:37.811207Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") oboInOwl:hasDefinition obo:ACTAN_0000853 "Expulsion that involves sperm from male genitalia.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000853 "ejaculating"@en)
AnnotationAssertion(Annotation(dc:date "1990"^^xsd:decimal) Annotation(dc:source "doi:10.1303/aez.25.383") oboInOwl:hasExactSynonym obo:ACTAN_0000853 "ejaculation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000853 "ejaculation expulsion")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000853 "\"...the genus Pan, namely chimpanzees and bonobos...

Ejection of seminal fluid from penis. Males begin to ejaculate at 9 years old at Mahale. Semen is often eaten by both sexes.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1023/A:1011074716758") skos:example obo:ACTAN_0000853 "\"Thus they invest heavily in sperm production and ejaculate large volumes to increase their chances of insemination. This pattern has been found in Salmo salar...\"")
SubClassOf(obo:ACTAN_0000853 obo:ACTAN_0000715)
SubClassOf(obo:ACTAN_0000853 ObjectSomeValuesFrom(obo:RO_0000057 obo:CL_0000019))

# Class: obo:ACTAN_0000854 (aeration incubation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000854 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000854 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000854 "2025-09-30T10:49:34.854918Z")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icq077") oboInOwl:hasBroadSynonym obo:ACTAN_0000854 "pump oxygen-rich water")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/brv.12317") Annotation(skos:scopeNote "\"For aquatic ectotherms, including fish such as three-spined sticklebacks (Gasterosteus aculeatus), the selection of a nest site typically reflects a trade-off between taking advantage of water flows to ventilate eggs with oxygenated water, which reduces the energetic demands of behavioural ventilation, and the risk of washout from water currents.\"") oboInOwl:hasDefinition obo:ACTAN_0000854 "Incubation that behaviourally ventilates with oxygenated water.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000854 "aeration"@en)
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") oboInOwl:hasExactSynonym obo:ACTAN_0000854 "fanning")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000854 "refresh"@en)
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.5343/bms.2014.1055") oboInOwl:hasRelatedSynonym obo:ACTAN_0000854 "stirring")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000854 "aeration incubation"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000854 obo:ACTAN_0000676)
AnnotationAssertion(Annotation(dc:source "doi:10.5343/bms.2014.1055") skos:example obo:ACTAN_0000854 "\"After mating, T. albomaculosus females left the nest site, whereas males stayed there to care for the eggs. Males flapped their  fins, and they often sucked the sand into their mouths and spat it out on the bottom of the nest. Thus, males cared for the eggs by stirring the sand and accompanying attached eggs.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000854 "\"The eggs and the larvae, as long as they are not able to swim, are aerated by one of the parents. The fish floats over them, constantly moving the fins, thus causing a powerful water current.\"")
SubClassOf(obo:ACTAN_0000854 obo:ACTAN_0000474)
SubClassOf(obo:ACTAN_0000854 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000396))

# Class: obo:ACTAN_0000855 (ostraciiform-BCF gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000855 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000855 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000855 "2025-09-30T12:53:40.222101Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icab021") Annotation(skos:scopeNote "\"At its extreme, the oscillatory motions are confined to a caudal fin that swivels at its base without exhibiting wave formation.\"") oboInOwl:hasDefinition obo:ACTAN_0000855 "Oscillating gait that swivels at  the caudal fin base without exhibiting wave formation.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icab021") oboInOwl:hasExactSynonym obo:ACTAN_0000855 "caudal fin swivel")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasExactSynonym obo:ACTAN_0000855 "caudal sculling")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(rdfs:comment "BCF mode") oboInOwl:hasExactSynonym obo:ACTAN_0000855 "ostraciiform")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasExactSynonym obo:ACTAN_0000855 "tail sculling")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000855 "tail beat"@en)
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00227-014-2403-0") oboInOwl:hasRelatedSynonym obo:ACTAN_0000855 "thunniform")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000855 "ostraciiform-BCF gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.204.8.1459") skos:example obo:ACTAN_0000855 "\"Some captured sequences of very high speed swimming indicated that the boxfish... bent the peduncular region to a maximal lateral orientation and then executed a single hard beat that had the effect of accelerating the fish forward with considerable force.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000855 "\"...if the transverse movements of the tail were symmetrical to the direction of movement:... the tail would exert equal pressure forwards and backwards. On the contrary, the transverse movement is symmetrical to the position of the head only, and as the head makes big sideways movements it is still possible that the greater part of the transverse strokes pushes the water backwards.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.204.8.1459") Annotation(rdfs:comment "Boxfishes are the only fishes which can undertake fully oscillatory BCF mode swimming. The 'Ostaciiform' gait term is now preferably applied to asynchronous use of median and pectoral fins. Since both modes are unique to Ostraciiformes, perhaps it would be better to call them 'Ostraciiform BCF' and 'Ostraciiform MPF' gaits?") skos:scopeNote obo:ACTAN_0000855 "\"Interestingly, boxfishes have been the benchmark for classical descriptions of ‘ostraciiform’ locomotion as a BCF mode with minimal body curvature in which a sculling caudal fin is the primary propulsor. Preliminary observations, both in the laboratory and in the field, suggested that boxfishes normally do not swim in this classical mode: they use their median and paired fins as the major propulsors for most of their speed range. Thus, boxfishes should be considered as MPF, not BCF, swimmers.\"")
SubClassOf(obo:ACTAN_0000855 obo:ACTAN_0000020)
SubClassOf(obo:ACTAN_0000855 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000026))
SubClassOf(obo:ACTAN_0000855 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_4000164))

# Class: obo:ACTAN_0000856 (tail flutter)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000856 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000856 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000856 "2025-09-30T13:43:13.344336Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"With great frequency the tail is lifted and brought back again.\"") oboInOwl:hasDefinition obo:ACTAN_0000856 "Flutter which involves the tail.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000856 "tail fluttering"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000856 "tail flutter")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000856 "\"In Hemichromis we many times observed a vertical fluttering of the tail during egg laying...
Once we saw it carried out by a displaying Hemichromis...\"")
SubClassOf(obo:ACTAN_0000856 obo:ACTAN_0000851)
SubClassOf(obo:ACTAN_0000856 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002415))

# Class: obo:ACTAN_0000857 (mouth-fight antagonism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000857 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000857 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000857 "2025-09-30T16:08:38.220482Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1590/S1679-62252011005000018") Annotation(skos:scopeNote "\"Mouth fighting: two fish approach each other with mouth opened and touch or bite their jaws. This behavior stops immediately after mouth contact, but in some cases it can lasts about a minute.\"") oboInOwl:hasDefinition obo:ACTAN_0000857 "Antagonism in which two fish approach each other and make mouth contact.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000857 "mouth-fighting"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000857 "mouth-fight antagonism"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000857 "\"Cichlids...

The fishes approach each other, displaying frontally... Both adversaries try to grip the jaws of the other one;

Having seized each other firmly, they push and pull, beating heavily with the tails, the pectorals and often with the caudal flaps of the dorsalis and analis also.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1444-2906.2003.00797.x") skos:example obo:ACTAN_0000857 "\"P. major sometimes bit each other’s mouth.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1444-2906.2003.00797.x") skos:example obo:ACTAN_0000857 "\"The two fish open their mouth widely and press them against each other, acccompanied by up-and-down movements from just above the sea bottom to 10 cm above it. This behavior was observed only in E. japonica.\"")
SubClassOf(obo:ACTAN_0000857 obo:ACTAN_0000385)
SubClassOf(obo:ACTAN_0000857 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000554))
SubClassOf(obo:ACTAN_0000857 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000165))

# Class: obo:ACTAN_0000858 (butting attack)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000858 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000858 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000858 "2025-09-30T16:46:56.688367Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000858 "Attack which involves rapid movement towards an adversary and ramming it using part of the head.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasExactSynonym obo:ACTAN_0000858 "head butting")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") oboInOwl:hasRelatedSynonym obo:ACTAN_0000858 "lateral attack")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") rdfs:label obo:ACTAN_0000858 "butting attack"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0000858 "\"...South American cichlid Laetacara araguaiae...

...a fish approaches and beats with its mouth opened on the opponent’s body.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000858 "\"A subordinate male stationed over the nest’s rear slope usually did not provoke the resident male N. micropogon, but any movement of a subordinate towards the trough or onto the upstream slope elicited head butting and chasing.\"")
SubClassOf(obo:ACTAN_0000858 obo:ACTAN_0000386)
SubClassOf(obo:ACTAN_0000858 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000861))
SubClassOf(obo:ACTAN_0000858 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000033))

# Class: obo:ACTAN_0000859 (mouth-strike resistance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000859 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000859 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000859 "2025-10-01T06:51:22.285326Z")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasBroadSynonym obo:ACTAN_0000859 "strike")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasDefinition obo:ACTAN_0000859 "Resistance that involves lunging toward a target, at speed, while mouth opening.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000859 "open-mouth strike"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000859 "mouth-strike resistance"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000859 obo:ACTAN_0000123)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000859 obo:ACTAN_0000512)
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000859 "\"Smaller snakes, regardless of species, have no choice when confronted by a predator but to strike with less efficient venom delivery systems and engage the predator more actively, not being able to coil up into a defensive posture and withstand a brief attack.\"")
SubClassOf(obo:ACTAN_0000859 obo:ACTAN_0000372)
SubClassOf(obo:ACTAN_0000859 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000847))

# Class: obo:ACTAN_0000860 (hit kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000860 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000860 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000860 "2025-10-01T06:51:52.527002Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasDefinition obo:ACTAN_0000860 "Kinetics which produces an impact.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000860 "hit")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasExactSynonym obo:ACTAN_0000860 "hitting")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10682-007-9183-7") oboInOwl:hasRelatedSynonym obo:ACTAN_0000860 "into")
AnnotationAssertion(Annotation(dc:date "1976"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/4084834") oboInOwl:hasRelatedSynonym obo:ACTAN_0000860 "strike")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasRelatedSynonym obo:ACTAN_0000860 "striking"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000860 "hit kinetics")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10682-007-9183-7") skos:example obo:ACTAN_0000860 "\"Courtship displays of R. decemdigitatus consisted of 11 steps: ... (ix) biting of the female and swimming into her...\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000860 "\"Many nests have their centres less than 2 X 30cm. from their nearest neighbour's, yet only once in many hundreds of observations has one sitting A. ibis been observed to strike another.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") skos:scopeNote obo:ACTAN_0000860 "\"After pole vaulting, the dog pushes upward and forward simultaneously off this second front foot; both E, and Ekf increase, and the center of mass returns to its original height. An aerial phase usually takes place after this push-off until the first rear foot strikes the ground again and the cycle repeats itself.\"")
SubClassOf(obo:ACTAN_0000860 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000860 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001034))

# Class: obo:ACTAN_0000861 (ram hit)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000861 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000861 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000861 "2025-10-01T13:45:54.310684Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000861 "Hit which is destabilising and involves the whole body's weight.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") oboInOwl:hasExactSynonym obo:ACTAN_0000861 "colliding")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000861 "ramming"@en)
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") oboInOwl:hasRelatedSynonym obo:ACTAN_0000861 "beating")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000861 "push")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000861 "ram hit")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000861 "\"Aequidens latifrons...
The male often butts the female and she tries to evade these pushes.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000861 "\"In Aequidens and Cichlasoma species the contact with the rammed fish is made with a sudden, more or less formalised pushing out of the lower jaw...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.11369/jji1950.34.76") skos:example obo:ACTAN_0000861 "\"Thalassoma cupido...
In fact, on one occasion, an upward dashing labrid aggregation collided into the abdomen of a waiting Pomacentrus nagasakiensis.\"")
SubClassOf(obo:ACTAN_0000861 obo:ACTAN_0000860)
SubClassOf(obo:ACTAN_0000861 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002245))

# Class: obo:ACTAN_0000862 (forelimb adduction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000862 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000862 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000862 "2026-08-02T10:50:23.049963Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000862 "Adduction that results from forelimb adducting.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000862 "adducted forelimb")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasNarrowSynonym obo:ACTAN_0000862 "arm adducted")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasNarrowSynonym obo:ACTAN_0000862 "humerus adducted")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000862 "forelimb adduction"@en)
