# Class: obo:ACTAN_0000936 (appendage retracting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000936 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000936 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000936 "2026-08-02T14:22:18.48167Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasDefinition obo:ACTAN_0000936 "Retracting that involves an appendage.")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") Annotation(skos:scopeNote "\"...chelae are often not lifted completely free from the substrate during retraction;\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000936 "cheliped retraction")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") Annotation(rdfs:comment "\"...left legs are extended and the right retracted.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000936 "leg retracting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000936 "appendage retracting"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000936 "\"C. compressus... The chelae are often not lifted completely free from the substrate during retraction; consequently, they will leave a gouged-out groove in the centre of the crab track as they are dragged along the sand.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3190/ac482d") skos:scopeNote obo:ACTAN_0000936 "\"...the gait patterns of many-legged organisms are characterised by stride period (one complete cycle of protraction and retraction of a leg), duty factor, (the ratio of the retracting period over a cycle), step length, (the moving distance during a retraction of a leg), stride length, (the moving distance during a cycle of a leg movement, i.e. stride length = step length / duty factor) and wavenumber (the mean phase difference between successive ipsilateral legs).\"")
SubClassOf(obo:ACTAN_0000936 obo:ACTAN_0000736)
SubClassOf(obo:ACTAN_0000936 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000026))

