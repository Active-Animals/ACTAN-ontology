SubClassOf(obo:ACTAN_0000068 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ENVO_01000267))

# Class: obo:ACTAN_0000069 (MPF mode)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000069 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000069 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000069 "2026-01-20T07:30:17.324692Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasDefinition obo:ACTAN_0000069 "Natatorial mode that uses a combination of lateral, dorsal, and ventral fins for thrust.

MPF propulsion couples fin rays and can offer greater maneuverability than BCF propulsion.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000069 "MPF propulsion"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000069 "median and/or paired fin")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000069 "MPF mode"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:scopeNote obo:ACTAN_0000069 "\"...many fish typically utilize MPF modes for foraging, as these offer greater maneuverability...\"")
SubClassOf(obo:ACTAN_0000069 obo:ACTAN_0000019)
SubClassOf(obo:ACTAN_0000069 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0002534))
SubClassOf(obo:ACTAN_0000069 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0003097))

# Class: obo:ACTAN_0000070 (LSDC-walk gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000070 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000070 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000070 "2026-01-21T11:49:30.91696Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasDefinition obo:ACTAN_0000070 "Walk gait that is lateral-sequence, diagonal-couplet, and vaulting.

The animal spends most of its time supported on diagonal pairs of limbs.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000070 "LSDC walk")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000070 "lateral sequence diagonal couplet walk")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000070 "LSDC-walk gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") skos:scopeNote obo:ACTAN_0000070 "\"This is the most common pattern for slow moving mammals.\"")
SubClassOf(obo:ACTAN_0000070 obo:ACTAN_0000134)
SubClassOf(obo:ACTAN_0000070 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000211))
SubClassOf(obo:ACTAN_0000070 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000736))
