SubClassOf(obo:ACTAN_0000572 obo:ACTAN_0000857)
SubClassOf(obo:ACTAN_0000572 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000569))

# Class: obo:ACTAN_0000573 (float regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000573 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000573 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000573 "2025-02-06T10:53:04.908328Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000573 "Swimming-regime that buoyantly maintains some tilt at the water surface.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000573 "floating"@en)
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.198.1.79") oboInOwl:hasExactSynonym obo:ACTAN_0000573 "hanging")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000573 "float regime")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000573 obo:ACTAN_0000403)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.198.1.79") skos:scopeNote obo:ACTAN_0000573 "\"...intertidal benthic gobies performed ASR in shallow water... hanging vertically from the water surface at positive buoyancy...\"")
SubClassOf(obo:ACTAN_0000573 obo:ACTAN_0000088)
SubClassOf(obo:ACTAN_0000573 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000311))
