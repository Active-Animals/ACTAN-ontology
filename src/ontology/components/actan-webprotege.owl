AnnotationAssertion(oboInOwl:creation_date obo:ENVO_01001479 "2018-10-04T13:59:22Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasDefinition obo:ENVO_01001479 "Definition: A part of an astronomical body which is primarily composed of fluid.")
AnnotationAssertion(rdfs:label obo:ENVO_01001479 "fluid astronomical body part"@en)
SubClassOf(obo:ENVO_01001479 obo:ENVO_01000813)

# Class: obo:ENVO_01001607 (water current)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01001607 "A hydroform which is maintained by a continuous, directed movement of water, generated by disequilibria in a water mass.")
AnnotationAssertion(dc:creator obo:ENVO_01001607 <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(oboInOwl:creation_date obo:ENVO_01001607 "2019-03-19T16:31:41Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment obo:ENVO_01001607 "Depth contours, shoreline configurations and interaction with other currents influence a current's direction and strength.")
AnnotationAssertion(rdfs:label obo:ENVO_01001607 "water current"@en)
SubClassOf(obo:ENVO_01001607 obo:ENVO_01001308)

# Class: obo:ENVO_01001673 (fluid surface layer)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01001673 "A surface layer which is composed primarily of some liquid or gas."@en)
AnnotationAssertion(dc:creator obo:ENVO_01001673 <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(dc:date obo:ENVO_01001673 "2019-08-20T08:28:42Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:ENVO_01001673 "fluid surface layer"@en)
SubClassOf(obo:ENVO_01001673 obo:ENVO_00010504)

