SubClassOf(obo:ACTAN_0000234 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000893))
SubClassOf(obo:ACTAN_0000234 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002103))

# Class: obo:ACTAN_0000235 (rectilinear gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000235 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000235 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000235 "2024-10-03T19:22:22.680103Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasDefinition obo:ACTAN_0000235 "Creeping gait that uses a cutaneous wave pattern.

Although the body need not be straight during this mode, snakes using rectilinear locomotion are able to move while the body is perfectly straight.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasExactSynonym obo:ACTAN_0000235 "rectilinear mode"@en)
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasRelatedSynonym obo:ACTAN_0000235 "crawl")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000235 "rectilinear gait")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000235 "\"...backward crawl found in rattlesnakes.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1073/pnas.2122563119") skos:example obo:ACTAN_0000235 "\"...snakes... send traveling waves during rectilinear motion. For example, Dumeril’s boa travels at a body speed of 0.2 to 6 cm/s with a wave speed of 25 cm/s.\"")
SubClassOf(obo:ACTAN_0000235 obo:ACTAN_0000225)
SubClassOf(obo:ACTAN_0000235 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000469))
SubClassOf(obo:ACTAN_0000235 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000735))
SubClassOf(obo:ACTAN_0000235 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000052))
SubClassOf(obo:ACTAN_0000235 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000521))

# Class: obo:ACTAN_0000236 (ride regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000236 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000236 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000236 "2024-10-03T19:22:42.979342Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"L17. Ride: Similar to tree sway, but used from tree to ground. A vertical, small diameter support is grasped in a clinging posture and a (sometimes violent) movement or oscillation overbalances the support (typically a small tree). The weight of the individual's body pulls the tree from a vertical orientation toward horizontal. As the tree approaches horizontal a suspensory posture may result, after or during which the grip with the hindlimb is released and the feet contact the ground.\"") oboInOwl:hasDefinition obo:ACTAN_0000236 "Traversing-regime in which a support is grasped and a movement overbalances the support from a vertical orientation toward horizontal, the grip is released, and the feet contact the ground.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000236 "ride")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000236 "riding"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000236 "ride regime")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") rdfs:seeAlso obo:ACTAN_0000236 obo:ACTAN_0000237)
SubClassOf(obo:ACTAN_0000236 obo:ACTAN_0000089)
SubClassOf(obo:ACTAN_0000236 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000311))
SubClassOf(obo:ACTAN_0000236 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))
SubClassOf(obo:ACTAN_0000236 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000530))
SubClassOf(obo:ACTAN_0000236 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000893))

# Class: obo:ACTAN_0000237 (sway regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000237 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000237 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000237 "2024-10-03T19:22:59.290562Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000237 "Traversing-regime that is a gap crossing movement between trees using body weight to oscillate flexible stems.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000237 "swaying"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000237 "sway regime")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") rdfs:seeAlso obo:ACTAN_0000237 obo:ACTAN_0000236)
SubClassOf(obo:ACTAN_0000237 obo:ACTAN_0000089)
SubClassOf(obo:ACTAN_0000237 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000693))
SubClassOf(obo:ACTAN_0000237 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))
SubClassOf(obo:ACTAN_0000237 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000530))
SubClassOf(obo:ACTAN_0000237 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000893))

# Class: obo:ACTAN_0000238 (drop regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000238 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000238 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000238 "2024-10-03T19:23:24.270589Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000238 "Traversing-regime in which falling is initiated by releasing a support.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000238 "drop")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000238 "dropping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000238 "drop regime")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000238 obo:ACTAN_0000193)
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:example obo:ACTAN_0000238 "\"For example, in the small tortoiseshell butterfly, Aglais urticae, males persistently court females, repeatedly tapping with their antennae until the female drops down into the vegetation, followed by the male who may then achieve a mating.\"")
SubClassOf(obo:ACTAN_0000238 obo:ACTAN_0000089)
SubClassOf(obo:ACTAN_0000238 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000192))
SubClassOf(obo:ACTAN_0000238 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000187))
