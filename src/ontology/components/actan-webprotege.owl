AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasBroadSynonym obo:ACTAN_0000411 "associating")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000411 "Participation in which an animal approaches and continually interacts with others.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000411 "aggregating")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000411 "aggregation")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000411 "assembling")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000411 "congregating")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000411 "converging")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") oboInOwl:hasExactSynonym obo:ACTAN_0000411 "crowding")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2022.1066186") oboInOwl:hasExactSynonym obo:ACTAN_0000411 "grouping"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000411 "packing")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000411 "herding")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "doi:10.1126/science.1125142") oboInOwl:hasRelatedSynonym obo:ACTAN_0000411 "gregarious")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasRelatedSynonym obo:ACTAN_0000411 "kin preference")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasRelatedSynonym obo:ACTAN_0000411 "social preference")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000411 "aggregation participation")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000411 obo:ACTAN_0000551)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000411 "NBO:0040000")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:scopeNote obo:ACTAN_0000411 "\"Aggregation behavior: Seeking of conspecifics based on chemical, visual or other cues; exploratory approach that then leads to shoaling, schooling, and/or sexual aggregating behavior, where applicable.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2022.1066186") skos:scopeNote obo:ACTAN_0000411 "\"Social grouping and social behavior are often constrained by environmental factors, including predation pressure and physical habitat structure.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:scopeNote obo:ACTAN_0000411 "\"The congregating of juveniles is a weakly developed type of aggregating.\"")
SubClassOf(obo:ACTAN_0000411 obo:ACTAN_0000409)
