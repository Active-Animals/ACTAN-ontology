# Class: obo:ACTAN_0000100 (wriggling bending)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000100 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000100 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000100 "2024-09-17T09:46:21.988603Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000100 "Bending which is of large amplitude, and repeated to and fro with a relatively low frequency.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000100 "wriggling"@en)
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icab021") oboInOwl:hasExactSynonym obo:ACTAN_0000100 "wriggling movement"@en)
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1580/1080-6032(1996)007[0038:USCS]2.3.CO;2") oboInOwl:hasExactSynonym obo:ACTAN_0000100 "writhing")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00265-014-1841-5") oboInOwl:hasRelatedSynonym obo:ACTAN_0000100 "squirming")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000100 "wriggling bending"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000100 "NBO:0000082")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000100 "\"Aequidens latifrons...
When it has come down the larva lies on its back, under the yolk mass... The tail is constantly beating to and fro with a frequency of 3-5 beats a second (wriggling).\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000100 "\"Compared with the majority of natricine species, T. marcianus and R. grahami exhibited more coiled body postures, more tail rubbing, more tail coiling, more tail wriggling, positioned their tails more centered on their bodies, and had their heads hidden more and positioned more centered on their bodies.\"")
AnnotationAssertion(Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") skos:example obo:ACTAN_0000100 "\"Similarly, the slender lure from tissue inside the lower jaw of some of the stargazers (Uranoscopus) is enticingly wriggled like a worm from the mouth of an otherwise hidden stargazer.\"")
SubClassOf(obo:ACTAN_0000100 obo:ACTAN_0000737)
SubClassOf(obo:ACTAN_0000100 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000689))
SubClassOf(obo:ACTAN_0000100 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0055002))

