AnnotationAssertion(Annotation(oboInOwl:hasDbXref "OBOL:accepted") oboInOwl:hasExactSynonym obo:UBERON_0000020 "organ of sensory system")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "OBOL:automatic") oboInOwl:hasExactSynonym obo:UBERON_0000020 "sense organ system organ")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:UBERON_0000020 "sensory organ")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "OBOL:automatic") oboInOwl:hasExactSynonym obo:UBERON_0000020 "sensory organ system organ")
