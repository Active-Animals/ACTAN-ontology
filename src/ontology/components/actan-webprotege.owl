# Class: obo:ACTAN_0000205 (stott gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000205 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000205 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000205 "2024-09-30T07:15:30.352937Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.2307/1379571") Annotation(skos:scopeNote "\"If all footfalls occur at about the same instant, the gait is a bound of the kind termed the prank ( or stott). The pronk has one long  suspension that is transitional between gathered and extended.\"") oboInOwl:hasDefinition obo:ACTAN_0000205 "Stepping gait that is bouncing, asymmetric, quadrupedal, all footfalls occur at about the same instant, and there is one long suspension that is transitional between gathered and extended.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasExactSynonym obo:ACTAN_0000205 "pronk")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasExactSynonym obo:ACTAN_0000205 "stott"@en)
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") Annotation(dc:source "doi:10.2307/1379571") Annotation(rdfs:comment "Hildebrand stated, \"the gait is a bound,\" (doi:10.2307/1379571), but Struble and Gibb have differentiated between the two, noting that in a bound, \"footfalls of the fore and hindfoot pairs are not simultaneous,\" (doi:10.1093/icb/icac125).") oboInOwl:hasRelatedSynonym obo:ACTAN_0000205 "bound")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000205 "stott gait")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000205 "NBO:0070004")
AnnotationAssertion(Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") skos:scopeNote obo:ACTAN_0000205 "\"This gait is not functional to speed, but is used by the mentioned species as a fitness proof, to damp predators from catching them.\"")
SubClassOf(obo:ACTAN_0000205 obo:ACTAN_0000124)
SubClassOf(obo:ACTAN_0000205 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000091))
SubClassOf(obo:ACTAN_0000205 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000199))
SubClassOf(obo:ACTAN_0000205 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000056))
SubClassOf(obo:ACTAN_0000205 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000136))

# Class: obo:ACTAN_0000206 (crutch gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000206 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000206 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000206 "2024-09-30T07:16:28.758515Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasDefinition obo:ACTAN_0000206 "Stepping gait that is vaulting, asymmetric, and involving anterior transverse couplets.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000206 "crutch")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasRelatedSynonym obo:ACTAN_0000206 "crutching"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000206 "crutch gait")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000206 "\"Lophius piscatorius pushes the body along the bottom at times by kicking back with the ventrals.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") skos:example obo:ACTAN_0000206 "\"Mudskippers use slow-speed movements called 'crutching,' where the fish forms transverse couplets in which both fins in the pectoral gridle move in synchrony. Mudskippers can elevate the mid-body during the stance phase of crutching behavior, but the body returns to full contact with the substrate as both pectoral fins are lifted during the swing phase. Because of this, mudskippers undergo marked deceleration when the pectoral fin is in swing phase, which does not permit continuous motion between cycles.\"")
SubClassOf(obo:ACTAN_0000206 obo:ACTAN_0000124)
SubClassOf(obo:ACTAN_0000206 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000211))
SubClassOf(obo:ACTAN_0000206 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000736))
SubClassOf(obo:ACTAN_0000206 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000054))
SubClassOf(obo:ACTAN_0000206 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000136))

# Class: obo:ACTAN_0000207 (gallop gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000207 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000207 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000207 "2024-09-30T07:16:57.82809Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1098/rspb.1998.0424") Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasDefinition obo:ACTAN_0000207 "Skip gait that is asymmetric, quadrupedal, and combines a forelimb and hindlimb skip in each stride.

In each stride, a slow gallop has no suspension, a moderate gallop has a gathered suspension, and a fast gallop may have both a gathered and an extended suspension.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000207 "gallop"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000207 "gallop gait"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") skos:example obo:ACTAN_0000207 "Monty Python's Holy Grail contains a wonderful scene involving a horseless knight, with added coconut shells, unilaterally skipping one half of a triple beat gallop.")
SubClassOf(obo:ACTAN_0000207 obo:ACTAN_0000210)
SubClassOf(obo:ACTAN_0000207 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000199))
SubClassOf(obo:ACTAN_0000207 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000211))
SubClassOf(obo:ACTAN_0000207 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000710))
SubClassOf(obo:ACTAN_0000207 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000056))
SubClassOf(obo:ACTAN_0000207 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000136))

# Class: obo:ACTAN_0000208 (bound gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000208 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000208 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000208 "2024-09-30T07:17:19.834574Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icac125") Annotation(skos:scopeNote "\"Bound
A quadrupedal gait characterized by (1) synchronous IntraPAP, (2) the two hind footfalls are simultaneous (the timings of the hindfoot footfalls differ by no more than 10% of the entire gait cycle), (3) the two fore footfalls are simultaneous (the timings of the forefoot footfalls differ by no more than 10% of the entire gait cycle), and (4) but the timings of the footfalls of the fore and hindfoot pairs are not simultaneous.\"") oboInOwl:hasDefinition obo:ACTAN_0000208 "Stepping gait that is bouncing and suspended, with an asymmetric quadrupedal gait, in which the two hind footfalls are simultaneous, the two fore footfalls are simultaneous, and the timings of the footfalls of the fore and hindfoot pairs are not simultaneous.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasExactSynonym obo:ACTAN_0000208 "bound"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000208 "bound gait")
SubClassOf(obo:ACTAN_0000208 obo:ACTAN_0000124)
SubClassOf(obo:ACTAN_0000208 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000091))
SubClassOf(obo:ACTAN_0000208 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000199))
SubClassOf(obo:ACTAN_0000208 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000056))
SubClassOf(obo:ACTAN_0000208 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000136))

# Class: obo:ACTAN_0000209 (half-bound gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000209 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000209 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000209 "2024-09-30T07:17:55.916173Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icac125") Annotation(skos:scopeNote "\"Half-bound
A quadrupedal gait characterized by (1) synchronous IntraPAP, (2) simultaneous hindlimb footfalls(the timings of the hindfoot footfalls differ by no more than 10% of the entire gait cycle), and (3) an evident fore lead (the timings of the forefoot footfalls differ by more than 10% of the entire gait cycle).\"") oboInOwl:hasDefinition obo:ACTAN_0000209 "Stepping gait that is bouncing and suspended, with an asymmetric quadrupedal gait, with simultaneous hindlimb footfalls, and the timings of the forefoot footfalls differ by more than 10% of the entire gait cycle.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasExactSynonym obo:ACTAN_0000209 "half bound")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000209 "half-bounding")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasExactSynonym obo:ACTAN_0000209 "halfbound"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000209 "half-bound gait"@en)
SubClassOf(obo:ACTAN_0000209 obo:ACTAN_0000124)
SubClassOf(obo:ACTAN_0000209 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000091))
SubClassOf(obo:ACTAN_0000209 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000199))
SubClassOf(obo:ACTAN_0000209 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000056))
SubClassOf(obo:ACTAN_0000209 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000136))

# Class: obo:ACTAN_0000210 (skip gait)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000210 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000210 "2024-09-30T09:05:26.737584Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1098/rspb.1998.0424") Annotation(skos:scopeNote "\"As I will discuss, only a component of the energy recovery in S is based on the pendulum-like mechanism, the other being generated by elastic energy release (at a non-symmetrical phase of the stance with respect to the storage).\"") oboInOwl:hasDefinition obo:ACTAN_0000210 "Stepping gait in which a component of the energy recovery is based on the pendulum-like mechanism, the other being generated by elastic energy release.")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rspb.1998.0424") oboInOwl:hasExactSynonym obo:ACTAN_0000210 "skipping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000210 "skip gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rspb.1998.0424") skos:example obo:ACTAN_0000210 "\"Bipeds such as some birds (rook walk and hop), jerboas, and lemurs (Sifaka hop) for instance, use skipping.\"")
SubClassOf(obo:ACTAN_0000210 obo:ACTAN_0000124)

# Class: obo:ACTAN_0000211 (vaulting leverage)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000211 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000211 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000211 "2024-09-30T09:05:35.894266Z")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasBroadSynonym obo:ACTAN_0000211 "pendulum")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1126/science.288.5463.100") Annotation(skos:scopeNote "\"When animals walk, the body vaults up and over each stiff leg in an arc, analogous to an inverted pendulum (Fig. 1B). Kinetic energy in the first half of the stance phase is transformed into gravitational potential energy, which is partially recovered as the animal’s body falls forward and downward in the second half of the stance phase.\"") oboInOwl:hasDefinition obo:ACTAN_0000211 "Leverage that moves the body up and over each stiff leg in an arc, analogous to an inverted pendulum, transforming kinetic energy in the first half of the stance phase into gravitational potential energy, which is partially recovered as the animal’s body falls forward and downward in the second half of the stance phase.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000211 "inverted pendulum")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000211 "vaulting"@en)
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasRelatedSynonym obo:ACTAN_0000211 "pivoting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000211 "vaulting leverage"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1002/9781118501153.ch12") skos:example obo:ACTAN_0000211 "\"Metamorphosed flatfishes... When moving in contact with the bottom, locomotion is affected by antero-posterior movements of the dorsal and anal fin rays, which lever the fish over the substratum.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.130.1.155") skos:scopeNote obo:ACTAN_0000211 "\"Vaulting over stiffened legs results in up to a 70 % conservation in energy that would otherwise have to be provided by muscles and tendons.\"")
SubClassOf(obo:ACTAN_0000211 obo:ACTAN_0000693)
SubClassOf(obo:ACTAN_0000211 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000026))
SubClassOf(obo:ACTAN_0000211 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001023))

# Class: obo:ACTAN_0000212 (unilateral-skip gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000212 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000212 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000212 "2024-09-30T09:15:46.482074Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1098/rspb.1998.0424") oboInOwl:hasDefinition obo:ACTAN_0000212 "Skip gait that involves asymmetric bipedal skipping, and in which one foot is always forward, landing with the trailing foot just a fraction of a second before the leading foot, and pushing off with each foot as it hits.")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rspb.1998.0424") oboInOwl:hasExactSynonym obo:ACTAN_0000212 "unilateral skipping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000212 "unilateral-skip gait"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") skos:example obo:ACTAN_0000212 "Monty Python's Holy Grail contains a wonderful scene involving a horseless knight, with added coconut shells, unilaterally skipping one half of a triple beat (transverse) gallop.")
SubClassOf(obo:ACTAN_0000212 obo:ACTAN_0000210)
SubClassOf(obo:ACTAN_0000212 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000091))
SubClassOf(obo:ACTAN_0000212 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000199))
SubClassOf(obo:ACTAN_0000212 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000211))
SubClassOf(obo:ACTAN_0000212 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000054))
SubClassOf(obo:ACTAN_0000212 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000136))

# Class: obo:ACTAN_0000213 (bilateral-skip gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000213 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000213 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000213 "2024-09-30T09:15:58.347509Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1098/rspb.1998.0424") oboInOwl:hasDefinition obo:ACTAN_0000213 "Skip gait that involves symmetric bipedal skipping, and in which the forward foot alternates between strides, landing with the trailing foot just a fraction of a second before the leading foot, and pushing off with each foot as it hits.")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rspb.1998.0424") oboInOwl:hasExactSynonym obo:ACTAN_0000213 "bilateral skipping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000213 "bilateral-skip gait")
SubClassOf(obo:ACTAN_0000213 obo:ACTAN_0000210)
SubClassOf(obo:ACTAN_0000213 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000091))
SubClassOf(obo:ACTAN_0000213 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000199))
SubClassOf(obo:ACTAN_0000213 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000211))
SubClassOf(obo:ACTAN_0000213 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000054))
SubClassOf(obo:ACTAN_0000213 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000135))

# Class: obo:ACTAN_0000214 (transverse-gallop gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000214 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000214 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000214 "2024-09-30T09:16:10.237132Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1098/rspb.1998.0424") oboInOwl:hasDefinition obo:ACTAN_0000214 "Gallop gait that involves the same (both left or both right) unilateral skips with 50% of the stride period being out-of-phase.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasExactSynonym obo:ACTAN_0000214 "transverse gallop"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000214 "transverse-gallop gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.2307/1379571") skos:example obo:ACTAN_0000214 "\"The rotary sequence tends to be preferred to the transverse sequence by the fastest and most maneuverable cursors (Acinonyx, Antilope, and Gazella), and limited evidence indicates that some artiodactyls may tend to change from the transverse to the rotary gallop as speed increases.\"")
SubClassOf(obo:ACTAN_0000214 obo:ACTAN_0000207)
SubClassOf(obo:ACTAN_0000214 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002035))

# Class: obo:ACTAN_0000215 (rotary-gallop gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000215 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000215 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000215 "2024-09-30T09:16:18.35121Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1098/rspb.1998.0424") oboInOwl:hasDefinition obo:ACTAN_0000215 "Gallop gait that involves different (left and right) unilateral skips with 50% of the stride period being out-of-phase.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasExactSynonym obo:ACTAN_0000215 "rotary gallop"@en)
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000215 "rotary-gallop gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.2307/1379571") skos:example obo:ACTAN_0000215 "\"The rotary sequence tends to be preferred to the transverse sequence by the fastest and most maneuverable cursors (Acinonyx, Antilope, and Gazella), and limited evidence indicates that some artiodactyls may tend to change from the transverse to the rotary gallop as speed increases.\"")
SubClassOf(obo:ACTAN_0000215 obo:ACTAN_0000207)
SubClassOf(obo:ACTAN_0000215 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001193))

# Class: obo:ACTAN_0000216 (crutch-walk gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000216 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000216 "Ditch Townsend")
