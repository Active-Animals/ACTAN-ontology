# Class: obo:ACTAN_0000731 (retroflexure arch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000731 "https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality")
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000731 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000731 "2025-05-28T09:03:19.500382Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.198.1.79") oboInOwl:hasDefinition obo:ACTAN_0000731 "Arch that has an axial concavity, dorsally orientated, in the sagittal plane.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasExactSynonym obo:ACTAN_0000731 "retroflexed motion")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasExactSynonym obo:ACTAN_0000731 "retroflexing")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasExactSynonym obo:ACTAN_0000731 "retroflexure")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasExactSynonym obo:ACTAN_0000731 "upwards arched")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasExactSynonym obo:ACTAN_0000731 "vertically arched")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasRelatedSynonym obo:ACTAN_0000731 "extended")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000731 "retroflexure arch")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.198.1.79") skos:example obo:ACTAN_0000731 "\"...intertidal benthic gobies performed ASR in shallow water... in an arched position with the head tilted up, the snout emersed and the mouth at the water surface, with the body resting on the pelvic, anal and caudal fins...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000731 "\"A large female N. micropogon typically arched her anterior body about 30° from the substrate, whereas a small female arched 60-90°.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:example obo:ACTAN_0000731 "\"The horizontal fluke of the whale may be brought into play to further control forward pitch or even to extend the head and back.\"")
SubClassOf(obo:ACTAN_0000731 obo:ACTAN_0000809)
SubClassOf(obo:ACTAN_0000731 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002208))
SubClassOf(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") Annotation(skos:scopeNote "\"The female’s motion at the end of her run (i.e., frontal head pitch and sagittal twist) is termed “retroflexure”...\"") obo:ACTAN_0000731 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002495))

# Class: obo:ACTAN_0000732 (flexing movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000732 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000732 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000732 "2025-05-28T11:37:10.769695Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") oboInOwl:hasDefinition obo:ACTAN_0000732 "Movement that decreases the angle between two joined body parts.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000732 "flexing"@en)
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasRelatedSynonym obo:ACTAN_0000732 "bending")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000732 "collapsing")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000732 "folding")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasRelatedSynonym obo:ACTAN_0000732 "gathered")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000732 "lowering")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") oboInOwl:hasRelatedSynonym obo:ACTAN_0000732 "raising")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") oboInOwl:hasRelatedSynonym obo:ACTAN_0000732 "retracting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000732 "flexing movement")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000732 obo:ACTAN_0000120)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") Annotation(rdfs:comment "1996"^^xsd:decimal) skos:example obo:ACTAN_0000732 "\"Bipedal landing: Hindlimbs land first, flexing to absorb most or all of the energy of impact; used primarily after leaps with vertical cling take-offs.\"")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") skos:scopeNote obo:ACTAN_0000732 "In the case where an appendage is swung through a dorsal/ventral arc in a transverse plane (e.g. flapping), our terms related to abduction and adduction are preferred.

In the case where an appendage is moved through a dorsal/ventral arc but parallel to the body (alongside/parasagitally), our terms related to protraction and retraction are preferred.")
SubClassOf(obo:ACTAN_0000732 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000732 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002328))

# Class: obo:ACTAN_0000733 (hunch arch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000733 "https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality")
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000733 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000733 "2025-05-28T11:42:53.836855Z")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "ISBN:9781482294347") oboInOwl:hasBroadSynonym obo:ACTAN_0000733 "dorso-ventrally arched")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "ISBN:9781482294347") oboInOwl:hasDefinition obo:ACTAN_0000733 "Arch that has an axial concavity, ventrally orientated, in the sagittal plane.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000733 "hunch")
AnnotationAssertion(Annotation(dc:date "1948"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5252&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000733 "hunched"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasRelatedSynonym obo:ACTAN_0000733 "rounded")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000733 "hunch arch")
AnnotationAssertion(Annotation(dc:source "ISBN:9781482294347") skos:example obo:ACTAN_0000733 "\"Courtship in the Hynobiidae...
He grasps the emerging egg sacs firmly with his forelimbs and hindlimbs and then releases sperm while arching his body in the dorso-ventral plane.\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000733 "\"During the first 5 to 8 days of life, A. ibis chicks feed by weakly pecking and grabbing at any part of the adult's beak. When an adult is ready to pass food, it stands over the young in the hunched position... with beak pointing vertically downwards, and responds to its offsprings' pecking by slowly regurgitating a bolus of food.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:scopeNote obo:ACTAN_0000733 "\"Stand, walk or run on all fours with rounded back and head pulled in between shoulders. Seen among adult males at Mahale. Also occurs in bonobos.\"")
SubClassOf(obo:ACTAN_0000733 obo:ACTAN_0000809)
SubClassOf(obo:ACTAN_0000733 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002238))
SubClassOf(obo:ACTAN_0000733 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002501))

# Class: obo:ACTAN_0000734 (lateral-bend placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000734 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000734 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000734 "2025-05-28T11:51:53.326115Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasDefinition obo:ACTAN_0000734 "Placement that results from bending in a sagittal plane.")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") Annotation(skos:scopeNote "\"...curling the body laterally...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000734 "curling laterally")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") Annotation(dc:source "1977"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000734 "lateral arch")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000734 "laterally-bent")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasNarrowSynonym obo:ACTAN_0000734 "postured sinusoidally")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000734 "laterally flexed"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000734 "lateral-bend placement")
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0000734 "\"...South American cichlid Laetacara araguaiae...

A more aggressive posture may be adopted by curling the body laterally, with the fish assuming a “S” shape of the body.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") skos:example obo:ACTAN_0000734 "\"Metridium senile is notable for the variety of shapes which it assumes. It may be fully expanded with a narrow or with a wide column. The same anemone may next day be found contracted down to a mere button-like object. It may indulge in a variety of contortions in which it is laterally bent, or possesses deep transverse constrictions locally or completely embracing the column. The whole anemone may on occasion temporarily assume a shrivelled and contracted condition...\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:scopeNote obo:ACTAN_0000734 "\"An exaggerated lateral flexure is made in the body, often as the fish reverses directions. It may immediately straighten out again...\"")
SubClassOf(obo:ACTAN_0000734 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000734 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002497))
SubClassOf(obo:ACTAN_0000734 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000737))

# Class: obo:ACTAN_0000735 (straightening movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000735 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000735 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000735 "2025-05-28T20:19:09.382796Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.00424") oboInOwl:hasDefinition obo:ACTAN_0000735 "Movement that lessens axial curving.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000735 "straightening"@en)
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasNarrowSynonym obo:ACTAN_0000735 "reaching")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "https://bioengineering.hyperbook.mcgill.ca/functional-mechanics-of-the-elephant-and-butterfly-proboscis/") oboInOwl:hasNarrowSynonym obo:ACTAN_0000735 "uncoiling")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "https://bioengineering.hyperbook.mcgill.ca/functional-mechanics-of-the-elephant-and-butterfly-proboscis/") oboInOwl:hasNarrowSynonym obo:ACTAN_0000735 "unfurling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000735 "straightening movement"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icaa017") skos:example obo:ACTAN_0000735 "\"During concertina locomotion snakes have both sliding and static contact, and the head-to-tail distance changes as a convoluted region of the body provides a static anchoring region with subsequent straightening that slides the body forward.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:scopeNote obo:ACTAN_0000735 "\"An exaggerated lateral flexure is made in the body, often as the fish reverses directions. It may immediately straighten out again...\"")
SubClassOf(obo:ACTAN_0000735 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000735 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001593))

# Class: obo:ACTAN_0000736 (retracting movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000736 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000736 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000736 "2025-06-01T13:19:01.767943Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1088/1748-3190/ac482d") oboInOwl:hasDefinition obo:ACTAN_0000736 "Moving in which a body part is pulled back inwards.

In a stride cycle, this will be the stance phase.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000736 "retracting")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "doi:10.1017/S1464793104006700") oboInOwl:hasRelatedSynonym obo:ACTAN_0000736 "withdrawing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000736 "retracting movement")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000736 obo:ACTAN_0000085)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000736 obo:ACTAN_0000621)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000736 obo:ACTAN_0000777)
AnnotationAssertion(Annotation(dc:source "doi:10.1017/S1464793104006700") skos:example obo:ACTAN_0000736 "\"...in Latrodecus revivensis (Theridiidae), it may be the female herself that actively prevents the male from withdrawing the embolus after copulation, thus promoting fracture of the embolus within her genitalia.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4084834") skos:example obo:ACTAN_0000736 "\"In wing flicking, a heron walking slowly in an upright posture suddenly extends and retracts wings in a flicking action usually repeated several times.\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:scopeNote obo:ACTAN_0000736 "\"The bird suddenly crouches, with body horizontal, fully flexed legs, slightly raised scapulars, neck retracted and crest positions 7, 8, or 9.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3190/ac482d") skos:scopeNote obo:ACTAN_0000736 "\"The retraction phase... and the protraction phase... correspond the backward movement during stance... and the swing forward... respectively.\"")
SubClassOf(obo:ACTAN_0000736 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000736 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001477))

# Class: obo:ACTAN_0000737 (bending movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000737 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000737 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000737 "2025-06-10T09:16:44.74786Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.00424") oboInOwl:hasDefinition obo:ACTAN_0000737 "Movement that increases axial curving.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000737 "bending"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000737 "curving")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000737 "inclination")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://digit.snm.ku.dk/Documentsonline/GalatheaReports/galathea-vol.14-pp_049-108.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000737 "arching")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "https://bioengineering.hyperbook.mcgill.ca/functional-mechanics-of-the-elephant-and-butterfly-proboscis/") oboInOwl:hasNarrowSynonym obo:ACTAN_0000737 "coiling")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasRelatedSynonym obo:ACTAN_0000737 "contracting")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000737 "flexing")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000737 "flexure")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "https://bioengineering.hyperbook.mcgill.ca/functional-mechanics-of-the-elephant-and-butterfly-proboscis/") oboInOwl:hasRelatedSynonym obo:ACTAN_0000737 "furling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000737 "bending movement")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000737 "\"During breeding, the male zebrafish approaches the female and curves body around, positioning his genital pore next to hers.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") skos:example obo:ACTAN_0000737 "\"Giraffes are the tallest of all extant land-living species. The extremely long neck, evolved to reach the canopies of savannah trees but constrained by the mammal anatomical limit of seven cervical vertebrae, makes challenging some movements, like bending down to drink...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") skos:example obo:ACTAN_0000737 "\"In Hebrus pusillus, the male bends his genitalia ventrally 180° (but without rotation along the longitudinal axis), again resulting in an inverse correlation between male and female genitalia.\"")
SubClassOf(obo:ACTAN_0000737 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000737 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001592))

# Class: obo:ACTAN_0000738 (abducting movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000738 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000738 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000738 "2025-06-10T19:32:33.494096Z")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasBroadSynonym obo:ACTAN_0000738 "opening")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.204.8.1459") Annotation(skos:scopeNote "\"Pectoral fin-beat cycles started with the fins pressed against the body (maximally adducted), moving away (abducting) from the body to some maximum point of excursion and returning (adducting) to the original position...
Since the dorsal and anal fins beat synchronously, this will smooth the lateral forces produced by the motions of the pectoral fins and perhaps balance increasing fluid in the side forces of the dorsal/anal fin complex.\"") oboInOwl:hasDefinition obo:ACTAN_0000738 "Movement that excurs laterally away from the body.

This represents the up stroke (anterior) in flapping.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000738 "abducing")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(skos:scopeNote "\"...the pelvic fins are abducted now and then...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000738 "abducting"@en)
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasRelatedSynonym obo:ACTAN_0000738 "abduction")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000738 "raising")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000738 "abducting movement")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac061") skos:example obo:ACTAN_0000738 "\"Hawkfish do beat their pectoral fins during swimming. In our recordings pectoral fin movement was always performed in concert with the caudal fin beats and always with symmetrical abduction and adduction between the left and right pectoral fins.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:scopeNote obo:ACTAN_0000738 "\"...inconsistencies concerning the movements characterizing each phase do appear in the literature. Generally, during abduction, the fin is moved away from the body and downwards. It is then brought back to the body surface (adduction phase) and, during refraction, the fin is orientated to its original position by rotation of the leading edge. Due to the subtlety of these movements, the angle of attack for the fin changes during each phase. As a result, the lift forces generated have an elevation as well as a thrust component that causes the body to move up and down during normal forward swimming..\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:scopeNote obo:ACTAN_0000738 "\"Even in those filters that are relatively rigid, such as the gill rakers of fishes and the lamellae of birds, the porosity varies as the gill arches abduct and adduct or the jaws open and close, respectively.\"")
SubClassOf(obo:ACTAN_0000738 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000738 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002131))

# Class: obo:ACTAN_0000739 (adducting movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000739 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000739 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000739 "2025-06-10T19:32:44.509137Z")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasBroadSynonym obo:ACTAN_0000739 "closing")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000739 "folding")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasDefinition obo:ACTAN_0000739 "Movement that returns laterally towards the body.

This represents the down stroke (posterior) in flapping.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000739 "adducing")
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") Annotation(skos:scopeNote "\"...the valves are slightly adducted to release their grip...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000739 "adducting"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000739 "adduction")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000739 "clapped against")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000739 "adducting movement")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac061") skos:example obo:ACTAN_0000739 "\"Hawkfish do beat their pectoral fins during swimming. In our recordings pectoral fin movement was always performed in concert with the caudal fin beats and always with symmetrical abduction and adduction between the left and right pectoral fins.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:scopeNote obo:ACTAN_0000739 "\"...inconsistencies concerning the movements characterizing each phase do appear in the literature. Generally, during abduction, the fin is moved away from the body and downwards. It is then brought back to the body surface (adduction phase) and, during refraction, the fin is orientated to its original position by rotation of the leading edge. Due to the subtlety of these movements, the angle of attack for the fin changes during each phase. As a result, the lift forces generated have an elevation as well as a thrust component that causes the body to move up and down during normal forward swimming..\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:scopeNote obo:ACTAN_0000739 "\"Even in those filters that are relatively rigid, such as the gill rakers of fishes and the lamellae of birds, the porosity varies as the gill arches abduct and adduct or the jaws open and close, respectively.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") skos:scopeNote obo:ACTAN_0000739 "\"In most bivalves, contraction of the pedal retractors is accompanied by a quick adduction of the valves, which squeezes water out of the mantle cavity and into the sediment below the shell.\"")
SubClassOf(obo:ACTAN_0000739 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000739 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002133))

# Class: obo:ACTAN_0000740 (furling movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000740 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000740 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000740 "2025-06-11T11:16:12.507967Z")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasBroadSynonym obo:ACTAN_0000740 "closing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000740 "Movement that brings together the more mobile distal ends of proximally more fixed, similar parts.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasExactSynonym obo:ACTAN_0000740 "furling"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000740 "folding")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000740 "furling movement")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000740 obo:ACTAN_0000640)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.204.8.1459") skos:example obo:ACTAN_0000740 "\"At speeds above 5 TL s-1, fish were unable to maintain position in the flow using the median and paired fins alone and alternated the use of these fins with bursts of caudal-fin propulsion. At such times, the caudal fin executed 3–4 rapid beats, while the other fins were maximally adducted. The caudal fin was then furled as the pectoral and anal/dorsal fin complexes recommenced their movements.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:scopeNote obo:ACTAN_0000740 "\"When folded, the rays of the caudal fin may press together until the fin forms a point.\"")
SubClassOf(obo:ACTAN_0000740 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000740 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001485))

# Class: obo:ACTAN_0000741 (telescoping contracting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000741 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000741 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000741 "2025-06-11T11:20:50.938439Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1073/pnas.2122563119") oboInOwl:hasDefinition obo:ACTAN_0000741 "Contracting which sheathes one layer into another resulting in overall shortening.")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "https://www.researchgate.net/profile/Lina-Barrios-2/post/any_idea_about_these_anemones/attachment/59d61dea79197b807797c41b/AS%3A273509083512833%401442221055505/download/Fautin+et+al+2015-+Sea+anemones+of+Singapore.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000741 "telescope into")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1073/pnas.2122563119") Annotation(rdfs:comment "\"unsheathe\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000741 "sheathe"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000741 "telescoping contracting")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000741 obo:ACTAN_0000622)
AnnotationAssertion(Annotation(dc:source "doi:10.1073/pnas.2122563119") skos:example obo:ACTAN_0000741 "\"...telescopic behaviors have also been observed in honey bee abdomens, specifically during bending. A flexible membrane allows for each segment of the abdomen to telescope into the next segment.\"")
AnnotationAssertion(Annotation(dc:source "https://www.researchgate.net/profile/Lina-Barrios-2/post/any_idea_about_these_anemones/attachment/59d61dea79197b807797c41b/AS%3A273509083512833%401442221055505/download/Fautin+et+al+2015-+Sea+anemones+of+Singapore.pdf") skos:example obo:ACTAN_0000741 "\"Stephensonactis ornata Panikkar, 1936...
Column divided into narrower grayish capitulum that can telescope into broader orange scapus;\"")
SubClassOf(obo:ACTAN_0000741 obo:ACTAN_0000743)
SubClassOf(obo:ACTAN_0000741 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002313))

