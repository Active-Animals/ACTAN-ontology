AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3354/meps011165") Annotation(skos:scopeNote "\"A. clausi in Shijiki Bay and O. oculata in Tanabe Bay formed continuous flat swarms and carpeted the bottom with copepods.\"") oboInOwl:hasDefinition obo:ACTAN_0000408 "Dimension that corresponds to a continuous, flat carpet.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000408 "2-D")
AnnotationAssertion(Annotation(dc:date "1983"^^xsd:decimal) Annotation(dc:source "doi:10.3354/meps011165") oboInOwl:hasExactSynonym obo:ACTAN_0000408 "carpeting")
AnnotationAssertion(Annotation(dc:date "1983"^^xsd:decimal) Annotation(dc:source "doi:10.3354/meps011165") oboInOwl:hasExactSynonym obo:ACTAN_0000408 "flat")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s002850050112") Annotation(rdfs:comment "1998"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000408 "two dimensional"@en)
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "doi:10.1086/342821") oboInOwl:hasExactSynonym obo:ACTAN_0000408 "two-dimensional space")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000408 "two dimension"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.1125142") skos:example obo:ACTAN_0000408 "\"The desert locust, Schistocerca gregaria, has a devastating social and economic impact on humans. Before taking flight as adults, wingless juveniles (also called nymphs or hoppers) form coordinated \"marching bands\" that can extend over many kilometers.\"")
