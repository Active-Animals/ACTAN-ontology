AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000019 "spermatozoid")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000019 "spermatozoon")
AnnotationAssertion(rdfs:label obo:CL_0000019 "sperm")
SubClassOf(Annotation(oboInOwl:is_inferred "true") obo:CL_0000019 obo:CL_0000408)

# Class: obo:CL_0000025 (egg cell)

