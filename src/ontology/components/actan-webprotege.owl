AnnotationAssertion(rdfs:label obo:UBERON_0007113 "venom")
SubClassOf(obo:UBERON_0007113 obo:UBERON_0000456)

# Class: obo:UBERON_0007803 (preen oil)

AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:UBERON_0007803 "preen gland secretion")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:UBERON_0007803 "uropygial gland secretion")
AnnotationAssertion(rdfs:comment obo:UBERON_0007803 "The uropygial gland is involved in maintaining feather condition and secretions spread by preening. It serves a waterproofing function. The secretions contain a pro-vitamin D, converted by UV light to active vitamin D. The secretions are also believed to suppress the growth of micro-organisms, serving an anti-bacterial function. [http://en.wikivet.net]")
AnnotationAssertion(rdfs:label obo:UBERON_0007803 "preen oil")
SubClassOf(obo:UBERON_0007803 obo:UBERON_0000456)

# Class: obo:UBERON_0008811 (intromittent organ)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Intromittent_organ") obo:IAO_0000115 obo:UBERON_0008811 "An external organ of a male organism that is specialized to deliver sperm during copulation. Intromittent organs are found most often in terrestrial species, as most aquatic species fertilize their eggs externally, although there are exceptions[WP].")
AnnotationAssertion(obo:IAO_0000232 obo:UBERON_0008811 "this is a broad grouping class connecting a number of different analagous organs by their function. We place the insect aedeagus here rather than penis, although this is somewhat arbitrary given the broadness of the current definition")
