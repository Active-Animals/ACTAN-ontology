# Class: obo:UBERON_0001555 (digestive tract)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Talk:Human_gastrointestinal_tract") Annotation(oboInOwl:hasDbXref "https://github.com/geneontology/go-ontology/issues/7549") obo:IAO_0000115 obo:UBERON_0001555 "A tube extending from the mouth to the anus.")
AnnotationAssertion(Annotation(oboInOwl:date_retrieved "2012-08-14") Annotation(oboInOwl:external_class "TAO:0000112") Annotation(oboInOwl:ontology "TAO") Annotation(oboInOwl:source "ZFIN:curator") obo:UBPROP_0000001 obo:UBERON_0001555 "The alimentary or digestive tract, and associated organs.[TAO]")
AnnotationAssertion(Annotation(oboInOwl:date_retrieved "2012-09-17") Annotation(oboInOwl:external_class "VHOG:0000309") Annotation(oboInOwl:ontology "VHOG") Annotation(oboInOwl:source "ISBN:978-0030259821 Ruppert EE, Fox RS, Barnes RD, Invertebrate zoology: a functional evolutionary approach (2003) p.203, ISBN:978-0521617147 Stevens CE and Hume ID, Comparative physiology of the vertebrate digestive system (2004) p.11") Annotation(oboInOwl:source "http://bgee.unil.ch/") obo:UBPROP_0000003 obo:UBERON_0001555 "The bilaterian gut is typically a complete tube that opens to the exterior at both ends. It consists of mouth, foregut, midgut, hindgut, and anus (reference 1); Although all vertebrates have a digestive tract and accessory glands, various parts of this system are not necessarily homologous, analogous, or even present in all species. Therefore, broad comparisons can be best made under the listings of headgut, foregut, midgut, pancreas and biliary system, hindgut (reference 2).[well established][VHOG]")
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:UBERON_0001555 "gut")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:UBERON_0001555 "digestive tube")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "ZFA:0000112") oboInOwl:hasExactSynonym obo:UBERON_0001555 "enteric tract")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:UBERON_0001555 "alimentary canal")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:UBERON_0001555 "alimentary tract")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "BTO:0000058") oboInOwl:hasRelatedSynonym obo:UBERON_0001555 "digestive canal")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:UBERON_0001555 "gut tube")
AnnotationAssertion(rdfs:label obo:UBERON_0001555 "digestive tract")
SubClassOf(obo:UBERON_0001555 obo:UBERON_0001007)

