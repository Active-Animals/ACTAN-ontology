# Class: obo:ACTAN_0000085 (stance placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000085 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000085 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000085 "2024-09-16T15:08:38.679206Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasDefinition obo:ACTAN_0000085 "Placement which occurs during the contact phase of a gait.")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/20.1.255") Annotation(rdfs:comment "1980"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000085 "stance")
AnnotationAssertion(Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") Annotation(rdfs:comment "1977"^^xsd:decimal) oboInOwl:hasRelatedSynonym obo:ACTAN_0000085 "grounding"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000085 "stance placement")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000085 obo:ACTAN_0000736)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000085 "\"Hermit crabs (Order Anomura) unlike the Brachyura usually move forward rather than sideways. Movement in C. compressus is principally produced by the second and third pairs of thoracic appendages. These walking legs are positioned laterally and appear to provide thrust with both a pulling motion during the early part of the leg cycle as they reach forward, contact the sand and flex, and a pushing motion in the latter phase of the leg cycle when the legs extend to the rear of the crab.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") skos:scopeNote obo:ACTAN_0000085 "\"Compliant walking, groucho run, amble, or grounded run: A quadrupedal or bipedal gait characterized by... (3) no true aerial phase...\"
\"Step: A progressive motion in which one of the supporting members of the body is lifted from the ground, thrust in the direction of movement, and placed again on the ground.\"
\"Stance phase: The period of time when the foot is in contact with the ground.\"")
SubClassOf(obo:ACTAN_0000085 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000085 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000925))

