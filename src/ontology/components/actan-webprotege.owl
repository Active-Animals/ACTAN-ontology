SubClassOf(obo:ACTAN_0000729 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))

# Class: obo:ACTAN_0000730 (protraction placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000730 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000730 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000730 "2025-05-28T08:31:26.270473Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000730 "Placement that results from protracting.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000730 "protracted")
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.156.1.215") oboInOwl:hasExactSynonym obo:ACTAN_0000730 "protraction")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000730 "protraction placement"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000730 obo:ACTAN_0000710)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:example obo:ACTAN_0000730 "\"The hindlimb is protracted prior to heel contact.\"")
