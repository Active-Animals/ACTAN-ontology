SubClassOf(obo:ACTAN_0000803 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000798))

# Class: obo:ACTAN_0000804 (shrivel contraction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000804 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000804 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000804 "2025-08-13T11:10:16.388311Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000804 "Contraction that results from shrivelling contracting.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000804 "shrivelled"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000804 "shrivel contraction"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") skos:example obo:ACTAN_0000804 "\"Metridium senile... The whole anemone may on occasion temporarily assume a shrivelled and contracted condition... which, in fact, is a normal temporary state from which there is comparatively rapid recovery.\"")
SubClassOf(obo:ACTAN_0000804 obo:ACTAN_0000625)
SubClassOf(obo:ACTAN_0000804 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000623))

# Class: obo:ACTAN_0000805 (pre-flight ethotype)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000805 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000805 "2025-08-19T13:04:31.313658Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000805 "Ethotype that involves a selection from a variety of ritualized behaviour sequences, prior to flying up.

It may indicate intention in an individual, transmit the flying mood to others, and ensure synchronous flight in the group.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000805 "pre-flight signaling"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"...precede a take-off...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000805 "pre-take-off")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000805 "pre-flight ethotype"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000805 obo:ACTAN_0000641)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000805 "\"Head-shaking is widespread in the pre-flight behaviour of Anatidae... in Greylag Geese... the intensity of the movements gradually increases up to the moment of take-off.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000805 "\"Lorenz described the \"going-away call\" of the female Mallard which consisted of a series of \"quacks\" and is given especially before flight...\"")
SubClassOf(obo:ACTAN_0000805 obo:ACTAN_0000118)
SubClassOf(obo:ACTAN_0000805 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000317))

# Class: obo:ACTAN_0000806 (head extending)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000806 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000806 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000806 "2025-08-19T14:13:05.230223Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000806 "Extending that aims the head.

It may progressively involve the head, the neck, and the forebody.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"...aiming movements of the head... such pointing movements...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000806 "head aiming")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000806 "head and neck pointing")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"...aiming movements of the head... such pointing movements...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000806 "head pointing")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") Annotation(skos:scopeNote "\"...lowering or raising the head...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000806 "head raising")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000806 "bill pointing")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000806 "chin-lifting"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000806 "crown pointing")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000806 "head-thrusting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000806 "head extending")
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5252&context=wilson_bulletin") skos:example obo:ACTAN_0000806 "\"...when two male Purple Grackles were present on two occasions during anting, both birds indulged in the act of raising the head, pointing the bill upward.\"")
SubClassOf(obo:ACTAN_0000806 obo:ACTAN_0000726)
SubClassOf(obo:ACTAN_0000806 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000033))

# Class: obo:ACTAN_0000807 (head-high inspection)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000807 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000807 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000807 "2025-08-20T07:40:27.028903Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000807 "Inspection that involves temporarily raising the head.")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1002/9781118501153.ch12") oboInOwl:hasExactSynonym obo:ACTAN_0000807 "head up alert posture")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000807 "head-high"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000807 "head-high inspection"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1002/9781118501153.ch12") skos:example obo:ACTAN_0000807 "\"When active a flatfish often keeps its head elevated in an 'alert posture'...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000807 "\"Immediately after landing the birds tends to be alert, standing with heads high.\"")
SubClassOf(obo:ACTAN_0000807 obo:ACTAN_0000399)
SubClassOf(obo:ACTAN_0000807 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MF_0000003))
SubClassOf(obo:ACTAN_0000807 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000033))

# Class: obo:ACTAN_0000808 (back-zipping ethotype)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000808 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000808 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000808 "2025-09-03T10:24:50.010141Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"In (2) the wing is not lifted at all, the bill touching the bird's back.\"") oboInOwl:hasDefinition obo:ACTAN_0000808 "Zipping in which the wing is not lifted, the bill touching the bird's back.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000808 "dorsal-preening"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000808 "back-zipping ethotype")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000808 "\"Preen-dorsally occurs in many species before copulation. It is performed repeatedly by both male and female Marbled Teal...\"")
SubClassOf(obo:ACTAN_0000808 obo:ACTAN_0000118)
SubClassOf(obo:ACTAN_0000808 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000750))
SubClassOf(obo:ACTAN_0000808 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0001137))

# Class: obo:ACTAN_0000809 (arch placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000809 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000809 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000809 "2025-09-01T19:24:32.213653Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1676/1559-4491-128.3.628") oboInOwl:hasDefinition obo:ACTAN_0000809 "Placement that creates a partially circular, vertically positioned, profile.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000809 "arch")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://digit.snm.ku.dk/Documentsonline/GalatheaReports/galathea-vol.14-pp_049-108.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000809 "arched"@en)
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://digit.snm.ku.dk/Documentsonline/GalatheaReports/galathea-vol.14-pp_049-108.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000809 "arching"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000809 "arch placement")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.198.1.79") skos:example obo:ACTAN_0000809 "\"...intertidal benthic gobies performed ASR in shallow water... in an arched position with the head tilted up...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000809 "\"Occasionally a caterpillar, very similar fore and aft, in its efforts to extricate itself from a puddle, will violently bend from side to side so that the arch occurs centrally with no progressional movement at all.\"")
AnnotationAssertion(Annotation(dc:source "https://digit.snm.ku.dk/Documentsonline/GalatheaReports/galathea-vol.14-pp_049-108.pdf") skos:example obo:ACTAN_0000809 "\"Submersible obtained photographs of B. viridensis reveal that the long pectoral fin rays are spread and arched forward to encircle the head.\"")
SubClassOf(obo:ACTAN_0000809 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000809 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001594))
SubClassOf(obo:ACTAN_0000809 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002523))
SubClassOf(obo:ACTAN_0000809 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000737))

# Class: obo:ACTAN_0000810 (wing arch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000810 "https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity")
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000810 "Ditch Townsend")
