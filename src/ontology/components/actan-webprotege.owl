# Class: obo:ACTAN_0000258 (bent-concertina gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000258 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000258 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000258 "2024-10-06T10:10:46.880675Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasDefinition obo:ACTAN_0000258 "Climbing gait that uses active ventral flexion during concertinaing, to press medially and form a static grip via a series of curves to the left and right.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasExactSynonym obo:ACTAN_0000258 "concertina with alternate bends"@en)
