# Class: obo:GO_0007612 (learning)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "ISBN:0582227089") Annotation(oboInOwl:hasDbXref "ISBN:0721662544") obo:IAO_0000115 obo:GO_0007612 "Any process in an organism in which a relatively long-lasting adaptive behavioral change occurs as the result of experience.")
AnnotationAssertion(oboInOwl:hasDbXref obo:GO_0007612 "Wikipedia:Learning")
AnnotationAssertion(rdfs:label obo:GO_0007612 "learning")
SubClassOf(obo:GO_0007612 obo:MF_0000020)

# Class: obo:GO_0008306 (associative learning)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "ISBN:0582227089") obo:IAO_0000115 obo:GO_0008306 "Learning by associating a stimulus (the cause) with a particular outcome (the effect).")
AnnotationAssertion(oboInOwl:hasDbXref obo:GO_0008306 "Wikipedia:Learning#Associative_learning")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:GO_0008306 "Pavlovian conditioning")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:GO_0008306 "classical conditioning")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:GO_0008306 "conditional learning")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:GO_0008306 "conditional response")
AnnotationAssertion(rdfs:label obo:GO_0008306 "associative learning")
SubClassOf(obo:GO_0008306 obo:GO_0007612)

# Class: obo:GO_0046958 (nonassociative learning)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "ISBN:0582227089") obo:IAO_0000115 obo:GO_0046958 "A simple form of learning whereby the repeated presence of a stimulus leads to a change in the probability or strength of the response to that stimulus. There is no association of one type of stimulus with another, rather it is a generalized response to the environment.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:GO_0046958 "unconditional response")
AnnotationAssertion(rdfs:label obo:GO_0046958 "nonassociative learning")
SubClassOf(obo:GO_0046958 obo:GO_0007612)

# Class: obo:GO_0046959 (habituation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "ISBN:0582227089") obo:IAO_0000115 obo:GO_0046959 "A decrease in a behavioral response to a repeated stimulus. This is exemplified by the failure of a person to show a startle response to a loud noise that has been repeatedly presented.")
AnnotationAssertion(oboInOwl:hasDbXref obo:GO_0046959 "Wikipedia:Habituation")
AnnotationAssertion(rdfs:label obo:GO_0046959 "habituation")
SubClassOf(obo:GO_0046959 obo:GO_0046958)

# Class: obo:GSSO_007185 (eusociality)

AnnotationAssertion(obo:IAO_0000115 obo:GSSO_007185 "The highest level of organization of sociality, defined by the following characteristics: cooperative brood care (including care of offspring from other individuals), overlapping generations within a colony of adults, and a division of labor into reproductive and non-reproductive groups."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:GSSO_007185 "https://en.wikipedia.org/wiki/Eusociality"^^xsd:anyURI)
AnnotationAssertion(oboInOwl:hasDbXref obo:GSSO_007185 "https://www.wikidata.org/wiki/Q753694"^^xsd:anyURI)
AnnotationAssertion(rdfs:label obo:GSSO_007185 "eusociality"@en)
SubClassOf(obo:GSSO_007185 obo:PATO_0002003)

# Class: obo:INO_0000057 (controling)

AnnotationAssertion(obo:IAO_0000115 obo:INO_0000057 "a regulation that one interactor controls the quality of another interactor to a specific range")
AnnotationAssertion(obo:IAO_0000117 obo:INO_0000057 "YH, ZX")
AnnotationAssertion(obo:INO_0000006 obo:INO_0000057 "control, controled, controling, controlled, controlling, controls")
AnnotationAssertion(rdfs:label obo:INO_0000057 "controling")
SubClassOf(obo:INO_0000057 obo:INO_0000157)

# Class: obo:INO_0000157 (regulation)

AnnotationAssertion(obo:IAO_0000115 obo:INO_0000157 "A regulation represents a regulatory interaction between two interactors. ")
AnnotationAssertion(obo:IAO_0000117 obo:INO_0000157 "YH, ZX, AO, JH")
AnnotationAssertion(obo:INO_0000006 obo:INO_0000157 "regulate, regulated, regulates, regulating, regulation, regulator, modulate, modulated, modulates, modulating, modulation, mediate, mediated, mediates, mediating, influence, influenced, influences, influencing, affect, affected, affecting, affects, impact, impacted, impacting, impacts, effect, effected, effecting, effects, require, required, requires, requiring, respond, responded, responding, responds, responsive, change, changed, changes, changing, alter, altered, altering, alters, modified, modifies, modify, modifying, depend, depended, depending, depends, direct, directed, directing, directs, drive, driven, drives, driving, cause, caused, causes, causing,  lead, leading, leads, led, target, targeted, targeting, targets, dependent, essential for")
AnnotationAssertion(rdfs:label obo:INO_0000157 "regulation")
AnnotationAssertion(rdfs:seeAlso obo:INO_0000157 "GO: GO_0065007")
SubClassOf(obo:INO_0000157 obo:BFO_0000015)

# Class: obo:MFOEM_000001 (emotion process)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000001 "An affective process that is a synchronized aggregate of constituent mental processes including an appraisal process, which is valenced, has an object, and gives rise to an action tendency.")
AnnotationAssertion(rdfs:comment obo:MFOEM_000001 "Emotion processes are distinguished from other affective processes (e.g., mood) by having an object. Even if an emotion is experienced due to physiological reasons, they would be felt as being about something or someone. For instance, a person might be angry at a situation that they would normally not be angry at, because they are hungry. However, that person would still be angry at a specific situation.")
AnnotationAssertion(rdfs:comment obo:MFOEM_000001 "There is no rigid sequence of the entities that are part of the emotion process (e.g., an appraisal process does not necessarily precede a physiological process part of the emotion process).")
AnnotationAssertion(rdfs:comment obo:MFOEM_000001 "Valence refers to the 'the subjective value of an event, object, person, or other entity in the life space of the individual' (https://dictionary.apa.org/valence). Valence ranges from negative to positive.")
AnnotationAssertion(rdfs:label obo:MFOEM_000001 "emotion process")
SubClassOf(obo:MFOEM_000001 obo:MFOEM_000195)
SubClassOf(obo:MFOEM_000001 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MFOEM_000002))

# Class: obo:MFOEM_000002 (affective appraisal process)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000002 "A mental process that gives rise to an appraisal.")
AnnotationAssertion(obo:MFOEM_000010 obo:MFOEM_000002 "appraising")
AnnotationAssertion(rdfs:label obo:MFOEM_000002 "affective appraisal process")
AnnotationAssertion(rdfs:label obo:MFOEM_000002 "appraisal process")
SubClassOf(obo:MFOEM_000002 obo:MF_0000020)

# Class: obo:MFOEM_000009 (anger)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000009 "Anger is a negative emotion, characterised by feelings of unpleasantness and high arousal, in the form of antagonistic feelings and action tendencies. [Source: OCEAS]
")
AnnotationAssertion(rdfs:label obo:MFOEM_000009 "anger"@en)
SubClassOf(obo:MFOEM_000009 obo:MFOEM_000001)

# Class: obo:MFOEM_000026 (fear)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000026 "A negative emotion that is aversive and characterised by feelings of threat and impending doom, and by an urge to get out of the situation.")
AnnotationAssertion(rdfs:comment obo:MFOEM_000026 "Distinguished from anxiety since it usually has sudden onset and offset. Anxiety is often gradual and long-lasting and is triggered by a distal threat.")
AnnotationAssertion(rdfs:label obo:MFOEM_000026 "fear")
SubClassOf(obo:MFOEM_000026 obo:MFOEM_000001)

# Class: obo:MFOEM_000028 (anxiety)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000028 "A negative emotion that is aversive and provoked by the prospect of distal threat.")
AnnotationAssertion(rdfs:comment obo:MFOEM_000028 "Distinguished from fear since it is triggered by a distal threat whereas fear is triggered by an immediate threat. Often gradual and long-lasting, whereas fear usually has sudden onset and offset.   [Source: OCEAS]")
AnnotationAssertion(rdfs:comment obo:MFOEM_000028 "Experiencing 'anxious mood' can give rise to 'anxiety'. An 'anxious mood' does not have an object, but involves generalised feeling of anxiety that a person experiences. In contrast, 'anxiety' will be about something, even if this object is not well-specified.

The term 'distal' can refer to future threats or geographically distant threats.")
AnnotationAssertion(rdfs:label obo:MFOEM_000028 "anxiety")
SubClassOf(obo:MFOEM_000028 obo:MFOEM_000001)

# Class: obo:MFOEM_000195 (affective process)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000195 "A mental process that has positive or negative valence.")
AnnotationAssertion(rdfs:label obo:MFOEM_000195 "affective process"@en)
SubClassOf(obo:MFOEM_000195 obo:MF_0000020)

# Class: obo:MF_0000002 (remembering)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000002 "(for the case of remembering X, where X is an event in the organism’s history) a mental process that is a) about X, and b) made possible by the physical traces left by a causal process involving the organism during the event X")
AnnotationAssertion(obo:IAO_0000118 obo:MF_0000002 "act of remembering")
AnnotationAssertion(rdfs:label obo:MF_0000002 "remembering"@en)
SubClassOf(obo:MF_0000002 obo:MF_0000020)

# Class: obo:MF_0000003 (alertness)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000003 "State of active attention by high sensory awareness such as being watchful and prompt to meet danger or emergency, or being quick to perceive and act.

 http://en.wikipedia.org/wiki/Alertness")
AnnotationAssertion(obo:IAO_0000118 obo:MF_0000003 "state of alertness")
AnnotationAssertion(rdfs:label obo:MF_0000003 "alertness"@en)
AnnotationAssertion(owl:priorVersion obo:MF_0000003 "MFOMD_0000176")
SubClassOf(obo:MF_0000003 obo:MF_0000018)

# Class: obo:MF_0000008 (cognitive process)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000008 "A mental process that creates, modifies or has as participant some cognitive representation.")
AnnotationAssertion(rdfs:label obo:MF_0000008 "cognitive process")
AnnotationAssertion(rdfs:seeAlso obo:MF_0000008 "GO:0050890, cognition, defined as  `The operation of the mind by which an organism becomes aware of objects of thought or perception; it includes the mental activities associated with thinking, learning, and memory.' ")
SubClassOf(obo:MF_0000008 obo:MF_0000020)

# Class: obo:MF_0000018 (attending)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000018 "the process whereby relevant aspects of our mental experience are focused on specific targets")
AnnotationAssertion(rdfs:label obo:MF_0000018 "attending"@en)
SubClassOf(obo:MF_0000018 obo:MF_0000020)

# Class: obo:MF_0000020 (mental process)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000020 "A bodily process that occurs in the brain, and that can of itself be conscious, or can give rise to a process that can of itself be conscious or can give rise to behaviour.")
AnnotationAssertion(rdfs:comment obo:MF_0000020 "A 'mental process' is a subclass of 'bodily process', as mental processes occur within the body, specifically involving the brain.")
AnnotationAssertion(rdfs:comment obo:MF_0000020 "A bodily process which brings into being, sustains or modifies a cognitive representation or a behavior inducing state.")
AnnotationAssertion(rdfs:comment obo:MF_0000020 "Examples include thinking, feeling pain, remembering and emotion as occurrent experiences.")
AnnotationAssertion(rdfs:comment obo:MF_0000020 "Mental processes can varying in the degree to which they involve consciousness.")
AnnotationAssertion(rdfs:label obo:MF_0000020 "mental process")
AnnotationAssertion(rdfs:seeAlso obo:MF_0000020 "GO:0050890, cognition, defined as  `The operation of the mind by which an organism becomes aware of objects of thought or perception; it includes the mental activities associated with thinking, learning, and memory.' ")
SubClassOf(obo:MF_0000020 obo:BFO_0000015)

# Class: obo:MF_0000027 (planning)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000027 "A mental process that involves mentally manipulating representations of steps in an imagined process which has some goal.")
AnnotationAssertion(obo:IAO_0000118 obo:MF_0000027 "act of planning")
AnnotationAssertion(rdfs:comment obo:MF_0000027 "The outcome of this mental process is a plan which has the potential to be followed to bring about the desired outcome.")
AnnotationAssertion(rdfs:label obo:MF_0000027 "planning")
SubClassOf(obo:MF_0000027 obo:MF_0000020)

# Class: obo:MF_0000060 (vigilance)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000060 "The ability to maintain attention and alertness over prolonged periods of time.


http://en.wikipedia.org/wiki/Vigilance_%28psychology%29")
AnnotationAssertion(obo:IAO_0000118 obo:MF_0000060 "state of vigilance")
AnnotationAssertion(rdfs:label obo:MF_0000060 "vigilance"@en)
AnnotationAssertion(owl:priorVersion obo:MF_0000060 "MFOMD_0000140")
SubClassOf(obo:MF_0000060 obo:MF_0000018)

# Class: obo:NCIT_C60702 (random)

AnnotationAssertion(obo:IAO_0000115 obo:NCIT_C60702 "Governed by or depending on chance; lacking any definite plan or order or purpose.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:NCIT_C60702 "Random")
AnnotationAssertion(rdfs:label obo:NCIT_C60702 "random")
SubClassOf(obo:NCIT_C60702 obo:PATO_0001303)

# Class: obo:PATO_0000001 (characteristic)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://github.com/pato-ontology/pato/issues/602") obo:IAO_0000115 obo:PATO_0000001 "The properties, attributes, or modifiers used to describe an entity or process or some aspect of an entity or process.")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:PATO_0000001 "PATO:0000072")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "OBO:legacy") oboInOwl:hasExactSynonym obo:PATO_0000001 "quality")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PATO_0000001 "quality")
AnnotationAssertion(oboInOwl:id obo:PATO_0000001 "PATO:0000001")
AnnotationAssertion(rdfs:label obo:PATO_0000001 "characteristic")
SubClassOf(obo:PATO_0000001 obo:BFO_0000002)

# Class: obo:PATO_0000004 (mobility)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0000004 "A quality of inhering in a bearer by virtue of the bearer's disposition to move freely.")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PATO_0000004 "quality")
AnnotationAssertion(oboInOwl:id obo:PATO_0000004 "PATO:0000004")
AnnotationAssertion(oboInOwl:inSubset obo:PATO_0000004 <http://purl.obolibrary.org/obo/pato#attribute_slim>)
AnnotationAssertion(oboInOwl:inSubset obo:PATO_0000004 <http://purl.obolibrary.org/obo/pato#disposition_slim>)
AnnotationAssertion(oboInOwl:inSubset obo:PATO_0000004 <http://purl.obolibrary.org/obo/pato#scalar_slim>)
AnnotationAssertion(rdfs:comment obo:PATO_0000004 "Should be defined using translocation.")
AnnotationAssertion(rdfs:label obo:PATO_0000004 "mobility")
SubClassOf(obo:PATO_0000004 obo:PATO_0001018)
SubClassOf(obo:PATO_0000004 obo:PATO_0001241)

# Class: obo:PATO_0000008 (speed)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000008 "Definition: A physical quality inhering in a bearer by virtue of the bearer's scalar absolute value of the rate of change of the bearer's position.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:PATO_0000008 "velocity")
AnnotationAssertion(rdfs:label obo:PATO_0000008 "speed")
SubClassOf(obo:PATO_0000008 obo:PATO_0001906)

# Class: obo:PATO_0000016 (color brightness)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0000016 "A scalar optical property that is the intensity, value or amount of perceived light.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PATO_0000016 "color intensity")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PATO_0000016 "color lightness")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PATO_0000016 "color value")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PATO_0000016 "quality")
AnnotationAssertion(oboInOwl:id obo:PATO_0000016 "PATO:0000016")
AnnotationAssertion(oboInOwl:inSubset obo:PATO_0000016 <http://purl.obolibrary.org/obo/pato#attribute_slim>)
AnnotationAssertion(rdfs:comment obo:PATO_0000016 "Color brightness refers to the intensity, lightness or value of the light present. Think of this as a dimmer switch.")
AnnotationAssertion(rdfs:label obo:PATO_0000016 "color brightness")
SubClassOf(obo:PATO_0000016 obo:PATO_0001300)

# Class: obo:PATO_0000039 (direction)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "thesaurus.maths:thesaurus.maths") obo:IAO_0000115 obo:PATO_0000039 "A physical quality inhering in a bearer by virtue of the bearer's orientation in space.")
AnnotationAssertion(rdfs:comment obo:PATO_0000039 "TODO: consider merging with angular placement.")
AnnotationAssertion(rdfs:label obo:PATO_0000039 "direction")
SubClassOf(obo:PATO_0000039 obo:PATO_0001018)
SubClassOf(obo:PATO_0000039 obo:PATO_0001241)

# Class: obo:PATO_0000040 (distance)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000040 "Definition: A quality that is the extent of space between two entities.")
AnnotationAssertion(rdfs:label obo:PATO_0000040 "distance")
SubClassOf(obo:PATO_0000040 obo:PATO_0001018)
SubClassOf(obo:PATO_0000040 obo:PATO_0001241)

# Class: obo:PATO_0000044 (frequency)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000044 "Definition: A physical quality which inheres in a bearer by virtue of the number of the bearer's repetitive actions in a particular time.")
AnnotationAssertion(rdfs:label obo:PATO_0000044 "frequency")
SubClassOf(obo:PATO_0000044 obo:PATO_0002062)

# Class: obo:PATO_0000051 (morphology)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000051 "Definition: A quality of a single physical entity inhering in the bearer by virtue of the bearer's size or shape or structure.")
AnnotationAssertion(rdfs:label obo:PATO_0000051 "morphology")
SubClassOf(obo:PATO_0000051 obo:PATO_0001241)

# Class: obo:PATO_0000052 (shape)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000052 "Definition: A morphological quality inhering in a bearer by virtue of the bearer's ratios of distances between its features (points, edges, surfaces and also holes etc).")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PATO_0000052 "relational shape quality")
AnnotationAssertion(rdfs:comment obo:PATO_0000052 "Shapes are invariant on size transformations. Shapes can be subdivided into 2D and 3D shapes, We can also make a distinction between shapes of complete self-connected objects, and shapes of parts of objects.")
AnnotationAssertion(rdfs:label obo:PATO_0000052 "shape")
SubClassOf(obo:PATO_0000052 obo:PATO_0000051)

# Class: obo:PATO_0000057 (occurrence)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0000057 "A quality of a single process inhering in a bearer by virtue of the bearer's occurrence.")
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:PATO_0000057 "temporal")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PATO_0000057 "incidence")
AnnotationAssertion(rdfs:label obo:PATO_0000057 "occurrence")
SubClassOf(obo:PATO_0000057 obo:PATO_0002323)

# Class: obo:PATO_0000058 (odor)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0000058 "A physical quality inhering in a bearer by virtue of the bearer's molecules being are aerially dispersed and perceived by an odorant receptor.")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PATO_0000058 "quality")
AnnotationAssertion(oboInOwl:id obo:PATO_0000058 "PATO:0000058")
AnnotationAssertion(oboInOwl:inSubset obo:PATO_0000058 <http://purl.obolibrary.org/obo/pato#attribute_slim>)
AnnotationAssertion(rdfs:label obo:PATO_0000058 "odor")
SubClassOf(obo:PATO_0000058 obo:PATO_0001018)
SubClassOf(obo:PATO_0000058 obo:PATO_0001241)

# Class: obo:PATO_0000060 (spatial pattern)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000060 "Definition: A spatial quality inhering in a bearer by virtue of the bearer's exhibiting repetition of placement of its parts.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PATO_0000060 "distribution")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:PATO_0000060 "pattern")
AnnotationAssertion(rdfs:label obo:PATO_0000060 "spatial pattern")
SubClassOf(obo:PATO_0000060 obo:PATO_0000051)

# Class: obo:PATO_0000077 (response to)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000077 "Definition: A quality inhering in a bearer by virtue of the whether the bearer's disposition to react to a stimulus or an agent.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:PATO_0000077 "response")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:PATO_0000077 "responsivity")
AnnotationAssertion(rdfs:label obo:PATO_0000077 "response to")
SubClassOf(obo:PATO_0000077 obo:PATO_0001995)

# Class: obo:PATO_0000078 (rhythm quality)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000078 "Definition: A quality of a single process inhering in a bearer by virtue of the bearer's movement or variation characterized by the regular recurrence or alternation of different quantities or conditions.")
AnnotationAssertion(rdfs:label obo:PATO_0000078 "rhythm quality")
SubClassOf(obo:PATO_0000078 obo:PATO_0002323)

# Class: obo:PATO_0000080 (amplitude)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000080 "Definition: A physical quality of a process inhering in a bearer by virtue of the size of the bearer's maximum displacement from the 'normal' position, when periodic motion is taking place.")
AnnotationAssertion(rdfs:label obo:PATO_0000080 "amplitude")
SubClassOf(obo:PATO_0000080 obo:PATO_0002062)

# Class: obo:PATO_0000083 (phase)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0000083 "A quality that exists by virtue of being a particular point in the time of a cycle.")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:PATO_0000083 "quality")
AnnotationAssertion(oboInOwl:id obo:PATO_0000083 "PATO:0000083")
AnnotationAssertion(oboInOwl:inSubset obo:PATO_0000083 <http://purl.obolibrary.org/obo/pato#attribute_slim>)
AnnotationAssertion(rdfs:label obo:PATO_0000083 "phase")
SubClassOf(obo:PATO_0000083 obo:PATO_0002323)

# Class: obo:PATO_0000117 (size)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000117 "Definition: A morphology quality inhering in a bearer by virtue of the bearer's physical magnitude.")
AnnotationAssertion(rdfs:label obo:PATO_0000117 "size")
SubClassOf(obo:PATO_0000117 obo:PATO_0000051)

# Class: obo:PATO_0000128 (weight)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0000128 "A physical quality inhering in a bearer that has mass near a gravitational body. Important usage note: Note that this ontology has a class for a similar concept, mass (PATO:0000125). Mass and weight are not equivalent. For most use cases, the class mass is strongly preferred over weight.")
AnnotationAssertion(rdfs:comment obo:PATO_0000128 "For any biological use of PATO, the concept that should be used is 'mass' and not 'weight'. For example, increased weight of an organism.")
AnnotationAssertion(rdfs:label obo:PATO_0000128 "weight")
SubClassOf(obo:PATO_0000128 obo:PATO_0001035)

# Class: obo:PATO_0000133 (orientation)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000133 "Definition: A spatial quality inhering in a bearer by virtue of the bearer's placement which is defined by the angle between the bearer and an axis, or the angle between the bearer and another object.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PATO_0000133 "angular placement")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:PATO_0000133 "amount of rotation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:PATO_0000133 "angle")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:PATO_0000133 "angular magnitude")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:PATO_0000133 "plane angle")
AnnotationAssertion(rdfs:label obo:PATO_0000133 "orientation")
SubClassOf(obo:PATO_0000133 obo:PATO_0000140)

# Class: obo:PATO_0000136 (closure)

AnnotationAssertion(obo:IAO_0000115 obo:PATO_0000136 "A morphological quality pertaining to the degree to which an object contains an opening, aperture, orifice or vent.")
AnnotationAssertion(rdfs:label obo:PATO_0000136 "closure")
SubClassOf(obo:PATO_0000136 obo:PATO_0000051)

# Class: obo:PATO_0000140 (position)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000140 "Definition: A spatial quality inhering in a bearer by virtue of the bearer's spatial location relative to other objects in the vicinity.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PATO_0000140 "location")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PATO_0000140 "placement")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PATO_0000140 "relational spatial quality")
AnnotationAssertion(rdfs:label obo:PATO_0000140 "position")
SubClassOf(obo:PATO_0000140 obo:PATO_0001018)
SubClassOf(obo:PATO_0000140 obo:PATO_0001241)

# Class: obo:PATO_0000141 (structure)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000141 "Definition: A morphology quality inhering in a bearer by virtue of the bearer's relative position, shape, arrangements and connectivity of an organism's various parts; the pattern underlying its form.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:PATO_0000141 "relational structural quality")
AnnotationAssertion(rdfs:label obo:PATO_0000141 "structure")
SubClassOf(obo:PATO_0000141 obo:PATO_0000051)

# Class: obo:PATO_0000146 (temperature)

AnnotationAssertion(oboInOwl:hasDefinition obo:PATO_0000146 "Definition: A physical quality of the thermal energy of a system.")
