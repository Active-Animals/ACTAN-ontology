AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1023/A:1005565304671") Annotation(skos:scopeNote "\"One of the hind limbs then released the liftoff stem and protracted the distance required to allow the foot to grasp the target lateral stem.\"") oboInOwl:hasDefinition obo:ACTAN_0000938 "Protracting which involves a hindlimb.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"The hindlimb is protracted prior to contact.\"") rdfs:label obo:ACTAN_0000938 "hindlimb protracting"@en)
