SubClassOf(obo:ACTAN_0000264 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000317))

# Class: obo:ACTAN_0000265 (tripod stand)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000265 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000265 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000265 "2024-10-06T16:01:00.030926Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"Vertical tripod: A flexed bipedal stand in which additional stability is provided by contact between the stiffened tail and the ground.\"") oboInOwl:hasDefinition obo:ACTAN_0000265 "Stand in which additional bipedal stability is provided by contact between the stiffened tail and the ground.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000265 "vertical tripod"@en)
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://digit.snm.ku.dk/Documentsonline/GalatheaReports/galathea-vol.14-pp_049-108.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000265 "stilting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000265 "tripod stand")
AnnotationAssertion(Annotation(dc:source "https://digit.snm.ku.dk/Documentsonline/GalatheaReports/galathea-vol.14-pp_049-108.pdf") skos:example obo:ACTAN_0000265 "\"The produced outer pelvic and lower caudal fin rays are found to be poorly innervated and encased distally by a pad of epithelial tissue. These specialized rays appear to serve as stilts to elevate Bathypterois into the near bottom layer of zooplankton upon which it feeds.\"")
SubClassOf(obo:ACTAN_0000265 obo:ACTAN_0000245)
SubClassOf(obo:ACTAN_0000265 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002415))

# Class: obo:ACTAN_0000266 (aquatic-lateral-undulating gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000266 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000266 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000266 "2024-10-06T18:51:02.24113Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasDefinition obo:ACTAN_0000266 "Swimming-gait in which the amplitude and wavelength of lateral undulating waves increase regularly from anterior to posterior along the body, and the speed of mechanical wave propagation exceeds the forward speed of the animal.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasExactSynonym obo:ACTAN_0000266 "aquatic lateral undulating"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000266 "aquatic-lateral-undulating gait"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000266 obo:ACTAN_0000139)
SubClassOf(obo:ACTAN_0000266 obo:ACTAN_0000087)
SubClassOf(obo:ACTAN_0000266 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000671))
