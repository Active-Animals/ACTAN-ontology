# Class: obo:ACTAN_0000539 (paralleling alignment)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000539 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000539 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000539 "2025-01-21T12:08:19.983134Z")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "http://researcharchive.vuw.ac.nz/handle/10063/9442") Annotation(skos:scopeNote "\"...parallel (head to head).\"") oboInOwl:hasBroadSynonym obo:ACTAN_0000539 "head to head")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000539 "Alignment that is alongside another, head-to-head.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000539 "paralleling"@en)
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10682-007-9183-7") oboInOwl:hasRelatedSynonym obo:ACTAN_0000539 "lateral display")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000539 "paralleling alignment"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10682-007-9183-7") skos:example obo:ACTAN_0000539 "\"Courtship displays of R. decemdigitatus consisted of 11 steps: ... (vi) lateral displays, in which the male swims close to the female with erect dorsal and pectoral fins, shivering his body...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") skos:scopeNote obo:ACTAN_0000539 "\"Pair-bonded fish exhibit several affiliative behaviors. In cichlids, pair-bonded individuals display parallel swimming, tail beating, circling, greeting, and affiliative bites.\"")
SubClassOf(obo:ACTAN_0000539 obo:ACTAN_0000922)
SubClassOf(obo:ACTAN_0000539 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002272))

# Class: obo:ACTAN_0000540 (stereotype switch)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000540 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000540 "2025-01-21T15:20:25.440084Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/j.beproc.2014.10.001") oboInOwl:hasDefinition obo:ACTAN_0000540 "Switch that is part of a highly predictable, rigid pattern of serially and spatially configured activity modules.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000540 "fixed motor pattern")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasExactSynonym obo:ACTAN_0000540 "stereotyped pattern of behavior"@en)
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasExactSynonym obo:ACTAN_0000540 "stereotypy")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000540 "fixed action pattern (FAP)")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.beproc.2014.10.001") oboInOwl:hasNarrowSynonym obo:ACTAN_0000540 "modal action pattern (MAP)")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000540 "automatic")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000540 "fixed")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1111/tops.12554") oboInOwl:hasRelatedSynonym obo:ACTAN_0000540 "inflexible")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000540 "rigid")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000540 "ritual")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/eff.12212") Annotation(skos:scopeNote "\"...abnormal behaviours, such as stereotypic behaviour, inappropriate time budgeting or the occurrence of atypical behaviour....\"") rdfs:comment obo:ACTAN_0000540 "The literature mixes up use of certain terms for 'normal' and 'abnormal' behaviours: in this case we use the term 'stereotyped' to refer to 'normal', if invariant, behaviour, and not to 'abnormal' behaviour such as maladaptive perseveration.")
AnnotationAssertion(rdfs:label obo:ACTAN_0000540 "stereotype switch")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:example obo:ACTAN_0000540 "\"...the flock of teal may release sham attacks by the falcon, resulting in the isolation of a member of the flock. The final stoop, capture, kill, plucking, and eating form a relatively simple and stereotyped\" chain of consummatory acts.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") skos:example obo:ACTAN_0000540 "\"The rarer jaw movement was highly stereotyped, comprising a rapid, large-amplitude depression of the jaw concurrent with cranial elevation. This movement was exclusively associated with capture events and was preceded by an attack swim or S-strike, or occurred in isolation as a ‘‘suction’’ capture. Thus, different capture strategies in zebrafish larvae emerge by combining different stereotyped tail kinematics with stereotyped jaw kinematics.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/tops.12554") skos:scopeNote obo:ACTAN_0000540 "\"...stereotyped, inflexible tooling, which can be identified by the use of “a single tool for a single purpose in a particular context”, typically in species showing only one type of tooling.\"")
SubClassOf(obo:ACTAN_0000540 obo:ACTAN_0000541)
SubClassOf(obo:ACTAN_0000540 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000438))

# Class: obo:ACTAN_0000541 (configuration-switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000541 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000541 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000541 "2025-01-21T17:53:57.678106Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1534/genetics.120.303539") oboInOwl:hasDefinition obo:ACTAN_0000541 "Behavioural disposition that is realized when an animal transitions between configurations.")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasExactSynonym obo:ACTAN_0000541 "switching"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000541 "starting")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000541 "stopping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000541 "configuration-switch")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/1365-2656.12379") skos:example obo:ACTAN_0000541 "\"The first order question is When is the wolf dispersing (or behaving in a ‘dispersive’ way)?...

This three-step signature, which we might describe as dispersive to exploratory to pseudoterritorial was visible in the sequence of shifts from mid-April... to the end of May...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:scopeNote obo:ACTAN_0000541 "\"As animals explore their environments, their nervous systems transition between behavioral states that influence how sensory information is processed and how actions are generated.\"")
SubClassOf(obo:ACTAN_0000541 <http://humanbehaviourchange.org/ontology/BCIO_050416>)
SubClassOf(obo:ACTAN_0000541 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002325))

# Class: obo:ACTAN_0000542 (random switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000542 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000542 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000542 "2025-01-21T17:55:27.312962Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/j.jtbi.2011.01.001") oboInOwl:hasDefinition obo:ACTAN_0000542 "Switch that overcomes uncertainty with a non-deterministic component.")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasExactSynonym obo:ACTAN_0000542 "random")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1140/epjst/e2008-00633-y") oboInOwl:hasExactSynonym obo:ACTAN_0000542 "stochasticity"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000542 "spontaneous departure")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000542 "random switch")
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:example obo:ACTAN_0000542 "\"C. elegans animals... roaming and dwelling, where animals stochastically switch between the two states...\"")
SubClassOf(obo:ACTAN_0000542 obo:ACTAN_0000541)
SubClassOf(obo:ACTAN_0000542 ObjectSomeValuesFrom(obo:RO_0000086 obo:NCIT_C60702))

# Class: obo:ACTAN_0000543 (phase switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000543 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000543 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000543 "2025-01-21T17:55:40.303416Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1534/genetics.120.303539") Annotation(skos:scopeNote "\"Periodic display of sleep during lethargus is likely one manifestation of oscillation of physiology during larval development.\"") oboInOwl:hasDefinition obo:ACTAN_0000543 "Switch which is periodic.

It is likely one manifestation of oscillation of physiology")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fnbeh.2010.00049") oboInOwl:hasNarrowSynonym obo:ACTAN_0000543 "circadian rhythm")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasRelatedSynonym obo:ACTAN_0000543 "phase"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000543 "phase switch")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000543 "\"Haplochromis multicolor...
In a male in the non-mating phase and particularly in a female carrying young, longitudinal bands develop.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000543 "\"Oscillations of locomotor activity: Sinusoidal aspect of zebrafish locomotion/swimming, with alternating high and lower-velocity phases (usually, with the frequency of 4–5 min) when exposed to novel environments.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:example obo:ACTAN_0000543 "\"When C. elegans animals are removed from food, they display a stereotyped sequence of two consecutive locomotion states. For the first 15 min, they engage in a local search state (also called “area-restricted search”) consisting of a high frequency of high-angle turns and omega bends. Then, they transition to a global search state (also referred to as dispersal); where they suppress their turning rates.\"")
SubClassOf(obo:ACTAN_0000543 obo:ACTAN_0000541)
SubClassOf(obo:ACTAN_0000543 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000083))

# Class: obo:ACTAN_0000544 (returning translocation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000544 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000544 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000544 "2025-01-22T20:41:12.913824Z")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasDefinition obo:ACTAN_0000544 "Translocation which involves a route going back to a previously visited site.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000544 "returning"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000544 "returning translocation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/41.2.137") skos:example obo:ACTAN_0000544 "\"Eastern chipmunk (Tamias striatus) returning to burrow with load of seeds.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000544 "\"I traced the returning file burthened with booty, for about forty yards, to a very thick clump of heath, whence I saw the last individual of F. sanguinea emerge, carrying a pupa;\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1023/A:1005565304671") skos:example obo:ACTAN_0000544 "\"Macaca radiata...
Returning toward the trunk along these steeply sloped longitudinal branches was, effectively, a descent that required careful foot placement and tail braking.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3354/esr01312") skos:example obo:ACTAN_0000544 "\"Some taxa—particularly snakes—often travel several kilometers from activity season ranges to return to the same hibernaculum each winter.\"")
SubClassOf(obo:ACTAN_0000544 obo:ACTAN_0000752)
SubClassOf(obo:ACTAN_0000544 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002448))

