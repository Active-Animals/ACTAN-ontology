AnnotationAssertion(Annotation(oboInOwl:hasDbXref "POC:Maria_Alejandra_Gandolfo") Annotation(oboInOwl:hasSynonymType <http://purl.obolibrary.org/obo/po#Spanish>) oboInOwl:hasExactSynonym obo:PO_0009001 "fruto (exact, Spanish)")
