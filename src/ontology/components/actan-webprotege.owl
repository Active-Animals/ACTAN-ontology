AnnotationAssertion(Annotation(oboInOwl:source "ncithesaurus:Back") oboInOwl:hasDbXref obo:UBERON_0001137 "UMLS:C0004600")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0001137 "Wikipedia:Dorsum_(anatomy)")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0001137 "galen:Back")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:14181") oboInOwl:hasExactSynonym obo:UBERON_0001137 "back")
