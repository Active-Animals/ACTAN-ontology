AnnotationAssertion(Annotation(dc:date "1983"^^xsd:decimal) Annotation(dc:source "doi:10.3354/meps011165") oboInOwl:hasExactSynonym obo:ACTAN_0000568 "escape")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000568 "escaping"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000568 "fleeing")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000568 "panicky flight")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000568 "flight")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000568 "panic")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000568 "escape evasion")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000568 "\"Fright in Badis badis finds expression in three more or less conflicting kinds of behavior... The most extrewe type of Avoiding is panicky flight ; the behavior has negative valence since the only taxis is away from the stimulus, if the stimulus is located.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000568 "\"We noted Uca pugilator could also travel at 0- 2 km h~' but they could run twice as fast for about 3 min and sprint at much higher speeds for a few seconds. This behaviour is essential if fiddler crabs are to dash back to their burrow to escape predators.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000568 "NBO:0020268")
SubClassOf(obo:ACTAN_0000568 obo:ACTAN_0000379)
SubClassOf(obo:ACTAN_0000568 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000689))

