AnnotationAssertion(terms:conformsTo obo:ACTAN_0000516 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000516 "Ditch Townsend")
