# Class: obo:ACTAN_0000495 (plane steering)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000495 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000495 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000495 "2026-07-21T15:20:09.268792Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"This method is effective only if the fish is actively swimming as the fins are held passively up or down, their position as planes, and not any motion of theirs, determining the course taken.\"") oboInOwl:hasDefinition obo:ACTAN_0000495 "Steering in which, when an animal is actively moving, appendages are held passively up or down, their position determining the course taken.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "\"...wheeling about by “warping” the planes.\"") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000495 "plane wheeling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000495 "plane steering"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000495 "\"Prionotus evolans and carolinus... wheeling about by “warping” the planes. Sometimes they will “volplane” through the water in wide circles by this means alone.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000495 "\"The turning over of sharks when feeding from the surface is not a necessary act, for often they will deliberately swim up, protruding the snout, so as to place the inferior mouth at the surface. However, when such turns are made, they are controlled entirely by warping the guiding keel-like fins.\"")
SubClassOf(obo:ACTAN_0000495 obo:ACTAN_0000645)
SubClassOf(obo:ACTAN_0000495 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002445))

# Class: obo:ACTAN_0000496 (tail sweeping)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000496 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000496 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000496 "2026-07-21T16:32:44.996405Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"This produces the appearance of a progression more or less snake or eel-like, although in general the powerful sweeps of the strong tail characterize the progression as fish-like.”\"") oboInOwl:hasDefinition obo:ACTAN_0000496 "Sweeping that involves the tail.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...sweeps of the strong tail...\"") rdfs:label obo:ACTAN_0000496 "tail sweeping"@en)
SubClassOf(obo:ACTAN_0000496 obo:ACTAN_0000716)
SubClassOf(obo:ACTAN_0000496 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002415))

# Class: obo:ACTAN_0000497 (sail regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000497 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000497 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000497 "2026-07-22T07:29:17.794723Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000497 "Swimming-regime that uses a structure above the water surface to harvest air current momentum.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000497 "sailing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000497 "sail regime"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000497 "\"Istiophorus nigricans (Lacepede) must possess a powerful keel in the enlarged dorsal fin but its exact use is not evident, although it is reputed to project the fin above the surface and actually sail by that means.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1676/1559-4491-128.3.628") skos:example obo:ACTAN_0000497 "\"The Mute Swans were windsurfing in a southern direction, i.e., in tailwind, using the arched wings as sails.\"")
SubClassOf(obo:ACTAN_0000497 obo:ACTAN_0000088)
SubClassOf(obo:ACTAN_0000497 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000486))
SubClassOf(obo:ACTAN_0000497 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000289))
SubClassOf(obo:ACTAN_0000497 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000543))
SubClassOf(obo:ACTAN_0000497 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01000267))

# Class: obo:ACTAN_0000498 (phoresy relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000498 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000498 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000498 "2026-07-26T07:22:31.495774Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/brv.12654") Annotation(skos:scopeNote "\"We believe these definitions are complementary, and that phoresy can be defined most broadly as the behaviour of one organism (the phoront) to disperse from one location to another with the aid of another organism (the dispersal host) by attaching to that organism, regardless of whether the phoront actively searches for or more passively waits for the host.\"") oboInOwl:hasDefinition obo:ACTAN_0000498 "Relativity in which an organism disperses from its location with the aid of another organism by attaching to it.

This is regardless of whether the phoront actively searches for or more passively waits for the host.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1111/brv.12654") oboInOwl:hasExactSynonym obo:ACTAN_0000498 "phoresis")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1111/brv.12654") oboInOwl:hasExactSynonym obo:ACTAN_0000498 "phoresy")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1111/brv.12654") oboInOwl:hasNarrowSynonym obo:ACTAN_0000498 "hyperphoresy")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000498 "phoresy relativity"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000498 "\"DISCOCEPHALI...
This placing of these fins appears to be associated with the ability of the fish to rotate on its longitudinal axis in swimming, apparently turning to any such position with ease. This is clearly necessary to insure attachment to sharks or other bodies. That fishes of such natatorial powers possess such a highly specialized organ as the cephalic disc is interesting, for they have apparently suffered no particular degeneration of their power to care for themselves in a locomotor sense, for of course they must first catch their shark.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12654") skos:scopeNote obo:ACTAN_0000498 "\"Fossilized accounts of phoresy include mites, springtails, and pseudoscorpions, with some records of mites dating back 85 million years, and pseudoscorpion records dating back 40 million years.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:scopeNote obo:ACTAN_0000498 "\"Madeira, again, is inhabited by a wonderful number of peculiar land-shells, whereas not one species of sea-shell is confined to its shores: now, though we do not know how seashells are dispersed, yet we can see that their eggs or larvæ, perhaps attached to seaweed or floating timber, or to the feet of wading-birds, might be transported far more easily than land-shells, across three or four hundred miles of open sea.\"")
SubClassOf(obo:ACTAN_0000498 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000498 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000289))

# Class: obo:ACTAN_0000499 (ownership assessment)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000499 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000499 "2024-12-23T21:12:51.454852Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"EVANS (1935, 1936) found that in Anolis carolinensis the heaviest male usually won the fight. If, however, the lighter male was already in possession of the territory, then the bigger one was often defeated. KRAMER (1937) found the moral effect of the possession of a territory in the lizard Lacerta melisellensis.\"") oboInOwl:hasDefinition obo:ACTAN_0000499 "Assessment which assumes moral possession.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000499 "ownership")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000499 "owning")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000499 "possession")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000499 "reserving")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2019.12.009") Annotation(skos:scopeNote "\"...conceiving of ownership is unfeasible in animal societies...\"") rdfs:comment obo:ACTAN_0000499 "There are probably more appropriate ways to conceive of behaviour that looks like 'ownership', such as 'control of access'.")
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000499 "ownership assessment")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000499 obo:ACTAN_0000291)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000499 obo:ACTAN_0000378)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000499 obo:ACTAN_0000382)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000499 obo:ACTAN_0000449)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000499 obo:ACTAN_0000834)
SubClassOf(obo:ACTAN_0000499 obo:ACTAN_0000334)

# Class: obo:ACTAN_0000500 (shinny gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000500 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000500 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000500 "2025-07-27T16:45:26.507579Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000500 "Climbing gait in which the forelimbs grasp a support as the hindlimbs are gathered underneath the body by flexion of the knee, hip, and spine; extension of the hindlimbs and back push the body upward.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000500 "bear climbing")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000500 "pulse climb"@en)
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000500 "shinny")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000500 "vertical bound")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasNarrowSynonym obo:ACTAN_0000500 "trunk climb")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000500 "shinny gait")
