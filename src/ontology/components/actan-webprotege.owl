# Class: obo:ACTAN_0000409 (participation interaction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000409 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000409 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000409 "2024-11-11T17:14:29.508889Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasDefinition obo:ACTAN_0000409 "Interaction which involves a communal association of animals frequenting a shared habitat.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000409 "community"@en)
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000409 "participating")
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2003.11.017") oboInOwl:hasExactSynonym obo:ACTAN_0000409 "participation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000409 "participation interaction"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.3354/esr01312") skos:scopeNote obo:ACTAN_0000409 "\"Some taxa—particularly snakes—often travel several kilometers from activity season ranges to return to the same hibernaculum each winter. Several high-latitude species also overwinter communally, resulting in large multi-species congregations in a hibernaculum.\"")
SubClassOf(obo:ACTAN_0000409 obo:ACTAN_0000383)
SubClassOf(obo:ACTAN_0000409 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000110))

# Class: obo:ACTAN_0000410 (indirect-sample participation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000410 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000410 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000410 "2024-11-11T17:14:48.75578Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3389/fetho.2023.1238167") Annotation(skos:scopeNote "\"Individuals can obtain information about various aspects of their environment either directly via direct sampling (personal information) or indirectly by acquiring inadvertent social information from others.\"") oboInOwl:hasDefinition obo:ACTAN_0000410 "Participation that obtains information about various aspects of the  environment by acquiring inadvertent social information from others.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1238167") Annotation(skos:scopeNote "\"...direct sampling (personal information) or indirectly... from others...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000410 "indirect sampling"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...animals assist each other in watching for enemies...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000410 "assisted watching")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000410 "indirect-sample participation"@en)
SubClassOf(obo:ACTAN_0000410 obo:ACTAN_0000409)
SubClassOf(obo:ACTAN_0000410 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000817))

