SubClassOf(obo:ACTAN_0000238 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000893))

# Class: obo:ACTAN_0000239 (landing regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000239 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000239 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000239 "2024-10-03T19:26:27.651321Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000239 "Interfacing-regime that follows a period of suspension, decelerates the body, absorbs the energy of impact, and is not part of a stride.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000239 "alighting")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000239 "landing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000239 "landing regime")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000239 "\"After alighting on land, wild geese usually shake, normally within 10 to 80 seconds in the case of White-fronted Geese.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:scopeNote obo:ACTAN_0000239 "\"In prehensile-tailed New World monkeys landing may be aided by tail grips.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:scopeNote obo:ACTAN_0000239 "\"Quadrupedal landing: Both forelimbs and hindlimbs decelerate the body by flexion, with only a slight difference between the time of contact of fore- and hindlimbs, usually the forelimbs contact first. Not followed by a suspensory bout.\"")
SubClassOf(obo:ACTAN_0000239 obo:ACTAN_0000086)
SubClassOf(obo:ACTAN_0000239 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000192))
SubClassOf(obo:ACTAN_0000239 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000860))
SubClassOf(obo:ACTAN_0000239 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000173))
SubClassOf(obo:ACTAN_0000239 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

# Class: obo:ACTAN_0000240 (scoot gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000240 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000240 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000240 "2024-10-03T19:26:43.310424Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"LI$. Scoot: The body is propelled by sliding while the ischia support a substantial proportion of the body weight; knee and thigh remain flexed while propelling the body.\"") oboInOwl:hasDefinition obo:ACTAN_0000240 "Traversing-gait in which the body is propelled while the ischia support a substantial proportion of the body weight.

Knee and thigh remain flexed while propelling the body.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000240 "scoot"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000240 "scoot gait")
SubClassOf(obo:ACTAN_0000240 obo:ACTAN_0000093)
SubClassOf(obo:ACTAN_0000240 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000104))
