AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1537/ase.107.141") Annotation(skos:scopeNote "\"Remove an object surreptitiously, without the owner's knowledge.\"") oboInOwl:hasDefinition obo:ACTAN_0000392 "Interference that removes an object surreptitiously, without the owner's knowledge.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000392 "stealing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000392 "stealing interference")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000392 obo:ACTAN_0000499)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000392 "\"Male bowerbirds construct bowers from interwoven sticks and decorate the fl oor of their courtship arena with all manner of colorful objects, each assembled into discrete piles with great precision, including berries, shells, and even human-made objects, like bottle caps or poker chips. Sometimes these ornamental objects are stolen by competing males, who even attempt to destroy the bowers of rivals.\"")
SubClassOf(obo:ACTAN_0000392 obo:ACTAN_0000388)
SubClassOf(obo:ACTAN_0000392 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000390))

# Class: obo:ACTAN_0000393 (eusociality colony)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000393 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000393 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000393 "2024-11-05T15:32:14.922432Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1371/journal.pone.0200048") oboInOwl:hasDefinition obo:ACTAN_0000393 "Colony that is superorganismal.")
AnnotationAssertion(Annotation(dc:date "2017"^^xsd:decimal) Annotation(dc:source "doi:10.1007/978-3-319-68576-2_3") oboInOwl:hasExactSynonym obo:ACTAN_0000393 "eusocial"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000393 "eusociality colony"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pone.0200048") skos:example obo:ACTAN_0000393 "\"The Eusocial bees use thermoregulation to ensure their survival and health; for instance, Apis mellifera larvae can only survive in an environment with slight temperature fluctuation (i.e., from 32 to 36˚C).\"")
SubClassOf(obo:ACTAN_0000393 obo:ACTAN_0000044)
SubClassOf(obo:ACTAN_0000393 ObjectSomeValuesFrom(obo:RO_0000086 obo:GSSO_007185))

# Class: obo:ACTAN_0000394 (dislodging relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000394 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000394 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000394 "2024-11-05T17:30:50.749783Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/s10164-009-0176-6") oboInOwl:hasDefinition obo:ACTAN_0000394 "Relativity in which an animal unattaches another.")
AnnotationAssertion(Annotation(dc:date "1969"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000394 "dislodging"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000394 "dislodging relativity")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:scopeNote obo:ACTAN_0000394 "\"In most species, females shake vigorously to dislodge the males and presumably the tight meshing of the male foreleg armature with the female wings help the males to remain mounted.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") skos:scopeNote obo:ACTAN_0000394 "\"In these organisms, terraces are functional in increasing friction between the exoskeleton and the substrate when a predator or a competitor tries to dislodge the crab from its shelter.\"")
SubClassOf(obo:ACTAN_0000394 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000394 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000693))

# Class: obo:ACTAN_0000395 (placing nontooling)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000395 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000395 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000395 "2024-11-10T20:42:46.001519Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/tops.12554") oboInOwl:hasDefinition obo:ACTAN_0000395 "Nontooling that places an object in a specific location.")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/tops.12554") Annotation(dc:source "2021"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000395 "placing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000395 "placing nontooling")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/tops.12554") skos:scopeNote obo:ACTAN_0000395 "This may include a/an absorbant, adornment, blockade (to prevent movement), camouflage, comfort, decor, prey detector, float (on self to increase buoyancy), hide (to hide something), landmark/directional marker, mark, other-bandage (on others' injuries), play, presser, protection, rest (to sit on it), scented application, self-bandage (on own injuries), self-hide (to hide in), shelter, sound modifier (to modify vocalizations), thermoregulator, threat (on self to ward off others), wedge.")
SubClassOf(obo:ACTAN_0000395 obo:ACTAN_0000287)
SubClassOf(obo:ACTAN_0000395 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000727))
SubClassOf(obo:ACTAN_0000395 ObjectSomeValuesFrom(obo:RO_0000057 obo:BFO_0000040))

# Class: obo:ACTAN_0000396 (hydraulics nontooling)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000396 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000396 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000396 "2024-11-10T20:43:01.407687Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/tops.12554") oboInOwl:hasDefinition obo:ACTAN_0000396 "Nontooling that uses a water current.")
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") oboInOwl:hasExactSynonym obo:ACTAN_0000396 "hydraulic pumping")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1111/tops.12554") oboInOwl:hasNarrowSynonym obo:ACTAN_0000396 "swim-flush"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000396 "waving")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000396 "hydraulics nontooling"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000396 "\"...the Centrarchids... nest-pit, which is dug by waving movements of the fish when it stands horizontally over the bottom...\"")
SubClassOf(obo:ACTAN_0000396 obo:ACTAN_0000287)
SubClassOf(obo:ACTAN_0000396 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000147))
SubClassOf(obo:ACTAN_0000396 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01001607))

# Class: obo:ACTAN_0000397 (routine pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000397 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000397 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000397 "2025-07-27T14:59:08.509847Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1177/10597123211040574") Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") oboInOwl:hasDefinition obo:ACTAN_0000397 "Pattern in which varying activity lists, constrained by abilities and available resources, can be used to achieve the same goal.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000397 "routine"@en)
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasNarrowSynonym obo:ACTAN_0000397 "habit")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") oboInOwl:hasNarrowSynonym obo:ACTAN_0000397 "maneuver")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1177/10597123211040574") oboInOwl:hasNarrowSynonym obo:ACTAN_0000397 "subroutine")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000397 "routine pattern"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.4000/ejpap.2324") skos:scopeNote obo:ACTAN_0000397 "\"As the agent accumulates experiences and ways of dealing with difficult situations, habits are formed. Habits are not permanently fixed, but change and are updated through the perception of new problematic situations and the action carried out by the agent. The agent can use those habits for similar situations in “schematically structured sequences of acts”.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/978-3-319-33774-6_5") skos:scopeNote obo:ACTAN_0000397 "\"It has been suggested that proactive animals may have an advantage in stable predictable environments, to develop routines and aggressively defend resources like food and shelter. In contrast, reactive animals may have an advantage in variable environments where fluctuations are non-predictable, and where resources in demand are difficult to monopolize.\"")
SubClassOf(obo:ACTAN_0000397 obo:ACTAN_0000017)
SubClassOf(obo:ACTAN_0000397 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001303))

# Class: obo:ACTAN_0000398 (individual membership)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000398 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000398 "2024-11-11T09:15:26.974059Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000398 "Membership that involves a group of one.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000398 "individual")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000398 "individualistic")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000398 "isolated")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000398 "solitary")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000398 "individual membership")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:example obo:ACTAN_0000398 "\"As solitary foragers, snakes are typically considered asocial.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000398 "\"Badis badis is throughout its life an essentially non-aggregating species. The post-larvae seem to be entirely solitary.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2022.1066186") skos:scopeNote obo:ACTAN_0000398 "\"Even in species in which individuals spend most of their lives solitary (e.g., orb weaving spiders), individuals still have to mate, and occasionally have to interact with others in ways that affect social proximity (e.g., territoriality).\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:scopeNote obo:ACTAN_0000398 "\"They exhibit individualistic behavior, typified by more forceful movements and a distinctive manner...\"")
SubClassOf(obo:ACTAN_0000398 obo:ACTAN_0000108)

# Class: obo:ACTAN_0000399 (inspection cognition)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000399 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000399 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000399 "2024-11-11T09:15:44.621907Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3389/fetho.2023.1238167") Annotation(skos:scopeNote "\"Individuals can obtain information about various aspects of their environment either directly via direct sampling (personal information) or indirectly by acquiring inadvertent social information from others.\"") oboInOwl:hasDefinition obo:ACTAN_0000399 "Cognition that personally obtains information about various aspects of the environment.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1238167") oboInOwl:hasExactSynonym obo:ACTAN_0000399 "direct-sampling"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000399 "inspection")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000399 "inspection cognition"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000399 "\"Chimpanzee...
One finger , usually index finger, is carefully smelled after being used to investigate some object. The most usual context is during inspection of the genital area... of a female.\"")
AnnotationAssertion(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") skos:example obo:ACTAN_0000399 "\"Goatfishes... horizontal position of the body above the substrate while locating food also appears advantageous as a method of hunting over wide areas with occasional sampling of the bottom for food.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000399 "NBO:0000455")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2011.0690") skos:scopeNote obo:ACTAN_0000399 "\"...fish collect information from observed interactions between third parties and that they respond differentially to individuals that they have observed winning/losing a previous interaction.\"")
SubClassOf(obo:ACTAN_0000399 obo:ACTAN_0000270)
SubClassOf(obo:ACTAN_0000399 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MF_0000018))
SubClassOf(obo:ACTAN_0000399 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000398))

# Class: obo:ACTAN_0000400 (predator inspection)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000400 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000400 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000400 "2024-11-11T09:17:14.599417Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Predator inspection: An exploratory/boldness-related risk-taking behavior in fish associated with either increased or decreased tendency to approach a predator, potentially to gather information about the identity, precise location and/or current motivational state of the predator.\"") oboInOwl:hasDefinition obo:ACTAN_0000400 "Inspection that involves approaching to gather information about the identity, precise location, and current motivational state of a potential predator.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasRelatedSynonym obo:ACTAN_0000400 "probing")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1238167") rdfs:label obo:ACTAN_0000400 "predator inspection"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000400 "NBO:0020223")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000400 "\"Adult ground squirrels (Spermophilus beecheyi), which have some immunity to the bite of northern Pacific rattlesnakes (Crotalus viridis), have been known to kill rattlesnakes and even engage in probing behavior to elicit a snake to rattle apparently because this provides information about the relative danger of an individual snake.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1238167") skos:example obo:ACTAN_0000400 "\"Trinidadian guppies engage in increased predator inspection behaviour (i.e. information gathering) in sites along rivers disturbed by human recreation relative to undisturbed sites.\"")
SubClassOf(obo:ACTAN_0000400 obo:ACTAN_0000399)
SubClassOf(obo:ACTAN_0000400 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000326))
SubClassOf(obo:ACTAN_0000400 ObjectSomeValuesFrom(obo:RO_0000057 obo:ECOCORE_00000089))

# Class: obo:ACTAN_0000401 (sucker gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000401 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000401 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000401 "2026-07-20T16:21:03.25417Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000401 "Creeping gait in which a fish alternately releases and adheres its anterior sucker, in conjunction with the inward and outward swing of its caudal region respectively.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...suctorial disc ... movements of these discs...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000401 "suctorial movement")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000401 "sucker gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac061") skos:example obo:ACTAN_0000401 "\"...in the waterfall climbing gobies... the oral sucker and pelvic fins drive waterfall climbing...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000401 "\"Astroblepus longifilis inhabiting mountain torrents is able to hold tightly fast to smooth surfaces by use of its suctorial mouth, both under water and out of it.. The method of progressing overland as seen by the author is essentially a fish-like flapping coupled with an appropriate action of the mouth, it holding fast on the flexure of the caudal portion, and releasing on the extension.\"")
SubClassOf(obo:ACTAN_0000401 obo:ACTAN_0000225)
SubClassOf(obo:ACTAN_0000401 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000496))
SubClassOf(obo:ACTAN_0000401 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000590))
SubClassOf(obo:ACTAN_0000401 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000052))
SubClassOf(obo:ACTAN_0000401 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000241))

# Class: obo:ACTAN_0000402 (occupancy residence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000402 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000402 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000402 "2024-11-11T09:18:09.469196Z")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") oboInOwl:hasBroadSynonym obo:ACTAN_0000402 "inhabiting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") oboInOwl:hasDefinition obo:ACTAN_0000402 "Residence in which an animal inhabits a constrained space, depending on habitat limitations and density-regulating behaviour.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") oboInOwl:hasExactSynonym obo:ACTAN_0000402 "occupancy")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...pre-occupation has probably played an important part in checking the commingling of species...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000402 "occupation"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000402 "occupancy residence"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000402 obo:ACTAN_0000415)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000402 "\"Snail shells are in short supply and hermit crabs compete for this limited resource. The crabs often occupy shells that appear less than optimum in shape or size.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/978-3-319-68576-2_3") skos:scopeNote obo:ACTAN_0000402 "\"Many of the more generalizable definitions of habitat offer some reference to occupancy or  resources that promote occupancy. Of these, Morrison et al.’s is among the more precise and generalizable, calling habitat an “area with a combination of resources and environmental conditions that promotes occupancy by individuals of a given species that allows individuals to survive and reproduce.”\"")
AnnotationAssertion(Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") skos:scopeNote obo:ACTAN_0000402 "\"The number of B. amplus associated with each colony of J. juncea and D. gemmacea, was termed occupation density.\"")
SubClassOf(obo:ACTAN_0000402 obo:ACTAN_0000308)
SubClassOf(obo:ACTAN_0000402 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001019))

# Class: obo:ACTAN_0000403 (emersion regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000403 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000403 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000403 "2026-07-21T08:06:51.704708Z")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000403 "aerial excursion")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"The leaping of fishes may be considered simply as a rapid swimming up through the surface of the water, momentum alone carrying the fish forward after the tail has left the water entirely.\"") oboInOwl:hasDefinition obo:ACTAN_0000403 "Interfacing-regime that involves a rapid swimming up through the surface of the water, momentum alone carrying the animal forward after it has left the water entirely.")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.198.1.79") Annotation(skos:scopeNote "\"...emersing up to 7.2 % of volume...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000403 "emersing percent")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000403 "leaping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000403 "emersion regime"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000403 "\"If the body is held rigidly in a straight line the path will be straight, barring external factors. Mugil usually leaps in this manner. If the body is flexed, the fish follows the curve and falls to the concave side. Salmo and Tarpon usually show this. The final stroke before leaving the water is often of great amplitude in these fishes and sends them upward in a great curving path.\"")
SubClassOf(obo:ACTAN_0000403 obo:ACTAN_0000086)
SubClassOf(obo:ACTAN_0000403 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000003))
SubClassOf(obo:ACTAN_0000403 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000173))
SubClassOf(obo:ACTAN_0000403 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000182))
SubClassOf(obo:ACTAN_0000403 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000183))
SubClassOf(obo:ACTAN_0000403 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

# Class: obo:ACTAN_0000404 (role cooperation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000404 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000404 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000404 "2024-11-11T09:20:09.341529Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000404 "Cooperation in which charge of a particular, mutually beneficial, behaviour is assumed.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000404 "on duty")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000404 "role"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000404 "role cooperation")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000404 "\"Until the beginning of the spawning it is the male that usually behaves more aggressively, but as soon as the female has laid some eggs. the roles change, particularly in the centre of the territory. Thereafter the female often drives away the male with butting and tail-beating. The male is then chiefly in charge of defending the periphery of the territory. We observed this especially frequently in C. meeki.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2022.1066186") skos:scopeNote obo:ACTAN_0000404 "\"More work is needed that integrates assessments of social contextual factors like density and variation in social roles with assessments of individual behavior to increase our understanding of behavioral variation across populations and across generations.\"")
SubClassOf(obo:ACTAN_0000404 obo:ACTAN_0000463)
SubClassOf(obo:ACTAN_0000404 ObjectSomeValuesFrom(obo:BFO_0000055 obo:BFO_0000023))

# Class: obo:ACTAN_0000405 (mill formation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000405 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000405 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000405 "2025-04-15T15:12:32.633746Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pcbi.1002915") Annotation(skos:scopeNote "\"...a milling state in which individuals have a high degree of alignment with local neighbors but overall the group exhibits a rotating milling formation (or torus, in three dimensional space)...\"") oboInOwl:hasDefinition obo:ACTAN_0000405 "Formation in which individuals have a high degree of alignment with local neighbors but overall the group exhibits a rotating motion.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1371/journal.pcbi.1002915") oboInOwl:hasExactSynonym obo:ACTAN_0000405 "milling"@en)
AnnotationAssertion(Annotation(dc:date "1983"^^xsd:decimal) Annotation(dc:source "doi:10.3354/meps011165") Annotation(rdfs:comment "'Swarming' has a specific meaning in this ontology, which differs from the synonymous meaning here.") oboInOwl:hasRelatedSynonym obo:ACTAN_0000405 "swarming")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000405 "mill formation")
SubClassOf(obo:ACTAN_0000405 obo:ACTAN_0000047)
SubClassOf(obo:ACTAN_0000405 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001653))
SubClassOf(obo:ACTAN_0000405 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001904))

# Class: obo:ACTAN_0000406 (polarization formation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000406 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000406 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000406 "2025-04-15T15:12:52.137281Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1371/journal.pcbi.1002915") Annotation(skos:scopeNote "\"...a polarized state in which individuals tend to be aligned with each other over a long range and consequently the group experiences net movement.\"") oboInOwl:hasDefinition obo:ACTAN_0000406 "Formation in which individuals tend to be aligned with each other over a long range and consequently the group experiences net movement.

The rotation order parameter remains low.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000406 "polarization"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000406 "polarization formation")
