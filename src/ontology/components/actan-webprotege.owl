# Class: obo:ACTAN_0000679 (chafe routine)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000679 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000679 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000679 "2025-05-04T15:38:17.764123Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000679 "Counter-irritant routine that scrapes a body part across an unyielding external object.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000679 "chafing"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000679 "grating")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000679 "chafe routine"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.4236/ojas.2019.91008") skos:example obo:ACTAN_0000679 "\"...irritation can lead to rather extreme reactions by the shark, such as... chafing the irritated body part on the bottom...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000679 "\"Less frequently a fish chafes in its usual upright position, with the ventral side over the substrate. Once we saw this in a female Tilapia natalensis carrying young in its mouth. Probably the movements of the young, trying to escape, irritated the fish.\"")
SubClassOf(obo:ACTAN_0000679 obo:ACTAN_0000103)
SubClassOf(obo:ACTAN_0000679 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000786))
SubClassOf(obo:ACTAN_0000679 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01000814))

# Class: obo:ACTAN_0000680 (spit expulsion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000680 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000680 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000680 "2025-05-04T20:03:16.681903Z")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000680 "squirting")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(skos:scopeNote "\"Apparently a counter-current of water is flushed through the buccal cavity.\"") oboInOwl:hasDefinition obo:ACTAN_0000680 "Expulsion in which a counter-current of water is flushed through the buccal cavity.")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") oboInOwl:hasExactSynonym obo:ACTAN_0000680 "expelling water")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000680 "spit")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000680 "spitting")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000680 "spitting-out")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000680 "blowing")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000680 "coughing")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000680 "flushing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000680 "spit expulsion")
AnnotationAssertion(Annotation(dc:source "doi:10.5343/bms.2014.1055") skos:example obo:ACTAN_0000680 "\"After mating, T. albomaculosus... males stayed there to care for the eggs... The frequencies of parental care behaviors (in bouts per 10 min) were... 0.66 (sucking and spitting)...\"")
AnnotationAssertion(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") skos:example obo:ACTAN_0000680 "\"Mulloides fiavolineatus... may back off from an item discovered by the barbels and \"blow\" away sand to uncover it (pers. obs.);\"")
AnnotationAssertion(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") skos:example obo:ACTAN_0000680 "\"Mullus surmuletus on occasion ploughs up the mud with its snout in feeding and apparently expels water from its mouth while doing so.\"")
SubClassOf(obo:ACTAN_0000680 obo:ACTAN_0000715)
SubClassOf(obo:ACTAN_0000680 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000167))

# Class: obo:ACTAN_0000681 (seize catch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000681 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000681 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000681 "2025-05-06T08:54:46.577264Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasDefinition obo:ACTAN_0000681 "Catch that is firm and sudden.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000681 "grabbing")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000681 "seizing"@en)
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasNarrowSynonym obo:ACTAN_0000681 "picking")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000681 "picking up")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000681 "snatching")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000681 "seize catch"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF01609520") skos:example obo:ACTAN_0000681 "\"Lut]anus griseus, a carnivore which seizes invertebrates and fishes;\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000681 "\"Now I was curious to ascertain whether F. sanguinea could distinguish the pupæ of F. fusca, which they habitually make into slaves, from those of the little and furious F. flava, which they rarely capture, and it was evident that they did at once distinguish them: for we have seen that they eagerly and instantly seized the pupæ of F. fusca, whereas they were much terrified when they came across the pupæ, or even the earth from the nest of F. flava, and quickly ran away; but in about a quarter of an hour, shortly after all the little yellow ants had crawled away, they took heart and carried off the pupæ.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:scopeNote obo:ACTAN_0000681 "\"He either rooted with his snout or seized a pebble with his jaws, lifted his head and swam forward with tail quivering.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") skos:scopeNote obo:ACTAN_0000681 "\"The details of genital contact in cockroaches are comparatively well known. In Periplaneta americana, the hook on the left phallomere initially seizes the female (on which side is apparently unknown), while the right phallomere is used to hold the female once the end-to-end position is adopted.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:scopeNote obo:ACTAN_0000681 "\"When one individual roughly seizes another with one or both hands.\"")
SubClassOf(obo:ACTAN_0000681 obo:ACTAN_0000907)
SubClassOf(obo:ACTAN_0000681 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000683))

# Class: obo:ACTAN_0000682 (ingestion feed)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000682 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000682 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000682 "2025-05-06T11:46:39.905516Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "ISBN:9780226315737") Annotation(skos:scopeNote "\"Thus, more than one prey item is typically engulfed during each feeding bout, and some degree of nonselectivity is implied.\"") oboInOwl:hasDefinition obo:ACTAN_0000682 "Feed that engulfs food.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000682 "devouring")
AnnotationAssertion(Annotation(dc:date "1983"^^xsd:decimal) Annotation(dc:source "doi:10.3354/meps011089") oboInOwl:hasExactSynonym obo:ACTAN_0000682 "ingestion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000682 "ingestion feed")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000682 "\"Badis badis...
Suddenly it darts forward with folded fins in a single snap of the trunk, and engulfs the Daphnia. The prey is chewed a few times, apparently by the pharyngeal teeth, before swallowing.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:scopeNote obo:ACTAN_0000682 "\"Continuous Suction Feeders...
No forward body movement, uses suction to engulf prey.\"")
SubClassOf(obo:ACTAN_0000682 obo:ACTAN_0000348)
SubClassOf(obo:ACTAN_0000682 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000868))
SubClassOf(obo:ACTAN_0000682 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0001007))

# Class: obo:ACTAN_0000683 (power grip)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000683 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000683 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000683 "2025-05-06T15:59:49.286088Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/brv.12010") oboInOwl:hasDefinition obo:ACTAN_0000683 "Grip that clamps an object sufficiently to resist it slipping.")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00426-009-0242-2") oboInOwl:hasExactSynonym obo:ACTAN_0000683 "power grasp"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasRelatedSynonym obo:ACTAN_0000683 "clamp")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ajpa.1330870108") Annotation(rdfs:comment "1992"^^xsd:decimal) rdfs:label obo:ACTAN_0000683 "power grip")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:example obo:ACTAN_0000683 "\"...the males of most sepsid species use the forelegs for clamping onto the base of the females’ wings during mounting.\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000683 "\"The male then steps onto his mate's back, grasps the humerous region of each wing in his feet, begins to perform rhythmic treading movements which gradually accelerate, then lowers his tail to achieve cloacal contact and simultaneously begins to flap in order to retain balance. In 16% of 25 copulations the male grasped the female's nape in his beak.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icaa017") skos:scopeNote obo:ACTAN_0000683 "\"If the weight of the snake is not balanced when moving on shallow cylindrical surfaces, the snake will topple sideways. Actively gripping cylindrical surfaces reduces both of these problems. However, some snakes actually take advantage of the forces from their weight by using it as a propulsive mechanism for moving down steep surfaces while holding a static posture and exerting a slight grip to control the speed of sliding.\"")
SubClassOf(obo:ACTAN_0000683 obo:ACTAN_0000628)
SubClassOf(obo:ACTAN_0000683 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002245))

# Class: obo:ACTAN_0000684 (bank turning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000684 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000684 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000684 "2026-07-27T18:41:58.706354Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1016/j.jembe.2011.03.010") Annotation(skos:scopeNote "\"Movement of the paired pectoral fins of rays can aid in the generation of a centripetal force to bank the body and reduce slip. Banking is a rolling maneuver that provides a greater projected area. By banking through the turn, the body and fins would be canted at an angle to the incident water flow (i.e., angle of attack).\"") oboInOwl:hasDefinition obo:ACTAN_0000684 "Turning in which rolling through the turn, the body and fins canted at an angle to the incident water flow, can aid in the generation of a centripetal force to reduce slip.")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.jembe.2011.03.010") oboInOwl:hasExactSynonym obo:ACTAN_0000684 "bank the body")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icy121") oboInOwl:hasExactSynonym obo:ACTAN_0000684 "banked turn")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icy121") oboInOwl:hasExactSynonym obo:ACTAN_0000684 "banking maneuver")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icy121") oboInOwl:hasNarrowSynonym obo:ACTAN_0000684 "inward bank")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icy121") Annotation(skos:scopeNote "\"...outward banked...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000684 "outward bank")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.jembe.2011.03.010") Annotation(skos:scopeNote "\"...banking while turning...\"") rdfs:label obo:ACTAN_0000684 "bank turning"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icy121") skos:example obo:ACTAN_0000684 "\"...blue whales take advantage of their dorsal flexibility to perform turns by banking... up to 90° inward to perform fast turns and their turning speed is strongly correlated with bank angle.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.jembe.2011.03.010") skos:example obo:ACTAN_0000684 "\"The rays that were observed swam by oscillatory movements of the pectoral fins (Aetobatus narinari, Myliobatis freminvillii and Rhinoptera bonasus) or by undulations of the fins (Dasyatis americana and Dasyatis centroura). Oscillatory rays maneuvered by either powered or unpowered gliding turns, whereas undulatory rays turned using asymmetrical undulations of both pectoral fins. Underwater observations showed that both rays used banking while turning, where bank angle ranged from 15–70°.\"")
SubClassOf(obo:ACTAN_0000684 obo:ACTAN_0000174)
SubClassOf(obo:ACTAN_0000684 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000653))

# Class: obo:ACTAN_0000685 (rolling rotating)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000685 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000685 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000685 "2025-05-07T07:18:48.718523Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "ISBN:9780226315737") Annotation(dc:source "doi:10.1111/jfb.12866") Annotation(skos:scopeNote "\"Side-to-side rolling motions and pitching over onto the back are common body motions observed during feeding in rorqual whales.\" (ISBN:9780226315737)") Annotation(skos:scopeNote "\"Typically, fish that exhibited this behaviour would repeatedly swim on their sides before recovering to their normal upright swimming position.\" (doi:10.1111/jfb.12866)") oboInOwl:hasDefinition obo:ACTAN_0000685 "Rotating that manoeuvres from side to side, and from upright to upside down.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000685 "roll")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000685 "rolling"@en)
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "doi:10.1093/auk/123.4.967") oboInOwl:hasExactSynonym obo:ACTAN_0000685 "side-to-side")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000685 "capsizing")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000685 "corkscrewing")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000685 "spiraling")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000685 "whirling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000685 "rolling rotating")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000685 "\"In the more complex method of grasping a worm the fish rolls over onto one side, simultaneously forming an S-shape ; the head points down at the worm, and the dorsal fin is usually spread as much as the body curvature allows. After briefly fixing on the prey the Badis badis lunges and seizes the worm.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000685 "\"Large sturgeon when swimming slowly, especially when starting off, have a noticeable roll...\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000685 "\"Much commoner are the oil-distributing movements in which head and neck are vigorously rubbed and rolled over the back and area around the humerus.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.conb.2018.06.004") skos:scopeNote obo:ACTAN_0000685 "\"Larval zebrafish can actively rotate their bodies by selective contractions of the dorsal (epaxial) and ventral (hypaxial) trunk musculature. Differential contraction of the dorsal and ventral muscles on the right and left sides of the body subserves roll\"")
SubClassOf(obo:ACTAN_0000685 obo:ACTAN_0000013)
SubClassOf(obo:ACTAN_0000685 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000653))

# Class: obo:ACTAN_0000686 (rotation placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000686 <https://github.com/Active-Animals/Ontology/patterns/placement_by_manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000686 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000686 "2025-05-07T18:38:42.859709Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000686 "Rotation that yawing culminates in.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000686 "rotated"@en)
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.158.1.369") oboInOwl:hasExactSynonym obo:ACTAN_0000686 "rotation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000686 "rotation placement")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") skos:example obo:ACTAN_0000686 "\"Rotation of the phallus in Lygaeus does not simply result from rotation of the abdomen but from the expansion of a membranous portion of the phallus. These membranes are spirally folded so that their expansion rotates the phallus.\"")
SubClassOf(obo:ACTAN_0000686 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000686 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000013))

# Class: obo:ACTAN_0000687 (yaw rotation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000687 <https://github.com/Active-Animals/Ontology/patterns/placement_by_manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000687 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000687 "2025-05-07T18:39:01.820614Z")
AnnotationAssertion(Annotation(rdfs:comment "Directly inferred..") oboInOwl:hasDefinition obo:ACTAN_0000687 "Rotation that yawing culminates in.")
AnnotationAssertion(Annotation(dc:date "2007"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") oboInOwl:hasExactSynonym obo:ACTAN_0000687 "sideward"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000687 "yaw rotation")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/20.1.255") skos:scopeNote obo:ACTAN_0000687 "\"...lateral sequence facilitates undulation of the spine, which rotates the girdles and lengthens the step...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") skos:scopeNote obo:ACTAN_0000687 "\"In Ectopsocus briggsi, this sideward turning of the male was interpreted to occur after copulation, as a process that actually terminates copulation.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:scopeNote obo:ACTAN_0000687 "\"Positive defense consists of spreading the fins. This may be accompanied by rotating the body slightly, presenting the erect dorsal fin spines to the object eliciting the behavior.\"")
SubClassOf(obo:ACTAN_0000687 obo:ACTAN_0000686)
SubClassOf(obo:ACTAN_0000687 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000168))

# Class: obo:ACTAN_0000688 (upside-down roll)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000688 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000688 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000688 "2025-05-07T18:39:29.855996Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(dc:source "doi:10.1111/eff.12212") Annotation(skos:scopeNote "\"(i.e., the body inclination... decreases with the gravity).\" (doi:10.1089/zeb.2012.0861)") Annotation(skos:scopeNote "\"Then, the fish turns in a normal position (dorsal fin facing the surface) and after a very short period (up to 1 s) the fish turns upside down again, repeating this pattern up to 3 or 4 times.\" (doi:10.1111/eff.12212)") oboInOwl:hasDefinition obo:ACTAN_0000688 "Roll that inverts the normal inclination relative to gravity.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000688 "upside-down"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000688 "upside-down roll"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000688 "\"Aequidens latifrons...
When it has come down the larva lies on its back, under the yolk mass.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:example obo:ACTAN_0000688 "\"The hanging parakeets (Loriculus) sleep hanging upsided own, and the related Agapornis pullaria also sometimes sleep in this position.\"")
SubClassOf(obo:ACTAN_0000688 obo:ACTAN_0000690)
SubClassOf(obo:ACTAN_0000688 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000625))
SubClassOf(obo:ACTAN_0000688 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001653))

# Class: obo:ACTAN_0000689 (pitch tilt)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000689 <https://github.com/Active-Animals/Ontology/patterns/placement_by_manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000689 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000689 "2025-05-07T18:41:20.234141Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000689 "Tilt that results from pitching.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000689 "pitching"@en)
AnnotationAssertion(Annotation(dc:date "2018"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.conb.2018.06.004") oboInOwl:hasExactSynonym obo:ACTAN_0000689 "tipped")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000689 "standing vertically, head downward")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1093/iob/obz025") oboInOwl:hasNarrowSynonym obo:ACTAN_0000689 "trim")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000689 "up-ending"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000689 "pitch tilt")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000689 "\"\"Neck-dipping\" is the main pre-copulatory movement of both male and female... In Anser... the birds may also up-end as in feeding or in bringing up food for the young;\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000689 "\"Aeoliscus strigatus (Gunther) and other members of this group swim with the axis practically vertical for most part although they may assume any other position.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/iob/obz025") skos:scopeNote obo:ACTAN_0000689 "\"Despite the advantages of maintaining horizontal trim for typical fishes, various fishes can swim or float with different orientations.\"")
SubClassOf(obo:ACTAN_0000689 obo:ACTAN_0000563)
SubClassOf(obo:ACTAN_0000689 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000692))

# Class: obo:ACTAN_0000690 (roll tilt)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000690 <https://github.com/Active-Animals/Ontology/patterns/placement_by_manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000690 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000690 "2025-05-07T18:41:28.744573Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(skos:scopeNote "\"In the more complex method of grasping a worm the fish rolls over onto one side, simultaneously forming an S-shape ;\"") oboInOwl:hasDefinition obo:ACTAN_0000690 "Tilt that is to one side.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000690 "rolled"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000690 "roll tilt")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000690 "\"Nocomis leptocephalus...
During alignment the male tilted the dorsal half of his body to one side as the female’s snout moved beneath his pectoral region. The female’s movement into the pit determined the direction of his sagittal tilt.\"")
SubClassOf(obo:ACTAN_0000690 obo:ACTAN_0000563)
SubClassOf(obo:ACTAN_0000690 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000685))

# Class: obo:ACTAN_0000691 (on-its-side roll)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000691 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000691 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000691 "2025-05-07T18:42:47.822511Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "This definition is the implied extreme version of its parent.") oboInOwl:hasDefinition obo:ACTAN_0000691 "Roll that is perpendicular to its normal inclination.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000691 "on a side")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000691 "on its side")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000691 "on the side"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000691 "on-its-side roll")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000691 "\"If the prey is imbedded in the substrate the fish may lay on its side and use leverage to pull it loose.\"")
SubClassOf(obo:ACTAN_0000691 obo:ACTAN_0000690)
SubClassOf(obo:ACTAN_0000691 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002497))

# Class: obo:ACTAN_0000692 (pitching rotating)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000692 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000692 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000692 "2025-05-07T20:14:36.932156Z")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasBroadSynonym obo:ACTAN_0000692 "tipping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/j.conb.2018.06.004") oboInOwl:hasDefinition obo:ACTAN_0000692 "Rotating which manoeuvres an animal forwards and backwards around its centre of gravity.")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") Annotation(skos:scopeNote "\"...pitched forward...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000692 "pitching"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000692 "somersault")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasRelatedSynonym obo:ACTAN_0000692 "end over end")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000692 "head over heels")
AnnotationAssertion(Annotation(dc:date "2018"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.conb.2018.06.004") oboInOwl:hasRelatedSynonym obo:ACTAN_0000692 "headfirst")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000692 "tip up")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasRelatedSynonym obo:ACTAN_0000692 "tippy")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...“trip it up”...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000692 "trip up")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000692 "tumbling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000692 "pitching rotating")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000692 "\"As the female moved forward over the upstream rim of the pit, she gaped and abruptly tossed her head vertically into the water column. She began her upward pitch with body upright and the ventral surface of her caudal peduncle still pressed to the substrate.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:example obo:ACTAN_0000692 "\"The horizontal fluke of the whale may be brought into play to further control forward pitch or even to extend the head and back. Side-to-side rolling motions and pitching over onto the back are common body motions observed during feeding in rorqual whales.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.conb.2018.06.004") skos:scopeNote obo:ACTAN_0000692 "\"...contraction of dorsal or ventral muscles on the left and right sides in concert serves to rotate fish in the pitch axis...\"")
SubClassOf(obo:ACTAN_0000692 obo:ACTAN_0000013)
SubClassOf(obo:ACTAN_0000692 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000652))

# Class: obo:ACTAN_0000693 (leverage kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000693 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000693 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000693 "2025-05-11T14:04:52.776228Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000693 "Kinetics that moves an object one way by exerting a counteracting force the opposite way.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000693 "leverage"@en)
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasExactSynonym obo:ACTAN_0000693 "prying")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000693 "leverage kinetics"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:example obo:ACTAN_0000693 "\"A prying movement (sometimes called gaping or \"Zirkeln\") occurs in at least eight passefine families. The birds stick their bills into the ground, a soft substance, or a crack, and then open them with considerable force.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000693 "\"By lying on one side the fish is able to use its body as a lever. The head is raised, pulling the worm free, while a counteracting force is exerted downward by swimming movements of the tail.\"")
SubClassOf(obo:ACTAN_0000693 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000693 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001029))

# Class: obo:ACTAN_0000694 (prying tooling)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000694 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000694 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000694 "2025-05-11T14:26:49.213544Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/tops.12554") Annotation(rdfs:comment "This is a simple source subdivision.") oboInOwl:hasDefinition obo:ACTAN_0000694 "Tooling that prys with an object.

This may be to access, autogroom, enlarge, press, or remove.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1111/tops.12554") oboInOwl:hasExactSynonym obo:ACTAN_0000694 "pry with an object"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000694 "prying tooling")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") skos:example obo:ACTAN_0000694 "\"The key idea is that in the most familiar examples of tool use (e.g. pounding with a stone, probing with a twig, transporting liquid with a leaf sponge, levering with a sturdy stick) an effect is generated by the dynamic mechanical interaction between the manipulated tool and other objects or organisms in the environment.\"")
SubClassOf(obo:ACTAN_0000694 obo:ACTAN_0000286)
SubClassOf(obo:ACTAN_0000694 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000693))
SubClassOf(obo:ACTAN_0000694 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01000814))

# Class: obo:ACTAN_0000695 (press kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000695 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000695 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000695 "2025-05-12T06:28:28.254427Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasDefinition obo:ACTAN_0000695 "Kinetics that exerts a sustained contact force away from the subject.

It may be countered by a pulling force from the same subject.")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") Annotation(rdfs:comment "2000"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000695 "driving")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000695 "pressing")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000695 "push")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000695 "pushing"@en)
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasNarrowSynonym obo:ACTAN_0000695 "shove")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000695 "ejecting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000695 "press kinetics")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000695 obo:ACTAN_0000163)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000695 obo:ACTAN_0000233)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000695 "\"...the young cuckoo ejecting its foster-brothers...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000695 "\"Hemichromis bimaculatus...
The male butts the female vigorously in the flank, the female tries to dodge but is pushed back.\"")
SubClassOf(obo:ACTAN_0000695 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000695 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001576))

# Class: obo:ACTAN_0000696 (pull kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000696 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000696 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000696 "2025-05-12T06:28:37.076084Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000696 "Kinetics that exerts a contact force towards the subject.

It may be countered by a pushing force from the same subject.")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000696 "pull")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000696 "pulling"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000696 "tug")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000696 "dragging")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000696 "tearing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000696 "pull kinetics")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000696 obo:ACTAN_0000736)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") skos:example obo:ACTAN_0000696 "\"In Tephritidae, disengagement of the coupling occurs as the male dismounts and moves away end-to-end, pulling the phallus from the female aculeus.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000696 "\"It was really curious to note in cases of difficulty, as when two pieces of comb met at an angle, how often the bees would entirely pull down and rebuild in different ways the same cell, sometimes recurring to a shape which they had at first rejected.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000696 "\"The chelae are often not lifted completely free from the substrate during retraction; consequently, they will leave a gouged-out groove in the centre of the crab track as they are dragged along the sand.\"")
SubClassOf(obo:ACTAN_0000696 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000696 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002284))

# Class: obo:ACTAN_0000697 (scrape graze)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000697 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000697 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000697 "2026-07-28T11:06:59.935181Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF00751035") Annotation(skos:scopeNote "\"The term scrapers implies a non-excavating bite which is restricted to removal of material from the surface of the substratum.\"") oboInOwl:hasDefinition obo:ACTAN_0000697 "Graze in which a bite is restricted to removal of material from the surface of the substratum.")
AnnotationAssertion(Annotation(dc:date "1990"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF00751035") oboInOwl:hasExactSynonym obo:ACTAN_0000697 "scraping")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1111/1365-2435.13457") oboInOwl:hasRelatedSynonym obo:ACTAN_0000697 "gouging")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000697 "scrape graze"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF00751035") skos:example obo:ACTAN_0000697 "\"The scrapers... functional group encompasses... Scarus... altipinnis, S. chameleon, S. dimidiatus, S. flavipectoralis... and Hipposcarus longiceps.\"")
SubClassOf(obo:ACTAN_0000697 obo:ACTAN_0000355)
SubClassOf(obo:ACTAN_0000697 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000786))

# Class: obo:ACTAN_0000698 (motivation-initiator)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000698 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000698 "2025-05-12T18:51:13.54063Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1177/10597123211040574") Annotation(skos:scopeNote "\"These kinds of categorisation are varied in their approach, the most common of which is the enumeration of types of initiators of behaviour through various constructs, the most prominent three of which bear the names of ‘instincts’, ‘drives’ and ‘needs’. These are the initial causal factors that motivate behaviour and are directed towards some goal object, and we will briefly review each of these constructs in turn.\"") oboInOwl:hasDefinition obo:ACTAN_0000698 "Behavioural disposition that is realized when a constructed initial causal factor for behaviour is directed towards some goal object.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000698 "motivation"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000698 "motivation-initiator"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000698 obo:ACTAN_0000706)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000698 obo:ACTAN_0000707)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000698 obo:ACTAN_0000838)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12891") skos:example obo:ACTAN_0000698 "\"...deimatic behaviour... will cease upon the perceived threat passing, such as when the attacker leaves the scene or obviously changes its motivation (e.g. from a focused attack to ignoring, or if the prey escapes the predator).\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000698 "\"Aggregating between two gravid females is clear cut. The females, though, must be deprived of contact with a male. Such females will then spend most of their time together, only separating occasionally. Infrequently they may fight, but this almost never proceeds beyond initial displays. Two not sexually motivated, on the other hand, will enter into well developed fights. Thus the aggregating of two gravid, male-deprived females probably results from substituting one another for a female and is made possible through the suppression of fighting behavior.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00265-019-2778-5") skos:example obo:ACTAN_0000698 "\"The reason behind a prey hissing, however, may have nothing to do with mimicry of a specific type of predator (e.g., snakes in this study) that hiss. It may simply reflect the production and reaction to a sound that is widely used in fearful or adversarial situations. If so, this would resonate with theories of shared emotional systems across bird and mammal species, as described for emotional vocalizations in Morton’s motivation-structural rules.\"")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") skos:scopeNote obo:ACTAN_0000698 "\"...a pair bond must be more than transactional in nature and must include at least some affective component (e.g., motivation, arousal, aversion, attraction).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1177/10597123211040574") skos:scopeNote obo:ACTAN_0000698 "\"Most of these terms have not disappeared from usage completely, although as psychology decreased its focus on behaviour and increased its focus on cognition, the field of motivation has become ever more unfashionable...

...there are several common ways to split these constructs further... The first is the concept of primary (inherited, innate) and secondary (or acquired, derived, learned) motivations. Although informative in many species, what is innate in one species may be learned in another, and this distinction is further blurred by processes such as imprinting and tendencies to learn particular things. Related divisions have been made between viscerogenic/biogenic (from the body) and psychogenic (from the mind), biological and social behaviours, and intrinsic and extrinsic motivation; all having a similar vagueness about them. Behaviour is also sometimes divided up by how it is controlled, between simple reflexes, learned habits, and deliberative goal-directed behaviour, however, even within the same individual, the same behaviour can be controlled by different levels during different times and situations...\"")
SubClassOf(obo:ACTAN_0000698 <http://humanbehaviourchange.org/ontology/BCIO_050416>)

# Class: obo:ACTAN_0000699 (cornered avoidance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000699 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000699 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000699 "2025-05-13T11:34:20.112527Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000699 "Avoidance in which an animal presses its posterior part against the rear-most region of its shelter, readies propulsors, and becomes almost motionless.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasExactSynonym obo:ACTAN_0000699 "cornered")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000699 "nestling"@en)
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1002/(SICI)1098-2337(1998)24:3<197::AID-AB4>3.0.CO;2-I") oboInOwl:hasRelatedSynonym obo:ACTAN_0000699 "at bay")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000699 "cornered avoidance")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000699 "\"...the presence of an emergency escape hatch near the surface... allows mice with that ex tended phenotype to rapidly tunnel to the surface if cornered in their burrow by a predator.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000699 "\"Badis badis...
Nestling... The fish backs up while seemingly probing for a crevice with its tail. Then it presses its body, especially the posterior part, against the rear-most region of the shelter where the light intensity is low. The median and pelvic fins are folded until the fish assumes a \"satisfactory position. Then these fins are usually spread, and the fish becomes almost motionless.\"")
SubClassOf(obo:ACTAN_0000699 obo:ACTAN_0000376)
SubClassOf(obo:ACTAN_0000699 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000311))

# Class: obo:ACTAN_0000700 (operculum gaping)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000700 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000700 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000700 "2025-05-13T14:16:02.693841Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000700 "Gaping that opens and closes the gill covers, with variable, situation dependant tempo and amplitude.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000700 "opercular beat"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000700 "opercular movement")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") oboInOwl:hasExactSynonym obo:ACTAN_0000700 "opercular opening")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.198.1.79") oboInOwl:hasExactSynonym obo:ACTAN_0000700 "opercular pumping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000700 "operculum gaping")
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0000700 "\"...South American cichlid Laetacara araguaiae...

...a fish approach to another with the head directed to it and spread down the branchiostegal membrane.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10682-007-9183-7") skos:example obo:ACTAN_0000700 "\"Courtship displays of R. decemdigitatus consisted of 11 steps: ... (ii) increase in opercular movements...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:scopeNote obo:ACTAN_0000700 "\"...stress-related freezing (lack of body movements except for eyes, with increased opercular movements) can be differentiated from sleep-like/resting behavior (lack of body movement with reduced opercular activity.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000700 "\"...while swimming to pump water in and out...\"")
SubClassOf(obo:ACTAN_0000700 obo:ACTAN_0000122)
SubClassOf(obo:ACTAN_0000700 ObjectSomeValuesFrom(obo:RO_0000057 obo:ZFA_0000555))

# Class: obo:ACTAN_0000701 (instinct initiator)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000701 <https://github.com/Active-Animals/Ontology/patterns/historical_disposition>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000701 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000701 "2025-05-13T17:15:14.431263Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasDefinition obo:ACTAN_0000701 "Initiator which is constructed from a pattern of behaviour which is inherited and specific.

It may be characterized by the accumulation of reaction specific energy or specific action potential (SAP) which is the state of the animal responsible for its readiness to perform the behaviour patterns of one instinct in preference to all other behaviour patterns. An innate releasing mechanism (IRM)  is selectively responsive to a special stimulus situation. Releasers are structures or actions that emanate sign stimuli which are perceived by an animal.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000701 "innate behaviour")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000701 "instinct"@en)
AnnotationAssertion(rdfs:comment obo:ACTAN_0000701 "HISTORICAL TERM

This term is part of a historical ethological perspective which is no longer mainstream.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000701 "instinct initiator")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000701 obo:ACTAN_0000773)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000701 "\"It may be difficult, but we ought to admire the savage instinctive hatred of the queen-bee, which urges her instantly to destroy the young queens her daughters as soon as born, or to perish herself in the combat;\"")
SubClassOf(obo:ACTAN_0000701 obo:ACTAN_0000698)

# Class: obo:ACTAN_0000702 (appetitive initiator)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000702 <https://github.com/Active-Animals/Ontology/patterns/historical_disposition>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000702 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000702 "2025-05-13T17:16:04.40902Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.2307/4083155") Annotation(skos:scopeNote "\"The variable introductory phase of an instinctive behaviour pattern or sequence is called appetitive behaviour.\"") oboInOwl:hasDefinition obo:ACTAN_0000702 "Instinct initiator that is an introductory phase.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000702 "appetitive behaviour"@en)
AnnotationAssertion(rdfs:comment obo:ACTAN_0000702 "HISTORICAL TERM

This term is part of a historical ethological perspective which is no longer mainstream.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000702 "appetitive initiator"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:example obo:ACTAN_0000702 "\"...a Peregrine Falcon (Falco peregrinus) searching for food begins by randomly roaming over its hunting territory. This appetitive behavior continues until a stimulus situation is encountered (e.g., a flock of teal executing fligh't maneuvers).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000702 "\"LORENZ has shown that the animal actively strives to find the stimuli that makes the releasive mechanism of a certain pattern work... LORENZ, following CRAIG, called this striving or purposive behaviour appetitive behaviour. This appetitive behaviour is the place where learning and intelligence can play an important part.\"")
SubClassOf(obo:ACTAN_0000702 obo:ACTAN_0000701)

# Class: obo:ACTAN_0000703 (consummatory initiator)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000703 <https://github.com/Active-Animals/Ontology/patterns/historical_disposition>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000703 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000703 "2025-05-13T17:16:16.171639Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.2307/4083155") Annotation(skos:scopeNote "\"...the act terminating a behavior pattern or sequence is the consummatory act.\"") oboInOwl:hasDefinition obo:ACTAN_0000703 "Instinct initiator that is a terminating act.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000703 "consummatory action"@en)
AnnotationAssertion(rdfs:comment obo:ACTAN_0000703 "HISTORICAL TERM

This term is part of a historical ethological perspective which is no longer mainstream.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000703 "consummatory initiator"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:example obo:ACTAN_0000703 "\"...a Peregrine Falcon (Falco peregrinus) searching for food begins by randomly roaming over its hunting territory... The final stoop, capture, kill, plucking, and eating form a relatively simple and stereotyped chain of consummatory acts.\"")
SubClassOf(obo:ACTAN_0000703 obo:ACTAN_0000701)

# Class: obo:ACTAN_0000704 (drive initiator)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000704 <https://github.com/Active-Animals/Ontology/patterns/historical_disposition>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000704 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000704 "2025-05-13T17:20:51.554481Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.2307/4083155") Annotation(skos:scopeNote "\"Drive has been defined by Thorpe (1951) as \"the complex of internal and external states and stimuli leading to a given behaviour.\"\"") oboInOwl:hasDefinition obo:ACTAN_0000704 "Initiator which is constructed from the complex of internal and external states and stimuli leading to a given behaviour.

This term may include the stimuli, specific action potential, and innate releasing mechanisms involved in a given behavioral act.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000704 "drive"@en)
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") Annotation(skos:scopeNote "\"Because of the difficulties of determining internal states without experimentation, the term tendency has been used to indicate the readiness to show a particular type of behaviour as observed under natural conditions.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000704 "tendency")
AnnotationAssertion(rdfs:comment obo:ACTAN_0000704 "HISTORICAL TERM

This term is part of a historical ethological perspective which is no longer mainstream.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000704 "drive initiator")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000704 <http://humanbehaviourchange.org/ontology/BCIO_050783>)
SubClassOf(obo:ACTAN_0000704 obo:ACTAN_0000698)

# Class: obo:ACTAN_0000705 (needs initiator)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000705 <https://github.com/Active-Animals/Ontology/patterns/historical_disposition>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000705 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000705 "2025-05-13T20:20:29.347051Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1177/10597123211040574") oboInOwl:hasDefinition obo:ACTAN_0000705 "Initiator which is constructed from goal objects with some kind of biological, environmental or sociological significance.")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1177/1745691610369469") Annotation(rdfs:comment "Left in the plural form because of historical usage.") oboInOwl:hasExactSynonym obo:ACTAN_0000705 "needs"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1177/10597123211040574") Annotation(dc:source "doi:10.1177/1745691610369469") Annotation(rdfs:comment "These sources may entice a future editor to patch or further unravel this term.") rdfs:comment obo:ACTAN_0000705 "HISTORICAL TERM

This term is part of a historical ethological perspective which is no longer mainstream.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000705 "needs initiator")
AnnotationAssertion(Annotation(dc:source "doi:10.1177/10597123211040574") skos:scopeNote obo:ACTAN_0000705 "\"For many homeostatic resources (like water and oxygen), the organism will die in the long run if a subsistence level of consumption is not maintained, and it is in this sense that the organism needs these resources. However, the same cannot be said for the vast majority of observed behaviours, where the behaviour is not essential for either survival or reproduction, but rather is opportunistic or has instrumental value, facilitating other goal objectives.\"")
SubClassOf(obo:ACTAN_0000705 obo:ACTAN_0000698)

# Class: obo:ACTAN_0000706 (displacement switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000706 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000706 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000706 "2025-05-14T06:22:38.893479Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.2307/4083155") Annotation(skos:scopeNote "\"In other use it refers to the performance of a behavior pattern out of the context of
behavior with which it is normally related.\"") oboInOwl:hasDefinition obo:ACTAN_0000706 "Condition switch that performs a behaviour pattern out of the context of behaviour with which it is normally related.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000706 "displacement"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000706 "displacement switch"@en)
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000706 "\"Wing-touch is obviously a preening movement, since no other activity involves contact between beak and wing. The display contains all the characteristics of a displacement activity, namely an irrelevant movement...\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000706 "NBO:0020255")
SubClassOf(obo:ACTAN_0000706 obo:ACTAN_0000553)
SubClassOf(obo:ACTAN_0000706 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000694))

# Class: obo:ACTAN_0000707 (redirection switch)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000707 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000707 "2025-05-14T06:22:48.925476Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasDefinition obo:ACTAN_0000707 "Switch in which activities toward a potential object or animal goal, are instead shown toward another.")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasExactSynonym obo:ACTAN_0000707 "redirection"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000707 "redirection switch"@en)
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000707 "\"...female A threatened a trespasser, was threatened in return, and a fight developed. Male A then flew down from a perch in the treetop, drove the trespasser from the site, then momentarily redirected his attack against his mate, but within a second their behaviour switched to high-intensity mutual Back Biting.\"")
SubClassOf(obo:ACTAN_0000707 obo:ACTAN_0000541)

# Class: obo:ACTAN_0000708 (comfort maintenance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000708 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000708 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000708 "2025-05-14T14:41:43.043429Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000708 "Maintenance which relieves restlessness.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000708 "comfort movement"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000708 "toilet")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000708 "comfort maintenance")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000708 "\"Some of these categories (e.g. oiling and bathing) include movements which occur in sequences and form a pattern.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000708 "\"Usually all these movement are carried out alternately, but they have one common feature: before the movement is carried out the animal is restless, but after it, it looks as if it feels more comfortable.\"")
SubClassOf(obo:ACTAN_0000708 obo:ACTAN_0000341)
SubClassOf(obo:ACTAN_0000708 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000893))

# Class: obo:ACTAN_0000709 (stretch comfort)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000709 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000709 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000709 "2025-05-14T15:41:28.559056Z")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasBroadSynonym obo:ACTAN_0000709 "general preparatory movements")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasDefinition obo:ACTAN_0000709 "Comfort that involves stereotyped placements and muscles in tension.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000709 "stretching movement"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000709 "stretch comfort")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:scopeNote obo:ACTAN_0000709 "\"Stretching movements of two types occur in all carinate birds. One involves the stretching down of one wing and the corresponding leg, typically also with a spreading of the tail. However, Kilham notes that woodpeckers do not stretch the corresponding leg . The other is a stretching of the wings (closed or perhaps somewhat extended) over the back. During this latter, some species spread their tails symmetrically at the same time. Some, such as herons, stretch their neck forward during both types of stretching. The stretching downward of both wings which occurs in some young passerines, has also been reported in some adult parrots and in adult emberizines. The straightening of both legs while the bird is standing (usually without involvement of the wings) occurs in young birds but less frequently in adults.\"")
SubClassOf(obo:ACTAN_0000709 obo:ACTAN_0000708)
SubClassOf(obo:ACTAN_0000709 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002204))
SubClassOf(obo:ACTAN_0000709 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002284))

# Class: obo:ACTAN_0000710 (protracting movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000710 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000710 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000710 "2025-05-14T16:43:57.422282Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1002/ajpa.1330870108") Annotation(dc:source "doi:10.1088/1748-3190/ac482d") oboInOwl:hasDefinition obo:ACTAN_0000710 "Movement in which an appendage goes forwards in the sagittal plane.

In a stride cycle, this will be the swing phase.")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ajpa.1330870108") Annotation(rdfs:comment "1992"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000710 "protracting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000710 "protracting movement")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000710 obo:ACTAN_0000091)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000710 obo:ACTAN_0000730)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/jzo.12455") skos:example obo:ACTAN_0000710 "\"...it is likely that two-toed sloths are controlling their center of mass position through the mechanism initially described by Ishida et al. (1990), in which interlimb coordination is timed so that a protracted propulsive forelimb early in its support phase is synchronized with a retracted ipsilateral braking hind limb late in its support phase.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:scopeNote obo:ACTAN_0000710 "\"While the back and hindlimbs propel the body upward, the forelimbs release the support and are protracted in unison to reach a higher handhold. The motion has a pulsing appearance.\"")
SubClassOf(obo:ACTAN_0000710 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000710 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001632))

# Class: obo:ACTAN_0000711 (protruding transition)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000711 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000711 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000711 "2025-05-20T07:30:04.021986Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasDefinition obo:ACTAN_0000711 "Transition in which parts of an animal are in differently exposed, adjacent spaces.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000711 "protruding"@en)
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasRelatedSynonym obo:ACTAN_0000711 "extension")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasRelatedSynonym obo:ACTAN_0000711 "telescopic")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000711 "protruding transition")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000711 obo:ACTAN_0000009)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000711 obo:ACTAN_0000028)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF01609520") skos:example obo:ACTAN_0000711 "\"...extension into the water column from a burrow as in the garden eels Taeniconger and Gorgasia (Congridae)...\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:scopeNote obo:ACTAN_0000711 "\"...the fish first swims to the protruding tip of the worm.\"")
SubClassOf(obo:ACTAN_0000711 obo:ACTAN_0000144)
SubClassOf(obo:ACTAN_0000711 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001598))

# Class: obo:ACTAN_0000712 (daily-vertical migration)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000712 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000712 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000712 "2025-05-20T16:40:23.664067Z")
AnnotationAssertion(Annotation(dc:date "1983"^^xsd:decimal) Annotation(dc:source "doi:10.3354/meps011165") oboInOwl:hasBroadSynonym obo:ACTAN_0000712 "vertical migration"@en)
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1098/rsos.170467") Annotation(skos:scopeNote "\"Chambered nautilus (Nautilus pompilius) perform diurnal vertical movements involving depth changes of 500–600 m.\"") oboInOwl:hasDefinition obo:ACTAN_0000712 "Migration in which diurnal movements involve depth changes.")
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rsos.170467") oboInOwl:hasExactSynonym obo:ACTAN_0000712 "diurnal vertical movement")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000712 "daily-vertical migration"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000712 "NBO:0070002")
AnnotationAssertion(Annotation(dc:source "doi:10.3354/meps011165") skos:example obo:ACTAN_0000712 "\"The major adaptive function of continuous flat swarms over the bottom - observed for A. clausi in Shijiki Bay and for Oithona oculata in Tanabe Bay - may differ from that of ball-shaped ones: the former swarm type seems to represent aggregations due to extensive vertical migration.\"")
SubClassOf(obo:ACTAN_0000712 obo:ACTAN_0000299)
SubClassOf(obo:ACTAN_0000712 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0095005))

# Class: obo:ACTAN_0000713 (plough hunt)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000713 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000713 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000713 "2025-05-20T19:15:36.942522Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "ISBN:9780226315737") Annotation(skos:scopeNote "\"We exclude from consideration those animals that \"bottom feed\" by separating food from surrounding inorganic material and other nonfood particles at the sediment-water interface or that \"deposit feed\" by directly consuming particulate matter on or in the bottom.\"") oboInOwl:hasDefinition obo:ACTAN_0000713 "Hunt that separates food from surrounding inorganic material and other nonfood particles at the substrate interface.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000713 "bottom-feeding"@en)
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") Annotation(skos:scopeNote "\"...ploughs up the mud with its snout...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000713 "snout plough")
AnnotationAssertion(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") Annotation(rdfs:comment "1984"^^xsd:decimal) Annotation(skos:scopeNote "\"...ploughs up the mud... method of hunting...\"") rdfs:label obo:ACTAN_0000713 "plough hunt")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000713 obo:ACTAN_0000363)
AnnotationAssertion(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") skos:example obo:ACTAN_0000713 "\"In Mullus the absence of teeth in the adult upper jaw suggests a suction feeder, and its habit of ploughing up the mud is in line with such a feeding method.\"")
SubClassOf(obo:ACTAN_0000713 obo:ACTAN_0000358)
SubClassOf(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") obo:ACTAN_0000713 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000282))
SubClassOf(obo:ACTAN_0000713 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01001192))

