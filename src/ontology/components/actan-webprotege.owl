AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0008811 "AAO:0010255")
AnnotationAssertion(Annotation(sssom:mapping_justification <https://w3id.org/semapv/vocab/ManualMappingCuration>) oboInOwl:hasDbXref obo:UBERON_0008811 "FBbt:00004850")
