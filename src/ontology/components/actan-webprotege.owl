AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Fast turn (turning): Escape-like turns in larval zebrafish, characterized by fast, large-angle turns that involve bending of the entire body with high angular velocity;\"") oboInOwl:hasDefinition obo:ACTAN_0000569 "Turning that is large-angle, with high angular velocity.")
