AnnotationAssertion(oboInOwl:hasExactSynonym obo:BSPO_0000417 "left/right plane")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:BSPO_0000417 "median plane")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:BSPO_0000417 "sagittal section")
AnnotationAssertion(rdfs:label obo:BSPO_0000417 "sagittal plane")
SubClassOf(obo:BSPO_0000417 obo:BSPO_0000400)

# Class: obo:CL_0000000 (cell)

AnnotationAssertion(oboInOwl:hasDefinition obo:CL_0000000 "A material entity of anatomical origin (part of or deriving from an organism) that has as its parts a maximally connected cell compartment surrounded by a plasma membrane.")
AnnotationAssertion(rdfs:comment obo:CL_0000000 "The definition of cell is intended to represent all cells, and thus a cell is defined as a material entity and not an anatomical structure, which implies that it is part of an organism (or the entirety of one).")
AnnotationAssertion(rdfs:label obo:CL_0000000 "cell")
SubClassOf(obo:CL_0000000 obo:UBERON_0000061)

# Class: obo:CL_0000019 (sperm)

AnnotationAssertion(oboInOwl:hasDefinition obo:CL_0000019 "A mature male germ cell that develops from a spermatid.")
