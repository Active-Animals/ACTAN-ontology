SubClassOf(obo:ACTAN_0000500 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))

# Class: obo:ACTAN_0000501 (induction streamlining)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000501 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000501 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000501 "2026-07-26T08:49:13.357966Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www-dr.wcupa.edu/sciences-mathematics/biology/fFish/documents/1998ImaginativeDragReduction.pdf") Annotation(skos:scopeNote "\"Injection of high momentum fluid into the boundary layer has the capacity to delay both transition and separation. The effluent from the gills of fish could potentially introduce kinetic energy into the boundary layer.\"") oboInOwl:hasDefinition obo:ACTAN_0000501 "Streamlining which results from Injection of high momentum fluid into the boundary layer from the gills.")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "https://www-dr.wcupa.edu/sciences-mathematics/biology/fFish/documents/1998ImaginativeDragReduction.pdf") Annotation(skos:scopeNote "\"Injection of high momentum fluid into the boundary layer...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000501 "boundary layer fluid injection")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000501 "developed jets")
AnnotationAssertion(Annotation(dc:source "https://www-dr.wcupa.edu/sciences-mathematics/biology/fFish/documents/1998ImaginativeDragReduction.pdf") Annotation(skos:scopeNote "\"Flow visualization in fish, however, has shown the pulsed flow during active respiration increases turbulence. The location of the gill slits anterior of the maximum thickness of fish (i.e,, position of lowest pressure) would enhance respiratory flow rather than surface flow. During passive or ram ventilation in scombrid fish, the mouth and gill coverings are kept open so that water can continuously flow over the gills without pumping. The constant swimming motion of the fish maintains the flow. Ram ventilation does not prevent turbulence, but it appears to extend the laminar region of the boundary layer by 13-100%.\"") rdfs:comment obo:ACTAN_0000501 "Whilst prescient, Breder's insight about active (pulsed) fluid injection does not appear to be effective in practice amongst fishes, although a passive relation to it does in the form of continuous ram with the gill slits left open.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"induced streamline system\"") rdfs:label obo:ACTAN_0000501 "induction streamlining"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000501 "\"Returning to the fishes, it should now be obvious that the water ejected through the gill clefts of typical acanthopterygians is extremely similar in its effect to that of this new mechanical device that has actually propelled a model successfully. It seems, however, almost impossible to obtain an accurate measure of just what locomotor advantage this exhalation of water may be to most species, but it is readily demonstrated to be a real item in others.\"")
SubClassOf(obo:ACTAN_0000501 obo:ACTAN_0000643)
SubClassOf(obo:ACTAN_0000501 ObjectSomeValuesFrom(obo:RO_0000057 obo:ZFA_0005389))

# Class: obo:ACTAN_0000502 (tail splaying)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000502 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000502 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000502 "2026-07-26T12:37:10.634945Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"These muscles spread the tail fin, and the inner branch can also bend the tail sideways.\"") oboInOwl:hasDefinition obo:ACTAN_0000502 "Splaying that spreads the tail.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...spread the tail fin...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000502 "tail spreading")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...caudal fin is always spread and closed as a whole.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000502 "caudal fin spreading")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000502 "tail splaying"@en)
SubClassOf(obo:ACTAN_0000502 obo:ACTAN_0000083)
SubClassOf(obo:ACTAN_0000502 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002415))

# Class: obo:ACTAN_0000503 (tail splay)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000503 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000503 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000503 "2026-07-26T12:41:20.341974Z")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10682-007-9183-7") Annotation(skos:scopeNote "\"...erection of... caudal... fins...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000503 "caudal fin erection")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.021360") Annotation(skos:scopeNote "\"...abduction of the fin rays by the supracarinalis (SC) and infracarinalis
(IC) to increase the tail surface area...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000503 "tail abduction")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000503 "tail splay"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") skos:definition obo:ACTAN_0000503 "Splay that results from tail splaying.")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10682-007-9183-7") skos:example obo:ACTAN_0000503 "\"Courtship displays of R. decemdigitatus consisted of 11 steps: (i) darkening of breeding colours and erection of anal, caudal and all dorsal fins...\"")
SubClassOf(obo:ACTAN_0000503 obo:ACTAN_0000624)
SubClassOf(obo:ACTAN_0000503 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002415))

# Class: obo:ACTAN_0000504 (freeze alarm)

