# Class: obo:ACTAN_0000551 (dis-aggregation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000551 <https://github.com/Active-Animals/Ontology/patterns/group_behaviour>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000551 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000551 "2025-01-27T09:18:45.735896Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000551 "Dissociation in which multiple animals move away from each other.

They may reaggregate later.")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s002850050112") oboInOwl:hasExactSynonym obo:ACTAN_0000551 "asocial"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000551 "disaggregating")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000551 "dispersal"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000551 "scattering")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000551 "spreading out")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000551 "anti-social")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&cbl=18750&diss=y") rdfs:label obo:ACTAN_0000551 "dis-aggregation")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000551 obo:ACTAN_0000376)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000551 obo:ACTAN_0000927)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF01609520") skos:example obo:ACTAN_0000551 "\"Haemulon striatum... forage in diurnal schools. At night, schools of these species disperse and individuals are found in resting states among the reef features, or elsewhere on the bottom.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s002850050112") skos:example obo:ACTAN_0000551 "\"In the solitary phase, individual locusts are asocial and avoid each other.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3354/esr01312") skos:example obo:ACTAN_0000551 "\"Life history of C. horridus necessitates large tracts of forest to accommodate seasonal dispersal movements (of up to 7 km) to and from overwintering sites.\"")
SubClassOf(obo:ACTAN_0000551 obo:ACTAN_0000411)
SubClassOf(obo:ACTAN_0000551 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000398))
SubClassOf(obo:ACTAN_0000551 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001630))

# Class: obo:ACTAN_0000552 (ranking agonism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000552 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000552 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000552 "2025-01-27T11:53:58.918345Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000552 "Agonism in which inequality characterises the way members of a social organisation treat one another.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000552 "hierarchy"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000552 "ranking")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000552 "ranking agonism")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:scopeNote obo:ACTAN_0000552 "\"Agonistic social behavior used to establish dominance/hierarchy, plays a role in fighting behavior.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:scopeNote obo:ACTAN_0000552 "\"The hierarachy is a purely internal phenomenon arising among the members of a society, but it can nevertheless enormously affect their individual expectations of life and reproduction.\"")
SubClassOf(obo:ACTAN_0000552 obo:ACTAN_0000384)
SubClassOf(obo:ACTAN_0000552 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000414))

# Class: obo:ACTAN_0000553 (condition switch)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000553 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000553 "2025-01-27T14:17:01.64865Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.3389/fnbeh.2010.00049") oboInOwl:hasDefinition obo:ACTAN_0000553 "Switch that depends on the environmental context present.")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fnbeh.2010.00049") oboInOwl:hasExactSynonym obo:ACTAN_0000553 "context-dependent response")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fnbeh.2010.00049") oboInOwl:hasExactSynonym obo:ACTAN_0000553 "dependent switching")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fnbeh.2010.00049") oboInOwl:hasExactSynonym obo:ACTAN_0000553 "shaped switching")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000553 "apt")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fnbeh.2010.00049") oboInOwl:hasRelatedSynonym obo:ACTAN_0000553 "conditional"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000553 "condition switch"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000553 "\"Cichlasoma biocellatum...
When the fish is apt to become aggressive, for instance when it is guarding the young...\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000553 "\"It is possible to demonstrate the conflict between fleeing, backward or forward, and suppression of movement in a Badis badis by placing it in a small aquarium with inadequate shelter. Tapping on the glass with one's finger, varying the strength and distance of the tapping, causes the fish to lie still, suddenly jump forward and immediately back, and so forth. Thus the behavior switches back and forth rapidly between the possible outlets of Fright.\"")
SubClassOf(obo:ACTAN_0000553 obo:ACTAN_0000541)

# Class: obo:ACTAN_0000554 (fighting switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000554 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000554 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000554 "2025-01-27T14:51:05.995843Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000554 "Condition switch that involves a variable mixture of phased signals, assessments, antagonism, relative locomotion, and movement bouts, with the potential outcome of winning or losing.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000554 "fighting"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000554 "fighting switch"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000554 "\"...the male Haplochromis... in intraterritorial fighting too, the tail beating, butting and gripping the jaws is not performed in a definite order but the fishes apparently use these actions just at the right moment, which may appear at any time. This indicates that their exact timing is a matter of external stimuli.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000554 "\"Agonistic confrontation between two individuals often used to establish social dominance; comprises two distinct phases: the fish first assess each other by exhibiting display, biting/nipping, flicking, and circling behaviors, which continues until the first chase/flee occurs. Next, the ‘winner’ (chaser) initiates all agonistic behaviors, while the ‘loser’ displays fleeing, submission behavior, or freezing.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1439-0310.1963.tb01161.x") skos:scopeNote obo:ACTAN_0000554 "\"...all fighting acts fluctuate together in the natural situation, as do all components of escape... as soon as we begin to analyse the causation of each of them separately, it is pre-judging the issue if we take for granted that each is in itself a causally closely-linked complex of components.\"")
SubClassOf(obo:ACTAN_0000554 obo:ACTAN_0000553)
SubClassOf(obo:ACTAN_0000554 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001507))

# Class: obo:ACTAN_0000555 (lateral confrontation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000555 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000555 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000555 "2025-01-27T20:45:29.293429Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Lateral display: Two fish line up parallel to each other head to tail, raise their dorsal fins (fin raise), extend their caudal fins, darken in color (body color change), and swim in circles (circling), often ascending.\"") oboInOwl:hasDefinition obo:ACTAN_0000555 "Confrontation that involves lining up parallel to another.")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") oboInOwl:hasExactSynonym obo:ACTAN_0000555 "lateral threat")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000555 "lateral-display"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000555 "lateral confrontation")
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0000555 "\"...South American cichlid Laetacara araguaiae...

...a fish approaches to an opponent, shows its body laterally and spreads its fins..\"")
SubClassOf(obo:ACTAN_0000555 obo:ACTAN_0000329)
SubClassOf(obo:ACTAN_0000555 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001193))

# Class: obo:ACTAN_0000556 (frontal confrontation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000556 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000556 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000556 "2025-01-27T20:45:40.981142Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000556 "Confrontation in which animals approach each other head to head.")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") oboInOwl:hasExactSynonym obo:ACTAN_0000556 "frontal threat")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000556 "frontal-display"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000556 "frontal confrontation")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000556 "\"The Tilapia species, when still at some distance from each other open their mouths widely; in Tilapia natalensis the thick white lips are then contrasted with the dark background, and in Tilapia nilotica the pink coloured throat is conspicuous. Astonotus, when still at long distance from its enemy, erects the operculae and the branchiostegal membrance.\"")
SubClassOf(obo:ACTAN_0000556 obo:ACTAN_0000329)
SubClassOf(obo:ACTAN_0000556 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002448))

# Class: obo:ACTAN_0000557 (ascent manoeuvre)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000557 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000557 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000557 "2025-01-27T21:09:07.509414Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/j.1744-7429.2000.tb00506.x") Annotation(skos:scopeNote "\"S. C. Sillett (pers. comm.) has seen a 7-cm earthworm of a predominantly terrestrial species rapidly ascending 60 m up a Sitka spruce trunk.\"") oboInOwl:hasDefinition obo:ACTAN_0000557 "A manoeuvre that is up.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...they ascended...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000557 "ascending")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") oboInOwl:hasExactSynonym obo:ACTAN_0000557 "ascent"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000557 "rising")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasRelatedSynonym obo:ACTAN_0000557 "upwards")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000557 "ascent manoeuvre"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ajpa.1330870108") skos:example obo:ACTAN_0000557 "\"Baboons often ascended by alternately leaping and walking on slightly angled WBS [weight bearing structures], whereas chimpanzees used less saltatory locomotor modes.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000557 "\"Nocomis leptocephalus...
Once released, the female continued to rise vertically into the water column...\"")
SubClassOf(obo:ACTAN_0000557 obo:ACTAN_0000149)
SubClassOf(obo:ACTAN_0000557 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000370))

# Class: obo:ACTAN_0000558 (descent manoeuvre)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000558 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000558 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000558 "2025-01-28T11:31:28.062679Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/j.1744-7429.2000.tb00506.x") Annotation(skos:scopeNote "\"Gliding and parachuting are most usefully distinguished for species operating at the extremes of descent angle. This is because Oliver's (1951) 45° demarcation is arbitrary (except at this angle, lift = drag) and frustrating to assess, owing to the unpredictability of air currents and the flexibility available to many organisms in choosing their downward angle and continuously changing this angle during the course of descent.\"") oboInOwl:hasDefinition obo:ACTAN_0000558 "A manoeuvre that is downward.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000558 "descent")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasRelatedSynonym obo:ACTAN_0000558 "downwards")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000558 "falling")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1038/ncomms1350") oboInOwl:hasRelatedSynonym obo:ACTAN_0000558 "sink")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000558 "descent manoeuvre"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000558 obo:ACTAN_0000192)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000558 "\"Coenobita compressus is a terrestrial hermit crab living in the rocks and grass above high tide in the tropics. Usually, by day it is quiescent and at night it descends to the beaches to scavenge organic debris along the moist sand.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000558 "\"Thalassoma cupido...
Immediately after spawning, the fish move slightly apart and swim downwards with great rapidity.\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000558 "\"When approaching a roost from upwing or a feeding area surrounded by tall trees, A. ibis occasionally descend with a rapid side-slipping swerving flight... Swerving flight clearly serves to check the rate of descent when a bird is flying steeply downwards...\"")
SubClassOf(obo:ACTAN_0000558 obo:ACTAN_0000149)
SubClassOf(obo:ACTAN_0000558 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000365))

# Class: obo:ACTAN_0000559 (geo-taxis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000559 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000559 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000559 "2025-01-28T14:18:09.8569Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000559 "Taxis that is gravitational.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") rdfs:label obo:ACTAN_0000559 "geo-taxis"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000559 "NBO:0000378")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/41.2.137") skos:example obo:ACTAN_0000559 "\"During vertical movements, animals can take advantage of gravity or positive buoyancy to permit unpowered downward or upward locomotion for a longer period. It was recently discovered that whales and seals cease locomotion while continuing to glide downward during the deeper descending portion of dives over 80 m thereby saving considerable energy and reducing their oxygen demands.\"")
SubClassOf(obo:ACTAN_0000559 obo:ACTAN_0000368)
SubClassOf(obo:ACTAN_0000559 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002105))

# Class: obo:ACTAN_0000560 (tail furling)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000560 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000560 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000560 "2026-07-26T17:09:30.470819Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000560 "Furling that closes the tail.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...caudal fin is always spread and closed as a whole.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000560 "caudal fin closing")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.021360") oboInOwl:hasNarrowSynonym obo:ACTAN_0000560 "caudal fin ray adducting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000560 "tail furling"@en)
SubClassOf(obo:ACTAN_0000560 obo:ACTAN_0000740)
SubClassOf(obo:ACTAN_0000560 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002415))

# Class: obo:ACTAN_0000561 (dive regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000561 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000561 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000561 "2025-01-28T16:33:45.134274Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") oboInOwl:hasDefinition obo:ACTAN_0000561 "Interfacing-regime in which falling is actively assisted by a mix of thrusting and streamlining.")
AnnotationAssertion(Annotation(dc:date "1976"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/4084834") oboInOwl:hasExactSynonym obo:ACTAN_0000561 "dive")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000561 "diving"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000561 "plunge")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasNarrowSynonym obo:ACTAN_0000561 "submersion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000561 "dive regime")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4084834") skos:example obo:ACTAN_0000561 "\"...a heron perched on shore or on branches overhanging the water dives head first from its perch into the water.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000561 "\"Diving is an active, fast and directed zebrafish behavior (with body heading towards the bottom head first);\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000561 "\"Petrels are the most aërial and oceanic of birds, yet in the quiet Sounds of Tierra del Fuego, the Puffinuria berardi, in its general habits, in its astonishing power of diving, its manner of swimming, and of flying when unwillingly it takes flight, would be mistaken by any one for an auk or grebe; nevertheless, it is essentially a petrel, but with many parts of its organisation profoundly modified.\"")
SubClassOf(obo:ACTAN_0000561 obo:ACTAN_0000086)
SubClassOf(obo:ACTAN_0000561 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000192))
SubClassOf(obo:ACTAN_0000561 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000643))
SubClassOf(obo:ACTAN_0000561 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000173))
SubClassOf(obo:ACTAN_0000561 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

