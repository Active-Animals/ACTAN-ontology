SubClassOf(obo:ACTAN_0000266 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000528))

# Class: obo:ACTAN_0000267 (anguilliform gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000267 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000267 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000267 "2024-10-06T18:51:50.191979Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"That form of locomotion exemplified by the Anguillidae {Anguilla). It consists of a series of sine waves (as in the waving of a flag) which are passed caudad by successive contractions and relaxations of the metameral body muscles. More than one-half a sine curve is formed at least. The pivot is at the base of the skull.\"") oboInOwl:hasDefinition obo:ACTAN_0000267 "Aquatic-lateral-undulating gait that consists of a series of sine waves, comprising more than one-half a sine curve, which are passed caudally.

The pivot is at the base of the skull.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasExactSynonym obo:ACTAN_0000267 "anguilliform axial swim"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000267 "anguilliform mode")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000267 "anguilliform motion")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000267 "slipping along")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000267 "anguilliform gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:example obo:ACTAN_0000267 "\"Typical examples of this common locomotion mode are the eel and the lamprey.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:scopeNote obo:ACTAN_0000267 "\"In anguilliform mode, the whole body participates in large amplitude undulations. Since at least one complete wavelength of the propulsive wave is present along the body, lateral forces are adequately cancelled out, minimizing any tendencies for the body to recoil. Many anguilliform swimmers are capable of backward as well as forward swimming by altering the propagation direction of the propulsive wave.\"")
SubClassOf(obo:ACTAN_0000267 obo:ACTAN_0000266)
SubClassOf(obo:ACTAN_0000267 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000027))
SubClassOf(Annotation(dc:source "doi:10.1093/icb/36.6.555") obo:ACTAN_0000267 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002100))

# Class: obo:ACTAN_0000268 (subcarangiform gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000268 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000268 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000268 "2024-10-06T18:52:34.334332Z")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasBroadSynonym obo:ACTAN_0000268 "intermediate gait"@en)
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1109/48.757275") oboInOwl:hasDefinition obo:ACTAN_0000268 "Aquatic-lateral-undulating gait that increases only in the posterior half of the body.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...locomotion of the members of this group is typically sub-carangiform...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000268 "sub-carangiform locomotion")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000268 "sub-carangiform method")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000268 "sub-carangiform movement")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000268 "sub-carangiform type")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000268 "subcarangiform mode")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000268 "subcarangiform swimming")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000268 "subcarangiform gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:example obo:ACTAN_0000268 "\"...observed in the subcarangiform mode (e.g., trout)...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/eff.12212") skos:example obo:ACTAN_0000268 "\"Arctic charr... to move from one point to another, the fish resorts to a subcarangiform locomotion.\"")
SubClassOf(obo:ACTAN_0000268 obo:ACTAN_0000266)
SubClassOf(Annotation(dc:source "doi:10.1109/48.757275") obo:ACTAN_0000268 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000027))
SubClassOf(Annotation(dc:source "doi:10.1109/48.757275") obo:ACTAN_0000268 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002100))
SubClassOf(Annotation(dc:source "doi:10.1109/48.757275") obo:ACTAN_0000268 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_4000164))

# Class: obo:ACTAN_0000269 (thunniform gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000269 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000269 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000269 "2024-10-06T18:53:02.390919Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1109/48.757275") Annotation(skos:scopeNote "\"Significant lateral movements occur only at the caudal fin (that produces more than 90% of the thrust) and at the area near the narrow peduncle. The body is well streamlined to significantly reduce pressure drag, while the caudal fin is stiff and high, with a crescent-moon shape often referred to as lunate.\"") oboInOwl:hasDefinition obo:ACTAN_0000269 "Aquatic-lateral-undulating gait that uses significant lateral movements only at the caudal fin and at the area near the narrow peduncle. 

The body is well streamlined to significantly reduce pressure drag, while the caudal fin is stiff and high, with a crescent-moon shape often referred to as lunate.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasExactSynonym obo:ACTAN_0000269 "thuniform mode")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasExactSynonym obo:ACTAN_0000269 "thunniform axial swim"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000269 "thunniform mode")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000269 "thunniform gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:example obo:ACTAN_0000269 "\"In teleost fish, thunniform mode is encountered in scombrids, such as the tuna and the mackerel.\"")
SubClassOf(obo:ACTAN_0000269 obo:ACTAN_0000266)
SubClassOf(Annotation(dc:source "doi:10.1109/48.757275") obo:ACTAN_0000269 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000534))
SubClassOf(Annotation(dc:source "doi:10.1109/48.757275") obo:ACTAN_0000269 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_4000164))
SubClassOf(Annotation(dc:source "doi:10.1109/48.757275") obo:ACTAN_0000269 ObjectSomeValuesFrom(obo:RO_0000057 obo:ZFA_0000178))

# Class: obo:ACTAN_0000270 (cognition context)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000270 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000270 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000270 "2024-10-07T08:06:04.066196Z")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasDefinition obo:ACTAN_0000270 "Context in which a representational processing capacity is evidenced.

Attention and recognition may be involved.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000270 "cognition"@en)
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000270 "cognitive processes")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000270 "cognition context"@en)
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000270 "NBO:0000607")
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:scopeNote obo:ACTAN_0000270 "\"Animals also exhibit emotional states, like states of heightened anxiety or depression, as well as cognitive states, for example, in the contexts of attention or working memory.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/tops.12554") skos:scopeNote obo:ACTAN_0000270 "\"In order to provide a more rigorous foundation for research and to advance our understanding of the interrelation between tool use and cognition, we suggest the adoption of Fragaszy and Mangalam’s (2018) tooling framework, which is characterized by the creation of a body-plus-object system that manages a mechanical interface between tool and surface. Tooling is limited to a narrower suite of behaviors than tool use, which might facilitate its neurocognitive investigation. Indeed, evidence in the literature indicates that tooling has distinct neurocognitive underpinnings not shared by other activities typically classified as tool use, at least in primates.\"")
SubClassOf(obo:ACTAN_0000270 obo:ACTAN_0000751)
SubClassOf(obo:ACTAN_0000270 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MF_0000008))
SubClassOf(obo:ACTAN_0000270 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000077))

# Class: obo:ACTAN_0000271 (technic activity)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000271 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000271 "2024-10-07T08:06:22.076385Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.4000/ejpap.2324") oboInOwl:hasDefinition obo:ACTAN_0000271 "Activity which uses an artifact to modify an environment.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.4000/ejpap.2324") oboInOwl:hasExactSynonym obo:ACTAN_0000271 "technic")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.4000/ejpap.2324") oboInOwl:hasExactSynonym obo:ACTAN_0000271 "technical enactivism"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000271 "technic activity"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.4000/ejpap.2324") skos:scopeNote obo:ACTAN_0000271 "\"Venturing a Pragmatist Interpretation of Nonhuman Animals’ Technical Capacities:

Those problematic and particular situations that are solved with an active adaptation can lead to different kinds of solutions, some of which can be achieved through modification of habits... In some cases, however, animals can use mediating objects to find a solution for the problematic situation. Of course, not every mediating object used by an agent is necessarily an artifact... An artifact could be defined as an extreme case of a mediating object created or used to solve a problematic situation in an efficient way. Sometimes the object already exists, and it is picked out from among other natural objects for its special structure (naturfacts) – a structure that is identified by the animal for its outstanding features for solving the problematic situation... Yet, in other cases, the object does not exist before, and the agent creates it, either by modifying natural objects, or by combining and assembling different natural objects. The structure of the object allows the animal to deal with the problematic situation, transforming it into a non-problematic one.\"")
SubClassOf(obo:ACTAN_0000271 obo:ACTAN_0000078)

# Class: obo:ACTAN_0000272 (construction technic)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000272 <https://github.com/Active-Animals/Ontology/patterns/technical_realizing_routine>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000272 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000272 "2024-10-07T08:07:26.13089Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasDefinition obo:ACTAN_0000272 "Technic in which an animal's activity creates functional architecture, using characteristic materials and techniques, and involving labour and other costs.

Costs may be significant for building, maintenance, or defense. Structures can become very complex, exemplifying the 'extended genotype' concept, and even suggesting well developed cognitive mechanisms. Functions include feeding, sheltering, socialising and signaling. There may also be significant ecosystem (niche) and inter-generational (even evolutionary) impacts.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000272 "building")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000272 "construction"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasNarrowSynonym obo:ACTAN_0000272 "rebuilding")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasNarrowSynonym obo:ACTAN_0000272 "remodelling")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasNarrowSynonym obo:ACTAN_0000272 "reshaping")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.5343/bms.2014.1055") oboInOwl:hasRelatedSynonym obo:ACTAN_0000272 "maintaining")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000272 "construction technic"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000272 "\"...the spawning pit or trough creates a pocket of slack water...  a male N. micropogon continually reshapes the original trough.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000272 "\"As in the cells of the hive-bee, so here, the three plane surfaces in any one cell necessarily enter into the construction of three adjoining cells. It is obvious that the Melipona saves wax by this manner of building; for the flat walls between the adjoining cells are not double, but are of the same thickness as the outer spherical portions, and yet each flat portion forms a part of two cells.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:scopeNote obo:ACTAN_0000272 "\"Cases of animal architecture should therefore be evolutionarily shaped to maximize the adaptive benefi ts to the architect, devalued by any costs the architect incurs in constructing, maintaining, and defending its architecture. The extended phenotype concept thus sheds essential light on when architecture will be evolutionarily favored.\"")
SubClassOf(obo:ACTAN_0000272 obo:ACTAN_0000271)
SubClassOf(obo:ACTAN_0000272 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000096))

# Class: obo:ACTAN_0000273 (cementing construction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000273 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000273 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000273 "2024-10-07T08:07:52.090661Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") Annotation(skos:scopeNote "\"Bodily secretions include saliva, wax, silk and even excrement, all of which can serve as effective glue for cementing external materials together.\"") oboInOwl:hasDefinition obo:ACTAN_0000273 "Construction that uses bodily secretions as an effective glue for external materials.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") Annotation(skos:example "\"And weaver ants use their own larvae as a source of silk, thereby bonding leaves together to create elaborate treetop nests.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000273 "bonding")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasExactSynonym obo:ACTAN_0000273 "cementing"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000273 "cement")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000273 "cementing construction"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000273 "\"The impressively tall and long-lasting mounds of termites, for example, are constructed from a mixture of feces, saliva and soil.\"")
SubClassOf(obo:ACTAN_0000273 obo:ACTAN_0000272)
SubClassOf(obo:ACTAN_0000273 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000616))
SubClassOf(obo:ACTAN_0000273 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000463))

# Class: obo:ACTAN_0000274 (keel stabilizing)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000274 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000274 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000274 "2026-07-20T06:32:55.342084Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000274 "Stabilizing which reduces rolling in a fluid by erecting a rigid blade.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000274 "even keel")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000274 "steadying keel")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000274 "keel stabilizing"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000274 "\"Batistes vetula and others possess a long movable pelvis, which when erected seems to act as a keel. This is usually done on coming to a stop and at times when other fishes would erect their anal.\"")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.194704") skos:example obo:ACTAN_0000274 "\"Most balistoid fishes possess a mobile ventral keel that can be extended and retracted.\"")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") Annotation(rdfs:comment "This term is about the active use of movable keels; fixed keels, such as may be seen in sharks are not its target.") skos:scopeNote obo:ACTAN_0000274 "\"Rapidity of motion continuously made, without acceleration or deceleration and absolute rest obviates to a certain extent the necessity of these keels which are then ordinarily folded back... The pelvic fins further this same maintenance of position by functioning after the manner of bilge keels. This is especially prominent in many of the sharks with the long and evenly outstanding pelvics.\"")
SubClassOf(obo:ACTAN_0000274 obo:ACTAN_0000148)
SubClassOf(obo:ACTAN_0000274 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000026))

# Class: obo:ACTAN_0000275 (web-building construction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000275 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000275 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000275 "2024-10-07T08:08:19.570652Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/j.1469-185X.2010.00163.x") oboInOwl:hasDefinition obo:ACTAN_0000275 "Construction which weaves silk threads into variably regular structures.

The silk is often sticky and the web is usually a trap stretched across a gap.")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "doi:10.1017/S1464793104006700") oboInOwl:hasExactSynonym obo:ACTAN_0000275 "orb-weaving")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000275 "web-building"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000275 "web-building construction"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000275 obo:ACTAN_0000351)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:scopeNote obo:ACTAN_0000275 "\"Similarly, the webs of spiders can simultaneously provide a tool for catching prey, a home base for raising brood, and a platform of expanded sensory information, based on vibrations transmitted through the web.\"")
SubClassOf(obo:ACTAN_0000275 obo:ACTAN_0000272)
SubClassOf(obo:ACTAN_0000275 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000715))
SubClassOf(obo:ACTAN_0000275 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0012245))

# Class: obo:ACTAN_0000276 (casing construction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000276 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000276 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000276 "2024-10-07T08:08:32.721186Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1098/rsbl.2015.0325") Annotation(skos:scopeNote "\"Taking these issues into account, we define a decorator as an organism that (by means of specialist behaviour and/or morphology that has been favoured by selection for that purpose) accumulates and retains environmental material that becomes attached to the exterior of the decorator.\"") oboInOwl:hasDefinition obo:ACTAN_0000276 "Construction that accumulates and retains environmental material that becomes attached to the exterior.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasExactSynonym obo:ACTAN_0000276 "encasing"@en)
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasNarrowSynonym obo:ACTAN_0000276 "cobbling"@en)
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "https://www.researchgate.net/profile/Sarah-Woodin/publication/228674786_Modelling_the_energy-mortality_trade-offs_of_invertebrate_decorating_behaviour/links/5505fb030cf2d60c0e6c825b/Modelling-the-energy-mortality-trade-offs-of-invertebrate-decorating-behaviour.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000276 "hatting")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "https://www.researchgate.net/profile/Sarah-Woodin/publication/228674786_Modelling_the_energy-mortality_trade-offs_of_invertebrate_decorating_behaviour/links/5505fb030cf2d60c0e6c825b/Modelling-the-energy-mortality-trade-offs-of-invertebrate-decorating-behaviour.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000276 "shield-carrying")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "https://www.researchgate.net/profile/Sarah-Woodin/publication/228674786_Modelling_the_energy-mortality_trade-offs_of_invertebrate_decorating_behaviour/links/5505fb030cf2d60c0e6c825b/Modelling-the-energy-mortality-trade-offs-of-invertebrate-decorating-behaviour.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000276 "trash-carrying")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "https://www.researchgate.net/profile/Sarah-Woodin/publication/228674786_Modelling_the_energy-mortality_trade-offs_of_invertebrate_decorating_behaviour/links/5505fb030cf2d60c0e6c825b/Modelling-the-energy-mortality-trade-offs-of-invertebrate-decorating-behaviour.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000276 "carrying")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.4000/ejpap.2324") oboInOwl:hasRelatedSynonym obo:ACTAN_0000276 "cocooning")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "https://www.researchgate.net/profile/Sarah-Woodin/publication/228674786_Modelling_the_energy-mortality_trade-offs_of_invertebrate_decorating_behaviour/links/5505fb030cf2d60c0e6c825b/Modelling-the-energy-mortality-trade-offs-of-invertebrate-decorating-behaviour.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000276 "covering")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "https://www.researchgate.net/profile/Sarah-Woodin/publication/228674786_Modelling_the_energy-mortality_trade-offs_of_invertebrate_decorating_behaviour/links/5505fb030cf2d60c0e6c825b/Modelling-the-energy-mortality-trade-offs-of-invertebrate-decorating-behaviour.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000276 "decoration")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "https://www.researchgate.net/profile/Sarah-Woodin/publication/228674786_Modelling_the_energy-mortality_trade-offs_of_invertebrate_decorating_behaviour/links/5505fb030cf2d60c0e6c825b/Modelling-the-energy-mortality-trade-offs-of-invertebrate-decorating-behaviour.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000276 "masking")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "https://www.researchgate.net/profile/Sarah-Woodin/publication/228674786_Modelling_the_energy-mortality_trade-offs_of_invertebrate_decorating_behaviour/links/5505fb030cf2d60c0e6c825b/Modelling-the-energy-mortality-trade-offs-of-invertebrate-decorating-behaviour.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000276 "ornamenting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000276 "casing construction")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000276 obo:ACTAN_0000445)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000276 "\"For example, the external casings and nets constructed by caddisfly larvae can serve to protect the larva’s soft body and trap food items flowing through streams. And as the larva grows, it can enlarge the casing to accommodate its bigger body.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rsbl.2015.0325") skos:example obo:ACTAN_0000276 "\"The most widely studied group of decorators are crabs of the superfamily Majoidea. The group has over 900 species, about 75% of which show decorating over some or all of their body, having specialized hooked setae to attach material from the environment.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:scopeNote obo:ACTAN_0000276 "\"Other forms of animal architecture do not require attaching or cobbling matter together, but rather excavating material from a substrate.\"")
SubClassOf(obo:ACTAN_0000276 obo:ACTAN_0000272)
SubClassOf(obo:ACTAN_0000276 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000616))
SubClassOf(obo:ACTAN_0000276 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00010483))

# Class: obo:ACTAN_0000277 (manufacture technic)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000277 <https://github.com/Active-Animals/Ontology/patterns/technical_realizing_routine>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000277 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000277 "2024-10-07T16:20:43.441417Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.4000/ejpap.2324") Annotation(skos:scopeNote "\"Schumaker, Walkup and Beck define “tool manufacture” as “simply any structural modification of an object or an existing tool so that the object serves, or serves more effectively, as a tool.\"") oboInOwl:hasDefinition obo:ACTAN_0000277 "Technic which causes any structural modification of an object, so that it serves more effectively as a tool.

Modification means alteration of the dimensional physical characteristics of the tool, not simply its spatial orientation. There are four types of tool manufacture: detach, subtract, add/combine and reshape.")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") oboInOwl:hasExactSynonym obo:ACTAN_0000277 "manufacture")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") oboInOwl:hasExactSynonym obo:ACTAN_0000277 "manufacturing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000277 "manufacture technic")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(rdfs:comment "Darwin anticipated the concept of animal tool manufacture in negating it; however, our ontology tries to source the earliest positive label and synonym assertion dates, hence this quote is left here.") skos:scopeNote obo:ACTAN_0000277 "\"As ants work by inherited instincts and by inherited tools or weapons, and not by acquired knowledge and manufactured instruments, a perfect division of labour could be effected with them only by the workers being sterile;\"")
SubClassOf(obo:ACTAN_0000277 obo:ACTAN_0000271)
SubClassOf(obo:ACTAN_0000277 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000096))
SubClassOf(obo:ACTAN_0000277 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01000814))

# Class: obo:ACTAN_0000278 (weaving construction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000278 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000278 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000278 "2024-10-07T08:09:13.991287Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3819/ccbr.2016.110005") Annotation(skos:scopeNote "\"The techniques with which birds build their nests have also been described in some detail and are also various: they range... to the weaving of hanging nest baskets using intricate tuck, looping, interlocking, winding, and knotting bill-made stitches to fasten and secure grassy materials.\"") oboInOwl:hasDefinition obo:ACTAN_0000278 "Construction which uses stitches to fasten and secure materials.")
AnnotationAssertion(Annotation(dc:date "2016"^^xsd:decimal) Annotation(dc:source "doi:10.3819/ccbr.2016.110005") oboInOwl:hasExactSynonym obo:ACTAN_0000278 "weaving"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000278 "weaving construction"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000278 "\"A fitting example is the long entrance tube woven by weaver birds beneath their nest, which not only keeps the nest waterproof but also makes access to the nest difficult for predators.\"")
SubClassOf(obo:ACTAN_0000278 obo:ACTAN_0000272)
SubClassOf(obo:ACTAN_0000278 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000695))
SubClassOf(obo:ACTAN_0000278 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00010483))

# Class: obo:ACTAN_0000279 (linking construction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000279 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000279 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000279 "2024-10-07T08:09:28.769789Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasDefinition obo:ACTAN_0000279 "Construction in which colony members temporarily build using one another as raw material, holding together end-to-end.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasExactSynonym obo:ACTAN_0000279 "linking"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000279 "linking construction")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000279 "\"Army ants create ‘living architecture’ in which colony members temporarily link themselves end-to-end, holding together as a bridge while others travel atop them.\"")
SubClassOf(obo:ACTAN_0000279 obo:ACTAN_0000272)
SubClassOf(obo:ACTAN_0000279 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000628))
SubClassOf(obo:ACTAN_0000279 ObjectSomeValuesFrom(obo:RO_0000057 obo:PCO_0000018))

# Class: obo:ACTAN_0000280 (anal-fin extension)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000280 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000280 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000280 "2026-07-20T10:58:40.019788Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000280 "Extension that results from anal fin extending.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000280 "anal-fin extension"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000280 "\"In stopping, the dorsal and anal of most spiny rayed fishes are usually erected to their fullest extent.\"")
