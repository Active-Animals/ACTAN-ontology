# Class: obo:ACTAN_0000220 (pace gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000220 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000220 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000220 "2024-10-02T06:51:20.46724Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Compositional definition.") oboInOwl:hasDefinition obo:ACTAN_0000220 "Run gait that is ipsilateral-bipodal, bouncing, and suspended.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3390/ani13162557") oboInOwl:hasExactSynonym obo:ACTAN_0000220 "flying pace")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000220 "pacing"@en)
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000220 "running pace")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3390/ani13162557") oboInOwl:hasNarrowSynonym obo:ACTAN_0000220 "hard pace")
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000220 "pace gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/20.1.255") skos:example obo:ACTAN_0000220 "\"The long legs of camelids and certain breeds of dogs provide both the necessity to pace (to avoid interference) and the capacity to do so steadily on open terrain without loss of balance.\"")
