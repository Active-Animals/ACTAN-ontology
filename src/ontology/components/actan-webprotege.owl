# Class: obo:ACTAN_0000715 (expulsion kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000715 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000715 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000715 "2025-05-21T09:34:43.235324Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasDefinition obo:ACTAN_0000715 "Kinetics that produces positive pressure in a cavity to pump out a fluid.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000715 "ejecting")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000715 "expelling")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000715 "expulsion")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") Annotation(skos:scopeNote "\"...extrusion of water...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000715 "extrusion")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000715 "force pump")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasNarrowSynonym obo:ACTAN_0000715 "exuding")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasNarrowSynonym obo:ACTAN_0000715 "secretion"@en)
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") Annotation(skos:scopeNote "\"...the method of ejaculation, i. e., whether sprayed or exuded...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000715 "ejaculation")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasRelatedSynonym obo:ACTAN_0000715 "releasing")
AnnotationAssertion(Annotation(dc:date "1983"^^xsd:decimal) Annotation(dc:source "doi:10.3354/meps011089") oboInOwl:hasRelatedSynonym obo:ACTAN_0000715 "squeezing from")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasRelatedSynonym obo:ACTAN_0000715 "squeezing out")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000715 "expulsion kinetics")
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:example obo:ACTAN_0000715 "\"It is easy to imagine how water captured with krill could be extruded from the mouth through the spaces between the cusps on Lobodon's teeth. Juvenile crabeater seals feeding on fish in captivity sucked them in individually and ejected excess water from the sides of their mouths.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:example obo:ACTAN_0000715 "\"Next to moving their tails up and down, the expelling of water from their mouths by rorqual whales is the most massive, single action taken by any organism that has ever lived.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000715 "\"Thalassoma cupido...
...pair dash rapidly upward, usually about 25-50 cm, where the eggs and milt are released.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:scopeNote obo:ACTAN_0000715 "\"Bodily secretions include saliva, wax, silk and even excrement, all of which can serve as effective glue for cementing external materials together.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9781482294347") skos:scopeNote obo:ACTAN_0000715 "\"In Cryptobranchus and Andrias, males guard oviposition sites in burrows or under rocks. Females are attracted to these sites and lay large yolky eggs in long strands, as in the anuran genus Bufo. Strands may be extruded from one oviduct or from both oviducts simultaneously. The resident male moves over the strands as they are laid and extrudes white, ropy masses of sperm, fertilizing the eggs.\"")
SubClassOf(obo:ACTAN_0000715 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000715 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001576))

# Class: obo:ACTAN_0000716 (sweeping movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000716 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000716 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000716 "2025-05-25T13:52:03.467358Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.00424") oboInOwl:hasDefinition obo:ACTAN_0000716 "Movement that involves extensive lateral excursions of an extremity.")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.00424") Annotation(rdfs:comment "2003"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000716 "lateral swinging")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1126/science.288.5463.100") oboInOwl:hasExactSynonym obo:ACTAN_0000716 "sweep")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(rdfs:comment "1859"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000716 "sweeping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000716 "sweeping movement")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:example obo:ACTAN_0000716 "\"As the tail sweeps back and forth, it creates a series of alternating vortices. Each stroke of the fin creates a single donut-shaped vortex that is linked to the vortices of previous strokes. Each vortex represents the momentum imparted to the water by the fish's body and tail.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000716 "\"The work of construction seems to be a sort of balance struck between many bees, all instinctively standing at the same relative distance from each other, all trying to sweep equal spheres, and then building up, or leaving ungnawed, the planes of intersection between these spheres.\"")
SubClassOf(obo:ACTAN_0000716 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000716 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002497))

# Class: obo:ACTAN_0000717 (excavation graze)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000717 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000717 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000717 "2026-07-28T11:07:24.650022Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF00751035") Annotation(skos:scopeNote "\"The term excavator implies removal of pieces of the substratum during feeding.\"") oboInOwl:hasDefinition obo:ACTAN_0000717 "Graze which removes pieces of the substratum during feeding.")
AnnotationAssertion(Annotation(dc:date "1990"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF00751035") oboInOwl:hasExactSynonym obo:ACTAN_0000717 "gouging")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/1365-2435.13457") Annotation(dc:source "2020"^^xsd:decimal) Annotation(rdfs:comment "This source bundles excavating and scraping into a single term 'scraping', although the  earlier defining author is at pains to separate them.") oboInOwl:hasRelatedSynonym obo:ACTAN_0000717 "scraping")
AnnotationAssertion(Annotation(dc:date "1990"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF00751035") Annotation(skos:scopeNote "\"...excavation during grazing...\"") rdfs:label obo:ACTAN_0000717 "excavation graze"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF00751035") skos:example obo:ACTAN_0000717 "\"The excavators... functional group contains Cetoscarus bicolor, Bolbometopon muricatum and a range of species currently included in the genus Scarus...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF00751035") skos:scopeNote obo:ACTAN_0000717 "\"In the field, excavating species take relatively few bites per minute, but each bite is slow and large, and excavates the substratum, leaving distinct scars.\"")
SubClassOf(obo:ACTAN_0000717 obo:ACTAN_0000355)
SubClassOf(obo:ACTAN_0000717 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000282))

# Class: obo:ACTAN_0000718 (expiration respiration)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000718 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000718 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000718 "2025-05-21T19:06:13.306559Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Compositional definition.") oboInOwl:hasDefinition obo:ACTAN_0000718 "Respiration that blows.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...laborious breathing...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000718 "breathing out")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000718 "exhalation")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000718 "expiration"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000718 "expiration respiration"@en)
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:scopeNote obo:ACTAN_0000718 "\"During expiration, the pharynx contracts and the velum moves posteriorly, forcing water over gill filaments and out the external branchiopore.\"")
SubClassOf(obo:ACTAN_0000718 obo:ACTAN_0000676)
SubClassOf(obo:ACTAN_0000718 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000780))

# Class: obo:ACTAN_0000719 (inspiration respiration)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000719 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000719 "Ditch Townsend")
