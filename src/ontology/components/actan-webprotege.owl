# Class: obo:ACTAN_0000221 (DSDC pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000221 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000221 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000221 "2024-10-02T08:53:53.498342Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/20.1.255") Annotation(skos:scopeNote "\"DSDC walk
A form of true walking characterized by (1) the footfalls formula of right hind–left front–(pause)–left hind–right front, and (1) the animal spends most of its time supported on diagonal pairs of limbs (such as the right hind and left front). This is frequently seen in arboreal animals like primates.\"") oboInOwl:hasDefinition obo:ACTAN_0000221 "Contralateral-bipodal pattern that involves the footfall formula of right hind–left front–(pause)–left hind–right front.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000221 "DSDC"@en)
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000221 "diagonal sequence, diagonal couplet")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000221 "DSDC pattern"@en)
SubClassOf(obo:ACTAN_0000221 obo:ACTAN_0000142)
SubClassOf(obo:ACTAN_0000221 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002392))

# Class: obo:ACTAN_0000222 (LS-single-foot gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000222 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000222 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000222 "2024-10-02T08:54:19.55354Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icac125") Annotation(skos:scopeNote "\"Lateral sequence
A characteristic of some walking gaits in which the footfall of a given hindfoot is followed next by the footfall of the forefoot on the same side, such as the right hind–right front–left hind–left front pattern.\"") oboInOwl:hasDefinition obo:ACTAN_0000222 "Single-foot gait in which the footfall of a given hindfoot is followed next by the footfall of the forefoot on the same side.")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000222 "lateral-sequence, single-foot"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000222 "LS-single-foot gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/20.1.255") skos:example obo:ACTAN_0000222 "\"The elephant uses the lateral sequence single-foot because that gait is smoother than the pace or trot and avoids suspensions, matters of importance to so huge an animal.\"")
SubClassOf(obo:ACTAN_0000222 obo:ACTAN_0000137)
SubClassOf(obo:ACTAN_0000222 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001193))

# Class: obo:ACTAN_0000223 (DS-single-foot gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000223 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000223 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000223 "2024-10-02T08:54:25.702247Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icac125") Annotation(skos:scopeNote "\"Diagonal sequence
A characteristic of some walking gaits in which the footfall of a given hindfoot is followed next by the footfall of the forefoot on the opposite side, such as the right hind–left front–left hind–right front pattern.\"") oboInOwl:hasDefinition obo:ACTAN_0000223 "Single-foot gait in which the footfall of a given hindfoot is followed next by the footfall of the forefoot on the opposite side.")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000223 "diagonal sequence, single-foot"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000223 "DS-single-foot gait")
SubClassOf(obo:ACTAN_0000223 obo:ACTAN_0000137)
SubClassOf(obo:ACTAN_0000223 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002392))

