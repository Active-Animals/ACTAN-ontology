AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000025 "ovum")
AnnotationAssertion(rdfs:label obo:CL_0000025 "egg cell")
SubClassOf(Annotation(oboInOwl:is_inferred "true") obo:CL_0000025 obo:CL_0000675)

# Class: obo:CL_0000300 (gamete)

AnnotationAssertion(oboInOwl:hasDefinition obo:CL_0000300 "A mature sexual reproductive cell having a single set of unpaired chromosomes.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:CL_0000300 "haploid nucleated cell")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:CL_0000300 "haploid germ cell")
AnnotationAssertion(rdfs:label obo:CL_0000300 "gamete")
SubClassOf(obo:CL_0000300 obo:CL_0000413)

# Class: obo:CL_0000408 (male gamete)

AnnotationAssertion(oboInOwl:hasDefinition obo:CL_0000408 "Any male germ cell that has characteristic some haploid and is capable of some fertilization.")
AnnotationAssertion(rdfs:label obo:CL_0000408 "male gamete")
SubClassOf(Annotation(oboInOwl:is_inferred "true") obo:CL_0000408 obo:CL_0000300)

# Class: obo:CL_0000413 (haploid cell)

AnnotationAssertion(oboInOwl:hasDefinition obo:CL_0000413 "A cell whose nucleus contains a single haploid genome.")
AnnotationAssertion(rdfs:label obo:CL_0000413 "haploid cell")
SubClassOf(obo:CL_0000413 obo:CL_0000000)

# Class: obo:CL_0000675 (female gamete)

AnnotationAssertion(oboInOwl:hasDefinition obo:CL_0000675 "A mature sexual reproductive cell of the female germline.")
AnnotationAssertion(rdfs:label obo:CL_0000675 "female gamete")
SubClassOf(obo:CL_0000675 obo:CL_0000300)

# Class: obo:COB_0000022 (organism)

AnnotationAssertion(obo:IAO_0000115 obo:COB_0000022 "A material entity that is a maximal functionally integrated unit that develops from a program encoded in a genome"@en)
AnnotationAssertion(obo:IAO_0000116 obo:COB_0000022 "'Maximal functionally integrated unit' is intended to express unity, which Barry considers synonymous with BFO 'object'."@en)
AnnotationAssertion(obo:IAO_0000116 obo:COB_0000022 "Includes virus - we will later have a class for cellular organisms."@en)
AnnotationAssertion(rdfs:label obo:COB_0000022 "organism"@en)
SubClassOf(obo:COB_0000022 obo:PCO_0000031)
SubClassOf(obo:COB_0000022 obo:UBERON_0000465)

# Class: obo:ECOCORE_00000089 (predator)

AnnotationAssertion(obo:IAO_0000115 obo:ECOCORE_00000089 "A carnivore that actively captures and consumes other animals, causing their immediate or immenent death")
AnnotationAssertion(obo:IAO_0000117 obo:ECOCORE_00000089 "http://orcid.org/0000-0002-2908-3327")
AnnotationAssertion(rdfs:label obo:ECOCORE_00000089 "predator")
SubClassOf(obo:ECOCORE_00000089 obo:COB_0000022)

# Class: obo:ECOCORE_00000148 (prey)

AnnotationAssertion(obo:IAO_0000115 obo:ECOCORE_00000148 "An organism that is consumed in whole or in part by a predator")
AnnotationAssertion(rdfs:label obo:ECOCORE_00000148 "prey")
SubClassOf(obo:ECOCORE_00000148 obo:COB_0000022)

# Class: obo:ENVO_00000063 (water body)

AnnotationAssertion(oboInOwl:hasDefinition obo:ENVO_00000063 "Definition: An accumulation of water of varying size.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:ENVO_00000063 "aquatic feature")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:ENVO_00000063 "waterbody")
AnnotationAssertion(rdfs:comment obo:ENVO_00000063 "The term body of water most often refers to large accumulations of water, such as oceans, seas, and lakes, but it includes smaller pools of water such as ponds, wetlands, or more rarely, puddles. A body of water does not have to be still or contained; Rivers, streams, canals, and other geographical features where water moves from one place to another are also considered bodies of water."@en)
AnnotationAssertion(rdfs:label obo:ENVO_00000063 "water body")
SubClassOf(obo:ENVO_00000063 obo:ENVO_01000685)

# Class: obo:ENVO_00000501 (submerged bed)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_00000501 "The portion of the ground surface which lies below water.")
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:ENVO_00000501 "BOTTOM")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00000501 "EcoLexicon:bed")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00000501 "FTT:804")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00000501 "SWEETRealm:Bottom")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00000501 "https://en.wikipedia.org/wiki/Stream_bed")
AnnotationAssertion(rdfs:label obo:ENVO_00000501 "submerged bed")
SubClassOf(obo:ENVO_00000501 obo:ENVO_01001311)

# Class: obo:ENVO_00001998 (soil)

AnnotationAssertion(oboInOwl:hasBroadSynonym obo:ENVO_00001998 "regolith")
AnnotationAssertion(oboInOwl:hasDefinition obo:ENVO_00001998 "Definition: An environmental material which is primarily composed of minerals, varying proportions of sand, silt, and clay, organic material such as humus, interstitial gases, liquids, and a broad range of resident micro- and macroorganisms.")
AnnotationAssertion(rdfs:comment obo:ENVO_00001998 "'In engineering terms, soil is referred to as regolith, or loose rock material that lies above the 'solid geology'. Soil is commonly referred to as \"earth\" or \"dirt\"; technically, the term \"dirt\" should be restricted to displaced soil.' https://en.wikipedia.org/wiki/Soil

\" The upper limit of soil is the boundary between soil and air, shallow water, live plants, or plant materials that have not begun to decompose. Areas are not considered to have soil if the surface is permanently covered by water too deep (typically more than 2.5 meters) for the growth of rooted plants.

The lower boundary that separates soil from the nonsoil underneath is most difficult to define. Soil consists of horizons near the Earth's surface that, in contrast to the underlying parent material, have been altered by the interactions of climate, relief, and living organisms over time. Commonly, soil grades at its lower boundary to hard rock or to earthy materials virtually devoid of animals, roots, or other marks of biological activity. For purposes of classification, the lower boundary of soil is arbitrarily set at 200 cm.\"  Soil taxonomy, 2nd Ed., quoted in http://www.nrcs.usda.gov/wps/portal/nrcs/detail/soils/edu/?cid=nrcs142p2_054280")
AnnotationAssertion(rdfs:label obo:ENVO_00001998 "soil")
SubClassOf(obo:ENVO_00001998 obo:ENVO_00010483)

# Class: obo:ENVO_00002005 (air)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://en.wikipedia.org/wiki/Air") obo:IAO_0000115 obo:ENVO_00002005 "The mixture of gases (roughly (by molar content/volume: 78% nitrogen, 20.95% oxygen, 0.93% argon, 0.038% carbon dioxide, trace amounts of other gases, and a variable amount (average around 1%) of water vapor) that surrounds the planet Earth.")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00002005 "EcoLexicon:air")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00002005 "LTER:18")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00002005 "SWEETRealm:Air")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00002005 "https://en.wikipedia.org/wiki/Air")
AnnotationAssertion(oboInOwl:inSubset obo:ENVO_00002005 <http://purl.obolibrary.org/obo/envo#EnvO-Lite-GSC>)
AnnotationAssertion(oboInOwl:inSubset obo:ENVO_00002005 "envoPolar")
AnnotationAssertion(rdfs:label obo:ENVO_00002005 "air")
SubClassOf(obo:ENVO_00002005 obo:ENVO_00010483)

# Class: obo:ENVO_00002006 (liquid water)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "MA:ma") obo:IAO_0000115 obo:ENVO_00002006 "An environmental material primarily composed of dihydrogen oxide in its liquid form.")
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:ENVO_00002006 "water")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00002006 "EcoLexicon:water")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00002006 "LTER:617")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00002006 "https://en.wikipedia.org/wiki/Water")
AnnotationAssertion(rdfs:label obo:ENVO_00002006 "liquid water")
SubClassOf(obo:ENVO_00002006 obo:ENVO_00010483)

# Class: obo:ENVO_00002007 (sediment)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://en.wikipedia.org/wiki/Sediment") obo:IAO_0000115 obo:ENVO_00002007 "Particulate environmental material which is formed as a result of the transport and deposition of particles by flowing liquid."@en)
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00002007 "EcoLexicon:sediment")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00002007 "EcoLexicon:sedimentation")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00002007 "LTER:492")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00002007 "LTER:493")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00002007 "SWEETRealm:Sediment")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_00002007 "https://en.wikipedia.org/wiki/Sediment")
AnnotationAssertion(oboInOwl:inSubset obo:ENVO_00002007 <http://purl.obolibrary.org/obo/envo#EnvO-Lite-GSC>)
AnnotationAssertion(oboInOwl:inSubset obo:ENVO_00002007 "envoPolar")
AnnotationAssertion(rdfs:comment obo:ENVO_00002007 "Sediment is typically deposited on the bed or bottom of a body of water or other liquid."@en)
AnnotationAssertion(rdfs:label obo:ENVO_00002007 "sediment")
SubClassOf(obo:ENVO_00002007 obo:ENVO_01000060)

# Class: obo:ENVO_00010483 (environmental material)

AnnotationAssertion(oboInOwl:hasExactSynonym obo:ENVO_00010483 "portion of environmental material")
AnnotationAssertion(rdfs:comment obo:ENVO_00010483 "Everything under this parent must be a mass noun (i.e. not countable). All subclasses are to be understood as being composed primarily of the named entity, rather than restricted to that entity. For example, \"ENVO:water\" is to be understood as \"environmental material composed primarly of some CHEBI:water\"."@en)
AnnotationAssertion(rdfs:comment obo:ENVO_00010483 "Instances of this class are portions of environmental materials, such as seawater in bucket, a water parcel in the photic zone of a lake, or the concrete that composes a building part. Instances of these portions may have fiat or non-fiat boundaries. For example, a water parcel has not physical boundaries, while the seawater in a bucket is bounded by the internal surfaces of the bucket."@en)
AnnotationAssertion(rdfs:isDefinedBy obo:ENVO_00010483 <http://purl.allotrope.org/voc/afo/REC/2024/06/afo>)
AnnotationAssertion(rdfs:label obo:ENVO_00010483 "environmental material")
AnnotationAssertion(skos:definition obo:ENVO_00010483 "An environmental material is a fiat object which forms the medium or part of the medium of an environmental system. [ENVO]")
SubClassOf(obo:ENVO_00010483 obo:BFO_0000040)

# Class: obo:ENVO_00010504 (surface layer)

AnnotationAssertion(oboInOwl:hasDefinition obo:ENVO_00010504 "Definition: A layer of some material entity which is adjacent to one or more of its external boundaries and directly interacts with its immediate surroundings.")
AnnotationAssertion(rdfs:label obo:ENVO_00010504 "surface layer")
SubClassOf(obo:ENVO_00010504 obo:ENVO_01001684)

# Class: obo:ENVO_01000060 (particulate environmental material)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01000060 "An environmental material which is composed primarily of particles."@en)
AnnotationAssertion(obo:IAO_0000116 obo:ENVO_01000060 "Do not oversimplify this branch with design patterns or similar. The materials have properties that their components do not - write full definitions including these where possible."@en)
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:ENVO_01000060 "particulate matter"@en)
AnnotationAssertion(rdfs:label obo:ENVO_01000060 "particulate environmental material"@en)
SubClassOf(obo:ENVO_01000060 obo:ENVO_00010483)

# Class: obo:ENVO_01000155 (organic material)

AnnotationAssertion(oboInOwl:created_by obo:ENVO_01000155 "ORCID:0000-0002-4366-3088")
AnnotationAssertion(oboInOwl:creation_date obo:ENVO_01000155 "2010-03-20T08:40:04Z")
AnnotationAssertion(oboInOwl:hasDefinition obo:ENVO_01000155 "Definition: Environmental material derived from living organisms and composed primarily of one or more biomacromolecules.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:ENVO_01000155 "biomass")
AnnotationAssertion(rdfs:label obo:ENVO_01000155 "organic material")
SubClassOf(obo:ENVO_01000155 obo:ENVO_00010483)

# Class: obo:ENVO_01000254 (environmental system)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "DOI:10.1186/2041-1480-4-43") obo:IAO_0000115 obo:ENVO_01000254 "A system which has the disposition to environ one or more material entities.")
AnnotationAssertion(oboInOwl:creation_date obo:ENVO_01000254 "2013-09-23T16:04:08Z")
AnnotationAssertion(oboInOwl:hasDbXref obo:ENVO_01000254 "EcoLexicon:environment")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:ENVO_01000254 "environment")
AnnotationAssertion(rdfs:comment obo:ENVO_01000254 "In ENVO's alignment with the Basic Formal Ontology, this class is being considered as a subclass of a proposed BFO class \"system\". The relation \"environed_by\" is also under development. Roughly, a system which includes a material entity (at least partially) within its site and causally influences that entity may be considered to environ it. Following the completion of this alignment, this class' definition and the definitions of its subclasses will be revised.")
AnnotationAssertion(rdfs:label obo:ENVO_01000254 "environmental system")
SubClassOf(obo:ENVO_01000254 obo:BFO_0000040)

# Class: obo:ENVO_01000267 (atmosphere)

AnnotationAssertion(oboInOwl:created_by obo:ENVO_01000267 "ORCID:0000-0002-4366-3088")
AnnotationAssertion(oboInOwl:creation_date obo:ENVO_01000267 "2013-10-10T08:14:50Z")
AnnotationAssertion(oboInOwl:hasDefinition obo:ENVO_01000267 "Definition: An atmosphere is a layer of gases surrounding a material body of sufficient mass that is held in place by the gravity of the body.")
AnnotationAssertion(rdfs:label obo:ENVO_01000267 "atmosphere")
SubClassOf(obo:ENVO_01000267 obo:ENVO_01001678)

# Class: obo:ENVO_01000281 (layer)

AnnotationAssertion(oboInOwl:created_by obo:ENVO_01000281 <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(oboInOwl:creation_date obo:ENVO_01000281 "2013-10-15T16:42:02Z")
AnnotationAssertion(oboInOwl:hasDefinition obo:ENVO_01000281 "Definition: A material entity which 1) is spatially continuous, 2) is composed of material of comparable thickness, composition, and physical properties, and 3) is physically distinct from adjacent portions of environmental material.")
AnnotationAssertion(rdfs:label obo:ENVO_01000281 "layer")
SubClassOf(obo:ENVO_01000281 obo:BFO_0000040)

# Class: obo:ENVO_01000685 (water mass)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01000685 "A mass of water.")
AnnotationAssertion(rdfs:label obo:ENVO_01000685 "water mass"@en)
SubClassOf(obo:ENVO_01000685 obo:ENVO_01001476)

# Class: obo:ENVO_01000739 (habitat)

AnnotationAssertion(oboInOwl:hasDefinition obo:ENVO_01000739 "Definition: An environmental system which can sustain and allow the growth of an ecological population.")
AnnotationAssertion(rdfs:comment obo:ENVO_01000739 "A habitat's specificity to an ecological population differentiates it from other environment classes.")
AnnotationAssertion(rdfs:label obo:ENVO_01000739 "habitat"@en)
SubClassOf(obo:ENVO_01000739 obo:ENVO_01000813)
SubClassOf(obo:ENVO_01000739 obo:ENVO_01001110)

# Class: obo:ENVO_01000813 (astronomical body part)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01000813 "A material part of an astronomical body.")
AnnotationAssertion(obo:IAO_0000116 obo:ENVO_01000813 "Also note that some astronomical body parts (ABPs) may have fiat boundaries: if there's strong debate about where an ABP begins or ends (over and above fuzzy boundaries), with different official classifications setting different thresholds or limits, axiomatise the class with fiat boundaries of the appropriate dimension."@en)
AnnotationAssertion(obo:IAO_0000116 obo:ENVO_01000813 "Note that material entities may have immaterial entities (e.g. sites) as parts."@en)
AnnotationAssertion(obo:IAO_0000116 obo:ENVO_01000813 "This class includes material parts of astronomical bodies. Immaterial parts, such as magnetospheres, are represented as sites under the influence of magnetic fields.Please post countercases in the ENVO tracker for revision of this hierarchy if needed."@en)
AnnotationAssertion(rdfs:comment obo:ENVO_01000813 "Material parts of astronomical bodies generally have boundaries formed by discontinuities in qualities, composition, or other physical characterisitcs. These boundaries are sometimes sharp, and sometimes diffuse, with different classification systems and communities declaring varying thresholds (e.g. for where a shoreline, forest, or other entity begins and ends). However, some boundaries are declared by fiat - that is, by arbitrary human convention or decree - particularly by regulatory or other authorities and communities of practice. The classes in this hierarchy attempt to offer generalisable definitions that allow multiple classfiication systems to map to and interoperate through. If desired, we can create classes that declare thresholds used by a given authority or community under the more generic ones, annotated with source information."@en)
AnnotationAssertion(rdfs:label obo:ENVO_01000813 "astronomical body part"@en)
SubClassOf(obo:ENVO_01000813 obo:BFO_0000040)

# Class: obo:ENVO_01000814 (solid environmental material)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01000814 "An environmental material which is in a solid state.")
AnnotationAssertion(rdfs:comment obo:ENVO_01000814 "This is a defined class: its subclasses will not be asserted, but filled by inference.")
AnnotationAssertion(rdfs:label obo:ENVO_01000814 "solid environmental material"@en)
SubClassOf(obo:ENVO_01000814 obo:ENVO_00010483)

# Class: obo:ENVO_01001023 (radiation)

AnnotationAssertion(oboInOwl:hasDefinition obo:ENVO_01001023 "Definition: A process during which energy is emitted or transmitted in the form of waves or particles through space or a material medium.")
AnnotationAssertion(rdfs:label obo:ENVO_01001023 "radiation"@en)
SubClassOf(obo:ENVO_01001023 obo:ENVO_01001852)

# Class: obo:ENVO_01001026 (electromagnetic radiation)

AnnotationAssertion(oboInOwl:hasDefinition obo:ENVO_01001026 "Definition: A radiation process during which waves (or their quanta, photons) of the electromagnetic field propagate (radiate) through space carrying electromagnetic energy.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:ENVO_01001026 "EM radiation")
AnnotationAssertion(rdfs:comment obo:ENVO_01001026 "Note that this class is concerned only with active radiative processes: static electric and magnetic fields are not inlcuded. All electromagnetic radiation carries radiant energy.")
AnnotationAssertion(rdfs:label obo:ENVO_01001026 "electromagnetic radiation"@en)
SubClassOf(obo:ENVO_01001026 obo:ENVO_01001023)

# Class: obo:ENVO_01001110 (ecosystem)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://en.wikipedia.org/wiki/Ecosystem") obo:IAO_0000115 obo:ENVO_01001110 "An environmental system which includes both living and non-living components.")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://vocab.lternet.edu/vocab/vocab/index.php?tema=173&/ecosystems") oboInOwl:hasDbXref obo:ENVO_01001110 "LTER:173")
AnnotationAssertion(rdfs:comment obo:ENVO_01001110 "This class will be primarily filled by inference, any environmental system which necessarily includes living parts should be autoclassified here.")
AnnotationAssertion(rdfs:label obo:ENVO_01001110 "ecosystem"@en)
SubClassOf(obo:ENVO_01001110 obo:ENVO_01000254)

# Class: obo:ENVO_01001192 (sediment surface)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01001192 "The surface layer of a mass of sediment.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:ENVO_01001192 "surface of a sedimentary mass")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:ENVO_01001192 "surface sediment")
AnnotationAssertion(rdfs:label obo:ENVO_01001192 "sediment surface"@en)
SubClassOf(obo:ENVO_01001192 obo:ENVO_00010504)

# Class: obo:ENVO_01001308 (hydroform)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01001308 "A liquid astronomical body part which is primarily composed of a continuous volume of liquid water and is held in shape or sustained by an environmental process.")
AnnotationAssertion(Annotation(oboInOwl:created_by "ORCID:0000-0002-4366-3088") obo:IAO_0000116 obo:ENVO_01001308 "Should create links to envrionmental process with new relation like \"sustained_by\"")
AnnotationAssertion(rdfs:comment obo:ENVO_01001308 "Similar, in spirit, to landform.")
AnnotationAssertion(rdfs:label obo:ENVO_01001308 "hydroform")
SubClassOf(obo:ENVO_01001308 obo:ENVO_01001477)

# Class: obo:ENVO_01001309 (liquid air-water interface layer)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01001309 "A liquid surface layer which is in contact with air.")
AnnotationAssertion(rdfs:label obo:ENVO_01001309 "liquid air-water interface layer"@en)
SubClassOf(obo:ENVO_01001309 obo:ENVO_01001310)

# Class: obo:ENVO_01001310 (liquid surface layer)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01001310 "A surface layer which is composed primarily of some liquid.")
AnnotationAssertion(rdfs:label obo:ENVO_01001310 "liquid surface layer"@en)
