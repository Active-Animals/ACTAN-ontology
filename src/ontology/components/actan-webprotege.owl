# Class: obo:ACTAN_0000042 (coast kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000042 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000042 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000042 "2025-01-01T21:22:45.531016Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasDefinition obo:ACTAN_0000042 "Kinetics in which horizontal locomotion continues without propulsion, and with a reduced drag profile.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasExactSynonym obo:ACTAN_0000042 "coast"@en)
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000042 "coasting")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000042 "glide")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000042 "coast kinetics"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") rdfs:seeAlso obo:ACTAN_0000042 obo:ACTAN_0000253)
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") rdfs:seeAlso obo:ACTAN_0000042 obo:ACTAN_0000574)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.021360") skos:example obo:ACTAN_0000042 "\"...in bluegill sunfish, Lepomis macrochirus...
...forward movement of the fish with the caudal fin rays adducted to reduce surface area and with the tail held in line with the body.\"")
SubClassOf(obo:ACTAN_0000042 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000042 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001023))

# Class: obo:ACTAN_0000043 (plankton travel)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000043 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000043 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000043 "2025-01-06T16:27:26.557228Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasDefinition obo:ACTAN_0000043 "Travel that relies on suspension in moving fluid surroundings.

The ratio of inertial to viscous forces (measured by the Reynolds number) will be too low to enable independant locomotion, and also allows fluid currents to have a greater impact than gravity or density.")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasExactSynonym obo:ACTAN_0000043 "nature adrift")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000043 "plancton")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasExactSynonym obo:ACTAN_0000043 "plankter")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasExactSynonym obo:ACTAN_0000043 "plankton"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000043 "plankton travel")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000043 "\"...planctonic forms with extended surfaces to assist in flotation.\"")
SubClassOf(obo:ACTAN_0000043 obo:ACTAN_0000178)
SubClassOf(obo:ACTAN_0000043 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0015029))

# Class: obo:ACTAN_0000044 (colony participation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000044 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000044 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000044 "2025-01-07T08:49:46.790524Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.jstor.org/stable/986582") Annotation(skos:scopeNote "\"Colonial associations can reach this degree of integration either via (1) increased genetic homogeneity (genetic convergence of interests), (2) increased efficiency of suppression and control of reproductive competitors (imposed convergence of interests), and/or (3) increased mutual dependence due to a common dependence on the presence of other group members, or mutually exclusive task specialization (mutualistic convergence of interests).\"") oboInOwl:hasDefinition obo:ACTAN_0000044 "Participation which involves an integrated association.")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasExactSynonym obo:ACTAN_0000044 "colonial association")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000044 "colony"@en)
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasExactSynonym obo:ACTAN_0000044 "integration")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000044 "colony participation")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000044 "\"So we do not believe that the colonies of fish or birds are a result of lack of nesting places;... the tendency is to crowd as much as possible.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pone.0200048") skos:scopeNote obo:ACTAN_0000044 "\"Thus, we suggest that monitoring abiotic factors such as humidity and temperature in honeybee hives could be a strategy for identifying colonies having disturbance in their normal functioning as a eusocial community, and help to find the eventual factors leading to the decline of a honeybee colony.\"")
SubClassOf(obo:ACTAN_0000044 obo:ACTAN_0000409)
SubClassOf(Annotation(dc:source "doi:10.1163/156853981X00220") obo:ACTAN_0000044 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000577))
SubClassOf(obo:ACTAN_0000044 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000111))

# Class: obo:ACTAN_0000045 (unkenreflex posture)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000045 <https://github.com/Active-Animals/Ontology/patterns/posture>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000045 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000045 "2025-06-17T20:22:17.845321Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/brv.12891") Annotation(skos:scopeNote "\"The ‘unken reflex’, named after the fire-bellied toads ‘Feuerunke’ (Löhner, 1919), is a proximate cause of deimatic behaviour but little is known about its mechanistic underpinnings. Typically only applied to amphibians, it manifests as a rigid arching or lifting of the body, legs, and/or tail in which ventral surfaces become visible and sometimes body parts are ‘hypnotically’ swayed.\"") oboInOwl:hasDefinition obo:ACTAN_0000045 "Posture that manifests in varying degrees of rigid arching and lifting of the body, legs, and tail, and in which ventral surfaces become visible.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1111/brv.12891") oboInOwl:hasExactSynonym obo:ACTAN_0000045 "arched-back posture")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1111/brv.12891") oboInOwl:hasExactSynonym obo:ACTAN_0000045 "unken reflex")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2014.08.051") rdfs:label obo:ACTAN_0000045 "unkenreflex posture"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000045 obo:ACTAN_0000626)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2014.08.051") skos:example obo:ACTAN_0000045 "\"Fire-bellied toads (Bombina spp.), for example, assume contorted postures akin to thanatosis when attacked (the unkenreflex) which reveal bright colours warning of their deterrent taste.\"")
SubClassOf(obo:ACTAN_0000045 obo:ACTAN_0000177)
SubClassOf(obo:ACTAN_0000045 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000731))
SubClassOf(obo:ACTAN_0000045 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000008))
SubClassOf(obo:ACTAN_0000045 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))

# Class: obo:ACTAN_0000046 (emergence switch)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000046 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000046 "2024-09-08T08:09:49.201971Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1126/science.288.5463.100") Annotation(skos:scopeNote "\"These systems possess functional properties that emerge only when they interact with each other and the environment.\"") oboInOwl:hasDefinition obo:ACTAN_0000046 "Switch which requires a functional property that only occurs when systems interact with each other and the environment.")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1140/epjst/e2008-00633-y") Annotation(skos:scopeNote "\"...lead to behavior... in an emergent way.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000046 "emergent behavior")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rspb.1998.0424") Annotation(rdfs:comment "\"...a different locomotion paradigm emerges...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000046 "emergent paradigm")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000046 "synergy")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000046 "emergence switch"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fnbeh.2010.00049") skos:example obo:ACTAN_0000046 "\"...studies of overt crawling and swimming confirmed that leeches will quickly switch to a crawling mode when encountering shallow water. Furthermore, when fluid levels were ambiguous, a swim-crawl hybrid locomotor pattern emerged... Thus the decision to locomote is hierarchical, made at the level of a single higher-order descending interneuron, but the switching (and selection in this case) of various forms of locomotion is based on the integration of contextual somatosensory cues.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2009.03.018") skos:example obo:ACTAN_0000046 "\"...the characteristic V formations of flocks of geese... is an emergent property of the simultaneous interactions of multiple individuals, it cannot be exhibited by a single individual.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00426-009-0242-2") skos:scopeNote obo:ACTAN_0000046 "\"...numerous studies have shown that tool use is accompanied by its incorporation into the neural representation of the body, and... after extensive training, neurons in monkey area F5 that used to code manual grasping, may also come to code grasps performed with a tool—independently of the hand movements involved. Together, these findings suggest that the capacity to use such simple tools might emerge from experience-dependent changes within cerebral areas involved in the control of manual actions.\"")
SubClassOf(obo:ACTAN_0000046 obo:ACTAN_0000541)

# Class: obo:ACTAN_0000047 (collective-formation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000047 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000047 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000047 "2025-07-24T20:24:11.385078Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1371/journal.pcbi.1002915") oboInOwl:hasDefinition obo:ACTAN_0000047 "Behavioural disposition that is realized in a dynamically stable spatio-temporal behavior pattern.")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "doi:10.1126/science.1125142") oboInOwl:hasExactSynonym obo:ACTAN_0000047 "collective motion"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1371/journal.pcbi.1002915") Annotation(skos:scopeNote "\"...self-structuring properties of groups...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000047 "group self-structuring")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/beheco/12.5.534") oboInOwl:hasNarrowSynonym obo:ACTAN_0000047 "chevron formation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000047 "collective-formation")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000047 obo:ACTAN_0000411)
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.1125142") skos:example obo:ACTAN_0000047 "\"Locust aggregations will build into major outbreaks only if locally gregarized populations remain together and move collectively into neighboring areas of habitat, where they can recruit further locusts to the growing band.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pcbi.1002915") skos:scopeNote obo:ACTAN_0000047 "\"The spontaneous emergence of pattern formation is ubiquitous in nature, often arising as a collective phenomenon from interactions among a large number of individual constituents or sub-systems...

...collective properties, such as the spatio-temporal configurations exhibited, may be robust to exactly how behavioral tendencies such as repulsion, alignment and attraction are mediated.\"")
SubClassOf(obo:ACTAN_0000047 <http://humanbehaviourchange.org/ontology/BCIO_050416>)
SubClassOf(obo:ACTAN_0000047 ObjectSomeValuesFrom(obo:BFO_0000051 obo:PCO_0000000))

# Class: obo:ACTAN_0000048 (disorder formation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000048 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000048 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000048 "2025-07-27T11:04:50.31077Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1371/journal.pcbi.1002915") Annotation(skos:scopeNote "\"For example, models representing local repulsion, directional alignment and longer-range attraction among individuals predict that groups in which individuals follow these behavioral rules exhibit only three collective states; a swarm state in which individuals aggregate but are locally and globally disordered, a milling state in which individuals have a high degree of alignment with local neighbors but overall the group exhibits a rotating milling formation (or torus, in threedimensional space) and a polarized state in which individuals tend to be aligned with each other over a long range and consequently the group experiences net movement...

Individuals reaching the wall slow down and tend to become disordered (unaligned) and the group can transition into the swarm state.\"") oboInOwl:hasDefinition obo:ACTAN_0000048 "Formation in which individuals aggregate but are locally and globally unaligned.")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "doi:10.1126/science.1125142") oboInOwl:hasExactSynonym obo:ACTAN_0000048 "disordered motion"@en)
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "doi:10.1126/science.1125142") oboInOwl:hasExactSynonym obo:ACTAN_0000048 "disordered movement")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasRelatedSynonym obo:ACTAN_0000048 "milling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000048 "disorder formation")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000048 "\"Thalassoma cupido...
The groups observed at the spawning site may be best described as loose aggregations of milling fish. The aggregating fish swim an irregular path, frequently changing direction so that individual members often vary in their orientation.\"")
SubClassOf(obo:ACTAN_0000048 obo:ACTAN_0000047)
SubClassOf(obo:ACTAN_0000048 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001654))

# Class: obo:ACTAN_0000049 (peristaltic-creeping gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000049 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000049 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000049 "2026-01-14T10:45:07.128202Z")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.202.6.661") oboInOwl:hasBroadSynonym obo:ACTAN_0000049 "peristaltic crawling")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.202.6.661") Annotation(skos:scopeNote "\"Typically, the radially expanded regions anchor the organisms to the substratum while the radially contracted regions advance over the substratum.\"") oboInOwl:hasDefinition obo:ACTAN_0000049 "Creeping gait in which radially expanded regions anchor the organisms to the substratum while the radially contracted regions advance over the substratum.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000049 "peristaltic-creeping gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.202.6.661") skos:example obo:ACTAN_0000049 "\"The surface-crawling habit of L. terrestris is reflected in its morphology. For example, the bristle-like setae that provide traction for the radially expanded segments are present only on the ventral and lateral surfaces rather than uniformly around the circumference of the worm, as found in purely geophagous earthworms.\"")
SubClassOf(obo:ACTAN_0000049 obo:ACTAN_0000225)
SubClassOf(obo:ACTAN_0000049 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000469))
SubClassOf(obo:ACTAN_0000049 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000743))
SubClassOf(obo:ACTAN_0000049 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000744))
SubClassOf(obo:ACTAN_0000049 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000931))
SubClassOf(obo:ACTAN_0000049 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000052))
SubClassOf(obo:ACTAN_0000049 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000796))

# Class: obo:ACTAN_0000050 (pelvic-fin abducting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000050 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000050 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000050 "2026-07-12T08:14:56.353461Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000050 "Abducting which involves a pelvic fin.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000050 "pelvic-fin abducting"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00227-014-2403-0") skos:scopeNote obo:ACTAN_0000050 "\"...for... similar style of active benthic foraging... in coral reef fishes... pelvic fins were the most frequently adopted fin type during behaviours involving slow-speed movement...\"")
SubClassOf(obo:ACTAN_0000050 obo:ACTAN_0000738)
SubClassOf(obo:ACTAN_0000050 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000152))

# Class: obo:ACTAN_0000051 (pedestrian mode)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000051 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000051 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000051 "2024-09-08T11:19:21.67384Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasDefinition obo:ACTAN_0000051 "Mode that uses appendages for supported activity.")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF00197760") oboInOwl:hasExactSynonym obo:ACTAN_0000051 "legged")
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.158.1.369") oboInOwl:hasExactSynonym obo:ACTAN_0000051 "pedestrian")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1002/jmor.10788") oboInOwl:hasNarrowSynonym obo:ACTAN_0000051 "apterous")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000051 "pedestrian mode")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.156.1.215") skos:example obo:ACTAN_0000051 "\"At all speeds, P. americana ran using two alternating set(s) of one, two or three legs... At speeds less than 1.0 ms\"1, P. americana ran using an alternating tripod stepping pattern.... P. americana attained an aerial phase at the fastest speeds (1.0-1.5ms\"1). High-speed video recordings (300 frames s\"1) showed that, at these high speeds, the insect raises its body off the substratum (from 0.5 to 1.0 cm) and increases its body's angle of attack (from 0 to 30° relative to the horizontal). In half of the high-speed runs (N=13), cockroaches used only four legs (i.e. middle and hind legs). In the other half of the high-speed runs, cockroaches ran bipedally, propelling themselves exclusively with their hind legs.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.158.1.369") skos:scopeNote obo:ACTAN_0000051 "\"Pedestrians that vary in leg number and design can generate similar ground reaction force patterns. Running humans, trotting dogs, cockroaches and sideways-running crabs can move their bodies by producing alternating propulsive forces. Two legs in a trotting quadrupedal mammal, three legs in an insect and four legs in a crab can act as one leg does in a biped during ground contact.\"")
SubClassOf(obo:ACTAN_0000051 obo:ACTAN_0000010)
SubClassOf(obo:ACTAN_0000051 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ENVO_01001790))

# Class: obo:ACTAN_0000052 (limbless mode)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000052 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000052 "2024-09-08T11:20:53.074287Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "This applies to animals which are taxonomic tetrapods, and not to soft-bodied invertebrates with hydrostatic skeltons (i.e. NOT worms or leeches).") oboInOwl:hasDefinition obo:ACTAN_0000052 "Pedestrian mode that uses no appendages.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000052 "limbless"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000052 "limbless mode"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.009050") skos:scopeNote obo:ACTAN_0000052 "\"...a key advantage of the limbless body plan and behaviors used by snakes in cluttered arboreal habitats may be the small cross-sectional area required for moving.\"")
SubClassOf(obo:ACTAN_0000052 obo:ACTAN_0000051)

# Class: obo:ACTAN_0000053 (monoped mode)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000053 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000053 "2024-09-08T11:24:23.556432Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") Annotation(rdfs:comment "This term is functional, i.e. treat bipodal hopping as functionally monpedal (or imagine a single widely bisulcate/cloven foot/hoof).") oboInOwl:hasDefinition obo:ACTAN_0000053 "Pedestrian mode that uses one appendage.")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") oboInOwl:hasExactSynonym obo:ACTAN_0000053 "monoped"@en)
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF00197760") oboInOwl:hasExactSynonym obo:ACTAN_0000053 "monopode")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") oboInOwl:hasRelatedSynonym obo:ACTAN_0000053 "monopod")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3390/ani13162557") oboInOwl:hasRelatedSynonym obo:ACTAN_0000053 "unipedal support")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000053 "monoped mode"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") skos:scopeNote obo:ACTAN_0000053 "\"Therefore, hopping species can be considered functionally monopedal.\"")
SubClassOf(obo:ACTAN_0000053 obo:ACTAN_0000051)

# Class: obo:ACTAN_0000054 (biped mode)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000054 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000054 "2024-09-08T11:25:45.607072Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Inferred.") oboInOwl:hasDefinition obo:ACTAN_0000054 "Pedestrian mode that uses two appendages.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000054 "biped"@en)
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.158.1.369") oboInOwl:hasExactSynonym obo:ACTAN_0000054 "two legged")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000054 "biped mode"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") skos:example obo:ACTAN_0000054 "\"...bipedal birds which walk and run (turkey and rhea); ...and bipedal mammals which hop (kangaroo and springhare).\"")
SubClassOf(obo:ACTAN_0000054 obo:ACTAN_0000051)

