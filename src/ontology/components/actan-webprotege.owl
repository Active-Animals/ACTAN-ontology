AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"Body in a horizontal position, dorsalis, analis and pelvics closed against the body, caudalis closed.\"") oboInOwl:hasDefinition obo:ACTAN_0000589 "Flexing that closes the dorsal fin against the body.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...dorsalis... closed...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000589 "dorsal closing")
