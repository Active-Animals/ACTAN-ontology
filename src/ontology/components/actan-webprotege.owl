# Class: obo:ACTAN_0000790 (tail-rub deimatism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000790 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000790 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000790 "2025-08-06T20:17:27.741082Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"Tail rubbing, a behavior found only in large-bodied rattlesnakes, was mostly performed by gravid females. This behavior is associated with cloacal sac discharge and its function appears to be to spread exudates over the body of the snake. Such secretions may serve as a noxious defense to deter predators.\"") oboInOwl:hasDefinition obo:ACTAN_0000790 "Deimatism that spreads cloacal sac exudates using the tail.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000790 "tail rubbing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000790 "tail-rub deimatism"@en)
AnnotationAssertion(Annotation(rdfs:comment "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000790 "\"Instead of an active defense, a gravid female before flight may rely on more passive defensive behavior, such as chemical defense (see tail rubbing behavior, below).\"")
SubClassOf(obo:ACTAN_0000790 obo:ACTAN_0000626)
SubClassOf(obo:ACTAN_0000790 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000417))

# Class: obo:ACTAN_0000791 (wing-thrash bathe)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000791 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000791 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000791 "2025-08-10T15:46:57.881439Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"The bird half rises on the water, leans to one side, and rapidly beats the partly opened wings on the surface of the water.\"") oboInOwl:hasDefinition obo:ACTAN_0000791 "Bathe that rapidly beats the partly opened wings on the surface of the water.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000791 "wing-thrashing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000791 "wing-thrash bathe"@en)
SubClassOf(obo:ACTAN_0000791 obo:ACTAN_0000760)
SubClassOf(obo:ACTAN_0000791 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000765))
SubClassOf(obo:ACTAN_0000791 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000860))

# Class: obo:ACTAN_0000792 (somersault bathe)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000792 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000792 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000792 "2025-08-10T15:47:14.005151Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"The bird dips the breast and neck forward into the water and kicks vigorously with the feet at the same time, thus immersing the fore part of the body. The head is held against the back as the breast goes forward. The belly is now uppermost and the feet kick in the air until the body rolls over sideways and returns to the upright position.\"") oboInOwl:hasDefinition obo:ACTAN_0000792 "Bathe in which a bird kicks vigorously, the head is held against the back, the belly turns uppermost, and the body rolls over sideways and returns to the upright position.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"Bathing : somersaulting.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000792 "somersaulting bathing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000792 "somersault bathe"@en)
SubClassOf(obo:ACTAN_0000792 obo:ACTAN_0000760)
SubClassOf(obo:ACTAN_0000792 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000003))
SubClassOf(obo:ACTAN_0000792 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000692))

# Class: obo:ACTAN_0000793 (head-scoop bathe)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000793 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000793 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000793 "2025-08-10T15:53:32.34801Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"The head is dipped forward under the water and rapidly withdrawn so that water is thrown over the back. As the head is lifted it may be turned sideways so that the water is scooped back with the cheek.\"") oboInOwl:hasDefinition obo:ACTAN_0000793 "Bathe in which the head is dipped forward under the water and rapidly withdrawn so that water is thrown over the back.

As the head is lifted it may be turned sideways so that the water is scooped back with the cheek.\"")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000793 "head-dipping")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000793 "head-pumping")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000793 "neck-dipping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000793 "head-scoop bathe"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000793 "\"...a characteristic element of the male pre-copulatory behaviour... in Steller's Eider, up to 17 consecutive head-dips being recorded.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000793 "\"Head-dipping (without wing shuffling) is common in the pre-flight situation in the American Goldeneye and American Merganser;\"")
SubClassOf(obo:ACTAN_0000793 obo:ACTAN_0000760)
SubClassOf(obo:ACTAN_0000793 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000724))
SubClassOf(obo:ACTAN_0000793 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000727))

# Class: obo:ACTAN_0000794 (appendage extending)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000794 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000794 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000794 "2026-07-29T09:29:23.073599Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.120.1.283") Annotation(skos:scopeNote "\"The left appendages are frequently extended further away from the centre of the track than the right appendages.\"") oboInOwl:hasDefinition obo:ACTAN_0000794 "Extending that involves an appendage.")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") Annotation(skos:scopeNote "\"...extending the left legs...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000794 "leg extending")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") Annotation(skos:scopeNote "\"...limbs are extended...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000794 "limb extending")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") Annotation(skos:scopeNote "\"...appendages are frequently extended...\"") rdfs:label obo:ACTAN_0000794 "appendage extending"@en)
AnnotationAssertion(skos:example obo:ACTAN_0000794 "\"In the footprint pattern of C. compressus the second appendages (L2 and R2) tend to fall outside or lateral to the third (L3 and R3), and the chelipeds are positioned along the centre of the track. This pattern is not invariable; commonly, the third limbs are extended outwards so that they fall in line with or even outside L2 and R2.\"")
SubClassOf(obo:ACTAN_0000794 obo:ACTAN_0000726)
SubClassOf(obo:ACTAN_0000794 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000026))

# Class: obo:ACTAN_0000795 (shake oscillation)

