AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...laborious breathing...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000719 "breathing in")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000719 "inhalation")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000719 "inspiration"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000719 "inspiration respiration"@en)
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:scopeNote obo:ACTAN_0000719 "\"At the onset of inspiration, the velum moves forward and the pharynx begins to expand. Enlargement of the central lumen and parabranchial chambers draws some water in through the branchiopore under the still-closing branchial valve, and flow over the gills is medial. Later in inspiration, the gill pores are entirely shut, and the expanding parabranchial chambers draw water laterally again across the filaments.\"")
SubClassOf(obo:ACTAN_0000719 obo:ACTAN_0000676)
SubClassOf(obo:ACTAN_0000719 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000590))

# Class: obo:ACTAN_0000720 (chattering gaping)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000720 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000720 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000720 "2025-05-25T13:54:22.242338Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "ISBN:9780226315737") Annotation(skos:scopeNote "\"With each cycle, the jaws open and close slightly (maximum and minimum gape during feeding in A. platyrhynchos equal 14 mm and 3 mm. This is accomplished as much by elevation of the maxillae, which rotate through ~ 13° with each cycle, as by depression of the mandible. The fast oscillations of the jaws help suck water into the mouth and give it momentum.\"") oboInOwl:hasDefinition obo:ACTAN_0000720 "Mouthing in which the jaws open and close slightly with fast oscillations.")
AnnotationAssertion(Annotation(dc:date "2025"^^xsd:decimal) Annotation(dc:source "doi:10.1073/pnas.2503495122") oboInOwl:hasExactSynonym obo:ACTAN_0000720 "chattering"@en)
AnnotationAssertion(Annotation(dc:date "2025"^^xsd:decimal) Annotation(dc:source "doi:10.1073/pnas.2503495122") oboInOwl:hasRelatedSynonym obo:ACTAN_0000720 "clapping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000720 "chattering gaping")
AnnotationAssertion(Annotation(dc:source "doi:10.1073/pnas.2503495122") skos:example obo:ACTAN_0000720 "\"...flamingos use their chattering mandibles, morphing feet, and S-curved long necks to self-generate vortical structures spanning from the bottom to the air–water interface.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1073/pnas.2503495122") skos:scopeNote obo:ACTAN_0000720 "\"...flamingos produce a vertical flow up to ~7 cm/s while “clapping” their mandibles at an oscillation rate of ~12 Hz.\"")
SubClassOf(obo:ACTAN_0000720 obo:ACTAN_0000847)
SubClassOf(obo:ACTAN_0000720 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000380))

# Class: obo:ACTAN_0000721 (sweep roving)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000721 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000721 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000721 "2025-05-25T16:50:27.016602Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.00424") oboInOwl:hasDefinition obo:ACTAN_0000721 "Hunt in which a short but slow, open-mouthed, lateral search is followed by a rapid, directed attack.")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.00424") oboInOwl:hasExactSynonym obo:ACTAN_0000721 "head sweeping")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.00424") oboInOwl:hasExactSynonym obo:ACTAN_0000721 "lateral striking")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.00424") oboInOwl:hasExactSynonym obo:ACTAN_0000721 "sideways sweeping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000721 "sweep roving")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.00424") skos:example obo:ACTAN_0000721 "\"Head sweeping by Thamnophis elegans... As the snake travels forward, the head is swung from side to side primarily by movements of the anterior trunk.\"")
SubClassOf(obo:ACTAN_0000721 obo:ACTAN_0000359)
SubClassOf(obo:ACTAN_0000721 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000122))
SubClassOf(obo:ACTAN_0000721 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000716))

# Class: obo:ACTAN_0000722 (precision grip)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000722 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000722 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000722 "2025-05-26T09:41:36.744701Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/s00426-009-0242-2") oboInOwl:hasDefinition obo:ACTAN_0000722 "Grip which uses opposed end-effectors and minimal power to manipulate an object.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1111/brv.12010") oboInOwl:hasExactSynonym obo:ACTAN_0000722 "precision grasp")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00426-009-0242-2") oboInOwl:hasExactSynonym obo:ACTAN_0000722 "precision pinch")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00426-009-0242-2") Annotation(rdfs:comment "2009"^^xsd:decimal) rdfs:label obo:ACTAN_0000722 "precision grip"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000722 "\"...the acutest observer by examining the dead body of the water-ouzel would never have suspected its sub-aquatic habits; yet this anomalous member of the strictly terrestrial thrush family wholly subsists by diving,—grasping the stones with its feet...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000722 "\"A dominant individual grasps the hand extended to him by a subordinate for reassurance,\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") skos:example obo:ACTAN_0000722 "\"The mating position in Lepidoptera is relatively homogenous. The male usually initiates contact in a side-by-side position, bending his highly moveable abdomen up to 180° towards the female until the tip of her abdomen can be grasped by the claspers.\"")
SubClassOf(obo:ACTAN_0000722 obo:ACTAN_0000628)
SubClassOf(obo:ACTAN_0000722 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002246))

# Class: obo:ACTAN_0000723 (gape placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000723 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000723 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000723 "2025-05-26T16:23:20.5588Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasDefinition obo:ACTAN_0000723 "Placement in which the gape is open.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.1111/mms.13009") oboInOwl:hasExactSynonym obo:ACTAN_0000723 "agape")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000723 "ajar"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000723 "gaping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000723 "gape placement")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:example obo:ACTAN_0000723 "\"Scallop swimming provides a simple example of a muscle generating positive work to act as a motor. The cycle begins... when the gape of the shell is maximal.\"")
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") skos:example obo:ACTAN_0000723 "\"Suspension-feeding ducks have relatively long and broad bills. The larger, upper bill in these birds bows upward in cross section to canopy completely the lower bill and the tongue when the mouth is closed. A row of keratinized lamellae lines the lateral margins of both beaks. When the mouth is slightly ajar, the lamellae on the upper jaw oppose the lamellae on the lower jaw and may act as sieves for straining particles from the water.\"")
SubClassOf(obo:ACTAN_0000723 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000723 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000122))

# Class: obo:ACTAN_0000724 (head dipping)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000724 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000724 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000724 "2025-05-26T19:15:24.119463Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/j.1444-2906.2003.00797.x") Annotation(skos:scopeNote "\"Head down threat: a display shown by a territory holder to neighboring invaders near the boundary. The territory holder threatens the invaders by slightly dipping its head.\"") oboInOwl:hasDefinition obo:ACTAN_0000724 "Dipping which is head down.")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") Annotation(skos:scopeNote "\"...lowering or raising the head...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000724 "head lowering")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000724 "head-dipping"@en)
AnnotationAssertion(rdfs:label obo:ACTAN_0000724 "head dipping")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000724 "\"Attitude of inferiority...
C. meeki with the head down...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000724 "\"Spawning in Nocomis leptocephalus...
Pit-digging occurred as the male dipped his head and drove his snout into the pit floor while vigorously beating his tail.\"")
SubClassOf(obo:ACTAN_0000724 obo:ACTAN_0000598)
SubClassOf(obo:ACTAN_0000724 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000033))

# Class: obo:ACTAN_0000725 (head flick)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000725 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000725 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000725 "2025-05-27T08:30:37.567767Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"The head is rapidly jerked up, shaken laterally once or twice, and at the same time rotated around the long axis as in body-shaking, then returned to the resting position.\"") oboInOwl:hasDefinition obo:ACTAN_0000725 "Flick in which the head is jerked, then returned to the resting position.

It may be up, laterally, or rotated around the long axis.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000725 "head-flick"@en)
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasRelatedSynonym obo:ACTAN_0000725 "rotary-head-shaking")
AnnotationAssertion(rdfs:label obo:ACTAN_0000725 "head flick"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000725 obo:ACTAN_0000767)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000725 "\"In Cygnus, the head-flick is entirely rotary and the head is not jerked upward... The lateral component seems to be absent or poorly developed in large birds with long necks.\"")
SubClassOf(obo:ACTAN_0000725 obo:ACTAN_0000678)
SubClassOf(obo:ACTAN_0000725 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000033))

# Class: obo:ACTAN_0000726 (extending movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000726 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000726 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000726 "2025-05-27T09:15:46.892233Z")
AnnotationAssertion(Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") Annotation(terms:contributor "https://orcid.org/0000-0002-4277-2151") oboInOwl:hasDefinition obo:ACTAN_0000726 "Movement that increases the angle between two joined body parts.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000726 "extending")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000726 "extension"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000726 "putting out")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000726 "erecting")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000726 "erection")
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") oboInOwl:hasRelatedSynonym obo:ACTAN_0000726 "lowering")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000726 "opening")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000726 "raising")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasRelatedSynonym obo:ACTAN_0000726 "retraction")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000726 "setting up")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasRelatedSynonym obo:ACTAN_0000726 "straightening")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1073/pnas.2122563119") oboInOwl:hasRelatedSynonym obo:ACTAN_0000726 "telescoping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000726 "extending movement"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000726 obo:ACTAN_0000083)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000726 obo:ACTAN_0000523)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:example obo:ACTAN_0000726 "\"Ascent on larger supports (e.g. > 20 cm in chimpanzees and baboons) angled >=45 degrees in which the elbow is extended.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:scopeNote obo:ACTAN_0000726 "\"Fin raise (fin extension/erection): Raising the dorsal fin...; common in zebrafish during aggression and courtship.\"")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") skos:scopeNote obo:ACTAN_0000726 "In the case where an appendage is swung through a dorsal/ventral arc in a transverse plane (e.g. flapping), our terms related to abduction and adduction are preferred.

In the case where an appendage is moved through a dorsal/ventral arc but parallel to the body (alongside/parasagitally), our terms related to protraction and retraction are preferred.")
SubClassOf(obo:ACTAN_0000726 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000726 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002327))

# Class: obo:ACTAN_0000727 (raising kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000727 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000727 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000727 "2025-05-27T15:15:24.405667Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasDefinition obo:ACTAN_0000727 "Kinetics that vertically accelerates a mass against gravity.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000727 "raising")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasNarrowSynonym obo:ACTAN_0000727 "hauling")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasNarrowSynonym obo:ACTAN_0000727 "hoisting")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasRelatedSynonym obo:ACTAN_0000727 "elevation")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasRelatedSynonym obo:ACTAN_0000727 "lift")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000727 "lifting"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000727 "raising kinetics")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000727 "\"...each aphis, as soon as it felt the antennæ, immediately lifted up its abdomen and excreted a limpid drop of sweet juice, which was eagerly devoured by the ant.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000727 "\"Nocomis leptocephalus...
seized a pebble with his jaws, lifted his head and swam forward...\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9781482294347") skos:example obo:ACTAN_0000727 "\"Plethodon shermani. The female has stopped over the spermatophore and is lowering her cloaca over it. The male lifting his tail base under the female’s chin as she removes the sperm cap from the spermatophore..\"")
SubClassOf(obo:ACTAN_0000727 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000727 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001230))

# Class: obo:ACTAN_0000728 (clamber gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000728 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000728 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000728 "2025-05-27T17:16:00.380386Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"CANT defined the mode as follows: \"the body is orthograde with the head superior, and various combinations of all the four appendages attach to substrates in different ways, including suspension by the forelimbs from above.\"") oboInOwl:hasDefinition obo:ACTAN_0000728 "Climbing gait in which the body is orthograde, suspended, and various combinations of appendages attach in different ways, in net tension.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000728 "clamber")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000728 "clambering"@en)
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1005565304671") oboInOwl:hasExactSynonym obo:ACTAN_0000728 "uncoupled movement"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000728 "clamber gait")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000728 obo:ACTAN_0000729)
AnnotationAssertion(Annotation(dc:source "doi:10.1023/A:1005565304671") skos:scopeNote obo:ACTAN_0000728 "\"Thus, branch spacing dictates step lengths, thereby limiting potential choices in gait patterns and frequently requiring patterns that would be awkward or impractical on the ground. The latter case is best exemplified by the lateral stem gaits that uncouple the movements of the forelimb pair from those of the hind limb pair. The forelimbs first touch down in sequence, then the hind limbs.\"")
SubClassOf(obo:ACTAN_0000728 obo:ACTAN_0000256)
SubClassOf(obo:ACTAN_0000728 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000628))
SubClassOf(obo:ACTAN_0000728 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000710))
SubClassOf(obo:ACTAN_0000728 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000056))
SubClassOf(obo:ACTAN_0000728 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000169))
SubClassOf(obo:ACTAN_0000728 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000187))

# Class: obo:ACTAN_0000729 (scramble gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000729 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000729 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000729 "2025-05-27T17:16:10.644337Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"Scramble (= pronograde clamber): torso-pronograde ( - ) , nonsuspensory quadrupedal progression lacking a regular gait.\"") oboInOwl:hasDefinition obo:ACTAN_0000729 "Stepping gait which is irregular, non-suspensory, and the body is pronograde.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000729 "pronograde clamber")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000729 "scrambling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000729 "scramble gait")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000729 obo:ACTAN_0000728)
SubClassOf(obo:ACTAN_0000729 obo:ACTAN_0000124)
SubClassOf(obo:ACTAN_0000729 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000628))
SubClassOf(obo:ACTAN_0000729 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000710))
SubClassOf(obo:ACTAN_0000729 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000056))
