AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000833 "Extension that results from hindlimb extending.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000833 "hindlimb extension"@en)
SubClassOf(obo:ACTAN_0000833 obo:ACTAN_0000799)
SubClassOf(obo:ACTAN_0000833 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002103))

# Class: obo:ACTAN_0000834 (protection caring)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000834 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000834 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000834 "2025-09-14T14:25:23.533098Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"That the fish is also guarding the brood soon appears when others approach it. When they are not very much bigger than the guarding fish, they are heavily attacked.\"") oboInOwl:hasDefinition obo:ACTAN_0000834 "Caring which attacks others approaching.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...the brood is guarded.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000834 "brood guarding")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000834 "brood protection")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...stands guard over its offspring...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000834 "offspring guarding")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...eggs were guarded...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000834 "egg guarding"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...protect its own eggs or young...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000834 "egg protecting")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...young are again guarded...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000834 "young guarding")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...protect its own eggs or young...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000834 "young protecting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000834 "protection caring")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000834 "\"In the dwarf-cichlids (Nannacara, Apistogramma), for instance, only the female guards the eggs (which are laid on a substrate) and leads the young.\"")
SubClassOf(obo:ACTAN_0000834 obo:ACTAN_0000479)
SubClassOf(obo:ACTAN_0000834 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000378))

# Class: obo:ACTAN_0000835 (forelimb abducting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000835 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000835 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000835 "2026-08-02T10:49:29.670192Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000835 "Abducting which involves a forelimb.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") Annotation(skos:scopeNote "\"...(i.e., abduct or protract) the upper arm.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000835 "arm abducting")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"...abduction of the forelimb...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000835 "forelimb abduction")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasRelatedSynonym obo:ACTAN_0000835 "humeral abduction")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000835 "forelimb abducting"@en)
SubClassOf(obo:ACTAN_0000835 obo:ACTAN_0000738)
SubClassOf(obo:ACTAN_0000835 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002102))

# Class: obo:ACTAN_0000836 (forelimb adducting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000836 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000836 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000836 "2026-08-02T10:49:47.747415Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000836 "Adducting which involves a forelimb.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasNarrowSynonym obo:ACTAN_0000836 "arms adducting")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"...adducted forelimbs move...\"") rdfs:label obo:ACTAN_0000836 "forelimb adducting"@en)
