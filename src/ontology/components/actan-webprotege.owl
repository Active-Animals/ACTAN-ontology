# Class: obo:ACTAN_0000663 (leapfrog aggregation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000663 <https://github.com/Active-Animals/Ontology/patterns/group_behaviour>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000663 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000663 "2025-04-20T17:55:44.96562Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1140/epjst/e2008-00633-y") oboInOwl:hasDefinition obo:ACTAN_0000663 "Aggregation in which milling encounters an impenetrable boundary, including a takeoff zone, a landing zone, and a stationary zone.

It involves a cohesive motion and direction.")
AnnotationAssertion(Annotation(dc:date "1976"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/4084834") oboInOwl:hasExactSynonym obo:ACTAN_0000663 "leapfrog feeding")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/bird_observer/vol39/iss4/4") oboInOwl:hasExactSynonym obo:ACTAN_0000663 "leapfrog foraging")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000663 "roller feeding'"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000663 "leapfrog aggregation")
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/bird_observer/vol39/iss4/4") skos:example obo:ACTAN_0000663 "\"On March 11, 2011, I observed a foraging flock of an estimated 1000+ Redwinged Blackbirds (Agelaius phoeniceus) that included some Brown-headed Cowbirds (Molothrus ater) leapfrog foraging in a cornfield near Kearney, Nebraska. The flock was foraging among the corn stubble and moving rapidly across the field, with the birds at the back end of the flock flying up and over those at the front end of the flock. As soon as birds were at the back edge of the flock, they flew and landed to become the front edge, producing a swirling or rolling effect for the mass of birds. I watched this dynamic foraging-flock movement for several minutes.\"")
SubClassOf(obo:ACTAN_0000663 obo:ACTAN_0000411)
SubClassOf(obo:ACTAN_0000663 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000405))
SubClassOf(obo:ACTAN_0000663 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000662))

# Class: obo:ACTAN_0000664 (torus aggregation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000664 <https://github.com/Active-Animals/Ontology/patterns/group_behaviour>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000664 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000664 "2025-04-21T12:05:09.342805Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1371/journal.pcbi.1002915") oboInOwl:hasDefinition obo:ACTAN_0000664 "Aggregation which is 3-dimensional, rotating, milling, and has no boundary interactions.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1371/journal.pcbi.1002915") oboInOwl:hasExactSynonym obo:ACTAN_0000664 "torus"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000664 "torus aggregation")
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pcbi.1002915") skos:scopeNote obo:ACTAN_0000664 "\"...shiner schools exhibit... a milling state, where each fish moves around the center of the group.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3354/meps011165") skos:scopeNote obo:ACTAN_0000664 "\"Copepods within a swarm were hopping up and sinking down against the slight water current with their heads diagonally downward.\"")
SubClassOf(obo:ACTAN_0000664 obo:ACTAN_0000411)
SubClassOf(obo:ACTAN_0000664 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000405))
SubClassOf(obo:ACTAN_0000664 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000662))

# Class: obo:ACTAN_0000665 (volume homeostasis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000665 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000665 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000665 "2025-04-23T14:00:46.632933Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.27.3.264") Annotation(skos:scopeNote "\"The animal can control both its gain and loss of coelenteric volume.\"") oboInOwl:hasDefinition obo:ACTAN_0000665 "Homeostasis that can gain and lose volume.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000665 "volume control"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000665 "volume homeostasis"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") skos:example obo:ACTAN_0000665 "\"Metridium senile exhibits a great variety of shapes of the body. These are brought about by continual slow muscular activity... by which the animal itself increases or reduces extension by controlling its coelenteric volume... chiefly through the siphonoglyph, though under certain conditions there may be suction into the coelenteron. Fluid is lost chiefly through reflex opening of the mouth. From time to time Metridium empties itself of fluid, and then refills in a few hours.\"")
SubClassOf(obo:ACTAN_0000665 obo:ACTAN_0000381)
SubClassOf(obo:ACTAN_0000665 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000743))
SubClassOf(obo:ACTAN_0000665 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000744))
SubClassOf(obo:ACTAN_0000665 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000918))

# Class: obo:ACTAN_0000666 (turgor homeostasis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000666 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000666 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000666 "2025-04-23T14:51:51.679912Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasDefinition obo:ACTAN_0000666 "Homeostasis that provides the tissue pressure necessary for shape and activity.")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rsbl.2009.0938") oboInOwl:hasExactSynonym obo:ACTAN_0000666 "inflation pressure")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000666 "turgor"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000666 "turgor homeostasis")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000666 obo:ACTAN_0000743)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000666 obo:ACTAN_0000744)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") skos:example obo:ACTAN_0000666 "\"In animals which, like Metridium, possess a hydrostatic skeleton, the high pressure and deformation following maximal retraction for a time disorganize the whole mechanism of response in a way which is without parallel in animals with jointed skeletons, like the Vertebrates... In the hydrostatic skeletal system muscular contraction involves far greater change in length. The contraction of the muscle may be of almost identical extent with the movement of a part, as in the carriage of the prey to the mouth by the contraction of an extended tentacle of Hydra. Such extensive movements cannot be performed without great deformation, and if they are performed quickly there must be great waste of energy in this. The slowness of muscular action in Metridium has been repeatedly illustrated, and in general the hydrostatic skeletal system is characteristic of slow-moving animals. Only in such slow animals can great tissue deformation be executed without great inefficiency.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rsbl.2009.0938") skos:example obo:ACTAN_0000666 "\"Turgid female toads give males the slip: a new mechanism of female mate choice in the Anura... inflated female toads are more difficult for males to hold on to, and that the ability of a female to inflate her body facilitates takeovers by larger rival males.\"")
SubClassOf(obo:ACTAN_0000666 obo:ACTAN_0000381)
SubClassOf(obo:ACTAN_0000666 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001025))

# Class: obo:ACTAN_0000667 (parenting caring)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000667 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000667 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000667 "2025-04-27T14:15:00")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") oboInOwl:hasBroadSynonym obo:ACTAN_0000667 "reproductive cooperation")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.jstor.org/stable/986582") Annotation(skos:scopeNote "\"In \"ordinary\" competition of this sort, the better the teeth the better the nutrition and hence, presumably, the greater the number or success of progeny; reproductive success is some simple direct function of quality.\"") oboInOwl:hasDefinition obo:ACTAN_0000667 "Caring that involves progeny.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000667 "parental care")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") oboInOwl:hasExactSynonym obo:ACTAN_0000667 "parenting")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") oboInOwl:hasNarrowSynonym obo:ACTAN_0000667 "parental defense")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000667 "parenting caring")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000667 obo:ACTAN_0000463)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000667 obo:ACTAN_0000829)
AnnotationAssertion(skos:broadMatch obo:ACTAN_0000667 "NBO:0000044")
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0000667 "\"...South American cichlid Laetacara araguaiae... reproductive cooperation between males and females of L. araguaiae is marked by division of labor in the early reproductive phases and by sharing of parental duties as brood develops.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") skos:example obo:ACTAN_0000667 "\"Several species of foxes have been observed living in bonded pairs sharing parenting duties...\"")
SubClassOf(obo:ACTAN_0000667 obo:ACTAN_0000479)
SubClassOf(obo:ACTAN_0000667 ObjectSomeValuesFrom(obo:RO_0000057 obo:PCO_0000020))

# Class: obo:ACTAN_0000668 (surface-water inspiration)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000668 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000668 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000668 "2025-05-04T12:58:06.476016Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.198.1.79") Annotation(skos:scopeNote "\"The role of a buccal gas bubble, held while performing aquatic surface respiration (ASR; ventilating the gills with surface water during hypoxia), was examined in benthic, intertidal Australian gobies.\"") oboInOwl:hasDefinition obo:ACTAN_0000668 "Water inspiration that ventilates the gills with surface water.

Common during hypoxia.")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.198.1.79") oboInOwl:hasExactSynonym obo:ACTAN_0000668 "ASR")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.198.1.79") oboInOwl:hasExactSynonym obo:ACTAN_0000668 "aquatic surface respiration"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(skos:scopeNote "\"...surface film was then inhaled...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000668 "surface film inhaling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000668 "surface-water inspiration")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000668 "NBO:0040004")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000668 "\"Their bodies were tilted upward anteriorly about 45°, just enough to bring their mouths into contact with the surface. The oxygen-rich surface film was then inhaled arid passed over the gills. The opercular movements appeared to be the same as those seen in normal aquatic respiration. At no time did a Badis badis entrap air bubbles in, or pass them through, the gill chamber.\"")
SubClassOf(obo:ACTAN_0000668 obo:ACTAN_0000826)
SubClassOf(obo:ACTAN_0000668 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01001309))

