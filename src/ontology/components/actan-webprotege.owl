# Class: obo:ACTAN_0000670 (hover stationing)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000670 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000670 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000670 "2025-04-28T14:03:49.924121Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000670 "Stationing that actively holds the body nearly motionless, without support, in a fluid medium.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000670 "hovering"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000670 "swimming on the spot")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000670 "hover stationing")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4084834") skos:example obo:ACTAN_0000670 "\"...a heron hovers over a single spot and reaches down with its bill to remove prey from the water.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000670 "\"I have often watched a tyrant flycatcher (Saurophagus sulphuratus) in South America, hovering over one spot and then proceeding to another, like a kestrel...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF01609520") skos:example obo:ACTAN_0000670 "\"Ioglossus, PtereIeotris (Gobidae) and Trimrna tevegae are examples of split-fin gobies engaging in hovering on or near coral reefs;\"")
SubClassOf(obo:ACTAN_0000670 obo:ACTAN_0000612)
SubClassOf(obo:ACTAN_0000670 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000149))
SubClassOf(obo:ACTAN_0000670 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000671))

# Class: obo:ACTAN_0000671 (thrust kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000671 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000671 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000671 "2025-04-28T15:10:53.722828Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1126/science.288.5463.100") oboInOwl:hasDefinition obo:ACTAN_0000671 "Kinetics that uses energy to move the body, with a variably oriented force.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000671 "motor effort")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000671 "propulsion"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000671 "thrust")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000671 "thrust kinetics")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.156.1.215") skos:example obo:ACTAN_0000671 "\"With the hind legs functioning as the primary propulsive units, P. americana may be able to overcome the limitations to stride length imposed by shorter limbs by lifting both front and middle legs off the ground.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:scopeNote obo:ACTAN_0000671 "\"From whale sperm to sperm whales, locomotion is almost always produced by appendages that oscillate or by bodies that undulate, pulse, or undergo peristaltic waves.\"")
SubClassOf(Annotation(dc:source "doi:10.1126/science.288.5463.100") obo:ACTAN_0000671 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000671 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001024))

# Class: obo:ACTAN_0000672 (jet pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000672 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000672 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000672 "2025-04-28T16:13:54.133797Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1098/rsos.170467") Annotation(skos:scopeNote "\"If the area of the orifice through which water is drawn and ejected were the same, the required increase in flow rate during refilling would negate the benefits gained during propulsion.\"") oboInOwl:hasDefinition obo:ACTAN_0000672 "Gait pattern in which water is ejected from a refillable space, through an orifice.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000672 "jet pattern")
SubClassOf(obo:ACTAN_0000672 obo:ACTAN_0000126)
SubClassOf(obo:ACTAN_0000672 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0002553))

# Class: obo:ACTAN_0000673 (deceleration manoeuvre)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000673 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000673 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000673 "2025-04-28T20:29:50.41247Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasDefinition obo:ACTAN_0000673 "Manoeuvre that involves a negative change in speed over a given time course.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000673 "decelerating"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000673 "deceleration")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.021360") oboInOwl:hasRelatedSynonym obo:ACTAN_0000673 "braking maneuver")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000673 "deceleration manoeuvre")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000673 obo:ACTAN_0000172)
AnnotationAssertion(Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") skos:example obo:ACTAN_0000673 "\"For example when the kangaroo decelerates downward and forward, its feet are flexed so that the Achilles tendons are stretched storing elastic energy.\"")
AnnotationAssertion(Annotation(rdfs:comment "doi:10.1093/icb/icac125") skos:example obo:ACTAN_0000673 "\"Mudskippers can elevate the mid-body during the stance phase of crutching behavior, but the body returns to full contact with the substrate as both pectoral fins are lifted during the swing phase. Because of this, mudskippers undergo marked deceleration when the pectoral fin is in swing phase, which does not permit continuous motion between cycles.\"")
SubClassOf(obo:ACTAN_0000673 obo:ACTAN_0000149)
SubClassOf(obo:ACTAN_0000673 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000651))
SubClassOf(obo:ACTAN_0000673 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001028))

# Class: obo:ACTAN_0000674 (anal-fin flexion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000674 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000674 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000674 "2026-07-27T08:00:04.987014Z")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"... vertical fins can be depressed...\"") oboInOwl:hasBroadSynonym obo:ACTAN_0000674 "vertical fin depression")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000674 "Flexion that results from anal fin flexing.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000674 "anal-fin flexion"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000674 "\"In the fastest forms the vertical fins can be depressed so completely as to mar the perfection of the streamline form in no way at all.\"")
SubClassOf(obo:ACTAN_0000674 obo:ACTAN_0000120)
SubClassOf(obo:ACTAN_0000674 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_4000163))

# Class: obo:ACTAN_0000675 (pivot steering)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000675 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000675 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000675 "2025-04-29T15:17:11.798708Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000675 "Steering in which an appendage causes body rotation.")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "ISBN:9781482294347") oboInOwl:hasExactSynonym obo:ACTAN_0000675 "pinwheeling")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000675 "pivot"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000675 "pivot steering"@en)
AnnotationAssertion(Annotation(rdfs:comment "ISBN:9781482294347") skos:example obo:ACTAN_0000675 "\"...in salamandrids: The apparent ancestral mode is to deposit the spermatophore two body lengths in front of the female, while facing her head-to-head. The male and female then pivot about ipsilateral forelimbs, rotating pinwheel (PWT) fashion, so that the female contacts the spermatophore (Salamandrina, Pleurodeles, Tylototriton).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000675 "\"...in turning by means of extending a single pectoral the pressure of the water on the extended dorsal and anal swings the fish around with the pectoral somewhat as a pivot. This is especially noticeable in long bodied forms, such as Esox.\"")
SubClassOf(obo:ACTAN_0000675 obo:ACTAN_0000645)
SubClassOf(obo:ACTAN_0000675 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000026))

# Class: obo:ACTAN_0000676 (respiration subsistence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000676 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000676 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000676 "2025-05-04T13:11:40.776567Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.198.1.79") oboInOwl:hasDefinition obo:ACTAN_0000676 "Subsistence which involves gas diffusion across barriers between the environment and the blood.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000676 "breathing")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000676 "respiration"@en)
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000676 "ventilation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000676 "respiration subsistence"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.198.1.79") skos:scopeNote obo:ACTAN_0000676 "\"Diffusion barriers for respiratory organs such as gills or lungs are typically 0.1–10 mm. Diffusion barriers in amphibians, which rely on cutaneous respiration for a significant proportion of O2 uptake, are typically 10–50mm.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:scopeNote obo:ACTAN_0000676 "\"The opercular movements appeared to be the same as those seen in normal aquatic respiration.\"")
SubClassOf(obo:ACTAN_0000676 obo:ACTAN_0000360)
SubClassOf(obo:ACTAN_0000676 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0001004))

# Class: obo:ACTAN_0000677 (buoyancy homeostasis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000677 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000677 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000677 "2025-05-04T13:43:36.412855Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.198.1.79") oboInOwl:hasDefinition obo:ACTAN_0000677 "Homeostasis that affects weight in water by the lift from a low density inclusion.

This may be a gas or lipid.")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.198.1.79") oboInOwl:hasExactSynonym obo:ACTAN_0000677 "buoyancy control")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.198.1.79") oboInOwl:hasExactSynonym obo:ACTAN_0000677 "hydrostatic function"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000677 "buoyancy homeostasis")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.00424") skos:example obo:ACTAN_0000677 "\"In contrast to Thamnophis sirtalis, another generalist garter snake capable of capturing aquatic prey, T. elegans appeared comfortable when fully immersed (i.e. it did not avoid complete submersion and regularly engaged in sustained bouts of swimming) and appeared to have greater buoyancy control.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.198.1.79") skos:example obo:ACTAN_0000677 "\"Negatively buoyant benthic gobies survive extreme hypoxia by performing aquatic surface respiration (ASR) in shallow water.\"")
SubClassOf(obo:ACTAN_0000677 obo:ACTAN_0000381)
SubClassOf(obo:ACTAN_0000677 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00002006))
SubClassOf(obo:ACTAN_0000677 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001019))

# Class: obo:ACTAN_0000678 (flick jerking)

