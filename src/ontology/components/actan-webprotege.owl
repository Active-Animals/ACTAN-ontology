# Class: obo:ACTAN_0000574 (drift regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000574 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000574 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000574 "2025-02-06T12:36:13.506217Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000574 "Swimming-regime that maintains some tilt in mid-water.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000574 "drifting"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000574 "vertical drift")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasRelatedSynonym obo:ACTAN_0000574 "coasting")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000574 "floating")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000574 "hanging")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000574 "drift regime")
AnnotationAssertion(Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") skos:example obo:ACTAN_0000574 "\"...the juvenile labrid Novaculichthys taeniouru, which looks like drifting algae (the deception enhanced by its seemingly disoriented movement);\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000574 "\"Nocomis leptocephalus...
As the male’s body relaxed parallel to the current, he drifted down stream to resume interim behavior (e.g., pit-posturing). Once released, the female continued to rise vertically into the water column, then quickly rolled upright and... drifted to a position behind the male from where she might initiate another spawning sequence.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000574 "\"The drifting back is generally not done in a position with the body axis parallel to the current, but at an angle to it equal to... the best possible position to initiate motion against the stream flow, instead of having to make that first flexure from the less effectual position directly in line with the flow.\"")
SubClassOf(obo:ACTAN_0000574 obo:ACTAN_0000088)
SubClassOf(obo:ACTAN_0000574 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000311))
SubClassOf(obo:ACTAN_0000574 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000289))
SubClassOf(obo:ACTAN_0000574 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000543))
SubClassOf(obo:ACTAN_0000574 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_06105011))

# Class: obo:ACTAN_0000575 (surfacing regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000575 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000575 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000575 "2025-02-06T16:43:42.415173Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000575 "Swimming-regime that actively approaches the air-water boundary from below.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000575 "surfacing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000575 "surfacing regime")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000575 obo:ACTAN_0000403)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000575 "\"Mustelus canis when chafed by confinement will often swim up vertically through the surface of the water and hold a position with the fore part of the body exposed for some time by the continued action of the submerged hind portion. Over one-third of the body is often so lifted, and for shorter times even as much as one-half has been noted. This gives a measure of the force exerted, for it is not a matter of momentum as in leaping, but simply a direct and continued “push.”\"")
SubClassOf(obo:ACTAN_0000575 obo:ACTAN_0000088)
SubClassOf(obo:ACTAN_0000575 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000189))
SubClassOf(obo:ACTAN_0000575 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000183))
SubClassOf(obo:ACTAN_0000575 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000543))
SubClassOf(obo:ACTAN_0000575 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

# Class: obo:ACTAN_0000576 (safety assessment)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000576 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000576 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000576 "2025-02-06T20:20:24.584795Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.3389/fetho.2023.1238167") oboInOwl:hasDefinition obo:ACTAN_0000576 "Assessment in which an individual accepts that local risks are low.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000576 "safety"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000576 "safety assessment")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:scopeNote obo:ACTAN_0000576 "\"Much of animal architecture functions as a physical barrier between organisms and a potentially hostile outside environment, thereby enabling critical activities (e.g. sleep, growth, care for offspring, and socializing) within the safety of the architecture.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000576 "\"We could imagine that living in herds is safer because animals assist each other in watching for enemies...\"")
SubClassOf(obo:ACTAN_0000576 obo:ACTAN_0000334)
SubClassOf(obo:ACTAN_0000576 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0008306))

# Class: obo:ACTAN_0000577 (basing residence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000577 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000577 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000577 "2025-02-06T20:21:58.644093Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000577 "Residence that establishes a key location which the animal spends more time in, and repeatedly returns to after exploring.")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasExactSynonym obo:ACTAN_0000577 "home base"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000577 "lived in")
AnnotationAssertion(rdfs:comment obo:ACTAN_0000577 "Puzzle: beds may not always be nests, and dens may not always be bases, if bases must be returned to. More thought about this branch is needed.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000577 "basing residence")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000577 obo:ACTAN_0000294)
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ece3.6372") skos:example obo:ACTAN_0000577 "\"A common bear den is generally composed of three compartments: (1) an entrance; (2) a tunnel that connects the entrance with the resting chamber; and (3) a chamber occupied by the nest, that is, the zone where the bear gathers vegetative material to build a bed.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF01609520") skos:example obo:ACTAN_0000577 "\"In coral reef fish communities we find several species foraging in the water column from a \"home base\" on the reef within a relatively restricted habitat or home range.\"")
SubClassOf(obo:ACTAN_0000577 obo:ACTAN_0000308)
SubClassOf(obo:ACTAN_0000577 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000544))

# Class: obo:ACTAN_0000578 (J turning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000578 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000578 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000578 "2025-02-06T21:15:26.355646Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000578 "Turning in which the body finely reorientates by slightly curving, with a characteristic bend at the tail.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000578 "J-bend"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000578 "J-turn")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000578 "L-shape")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000578 "J turning")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") skos:example obo:ACTAN_0000578 "\"We found that J-turns were initiated when prey lie in the lateral visual field and served to center prey in the anterior visual field.\"")
SubClassOf(obo:ACTAN_0000578 obo:ACTAN_0000174)
SubClassOf(obo:ACTAN_0000578 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0015020))

# Class: obo:ACTAN_0000579 (orienting transition)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000579 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000579 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000579 "2025-02-06T21:50:43.456088Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") oboInOwl:hasDefinition obo:ACTAN_0000579 "Transition that involves an animal's heading vector.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000579 "orientating")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasExactSynonym obo:ACTAN_0000579 "orienting"@en)
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1005565304671") oboInOwl:hasExactSynonym obo:ACTAN_0000579 "reorienting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:seeAlso obo:ACTAN_0000081) Annotation(rdfs:seeAlso obo:ACTAN_0000177) rdfs:comment obo:ACTAN_0000579 "Be careful not to confuse this with placement (e.g. the orientation of the thumb to the palm of the hand) or postural changes (e.g. inclination of the body to the ground, such as when lying or standing).")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000579 "orienting transition")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000579 obo:ACTAN_0000523)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/41.2.137") skos:example obo:ACTAN_0000579 "\"Female crickets orienting to a male calling song pause frequently and change direction primarily during pauses.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1023/A:1005565304671") skos:example obo:ACTAN_0000579 "\"Macaca radiata...
To begin a descent, the monkeys first reoriented themselves to align the liftoff and target lateral stems with the transverse plane of the body.\"")
SubClassOf(obo:ACTAN_0000579 obo:ACTAN_0000144)
SubClassOf(obo:ACTAN_0000579 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002448))

