# Class: obo:ACTAN_0000479 (caring breeding)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000479 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000479 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000479 "2024-11-18T17:00:32.540314Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.jstor.org/stable/986582") Annotation(skos:scopeNote "\"This could give females an advantage if correlated, in turn, with greater male strength, which might be reflected in higher genetic quality of the brood, or (if males participate in defense or feeding of the young) in more effective brood care.\"") oboInOwl:hasDefinition obo:ACTAN_0000479 "Breeding that, to varying degrees, defends and feeds the young.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1181774") oboInOwl:hasExactSynonym obo:ACTAN_0000479 "attending")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000479 "caring"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000479 "rearing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000479 "caring breeding"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000479 "\"...the parent (or companion)...young reared by foster parents or... that had been with their own parents... it is possible to have young reared by foster parents of other species...\"")
SubClassOf(obo:ACTAN_0000479 obo:ACTAN_0000443)
SubClassOf(obo:ACTAN_0000479 ObjectSomeValuesFrom(obo:BFO_0000055 obo:BFO_0000023))

# Class: obo:ACTAN_0000480 (mothering parenting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000480 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000480 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000480 "2024-11-18T17:00:44.109559Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3389/fetho.2023.1181774") Annotation(skos:scopeNote "\"We further tested for a greater proclivity of social buffering in montane snakes, which overwinter communally, than in lowland snakes, which mostly overwinter alone; and for a greater proclivity in females, which often aggregate during gestation and maternally attend their offspring.\"") oboInOwl:hasDefinition obo:ACTAN_0000480 "Parenting that involves a female.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...maternal instinct
...maternal love and care
...maternal hatred...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000480 "maternal instinct"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000480 "mother's care")
AnnotationAssertion(Annotation(dc:date "2017"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.copsyc.2017.02.026") oboInOwl:hasExactSynonym obo:ACTAN_0000480 "mothering")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000480 "mothering parenting")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000480 "NBO:0000150")
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0000480 "\"...South American cichlid Laetacara araguaiae... there is... an increase in the frequency of attacks shown by female (p<0.01) that could be a response to an increased demand for parental defense.\"")
SubClassOf(obo:ACTAN_0000480 obo:ACTAN_0000667)
SubClassOf(obo:ACTAN_0000480 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000383))

# Class: obo:ACTAN_0000481 (gestation mothering)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000481 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000481 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000481 "2024-11-18T17:00:56.430863Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/s002650100391") Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasDefinition obo:ACTAN_0000481 "Mothering that involves viviparity.

In mammals this is approximately the time from conceptional estrus until parturition.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s002650100391") oboInOwl:hasExactSynonym obo:ACTAN_0000481 "gestation"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") Annotation(skos:scopeNote "\"pregnant\"") oboInOwl:hasExactSynonym obo:ACTAN_0000481 "pregnancy")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000481 "gravid")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000481 "gestation mothering"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:example obo:ACTAN_0000481 "\"Female pitvipers frequently aggregate during gestation, with at least one species (Crotalus horridus) forming aggregations consisting of relatives, as pitvipers are capable of kin recognition.\"")
SubClassOf(obo:ACTAN_0000481 obo:ACTAN_0000480)
SubClassOf(obo:ACTAN_0000481 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000922))

# Class: obo:ACTAN_0000482 (parturition mothering)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000482 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000482 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000482 "2024-11-18T17:01:07.275532Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasDefinition obo:ACTAN_0000482 "Mothering in which viviparity terminates with the production of offspring.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"give birth\"") oboInOwl:hasExactSynonym obo:ACTAN_0000482 "giving birth"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000482 "parturition")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000482 "parturition mothering")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:scopeNote obo:ACTAN_0000482 "\"Our gravid females gave birth in August–September, at least one month before fall trials began.\"")
SubClassOf(obo:ACTAN_0000482 obo:ACTAN_0000480)
SubClassOf(obo:ACTAN_0000482 ObjectSomeValuesFrom(obo:RO_0000057 obo:COB_0000022))

# Class: obo:ACTAN_0000483 (cluster aggregation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000483 <https://github.com/Active-Animals/Ontology/patterns/group_behaviour>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000483 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000483 "2024-11-18T21:06:12.41754Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasDefinition obo:ACTAN_0000483 "Aggregation that is localised and stable.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000483 "cluster"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000483 "cluster aggregation")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000483 "\"From all the cells, both those just commenced and those completed, being thus crowned by a strong coping of wax, the bees can cluster and crawl over the comb without injuring the delicate hexagonal walls, which are only about one four-hundredth of an inch in thickness;\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pone.0200048") skos:scopeNote obo:ACTAN_0000483 "\"The nest thermoregulation strategies of eusocial insects can be passive (e.g., nest orientation, architecture) or active (e.g., clustering, incubation), depending on the species.\"")
SubClassOf(obo:ACTAN_0000483 obo:ACTAN_0000411)
SubClassOf(obo:ACTAN_0000483 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000047))
SubClassOf(obo:ACTAN_0000483 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001788))

# Class: obo:ACTAN_0000484 (signal copulation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000484 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000484 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000484 "2024-11-19T08:12:12.393575Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1017/S1464793104006700") oboInOwl:hasDefinition obo:ACTAN_0000484 "Copulation that signals to the mate.")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") oboInOwl:hasExactSynonym obo:ACTAN_0000484 "copulatory courting"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"...signal during copulation...\"") rdfs:label obo:ACTAN_0000484 "signal copulation")
AnnotationAssertion(Annotation(dc:source "doi:10.1017/S1464793104006700") skos:example obo:ACTAN_0000484 "\"One phenomenon suggesting the action of sexual selection on chemical signals in spiders is gustatorial courtship. Transfer of male glandular products and possibly of haemolymph to the female mouth during copulation is documented in erigonine (and suggested in linyphiine) linyphiids...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000484 "\"Rapid wing-shaking movements are performed by the male during copulation in several species of Mergini.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1017/S1464793104006700") skos:example obo:ACTAN_0000484 "\"Steatoda bipunctata... males of this and related species stridulate not only before but also during copulation...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:scopeNote obo:ACTAN_0000484 "\"The male mid legs are heavily involved in courtship behaviours both prior to and during copulation by either tapping, stroking or rubbing different parts of her body.\"")
SubClassOf(obo:ACTAN_0000484 obo:ACTAN_0000485)
SubClassOf(obo:ACTAN_0000484 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000414))

# Class: obo:ACTAN_0000485 (copulation gamete-release)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000485 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000485 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000485 "2024-11-19T08:12:26.602778Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") oboInOwl:hasDefinition obo:ACTAN_0000485 "Gamete-release that establishes, positions, and separates, contact for direct transfer.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000485 "copulation"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000485 "copulation gamete-release")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000485 "\"Chimpanzee...
Mount in copulation...
Squeal in copulation...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:example obo:ACTAN_0000485 "\"Young (1949) described a male Robin (Turdus migratorius) which tried to copulate with a female but she threatened him each time; the male then \"copulated\" with a mound of earth and a crumpled newspaper before the female responded sexually.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000485 "NBO:0000060")
SubClassOf(obo:ACTAN_0000485 obo:ACTAN_0000852)
SubClassOf(obo:ACTAN_0000485 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000925))

# Class: obo:ACTAN_0000486 (recycling kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000486 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000486 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000486 "2026-07-21T10:36:38.32217Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.020263") Annotation(skos:scopeNote "\"Since the energy (or momentum) involved in the circulation of the shed vortex was imparted by the fish, the energy was thus probably recycled on trapping the fluid mass, which is functionally similar to the vortex-based extraction of energy by aquatic animals that extracts energy from environmental vortices.\"") oboInOwl:hasDefinition obo:ACTAN_0000486 "Kinetics that extracts momentum from environmental vortices.")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.020263") Annotation(skos:scopeNote "\"...extracts energy...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000486 "extracting energy")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.020263") Annotation(skos:scopeNote "\"...energy was thus probably recycled...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000486 "recycled energy")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000486 "slipping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000486 "recycling kinetics"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000486 "\"The habit that many smaller fishes have of following larger ones.. may among other advantages, enable them to slip along with less effort than they would otherwise have to make... In a similar manner it would seem probable the lagging members of a school dropping behind from fatigue or exhaustion would be unconsciously helped along by their more sturdy brothers swimming in the van.\"")
SubClassOf(obo:ACTAN_0000486 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000486 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001023))

# Class: obo:ACTAN_0000487 (swerve turning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000487 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000487 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000487 "2026-07-21T12:57:03.995056Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"On this account, sharks are unable to make an abrupt stop, swerving to one side of an obstacle instead, for they are unable to use the pectorals or any other members as “brakes.”\"") oboInOwl:hasDefinition obo:ACTAN_0000487 "Fast turning that moves abruptly to one side without braking.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000487 "swerving")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000487 "swerve turning"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/20.1.255") skos:example obo:ACTAN_0000487 "\"...when a cheetah chases a blackbuck at 100 km/hr over low vegetation and scattered small rocks, instantly matching every swerve of the prey, the marked variation from stride to stride is evidence of fine tuning almost beyond belief.\"")
SubClassOf(obo:ACTAN_0000487 obo:ACTAN_0000569)
SubClassOf(obo:ACTAN_0000487 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001350))

# Class: obo:ACTAN_0000488 (pelvic-fin twisting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000488 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000488 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000488 "2026-07-21T13:47:18.563654Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000488 "Twisting that involves a pelvic fin.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...pelvics, which serve as posterior warping planes...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000488 "pelvic warping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000488 "pelvic-fin twisting"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000488 "\"Cypselurus sp. and related^ “four-winged” forms doubtless have better control of their flight than the “two-winged” species, Halocypselurus, for the reason that the pelvics, which serve as posterior warping planes, give them more purchase for their limited amount of maneuvering.\"")
SubClassOf(obo:ACTAN_0000488 obo:ACTAN_0000605)
SubClassOf(obo:ACTAN_0000488 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000152))

# Class: obo:ACTAN_0000489 (pectoral-fin twisting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000489 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000489 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000489 "2026-07-21T13:47:38.861376Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1109/48.757275") Annotation(skos:scopeNote "\"...during refraction, the fin is orientated to its original position by rotation of the leading edge.\"") oboInOwl:hasDefinition obo:ACTAN_0000489 "Twisting that rotates the leading edge of a pectoral fin.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000489 "pectoral fin refraction")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...warping of the pectorals...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000489 "pectoral warping")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...pectorals can... by proper twisting...\"") rdfs:label obo:ACTAN_0000489 "pectoral-fin twisting"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000489 "\"Prionotus evolans and carolinus when ceasing active swimming generally extend their large pectorals and the weight of the fish (although it possesses a swim-bladder) which is heavier than the water generally, enables them to glide forward at will, wheeling about by “warping” the planes.\"")
SubClassOf(obo:ACTAN_0000489 obo:ACTAN_0000605)
SubClassOf(obo:ACTAN_0000489 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000151))

# Class: obo:ACTAN_0000490 (tail twisting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000490 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000490 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000490 "2026-07-21T13:50:25.007991Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000490 "Twisting that involves the tail.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...twists its tail...\"") rdfs:label obo:ACTAN_0000490 "tail twisting"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000490 "\"The central ray of the tail remains still and simply twists on its axis...\"")
SubClassOf(obo:ACTAN_0000490 obo:ACTAN_0000605)
SubClassOf(obo:ACTAN_0000490 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002415))

