AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000525 "2025-01-14T16:53:51.561044Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000525 "Ethotype that uses the nose against the tail of another animal.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000525 "tail-nose"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000525 "tail-nose ethotype"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000525 "\"The male will follow or chase the female in a jerky swimming motion with his dorsal fin erect (fin raise), and attempt to tail-nose touch (this happens after the male makes visual contact, since first needs to chemically sense the readiness of female and display sexual aggregating behavior).\"")
SubClassOf(obo:ACTAN_0000525 obo:ACTAN_0000118)
SubClassOf(obo:ACTAN_0000525 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000383))
SubClassOf(obo:ACTAN_0000525 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000925))
SubClassOf(obo:ACTAN_0000525 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000004))

