AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000935 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000935 "2026-08-02T14:22:03.889683Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1088/1748-3190/ac482d") oboInOwl:hasDefinition obo:ACTAN_0000935 "Protracting which involves an appendage.")
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.156.1.215") Annotation(skos:scopeNote "\"(...cycle of protraction and retraction of a leg).\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000935 "leg protraction")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3190/ac482d") oboInOwl:hasRelatedSynonym obo:ACTAN_0000935 "swing forward")
