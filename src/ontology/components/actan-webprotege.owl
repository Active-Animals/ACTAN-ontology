AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000678 "Jerk which moves a body element.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000678 "flick")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000678 "flickering"@en)
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasExactSynonym obo:ACTAN_0000678 "flicking")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasNarrowSynonym obo:ACTAN_0000678 "pick-flick motion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000678 "flick jerking")
SubClassOf(obo:ACTAN_0000678 obo:ACTAN_0000522)
