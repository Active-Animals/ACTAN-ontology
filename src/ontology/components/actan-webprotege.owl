AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000795 "shake")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000795 "shaking"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasNarrowSynonym obo:ACTAN_0000795 "wig- wag motion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000795 "shake oscillation")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000795 obo:ACTAN_0000708)
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000795 "\"... Blue Jays... when bitten, would shake their legs, jump or pick off the ant and fling it away.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:example obo:ACTAN_0000795 "\"Sepsid flies are emerging as important model organisms in the study of sexual selection... In most species, females shake vigorously to dislodge the males and presumably the tight meshing of the male foreleg armature with the female wings help the males to remain mounted. Some authors claim that this female shake is a defensive behaviour to avoid copulation [i.e. sexual conflict], whilst others believe that it could be test of male quality i.e. cryptic female choice.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000795 "\"...movements of various parts of the bird's body may be involved in several comfort movements. Tail-wag, for example, which frequently occurs as an independent action, is an integral part of the body-shake and it also accompanies head-dipping during bathing.\"")
SubClassOf(obo:ACTAN_0000795 obo:ACTAN_0000421)
SubClassOf(obo:ACTAN_0000795 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000381))
SubClassOf(obo:ACTAN_0000795 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0055002))

# Class: obo:ACTAN_0000796 (peristalsis pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000796 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000796 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000796 "2025-08-12T10:25:26.285605Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasDefinition obo:ACTAN_0000796 "Gait pattern in which a ring of contraction passes along the body of an animal with a hydrostatic skeleton, causing indirect deformation and elongation of other parts of the body through displacement of coelomic fluid.")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") oboInOwl:hasExactSynonym obo:ACTAN_0000796 "peristalsis"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000796 "peristaltic wave")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasNarrowSynonym obo:ACTAN_0000796 "antiperistaltic wave")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000796 "peristalsis pattern")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3190/ac482d") skos:example obo:ACTAN_0000796 "\"Gait patterns are often observed as waves propagating along the major body axis, such as peristaltic waves in Annelida such as earthworms...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3190/ac482d") skos:scopeNote obo:ACTAN_0000796 "\"They are called direct if they propagate in the movement direction, and retrograde if they propagate in the opposite direction.\"")
SubClassOf(obo:ACTAN_0000796 obo:ACTAN_0000126)
SubClassOf(obo:ACTAN_0000796 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0011997))

# Class: obo:ACTAN_0000797 (peristaltic-burrowing gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000797 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000797 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000797 "2025-08-12T16:02:34.820197Z")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.202.6.661") oboInOwl:hasBroadSynonym obo:ACTAN_0000797 "peristaltic crawling")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.202.6.661") Annotation(skos:scopeNote "\"Typically, the radially expanded regions anchor the organisms to the substratum while the radially contracted regions advance over the substratum.\"") oboInOwl:hasDefinition obo:ACTAN_0000797 "Burrowing-gait in which radially expanded regions anchor the organism to the substratum while the radially contracted regions advance.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000797 "worm crawling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000797 "peristaltic-burrowing gait")
SubClassOf(obo:ACTAN_0000797 obo:ACTAN_0000025)
SubClassOf(obo:ACTAN_0000797 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000469))
SubClassOf(obo:ACTAN_0000797 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000743))
SubClassOf(obo:ACTAN_0000797 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000744))
