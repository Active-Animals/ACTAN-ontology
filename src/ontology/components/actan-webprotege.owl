# Class: obo:ACTAN_0000103 (counter-irritant routine)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000103 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000103 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000103 "2026-04-20T19:55:02.407724Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"When a bird gives repeated attention to a definite area on the head it looks as though an attempt is being made to relieve a local irritation, possibly caused by Mallophaga.\"") oboInOwl:hasDefinition obo:ACTAN_0000103 "Autogroom-routine that attempts to relieve a local irritation.

Repeated attention may be given.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000103 "counter-irritant"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"...a response to an irritation.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000103 "irritation response")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000103 "removing irritant")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000103 "counter-irritant routine"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000103 "\"In the Cichlid fishes... There are some movements... that undoubtedly serve to remove irritating particles...\"")
SubClassOf(obo:ACTAN_0000103 obo:ACTAN_0000102)
SubClassOf(obo:ACTAN_0000103 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000553))

# Class: obo:ACTAN_0000104 (rub kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000104 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000104 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000104 "2024-09-17T13:10:10.963504Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000104 "Kinetics that moves an object across another.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000104 "rub")
AnnotationAssertion(Annotation(dc:date "1948"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5252&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000104 "rubbing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000104 "rub kinetics")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000104 "\"Tail rubbing, a behavior found only in large-bodied rattlesnakes, was mostly performed by gravid females. This behavior is associated with cloacal sac discharge and its function appears to be to spread exudates over the body of the snake.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000104 "\"Occasionally, when a duck appears to have an irritation about the head, it will rub its cheek on its shoulder.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:scopeNote obo:ACTAN_0000104 "\"Rub muzzle stained with fruit juice against a shrub, grass stalk, slender vine, or bark of tree or stone in order to wipe off the mess.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:scopeNote obo:ACTAN_0000104 "\"The pectoral fins can be rubbed against the body in various ways;\"")
SubClassOf(obo:ACTAN_0000104 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000104 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001025))

# Class: obo:ACTAN_0000105 (waterproofing routine)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000105 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000105 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000105 "2026-04-21T09:45:33.941801Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000105 "Autogroom-routine that conditions a surface structure.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000105 "waterproofing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000105 "waterproofing routine"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000105 "\"I have seen... individual ducks which had lost the waterproofing quality of their breast feathers, through being in poor condition.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000105 "\"The finely distributed air enclosed between the barbules of the feathers seems to be the main factor in waterproofing but oiling is important indirectly as it helps to maintain feather structure.Elder's experiments, involving removal of the oil gland from Mallards and Redheads, indicate that the secretion is effective also in maintaining the surface structure of the bill and legs.\"")
SubClassOf(obo:ACTAN_0000105 obo:ACTAN_0000102)
SubClassOf(obo:ACTAN_0000105 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002416))

# Class: obo:ACTAN_0000106 (head twisting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000106 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000106 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000106 "2026-04-21T10:41:50.098431Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000106 "Twisting in which the head is rolled around on the neck.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000106 "head-rolling")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "doi:10.1093/auk/123.4.967") oboInOwl:hasExactSynonym obo:ACTAN_0000106 "turning head")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1367395") rdfs:label obo:ACTAN_0000106 "head twisting"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000106 "NBO:0000026")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/1367395") skos:example obo:ACTAN_0000106 "\"...adult Java Sparrows (Puddu oryzivoru) use headtwisting as an aggressive display in supplanting attacks.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000106 "\"Head-rolling, involving rapid rubbing of one cheek on the back, occurs in the pre-copulation situation in the European, Pacific, King, and Stellar's Eiders.\"")
SubClassOf(obo:ACTAN_0000106 obo:ACTAN_0000605)
SubClassOf(obo:ACTAN_0000106 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000033))

# Class: obo:ACTAN_0000107 (framework-dimension)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000107 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000107 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000107 "2026-05-06T07:32:10.412193Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1371/journal.pcbi.1002915") oboInOwl:hasDefinition obo:ACTAN_0000107 "Behavioural disposition that is realized in a group behavior pattern's spatial parameters.")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1140/epjst/e2008-00633-y") Annotation(skos:scopeNote "\"...two-dimensional framework...\"") rdfs:label obo:ACTAN_0000107 "framework-dimension"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1140/epjst/e2008-00633-y") skos:scopeNote obo:ACTAN_0000107 "\"Nonetheless, given the large sizes of locust swarms the two-dimensional framework we use – and the band-like structure it implies – are likely good approximations for the bulk of a three-dimensional swarm.\"")
SubClassOf(obo:ACTAN_0000107 <http://humanbehaviourchange.org/ontology/BCIO_050416>)
SubClassOf(obo:ACTAN_0000107 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000117))

# Class: obo:ACTAN_0000108 (group-membership)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000108 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000108 "2026-05-10T15:31:16.148895Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/beheco/12.5.534") Annotation(skos:scopeNote "\"However, with the evolution of eusociality came the opportunity to exploit a new organizational method: highly cooperative and relatively unselfish groups of individuals who, collectively, are able to tackle tasks far beyond the abilities of the individuals themselves.\"") oboInOwl:hasDefinition obo:ACTAN_0000108 "Behavioural disposition that is realized in an individual's part in a collective.")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") Annotation(skos:scopeNote "\"...herds of mixed membership...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000108 "membership")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/beheco/12.5.534") oboInOwl:hasRelatedSynonym obo:ACTAN_0000108 "collective abilities")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000108 "group-membership")
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:example obo:ACTAN_0000108 "\"...lek-breeding ungulates such as fallow deer, Uganda kob and Kafue lechwe which live in large unstable herds of mixed membership...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/beheco/12.5.534") skos:scopeNote obo:ACTAN_0000108 "\"These collective abilities, such as the construction of relatively large nests and the ability to overpower prey much larger than themselves, have been well documented in insect societies.\"")
SubClassOf(obo:ACTAN_0000108 <http://humanbehaviourchange.org/ontology/BCIO_050416>)

# Class: obo:ACTAN_0000109 (head extension)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000109 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000109 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000109 "2026-07-12T10:13:38.29216Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000109 "Extension that results from head extending.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000109 "head extension"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000109 "\"Captive Trumpeter Swans often perform vigorous shakes when... they are threatening; at times only the wings are shaken, the head held stiffly forward with the bill pointing vertically downward.\"")
SubClassOf(obo:ACTAN_0000109 obo:ACTAN_0000523)
SubClassOf(obo:ACTAN_0000109 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000033))

# Class: obo:ACTAN_0000110 (community membership)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000110 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000110 "2026-05-10T15:31:30.758407Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Inferred.") oboInOwl:hasDefinition obo:ACTAN_0000110 "Membership that involves a group of at least three animals.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000110 "community"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000110 "social animal"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000110 "community membership"@en)
SubClassOf(obo:ACTAN_0000110 obo:ACTAN_0000108)

# Class: obo:ACTAN_0000111 (colony membership)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000111 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000111 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000111 "2026-05-10T15:31:50.888384Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasDefinition obo:ACTAN_0000111 "Membership that is place-based, relatively dense, and mutually interdependent.

It may even involve integration approaching that of cells in a multicellular organism, and  different roles for different members.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasRelatedSynonym obo:ACTAN_0000111 "colony")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000111 "colony membership"@en)
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:example obo:ACTAN_0000111 "\"Hovering fishes may form aggregations with colonies of burrows found in some regions of the reef, or adjacent habitats.\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000111 "\"Unlike many colonial birds, .notably ground-nesting marine species, A. ibis nests are not built a more or less fixed distance from the nearest neighbour's, resulting in a uniformly dense colony. Instead, the inter-nest distance (between nest centres) at the time of building varies from 50 cm. to 6 metres, with some new nests continuing to fill in the larger gaps for.the entire duration of nest commencement.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/bc60659126ef5c0172c2392d485b0c9b/1?pq-origsite=gscholar&cbl=18750") skos:example obo:ACTAN_0000111 "\"We found that individual corals did not participate in every annual spawning event but the same individual colony of Acropora digitifera could spawn in multiple months and nights. In context of seasonality, the breeding period seems to be a result of differential rates of gamete development. That is, gametes within a colony are ready to spawn at different times but the majority of the gametes in individual corals spawn on a single night.\"")
SubClassOf(obo:ACTAN_0000111 obo:ACTAN_0000108)
SubClassOf(obo:ACTAN_0000111 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ENVO_01000739))

# Class: obo:ACTAN_0000112 (buffering influence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000112 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000112 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000112 "2026-05-19T07:36:28.876431Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "NB: This class relates to active behaviours, not passive environmental effects such as passive temperature buffering caused by a nest in sunlight for example.") Annotation(rdfs:isDefinedBy "doi:10.1016/j.anbehav.2011.01.007") Annotation(skos:scopeNote "\"Taken together, the studies reviewed here suggest that under fitness challenge, play may (1) giveway to behaviours that are more urgent because of their immediate fitness consequences, (2) increase because it buffers an animal against the adverse effects of worsened conditions now or in the future, or (3) be suppressed initially but increase above baseline under rebound later.\"") oboInOwl:hasDefinition obo:ACTAN_0000112 "Influence which works against the adverse effects of worsened conditions.")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") oboInOwl:hasExactSynonym obo:ACTAN_0000112 "buffering")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000112 "buffering influence"@en)
SubClassOf(obo:ACTAN_0000112 obo:ACTAN_0000438)
SubClassOf(obo:ACTAN_0000112 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MFOEM_000001))

# Class: obo:ACTAN_0000113 (bite kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000113 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000113 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000113 "2024-09-17T13:42:31.003475Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2011.0690") Annotation(skos:scopeNote "\"Bite: Fish opens and closes its mouth in contact with the body surface of its opponent.\"") oboInOwl:hasDefinition obo:ACTAN_0000113 "Kinetics which opens and closes the mouth in contact with the body surface.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000113 "bite")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasNarrowSynonym obo:ACTAN_0000113 "nipping")
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000113 "bite kinetics")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000113 "NBO:0000017")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10682-007-9183-7") skos:example obo:ACTAN_0000113 "\"Courtship displays of R. decemdigitatus consisted of 11 steps: ... (ix) biting of the female and swimming into her...\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000113 "\"Larger snakes have better venom delivery systems and can first warn a predator. If the predator does not respond to the aposematic signal, they can deliver a few effective bites, then cover up their heads and withstand a brief attack while they wait for the envenomation to repel the attacker.\"")
SubClassOf(obo:ACTAN_0000113 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000113 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001025))

# Class: obo:ACTAN_0000114 (whole performance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000114 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000114 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000114 "2026-05-26T14:41:56.400288Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/s10988-025-09438-8") Annotation(skos:scopeNote "\"One includes elementary signals (notably, calls and gestures) whose atomic meaning involves the whole signal, and cannot be derived from deeper considerations (in linguistic parlance, they have 'lexical' meanings).\"") oboInOwl:hasDefinition obo:ACTAN_0000114 "Performance whose atomic meaning cannot be derived from deeper considerations.

In linguistic parlance, it has 'lexical' meaning.")
AnnotationAssertion(Annotation(dc:date "2025"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10988-025-09438-8") oboInOwl:hasExactSynonym obo:ACTAN_0000114 "whole signal")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000114 "whole performance"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1038/s41467-020-18772-3") skos:example obo:ACTAN_0000114 "\"Pecking, a foraging behaviour used in woodpeckers to excavate prey from tree trunk, has acquired a stereotypical and rhythmic structure, thus exapting into drumming, which holds a communicative function during mating and territorial defence.\"")
SubClassOf(obo:ACTAN_0000114 obo:ACTAN_0000446)
SubClassOf(obo:ACTAN_0000114 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000317))

# Class: obo:ACTAN_0000115 (envenomation expulsion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000115 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000115 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000115 "2024-09-17T14:46:05.938233Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasDefinition obo:ACTAN_0000115 "Expulsion in which a delivery system directly delivers an effective poison.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000115 "envenomation"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000115 "envenomation expulsion"@en)
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000115 "\"Larger snakes have better venom delivery systems and can first warn a predator. If the predator does not respond to the aposematic signal, they can deliver a few effective bites, then cover up their heads and withstand a brief attack while they wait for the envenomation to repel the attacker.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000115 "\"Although these species possess rear fangs and Duvernoy's gland secretions, the aperture of their mouths and effectiveness of the use of any \"venom\" is constrained by their small body size.\"")
SubClassOf(obo:ACTAN_0000115 obo:ACTAN_0000715)
SubClassOf(obo:ACTAN_0000115 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0007113))

# Class: obo:ACTAN_0000116 (chew bite)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000116 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000116 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000116 "2024-09-17T14:54:08.300445Z")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasBroadSynonym obo:ACTAN_0000116 "grinding")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasDefinition obo:ACTAN_0000116 "Bite which repeatedly crushes an item between mouthparts.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000116 "chewing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000116 "chew bite"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000116 "NBO:0000073")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000116 "\"Paper wasps, for example, chew up wood and mix it with their saliva to produce the paper from which they build their nests.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000116 "\"While lacking an upper pharyngeal jaw, zebrafish can chew their food by grinding the teeth in their lower jaw against a chewing pad on the base of the skull.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") skos:example obo:ACTAN_0000116 "\"Wood-feeding cockroaches (Salganea taiwanensis) mate and live as pairs; quite notably, after choosing a mate, paired cockroaches chew off each other’s wings. After cannibalizing their pair mate’s non-fleshy wings, paired individuals mate and produce multiple cycles of offspring that are cared for by both parents.\"")
SubClassOf(obo:ACTAN_0000116 obo:ACTAN_0000113)
SubClassOf(obo:ACTAN_0000116 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000427))

# Class: obo:ACTAN_0000117 (modality signal)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000117 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000117 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000117 "2026-05-25T19:59:26.738301Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1017/S1464793104006700") Annotation(skos:scopeNote "\"I will first focus on female choice and male competition working in the various sensory modalities, with the main conclusion that sexual selection in spiders may predominantly work via channels of communication that are not as easily accessible to the human observer as bird plumage, mammal weapons, and insect stridulation.\"") oboInOwl:hasDefinition obo:ACTAN_0000117 "Signal that works via a particular sensory channel of communication.")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "doi:10.1017/S1464793104006700") oboInOwl:hasExactSynonym obo:ACTAN_0000117 "modality")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "doi:10.1017/S1464793104006700") Annotation(skos:scopeNote "\"...spider communication also tends to be multimodal...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000117 "multimodal communication")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000117 "modality signal"@en)
SubClassOf(obo:ACTAN_0000117 obo:ACTAN_0000414)
SubClassOf(obo:ACTAN_0000117 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000078))

# Class: obo:ACTAN_0000118 (ethotype behaviour)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000118 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000118 "2026-05-26T12:56:19.016085Z")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "ISBN:9781482294347") oboInOwl:hasBroadSynonym obo:ACTAN_0000118 "behavioral complex")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1080/08927014.2002.9522740") oboInOwl:hasDefinition obo:ACTAN_0000118 "Behaviour in which a specific combination of activities is characteristic of a particular taxon.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "doi:10.1080/08927014.2002.9522740") oboInOwl:hasExactSynonym obo:ACTAN_0000118 "ethotype")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasNarrowSynonym obo:ACTAN_0000118 "display")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:comment obo:ACTAN_0000118 "This branch has the potential to overwhelm this ontology, being comprised of a potentially overwhelming number of activity combinations, for different contexts, in different taxa. It might form the root of a future ontology of its own. For now, it contains a small handful of uncategorised example subclasses. NO NEW SUBCLASSES should be added before a strategic approach has been agreed.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000118 "ethotype behaviour"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000118 "\"...in the nest-building minnows, the bluehead chub, Nocomis leptocephalus, and river chub, N. micropogon... a precise sequence of male-female interactions that coordinated a successful spawn. Reproductive behaviors were classified into six sequential categories (interim, approach, alignment, run, clasp, dissociation)...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1080/08927014.2002.9522740") skos:example obo:ACTAN_0000118 "\"The Cervidae ancestral ethotype would correspond to an animal who never beats the ground with hindlimbs, who shakes his body, who never digs with forelimbs, who scratches his forelimb with hindlimb, who licks or smells the hindlimbs of its fellows, who avoids fellow by stotting or running, and shakes head during play with a fellow.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000118 "\"The rock-thrush of Guiana, birds of Paradise, and some others, congregate; and successive males display their gorgeous plumage and perform strange antics before the females, which standing by as spectators, at last choose the most attractive partner.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4081601") skos:scopeNote obo:ACTAN_0000118 "\"...the \"ritualized\" activities or \"displays\"; i.e. those peculiarly standardized and often exaggerated performances, including all vocalizations and many movements and postures, which have become specialized and modified as social signals...\"")
SubClassOf(obo:ACTAN_0000118 obo:ACTAN_0000002)
SubClassOf(obo:ACTAN_0000118 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000046))

# Class: obo:ACTAN_0000119 (icon performance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000119 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000119 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000119 "2026-05-26T14:42:10.982165Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/s10988-025-09438-8") Annotation(skos:scopeNote "\"By definition, an expression is iconic if it conveys information about a situation by resembling certain aspects of that situation, or more abstractly: if there is a structuring-preserving map from the form of the expression to situations it is true of.\"") oboInOwl:hasDefinition obo:ACTAN_0000119 "Performance that conveys information about a situation by resembling certain aspects of that situation.

Put more abstractly: if there is a structuring-preserving map from the form of the expression to situations it is true of.")
AnnotationAssertion(Annotation(dc:date "2025"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10988-025-09438-8") oboInOwl:hasExactSynonym obo:ACTAN_0000119 "iconic communication")
AnnotationAssertion(Annotation(dc:date "2025"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10988-025-09438-8") Annotation(skos:scopeNote "\"...expression is iconic...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000119 "iconic expression")
AnnotationAssertion(Annotation(dc:date "2025"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10988-025-09438-8") Annotation(skos:scopeNote "\"...these signals are genuinely iconic...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000119 "iconic signal")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000119 "icon performance"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10988-025-09438-8") skos:example obo:ACTAN_0000119 "\"The most striking example of iconic communication in the animal world involves the waggle dance of bees.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10988-025-09438-8") skos:scopeNote obo:ACTAN_0000119 "\"Iconicity has some 'bite' only to the extent that the form can be modified (often gradiently) and yield corresponding changes to the meaning.\"")
SubClassOf(obo:ACTAN_0000119 obo:ACTAN_0000446)
SubClassOf(obo:ACTAN_0000119 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001303))

# Class: obo:ACTAN_0000120 (flexion placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000120 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000120 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000120 "2024-09-17T15:02:29.39842Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000120 "Placement that results from flexing.")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000120 "flexion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000120 "flexion placement")
AnnotationAssertion(Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") skos:example obo:ACTAN_0000120 "\"For example when the kangaroo decelerates downward and forward, its feet are flexed so that the Achilles tendons are stretched storing elastic energy.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:scopeNote obo:ACTAN_0000120 "\"The dorsal fin collapses from front to rear, and is erected in reverse order, from posterior to anterior.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1038/ncomms1350") skos:scopeNote obo:ACTAN_0000120 "\"Undulating flight is a special form of intermittent locomotion and involves gliding with flexed wings interspersed with active flapping.\"")
SubClassOf(obo:ACTAN_0000120 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000120 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000732))

# Class: obo:ACTAN_0000121 (curl placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000121 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000121 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000121 "2024-09-17T19:27:55.949666Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "ISBN:9781482294347") oboInOwl:hasDefinition obo:ACTAN_0000121 "Placement which results from a body part bending round towards itself.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000121 "curled"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000121 "curl placement")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000121 "\"C. pricei had derived tail displays of curling their tails and exposing the ventral surface of the tail to the predator.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") skos:example obo:ACTAN_0000121 "\"Mating in Raphidioptera... often starts with the male putting his head under the female abdomen from posteriorly. He then curls his abdomen upward and forward to grasp the female terminal segments.\"")
SubClassOf(obo:ACTAN_0000121 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000121 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002211))
SubClassOf(obo:ACTAN_0000121 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000737))

# Class: obo:ACTAN_0000122 (gaping movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000122 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000122 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000122 "2024-09-17T19:32:35.749699Z")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasBroadSynonym obo:ACTAN_0000122 "opening")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasDefinition obo:ACTAN_0000122 "Movement that opens a bilaterally articulated, curved orifice.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000122 "gape")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000122 "gaping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000122 "gaping movement")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000122 obo:ACTAN_0000723)
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000122 "\"Apomorphic characters were the derived mouth-gaping behavior of A. piscivorous and the specialized tail coil and ventral tail exposure of C. pricei.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000122 "\"Nocomis leptocephalus...
As the female moved forward over the upstream rim of the pit, she gaped and abruptly tossed her head vertically into the water column.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") skos:example obo:ACTAN_0000122 "\"The genera Lingula and Glottidia possess antero-posteriorly elongated shells, and live within mucus-lined burrows in soft sediment, with the long pedicles anchored at the bottom of their burrows... After burrowing downward for a while, they curve upward and continue burrowing until they emerge from the substrate with the anterior region of the shell. The valves perform a variety of gaping and shearing movements that are adaptive in displacing the sediment.\"")
SubClassOf(obo:ACTAN_0000122 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000122 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000610))

# Class: obo:ACTAN_0000123 (closed-mouth-strike feigning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000123 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000123 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000123 "2024-09-17T19:35:01.62595Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2011.0690") Annotation(skos:scopeNote "\"Strike: The fish swims rapidly toward the opponent but no physical contact occurs between them.\"") oboInOwl:hasDefinition obo:ACTAN_0000123 "Feigning that moves rapidly toward the opponent but no physical contact occurs between them.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000123 "closed mouth striking")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2011.0690") oboInOwl:hasRelatedSynonym obo:ACTAN_0000123 "striking"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000123 "closed-mouth-strike feigning")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000123 obo:ACTAN_0000512)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000123 obo:ACTAN_0000859)
SubClassOf(obo:ACTAN_0000123 obo:ACTAN_0000467)
SubClassOf(obo:ACTAN_0000123 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000327))

# Class: obo:ACTAN_0000124 (stepping gait)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000124 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000124 "2024-09-17T19:48:54.590671Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") oboInOwl:hasDefinition obo:ACTAN_0000124 "Traversing-gait that lifts an appendage and accelerates it with respect to the body, before repositioning it on the ground ready to push and accelerate the body in the desired direction.

The lift phase is the swing, the ground phase is the stance, and the sum of all the pushing appendages over a complete locomotor cycle is the stride (in bipeds this tends to equal a full cycle in one leg, although it is not so simple in multipeds). The relative fraction of a stride period when a particular limb is in the stance phase is defined as that limb’s duty factor.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000124 "step"@en)
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000124 "stepping")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000124 "stride")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000124 "stepping gait")
AnnotationAssertion(Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") skos:scopeNote obo:ACTAN_0000124 "\"When an animal moves, independently from the gait and speed, the limbs push on the ground accelerating the body in the desired direction, during the so called stance phase, then the limbs must be repositioned to take a step forward, leaving the ground and accelerating with respect to the body, in the course of the swing phase. During locomotion, the forces exerted by one limb on the ground rise and fall during the stance phase (when the foot is on the ground), and are zero when the limb is in the swing phase, but the average vertical force exerted by the sum of the limb over a complete locomotor cycle (stride) must be equal to the body weight. It follows that if the limbs are kept on the ground for a shorter period of time, larger forces will be exerted on each limb.

The relative fraction of a stride period when a particular limb is in the stance phase is defined as the limb’s duty factor (Df).\"")
SubClassOf(obo:ACTAN_0000124 obo:ACTAN_0000093)
SubClassOf(obo:ACTAN_0000124 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000085))
SubClassOf(obo:ACTAN_0000124 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))
SubClassOf(obo:ACTAN_0000124 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000026))

# Class: obo:ACTAN_0000125 (feature performance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000125 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000125 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000125 "2026-05-26T14:42:21.941692Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/s10988-025-09438-8") Annotation(skos:scopeNote "\"The alarm calls of many species contain acoustic features that are inherently attention-grabbing or frightening, and this may also prompt immediate response to unfamiliar calls (…). Many mobbing, distress, “panic,” or general alarm calls, for example, contain elements that are harsh, abrupt, broadband, or nonlinear. These acoustic features tend to be honest signals of caller distress, increase listener attention and response, and prevent habituation (…).\"") oboInOwl:hasDefinition obo:ACTAN_0000125 "Performance which contains atomic elements that inherently increase attention and response, and prevent habituation.")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10988-025-09438-8") Annotation(skos:scopeNote "\"...features tend to be honest signals...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000125 "feature signal")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000125 "feature performance"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1038/s41467-019-11626-7") skos:scopeNote obo:ACTAN_0000125 "\"...rough auditory percepts are analogous to flickering phenomena in the visual modality...
...subjective reports linearly follow stimulus frequency above the subjective transition from discrete (rough) to continuous (pitch) percepts (~130 Hz), but not below. Instead, sounds in the roughness range induce highly aversive, buzzing percepts that cannot be accounted for merely by stimulus energy.
...the negative percept induced by rough sounds such as dissonant intervals, alarm sounds or annoying vocal effects (e.g. vocal fry) might result from their capacity to massively, exogenously hijack brain networks involved in aversion and pain processing.\"")
SubClassOf(obo:ACTAN_0000125 obo:ACTAN_0000446)
SubClassOf(obo:ACTAN_0000125 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000690))

# Class: obo:ACTAN_0000126 (gait pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000126 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000126 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000126 "2024-09-19T20:04:57.601329Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icac125") Annotation(skos:scopeNote "\"Kinematic (the study of themovement of body parts) and kinetic (the study of energetic and force patterns) analysis techniques are often used to identify functional differences in “gaits,” defined as particular cyclical pattern of movement characteristic of a limited range of speeds in which momentum is conserved across repeated cycles, described by quantities of which one or more change discontinuously at transitions to other gaits.\"") oboInOwl:hasDefinition obo:ACTAN_0000126 "Pattern that involves particular, cyclical movements, characteristic of a limited range of speeds in which momentum is conserved across repeated cycles.

It is described by quantities of which one or more change discontinuously at transitions to other gaits.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000126 "gait"@en)
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.158.1.369") Annotation(skos:scopeNote "\"...few investigations have correlated kinematics (i.e. description of stepping patterns) with the actual kinetics of locomotion.\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000126 "kinematics")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") rdfs:label obo:ACTAN_0000126 "gait pattern")
AnnotationAssertion(Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") skos:scopeNote obo:ACTAN_0000126 "\"Due to the periodical characteristics of a gait, where a sequence of footfalls is repeated in time, the gait pattern is summarized by phase shifts of footfalls that can be plotted as points on a trigonometric circumference.\"")
SubClassOf(obo:ACTAN_0000126 obo:ACTAN_0000017)
SubClassOf(obo:ACTAN_0000126 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002323))

# Class: obo:ACTAN_0000127 (pectoral-fin adducting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000127 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000127 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000127 "2026-07-12T10:22:16.535411Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.204.8.1459") Annotation(skos:scopeNote "\"Pectoral fin-beat cycles started with the fins pressed against the body (maximally adducted), moving away (abducting) from the body to some maximum point of excursion...\"") oboInOwl:hasDefinition obo:ACTAN_0000127 "Adducting in which a pectoral fin is returning to the body.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") Annotation(skos:scopeNote "\"Pectoral fin-beat cycles started with the fins pressed against the body (maximally adducted), moving away... and returning (adducting) to the original position.\"") rdfs:label obo:ACTAN_0000127 "pectoral-fin adducting"@en)
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000127 "\"If a faster start is required the head initiates lateral trunk un-dulations in the manner typical for most fishes, and the spread pectoral fins are clapped against the sides in unison.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000127 "\"Such forms that have comparatively narrow pectorals used to this end, as Abudefduf and Teuthus, may be, in one sense, almost thought of as rowing their way along, in that they bring the fin forward almost edgewise and force it back broadside.\"")
SubClassOf(obo:ACTAN_0000127 obo:ACTAN_0000739)
SubClassOf(obo:ACTAN_0000127 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000151))

# Class: obo:ACTAN_0000128 (metachronal pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000128 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000128 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000128 "2024-09-19T20:25:01.141445Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"Metachronal swimming or metachronal rowing is a type of locomotion that arises when an organism with multiple appendages (legs, pleopods, ctene plates, etc.) performs a stroke by allowing some phase delay between adjacent appendages.\"") oboInOwl:hasDefinition obo:ACTAN_0000128 "Gait pattern in which an organism with multiple appendages performs a stroke by allowing some phase delay between adjacent appendages.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3190/ac482d") oboInOwl:hasExactSynonym obo:ACTAN_0000128 "leg-density wave")
AnnotationAssertion(Annotation(dc:date "1983"^^xsd:decimal) Annotation(dc:source "doi:10.3354/meps011089") oboInOwl:hasExactSynonym obo:ACTAN_0000128 "metachronal beat")
AnnotationAssertion(Annotation(dc:date "1983"^^xsd:decimal) Annotation(dc:source "doi:10.3354/meps011089") oboInOwl:hasExactSynonym obo:ACTAN_0000128 "metachronal wave")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3190/ac482d") oboInOwl:hasRelatedSynonym obo:ACTAN_0000128 "locomotory wave")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF00197760") oboInOwl:hasRelatedSynonym obo:ACTAN_0000128 "metachronal gait"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000128 "metachronal pattern")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3190/ac482d") skos:example obo:ACTAN_0000128 "\"Scolopocryptops rubiginous... possess various modes of locomotion that use retrograde waves, direct waves, and a combination of both that we will call splitting waves.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.130.1.155") skos:example obo:ACTAN_0000128 "\"The resulting gait of a sideways-walking crab, such as Uca pugnax, has been best described as an 'approximate' alternating tetrapod, with tendencies for metachronal waves.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000128 "\"Most metachronally swimming animals use an antiplectic pattern, in which the power stroke direction is opposite to the appendage wave direction.\"")
SubClassOf(obo:ACTAN_0000128 obo:ACTAN_0000126)
SubClassOf(obo:ACTAN_0000128 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0000026))

# Class: obo:ACTAN_0000129 (pelvic-fin adducting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000129 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000129 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000129 "2026-07-12T10:49:51.455687Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000129 "Adducting which involves a pelvic fin.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000129 "pelvic-fin adducting"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000129 "\"In the family Rajidae... The pelvics have a special function when the skate is resting on the bottom; they operate to push the animal forward by kicking back much as though they were feet. Frequently in rising the members of this family give a single violent backward thrust, so launching themselves on their way.\"")
SubClassOf(obo:ACTAN_0000129 obo:ACTAN_0000739)
SubClassOf(obo:ACTAN_0000129 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000152))

# Class: obo:ACTAN_0000130 (sequence pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000130 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000130 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000130 "2024-09-22T10:02:04.774121Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.2307/1379571") Annotation(skos:scopeNote "\"A gait is an accustomed, cyclic manner of moving in terrestrial locomotion. Although actions of the head, spine, and tail may be gait characteristics, this study is limited to the timing of the footfalls, the durations of the contacts that the feet make with the ground, and the sequences of the different patterns of support made by the feet in combination. There are two principal classes of gaits, symmetrical and asymmetrical. The former has the footfalls of a pair of feet evenly spaced in time.\"") oboInOwl:hasDefinition obo:ACTAN_0000130 "Gait pattern which describes the cyclical order and combinations of footfalls.")
AnnotationAssertion(Annotation(dc:date "1968"^^xsd:decimal) Annotation(dc:source "https://apps.dtic.mil/sti/html/tr/AD0675256/") oboInOwl:hasExactSynonym obo:ACTAN_0000130 "sequential characteristics"@en)
AnnotationAssertion(rdfs:comment obo:ACTAN_0000130 "The  'sequential' gait grouping has more recently been supplemented by energy recovery terms ('vaulting', 'bouncing', and 'skipping'). Terms like 'running' and 'symmetrical' are now insufficient to exclusively define a gait, but retain an inclusive meaning.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1005565304671") rdfs:label obo:ACTAN_0000130 "sequence pattern")
AnnotationAssertion(Annotation(dc:source "doi:10.3390/ani13162557") skos:scopeNote obo:ACTAN_0000130 "\"Hence, the walk can be categorized as a symmetrical, even four-beat lateral sequence “singlefoot” gait.\"")
SubClassOf(obo:ACTAN_0000130 obo:ACTAN_0000126)
SubClassOf(obo:ACTAN_0000130 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000441))

# Class: obo:ACTAN_0000131 (sound-regime)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000131 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000131 "2026-05-31T15:56:10.924013Z")
AnnotationAssertion(Annotation(rdfs:comment "This is an aggregator class: please DON'T use it for annotation.") oboInOwl:hasDefinition obo:ACTAN_0000131 "Sound that involves a regime.")
AnnotationAssertion(rdfs:label obo:ACTAN_0000131 "sound-regime"@en)
SubClassOf(obo:ACTAN_0000131 obo:ACTAN_0000425)

# Class: obo:ACTAN_0000132 (run gait)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000132 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000132 "2024-09-22T10:20:19.355027Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") Annotation(skos:scopeNote "\"Running gaits are characterized by a duty factor < 0.5, that means no overlapping support periods between alternating support limbs.\"") oboInOwl:hasDefinition obo:ACTAN_0000132 "Stepping gait that is characterized by a duty factor < 0.5, and no overlapping support periods between alternating support limbs.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000132 "running"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000132 "run gait")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000132 "NBO:0000055")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:example obo:ACTAN_0000132 "\"Although there are many exceptions, walking and running are characteristic of ground foraging birds. Some species, such as the Song Sparrow (Melospiza melodia), employ both, depending on the environmental conditions.\"")
SubClassOf(obo:ACTAN_0000132 obo:ACTAN_0000124)

# Class: obo:ACTAN_0000133 (tail-beat hydrodynamics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000133 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000133 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000133 "2026-05-31T19:19:52.160409Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000133 "Hydrodynamics in which a strong stream of water is pushed perpendicular to the fish, towards the receiver.

There is no propulsive force. To remain stationary, it then gives a counter-beat; if swimming, it will move in a zigzag course.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000133 "tail beat")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000133 "tail beating")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000133 "tail-beat hydrodynamics"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0000133 "\"...South American cichlid Laetacara araguaiae...

...male and female side by side spread their fins and assume an “S” shape body posture with their head turned away from the mate. This posture is showed while fish quiver their bodies and beat their tail against each other. These movements occur repeatedly and can be showed by one or both mates simultaneously.\"")
SubClassOf(obo:ACTAN_0000133 obo:ACTAN_0000601)
SubClassOf(obo:ACTAN_0000133 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000716))

# Class: obo:ACTAN_0000134 (walk gait)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000134 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000134 "2024-09-22T10:27:56.227208Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasDefinition obo:ACTAN_0000134 "Stepping gait that involves an appendage out of phase with the opposing limb in the same girdle, there is always at least one limb acting as ground-support (no suspension phase), the average duty factor of the limbs is always >0.5, and walking animals must elevate the center of mass (COM) from the ground, rather than incorporating prolonged contact between the animal’s belly and the substrate (thereby maintaining forward momentum during both stance and swing phases).")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000134 "walk")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000134 "walking"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000134 "walk gait")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000134 "NBO:0000056")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000134 "\"...the long toes of grallatores are formed for walking over swamps and floating plants...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") skos:scopeNote obo:ACTAN_0000134 "\"For quadrupedal, hexapedal and octopedal animals, during walking there are periods where three or more feet are contemporary in contact with the ground. For this reason walking is defined a statically stable gait. On contrary, bipedal walking must rely on dynamic equilibrium to achieve balance and stability.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") skos:scopeNote obo:ACTAN_0000134 "\"Other terms should be used in place of 'walk' for animals that move in ways which do not meet these criteria, including the terms crutching, crawling, creeping, or punting.\"")
SubClassOf(obo:ACTAN_0000134 obo:ACTAN_0000124)

# Class: obo:ACTAN_0000135 (symmetry pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000135 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000135 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000135 "2024-09-22T10:44:25.097351Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.2307/1379571") Annotation(skos:scopeNote "\"There are two principal classes of gaits, symmetrical and asymmetrical. The former has the footfalls of a pair of feet evenly spaced in time.\"") oboInOwl:hasDefinition obo:ACTAN_0000135 "Sequence pattern that has the footfalls of a pair of feet evenly spaced in time.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasRelatedSynonym obo:ACTAN_0000135 "symmetrical gait"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000135 "symmetry pattern")
SubClassOf(obo:ACTAN_0000135 obo:ACTAN_0000130)
SubClassOf(obo:ACTAN_0000135 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000632))

# Class: obo:ACTAN_0000136 (asymmetry pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000136 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000136 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000136 "2024-09-22T10:47:37.085809Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.2307/1379571") Annotation(skos:scopeNote "\"Asymmetrical gaits (that is, gallops and bounds) have the footfalls of a pair of feet unevenly spaced in time.") oboInOwl:hasDefinition obo:ACTAN_0000136 "Sequence pattern that has the footfalls of a pair of feet unevenly spaced in time.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasRelatedSynonym obo:ACTAN_0000136 "asymmetrical gait"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000136 "asymmetry pattern")
SubClassOf(obo:ACTAN_0000136 obo:ACTAN_0000130)
SubClassOf(obo:ACTAN_0000136 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000616))

# Class: obo:ACTAN_0000137 (single-foot gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000137 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000137 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000137 "2024-09-22T10:59:31.152774Z")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000137 "single-foot"@en)
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/20.1.255") Annotation(skos:scopeNote "\"Also, if the footfalls are evenly spaced in time, the gait is a single-foot, either in lateral or diagonal sequence.\"") rdfs:comment obo:ACTAN_0000137 "Stepping gait that is symmetric, grounded, and footfalls are evenly spaced in time.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000137 "single-foot gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/20.1.255") skos:scopeNote obo:ACTAN_0000137 "\"The single-foots, therefore, have advantages for economy of effort.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") Annotation(rdfs:comment "doi:10.1093/icb/20.1.255") skos:scopeNote obo:ACTAN_0000137 "This gait may be walking or running.")
SubClassOf(obo:ACTAN_0000137 obo:ACTAN_0000124)
SubClassOf(obo:ACTAN_0000137 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000148))
SubClassOf(obo:ACTAN_0000137 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000152))
SubClassOf(obo:ACTAN_0000137 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000056))
SubClassOf(obo:ACTAN_0000137 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000135))
SubClassOf(obo:ACTAN_0000137 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))

# Class: obo:ACTAN_0000138 (alternating-tetrapod pattern)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000138 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000138 "2024-09-22T11:18:27.852163Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF00197760") oboInOwl:hasDefinition obo:ACTAN_0000138 "Symmetry pattern in which two sets of four propulsors operate, one after the other.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasExactSynonym obo:ACTAN_0000138 "alternating tetrapod"@en)
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF00197760") oboInOwl:hasRelatedSynonym obo:ACTAN_0000138 "trotting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000138 "alternating-tetrapod pattern"@en)
SubClassOf(obo:ACTAN_0000138 obo:ACTAN_0000135)

# Class: obo:ACTAN_0000139 (undulation bending)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000139 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000139 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000139 "2026-05-31T19:52:01.561581Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"At the same time the head is inclined sidewards, one locomotory wave passes through the body ending with a beat of the tail, the unpaired fins and the pelvics are erected and the pactorals make braking movements which neutralise the additional propulsive force.\"") oboInOwl:hasDefinition obo:ACTAN_0000139 "Bending in which one locomotory wave passes through the body.

It may involve the tail and end with braking movements which neutralise additional propulsive force.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000139 "body undulation")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000139 "propulsive contortion")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000139 "undulating body movement")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") oboInOwl:hasExactSynonym obo:ACTAN_0000139 "waving of the body")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000139 "undulation bending"@en)
SubClassOf(obo:ACTAN_0000139 obo:ACTAN_0000737)
SubClassOf(obo:ACTAN_0000139 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000690))

# Class: obo:ACTAN_0000140 (alternating-tripod pattern)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000140 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000140 "2024-09-22T13:55:58.09164Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF00197760") oboInOwl:hasDefinition obo:ACTAN_0000140 "Symmetry pattern in which two sets of three propulsors operate, one after the other.")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000140 "alternating tripod"@en)
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF00197760") oboInOwl:hasRelatedSynonym obo:ACTAN_0000140 "trotting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000140 "alternating-tripod pattern"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000140 "\"Coenobita compressus (H. Milne Edwards) walk forward on six legs using an alternating tripod gait similar to that of insects.\"")
SubClassOf(obo:ACTAN_0000140 obo:ACTAN_0000135)

# Class: obo:ACTAN_0000141 (alternating-monopod pattern)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000141 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000141 "2024-09-22T15:35:21.957629Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF00197760") Annotation(skos:scopeNote "\"Gait: Animals of very different design can use similar gaits. Many species can use a regularly symmetrical alternating gait (e.g., a trot). Two sets of propulsers are used, one after the other. The set can differ in the number of legs used (e.g., one for a human, two for a dog, three for a cockroach and four for a crab).\"") oboInOwl:hasDefinition obo:ACTAN_0000141 "Symmetry pattern in which two propulsors operate, one after the other.")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF00197760") oboInOwl:hasRelatedSynonym obo:ACTAN_0000141 "bipedal")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF00197760") oboInOwl:hasRelatedSynonym obo:ACTAN_0000141 "trotting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF00197760") Annotation(skos:scopeNote "\"...symmetrical alternating gait (e.g., a trot). Two sets of propulsers are used, one after the other. The set can differ in the number of legs used (e.g., one for a human...\"") rdfs:label obo:ACTAN_0000141 "alternating-monopod pattern"@en)
SubClassOf(obo:ACTAN_0000141 obo:ACTAN_0000135)

# Class: obo:ACTAN_0000142 (contralateral-bipodal pattern)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000142 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000142 "2024-09-22T15:36:12.620717Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF00197760") Annotation(dc:source "doi:10.1093/icb/20.1.255") Annotation(skos:scopeNote "\"Further, at slow and moderate speeds, the bipods that combine support by a fore and a hind foot are more often contralateral (more stable) than ipsilateral (less stable) for the transverse gallop than for the rotary gallop.\" (doi:10.1093/icb/20.1.255)") Annotation(skos:scopeNote "\"Gait: Animals of very different design can use similar gaits. Many species can use a regularly symmetrical alternating gait (e.g., a trot). Two sets of propulsers are used, one after the other. The set can differ in the number of legs used (e.g., one for a human, two for a dog, three for a cockroach and four for a crab).\" (doi:10.1007/BF001977600)") oboInOwl:hasDefinition obo:ACTAN_0000142 "Symmetry pattern in which two sets of two propulsors, one after the other, combine support by a fore and a hind foot on opposite sides.")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") Annotation(skos:scopeNote "\"...the bipods that combine support by a fore and a hind foot are more often contralateral...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000142 "contralateral bipodal"@en)
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3390/ani13162557") oboInOwl:hasRelatedSynonym obo:ACTAN_0000142 "contralateral bipedal")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000142 "contralateral-bipodal pattern"@en)
SubClassOf(obo:ACTAN_0000142 obo:ACTAN_0000135)

# Class: obo:ACTAN_0000143 (ipsilateral-bipod pattern)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000143 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000143 "2024-09-22T15:36:30.687031Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF00197760") Annotation(dc:source "doi:10.1093/icb/20.1.255") Annotation(skos:scopeNote "\"Further, at slow and moderate speeds, the bipods that combine support by a fore and a hind foot are more often contralateral (more stable) than ipsilateral (less stable) for the transverse gallop than for the rotary gallop.\" (doi:10.1093/icb/20.1.255)") Annotation(skos:scopeNote "\"Gait: Animals of very different design can use similar gaits. Many species can use a regularly symmetrical alternating gait (e.g., a trot). Two sets of propulsers are used, one after the other. The set can differ in the number of legs used (e.g., one for a human, two for a dog, three for a cockroach and four for a crab).\" (doi:10.1007/BF00197760)") oboInOwl:hasDefinition obo:ACTAN_0000143 "Symmetry pattern in which two sets of two propulsors, one after the other, combine support by a fore and a hind foot on the same side.")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000143 "ipsilateral bipod"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000143 "ipsilateral-bipod pattern"@en)
SubClassOf(obo:ACTAN_0000143 obo:ACTAN_0000135)

# Class: obo:ACTAN_0000144 (transition localization)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000144 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000144 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000144 "2026-06-02T13:51:55.532784Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.11369/jji1950.34.76") Annotation(skos:scopeNote "\"Invariably they arrived at the point of apex of the spawning rush at about the same moment that the spawning aggregation had returned to the shelter of the algal substratum.\"") oboInOwl:hasDefinition obo:ACTAN_0000144 "Localization that has a point and moment of change.")
AnnotationAssertion(Annotation(dc:date "2016"^^xsd:decimal) Annotation(dc:source "doi:10.3819/ccbr.2016.110005") oboInOwl:hasRelatedSynonym obo:ACTAN_0000144 "change location")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000144 "change of habit")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasRelatedSynonym obo:ACTAN_0000144 "direction change")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:comment obo:ACTAN_0000144 "This is an aggregator for better defined changes and NOT recommended simply to log deviations in position or direction.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000144 "transition localization"@en)
SubClassOf(obo:ACTAN_0000144 obo:ACTAN_0000290)
SubClassOf(obo:ACTAN_0000144 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

# Class: obo:ACTAN_0000145 (hop gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000145 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000145 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000145 "2024-09-22T17:31:02.749659Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"L4. Bipedal hop: Torso-orthograde ( [ ) bipedal progression wherein the hindlimbs push off and land roughly simultaneously;\"") oboInOwl:hasDefinition obo:ACTAN_0000145 "Stepping gait that is bouncing, and uses a bipedal, asymmetric gait pattern, wherein the hindlimbs push off and land roughly simultaneously.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000145 "hop")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasExactSynonym obo:ACTAN_0000145 "hopping"@en)
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") oboInOwl:hasRelatedSynonym obo:ACTAN_0000145 "functionally monopedal")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000145 "hop gait")
SubClassOf(obo:ACTAN_0000145 obo:ACTAN_0000124)
SubClassOf(obo:ACTAN_0000145 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000091))
SubClassOf(obo:ACTAN_0000145 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000199))
SubClassOf(obo:ACTAN_0000145 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000054))
SubClassOf(obo:ACTAN_0000145 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000136))

# Class: obo:ACTAN_0000146 (extending suspension)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000146 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000146 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000146 "2024-09-22T20:34:05.500204Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/20.1.255") Annotation(skos:scopeNote "\"Plots in the lower quadrant represent gaits having one suspension in each cycle, and it occurs when the feet are extended, forward and backward, and the back is dorsoflexed.\"") oboInOwl:hasDefinition obo:ACTAN_0000146 "Suspension when a quadruped's feet are extended, forward and backward.")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000146 "extended suspension"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000146 "extending suspension"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/20.1.255") skos:scopeNote obo:ACTAN_0000146 "\"...the faster cursors among such animals tend to incorporate the suspensions into a gallop (deer, sheep) whereas the smaller and most agile mammals tend to incorporate the suspension into the bound or half bound (rodents, many mustelids, and felids). The
suspension is commonly 50% of the cycle, and may range up to 80% (pronking deer, Patagonian cavy, jumping mouse).\"")
SubClassOf(obo:ACTAN_0000146 obo:ACTAN_0000091)
SubClassOf(obo:ACTAN_0000146 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000756))
SubClassOf(obo:ACTAN_0000146 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000763))

# Class: obo:ACTAN_0000147 (kinetics activity)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000147 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000147 "2024-09-22T20:39:30.674958Z")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") oboInOwl:hasBroadSynonym obo:ACTAN_0000147 "dynamic")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icac125") Annotation(skos:scopeNote "\"Kinematic (the study of themovement of body parts) and kinetic (the study of energetic and force patterns) analysis techniques are often used to identify functional differences in “gaits,” defined as particular cyclical pattern of movement characteristic of a limited range of speeds in which momentum is conserved across repeated cycles, described by quantities of which one or more change discontinuously at transitions to other gaits.\"") oboInOwl:hasDefinition obo:ACTAN_0000147 "Activity that is about energetic and force patterns.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000147 "kinetics"@en)
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasNarrowSynonym obo:ACTAN_0000147 "energetics")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000147 "kinetics activity")
SubClassOf(obo:ACTAN_0000147 obo:ACTAN_0000078)

# Class: obo:ACTAN_0000148 (stabilizing kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000148 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000148 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000148 "2024-09-22T20:46:18.611216Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasDefinition obo:ACTAN_0000148 "Kinetics which acts to minimise a rotation.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000148 "stability")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000148 "stabilization")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000148 "steadying")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasRelatedSynonym obo:ACTAN_0000148 "destabilizing")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000148 "instability")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000148 "stabilising"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000148 "stabilizing")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000148 "stable")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000148 "unstable")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000148 "stabilizing kinetics")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:example obo:ACTAN_0000148 "\"Among prehensile-tailed New World monkeys many positional modes are stabilized by tail grips.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/20.1.255") skos:example obo:ACTAN_0000148 "\"We conclude that the slow gaits of most tetrapods, including all tippy ones like turtles, should fall in the upper left quadrant of the gait graph. Any exceptions may be expected to be animals for which stability is assured by large feet or a wide stance. This expectation is realized: Animals known to walk in diagonal sequence are primates and the giant armadillo, aardvark, and kinkajou.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:scopeNote obo:ACTAN_0000148 "\"...stable designs not only resist externally imposed changes in an organism’s trajectory, but they also resist changes imposed by the animal itself. In contrast, mechanically unstable bodies that can easily be blown off course are also very responsive to voluntary steering maneuvers.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.204.8.1459") skos:scopeNote obo:ACTAN_0000148 "\"Destabilizing recoil forces generated by the yaw and sideslip inherent in undulatory body and caudal-fin (BCF) modes of rectilinear fish swimming are thought to produce significantly more drag than is expected in fishes swimming with rigid bodies.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.130.1.155") skos:scopeNote obo:ACTAN_0000148 "\"Muscles in crabs and small mammals may function more to stabilize joints and operate as springs.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000148 "\"The stability of fishes in the first place depends on the relative positions of the centres of gravity and of buoyancy (centre of volume). If the former is situated above the latter the equilibrium is unstable; if the centre of gravity, however, lies below the centre of buoyancy or coincides with it, the equilibrium is stable.\"")
SubClassOf(Annotation(dc:source "doi:10.1126/science.288.5463.100") obo:ACTAN_0000148 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000148 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001035))

# Class: obo:ACTAN_0000149 (manoeuvre kinematics)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000149 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000149 "2024-09-23T07:49:22.422162Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(skos:scopeNote "\"When the prey lies directly ahead about one head length away the fish stops and commences Hovering while continually adjusting to maintain its position relative to the prey.\"") oboInOwl:hasDefinition obo:ACTAN_0000149 "Kinematics that adjusts a relative position.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000149 "maneuver")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000149 "maneuvering")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00227-014-2403-0") oboInOwl:hasExactSynonym obo:ACTAN_0000149 "manoeuver"@en)
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00227-014-2403-0") oboInOwl:hasExactSynonym obo:ACTAN_0000149 "manoeuvering"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000149 "manoeuvre"@en)
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rspb.1998.0424") oboInOwl:hasExactSynonym obo:ACTAN_0000149 "manoeuvring"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000149 "manoeuvre kinematics"@en)
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000149 "NBO:0000374")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:scopeNote obo:ACTAN_0000149 "\"...stable designs not only resist externally imposed changes in an organism’s trajectory, but they also resist changes imposed by the animal itself. In contrast, mechanically unstable bodies that can easily be blown off course are also very responsive to voluntary steering maneuvers.\"")
SubClassOf(obo:ACTAN_0000149 obo:ACTAN_0000747)

# Class: obo:ACTAN_0000150 (sprint kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000150 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000150 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000150 "2024-09-23T07:49:59.090585Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.01380") oboInOwl:hasDefinition obo:ACTAN_0000150 "Kinetics which is high-speed, short-term, and over a reduced distance.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasExactSynonym obo:ACTAN_0000150 "burst")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") oboInOwl:hasExactSynonym obo:ACTAN_0000150 "sprint")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000150 "sprinter"@en)
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasRelatedSynonym obo:ACTAN_0000150 "ballistic system")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000150 "sprint kinetics")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000150 obo:ACTAN_0000171)
AnnotationAssertion(Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") skos:example obo:ACTAN_0000150 "\"The fastest of all terrestrial runners on sprint is considered the cheetah, with a reliable measured speed of 105 km.h-1 (29.2 m.s-1).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000150 "\"We noted Uca pugilator could also travel at 0- 2 km [per hour] but they could run twice as fast for about 3 min and sprint at much higher speeds for a few seconds.\"")
SubClassOf(obo:ACTAN_0000150 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000150 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000303))
SubClassOf(obo:ACTAN_0000150 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001816))

# Class: obo:ACTAN_0000151 (propelling manoeuvre)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000151 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000151 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000151 "2024-09-23T07:50:21.008447Z")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000151 "progress")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000151 "progression")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1098/rsos.170467") Annotation(skos:scopeNote "\"Animals swam with either an anterior-first or posterior-first orientation.\"") oboInOwl:hasDefinition obo:ACTAN_0000151 "A manoeuvre that is anterior-first.")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000151 "forwards")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000151 "propelling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000151 "propelling manoeuvre")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.156.1.215") skos:example obo:ACTAN_0000151 "\"In half of the high-speed runs (N=13), cockroaches used only four legs (i.e. middle and hind legs). In the other half of the high-speed runs, cockroaches ran bipedally, propelling themselves exclusively with their hind legs.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/36.6.555") skos:scopeNote obo:ACTAN_0000151 "\"The mechanical efficiency of an aquatic propulsor represents the fraction of the total muscle power generated that is used to produce forward thrust.\"")
SubClassOf(obo:ACTAN_0000151 obo:ACTAN_0000149)
SubClassOf(obo:ACTAN_0000151 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000651))
SubClassOf(obo:ACTAN_0000151 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001900))

# Class: obo:ACTAN_0000152 (cruise kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000152 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000152 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000152 "2024-09-23T07:50:35.502166Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasDefinition obo:ACTAN_0000152 "Kinetics that is long-distance, continuous, steady, and intermediate speed.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1038/s42003-020-01521-z") oboInOwl:hasExactSynonym obo:ACTAN_0000152 "cruise")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasExactSynonym obo:ACTAN_0000152 "cruising")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000152 "endurance"@en)
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.194704") oboInOwl:hasRelatedSynonym obo:ACTAN_0000152 "sustained")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000152 "cruise kinetics")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000152 "\"Thus, it seems that hermit crabs have specialized in slow endurance locomotion while carrying a heavy load and have traded off sprinting behaviour for the protection of a mobile home.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:scopeNote obo:ACTAN_0000152 "\"...steady locomotion is more the exception than the rule for animals traveling through natural environments...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") skos:scopeNote obo:ACTAN_0000152 "\"Several gregarious predators, like canids, and other fast herbivores, like the pronghorn and some antelopes, need high endurance, that is to maintain the running speed as long as possible.\"")
SubClassOf(obo:ACTAN_0000152 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000152 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001817))

# Class: obo:ACTAN_0000153 (sidling manoeuvre)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000153 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000153 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000153 "2024-09-23T07:50:50.181182Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.120.1.283") Annotation(skos:scopeNote "\"While other crabs (decapod crustaceans) typically use octapedal locomotion and walk sideways, hermit crabs walk forward using six legs and provide an interesting comparison with other crustaceans as well as insects.\"") oboInOwl:hasDefinition obo:ACTAN_0000153 "A manoeuvre that is sideways.")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "doi:10.1093/auk/123.4.967") oboInOwl:hasExactSynonym obo:ACTAN_0000153 "lateral movement")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000153 "sideslipping")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasExactSynonym obo:ACTAN_0000153 "sidling")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasNarrowSynonym obo:ACTAN_0000153 "crabbing"@en)
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasRelatedSynonym obo:ACTAN_0000153 "sideways")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000153 "sidling manoeuvre")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000153 "\"...female Nocomis leptocephalus... entered the pit either by... swimming upstream to one side and sidling laterally into the pit.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/20.1.255") skos:scopeNote obo:ACTAN_0000153 "\"The long-legged greyhound commonly paces to avoid interference and can trot without crabbing only if moving relatively slowly.\"")
SubClassOf(obo:ACTAN_0000153 obo:ACTAN_0000149)
SubClassOf(obo:ACTAN_0000153 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000041))
SubClassOf(obo:ACTAN_0000153 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000650))

# Class: obo:ACTAN_0000154 (acceleration manoeuvre)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000154 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000154 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000154 "2024-09-23T07:51:03.052025Z")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1139/z98-044") oboInOwl:hasBroadSynonym obo:ACTAN_0000154 "linear maneuver")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasDefinition obo:ACTAN_0000154 "Manoeuvre that involves a positive change in speed over a given time course.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasExactSynonym obo:ACTAN_0000154 "accelerating")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000154 "acceleration"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") rdfs:label obo:ACTAN_0000154 "acceleration manoeuvre"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000154 obo:ACTAN_0000003)
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:example obo:ACTAN_0000154 "\"40% of the body mass of a shrimp is devoted to the large, tasty abdominal muscles that produce a powerful tail flick during rare, but critical, escape behaviors. During escape, rapid acceleration, rather than energy minimization, is the relevant aspect of performance.\"")
AnnotationAssertion(Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") skos:example obo:ACTAN_0000154 "\"Goatfishes... To escape , they simply swim off into open water, a system that depends on rapid acceleration and sustained speed among other things.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:scopeNote obo:ACTAN_0000154 "\"At its most fundamental level, locomotion is deceptively simple. An organism exerts a force on the external environment and, through Newton’s laws, accelerates in the opposite direction.\"")
SubClassOf(obo:ACTAN_0000154 obo:ACTAN_0000149)
SubClassOf(Annotation(dc:source "doi:10.1109/48.757275") obo:ACTAN_0000154 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000530))
SubClassOf(obo:ACTAN_0000154 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000651))
SubClassOf(obo:ACTAN_0000154 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001028))

# Class: obo:ACTAN_0000155 (interfacing-gait)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000155 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000155 "2026-06-09T16:38:46.665767Z")
AnnotationAssertion(Annotation(rdfs:comment "This is an aggregator class: please DON'T use it for annotation.") oboInOwl:hasDefinition obo:ACTAN_0000155 "Interfacing that involves a gait.")
AnnotationAssertion(rdfs:label obo:ACTAN_0000155 "interfacing-gait"@en)
SubClassOf(obo:ACTAN_0000155 obo:ACTAN_0000012)

# Class: obo:ACTAN_0000156 (pectoral-fin adduction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000156 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000156 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000156 "2026-07-12T11:00:41.955025Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasDefinition obo:ACTAN_0000156 "Adduction that results from pectoral adducting.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000156 "pectoral-fin adduction"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.204.8.1459") skos:example obo:ACTAN_0000156 "\"Boxfish Ostracion meleagris...
Pectoral fin-beat cycles started with the fins pressed against the body (maximally adducted)...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.204.8.1459") skos:scopeNote obo:ACTAN_0000156 "\"...most studies of MPF swimmers have demonstrated a significant refractory period at the end of the adduction phase.\"")
SubClassOf(obo:ACTAN_0000156 obo:ACTAN_0000630)
SubClassOf(obo:ACTAN_0000156 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000151))

# Class: obo:ACTAN_0000157 (pelvic-fin adduction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000157 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000157 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000157 "2026-07-12T12:20:44.386169Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000157 "Adduction that results from pelvic adducting.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000157 "pelvic-fin adduction"@en)
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000157 "\"Badis badis...
While swimming rapidly forward, the... pelvic fins, are usually folded against the body.\"")
SubClassOf(obo:ACTAN_0000157 obo:ACTAN_0000630)
SubClassOf(obo:ACTAN_0000157 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000152))

# Class: obo:ACTAN_0000158 (chaetodontiform gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000158 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000158 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000158 "2026-07-12T14:25:19.494529Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/s00338-007-0195-0") Annotation(skos:scopeNote "\"A third intermediate mode involved subcarangiform swimming augmented by pectoral fin strokes (simultaneous pectoral-caudal).\"") oboInOwl:hasDefinition obo:ACTAN_0000158 "Subcarangiform gait which is augmented by pectoral fin strokes.")
AnnotationAssertion(Annotation(dc:date "2007"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00338-007-0195-0") oboInOwl:hasExactSynonym obo:ACTAN_0000158 "augmented BCF")
AnnotationAssertion(Annotation(dc:date "2007"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00338-007-0195-0") oboInOwl:hasExactSynonym obo:ACTAN_0000158 "augmented body-caudal")
AnnotationAssertion(Annotation(dc:date "2007"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00338-007-0195-0") Annotation(skos:scopeNote "\"...chaetodontiform and subcarangiform modes...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000158 "chaetodontiform mode")
AnnotationAssertion(Annotation(dc:date "2007"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00338-007-0195-0") oboInOwl:hasExactSynonym obo:ACTAN_0000158 "chaetodontiform swimming")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000158 "chaetodontiform gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00338-007-0195-0") skos:example obo:ACTAN_0000158 "\"This pectoral-caudal mode was used widely within the chaetodontoids (with the exception of Pomacanthus and Hemitaurichthys, personal observation), and may therefore be referred to as Chaetodontiform swimming...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00338-007-0195-0") skos:scopeNote obo:ACTAN_0000158 "\"...chaetodontiform taxa using augmented BCF propulsion attained close (77.5 cm s–1) to the maximum experimental speeds displayed by labriform taxa (82.4 cm s–1).\"")
SubClassOf(obo:ACTAN_0000158 obo:ACTAN_0000268)
SubClassOf(obo:ACTAN_0000158 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000151))

# Class: obo:ACTAN_0000159 (gill expulsion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000159 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000159 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000159 "2026-07-12T18:30:30.093355Z")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000159 "squirting")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"That the force of the water exhaled from the gill orifices of fishes has a reactance which of necessity must be of some aid in sending them forward there can be no doubt.\"") oboInOwl:hasDefinition obo:ACTAN_0000159 "Expulsion in which a current of water is exhaled through a gill orifice.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...ejecting water through the gill orifices...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000159 "gill ejecting")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...exhaled from the gill orifices...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000159 "gill exhaling")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000159 "respiratory jet")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000159 "gill expulsion"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000159 "\"very cold water when Chaenobryttus is in a state of semi-hibernation they may sometimes be observed with no fin movement at all and with both sets of paired fins securely pressed against the sides. At such times the respiration is extremely superficial and appears to have little reactive effect. However, after a long period of time it was observed that they do move forward ever so slightly and that very occasionally the pectorals are brought into play to regain the previous position.\"")
SubClassOf(obo:ACTAN_0000159 obo:ACTAN_0000715)
SubClassOf(obo:ACTAN_0000159 ObjectSomeValuesFrom(obo:RO_0000057 obo:ZFA_0005389))

# Class: obo:ACTAN_0000160 (jetting gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000160 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000160 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000160 "2026-07-12T19:23:41.314986Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.027771") oboInOwl:hasDefinition obo:ACTAN_0000160 "Swimming-gait that generates a movement reaction to the momentum transferred by a moving plug of water squeezed out through a nozzle.")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.027771") oboInOwl:hasExactSynonym obo:ACTAN_0000160 "jet mode")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") Annotation(rdfs:comment "\"...“blowing” themselves along...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000160 "blowing along")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.198226") rdfs:label obo:ACTAN_0000160 "jetting gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rsos.170467") skos:example obo:ACTAN_0000160 "\"Mechanisms of producing jets during swimming in Nautilus: (1) by the contraction of the large head retractor muscle; (2) through the rhythmic contraction of the funnel wings.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:example obo:ACTAN_0000160 "\"Scallop swimming provides a simple example of a muscle generating positive work to act as a motor. The cycle begins... when the gape of the shell is maximal. Activation of the muscle... causes a rise in force and subsequent shortening producing the pressure to drive a jet of water that propels the animal.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00265-014-1841-5") skos:example obo:ACTAN_0000160 "\"The semelparous giant Australian cuttlefish, Sepia apama, form short-term mating pairs during the breeding season... Females usually convey receptivity through arm and body postures and convey non-receptivity through direct rejection (e.g., squirming, inking, or jetting)...\"")
SubClassOf(obo:ACTAN_0000160 obo:ACTAN_0000087)
SubClassOf(obo:ACTAN_0000160 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000030))
SubClassOf(obo:ACTAN_0000160 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000743))
SubClassOf(obo:ACTAN_0000160 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000164))
SubClassOf(obo:ACTAN_0000160 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000672))

# Class: obo:ACTAN_0000161 (short-pulsed jetting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000161 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000161 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000161 "2026-07-13T16:16:33.422308Z")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.027771") oboInOwl:hasBroadSynonym obo:ACTAN_0000161 "pulsed jetting")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.027771") Annotation(skos:scopeNote "\"Moreover, jet cycle period (contraction and refilling phase) decreased with increased speed for jet mode I (linear regression: d.f.=1, 28, F=36.365, P<0.001, R2=0.547) but jet cycle period increased with increased speed for jet mode II (linear regression: d.f.=1, 27, F=8.562, P=0.007, R2=0.241).\"") oboInOwl:hasDefinition obo:ACTAN_0000161 "Jetting in which jet cycle period (contraction and refilling phase) decreases with increased speed.

The ejected fluid rolls up into an isolated vortex ring.")
AnnotationAssertion(Annotation(dc:date "2018"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rsos.170467") oboInOwl:hasExactSynonym obo:ACTAN_0000161 "jet mode 1")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.027771") oboInOwl:hasExactSynonym obo:ACTAN_0000161 "jet mode I"@en)
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.027771") oboInOwl:hasExactSynonym obo:ACTAN_0000161 "short jet pulse")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.027771") oboInOwl:hasRelatedSynonym obo:ACTAN_0000161 "starting jet")
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.137.1.421") Annotation(skos:scopeNote "\"...subcritical... jet cycles...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000161 "subcritical jetting")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.027771") Annotation(skos:scopeNote "\"...short pulsed and long pulsed jet...\"") rdfs:label obo:ACTAN_0000161 "short-pulsed jetting")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000161 obo:ACTAN_0000159)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.027771") skos:example obo:ACTAN_0000161 "\"...brief squid Lolliguncula brevis...
The ratio of jet length based on the vorticity extent (Lω) to jet diameter based on peak vorticity locations (Dω) was <3.0 for jet mode I...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rsos.170467") skos:example obo:ACTAN_0000161 "\"In Nautilus the transition from jet mode 1 to jet mode 2 jets occurred at jet length to diameter ratio (Lj/Dj) of approximately 3 (jet mode 1 Lj/Dj <2.16; jet mode 2 Lj/Dj >3.16), similar to those observed in other jet propulsion swimmers (e.g. squid).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.027771") skos:scopeNote obo:ACTAN_0000161 "\"With the lack of a consistent dependence of jet mode on speed, jet mode I and II do not fall within the purview of classical ‘gaits’ as defined by Alexander. Given the dual mode propulsive system of squids, both the jet and the fins need to be considered for proper identification of gaits (and probably a wider speed range).\"")
SubClassOf(obo:ACTAN_0000161 obo:ACTAN_0000160)
SubClassOf(obo:ACTAN_0000161 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000499))

# Class: obo:ACTAN_0000162 (long-pulsed jetting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000162 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000162 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000162 "2026-07-13T17:13:35.119922Z")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.027771") oboInOwl:hasBroadSynonym obo:ACTAN_0000162 "pulsed jetting")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.027771") Annotation(skos:scopeNote "\"Moreover, jet cycle period (contraction and refilling phase) decreased with increased speed for jet mode I (linear regression: d.f.=1, 28, F=36.365, P<0.001, R2=0.547) but jet cycle period increased with increased speed for jet mode II (linear regression: d.f.=1, 27, F=8.562, P=0.007, R2=0.241).\"") oboInOwl:hasDefinition obo:ACTAN_0000162 "Jetting in which jet cycle period (contraction and refilling phase) increases with increased speed.

The ejected fluid develops into a leading vortex ring that separates or ‘pinches off’ from a long trailing jet.")
AnnotationAssertion(Annotation(dc:date "2018"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rsos.170467") oboInOwl:hasExactSynonym obo:ACTAN_0000162 "jet mode 2")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.027771") oboInOwl:hasExactSynonym obo:ACTAN_0000162 "jet mode II")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.027771") oboInOwl:hasExactSynonym obo:ACTAN_0000162 "long jet")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.027771") oboInOwl:hasExactSynonym obo:ACTAN_0000162 "long jet pulse")
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.137.1.421") oboInOwl:hasRelatedSynonym obo:ACTAN_0000162 "escape jet")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.027771") oboInOwl:hasRelatedSynonym obo:ACTAN_0000162 "starting jet")
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.137.1.421") oboInOwl:hasRelatedSynonym obo:ACTAN_0000162 "supracritical jet")
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.137.1.421") oboInOwl:hasRelatedSynonym obo:ACTAN_0000162 "supracritical speed jet")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.027771") rdfs:label obo:ACTAN_0000162 "long-pulsed jetting"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.027771") skos:example obo:ACTAN_0000162 "\"...brief squid Lolliguncula brevis...
The ratio of jet length [based on the vorticity extent (Lω)] to jet diameter [based on peak vorticity locations (Dω)] was... >3.0 for jet mode II...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rsos.170467") skos:example obo:ACTAN_0000162 "\"In Nautilus the transition from jet mode 1 to jet mode 2 jets occurred at jet length to diameter ratio (Lj/Dj) of approximately 3 (jet mode 1 Lj/Dj <2.16; jet mode 2 Lj/Dj >3.16), similar to those observed in other jet propulsion swimmers (e.g. squid).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.027771") skos:scopeNote obo:ACTAN_0000162 "\"With the lack of a consistent dependence of jet mode on speed, jet mode I and II do not fall within the purview of classical ‘gaits’ as defined by Alexander. Given the dual mode propulsive system of squids, both the jet and the fins need to be considered for proper identification of gaits (and probably a wider speed range).\"")
SubClassOf(obo:ACTAN_0000162 obo:ACTAN_0000160)
SubClassOf(obo:ACTAN_0000162 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000498))

# Class: obo:ACTAN_0000163 (push-off thrust)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000163 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000163 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000163 "2026-07-14T07:03:30.40683Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1126/science.288.5463.100") Annotation(skos:scopeNote "\"First, consider legged locomotion on land, where each leg pushes against the ground, producing an equal and opposite ground reaction force.\"") oboInOwl:hasDefinition obo:ACTAN_0000163 "Thrust in which a grounded push produces an equal and opposite ground reaction force, causing locomotion.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000163 "push-off")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasRelatedSynonym obo:ACTAN_0000163 "GRF")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasRelatedSynonym obo:ACTAN_0000163 "ground reaction force")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000163 "push-off thrust"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") skos:example obo:ACTAN_0000163 "\"Frogfish are operating in a microgravity environment and their “walking” behavior produces GRFs via fin-ground interactions allowing frogfish to maintain their body above the substrate for most of the locomotor cycle or even enter into a suspension phase (where no appendages are in contact with the substrate).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:example obo:ACTAN_0000163 "\"In a running cockroach, hind-leg ground reaction forces propel the animal forward,
whereas each foreleg ground reaction force pushes backward, counter to the animal's
movement. The middle-leg ground reaction force begins by pushing backward but then
pushes forward at the end of the stance phase. In addition to these fluctuating fore-aft forces, all legs act to push the body toward the midline.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000163 "NBO:0000016")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") skos:scopeNote obo:ACTAN_0000163 "\"Bipedal hop: Torso-orthograde ( [ ) bipedal progression wherein the hindlimbs push off and land roughly simultaneously;\"")
SubClassOf(obo:ACTAN_0000163 obo:ACTAN_0000671)
SubClassOf(obo:ACTAN_0000163 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001022))

# Class: obo:ACTAN_0000164 (nozzle mode)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000164 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000164 "2026-07-14T08:18:52.715528Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000164 "Natatorial mode that uses an orifice out of which to direct fluid for thrust.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000164 "nozzle reaction")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000164 "syringograde")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000164 "nozzle mode"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000164 "\"However, on the sluggish forms a definite demonstration of this force of the exhaled water is a simple matter, the Tetraodonts demonstrating it most clearly, although it must be admitted that here, on account of the rather wide divergence of the exhalant apertures, “nozzle reaction” plays a relatively larger part.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000164 "\"...the so-called syringograde animals which suck up water slowly and expel it with violence through the same or a nearby aperture, such as the cephalopods, medusae and certain Odonata nymphs. This notoriously inefficient method may be compared to the discredited jet propulsion systems of the past.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:scopeNote obo:ACTAN_0000164 "\"Jet propulsion by bullet-shaped jellyfish is more energy efficient than that of dish-shaped jellyfish...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.137.1.421") skos:scopeNote obo:ACTAN_0000164 "\"The funnel, too, is more than the simple directional nozzle of fixed cross-section assumed in earlier studies. The... best explanation for the increasing pressure with constant flow at higher speeds is active reduction of the maximum (or possibly average) funnel radius... It is also difficult to explain the prolonged high pressures during an escape response unless funnel radius... continues to decrease under active muscle tension. Squid may well have continuous dynamic control over the funnel orifice allowing them to optimize power output from a given volume change at a given speed, a relatively complex problem.\"")
SubClassOf(obo:ACTAN_0000164 obo:ACTAN_0000019)

# Class: obo:ACTAN_0000165 (propulsion steering)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000165 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000165 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000165 "2026-07-14T13:03:23.229621Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000165 "Steering which involves asymmetric propulsion.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000165 "propulsion steering"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000165 "\"The families Trygonidae and Myliobatidae have carried the rajiform undulations a step further... Steering is accomplished for the most part by differential action of the pectorals. That is, in curving, the outside “wing” is speeded up or the inside one retarded which swings the animal accordingly.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000165 "\"Fishes using a simple flapping movement of the dorsal and anal may oscillate them both over to one side,\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000165 "\"Metameral waves may be propagated in greater number or be of larger size on one side than the other, instead of simply alternating uniformly.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000165 "\"Probably the most common method is a single flap of the tail to one side... In this action the tail is expanded to its full extent in making the stroke and contracted on its return to the median position in order to prevent a reverse turning action or any more forward motion than necessary.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.137.1.421") skos:scopeNote obo:ACTAN_0000165 "\"Squid... use a... jet which can direct thrust at any angle through a hemisphere below the body plane...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000165 "\"The operculum of one side may be held down tightly, forcing all the water out through the opposite one.\"")
SubClassOf(obo:ACTAN_0000165 obo:ACTAN_0000645)
SubClassOf(obo:ACTAN_0000165 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001024))

# Class: obo:ACTAN_0000166 (rudder steering)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000166 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000166 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000166 "2026-07-14T14:33:28.5453Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1098/rsos.200129") oboInOwl:hasDefinition obo:ACTAN_0000166 "Steering in which part of the animal is held at an angle to the direction of travel, causing unequal drag and inducing a yaw torque.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000166 "rudder")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasExactSynonym obo:ACTAN_0000166 "ruddering")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000166 "rudder steering"@en)
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") skos:example obo:ACTAN_0000166 "\"Swimming movements in boxfishes were much more complex and varied than classical descriptions indicated. At low to moderate rectilinear swimming speeds (<5 TL s-1, where TL is total body length), they were entirely median- and paired-fin swimmers, apparently using their caudal fins for steering.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000166 "\"Several myomeres on one side may be held tightly contracted so as to hold the body flexed...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000166 "\"The dorsal and anal may be held over to one side.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000166 "\"The tail may be held rigidly to one side, acting like a rudder.\"")
SubClassOf(obo:ACTAN_0000166 obo:ACTAN_0000645)
SubClassOf(obo:ACTAN_0000166 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002326))

# Class: obo:ACTAN_0000167 (face-about turning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000167 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000167 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000167 "2026-07-14T19:42:31.188059Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"Fishes at rest may face about without perceptibly moving forward by opposite fin movements on either side of the body.\"") oboInOwl:hasDefinition obo:ACTAN_0000167 "Turning which happens without perceptibly moving forward, by opposite movements on either side of the body.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000167 "face about")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...practically turn the fish on a point...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000167 "turn on a point")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000167 "face-about turning"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000167 "\"...pectoral fin movements... for Lagocephalus will practically turn the fish on a point if no forward motion is being made. In such long bodied forms as Esox and Lepisosteus, the pelvics may be brought into play also to aid in this action.\"")
SubClassOf(obo:ACTAN_0000167 obo:ACTAN_0000174)
SubClassOf(obo:ACTAN_0000167 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000654))

# Class: obo:ACTAN_0000168 (yawing rotating)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000168 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000168 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000168 "2024-09-23T13:24:29.195109Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasDefinition obo:ACTAN_0000168 "Rotating that shifts the centre of gravity laterally.

This can happen in a straight line, without circling.")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000168 "yawing"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...oscillation of the anterior part.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000168 "anterior oscillation")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...swinging the nose...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000168 "nose swinging")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasNarrowSynonym obo:ACTAN_0000168 "nose wig-wagging")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1038/ncomms1350") oboInOwl:hasRelatedSynonym obo:ACTAN_0000168 "swaying")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000168 "yawing rotating")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000168 obo:ACTAN_0000174)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000168 "\"Shifts in the centre of gravity are not dramatically evident in large crabs during locomotion. However, in small crabs the shell and abdomen yaw right and left with each step of the third appendages. As R3 extends behind the crab, the shell posterior yaws to the left; as L3 extends in its power thrust, the shell yaws to the right. Such rocking motions may increase the cost of locomotion.\"")
SubClassOf(obo:ACTAN_0000168 obo:ACTAN_0000013)
SubClassOf(obo:ACTAN_0000168 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000654))

# Class: obo:ACTAN_0000169 (irregularity pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000169 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000169 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000169 "2024-09-23T15:26:00.946727Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "Irregular gait run: Fast locomotion wherein footfall pattern follows no regular sequence.") oboInOwl:hasDefinition obo:ACTAN_0000169 "Gait pattern which follows no regular sequence.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.130.1.155") Annotation(skos:scopeNote "\"...irregularity of the pattern...\"") rdfs:label obo:ACTAN_0000169 "irregularity pattern"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.130.1.155") skos:example obo:ACTAN_0000169 "\"Maximum energy recovery during walking in crabs should occur if all eight 'inverted pendulums' were operating in a tightly coupled alternating tetrapod. Yet irregular stepping patterns were used by the ghost crab during normal sideways walking. This indicates that the summed forces from all legs provides a rather consistent lift and acceleration of the body, even though the forces produced by individual legs may vary. Irregular stepping patterns appear to be the rule among free-walking crustaceans, rather than the exception.\"")
SubClassOf(obo:ACTAN_0000169 obo:ACTAN_0000126)
SubClassOf(obo:ACTAN_0000169 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000690))

# Class: obo:ACTAN_0000170 (metachronal-swimming gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000170 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000170 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000170 "2025-07-13T14:15:09.506653Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasDefinition obo:ACTAN_0000170 "Swimming-gait that involves waves of heaving appendages.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000170 "metachronal rowing")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000170 "metachronal stroking")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000170 "metachronal swimming"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000170 "metachronal-swimming gait"@en)
SubClassOf(obo:ACTAN_0000170 obo:ACTAN_0000087)
SubClassOf(obo:ACTAN_0000170 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000535))
SubClassOf(obo:ACTAN_0000170 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000736))
SubClassOf(obo:ACTAN_0000170 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000059))
SubClassOf(obo:ACTAN_0000170 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000128))

# Class: obo:ACTAN_0000171 (boost regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000171 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000171 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000171 "2024-09-23T15:26:24.038665Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") Annotation(skos:scopeNote "\"During fast displacements spiders did not maintain a constant speed. An explosive acceleration usually characterise the first stride, with the speed constantly decreasing thereafter. The stepping pattern observed during these sprints was very variable and irregular. The third pair of feet (the forefeet of the second quadruped) was prone to move in phase during the acceleration of the first stride, probably to boost the propulsion.\"") oboInOwl:hasDefinition obo:ACTAN_0000171 "Traversing-regime that involves an explosive acceleration, with one pair of feet moving in phase during the first stride.")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") oboInOwl:hasExactSynonym obo:ACTAN_0000171 "boosting"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000171 "boost regime"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000171 obo:ACTAN_0000150)
SubClassOf(obo:ACTAN_0000171 obo:ACTAN_0000089)
SubClassOf(obo:ACTAN_0000171 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000003))
SubClassOf(obo:ACTAN_0000171 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000173))
SubClassOf(obo:ACTAN_0000171 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

# Class: obo:ACTAN_0000172 (brake kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000172 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000172 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000172 "2024-09-23T15:26:48.622116Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000172 "Kinetics that applies a force to slow and stop.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000172 "braking"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000172 "checking")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasRelatedSynonym obo:ACTAN_0000172 "bluffing")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...coming to absolute rest.\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000172 "coming to rest")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000172 "stopping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000172 "brake kinetics")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000172 obo:ACTAN_0000673)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000172 "\"Lepomis and Micropterus at times curve their tails to one side and the dorsal and anal lobes to the other, thus checking movement and avoiding deflection.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.158.1.369") skos:example obo:ACTAN_0000172 "\"The prothoracic leg of B. discoidalis acted as a brake in the horizontal direction. Accelerating or pulling forces were not observed. At the same time, the first leg generated a vertical force comparable to that measured in the other two legs. The line of action of the three-dimensional ground reaction force vector pointed from the tarsus on the ground posteriorly towards the coxa. Contrary to the hypothesis of Hughes (1952), the leg functioned more as an inclined strut than as a lever.\"")
SubClassOf(obo:ACTAN_0000172 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000172 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000304))

# Class: obo:ACTAN_0000173 (transitioning switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000173 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000173 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000173 "2024-09-23T15:27:01.047174Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasDefinition obo:ACTAN_0000173 "Switch that changes gait.

This allows speed changes around the performance limits of different gaits.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasRelatedSynonym obo:ACTAN_0000173 "transitional gait")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasRelatedSynonym obo:ACTAN_0000173 "transitioning"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000173 "transitioning switch")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/1379571") skos:scopeNote obo:ACTAN_0000173 "\"Clearly, one cannot say just how many footfall formulas there are for actual asymmetrical gaits, but there are many. Even without those of transitional and improbable gaits, there are more, by an order of magnitude, than have heretofore been described.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ajp.23055") skos:scopeNote obo:ACTAN_0000173 "\"Shifting toward lateral sequence from diagonal sequence supports the hypothesis that primates’ ability to transition between gait types (i.e., flexibility) may be crucial for successfully occupying their arboreal niches.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/36.6.555") skos:scopeNote obo:ACTAN_0000173 "\"Species that swim by passing waves of bending of the body from head to tail often switch from steady axial undulation to a saltatory \"burst-and-coast\" mode of propulsion at high speeds... Many percomorph fishes, as well as some less-derived actinopterygians, swim over low speeds by pectoral fin propulsion (termed labriform locomotion by Breder, 1926) and with increasing speed supplement paired fin movements with caudal fin oscillation.\"")
SubClassOf(obo:ACTAN_0000173 obo:ACTAN_0000541)
SubClassOf(obo:ACTAN_0000173 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000008))

# Class: obo:ACTAN_0000174 (turning manoeuvre)

AnnotationAssertion(dc:source obo:ACTAN_0000174 "doi:10.1089/zeb.2012.0861")
AnnotationAssertion(terms:conformsTo obo:ACTAN_0000174 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000174 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000174 "2024-09-23T15:27:23.945476Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000174 "Manoeuvre that involves a change in orientation.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000174 "turn")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000174 "turn maneuver")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rsos.200129") rdfs:label obo:ACTAN_0000174 "turning manoeuvre")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000174 obo:ACTAN_0000645)
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:example obo:ACTAN_0000174 "\"The musculature supporting the seahorse fins is flexible and strong enough to provide additional functionality... These abilities are utilized during turn maneuvers to compensate for the inflexible body of the seahorse.\"")
SubClassOf(obo:ACTAN_0000174 obo:ACTAN_0000149)
SubClassOf(Annotation(dc:source "doi:10.1109/48.757275") obo:ACTAN_0000174 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000530))
SubClassOf(obo:ACTAN_0000174 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000039))
SubClassOf(obo:ACTAN_0000174 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001413))

# Class: obo:ACTAN_0000175 (positioning activity)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000175 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000175 "2024-09-23T20:46:55.391174Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.158.1.369") Annotation(skos:scopeNote "\"More importantly, we attempt to link the kinematics and kinetics of single legs to the whole body movement of a running hexaped.\"") oboInOwl:hasDefinition obo:ACTAN_0000175 "Activity that links the kinematics and kinetics of the whole body.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000175 "positional mode"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000175 "positioning activity")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:scopeNote obo:ACTAN_0000175 "\"We recommend a nomenclature that is not dedicated to or derived from any one taxonomic subset of the primates. Here we define 32 primate positional modes, divided more finely into 52 postural sub-modes and 74 locomotor sub-modes.\"")
SubClassOf(obo:ACTAN_0000175 obo:ACTAN_0000078)

# Class: obo:ACTAN_0000176 (locomotion positioning)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000176 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000176 "2024-09-23T20:47:13.072609Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icac125") Annotation(skos:scopeNote "\"Locomotion
How animals move from one place to another.\"") oboInOwl:hasDefinition obo:ACTAN_0000176 "Positioning that moves an animal from one place to another.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000176 "locomotion")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000176 "locomotor cycle"@en)
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000176 "locomotor mode")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasExactSynonym obo:ACTAN_0000176 "locomotor style")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853951X00214") oboInOwl:hasExactSynonym obo:ACTAN_0000176 "locomotory movement")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000176 "locomotion positioning")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000176 obo:ACTAN_0000341)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000176 "NBO:0000013")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icaa017") skos:scopeNote obo:ACTAN_0000176 "\"At some level, the terms “gait” and “locomotor mode” can be used interchangeably  given their common goal of identifying similarities and differences in patterns of movement, mechanics, or neural control.\"")
SubClassOf(obo:ACTAN_0000176 obo:ACTAN_0000175)

# Class: obo:ACTAN_0000177 (posture positioning)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000177 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000177 "2024-09-23T20:47:29.402044Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"COORDINATED LOCOMOTORY MOVEMENTS
Under this head we might distinguish: maintaining a stationary position...\"") oboInOwl:hasDefinition obo:ACTAN_0000177 "Positioning that is stationary.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000177 "poising")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000177 "postural mode")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000177 "posture")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000177 "posturing")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000177 "stationary position")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(rdfs:seeAlso obo:ACTAN_0000368) oboInOwl:hasNarrowSynonym obo:ACTAN_0000177 "orientated position")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1367395") oboInOwl:hasNarrowSynonym obo:ACTAN_0000177 "postural display"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000177 "posture positioning")
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000177 "\"Carrion Crow (Corvus corone) in ordinary passive anting posture typical of certain larger corvids. Note spread tail, somewhat pulled toward left wing, and lifted contour plumage.\"")
SubClassOf(obo:ACTAN_0000177 obo:ACTAN_0000175)
SubClassOf(obo:ACTAN_0000177 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000289))

# Class: obo:ACTAN_0000178 (travel context)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000178 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000178 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000178 "2024-09-23T20:50:16.061857Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000178 "Context which involves a starting position, a path, and the distance along it.

Being stationary may be considered zero distance travel.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasExactSynonym obo:ACTAN_0000178 "translocation")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000178 "travel")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000178 "travelling")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000178 "locomotion"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000178 "travel context")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000178 obo:ACTAN_0000176)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:scopeNote obo:ACTAN_0000178 "\"...according to Valenciennes, there is hardly a single group of fishes confined exclusively to fresh water, so that we may imagine that a marine member of a fresh-water group might travel far along the shores of the sea, and subsequently become modified and adapted to the fresh waters of a distant land.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:scopeNote obo:ACTAN_0000178 "\"Like other animals, C. elegans exhibit long-lasting behavioral states in which they display different movement patterns. By switching between different locomotion states, animals can alter how they explore their environment, for example searching for food locally vs. more globally...

In each locomotion state, C. elegans animals express a characteristic set of locomotor parameters over a long-lasting, stable time period.\"")
SubClassOf(obo:ACTAN_0000178 obo:ACTAN_0000751)
SubClassOf(Annotation(dc:source "doi:10.5962/p.203769") obo:ACTAN_0000178 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000040))

# Class: obo:ACTAN_0000179 (environment-mould)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000179 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000179 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000179 "2024-09-23T20:51:10.260824Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasDefinition obo:ACTAN_0000179 "Behavioural disposition that is realized when a behavioural mechanism is matched with its environment.

Multi-modal animals can utilize one type in different environments, with a level of adjustment made to accommodate the different conditions, or use two completely different mechanisms.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...inhabit a different medium...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000179 "inhabiting medium")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...the medium in which... animals live...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000179 "living medium")
AnnotationAssertion(Annotation(dc:date "1906"^^xsd:decimal) Annotation(dc:source "doi:10.1086/278651") Annotation(skos:scopeNote "\"...a homogeneous environment pressing upon all sides of the organism with almost the same intensity has moulded the form into a symmetrical contour which offers but little resistance in passing through the medium.\"") rdfs:label obo:ACTAN_0000179 "environment-mould")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") skos:example obo:ACTAN_0000179 "\"Mammals have achieved competent multi-modal abilities ranging from sustained powered forward flight to simple gliding operations. Two species of bat, the short tailed bat, Mystacina tuberculata, and the common vampire bat, Desmodus rotundus, are known to be able to fly competently but also have competent terrestrial ability. They both exhibit a quadrupedal gait, similar to that exhibited by other mammals during walking, and the common vampire bat has even achieved a novel gait pattern exhibiting traits similar to the definition of running.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000179 "\"The entire external, character of fishes , from the most general aspect down to minute details, reflects their locomotor qualifications, and indicates the power of their environment in moulding them.\"")
SubClassOf(obo:ACTAN_0000179 <http://humanbehaviourchange.org/ontology/BCIO_050416>)
SubClassOf(obo:ACTAN_0000179 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ENVO_00010483))

# Class: obo:ACTAN_0000180 (engineering context)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000180 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000180 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000180 "2024-09-23T20:52:26.830188Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icq077") Annotation(skos:scopeNote "\"Ecologists have long known that certain organisms fundamentally modify, create, or define habitats by altering the habitat’s physical properties. In the past 15 years, these processes have been formally defined as ‘‘ecosystem engineering’’, reflecting a growing consensus that environmental structuring by organisms represents a fundamental class of ecological interactions occurring in most, if not all, ecosystems.\"") oboInOwl:hasDefinition obo:ACTAN_0000180 "Context in which, in varying proportions, an organism fundamentally modifies, creates, and defines a habitat by altering its physical properties.")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icq077") oboInOwl:hasExactSynonym obo:ACTAN_0000180 "ecosystem engineering"@en)
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icq077") oboInOwl:hasExactSynonym obo:ACTAN_0000180 "environmental structuring")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000180 "engineering context"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000180 "\"Beaver dams represent a conspicuous example: by modifying the pattern of water flow in rivers, beaver dams ultimately create large ponds, which contain an altered abundance and composition of plants and animals.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:scopeNote obo:ACTAN_0000180 "\"Animal architecture naturally intersects with engineering, given that it must be structurally sound in design if it is to remain stable in the face of external environmental pressures and internal use.

Some animal architects are socalled ‘ecosystem engineers’, with their architecture not only changing the world for themselves, but also for many other species around them.\"")
SubClassOf(obo:ACTAN_0000180 obo:ACTAN_0000751)
SubClassOf(obo:ACTAN_0000180 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000077))

# Class: obo:ACTAN_0000181 (fossorial mould)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000181 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000181 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000181 "2024-09-23T20:52:44.98451Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasDefinition obo:ACTAN_0000181 "Mould which takes effect underground.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasNarrowSynonym obo:ACTAN_0000181 "tunnelling")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasRelatedSynonym obo:ACTAN_0000181 "fossorial"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000181 "subterranean")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000181 "fossorial mould"@en)
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:example obo:ACTAN_0000181 "\"Arguably the most bizarre tadpole in the world is that of the microhylid frog Otophryne robusta... This tadpole has been found shallowly buried in sand only at the bottom of streams in northern South America. It has a spiracular tube that is so long that it can extend above the sand even when the remainder
of the larva is concealed... The chondrocranium of Otophryne has a plethora of odd features, directly related to its combined fossorial/filter-feeding way of life.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") skos:scopeNote obo:ACTAN_0000181 "\"Modes of locomotion in nature can be decomposed broadly into three categories; terrestrial, aerial and aquatic. There are situations where the lines are blurred such as movement on the surface of water or underground tunnelling, but generally the types of locomotion used by the animals can be categorized into one of these three areas. The modes of locomotion can be broken down into specific types.\"")
SubClassOf(obo:ACTAN_0000181 obo:ACTAN_0000179)
SubClassOf(obo:ACTAN_0000181 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ENVO_01000060))

# Class: obo:ACTAN_0000182 (aerial mould)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000182 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000182 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000182 "2024-09-23T20:53:02.032652Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasDefinition obo:ACTAN_0000182 "Mould which takes effect in air.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasExactSynonym obo:ACTAN_0000182 "aerial mode")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/4533120") oboInOwl:hasRelatedSynonym obo:ACTAN_0000182 "aerial"@en)
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") oboInOwl:hasRelatedSynonym obo:ACTAN_0000182 "airborne")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000182 "aerial mould")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") Annotation(skos:scopeNote "\"TERRESTRIAL. Can be used generally to refer to the ground, as opposed to the canopy, or anything existing, forming, or living in the ground (e.g., rooted there), as distinct from something that is aerial (canopy-dwelling, e.g., arboreal or epiphytic). A ground-rooted plant taken as a whole can be described as \"terrestrial\" {e.g., in comparison to an epiphyte) or its roots can be described as terrestrial and its leaves as aerial. Context should make it clear whether these definitions or one of the other definitions of \"terrestrial\" or aerial is intended (i.e., land as opposed to \"aquatic,\" or earth as opposed to \"extraterrestrial\").\"") skos:scopeNote obo:ACTAN_0000182 "'Terrestrial' and 'aerial' can have alternate definitions in the context of forest canopy biology.")
SubClassOf(obo:ACTAN_0000182 obo:ACTAN_0000179)
SubClassOf(obo:ACTAN_0000182 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ENVO_00002005))

# Class: obo:ACTAN_0000183 (aquatic mould)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000183 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000183 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000183 "2024-09-23T20:53:16.930239Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasDefinition obo:ACTAN_0000183 "Mould which takes effect in water.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...adapted to an aquatic existence.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000183 "aquatic adapted"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasExactSynonym obo:ACTAN_0000183 "aquatic mode")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000183 "aquatic mould")
SubClassOf(obo:ACTAN_0000183 obo:ACTAN_0000179)
SubClassOf(obo:ACTAN_0000183 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ENVO_00002006))

# Class: obo:ACTAN_0000184 (supported mould)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000184 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000184 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000184 "2024-09-23T20:53:34.132498Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000184 "Mould which takes effect when using a weight bearing structure.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") Annotation(rdfs:comment "Although the source distinguishes between supported and suspensory forms of locomotion, it has not teased out the difference between this and the environmental material in use. In doing so, we are facilitating semantic drift towards the use of the term 'supported mode' to focus on the environmental material, and pushing the difference into its sub-classes.") oboInOwl:hasExactSynonym obo:ACTAN_0000184 "supported mode")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasRelatedSynonym obo:ACTAN_0000184 "arboreal")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasRelatedSynonym obo:ACTAN_0000184 "supported"@en)
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasRelatedSynonym obo:ACTAN_0000184 "terrestrial")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000184 "supported mould")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:scopeNote obo:ACTAN_0000184 "\"\"Substrate\" is commonly used to refer to a weight bearing structure on top of which a study subject stands or locomotes. Likewise, \"superstrate\" is a structure from which an animal suspends itself. We use \"support\" to mean both or either.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") Annotation(skos:scopeNote "\"TERRESTRIAL. Can be used generally to refer to the ground, as opposed to the canopy, or anything existing, forming, or living in the ground (e.g., rooted there), as distinct from something that is aerial (canopy-dwelling, e.g., arboreal or epiphytic). A ground-rooted plant taken as a whole can be described as \"terrestrial\" {e.g., in comparison to an epiphyte) or its roots can be described as terrestrial and its leaves as aerial. Context should make it clear whether these definitions or one of the other definitions of \"terrestrial\" or aerial is intended (i.e., land as opposed to \"aquatic,\" or earth as opposed to \"extraterrestrial\").\"") skos:scopeNote obo:ACTAN_0000184 "'Terrestrial', 'arboreal', and 'aerial' can have alternate definitions in the context of forest canopy biology.")
SubClassOf(obo:ACTAN_0000184 obo:ACTAN_0000179)
SubClassOf(obo:ACTAN_0000184 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ENVO_01000814))

# Class: obo:ACTAN_0000185 (facilitation engineering)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000185 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000185 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000185 "2024-09-23T20:54:25.455051Z")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1231780") oboInOwl:hasBroadSynonym obo:ACTAN_0000185 "facilitating"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.3389/fetho.2023.1231780") oboInOwl:hasDefinition obo:ACTAN_0000185 "Engineering in which one species alters conditions in a manner that improves the opportunities for another.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000185 "facilitation engineering"@en)
SubClassOf(obo:ACTAN_0000185 obo:ACTAN_0000180)
SubClassOf(obo:ACTAN_0000185 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0015004))

# Class: obo:ACTAN_0000186 (bridge mould)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000186 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000186 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000186 "2024-09-23T20:55:26.89597Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"The feet grasp a support on one side of a gap, the hands grasp support on the other side, with the body spanning the gap, in tension. Mothers may use their body as a \"bridge\" for infants (Fig. 18).\"") oboInOwl:hasDefinition obo:ACTAN_0000186 "Supported mould in which the body spans a gap, in tension.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000186 "bridging"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000186 "bridge mould"@en)
SubClassOf(obo:ACTAN_0000186 obo:ACTAN_0000184)
SubClassOf(obo:ACTAN_0000186 ObjectSomeValuesFrom(obo:BFO_0000051 obo:COB_0000022))

# Class: obo:ACTAN_0000187 (superstrate mould)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000187 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000187 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000187 "2024-09-23T20:55:41.659097Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"Likewise, \"superstrate\" is a structure from which an animal suspends itself.\"") oboInOwl:hasDefinition obo:ACTAN_0000187 "Supported mould in which an animal suspends itself below a superstrate.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000187 "suspensory mode")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasRelatedSynonym obo:ACTAN_0000187 "superstrate")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000187 "superstrate mould")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/jzo.12455") skos:example obo:ACTAN_0000187 "\"The sloths are the most suspensory of all extant mammals, and are incapable of hoisting themselves off the substrate when positioned above the support.\"")
SubClassOf(obo:ACTAN_0000187 obo:ACTAN_0000184)
SubClassOf(obo:ACTAN_0000187 ObjectSomeValuesFrom(obo:BFO_0000051 obo:BSPO_0000025))

# Class: obo:ACTAN_0000188 (substrate mould)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000188 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000188 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000188 "2024-09-23T20:55:56.901311Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"\"Substrate\" is commonly used to refer to a weight bearing structure on top of which a study subject stands or locomotes.\"") oboInOwl:hasDefinition obo:ACTAN_0000188 "Supported mould which operates on top of a weight bearing structure.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasRelatedSynonym obo:ACTAN_0000188 "substrate"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000188 "substrate mould"@en)
SubClassOf(obo:ACTAN_0000188 obo:ACTAN_0000184)
SubClassOf(obo:ACTAN_0000188 ObjectSomeValuesFrom(obo:BFO_0000051 obo:BSPO_0000022))

# Class: obo:ACTAN_0000189 (lift kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000189 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000189 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000189 "2026-07-15T10:15:45.156197Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"The resultant is the product of the inclination of the plane and the horizontal thrust.\"") oboInOwl:hasDefinition obo:ACTAN_0000189 "Kinetics that results from the vertical product of the inclination of any planes and the horizontal thrust.")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...control of elevation.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000189 "elevation control")
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.137.1.421") oboInOwl:hasExactSynonym obo:ACTAN_0000189 "lift production")
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.137.1.421") oboInOwl:hasNarrowSynonym obo:ACTAN_0000189 "hydrodynamic lift production")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000189 "lift kinetics"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000189 "\"Tylosurus marinus...This genus and its relatives, more especially the hemiramphids, are expert at... skittering over the surface of the sea. Their bodies are held at an angular elevation from the surface of about 30° or even more in an extremely rigid manner and their submerged tail is vibrated rapidly.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000189 "\"If a temporary tendency to rise or fall is not desirable and not readily obviated by the hydrostatic apparatus, the fins may be used to offset it and maintain a definite horizontal plane until an adjustment is made, by using any of the various muscular efforts, that will effect the desired result.\"")
SubClassOf(obo:ACTAN_0000189 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000189 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0005024))

# Class: obo:ACTAN_0000190 (flying locomotion)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000190 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000190 "2024-09-25T20:02:16.163935Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1126/science.288.5463.100") Annotation(skos:scopeNote "\"Flight is, however, distinct from swimming because, in addition to the thrust required to move forward, a flying animal must generate sufficient lift to remain aloft.\"") oboInOwl:hasDefinition obo:ACTAN_0000190 "Locomotion that generates sufficient lift to remain aloft.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000190 "flying"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000190 "locomotor .flight")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000190 "flying locomotion"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000190 obo:ACTAN_0000192)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000190 "NBO:0000367")
SubClassOf(obo:ACTAN_0000190 obo:ACTAN_0000176)
SubClassOf(obo:ACTAN_0000190 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000189))
SubClassOf(obo:ACTAN_0000190 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000182))

# Class: obo:ACTAN_0000191 (aerial plankton)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000191 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000191 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000191 "2024-09-25T20:03:34.319632Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/j.1744-7429.2000.tb00506.x") Annotation(skos:scopeNote "\"AERIAL PLANKTON.•Minute airborne organisms en masse, including mites, thrips, ballooning spiders, cysts, and many plant and fungal reproductive structures small enough to remain suspended in the air for potentially long intervals. The term is analogous to plankton in water, although most aerial plankton stay aloft only temporarily.\"") oboInOwl:hasDefinition obo:ACTAN_0000191 "Plankton that is airborne.

Most aerial plankton stay aloft only temporarily.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasNarrowSynonym obo:ACTAN_0000191 "ballooning")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") rdfs:label obo:ACTAN_0000191 "aerial plankton"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") skos:example obo:ACTAN_0000191 "Including mites, thrips, and ballooning spiders.")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000191 "\"...the ballooning spiders which simply drift about with air currents... are more comparable to planctonic forms with extended surfaces to assist in flotation.\"")
SubClassOf(obo:ACTAN_0000191 obo:ACTAN_0000043)
SubClassOf(obo:ACTAN_0000191 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000182))

# Class: obo:ACTAN_0000192 (fall kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000192 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000192 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000192 "2024-09-25T20:03:55.206356Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") oboInOwl:hasDefinition obo:ACTAN_0000192 "Kinetics which involve a gravitationally propelled descent.

The descent may be controlled.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000192 "fall")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "aquatic") oboInOwl:hasNarrowSynonym obo:ACTAN_0000192 "sink")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000192 "fall kinetics")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000192 obo:ACTAN_0000558)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000192 "\"Obviously any fish permanently or temporarily heavier than water may descend at will in any direction and at nearly any gradient by inclining their fins appropriately, depending on their structures. This is very commonly seen in the triglids although nearly all fishes of high specific gravity appear to use it at times.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000192 "\"We cannot doubt that each structure is of use to each kind of squirrel in its own country, by enabling it to escape birds or beasts of prey, or to collect food more quickly, or, as there is reason to believe, by lessening the danger from occasional falls.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") skos:scopeNote obo:ACTAN_0000192 "\"Studies of leaping and falling organisms tend to overemphasize arbitrary distinctions between gliding and parachuting to the detriment of the more critical issue of capacity for 'controlled descent.'\"")
SubClassOf(obo:ACTAN_0000192 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000192 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000128))

# Class: obo:ACTAN_0000193 (free-fall regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000193 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000193 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000193 "2024-09-26T19:21:08.837768Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") oboInOwl:hasDefinition obo:ACTAN_0000193 "Interfacing-regime that involves falling, without adaptive mechanisms to develop a high level of drag.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") oboInOwl:hasExactSynonym obo:ACTAN_0000193 "ballistic descent"@en)
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") oboInOwl:hasExactSynonym obo:ACTAN_0000193 "ballistic fall")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") oboInOwl:hasExactSynonym obo:ACTAN_0000193 "free-fall")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "aquatic") oboInOwl:hasNarrowSynonym obo:ACTAN_0000193 "sink")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000193 "free-fall regime")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000193 obo:ACTAN_0000238)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") skos:example obo:ACTAN_0000193 "\"Free fall can be either accidental, as when an animal is knocked from foliage, or intentional, as when insects descend from trees in a daily cycle.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:scopeNote obo:ACTAN_0000193 "\"...the fish remains immobile (except for the eyes and gills) but changes its position in the water column (moving from top to bottom) without moving any of its fins.\"")
SubClassOf(obo:ACTAN_0000193 obo:ACTAN_0000086)
SubClassOf(obo:ACTAN_0000193 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000192))
SubClassOf(obo:ACTAN_0000193 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000311))
SubClassOf(obo:ACTAN_0000193 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000173))
SubClassOf(obo:ACTAN_0000193 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

# Class: obo:ACTAN_0000194 (glide regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000194 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000194 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000194 "2024-09-26T19:21:23.508137Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") oboInOwl:hasDefinition obo:ACTAN_0000194 "Interfacing-regime that involves falling, in which the angle of descent is less than 45° from horizontal, without the use of propulsion, such that the organism's own adaptations determine the steepness of descent.

Gliding often requires a minimum descent speed, so that the organism must initially parachute some distance before it achieves appreciable forward motion.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000194 "glide")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000194 "gliding"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000194 "coasting")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000194 "flying")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000194 "soaring")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000194 "glide regime")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000194 "NBO:0000369")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000194 "\"Anguilla rostrata not infrequently arches its body and “coasts” downward by gravity alone, controlling the direction by turning the head and the radius of the arc which the body describes.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000194 "\"Cypselurus sp. and related “four-winged” forms doubtless have better control of their flight than the “two-winged” species, Halocypselurus, for the reason that the pelvics, which serve as posterior warping planes, give them more purchase for their limited amount of maneuvering.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000194 "\"Now look at the Galeopithecus or flying lemur, which formerly was falsely ranked amongst bats. It has an extremely wide flank-membrane, stretching from the corners of the jaw to the tail, and including the limbs and the elongated fingers: the flank membrane is, also, furnished with an extensor muscle. Although no graduated links of structure, fitted for gliding through the air, now connect the Galeopithecus with the other Lemuridæ, yet I can see no difficulty in supposing that such links formerly existed, and that each had been formed by the same steps as in the case of the less perfectly gliding squirrels; and that each grade of structure had been useful to its possessor.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000194 "\"Thoracocharax maculatus, owing to its long falcate pectorals is capable of soaring for considerable distances. Compared with the exocoetids there seems at first glance little similarity, but if viewed dorsally there is a pronounced one. The similarity is even greater between these characins and the “two-winged” flying fish, Halocypselurus. This is destroyed in the lateral view by the greatly dilated ventral region devoted to pectoral musculature. Except for housing this musculature it probably has little to do directly with their flight. This flight seems to be the simple trajectory of a characin leap flattened by the presence of these pectorals, although at times they seem to be able to sustain themselves for some little distance...\"")
SubClassOf(obo:ACTAN_0000194 obo:ACTAN_0000086)
SubClassOf(obo:ACTAN_0000194 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000189))
SubClassOf(obo:ACTAN_0000194 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000192))
SubClassOf(obo:ACTAN_0000194 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000173))
SubClassOf(obo:ACTAN_0000194 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

# Class: obo:ACTAN_0000195 (parachute regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000195 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000195 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000195 "2024-09-26T19:21:41.35768Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/j.1744-7429.2000.tb00506.x") Annotation(skos:scopeNote "\"PARACHUTE. - A falling or jumping organism having behavioral or morphological mechanisms to increase drag.\"") oboInOwl:hasDefinition obo:ACTAN_0000195 "Interfacing-regime that involves falling, with a mechanism to increase drag.

Associated with descent at a sharp angle (i.e., 45-90° from horizontal). Ballooning arthropods also parachute, but they are most likely to fall free during wind, resulting in notable horizontal movement such that their angle of descent may often meet the criterion for gliding; so called \"windblown\" parachuting.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000195 "parachute")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") oboInOwl:hasExactSynonym obo:ACTAN_0000195 "parachuting"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000195 "parachute regime")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") skos:example obo:ACTAN_0000195 "\"...a patagium attached the body section... in... the ‘Flying’ Gecko, Ptychozoon kuhli... automatically deploys upon the reptile launching into the air...

...Rhacophorus, are a group of tree frogs that have strong webbing located between their digits.

...the ‘flying’ snakes belonging to the genus group Chrysopelea... prominent body movements are utilized in air rather than simply relying on a fixed wing arrangement.

All the reptile examples detailed above really only exhibit... a parachuting aerial mode, reducing the sinking speed of the animal slightly.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000195 "\"Aequidens latfrons...
After the parents have ejected the young over the pit these sink down slowly with turning movements like maple seeds. The yolk is apparently heavier than the tail which brakes the sinking movement.\"")
SubClassOf(obo:ACTAN_0000195 obo:ACTAN_0000086)
SubClassOf(obo:ACTAN_0000195 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000192))
SubClassOf(obo:ACTAN_0000195 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000251))
SubClassOf(obo:ACTAN_0000195 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000173))
SubClassOf(obo:ACTAN_0000195 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

# Class: obo:ACTAN_0000196 (swimming locomotion)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000196 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000196 "2024-09-26T19:24:52.557344Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasDefinition obo:ACTAN_0000196 "Locomotion that uses a fluid propulsor to produce thrust in an aquatic environment.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000196 "swimming"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") rdfs:label obo:ACTAN_0000196 "swimming locomotion"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000196 "NBO:0000371")
SubClassOf(obo:ACTAN_0000196 obo:ACTAN_0000176)
SubClassOf(obo:ACTAN_0000196 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000183))

# Class: obo:ACTAN_0000197 (punt regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000197 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000197 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000197 "2024-09-26T19:25:07.233132Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icac125") Annotation(skos:scopeNote "\"Punt
A characteristic of walking-like locomotor patterns characterized by (1) slow speeds, and (2) suspension phases due to the microgravity of aquatic environments, as seen in hippopotami, skates, and crocodiles.\"") oboInOwl:hasDefinition obo:ACTAN_0000197 "Interfacing-regime that has walking-like locomotor patterns, slow speeds, and suspension phases due to the microgravity of aquatic environments.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000197 "punt"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000197 "punt regime")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000197 obo:ACTAN_0000547)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") skos:example obo:ACTAN_0000197 "\"As seen in hippopotami, skates, and crocodiles.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:example obo:ACTAN_0000197 "\"However, when the tide comes in and the crabs are buoyed up by the water around them, hydrodynamic forces are more important than gravity. Underwater, the animals switch to a gait in which only an occasional push with one or two legs on the substratum is sufficient to keep the animal gliding horizontally.\"")
AnnotationAssertion(skos:example obo:ACTAN_0000197 "\"The angulated paired fins are used as paddles and in many cases resemble feet more than they do fins, the mechanics of which are evident...

Ogcocephalus vespertilio (Linnaeus) and other similar forms are reputed to use the fore and hind “limbs” in a manner reminiscent of frogs, the latter aiding in launching them on their way.\"")
SubClassOf(obo:ACTAN_0000197 obo:ACTAN_0000086)
SubClassOf(obo:ACTAN_0000197 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000065))
SubClassOf(obo:ACTAN_0000197 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000173))
SubClassOf(obo:ACTAN_0000197 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000183))

# Class: obo:ACTAN_0000198 (wedged-concertina gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000198 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000198 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000198 "2024-09-26T19:28:20.32402Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icaa017") Annotation(rdfs:comment "The definition is derived from a description of the tunnel concertina but is broadened with the term 'channel' to replace 'tunnel' in order to account for semi-exposed uses of this form of locomotion.") oboInOwl:hasDefinition obo:ACTAN_0000198 "Climbing gait that maintains lateral pressure against the sides of a channel while concertinaing, and axial motor patterns are not propagated along the entire length of the animal.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") oboInOwl:hasExactSynonym obo:ACTAN_0000198 "concertina by wedging")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasNarrowSynonym obo:ACTAN_0000198 "tunnel concertina"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000198 "wedged-concertina gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") skos:scopeNote obo:ACTAN_0000198 "\"Describes a snake using static points of contact with supports, by wedging its posterior into surface irregularities with short-radius bends, extending its anterior to grasp more irregularities, then pulling up the posterior.\"")
SubClassOf(obo:ACTAN_0000198 obo:ACTAN_0000256)
SubClassOf(obo:ACTAN_0000198 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000695))
SubClassOf(obo:ACTAN_0000198 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000734))
SubClassOf(obo:ACTAN_0000198 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000052))
SubClassOf(obo:ACTAN_0000198 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))
SubClassOf(obo:ACTAN_0000198 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000241))

# Class: obo:ACTAN_0000199 (bounce kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000199 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000199 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000199 "2024-09-27T18:46:29.241989Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1126/science.288.5463.100") Annotation(skos:scopeNote "\"As a leg strikes the ground in a running gait, kinetic and gravitational potential energy is temporarily stored as elastic strain energy in muscles, tendons, and ligaments and then is nearly all recovered during the propulsive second half of the stance phase.\"") oboInOwl:hasDefinition obo:ACTAN_0000199 "Kinetics that temporarily stores kinetic and gravitational potential energy as elastic strain energy in muscles, tendons, and ligaments and then is nearly all recovered during the next movement phase.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000199 "bounce"@en)
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000199 "elasticity")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rspb.1998.0424") oboInOwl:hasExactSynonym obo:ACTAN_0000199 "pogo stick")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000199 "spring")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000199 "bounce kinetics")
SubClassOf(obo:ACTAN_0000199 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000199 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001171))

