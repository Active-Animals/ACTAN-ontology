# Class: obo:ACTAN_0000512 (strike catch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000512 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000512 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000512 "2024-12-29T15:38:42.653977Z")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasBroadSynonym obo:ACTAN_0000512 "striking")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") oboInOwl:hasDefinition obo:ACTAN_0000512 "Catch that comprises a highly stereotyped, rapid, large-amplitude depression of the jaw concurrent with cranial elevation.

In water, it may be preceded by an attack swim or S-strike tail movements.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") oboInOwl:hasExactSynonym obo:ACTAN_0000512 "capture strike maneuver"@en)
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.00424") oboInOwl:hasExactSynonym obo:ACTAN_0000512 "predatory strike")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") oboInOwl:hasNarrowSynonym obo:ACTAN_0000512 "S-strike")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000512 "strike catch")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000512 obo:ACTAN_0000123)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000512 obo:ACTAN_0000594)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000512 obo:ACTAN_0000660)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000512 obo:ACTAN_0000859)
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000512 "\"Badis badis...

While thus fixing on the worm the fish forms a slight Sickle-shape, and then strikes forward grasping the free tip of the worm. Hence this maneuver is the same as that used in capturing free-swimming prey, except it has a different orientation.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2019.11.022") skos:scopeNote obo:ACTAN_0000512 "\"Most commonly, predators will perform an attack swim once prey reach a ‘‘strike zone.’’ If, however, the prey becomes centered in the visual field at a greater distance, [predators] may resort to using their fins to keep the prey centered until it reaches the strike zone and then release an S-strike.\"")
SubClassOf(obo:ACTAN_0000512 obo:ACTAN_0000907)
SubClassOf(obo:ACTAN_0000512 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000847))

# Class: obo:ACTAN_0000513 (colouration activity)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000513 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000513 "2024-12-30T08:56:23.997061Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000513 "Activity in which changes in pigmentation occur in response to changing conditions.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000513 "assumed marking")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000513 "coloration response")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000513 "colour change")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000513 "tinting")
AnnotationAssertion(Annotation(dc:date "2012"^^xsd:decimal) Annotation(dc:source "doi:10.1111/eth.12027") oboInOwl:hasNarrowSynonym obo:ACTAN_0000513 "ephemeral nuptial colouration")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000513 "colouration activity")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12891") skos:example obo:ACTAN_0000513 "\"Cephalopods... with their colour patterns displayed and changed by chromatophores... controlled by the dispersal and concentration of pigments via intracellular innervated radial muscles... European cuttlefish, which produce dark rings around the eyes and dark eyespots on the dorsum... can also produce directional displays presenting deimatic patterning only towards the predator and cryptic patterning away from the predator...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/eth.12027") skos:example obo:ACTAN_0000513 "\"Zebrafish...

Our colour estimates indicate that both sexes changed colour over time and that most sex differences in colour were expressed in the morning, during mating. Sex differences of the light stripes became particularly apparent during this time.\"")
SubClassOf(obo:ACTAN_0000513 obo:ACTAN_0000078)

# Class: obo:ACTAN_0000514 (backing manoeuvre)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000514 <https://github.com/Active-Animals/Ontology/patterns/manoeuvre>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000514 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000514 "2024-12-30T15:47:34.641164Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1098/rsos.170467") Annotation(skos:scopeNote "\"Animals swam with either an anterior-first or posterior-first orientation.\"") oboInOwl:hasDefinition obo:ACTAN_0000514 "A manoeuvre that is posterior-first.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000514 "backing")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.021360") oboInOwl:hasExactSynonym obo:ACTAN_0000514 "backing maneuver")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000514 "backing-up"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...move the specimen in a backward direction...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000514 "move backward")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000514 "reversal")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...travel, at least short distances, backward...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000514 "travel backward")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000514 "backing manoeuvre")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.021360") skos:example obo:ACTAN_0000514 "\"...in bluegill sunfish, Lepomis macrochirus...

During backing up, the ventral lobe initiated a dorsally directed wave along the distal edge of the caudal fin.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10164-009-0176-6") skos:example obo:ACTAN_0000514 "\"Both the male and female Gryllus bimaculatus used in this study were sexually mature virgins of similar age... the mate guarding intensity (the number of body judders and antennal whips/rotations) was recorded every minute until the male entered into courtship (determined by production of long courtship song whilst backing towards the female;\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000514 "NBO:0000101")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000514 "\"A superficial glance at nearly any typical fish poised quietly in the water should convince anyone that the pectorals are engaged in backing water. That is, the effective thrust is forward, which would tend to move the specimen in a backward direction... However in connection with the effect of the exhaled water it is conceived that the function of this movement of the pectorals is to neutralize its reactive force.\"")
SubClassOf(obo:ACTAN_0000514 obo:ACTAN_0000149)
SubClassOf(obo:ACTAN_0000514 ObjectSomeValuesFrom(obo:RO_0000086 obo:ACTAN_0000651))
SubClassOf(obo:ACTAN_0000514 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001901))

# Class: obo:ACTAN_0000515 (burst-coast regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000515 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000515 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000515 "2024-12-30T16:12:44.158405Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Fish move forward (burst) in a single motion and glide (coast) to a slow speed, or stop from which they burst forward again.\"") oboInOwl:hasDefinition obo:ACTAN_0000515 "Swimming-regime that moves forward in a single motion, and coasts to a slow speed from which they burst forward again.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000515 "beat-and-glide"@en)
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasExactSynonym obo:ACTAN_0000515 "burst-and-coast mode")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1038/s42003-020-01521-z") oboInOwl:hasExactSynonym obo:ACTAN_0000515 "burst-and-coast regime")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasExactSynonym obo:ACTAN_0000515 "burst-and-coast swimming")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000515 "burst-coast")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000515 "burst-glide")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasExactSynonym obo:ACTAN_0000515 "kick and glide")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasNarrowSynonym obo:ACTAN_0000515 "CBC")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasNarrowSynonym obo:ACTAN_0000515 "caudal burst-and-coast")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000515 "burst-coast regime")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.021360") skos:example obo:ACTAN_0000515 "\"Bluegill sunfish... Kick maneuvers were characterized by sudden rapid lateral excursion of the caudal fin and were followed by a forward glide (‘kick-and-glide’).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/36.6.555") skos:example obo:ACTAN_0000515 "\"Species that swim by passing waves of bending of the body from head to tail often switch from steady axial undulation to a saltatory \"burst-and-coast\" mode of propulsion at high speeds.\"")
SubClassOf(obo:ACTAN_0000515 obo:ACTAN_0000088)
SubClassOf(Annotation(dc:source "doi:10.1093/icb/36.6.555") obo:ACTAN_0000515 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000042))
SubClassOf(Annotation(dc:source "doi:10.1093/icb/36.6.555") obo:ACTAN_0000515 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000150))
SubClassOf(Annotation(dc:source "doi:10.1093/icb/36.6.555") obo:ACTAN_0000515 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000530))
SubClassOf(obo:ACTAN_0000515 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000543))

