# Class: obo:ACTAN_0000971 (side lie)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000971 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000971 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000971 "2026-09-08T10:56:45.112685Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1002/9781118501153.ch12") Annotation(skos:scopeNote "\"When swimming in midwater most flatfishes hold the same position as on the bottom (i.e., with the anatomical dorso-ventral axis parallel to the seabed).\"") oboInOwl:hasDefinition obo:ACTAN_0000971 "Lie in which the anatomical dorso-ventral axis is parallel to the substrate.")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1002/9781118501153.ch12") oboInOwl:hasRelatedSynonym obo:ACTAN_0000971 "blind side")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") Annotation(skos:scopeNote "\"...lie down on one side...\"") rdfs:label obo:ACTAN_0000971 "side lie"@en)
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000971 "\"It would stand until the insects began crawling up its legs, then would lie down on one side, with fluffed plumage and lifted wing...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/9781118501153.ch12") skos:scopeNote obo:ACTAN_0000971 "\"When active a flatfish often keeps its head elevated in an 'alert posture' supported by the anterior rays of the median fins and by the blind side pectoral and pelvic fins.\"")
SubClassOf(obo:ACTAN_0000971 obo:ACTAN_0000242)
