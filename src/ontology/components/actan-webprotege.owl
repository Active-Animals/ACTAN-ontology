# Class: obo:ACTAN_0000508 (O turning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000508 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000508 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000508 "2024-12-28T20:48:41.246196Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000508 "Turning in which the body slowly curves to change its orientation by approximately 180 degrees.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000508 "O-bend")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1534/genetics.120.303539") oboInOwl:hasExactSynonym obo:ACTAN_0000508 "omega bend")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1534/genetics.120.303539") oboInOwl:hasExactSynonym obo:ACTAN_0000508 "omega turn"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000508 "O turning")
AnnotationAssertion(Annotation(dc:source "doi:10.1038/s41467-023-38685-1") skos:scopeNote obo:ACTAN_0000508 "\"Therefore, by markedly up-regulating speed and omega turn rates, starved worms at 25 °C are in a state enabling both local and global search, which we will call glocal search.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:scopeNote obo:ACTAN_0000508 "\"When C. elegans animals are removed from food, they display a stereotyped sequence of two consecutive locomotion states. For the first 15 min, they engage in a local search state (also called “area-restricted search”) consisting of a high frequency of high-angle turns and omega bends.\"")
SubClassOf(obo:ACTAN_0000508 obo:ACTAN_0000174)
SubClassOf(obo:ACTAN_0000508 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002397))

# Class: obo:ACTAN_0000509 (pelvic-fin splaying)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000509 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000509 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000509 "2026-07-26T12:44:29.284634Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"Both muscles if contracted erect the spine, and consequently spread the pelvic fin.\"") oboInOwl:hasDefinition obo:ACTAN_0000509 "Splaying that spreads a pelvic fin.")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"Both muscles if contracted erect the spine, and consequently spread the pelvic fin.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000509 "pelvic fin spreading")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000509 "pelvic-fin splaying"@en)
SubClassOf(obo:ACTAN_0000509 obo:ACTAN_0000083)
