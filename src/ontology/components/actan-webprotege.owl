# Class: obo:UBERON_0001456 (face)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "http://orcid.org/0000-0002-6601-2165") obo:IAO_0000115 obo:UBERON_0001456 "A subdivision of the head that has as parts the layers deep to the surface of the anterior surface, including the mouth, eyes, and nose (when present). In vertebrates, this includes the facial skeleton and structures superficial to the facial skeleton (cheeks, mouth, eyeballs, skin of face, etc).")
AnnotationAssertion(Annotation(oboInOwl:source "FMA:24728") obo:UBPROP_0000001 obo:UBERON_0001456 "Subdivision of head which consists of the viscerocranium and all layers superficial to it. Examples: There is only one face.")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Face") Annotation(oboInOwl:hasSynonymType obo:OMO_0003011) oboInOwl:hasRelatedSynonym obo:UBERON_0001456 "facia/facies")
