AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000407 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000407 "2025-04-18T09:41:25.447187Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") Annotation(skos:scopeNote "\"Such spatial constraints may also occur on J. juncea colonies, where gobies are often seen lined up in single file when two or more individuals share the same whip coral.\"") oboInOwl:hasDefinition obo:ACTAN_0000407 "Dimension that corresponds to a single file.")
