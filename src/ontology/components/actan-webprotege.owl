# Class: obo:ACTAN_0000263 (gap-close regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000263 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000263 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000263 "2024-10-06T15:14:06.353098Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000263 "Traversing-regime that involves reaching out to grasp a support on one side of a gap which is pulled toward the animal, pulling the body across the open space, and retaining both grips until a secure position is established on the other side.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000263 "gap-closing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000263 "gap-close regime"@en)
