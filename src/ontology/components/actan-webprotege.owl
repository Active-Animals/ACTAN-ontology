# Class: obo:ACTAN_0000259 (cantilever posture)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000259 <https://github.com/Active-Animals/Ontology/patterns/posture>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000259 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000259 "2024-10-06T10:11:32.563847Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"Cantilever: The feet anchor the lower body to a stable near-vertical support. The trunk is held rigid and near horizontal as the individual reaches out to snatch insects with the forelimbs (Fig. 10).\"") oboInOwl:hasDefinition obo:ACTAN_0000259 "Posture that anchors the lower body to a stable, near-vertical support, while the trunk is held rigid and near horizontal.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000259 "cantilever"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000259 "cantilever posture")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:example obo:ACTAN_0000259 "\"a. Extended cantilever: Knees and body are extended, often fully so in lorisids and cheirogaleids.
b. Lean out cantilever: Knees are flexed (exemplar: tarsiers).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:scopeNote obo:ACTAN_0000259 "\"This behavior is quite different from bridging and should not be conflated with it.\"")
SubClassOf(obo:ACTAN_0000259 obo:ACTAN_0000177)
SubClassOf(obo:ACTAN_0000259 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000060))
SubClassOf(obo:ACTAN_0000259 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))

# Class: obo:ACTAN_0000260 (inverted-quadrupedal gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000260 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000260 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000260 "2024-10-06T15:11:57.126591Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000260 "Traversing-gait that is pronograde, suspended, and has a symmetric gait, with musculoskeletal elements in net tension.")
AnnotationAssertion(Annotation(dc:date "2017"^^xsd:decimal) Annotation(dc:source "doi:10.1111/jzo.12455") oboInOwl:hasExactSynonym obo:ACTAN_0000260 "below branch quadrupedal")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000260 "inverted quadrupedal")
AnnotationAssertion(Annotation(dc:date "2017"^^xsd:decimal) Annotation(dc:source "doi:10.1111/jzo.12455") oboInOwl:hasRelatedSynonym obo:ACTAN_0000260 "inverted walking")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000260 "inverted-quadrupedal gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/jzo.12455") skos:example obo:ACTAN_0000260 "\"...unclear what, if any, advantage a DSDC gait might have during inverted walking. Yet, DSDC gaits are present in sloths and primates during below branch quadrupedal locomotion, although their use is highly variable.\"")
AnnotationAssertion(Annotation(rdfs:comment "doi:10.1111/jzo.12455") skos:scopeNote obo:ACTAN_0000260 "\"Due to the tendency for sloths to utilize diagonal-couplet gaits and similar contact times in both fore limbs and hindlimbs it is possible that this coordination of equal forces generated by contralateral limbs (e.g. the left forelimb and right hind limb) can act to ‘grip’ the arboreal support in the way observed in other arboreal mammals.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF02381373") skos:scopeNote obo:ACTAN_0000260 "This mode is often accompanied by the grasp of a prehensile tail in atelines and Cebus (exemplar: lorises).")
SubClassOf(obo:ACTAN_0000260 obo:ACTAN_0000093)
SubClassOf(obo:ACTAN_0000260 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000628))
SubClassOf(obo:ACTAN_0000260 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000688))
SubClassOf(obo:ACTAN_0000260 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000056))
SubClassOf(obo:ACTAN_0000260 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000135))
SubClassOf(obo:ACTAN_0000260 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000187))

