# Class: obo:ACTAN_0000090 (pelvic-fin abduction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000090 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000090 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000090 "2026-07-12T09:25:49.428006Z")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasBroadSynonym obo:ACTAN_0000090 "already abducted fin")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000090 "Abduction that results from pelvic abducting.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000090 "pelvic-fin abduction"@en)
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000090 "\"In some fishes, one extreme being the pomocentrids of the genus Dascyllus, the pelvic fin, on the side toward which the fish is turning, is lowered and serves as a pivot, or brake.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000090 "\"In such long bodied forms as Esox it is clear that if the low hung pectorals were simply dropped, while they would stop the fish, they would likewise “trip it up,” i. e., cause the caudal portion to raise up because the point of pressure is anterior and low. In order to avoid this the pelvics which in these forms are placed well aft are... thrown down simultaneously at approximately the same angle, thus producing two points of resistance, one forward and the other aft, which causes no tendency for either end to raise.\"")
SubClassOf(obo:ACTAN_0000090 obo:ACTAN_0000639)
SubClassOf(obo:ACTAN_0000090 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000152))

# Class: obo:ACTAN_0000091 (suspension placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000091 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000091 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000091 "2024-09-16T19:27:37.577554Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/20.1.255") Annotation(skos:scopeNote "\"Suspensions (periods in the locomotor cycle when all feet are off of the ground) may be costly in terms of effort.\"") oboInOwl:hasDefinition obo:ACTAN_0000091 "Placement in which all feet are off the ground.")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000091 "suspension"@en)
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasExactSynonym obo:ACTAN_0000091 "unsupported")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajp.23055") oboInOwl:hasRelatedSynonym obo:ACTAN_0000091 "floating")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasRelatedSynonym obo:ACTAN_0000091 "free-floating")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rspb.1998.0424") oboInOwl:hasRelatedSynonym obo:ACTAN_0000091 "glide")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000091 "suspension placement")
SubClassOf(obo:ACTAN_0000091 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000091 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000710))

# Class: obo:ACTAN_0000092 (gathering suspension)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000092 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000092 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000092 "2024-09-16T19:35:19.3031Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/20.1.255") Annotation(skos:scopeNote "\"Plots that fall in the upper triangular quadrant of the gait graph (Fig. 8) represent gallops having one suspension in each cycle, and this occurs when the feet are gathered under the animal and the back (if it is limber) is ventroflexed.\"") oboInOwl:hasDefinition obo:ACTAN_0000092 "Suspension when a quadruped's feet are under the animal.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000092 "collected")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000092 "gathered suspension"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000092 "gathering suspension")
SubClassOf(obo:ACTAN_0000092 obo:ACTAN_0000091)
SubClassOf(obo:ACTAN_0000092 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000732))

