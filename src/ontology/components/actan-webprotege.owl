SubClassOf(obo:ACTAN_0000748 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000187))

# Class: obo:ACTAN_0000749 (crop graze)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000749 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000749 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000749 "2026-07-28T11:07:40.836436Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/1365-2435.13457") oboInOwl:hasDefinition obo:ACTAN_0000749 "Graze which only removes portions of organisms when feeding.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000749 "cropping")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1111/1365-2435.13457") oboInOwl:hasNarrowSynonym obo:ACTAN_0000749 "algal‐cropping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000749 "crop graze"@en)
AnnotationAssertion(Annotation(dc:contributor "doi:10.1111/1365-2435.13457") skos:example obo:ACTAN_0000749 "\"Cropping species, primarily members of the Acanthuridae and Siganidae, remove the upper portions of the algae when feeding, which maintains algae in cropped states, promoting coral settlement and preventing transitions to fleshy macroalgae.\"")
SubClassOf(obo:ACTAN_0000749 obo:ACTAN_0000355)
SubClassOf(obo:ACTAN_0000749 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0055001))

# Class: obo:ACTAN_0000750 (zipping routine)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000750 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000750 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000750 "2025-07-28T15:41:32.185398Z")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasBroadSynonym obo:ACTAN_0000750 "nibbling preening")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.2307/4083155") Annotation(skos:scopeNote "\"Preening involves manipulating feathers with the bill.\"") oboInOwl:hasDefinition obo:ACTAN_0000750 "Waterproofing routine that involves manipulating feathers with the bill.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000750 "feather combing")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rsif.2013.0988") oboInOwl:hasExactSynonym obo:ACTAN_0000750 "zipping")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasRelatedSynonym obo:ACTAN_0000750 "feather flicking")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000750 "feather washing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000750 "zipping routine")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000750 obo:ACTAN_0000757)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000750 obo:ACTAN_0000815)
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000750 "\"Ardeola ibis... Particularly when longer feathers are being dealt with, nibbling is supplemented by a flicking movement in which the feather is rapidly drawn through the bill.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000750 "\"While the bathing movements distribute water over the body, it must be mainly the preening, head-rolling, and scratching which wash and clean the individual feathers.\"")
SubClassOf(obo:ACTAN_0000750 obo:ACTAN_0000105)
SubClassOf(obo:ACTAN_0000750 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000776))
SubClassOf(obo:ACTAN_0000750 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000022))

# Class: obo:ACTAN_0000751 (context behaviour)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000751 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000751 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000751 "2025-06-30T14:37:43.83941Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.69649/pachyderm.v62i.462") Annotation(skos:scopeNote "\"A Context refers to the particular setting, situation or circumstances in which a Behaviour or Constellation occurs.\"") oboInOwl:hasDefinition obo:ACTAN_0000751 "Behaviour that occurs in a particular setting, situation or circumstance.")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasExactSynonym obo:ACTAN_0000751 "context"@en)
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2007.05.008") oboInOwl:hasExactSynonym obo:ACTAN_0000751 "functional-context")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000751 "situation")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.tree.2013.09.013") oboInOwl:hasRelatedSynonym obo:ACTAN_0000751 "current utility")
AnnotationAssertion(Annotation(dc:date "1963"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1439-0310.1963.tb01161.x") oboInOwl:hasRelatedSynonym obo:ACTAN_0000751 "survival value")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000751 "context behaviour")
AnnotationAssertion(Annotation(dc:source "doi:10.69649/pachyderm.v62i.462") skos:example obo:ACTAN_0000751 "\"The Elephant Ethogram:
Context:
Advertisement & Attraction:
Behaviors employed by adult males and adult females in the advertisement of sexual state and the attraction of, and search for, mates.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2007.05.008") skos:scopeNote obo:ACTAN_0000751 "\"Animals often differ from one another in their willingness to take risks in a number of functional contexts related to fitness (e.g. mating, dispersal, and foraging behaviour).\"")
SubClassOf(obo:ACTAN_0000751 obo:ACTAN_0000002)
SubClassOf(obo:ACTAN_0000751 ObjectSomeValuesFrom(obo:BFO_0000055 obo:BFO_0000034))

# Class: obo:ACTAN_0000752 (translocation localization)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000752 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000752 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000752 "2025-07-02T10:50:57.860394Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/s00227-014-2403-0") oboInOwl:hasDefinition obo:ACTAN_0000752 "Localization that is unidirectional, steady, and under propulsion.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000752 "forward rectilinear movement")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasExactSynonym obo:ACTAN_0000752 "translocation")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000752 "travelling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000752 "translocation localization")
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:example obo:ACTAN_0000752 "\"...P. barberinus acted as the nuclear species, vigorously digging in the substratum, and the associates hovered close by and would often follow P. barberinus while travelling between foraging bouts.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1038/ncomms1350") skos:example obo:ACTAN_0000752 "\"...our elephant seal was on the outward leg of its migration moving rapidly over the Patagonian Shelf towards the shelf edge using u-shaped dives characteristic of directed travelling...\"")
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") skos:example obo:ACTAN_0000752 "\"For slow, rectilinear swimming... boxfishes use various combinations of the pectoral, dorsal and anal fins for propulsion...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00227-014-2403-0") skos:scopeNote obo:ACTAN_0000752 "\"...the caudal fin was best suited to powering unidirectional swimming...\"")
SubClassOf(obo:ACTAN_0000752 obo:ACTAN_0000290)
SubClassOf(obo:ACTAN_0000752 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001902))

# Class: obo:ACTAN_0000753 (constellation pattern)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000753 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000753 "2025-07-08T13:23:15.883644Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.69649/pachyderm.v62i.462") Annotation(skos:scopeNote "\"A Behavioural Constellation, or Constellation, is a suite of Behaviours that usually occur together.\"") oboInOwl:hasDefinition obo:ACTAN_0000753 "Component pattern that is a suite of behaviours that usually occur together.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.69649/pachyderm.v62i.462") oboInOwl:hasExactSynonym obo:ACTAN_0000753 "constellation"@en)
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasRelatedSynonym obo:ACTAN_0000753 "suite")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000753 "constellation pattern"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.69649/pachyderm.v62i.462") skos:example obo:ACTAN_0000753 "\"Musth-Walk typically includes the Behaviours: Ears-Stiff, Head-High, Chin-In, Purposeful-Walk, Musth-Temporal-Gland-Secretion, Urine-Dribbling.\"")
SubClassOf(obo:ACTAN_0000753 obo:ACTAN_0000011)

# Class: obo:ACTAN_0000754 (traversing locomotion)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000754 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000754 "2025-07-08T14:48:53.351512Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1023/A:1005565304671") oboInOwl:hasDefinition obo:ACTAN_0000754 "Locomotion that uses a support.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1005565304671") oboInOwl:hasExactSynonym obo:ACTAN_0000754 "traversing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000754 "traversing locomotion"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac061") skos:example obo:ACTAN_0000754 "\"Gobies are generally found underwater perched on sand, mud, rocks, or peeking from shelter, such as crevices in rocks or holes in sand or mud. In some cases, their association with substrate is extreme, such as that seen in the waterfall climbing gobies and mudskippers traversing air-exposed mud flats.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000754 "NBO:0000359")
AnnotationAssertion(Annotation(dc:source "doi:10.3390/ani13162557") skos:scopeNote obo:ACTAN_0000754 "\"...the running walk, rack, broken pace, and broken trot maintain ground contact at all times, with one to three, or even all four, hooves, despite being intermediate speed gaits. This makes them quite comfortable for the rider and useful in maintaining balance when traversing uneven terrain.\"")
SubClassOf(obo:ACTAN_0000754 obo:ACTAN_0000176)
SubClassOf(obo:ACTAN_0000754 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000184))

# Class: obo:ACTAN_0000755 (cascade regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000755 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000755 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000755 "2025-07-09T16:44:07.459309Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"Head-first descent: (1) Symmetrical head-first descent: similar to quadrupedal walking, except the limbs served a braking function on these steep descents (> 45 degrees) some skidding may occur; (2) head-first scramble descent: as with symmetrical head-first descent, except on multiple supports with odd orientation and sizes, and a less symmetrical gait; and (3) cascade: as with head-first scramble descent, except supports are still smaller, and radically angled. Limbs and tail grasp briefly and in rapid succession to brake descent.\"") oboInOwl:hasDefinition obo:ACTAN_0000755 "Traversing-regime in which appendages grasp briefly and in rapid succession to brake descent.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasExactSynonym obo:ACTAN_0000755 "cascade"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000755 "cascade regime"@en)
SubClassOf(obo:ACTAN_0000755 obo:ACTAN_0000089)
SubClassOf(obo:ACTAN_0000755 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000628))
SubClassOf(obo:ACTAN_0000755 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))
SubClassOf(obo:ACTAN_0000755 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000530))
SubClassOf(obo:ACTAN_0000755 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000893))

# Class: obo:ACTAN_0000756 (hindlimb extending)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000756 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000756 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000756 "2026-07-29T09:16:55.426343Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1002/ajpa.1330870108") Annotation(skos:scopeNote "\"Instead, retraction of the humerus and extension of the hindlimbs provided most of the propulsive power.\"") oboInOwl:hasDefinition obo:ACTAN_0000756 "Extending that involves a hindlimb.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasExactSynonym obo:ACTAN_0000756 "backward leg extending")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") Annotation(skos:scopeNote "\"...extension of the back foot...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000756 "back foot extending")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") Annotation(skos:scopeNote "\"...extension of the hindlimbs...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000756 "hindlimb extension")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") Annotation(skos:scopeNote "\"...legs are extended...\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000756 "leg extending")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000756 "hindlimb extending"@en)
SubClassOf(obo:ACTAN_0000756 obo:ACTAN_0000794)
SubClassOf(obo:ACTAN_0000756 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002103))

# Class: obo:ACTAN_0000757 (oiling routine)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000757 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000757 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000757 "2025-07-28T16:00:03.87235Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasDefinition obo:ACTAN_0000757 "Waterproofing routine that involves the uropygial gland.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000757 "oiling"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000757 "oiling preening")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000757 "oiling routine")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000757 obo:ACTAN_0000106)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000757 obo:ACTAN_0000765)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000757 obo:ACTAN_0000771)
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000757 "\"Ardeola ibis... The head is oiled by rubbing the \"chin\" and \"face\" on the exposed oil gland. Much commoner are the oil-distributing movements in which head and neck are vigorously rubbed and rolled over the back and area around the humerus.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000757 "\"Thus the head-rolling displays of the Andean Goose are probably derived from oiling since they include rubbing actions of the head or bill on the feathers.\"")
SubClassOf(obo:ACTAN_0000757 obo:ACTAN_0000105)
SubClassOf(obo:ACTAN_0000757 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000098))
SubClassOf(obo:ACTAN_0000757 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0007803))

# Class: obo:ACTAN_0000758 (dust anointment)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000758 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000758 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000758 "2025-08-10T15:13:56.583862Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") Annotation(skos:scopeNote "\"There is some evidence that a bird may be sensitive to special properties in the dusting soil and that anting and dusting may be more closely allied than was suggested by Chisholm.\"") oboInOwl:hasDefinition obo:ACTAN_0000758 "Anointment that occurs in soil.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000758 "dust-bathing"@en)
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000758 "dusting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000758 "dust anointment")
SubClassOf(obo:ACTAN_0000758 obo:ACTAN_0000788)
SubClassOf(obo:ACTAN_0000758 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00001998))

# Class: obo:ACTAN_0000759 (anting anointment)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000759 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000759 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000759 "2025-07-28T16:33:48.491172Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") Annotation(skos:scopeNote "\"Anting may be defined as the application of foreign substances to the plumage and possibly to the skin. These substances may be applied with the bill, or the bird may “bathe” or posture among thronging ants which invest its plumage.\"") oboInOwl:hasDefinition obo:ACTAN_0000759 "Anointment that applies foreign substances to the plumage.

These substances may be applied with the bill, or the bird may “bathe” or posture among thronging ants which invest its plumage.")
AnnotationAssertion(Annotation(dc:date "1948"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5252&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000759 "anting"@en)
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasNarrowSynonym obo:ACTAN_0000759 "ant bathing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000759 "anting anointment"@en)
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000759 "\"At least 24 kinds of ants and more than 40 substitute materials have been used by anting birds. These materials include fruits, foliages, raw onion, burning matches or tobacco, gum of grass-tree (Xunthorrhoea preissii) , millipedes (Diplopoda) , various beetles (“weevils”; tenebrionid beetles of the genus Blups) , grasshoppers (Anacridium uegyptium) , earwigs (Forficula) , bugs (Rhynchotu sp., Rhuphigaster nebulosu), wasps, hair tonic, prepared mustard, vinegar, hot chocolate, and moth balls.\"")
SubClassOf(obo:ACTAN_0000759 obo:ACTAN_0000788)
SubClassOf(obo:ACTAN_0000759 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01000155))

# Class: obo:ACTAN_0000760 (bathe anointment)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000760 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000760 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000760 "2025-07-28T17:25:51.903805Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"Bathing in water occurs in all Anatidae.\"") oboInOwl:hasDefinition obo:ACTAN_0000760 "Anointment that involves water.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000760 "water-bathe"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000760 "bathe anointment")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000760 obo:ACTAN_0000815)
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000760 "\"On the single occasion on which bathing has been seen, an A. ibis standing in shallow water suddenly and briefly plunged its head under water, then gave 4 or 5 typical wing-thrashing movements before resuming immobility. This was repeated 4 times in 9 minutes, during which the bird was joined by another. A noticeable feature of the incident was the total absence of repeated head-dips, ruffling, preening and general excited movement which is characteristic of bathing in other families. Dust-bathing does not occur, which probably  reflects the semi-aquatic origins of the family.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:scopeNote obo:ACTAN_0000760 "\"Records of species which bathe in... dew, snow... are scanty.\"")
SubClassOf(obo:ACTAN_0000760 obo:ACTAN_0000788)
SubClassOf(obo:ACTAN_0000760 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00000063))

# Class: obo:ACTAN_0000761 (scratch routine)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000761 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000761 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000761 "2025-07-29T06:34:22.350041Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000761 "Counter-irritant routine in which part of a limb is scraped against a defined area of skin, rapidly and in a fixed arc.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000761 "scratching"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000761 "scratch routine"@en)
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000761 "\"THE CATTLE EGRET ARDEOLA IBIS
The neck is partly extended and the foot is brought direct (\"vornherum\") to the head. Scratching is prolonged and vigorous (20 bouts averaged 16 sec.) and always performed with the pectinated claw of the second toe.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000761 "NBO:0000057")
SubClassOf(obo:ACTAN_0000761 obo:ACTAN_0000103)
SubClassOf(obo:ACTAN_0000761 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000786))
SubClassOf(obo:ACTAN_0000761 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002101))

# Class: obo:ACTAN_0000762 (swimming shake)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000762 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000762 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000762 "2025-07-29T10:43:30.325526Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"In the Mallard, the shake begins with a vigorous tail-wag; the feet paddle hard, raising the breast out of the water; the shake moves forward over the body until the head and neck are stretched out and up and rotated as in the body-shake. After subsiding in the water, the bird wags its tail.\"") oboInOwl:hasDefinition obo:ACTAN_0000762 "Body shake in which the feet paddle hard, raising the breast out of the water.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000762 "swimming-shake"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000762 "introductory shaking")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000762 "preliminary shaking")
AnnotationAssertion(rdfs:label obo:ACTAN_0000762 "swimming shake"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000762 "\"I have seen this shake given repeatedly by individual ducks which had lost the waterproofing quality of their breast feathers, through being in poor condition.\"")
SubClassOf(obo:ACTAN_0000762 obo:ACTAN_0000764)
SubClassOf(obo:ACTAN_0000762 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01001309))

# Class: obo:ACTAN_0000763 (forelimb extending)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000763 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000763 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000763 "2026-07-29T09:20:56.334249Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000763 "Extending that involves a forelimb.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") Annotation(skos:scopeNote "\"...extended-arm climb...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000763 "arm extending")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") Annotation(skos:scopeNote "\"...legs extended forward...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000763 "forward leg extending")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") Annotation(skos:scopeNote "\"...wings are raised and extended...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000763 "wing extending")
AnnotationAssertion(Annotation(rdfs:comment "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000763 "forelimb extending"@en)
SubClassOf(obo:ACTAN_0000763 obo:ACTAN_0000794)
SubClassOf(obo:ACTAN_0000763 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002102))

# Class: obo:ACTAN_0000764 (body shake)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000764 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000764 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000764 "2025-07-29T09:52:26.944859Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000764 "Shake that progresses along the body.

In water birds it is usually from tail to head.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000764 "body-shake"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000764 "body-shaking"@en)
AnnotationAssertion(rdfs:label obo:ACTAN_0000764 "body shake"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000764 "\"In the Mallard, the shake begins with a vigorous lateral tail-wag and at the same time many of the body feathers become erected. The shake moves forward to the wings, which are vibrated rapidly but without being removed from their \"pockets\" in the flank feathers. the wing-shaking dies down, the head is lifted from its normal position and is rotated around its long axis several times while pointing upward to make an angle of about 45 degrees with the ground. During the head movement, the feathers of the back, neck, and head are erected. A secondary wing-shaking may occur while the head is being moved. The head then returns to its normal position, and the feathers all over the body are depressed to the usual resting state. A final tail-wag usually follows. The whole movement takes a few seconds to perform, the longest part often being the introductory tail-wag.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000764 "\"Shaking may occur during hostile encounters. This is particularly striking in aggressive situations in the White-fronted Goose, but shaking involving the wings only is also very common in this species.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000764 "\"The main features of the shake - feather-erection, progression of the movement along the body and rotation of the head - are universal... The primary function of the body-shake seems to be the removal of waterdrops from the bird's feathers, which is achieved by the centrifugal effect of the movements.\"")
SubClassOf(obo:ACTAN_0000764 obo:ACTAN_0000795)
SubClassOf(obo:ACTAN_0000764 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002100))

# Class: obo:ACTAN_0000765 (wing shake)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000765 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000765 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000765 "2025-07-29T11:06:52.482784Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"The wings are shaken more vigorously, and it is mainly the secondaries which are involved.\"") oboInOwl:hasDefinition obo:ACTAN_0000765 "Shake in which the wings are shaken vigorously.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000765 "shaking of wings"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000765 "wing-shake")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") Annotation(dc:source "1965"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000765 "wing-shaking")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasRelatedSynonym obo:ACTAN_0000765 "wing-beat")
AnnotationAssertion(rdfs:label obo:ACTAN_0000765 "wing shake")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000765 obo:ACTAN_0000757)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000765 obo:ACTAN_0000766)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000765 obo:ACTAN_0000769)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000765 "\"Wing-shaking is given by White-fronted Geese, Bar-headed Geese, and Barnacle Geese while threatening with the head and neck stretched out toward and opponent.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000765 "\"I have also seen vigorous wing-shaking during oiling in a Semipalmated Plover (Charadrius hiaticula) and a Song Thrush (Turdus ericetorum).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000765 "\"The Magpie Goose performs Wing-shaking as part of a display. The male and female of a pair walk around each other calling, erecting the feathers on the back, and repeatedly shaking the wings vigorously.\"")
SubClassOf(obo:ACTAN_0000765 obo:ACTAN_0000795)
SubClassOf(obo:ACTAN_0000765 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000023))
SubClassOf(obo:ACTAN_0000765 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002328))

# Class: obo:ACTAN_0000766 (wing flick)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000766 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000766 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000766 "2025-07-29T11:52:47.917816Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.jstor.org/stable/4084834") Annotation(skos:scopeNote "\"In wing flicking, a heron walking slowly in an upright posture suddenly extends and retracts wings in a flicking action usually repeated several times.\"") oboInOwl:hasDefinition obo:ACTAN_0000766 "Flick that involves a wing.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000766 "wing-flick"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000766 "wing-flicking"@en)
AnnotationAssertion(rdfs:label obo:ACTAN_0000766 "wing flick"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000766 obo:ACTAN_0000765)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12891") skos:example obo:ACTAN_0000766 "\"...the peacock butterfly continually flicked its wings to hide and reveal its eyespots.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4084834") skos:example obo:ACTAN_0000766 "\"In wing flicking, a heron walking slowly in an upright posture suddenly extends and retracts wings in a flicking action usually repeated several times.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000766 "\"In view of the similarity in form between the Wing-flick and a wing-shake I suggest that this comfort movement may represent the true origin;\"")
SubClassOf(obo:ACTAN_0000766 obo:ACTAN_0000678)
SubClassOf(obo:ACTAN_0000766 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000023))

# Class: obo:ACTAN_0000767 (head shake)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000767 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000767 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000767 "2025-07-29T14:15:39.867273Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"The bill is shaken from side to side a few times. The movements vary a great deal in speed and amplitude, but they are always lateral...\"") oboInOwl:hasDefinition obo:ACTAN_0000767 "Shake in which the head is moved from side to side.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000767 "head shaking"@en)
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasRelatedSynonym obo:ACTAN_0000767 "head-flick")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") rdfs:label obo:ACTAN_0000767 "head shake")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000767 obo:ACTAN_0000725)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000767 "NBO:0000023")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s002650100391") skos:example obo:ACTAN_0000767 "\"...langur monkeys (Semnopithecus entellus)...
inviting a male by presenting the anogenital region, tail lowered, and simultaneous head shaking;\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000767 "\"Ardeola ibis... Head Flick. 

This display consists of rapid, small-amplitude head movements in a horizontal plane, given with the beak closed, and may be performed singly or as rapidly as twice per second.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000767 "\"The Maned Goose gives very rapid Head-shakes when calling with crest erect and head held high; possibly this display had its origin in pre-flight behaviour, but it provides an example of the incorporation of head-shaking in a highly ritualized pattern.\"")
SubClassOf(obo:ACTAN_0000767 obo:ACTAN_0000795)
SubClassOf(obo:ACTAN_0000767 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000033))
SubClassOf(obo:ACTAN_0000767 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002497))

# Class: obo:ACTAN_0000768 (tail-wag shake)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000768 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000768 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000768 "2025-07-29T14:16:35.154278Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"The tail, which may be fanned out to some extent, is shaken from side to side several times....

Tail-wagging normally follows every activity which involves, or could involve, wetting of the tail.\"") oboInOwl:hasDefinition obo:ACTAN_0000768 "Shake in which the tail is moved from side to side.

[In birds] Tail-wagging normally follows every activity which involves, or could involve, wetting of the tail.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000768 "tail wagging"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000768 "tail-wagging"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000768 "tail-wag shake")
AnnotationAssertion(Annotation(dc:source "ISBN:9781482294347") skos:example obo:ACTAN_0000768 "\"Courtship in the genus Rhyacotriton... begins with an approach phase in which the male nudges the female. The male then faces away from the female and performs a peculiar tail-wagging display in which the tail is curled upwards over the male’s back and the tail tip is wagged back and forth.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000768 "\"I have seen repeated, rapid bursts of tail-wagging performed by a female Blue-winged Teal, accompanied by day-old ducklings, as she threatened with open bill toward a male swimming nearby.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000768 "\"In addition, it occurs at the beginning of the body-shake and after it, after wing-flap on land, after stretching and many preening movements on land. It often precedes and/or follows defaecation. After copulation, the male often tail-wags repeatedly; in Mallards, the penis may protrude for some time, and tail-wags are given until it is withdrawn.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000768 "\"The action consists of vigorous body undulations, the propulsive force of which is checked by beating the pectorals forwards.\"")
SubClassOf(obo:ACTAN_0000768 obo:ACTAN_0000795)
SubClassOf(obo:ACTAN_0000768 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002415))
SubClassOf(obo:ACTAN_0000768 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002497))

# Class: obo:ACTAN_0000769 (wing-flap shake)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000769 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000769 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000769 "2025-07-29T14:21:24.800476Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"On water, a Mallard paddles vigorously until the body is poised almost vertically, the wings are fully opened and flapped as in flight a few times. Anatidae do not leave the water to fly up a few inches during wing-flapping as many Gulls and Waders do. After flapping, the bird subsides on the water...\"") oboInOwl:hasDefinition obo:ACTAN_0000769 "Shake in which the wings are fully opened and flapped as in flight a few times, and then the animal subsides.

The body may be poised almost vertically.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000769 "wing-flap"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000769 "wing-flapping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000769 "wing-flap shake")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000769 "\"The clearest case of ritualization of the wing-flap occur in the male pre-copulatory behaviour of the Common Eider and King Eider. The male rises on the water, opens the wings and remains briefly poised with the wings open and slightly back; the bill points upward... and two rapid flaps are given before the bird returns to a normal swimming position.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000769 "\"The frequency is particularly high in the least aquatic species (Spur-winged Goose, Hawaiian Goose, Magpie Goose) which are liable to become very wet during bathing.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000769 "\"The normal wing-flap occurs almost invariably after bathing, its frequency depending on the intensity of the bathing.\"")
SubClassOf(obo:ACTAN_0000769 obo:ACTAN_0000795)
SubClassOf(obo:ACTAN_0000769 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000023))
SubClassOf(obo:ACTAN_0000769 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002327))

# Class: obo:ACTAN_0000770 (foot shake)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000770 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000770 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000770 "2025-07-29T14:21:51.884192Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"A Mallard which is standing or sitting on the ground shakes one foot rapidly forward and back a number of times and then swings it forward into the flank feathers.\"") oboInOwl:hasDefinition obo:ACTAN_0000770 "Shake in which a foot is moved rapidly forward and back.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000770 "foot-shake"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000770 "foot-shaking"@en)
AnnotationAssertion(rdfs:label obo:ACTAN_0000770 "foot shake"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000770 "\"Oxyura and Aythya species, in which the legs are spaced very far apart, roll over on one side while swimming and the foot is shaken high in the air so that it appears to emerge from the bird's back.\"")
SubClassOf(obo:ACTAN_0000770 obo:ACTAN_0000795)
SubClassOf(obo:ACTAN_0000770 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002103))

# Class: obo:ACTAN_0000771 (shuffling oscillation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000771 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000771 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000771 "2025-07-29T14:40:10.113993Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000771 "Oscillation in which feathers are continuously splaying and furling, with gradually decreasing intensity.

Wing-shuffling and tail-fanning have the function of aiding in drying the feathers.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000771 "shuffle")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000771 "shuffling"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000771 "tail-fan")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000771 "wing-shuffle")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000771 "shuffling oscillation")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000771 obo:ACTAN_0000757)
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000771 "\"A most unusual account of birds using smoke concerns the small flock of Red-browed Waxbills (Estrilda temporalis) at Kairi, on Atherton Tableland, North Queensland, which Givens (1945) observed on several days in June... Each bird would stand upright, with tail as “support” and wings drooping a little forward and downward, and begin sweeping the head forward and down under the wings, meanwhile vigorously shuffling its wings and body feathers and “often toppling backward from the violence of its efforts.”\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000771 "\"In Denrocygna, the wing movements are particularly rapid and are restricted to the secondaries and scapulars, giving the effect of a rocking motion of the back.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000771 "\"Wing-shuffling occurs during the oiling and nibbling preening which follows bathing.\"")
SubClassOf(obo:ACTAN_0000771 obo:ACTAN_0000421)
SubClassOf(obo:ACTAN_0000771 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000022))
SubClassOf(obo:ACTAN_0000771 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000689))

# Class: obo:ACTAN_0000772 (flap thrust)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000772 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000772 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000772 "2025-07-30T12:01:13.306148Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1017/jfm.2017.173") Annotation(skos:scopeNote "\"Assuming that a bird flies at a constant cruising speed, the thrust force generated by the flapping wings has to be equal to the drag force experienced by the non-thrust-producing aerodynamic surfaces such as the head, body and the tail of the bird. The total drag force, and thus the thrust force, are not insignificant, which suggests that bird wings need to operate at a point well above the drag–thrust boundary.\"") oboInOwl:hasDefinition obo:ACTAN_0000772 "Thrust in which an appendage needs to operate at a point well above the drag–thrust boundary.

The drag force is experienced by the non-thrust-producing surfaces such as the head, body and the tail.")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1038/ncomms1350") oboInOwl:hasExactSynonym obo:ACTAN_0000772 "active flapping"@en)
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasNarrowSynonym obo:ACTAN_0000772 "wing beating")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasNarrowSynonym obo:ACTAN_0000772 "wingbeat")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000772 "stroking")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000772 "flap thrust")
AnnotationAssertion(Annotation(dc:source "doi:10.1017/jfm.2017.173") skos:scopeNote obo:ACTAN_0000772 "\"...a pitching wing needs to flap approximately 75% faster than the heaving wing when it needs to cross the drag–thrust boundary.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") skos:scopeNote obo:ACTAN_0000772 "\"This absence of a logarithmic speed/frequency relationship in flying birds may be attributed to the fact that wingbeats not only move the animal forward, but keep it suspended against the force of gravity.\"")
SubClassOf(obo:ACTAN_0000772 obo:ACTAN_0000671)
SubClassOf(obo:ACTAN_0000772 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000026))

# Class: obo:ACTAN_0000773 (development context)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000773 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000773 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000773 "2025-08-03T17:25:45.624065Z")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasBroadSynonym obo:ACTAN_0000773 "growth")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.2307/4083155") Annotation(skos:scopeNote "\"The study of the ontogeny of displays is an important but seldom used method of obtaining evidence about derivation and the developmental integration of form and function.\"") oboInOwl:hasDefinition obo:ACTAN_0000773 "Context that ontogenetically integrates form and function.")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasExactSynonym obo:ACTAN_0000773 "development"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000773 "ontogeny")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:comment obo:ACTAN_0000773 "Recognising that ontogeny is generally considered a physiological process, which are not generally within our scope, ontogeny has associated specific behaviours which are.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000773 "development context")
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:example obo:ACTAN_0000773 "\"Juvenile P. multifasciatus were mostly found in foraging associations with small and medium size P. barberinus, however adults rarely formed foraging associations with P. barberinus, though they did travel together in mixed schools at times. By contrast, adult P. indicus was found predominantly in associations with large P. barberinus, yet juvenile P. indicus rarely formed foraging associations with small and medium P. barberinus. Strand (1988) found similar ontogenetic effects.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:scopeNote obo:ACTAN_0000773 "\"Dimorphic males are reported in many species known or likely to engage in male-male combat, but surprisingly few of them have been investigated to ascertain the developmental basis and functions of the dimorphism...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1439-0310.1963.tb01161.x") skos:scopeNote obo:ACTAN_0000773 "\"I should like to characterise the phenomenon as \"change of behaviour machinery during development\". This is not, of course, the same as a change of behaviour during development;\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00265-010-0980-6") skos:scopeNote obo:ACTAN_0000773 "\"The energy available to organisms is limited, making it crucial for them to adequately partition their total energy budget into growth, maintenance and reproduction.\"")
SubClassOf(obo:ACTAN_0000773 obo:ACTAN_0000751)
SubClassOf(obo:ACTAN_0000773 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0001031))
SubClassOf(obo:ACTAN_0000773 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0040046))

# Class: obo:ACTAN_0000774 (level-flying regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000774 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000774 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000774 "2025-07-30T12:02:14.987845Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1038/ncomms1350") oboInOwl:hasDefinition obo:ACTAN_0000774 "Flying-regime which involves a continuous cycle of active flapping, without climbing or descending.")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/4161407") oboInOwl:hasExactSynonym obo:ACTAN_0000774 "level flight"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000774 "level-flying regime")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4161407") skos:example obo:ACTAN_0000774 "\"The first observation, on 1 August 1977, involved 2 dark-phase jaegers and an  immature female Pectoral Sandpiper (Calidris melanotos). When first seen, the jaegers were chasing the sandpiper in level flight.\"")
SubClassOf(obo:ACTAN_0000774 obo:ACTAN_0000076)
SubClassOf(obo:ACTAN_0000774 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000152))
SubClassOf(obo:ACTAN_0000774 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000772))
SubClassOf(obo:ACTAN_0000774 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000065))
SubClassOf(obo:ACTAN_0000774 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000543))

# Class: obo:ACTAN_0000775 (wing-exercise development)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000775 <https://github.com/Active-Animals/Ontology/patterns/context_by_life_cycle>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000775 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000775 "2025-08-03T19:38:30.513277Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000775 "Development that involves prolonged flapping of the wings, while the animal remains more or less in the same place.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000775 "exercise wing-flapping")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000775 "wing-exercise"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000775 "wing-exercise development"@en)
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000775 "\"Ardeola ibis...
From 20 days onwards nestlings frequently perform exercise wing-flapping (first seen at 14 days). The bird walks to the edge of its tree and vigorously flaps its wings for a few seconds while holding onto the perch.\"")
SubClassOf(obo:ACTAN_0000775 obo:ACTAN_0000773)
SubClassOf(obo:ACTAN_0000775 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000769))
SubClassOf(obo:ACTAN_0000775 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0000112))

# Class: obo:ACTAN_0000776 (nibble bite)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000776 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000776 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000776 "2025-08-05T14:21:24.045758Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/beheco/aru194") oboInOwl:hasDefinition obo:ACTAN_0000776 "Bite which remains on the object's surface.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000776 "nibbling"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000776 "nipping-off")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000776 "nibble bite"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000776 obo:ACTAN_0000912)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000776 "\"Cichlosoma meeki...

The female, passing the male, swims towards an inverted flower pot and there makes nipping-off movements.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000776 "\"Signal movements...
Nipping off a substrate...
...Aequidens and Cichlosoma species make a more formalised movement... The lower jaw is brought down quickly and suddenly and raps on the substrate; immediately after, the fish jumps up a little.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:scopeNote obo:ACTAN_0000776 "\"Nibble (nibbling): Nonaggressive biting on an object (usually, in food seeking or as part of object exploration).\"")
SubClassOf(obo:ACTAN_0000776 obo:ACTAN_0000113)
SubClassOf(obo:ACTAN_0000776 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001575))

# Class: obo:ACTAN_0000777 (withdrawal transition)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000777 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000777 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000777 "2025-08-04T14:11:37.875362Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.27.3.264") Annotation(dc:source "doi:10.1303/aez.25.383") oboInOwl:hasDefinition obo:ACTAN_0000777 "Transition that involves pulling out of a space.")
AnnotationAssertion(Annotation(dc:date "1922"^^xsd:decimal) Annotation(dc:source "doi:10.2307/2939673") oboInOwl:hasExactSynonym obo:ACTAN_0000777 "withdrawal"@en)
AnnotationAssertion(Annotation(dc:date "1990"^^xsd:decimal) Annotation(dc:source "doi:10.1303/aez.25.383") oboInOwl:hasRelatedSynonym obo:ACTAN_0000777 "removing")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasRelatedSynonym obo:ACTAN_0000777 "retracting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000777 "withdrawal transition")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000777 obo:ACTAN_0000029)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000777 obo:ACTAN_0000736)
AnnotationAssertion(Annotation(dc:source "https://www.researchgate.net/profile/Lina-Barrios-2/post/any_idea_about_these_anemones/attachment/59d61dea79197b807797c41b/AS%3A273509083512833%401442221055505/download/Fautin+et+al+2015-+Sea+anemones+of+Singapore.pdf") skos:example obo:ACTAN_0000777 "\"Pelocoetes exul... live in vertical burrows into which they can withdraw...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") skos:scopeNote obo:ACTAN_0000777 "\"The retractors have two distinct functions. Their slow tonic contraction plays its part in maintaining the shape of the column in concert with the parietals. But on sudden stimulation their rapid contraction leads to withdrawal of the disk and closure of the anemone. In this fast response, the powerful retractors act antagonistically not only to the circular muscle of the column but also to the parietals. The sudden withdrawal of the disk may cause a general bulging outwards of the whole body wall. The concurrent contraction of the marginal sphincter results in the animal passing from a cylindrical to a hemispherical shape.\"")
SubClassOf(obo:ACTAN_0000777 obo:ACTAN_0000144)
SubClassOf(obo:ACTAN_0000777 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000553))

# Class: obo:ACTAN_0000778 (nibble routine)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000778 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000778 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000778 "2025-08-05T14:43:34.066038Z")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasBroadSynonym obo:ACTAN_0000778 "nibbling movements")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000778 "Counter-irritant routine which responds to a localised irritation by using the mouthparts.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000778 "foot-pecking")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000778 "nibble routine")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000778 "\"...Mr SCOTT tells me that he has seen foot-pecking in geese as a response to nettle-stings.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000778 "\"Occasional nibbling movements...

Often the movements are hurried, and I suspect that the bird is attempting to remove a source of irritation (possibly caused by ectoparasites).\"")
SubClassOf(obo:ACTAN_0000778 obo:ACTAN_0000103)
SubClassOf(obo:ACTAN_0000778 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000776))

# Class: obo:ACTAN_0000779 (nose-blow routine)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000779 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000779 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000779 "2025-08-05T16:47:33.439289Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000779 "Wash routine in which the nasal passages are moistened, and cleared by blowing.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") Annotation(skos:scopeNote "\"...air is blown out through the nostrils...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000779 "nostril blowing"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000779 "bill-cleaning")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000779 "nose-blow routine")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000779 "\"(Dipping the head under water and blowing out through the nostrils occurs in hostile situations in the Whooper Swan and Trumpeter Swan, but I have not seen the movements repeated rhythmically; possibly these are cases of hostile \"hissing\" performed under-water).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000779 "\"The bill is almost completely submerged in the water and then the head is jerked back slightly as air is blown out through the nostrils making a staccato noise... I have seen bill-cleaning in all tribes except the Oxyurini... Perhaps the nasal passages are more effectively cleaned when the bill is dipped in water, pressure being built up as air is forced through the nares.\"")
SubClassOf(obo:ACTAN_0000779 obo:ACTAN_0000815)
SubClassOf(obo:ACTAN_0000779 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000780))
SubClassOf(obo:ACTAN_0000779 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000004))

# Class: obo:ACTAN_0000780 (blow expulsion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000780 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000780 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000780 "2025-08-05T16:49:29.328646Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000780 "Expulsion in which air is forced out of a head orifice, with controlled timing and intensity.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000780 "blowing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000780 "blow expulsion"@en)
AnnotationAssertion(Annotation(dc:source "https://bioengineering.hyperbook.mcgill.ca/functional-mechanics-of-the-elephant-and-butterfly-proboscis/") skos:example obo:ACTAN_0000780 "\"...elephants can blow air to push objects that are just beyond reach and modulate the air jet on a wall to draw objects closer to themselves.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/beheco/12.5.534") Annotation(rdfs:comment "2001"^^xsd:decimal) skos:example obo:ACTAN_0000780 "\"Alaskan humpback whales (Megaptera novaengliae), when hunting Pacific herring, sometimes work as a team to perform two basic subtasks: prey herding and bubble blowing.\"")
SubClassOf(obo:ACTAN_0000780 obo:ACTAN_0000715)
SubClassOf(obo:ACTAN_0000780 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0001004))

# Class: obo:ACTAN_0000781 (sneeze expulsion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000781 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000781 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000781 "2025-08-05T17:21:47.323651Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000781 "Expulsion in which air explodes out of a head orifice with limited control.

There may be a simultaneous jerk of the head.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000781 "sneeze")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000781 "sneezing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000781 "sneeze expulsion")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000781 "NBO:0000442")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000781 "\"Chimps sneeze in the same way as humans.\"")
SubClassOf(obo:ACTAN_0000781 obo:ACTAN_0000715)
SubClassOf(obo:ACTAN_0000781 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0001004))

# Class: obo:ACTAN_0000782 (probing tooling)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000782 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000782 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000782 "2025-08-05T17:39:11.458857Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/tops.12554") Annotation(rdfs:comment "This is a simple source subdivision.") oboInOwl:hasDefinition obo:ACTAN_0000782 "Tooling that probes with an object.

This may be to access, allogroom, autogroom, dislodge, or pack.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1111/tops.12554") oboInOwl:hasExactSynonym obo:ACTAN_0000782 "probe with an object"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000782 "probing tooling")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000782 "\"Sneeze with stick (SNS) (Type A): Push stick into nostril to stimulate sneeze,which discharges a large amount of nasal mucus. Only one adult male showed this type of tool-use.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/tops.12554") skos:scopeNote obo:ACTAN_0000782 "\"We found that probing was the most frequently referenced mode for the primates, followed by reaching and pounding. For birds, probing was by far the most commonly reported tooling mode.\"")
SubClassOf(obo:ACTAN_0000782 obo:ACTAN_0000286)
SubClassOf(obo:ACTAN_0000782 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000695))
SubClassOf(obo:ACTAN_0000782 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01000814))

