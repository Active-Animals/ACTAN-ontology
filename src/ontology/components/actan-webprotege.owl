# Class: obo:ACTAN_0000563 (tilt rotation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000563 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000563 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000563 "2025-02-04T16:52:38.366477Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000563 "Rotation in which inclination changes with reference to gravity.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000563 "tilted"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000563 "tilt rotation")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.conb.2018.06.004") skos:example obo:ACTAN_0000563 "\"At 3 days old, larval zebrafish show no measurable eye movements in response to body tilts in pitch or roll.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.156.1.215") skos:example obo:ACTAN_0000563 "\"Speed also increases with bipedalism in lizards. As in P. americana, lizards tilt their head end upwards and increase stride length by using long hind legs.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000563 "NBO:0000070")
SubClassOf(obo:ACTAN_0000563 obo:ACTAN_0000686)
SubClassOf(obo:ACTAN_0000563 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002326))

# Class: obo:ACTAN_0000564 (dorsal-light-reflex roll)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000564 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000564 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000564 "2025-02-04T16:53:10.119852Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Briefly, illuminated horizontally, the fish inclines its dorsoventral axis and turns dorsal surface toward the light source, with its body tilt corrected antagonistically by the vestibular righting reflex (i.e., the body inclination increases with the illumination intensity but decreases with the gravity).\"") oboInOwl:hasDefinition obo:ACTAN_0000564 "Roll that reflexively inclines its dorsal surface toward a light source.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000564 "DLR")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000564 "dorsal light reflex"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000564 "dorsal-light-reflex roll")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000564 "\"...commonly observed in teleost fishes.\"")
SubClassOf(obo:ACTAN_0000564 obo:ACTAN_0000690)
SubClassOf(obo:ACTAN_0000564 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000008))
SubClassOf(obo:ACTAN_0000564 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002104))
SubClassOf(obo:ACTAN_0000564 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002495))

# Class: obo:ACTAN_0000565 (upright roll)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000565 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000565 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000565 "2025-02-04T17:26:37.668556Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(dc:source "doi:10.1111/eff.12212") Annotation(rdfs:comment "Multi-sourced definition.") Annotation(skos:scopeNote "\"(i.e., the body inclination... decreases with the gravity).\" (doi:10.1089/zeb.2012.0861)") Annotation(skos:scopeNote "\"Then, the fish turns in a normal position (dorsal fin facing the surface) and after a very short period (up to 1 s) the fish turns upside down again, repeating this pattern up to 3 or 4 times.\" (doi:10.1111/eff.12212)") oboInOwl:hasDefinition obo:ACTAN_0000565 "Roll that is normally inclined relative to gravity.

Dorsal uppermost is a common norm.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000565 "righted"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000565 "upright position")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000565 "upright roll")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000565 "\"In the less elaborate technique of worm catching the body remains in the normal upright position...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000565 "\"When 3-5 days after the egg has hatched the yolk has been absorbed, the larva no longer attaches itself to a substrate and from then keeps the ventral side downwards.\"")
SubClassOf(obo:ACTAN_0000565 obo:ACTAN_0000690)
SubClassOf(obo:ACTAN_0000565 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001653))

# Class: obo:ACTAN_0000566 (vestibular-righting-reflex roll)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000566 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000566 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000566 "2025-02-04T17:27:03.028018Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000566 "Roll that aligns with gravity via a vestibular reflex.")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(rdfs:comment "2013"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000566 "vestibular righting reflex"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000566 "vestibular-righting-reflex roll"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000566 "NBO:0000578")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000566 "\"Briefly, illuminated horizontally, the fish inclines its dorsoventral axis and turns dorsal surface toward the light source, with its body tilt corrected antagonistically by the vestibular righting reflex (i.e., the body inclination increases with the illumination intensity but decreases with the gravity).\"")
SubClassOf(obo:ACTAN_0000566 obo:ACTAN_0000690)
SubClassOf(obo:ACTAN_0000566 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000008))
SubClassOf(obo:ACTAN_0000566 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002105))

# Class: obo:ACTAN_0000567 (droop placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000567 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000567 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000567 "2025-02-04T21:26:15.461859Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasDefinition obo:ACTAN_0000567 "Placement in which an extremity remains hanging downwards.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000567 "drooped"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000567 "drooping")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasRelatedSynonym obo:ACTAN_0000567 "swooning")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000567 "droop placement")
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000567 "\"...Red-browed Waxbills (Estrilda temporalis)... would stand on a smoldering log, in the curling wisps of smoke coming up through cracks in the bark, and there perform anting movements “quite distinct from those commonly seen when birds bathe in dust or water”. Each bird would stand upright, with tail as “support” and wings drooping a little forward and downward...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:scopeNote obo:ACTAN_0000567 "\"Droopy (drooping) tail:... can also be part of a normal resting/sleep behavior... In adult zebrafish... which a long-lasting behavior;\"")
SubClassOf(obo:ACTAN_0000567 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000567 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000598))

# Class: obo:ACTAN_0000568 (escape evasion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000568 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000568 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000568 "2025-02-05T12:23:19.738635Z")
