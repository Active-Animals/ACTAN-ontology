AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") Annotation(skos:scopeNote "\"...retraction (extension) of the humerus.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000933 "humerus retraction")
