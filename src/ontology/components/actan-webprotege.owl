# Class: obo:ACTAN_0000746 (vergence eye-movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000746 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000746 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000746 "2025-06-27T11:09:29.126819Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.ncbi.nlm.nih.gov/books/NBK10991/") Annotation(skos:scopeNote "\"Disjunctive movements of the eyes (convergence or divergence) that align the fovea of each eye with targets located at different distances from the observer.\"") oboInOwl:hasDefinition obo:ACTAN_0000746 "Movement in which each eye disjunctively aligns the fovea with targets located at different distances from the observer.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "https://www.ncbi.nlm.nih.gov/books/NBK10991/") oboInOwl:hasExactSynonym obo:ACTAN_0000746 "disconjugate"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000746 "vergence")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000746 "fixing on")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") Annotation(skos:scopeNote "\"The vergence movements involve motion of the two eyes...\"") rdfs:label obo:ACTAN_0000746 "vergence eye-movement")
AnnotationAssertion(Annotation(rdfs:comment "https://core.ac.uk/download/pdf/85255156.pdf") skos:scopeNote obo:ACTAN_0000746 "\"The vergence movements involve motion of the two eyes in opposite directions in order to maintain binocular fixation...\"")
SubClassOf(obo:ACTAN_0000746 obo:ACTAN_0000976)
SubClassOf(obo:ACTAN_0000746 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001653))

# Class: obo:ACTAN_0000747 (kinematics activity)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000747 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000747 "2025-06-29T16:36:12.085589Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icac125") Annotation(skos:scopeNote "\"Kinematics: A technique used to study locomotion; the study of the displacement and orientation of body segments, joint angles, and spatio-temporal gait parameters.\"") oboInOwl:hasDefinition obo:ACTAN_0000747 "Activity that involves the displacement and orientation of body segments, joint angles, and spatio-temporal gait parameters.")
AnnotationAssertion(Annotation(dc:date "1989"^^xsd:decimal) Annotation(dc:source "doi:10.1016/0021-9290(89)90224-8") oboInOwl:hasExactSynonym obo:ACTAN_0000747 "kinematics"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000747 "kinematics activity"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:example obo:ACTAN_0000747 "\"...control muscles of flies generate little or no mechanical power yet act as controllable springs to direct the forces of much larger power muscles, thus providing the means by which the nervous system can rapidly alter wing kinematics by varying the timing of activation.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000747 "NBO:0000001")
SubClassOf(obo:ACTAN_0000747 obo:ACTAN_0000078)

# Class: obo:ACTAN_0000748 (pull-up gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000748 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000748 "Ditch Townsend")
