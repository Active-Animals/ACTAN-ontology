# Class: obo:UBERON_0001032 (sensory system)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Sensory_system") obo:IAO_0000115 obo:UBERON_0001032 "Anatomical system that overlaps the nervous system and is responsible for receiving and processing sensory information.")
AnnotationAssertion(Annotation(oboInOwl:date_retrieved "2012-09-17") Annotation(oboInOwl:external_class "VHOG:0001674") Annotation(oboInOwl:ontology "VHOG") Annotation(oboInOwl:source "DOI:10.1073/pnas.97.9.4449 Shimeld SM and Holland PW. Vertebrate innovations. PNAS (2000)") Annotation(oboInOwl:source "http://bgee.unil.ch/") obo:UBPROP_0000003 obo:UBERON_0001032 "An early step in the evolution of neural crest, therefore, may have been the origin of a specific dorsal neural cell population contributing to sensory processing; this would predate the divergence of the amphioxus and vertebrate lineages.[well established][VHOG]")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:75259") Annotation(oboInOwl:hasDbXref "FMA:TA") Annotation(oboInOwl:hasSynonymType obo:OMO_0003011) oboInOwl:hasExactSynonym obo:UBERON_0001032 "organa sensuum")
