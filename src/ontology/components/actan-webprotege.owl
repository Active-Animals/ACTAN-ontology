# Class: obo:ACTAN_0000863 (countershading camouflaging)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000863 <https://github.com/Active-Animals/Ontology/patterns/context_by_environmental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000863 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000863 "2025-10-03T16:37:24.002305Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1098/rspb.2015.2890") Annotation(skos:scopeNote "\"In countershaded prey, the body surface closest to the ambient light source (often the dorsal surface unless the species rests upside-down) is darker in colour than the body surface furthest from the light source.\"") oboInOwl:hasDefinition obo:ACTAN_0000863 "Camouflaging in which the body surface closest to the ambient light source is darker in colour than the body surface furthest from the light source.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000863 "countershading"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000863 "countershading camouflaging"@en)
SubClassOf(obo:ACTAN_0000863 obo:ACTAN_0000462)
SubClassOf(obo:ACTAN_0000863 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ENVO_21001215))

# Class: obo:ACTAN_0000864 (iridescence colouration)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000864 <https://github.com/Active-Animals/Ontology/patterns/colouration>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000864 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000864 "2025-10-03T16:38:52.573726Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000864 "Colouration in which a gloss is effected.

This can be due to the arrangement of guanine crystals in skin cells.")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasExactSynonym obo:ACTAN_0000864 "iridescent")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000864 "irising"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000864 "silvering")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000864 "iridescence colouration")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000864 "\"Aequidens latifrons...
A great many blue irising spots (\"jewels\") distributed over the whole body, and particularly on the throat, gill cover and belly, give the fish a bluish hue (guanocytes of system V).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000864 "\"Guanocytes may occur in different layers in varying but often high concentrations. They are responsible for certain effects in the total colour appearance of the fish, for instance silverish white, yellow, green, or blue colours, They also build up the irising patches and the bright rings round dark spots.\"")
SubClassOf(obo:ACTAN_0000864 obo:ACTAN_0000513)
SubClassOf(obo:ACTAN_0000864 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002277))

# Class: obo:ACTAN_0000865 (fading colouration)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000865 <https://github.com/Active-Animals/Ontology/patterns/colouration>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000865 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000865 "2025-10-03T16:46:37.464319Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000865 "Colouration in which a tint loses its intensity.")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(rdfs:comment "1950"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000865 "fading"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000865 "greying")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000865 "paling")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasNarrowSynonym obo:ACTAN_0000865 "blanching")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000865 "darkening")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasRelatedSynonym obo:ACTAN_0000865 "lightening")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000865 "fading colouration"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000865 "\"Cichlasoma meeki...
The branchiostegal membrane, the throat and the ventral part of the abdomen are light vermilion... in the non-reproductive markings the colour often fades to a pinkish hue.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF01609520") skos:example obo:ACTAN_0000865 "\"In Haemulon cbrysargyreum diurnal schooling pigmentation correlates with other diurnal schooling grunt species, but nocturnally its pigmentation fades, leaving a blanched fish which feeds over open sand substrates.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000865 "\"In N. leptocephalus, the anterior anal-fin rays become bright white in breeding males compared to pale yellow or cream colored in nonbreeding males.\"")
AnnotationAssertion(Annotation(dc:source "https://www.researchgate.net/profile/Lina-Barrios-2/post/any_idea_about_these_anemones/attachment/59d61dea79197b807797c41b/AS%3A273509083512833%401442221055505/download/Fautin+et+al+2015-+Sea+anemones+of+Singapore.pdf") skos:scopeNote obo:ACTAN_0000865 "\"...colour of an animal’s tentacles lightens with expansion...\"")
SubClassOf(obo:ACTAN_0000865 obo:ACTAN_0000513)
SubClassOf(obo:ACTAN_0000865 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000327))

# Class: obo:ACTAN_0000866 (chromatics colouration)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000866 <https://github.com/Active-Animals/Ontology/patterns/colouration>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000866 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000866 "2025-10-03T17:12:42.625395Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000866 "Colouration that changes hue and saturation.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000866 "chromatic")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000866 "colouring"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000866 "chromatics colouration")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000866 "\"Hemichromis bimaculatus...
The principal colour of the fish is red... females were always bright orange-red, the males more violet-red when bearing the reproductive markings... When not reproductively motivated the fishes are brownish red with a greenish hue. However, a change from deep red into bright orange-red can take place in a very short time.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000866 "\"In the Stickleback, in the Centrarchids, and in the Cichlids of the Tilapia-type, there is a marked sexual dichromatism during the breeding season.\"")
SubClassOf(obo:ACTAN_0000866 obo:ACTAN_0000513)
SubClassOf(obo:ACTAN_0000866 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001301))

# Class: obo:ACTAN_0000867 (contrast colouration)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000867 <https://github.com/Active-Animals/Ontology/patterns/colouration>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000867 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000867 "2025-10-03T17:13:06.847749Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000867 "Colouration that gains brilliance.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000867 "contrast")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000867 "brightening")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasNarrowSynonym obo:ACTAN_0000867 "darkening")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000867 "contrast colouration")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000867 "\"Aequidens latifrons...
When the fish is, for instance, displaying, spawning, or caring for young, the cross bars are intensely dark while the background is nearly white. In the nonreproductive markings the contrast between the bands and the intermediate zones is far less, the bands being lighter and the background darker coloured.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000867 "\"Zebrafish...
Lateral display: Two fish line up parallel to each other head to tail, raise their dorsal fins (fin raise), extend their caudal fins, darken in color (body color change), and swim in circles (circling), often ascending.\"")
SubClassOf(obo:ACTAN_0000867 obo:ACTAN_0000513)
SubClassOf(obo:ACTAN_0000867 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001718))

# Class: obo:ACTAN_0000868 (engulfing movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000868 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000868 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000868 "2025-10-07T10:42:49.995465Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasDefinition obo:ACTAN_0000868 "Movement that surrounds and separates an object from its ambient environment.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000868 "engulf"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000868 "taking up")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000868 "engulfing movement")
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:example obo:ACTAN_0000868 "\"A more common and realistic estimate is that a fullgrown blue whale engulfs 60 m3 or 60 metric tons of water, approximately 50% of its body volume.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000868 "\"Suddenly it darts forward with folded fins in a single snap of the trunk, and engulfs the Daphnia.\"")
SubClassOf(obo:ACTAN_0000868 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000868 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001772))

# Class: obo:ACTAN_0000869 (mouth incubation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000869 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000869 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000869 "2025-10-07T11:26:06.839838Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"In the first experiment the eggs and young larvae are treated as own brood, even after they had been taken into the mouth and thus could have been tested chemically.\"") oboInOwl:hasDefinition obo:ACTAN_0000869 "Incubation in which eggs and young are taken into the mouth.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...carrying young in its mouth.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000869 "mouth carrying")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...keeps the eggs in the mouth...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000869 "mouth keeping")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...eggs cannot be reared outside the mouth...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000869 "mouth rearing")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...mouth to the eggs and takes them up.\"") Annotation(skos:scopeNote "\"...takes into the mouth.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000869 "mouth taking")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...oral breeders...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000869 "oral breeding")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...oral incubators.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000869 "oral incubation"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...snaps the eggs up.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000869 "egg snapping")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000869 "oral gestation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000869 "mouth incubation")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000869 "\"Tilapia natalensis...
The eggs of the fishes of the Tilapia-type are snapped up immediately after they have been spawned... As long as she is carrying eggs the female makes only weak respiratory movements in which the mouth is only slightly opened. These movements having lasted for about one minute, the female makes more intensive chewing movements for about half a minute. In each of these movements the mouth is opened wider than usually and shut completely afterwards; the bottom of the mouth is moved up and down and when the mouth is open the eggs can be seen rolling about in it.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000869 "NBO:0020102")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000869 "\"As long as the females are carrying eggs or young continuously, they do not take food, although they often fix and approach it, particularly shortly after spawning.\"")
SubClassOf(obo:ACTAN_0000869 obo:ACTAN_0000474)
SubClassOf(obo:ACTAN_0000869 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000165))

# Class: obo:ACTAN_0000870 (transport relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000870 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000870 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000870 "2025-10-07T11:36:14.314237Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasDefinition obo:ACTAN_0000870 "Relativity in which an animal carries something else.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000870 "carrying"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000870 "transferring")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000870 "transporting")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000870 "bringing")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000870 "displacing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000870 "transport relativity")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000870 "\"...in the Formica (Polyerges) rufescens... When the old nest is found inconvenient, and they have to migrate, it is the slaves which determine the migration, and actually carry their masters in their jaws...
Formica sanguinea, on the other hand, possesses much fewer slaves, and in the early part of the summer extremely few. The masters determine when and where a new nest shall be formed, and when they migrate, the masters carry the slaves..\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000870 "\"Internal mandibular surfaces of nest-building males in at least two species (N. leptoce.phalus and N micropogon) are covered with a layer of keratin which may reduce abrasion during stone carrying.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3819/ccbr.2016.110005") skos:example obo:ACTAN_0000870 "\"Southern masked weaverbird (Ploceus velatus)...
Observed building behaviours (e.g., carrying, inserting, and dropping material) used by the same males across multiple nests in one season.\"")
SubClassOf(obo:ACTAN_0000870 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000870 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000727))

# Class: obo:ACTAN_0000871 (mutual territorialism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000871 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000871 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000871 "2025-10-08T07:57:12.971638Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000871 "Territorialism in which neighbouring adversaries repeatedly stop, advance and retreat, in and out of each other's territory, until the centre of oscillation stops shifting, affirming a line of division.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000871 "boundary fight")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...boundary is fixed...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000871 "boundary fixing"@en)
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1444-2906.2003.00797.x") oboInOwl:hasNarrowSynonym obo:ACTAN_0000871 "mutual attack")
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1444-2906.2003.00797.x") oboInOwl:hasNarrowSynonym obo:ACTAN_0000871 "mutual display")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000871 "mutual territorialism"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1444-2906.2003.00797.x") skos:example obo:ACTAN_0000871 "\"Red sea bream Pagrus major and crimson sea bream, Evynnis japonica...

In this case, both fish attack each other toward the mouth, head and belly regions, and then they return to a certain position in their own territories. At the end of these attacks, territorial fish perform a mutual display.\"")
SubClassOf(obo:ACTAN_0000871 obo:ACTAN_0000291)
SubClassOf(obo:ACTAN_0000871 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000329))
SubClassOf(Annotation(dc:source "doi:10.1163/156853981X00220") obo:ACTAN_0000871 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000592))

# Class: obo:ACTAN_0000872 (claiming territorialism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000872 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000872 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000872 "2025-10-08T10:27:27.498162Z")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasBroadSynonym obo:ACTAN_0000872 "establishing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000872 "Territorialism that begins to drive others from a certain area.

At first this may be larger than necessary.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000872 "claiming")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000872 "reserving")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000872 "claiming territorialism")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000872 "\"Tilapia natalensis...
The pugnacious male first remains with the school, but soon he comes down, claims a territory, and begins to dig a pit.\"")
SubClassOf(obo:ACTAN_0000872 obo:ACTAN_0000291)
SubClassOf(obo:ACTAN_0000872 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000386))

# Class: obo:ACTAN_0000873 (defence territorialism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000873 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000873 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000873 "2025-10-08T10:31:02.252035Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1590/S1679-62252011005000018") Annotation(skos:scopeNote "\"Male and female alternated patrolling around territory, repelling intruder fish by using the following agonistic acts:\"") oboInOwl:hasDefinition obo:ACTAN_0000873 "Territorialism that agonistically repels intruders.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000873 "securing"@en)
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1011074716758") oboInOwl:hasExactSynonym obo:ACTAN_0000873 "territorial defence")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasExactSynonym obo:ACTAN_0000873 "territorial defense")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...maintaining the territories...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000873 "territory maintaining")
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1444-2906.2003.00797.x") oboInOwl:hasNarrowSynonym obo:ACTAN_0000873 "one-sided attack")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") Annotation(skos:scopeNote "\"...patrolling around territory...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000873 "patrolling territory")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000873 "defence territorialism"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000873 obo:ACTAN_0000304)
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000873 "\"T. cupido... often a male would be forced to stray to the outskirts of his comparatively large territory... Frequently, a male would spend as long as 20 minutes driving off other males while attempting to isolate a female.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/1367674") skos:example obo:ACTAN_0000873 "\"The other reaction of a male anna to a hummingbird that invaded his breeding territory was to chase it without further ado; indeed, chases were the most frequent means of territorial defense.\"")
SubClassOf(obo:ACTAN_0000873 obo:ACTAN_0000291)
SubClassOf(obo:ACTAN_0000873 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000378))

# Class: obo:ACTAN_0000874 (succeeding territorialism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000874 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000874 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000874 "2025-10-08T10:34:49.687272Z")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasBroadSynonym obo:ACTAN_0000874 "establishing")
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000874 "Territorialism that replaces another in an existing territory.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000874 "succeeding"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000874 "restoring")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000874 "taking")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000874 "succeeding territorialism"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000874 obo:ACTAN_0000930)
AnnotationAssertion(Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") skos:example obo:ACTAN_0000874 "\"...competition for large corals resulting in the displacement of smaller fish by larger individuals, as the reason for the positive relationship between the size of Gobiodon histrio and the size of their host-coral, Acropora nasuta.\"")
SubClassOf(obo:ACTAN_0000874 obo:ACTAN_0000291)
SubClassOf(obo:ACTAN_0000874 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000553))

# Class: obo:ACTAN_0000875 (wedging claiming)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000875 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000875 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000875 "2025-10-08T10:35:40.669907Z")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasBroadSynonym obo:ACTAN_0000875 "establishing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000875 "Claiming that obtains and successfully defends a small foothold in an important area.

An aspirant may start by claiming and then moving from a less important site, and use less challenging competitive signals, until its small territory is recognised by neighbours, and it can transition straight to boundary-fixing.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000875 "annexing")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000875 "wedging"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000875 "wedging claiming"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000875 "\"HOWARD (1920) describes how a reed buntingmanaged to establish a territory on parts of grounds of two other males by driving a wedge, between other territories, with a bush as headquarters.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000875 "\"...the defence of the already established territories stiffens in inverse proportion to their dimension.\"")
SubClassOf(obo:ACTAN_0000875 obo:ACTAN_0000872)
SubClassOf(obo:ACTAN_0000875 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000389))
SubClassOf(obo:ACTAN_0000875 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0015003))

# Class: obo:ACTAN_0000876 (dividing claiming)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000876 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000876 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000876 "2025-10-08T11:50:46.365281Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...when the breeding season is over, the female woodpecker claims a part of the common territory for her own. In the mockingbirds (Mimus polyglottus) the MITCHENERS (1935) also observed that at the end of the breeding season and after the moult the male and female of a pair divide the formerly common territory. They may still act together sometimes against common enemies.\"") oboInOwl:hasDefinition obo:ACTAN_0000876 "Claiming which involves part of a formerly common territory.

They may still act together sometimes against common enemies.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000876 "dividing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000876 "dividing claiming"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000876 "\"Cichlasoma bimaculatum...
...a female will only succeed in claiming a part of the former common territory if the combativeness of the male is inhibited...
...the male, in this phase, not only considers his mate as a competing neighbour, but also as his partner...\"")
SubClassOf(obo:ACTAN_0000876 obo:ACTAN_0000872)
SubClassOf(obo:ACTAN_0000876 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000543))

# Class: obo:ACTAN_0000877 (subversion competition)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000877 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000877 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000877 "2025-10-08T16:11:40.461367Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000877 "Competition in which cooperation is deceiptfully used to self-advantage.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(rdfs:comment "The use of \"inverted commas\" in the source appears intended to delegitimate the natural meaning of this term.") oboInOwl:hasExactSynonym obo:ACTAN_0000877 "\"assisting\"")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(rdfs:comment "The use of \"inverted commas\" in the source appears intended to delegitimate the natural meaning of this term.") oboInOwl:hasExactSynonym obo:ACTAN_0000877 "\"helping\""@en)
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2019.12.009") oboInOwl:hasExactSynonym obo:ACTAN_0000877 "subversion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000877 "subversion competition")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000877 "\"Cichlid... fishes without territory also often try to take part in the actions of resident males when these are too much occupied to chase them. So they may \"help\" a territory owner in fighting an intruder or in fertilising the eggs of a female.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000877 "\"Hemichromis females...
A starts laying... B and C approach and eat the eggs. A chases B, and more particularly C. B also chases C and eats most of the eggs... Later on C begins to lay eggs... B approaches and then \"assists\" C, just as she formerly \"helped\" A.\"")
SubClassOf(obo:ACTAN_0000877 obo:ACTAN_0000389)
SubClassOf(obo:ACTAN_0000877 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000464))

# Class: obo:ACTAN_0000878 (assistance cooperation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000878 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000878 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000878 "2025-10-08T17:03:44.892569Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000878 "Cooperation that helps another achieve the other's purpose.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000878 "assistance"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000878 "help")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000878 "joining")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000878 "assistance cooperation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000878 "\"In Cichlasoma meeki two frontally-fighting fishes were often assisted by territoryless congeners.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4161407") skos:example obo:ACTAN_0000878 "\"Parasitic Jaegers regularly team-hunt in pairs or small groups. Team-hunting occurs as:... two birds hunting cooperatively by assisting each other.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000878 "\"TINBERGEN (1939) describes how the female snow bunting assists the male in driving away intruders from the territory, but without knowing the boundaries of this territory exactly.\"")
SubClassOf(obo:ACTAN_0000878 obo:ACTAN_0000463)
SubClassOf(obo:ACTAN_0000878 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000334))

# Class: obo:ACTAN_0000879 (joining territorialism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000879 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000879 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000879 "2025-10-13T15:48:05.475425Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"So if a female joins a boundary fight, it is usually to assist the male and, as she remains in the neighbourhood of the male, she will not cross the boundary.\"") oboInOwl:hasDefinition obo:ACTAN_0000879 "Territorialism in which a female remains in the neighbourhood of a male, and will not cross the boundary.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000879 "joining"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000879 "joining territorialism")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000879 "\"In the Hemichromis type the male begins to secure a territory where he is joined by a female, and both take care of the eggs or the young, the latter remain in the territory at least untill they are able to swim.\"")
SubClassOf(obo:ACTAN_0000879 obo:ACTAN_0000291)
SubClassOf(obo:ACTAN_0000879 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000829))

# Class: obo:ACTAN_0000880 (tolerating territorialism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000880 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000880 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000880 "2025-10-13T16:17:38.863369Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000880 "Territorialism which offers very weak defense against a particular neighbour crossing their boundary.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000880 "accepting")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000880 "tolerating")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000880 "tolerating territorialism")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000880 obo:ACTAN_0000881)
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000880 "\"Thalassoma cupido...
The male dominates the area during his presence, actively chasing away some conspecifics. The tolerance with which other conspecifics are treated upon intrusion suggests that territories are defended against competitive males only, in defense of potential spawning partners. Fish that are not attacked apparently pose no threat to the reproductive success of the male.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000880 "\"...the danger that one member of a pair will tolerate or even mate with a stranger only exists before the eggs have been laid, or in the case of the male, when at the end of the rearing period he is anxious to begin a new breeding cycle.\"")
SubClassOf(obo:ACTAN_0000880 obo:ACTAN_0000291)
SubClassOf(obo:ACTAN_0000880 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000385))
SubClassOf(obo:ACTAN_0000880 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0015003))

# Class: obo:ACTAN_0000881 (peace-making ranking)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000881 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000881 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000881 "2025-10-13T16:35:53.434439Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"LORENZ reports that the night heron possesses certain signal movements (raising of the crest) that when showed to a neighbour, secure it a free passage through the other one's territory.\"") oboInOwl:hasDefinition obo:ACTAN_0000881 "Ranking which secures a free passage through another's territory.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000881 "peace making"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000881 "ambivalent behaviour")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000881 "peace-making ranking")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000881 obo:ACTAN_0000880)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000881 "\"A Tilapia male, when still in his own territory, will sometimes become pale, cross the boundary, and swim through other territories practically unattacked.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000881 "NBO:0020279")
SubClassOf(obo:ACTAN_0000881 obo:ACTAN_0000552)
SubClassOf(Annotation(dc:source "doi:10.1163/156853981X00220") obo:ACTAN_0000881 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000317))

# Class: obo:ACTAN_0000882 (tyranny dominance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000882 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000882 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000882 "2025-10-13T17:02:30.102445Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"There is, however, one tyrant that dominates over all other members, and ignores the territories without being resisted.\"") oboInOwl:hasDefinition obo:ACTAN_0000882 "Dominance which extends over all others

It ignores their territories without being resisted. There may be subordinate tyrants.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...the tyrant...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000882 "tyranny"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000882 "tyranny dominance")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000882 "\"Thalassoma cupido...
Most groups contain a single individual that behaves quite differently towards the other aggregate members, often treating them aggressively. These individuals are positioned at the periphery of the aggregation and have a greater range of movements, swimming around and above the others. They exhibit individualistic behavior, typified by more forceful movements and a distinctive manner of swimming whereby the pectoral fins are fluttered rapidly, conspicuously displaying their blackened tips.\"")
SubClassOf(obo:ACTAN_0000882 obo:ACTAN_0000387)
SubClassOf(obo:ACTAN_0000882 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000457))

# Class: obo:ACTAN_0000883 (con-vergence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000883 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000883 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000883 "2025-10-14T08:17:32.050503Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") oboInOwl:hasDefinition obo:ACTAN_0000883 "Vergence in which adduction draws the intersection of the optical axes closer in.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") rdfs:label obo:ACTAN_0000883 "con-vergence"@en)
AnnotationAssertion(Annotation(rdfs:comment "doi:10.1016/j.cub.2019.11.022") skos:example obo:ACTAN_0000883 "\"...zebrafish larvae... J-turns, approach swims, and capture strikes occupy the prey capture region of the behavioral space and predominantly occurred when the eyes were converged.\"")
SubClassOf(obo:ACTAN_0000883 obo:ACTAN_0000746)
SubClassOf(obo:ACTAN_0000883 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000375))

# Class: obo:ACTAN_0000884 (di-vergence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000884 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000884 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000884 "2025-10-14T08:17:41.68751Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") oboInOwl:hasDefinition obo:ACTAN_0000884 "Vergence in which abduction draws the intersection of the optical axes further out.

In some animals it can pass the point where optical axes are parallel.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") rdfs:label obo:ACTAN_0000884 "di-vergence"@en)
SubClassOf(obo:ACTAN_0000884 obo:ACTAN_0000746)
SubClassOf(obo:ACTAN_0000884 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000374))

# Class: obo:ACTAN_0000885 (flock aggregation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000885 <https://github.com/Active-Animals/Ontology/patterns/group_behaviour>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000885 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000885 "2025-10-14T09:03:32.959655Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000885 "Aggregation that is 3-dimensional, polarized and aerial.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(rdfs:comment "NB: As well as birds in flight (3-dimensions: our term meaning), Darwin uses the term for a group of sheep on the ground (2-dimensions: not our term meaning).") oboInOwl:hasExactSynonym obo:ACTAN_0000885 "flocking"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000885 "flock aggregation")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000885 "\"The starlings, at least, remained in a dense flock, trying to evade the attacker by manoeuvering as one compact mass.\"")
SubClassOf(obo:ACTAN_0000885 obo:ACTAN_0000411)
SubClassOf(obo:ACTAN_0000885 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000182))
SubClassOf(obo:ACTAN_0000885 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000406))
SubClassOf(obo:ACTAN_0000885 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000662))

# Class: obo:ACTAN_0000886 (shielded avoidance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000886 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000886 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000886 "2025-10-14T11:07:28.822456Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000886 "Avoidance which uses a more peripherally placed group member as a protection against threat.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "ISBN:9789798105975") oboInOwl:hasExactSynonym obo:ACTAN_0000886 "other for cover")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000886 "shielded"@en)
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") oboInOwl:hasNarrowSynonym obo:ACTAN_0000886 "agonistic buffering")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000886 "shielded avoidance")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000886 obo:ACTAN_0000413)
SubClassOf(obo:ACTAN_0000886 obo:ACTAN_0000376)
SubClassOf(obo:ACTAN_0000886 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001195))

# Class: obo:ACTAN_0000887 (deterrence assistance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000887 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000887 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000887 "2025-10-14T11:31:39.864838Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") oboInOwl:hasDefinition obo:ACTAN_0000887 "Assistance in which an animal works with a second in defence against a third.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") oboInOwl:hasExactSynonym obo:ACTAN_0000887 "cooperative defense")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") Annotation(skos:scopeNote "\"...numbers per se have a deterrent effect...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000887 "number deterrence")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000887 "social defence"@en)
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasNarrowSynonym obo:ACTAN_0000887 "mobbing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000887 "deterrence assistance")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000887 "\"...in birds social defence reactions have been described for instance by LORENZ (1935) in jaxckdaws.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1146/annurev-ecolsys-102209-144712") skos:example obo:ACTAN_0000887 "\"Some species, particularly shorebirds, take advantage of the vigilance and predator-mobbing behavior of colonially nesting species and place their nests within a colony of another species, thereby increasing their own nesting success.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9789798105975") skos:scopeNote obo:ACTAN_0000887 "\"...injury to predators by prey, eg mobbing in birds...\"")
SubClassOf(obo:ACTAN_0000887 obo:ACTAN_0000878)
SubClassOf(obo:ACTAN_0000887 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000371))

# Class: obo:ACTAN_0000888 (dodge evasion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000888 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000888 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000888 "2025-10-14T16:18:26.954Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000888 "Evasion that avoids attacks by skilfully and rapidly changing position.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000888 "dodging"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000888 "dodge evasion"@en)
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4161407") skos:example obo:ACTAN_0000888 "\"After approximately 250 m the lower jaeger caught up to the sandpiper and grabbed it in its bill as the sandpiper tried to dodge right.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000888 "\"Hemichromis bimaculatus...
The male remains quivering at some distance from the female, then charges on the female, which tries to evade the blow by placing herself rapidly parallel to the male.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/20.1.255") skos:scopeNote obo:ACTAN_0000888 "\"If there is an extended suspension of sufficient duration (less common for transverse than for rotary gallopers), then the feet can alternatively be repositioned during that suspension. The forefeet are then the first to assume the new support pattern—possibly an advantage in dodging quickly.\"")
SubClassOf(obo:ACTAN_0000888 obo:ACTAN_0000379)
SubClassOf(obo:ACTAN_0000888 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000690))

# Class: obo:ACTAN_0000889 (nudge hit)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000889 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000889 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000889 "2025-10-15T16:07:44.236694Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1643/h2023077") oboInOwl:hasDefinition obo:ACTAN_0000889 "Hit that involves brief, non-destabilising contact, using a blunt body prominence.

For many animals this will be the front of the face (e.g. the snout).")
AnnotationAssertion(Annotation(dc:date "2024"^^xsd:decimal) Annotation(dc:source "doi:10.1643/h2023077") oboInOwl:hasExactSynonym obo:ACTAN_0000889 "nudge")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "ISBN:9781482294347") oboInOwl:hasExactSynonym obo:ACTAN_0000889 "nudging"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000889 "touching")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000889 "nudge hit")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000889 "\"Cichlosoma meeki...
It looks as if she is going to receive a very heavy blow, but just before the male has reached the female, he brakes and only touches her gently.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9781482294347") skos:scopeNote obo:ACTAN_0000889 "\"Courtship in the ancestral ambystomatid consisted of an approach phase (in which the male rapidly nudged the female) and a tailtapping display (in which the male faced away from the female and tapped her with his tail). The tail-tapping display constitutes an invitation to a cloaca-nudging walk.\"")
SubClassOf(obo:ACTAN_0000889 obo:ACTAN_0000860)
SubClassOf(obo:ACTAN_0000889 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001950))

# Class: obo:ACTAN_0000890 (obstruction relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000890 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000890 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000890 "2025-10-19T15:11:53.442501Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"The male advances towards the female and butts her weakly, the female places herself across the path of the male and erects the dorsalis, tilting a little.\"") oboInOwl:hasDefinition obo:ACTAN_0000890 "Relativity in which an animal places itself across the path of another.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/beheco/12.5.534") oboInOwl:hasExactSynonym obo:ACTAN_0000890 "blocking"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000890 "crossways in front of")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasExactSynonym obo:ACTAN_0000890 "obstructing")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(rdfs:seeAlso obo:ACTAN_0000920) oboInOwl:hasNarrowSynonym obo:ACTAN_0000890 "presenting"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000890 "obstruction relativity")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000890 obo:ACTAN_0000993)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/beheco/12.5.534") skos:example obo:ACTAN_0000890 "\"...in the ant Colobopsis truncatus: (a) when under attack, an individual can use her specially shaped (phragmotic) head to block a small nest entrance herself. This is an individual task. (b) In larger nest entrances, several workers combine together to form a living plug, thus blocking the entrance.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000890 "\"During six runs, the stoneroller physically obstructed both the female’s retroflexure and the male chub’s clasping motion.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9781482294347") skos:example obo:ACTAN_0000890 "\"Pivoting about one forelimb after spermatophore deposition in Triturus cristatus... The female stops over the spermatophore as the male blocks her path, one body length in front of the spermatophore.\"")
SubClassOf(obo:ACTAN_0000890 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000890 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001933))

# Class: obo:ACTAN_0000891 (skirmish affiliation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000891 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000891 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000891 "2025-10-19T16:24:56.974594Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000891 "Affiliation that carries out exaggerated contact movements without inflicting damage on the other.

This can look like fighting.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000891 "skirmishing"@en)
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") oboInOwl:hasNarrowSynonym obo:ACTAN_0000891 "affiliative biting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000891 "skirmish affiliation")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000891 "\"Cochlasoma severum...
The fishes are constantly skirmishing with each other, carrying out exaggerated butting, biting and tail beating movements without inflicting the slightest damage on each other. When one of them behaves in such an \"aggressive\" way the other begins to quiver vigorously.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") skos:scopeNote obo:ACTAN_0000891 "\"Pair-bonded fish exhibit several affiliative behaviors. In cichlids, pair-bonded individuals display parallel swimming, tail beating, circling, greeting, and affiliative bites.\"")
SubClassOf(obo:ACTAN_0000891 obo:ACTAN_0000832)
SubClassOf(obo:ACTAN_0000891 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000860))
SubClassOf(obo:ACTAN_0000891 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000317))

# Class: obo:ACTAN_0000892 (female-female formation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000892 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000892 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000892 "2025-10-20T07:39:00.027785Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000892 "Formation in which females perform mating activities with each other.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(rdfs:comment "Synonym label is constructed from a large section of prose.") oboInOwl:hasExactSynonym obo:ACTAN_0000892 "homosexual female"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000892 "female-female formation")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000892 "\"Hemichromis bimaculatus...
A female pair performs the same courting activities as a normal one, i.e. jerking, quivering, nipping and skimming. When one of them spawns the other either skims alternately, just like the fertilizing male, or she also lays eggs.\"")
SubClassOf(obo:ACTAN_0000892 obo:ACTAN_0000831)
SubClassOf(obo:ACTAN_0000892 ObjectSomeValuesFrom(obo:RO_0000057 obo:PCO_0001000))
SubClassOf(obo:ACTAN_0000892 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000383))

# Class: obo:ACTAN_0000893 (stimulation switch)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000893 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000893 "2025-10-20T08:29:19.875034Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasDefinition obo:ACTAN_0000893 "Switch in which an external cue causes a behaviour change.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000893 "evoking")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000893 "stimulating"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000893 "stimulation")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000893 "synchronisation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000893 "stimulation switch")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") skos:example obo:ACTAN_0000893 "\"The majority of sea-anemones present to the eye an almost constant shape which only changes as the result of activities of a very simple kind. This is true, for instance, of Calliactis parasitica... The unstimulated animal rarely departs from the form of a short cylinder surmounted by a disk bearing the tentacles round its edge and the mouth at its centre.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000893 "\"The stimulating effect of the courting activities does not always seem to shorten the time till spawning. This we observed a few times in pairs of Astronotus ocellatus and C. bimaculatum, of which the male was more energetic than the female. As soon as the female carried out some feeble quivering or nipping-off movements on the substrate, the male rushed on and began to perform the same movements so vigorously that the female was pushed aside and had to leave the stone. Undoubtedly this tended to retard spawning in the female.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:scopeNote obo:ACTAN_0000893 "\"For self-costing aid to be profitable in terms of inclusive fitness it is not enough simply to determine relative fighting ability. The winner must likewise have a relative reproductive capacity superior enough to make helping behavior profitable to the subordinant. In such cases selection would have to define the difference in aggressiveness sufficient to signal a profitable switch to aid-giving behavior, and the cues used (e.g., relative aggressiveness) would have to correlate with reproductive capacity.\"")
SubClassOf(obo:ACTAN_0000893 obo:ACTAN_0000541)

# Class: obo:ACTAN_0000894 (acquaintance ranking)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000894 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000894 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000894 "2025-10-20T09:46:40.074034Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000894 "Ranking which is somewhat inhibited by recognition of a prior experience of acceptance.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000894 "acquaintance"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasNarrowSynonym obo:ACTAN_0000894 "friendly behavior")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000894 "ambivalent behaviour")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000894 "acquaintance ranking")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/1568539X-00003176") skos:example obo:ACTAN_0000894 "\"Japanese macaques (Macaca fuscata fuscata)...
It is known that friendly reunions of opponents soon after an aggressive interaction (reconciliations) are less likely to occur in the context of feeding.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") skos:scopeNote obo:ACTAN_0000894 "\"In social species of reptiles and amphibians, the chemosensory pathways that regulate self-recognition and recognition of friendly conspecifics (for example, a bonded partner) have been identified.\"")
SubClassOf(obo:ACTAN_0000894 obo:ACTAN_0000552)
SubClassOf(obo:ACTAN_0000894 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000465))

# Class: obo:ACTAN_0000895 (abandonment transition)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000895 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000895 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000895 "2025-10-20T10:26:57.013045Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasDefinition obo:ACTAN_0000895 "Transition that unadopts and leaves a previously adopted site.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000895 "abandoning"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000895 "abandonment transition"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000895 "\"...the female mockingbird... may abandon her winter territory, and wander until mated.\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000895 "\"A. ibis...
For these few days before pairing, each male occupies a small territory in the colony, displaying on it and vigorously defending against intruders an area of two or three metres radius. It is usual for this territory to be abandoned and another nest used for nesting after a mate has been acquired.\"")
SubClassOf(obo:ACTAN_0000895 obo:ACTAN_0000144)
SubClassOf(obo:ACTAN_0000895 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000428))

# Class: obo:ACTAN_0000896 (leading relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000896 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000896 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000896 "2025-10-20T13:03:26.240496Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000896 "Relativity which maintains a short distance ahead, and matches a relatively slow speed of a follower, in the leader's chosen direction.

It may turn, come back, turn and go forward again.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000896 "guiding"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000896 "leading")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/beheco/12.5.534") oboInOwl:hasNarrowSynonym obo:ACTAN_0000896 "front-running")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000896 "leading relativity")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000896 obo:ACTAN_0000325)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000896 obo:ACTAN_0000920)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/beheco/12.5.534") skos:example obo:ACTAN_0000896 "\"...performing prey retrieval in the army ants Eciton burchelli and Dorylus wilverthi.... there are just two subtasks: front-running, involving a single ant at the front, and following, involving one or more ants bringing up the rear. This distinction might seem almost absurdly obvious and trivial, but it is not, as is clear from considering prey retrieval groups such as Formica wood ants that habitually pull in different directions when they attempt jointly to carry a large prey item. In Formica, subtasks within the prey retrieval group are absent, each ant continues to try to take the lead, and they are notoriously inefficient.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000896 "\"In the dwarf-cichlids (Nannacara, Apistogramma), for instance, only the female guards the eggs (which are laid on a substrate) and leads the young.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000896 "\"Tilapia natalensis and T. nilotica...
...the leading action... can be carried out in the normal as well as the displaying attitude, although T. natalensis as a rule always performs it without displaying...\"\"")
SubClassOf(obo:ACTAN_0000896 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000896 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001632))

# Class: obo:ACTAN_0000897 (imprinting association)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000897 <https://github.com/Active-Animals/Ontology/patterns/context_by_life_cycle>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000897 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000897 "2025-10-20T16:05:52.68384Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"The courtship reactions thus seem to be conditioned, and SEITZ was able to show that the learning process had already taken place at a very early age, and was never forgotten again. This type of conditioning has been called by LORENZ (1935), who found it in young birds, \"Pragung\" (imprinting).\"") oboInOwl:hasDefinition obo:ACTAN_0000897 "Association that is conditioned at a very early age, and is never forgotten again.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000897 "imprinting"@en)
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000897 "imprinting association"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000897 "NBO:0000213")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10071-014-0761-0") skos:example obo:ACTAN_0000897 "\"Many salmonids breed in cool upland rivers where their eggs are laid in gravel beds. As the eggs develop and hatch, the larvae and emerging young imprint on the chemical signature of their home stream. After spending various lengths of time in freshwater, they migrate to the ocean where they may spend several years growing to adulthood. Once mature, the fish return to their home streams by following chemical plumes from the river and matching it to the template laid down during the imprinting stage.\"")
SubClassOf(obo:ACTAN_0000897 obo:ACTAN_0000583)
SubClassOf(obo:ACTAN_0000897 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0000105))

# Class: obo:ACTAN_0000898 (interrogative switch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000898 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000898 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000898 "2025-10-20T16:21:43.300276Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000898 "Stimulation switch in which each action of one member of a pair evokes a linked reaction in the other, and vice versa.

When one link is omitted the pair does not remain friendly any longer.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000898 "interrogative"@en)
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasRelatedSynonym obo:ACTAN_0000898 "interaction sequence")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000898 "interrogative switch"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000898 "\"Bluehead Chub, Nocomis leptocephalus...
the sequence of male-female interactions characteristic of a successful spawn... are: interim (male behavior between spawns), approach (female behavior directed towards interim male), alignment (behavior affecting precise orientation of spawning pair over substrate), run (initiated by female, synchronized movement of aligned pair over substrate), clasp (momentary flexure of male’s body about an axis determined by female’s position at the end of her run) and dissociation (pair separation immediately alter the clasp).\"")
SubClassOf(obo:ACTAN_0000898 obo:ACTAN_0000893)
SubClassOf(obo:ACTAN_0000898 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002486))

# Class: obo:ACTAN_0000899 (stab hit)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000899 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000899 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000899 "2025-10-20T16:41:22.881341Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasDefinition obo:ACTAN_0000899 "Hit that is sudden and penetrative, involving a sharp object.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000899 "pricking"@en)
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000899 "stab")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasNarrowSynonym obo:ACTAN_0000899 "beak-stabbing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000899 "stab hit")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000899 "\"In the stickleback... Often, when the female does not follow immediately, the male stimulates her by pricking her with the dorsal spines.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4161407") skos:example obo:ACTAN_0000899 "\"The jaeger killed the victim by stabbing with its beak at the head and thorax region;\"")
SubClassOf(obo:ACTAN_0000899 obo:ACTAN_0000860)
SubClassOf(obo:ACTAN_0000899 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001419))

# Class: obo:ACTAN_0000900 (male-male formation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000900 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000900 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000900 "2025-10-21T06:57:21.002089Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000900 "Formation in which males perform mating activities with each other.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(rdfs:comment "Synonym label is constructed from a large section of prose.") oboInOwl:hasExactSynonym obo:ACTAN_0000900 "homosexual male"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000900 "male-male formation")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000900 "\"In these Lacerta- and Anolis species homosexual matings are rare.\"")
SubClassOf(obo:ACTAN_0000900 obo:ACTAN_0000831)
SubClassOf(obo:ACTAN_0000900 ObjectSomeValuesFrom(obo:RO_0000057 obo:PCO_0001000))
SubClassOf(obo:ACTAN_0000900 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000384))

# Class: obo:ACTAN_0000901 (head-nod shake)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000901 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000901 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000901 "2025-10-21T07:08:05.733336Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3390/ani13162557") Annotation(skos:scopeNote "\"There is also substantial head nodding that occurs with the running walk, which helps the horse maintain balance (vertical head displacement 10–24 cm).\"") oboInOwl:hasDefinition obo:ACTAN_0000901 "Shake that involves a vertical head displacement.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000901 "head-nodding"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000901 "head-nod shake")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000901 "\"KRAMER (1937) found that in Lacerta melisellensis... the females, but also weaker males, respond with special movements (head-nodding and movements with the fore legs)...\"")
SubClassOf(obo:ACTAN_0000901 obo:ACTAN_0000795)
SubClassOf(obo:ACTAN_0000901 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000033))
SubClassOf(obo:ACTAN_0000901 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002495))

# Class: obo:ACTAN_0000902 (unprotecting exposure)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000902 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000902 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000902 "2025-10-21T08:12:57.409209Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"LORENZ (1939) points out that in such inferior attitudes the attacked animal often demonstratively offers its unprotected vulnerable places.\"") oboInOwl:hasDefinition obo:ACTAN_0000902 "Exposure in which an animal demonstratively offers its vulnerable places.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000902 "unprotecting"@en)
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000902 "unprotecting exposure"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000902 "\"For instance a dog, when defeated offers its throat to the enemy, and this inhibits a further attack.\"")
SubClassOf(obo:ACTAN_0000902 obo:ACTAN_0000423)
SubClassOf(obo:ACTAN_0000902 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000506))

# Class: obo:ACTAN_0000903 (hatching development)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000903 <https://github.com/Active-Animals/Ontology/patterns/context_by_life_cycle>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000903 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000903 "2025-10-21T10:55:18.306996Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"A structure used only once in an animal’s whole life, if of high importance to it, might be modified to any extent by natural selection; for instance, the great jaws possessed by certain insects, and used exclusively for opening the cocoon—or the hard tip to the beak of nestling birds, used for breaking the egg.\"") oboInOwl:hasDefinition obo:ACTAN_0000903 "Development in which a nestling breaks out of its egg.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000903 "hatching"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000903 "hatching development"@en)
SubClassOf(obo:ACTAN_0000903 obo:ACTAN_0000773)
SubClassOf(obo:ACTAN_0000903 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0000068))

# Class: obo:ACTAN_0000904 (promotion incubation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000904 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000904 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000904 "2025-10-21T11:13:42.479393Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000904 "Incubation that speeds hatching by touching an egg.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000904 "promoting hatching"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000904 "promotion incubation"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000904 obo:ACTAN_0000903)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000904 "\"Touching of the eggs is not necessary for hatching; the embryos hatch, but stay in the capsule for a longer time, when the eggs remain untouched.\"")
SubClassOf(obo:ACTAN_0000904 obo:ACTAN_0000474)
SubClassOf(obo:ACTAN_0000904 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000889))

# Class: obo:ACTAN_0000906 (jolting hydrodynamics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000906 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000906 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000906 "2025-10-22T09:36:30.137871Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000906 "Hydrodynamics in which an undulating body movement stimulates another fish's lateral line by the pressure waves generated.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000906 "jolting"@en)
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1590/S1679-62252011005000018") oboInOwl:hasRelatedSynonym obo:ACTAN_0000906 "undulation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000906 "jolting hydrodynamics"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000906 obo:ACTAN_0000600)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000906 obo:ACTAN_0000909)
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0000906 "\"...South American cichlid Laetacara araguaiae...

Attacks... Undulation: the fish performs antero-posterior waving of the body at the side of the opponent..\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000906 "\"Calling the young; jolting...
This action is often carried out by Cichlosoma bimaculatum if alarmed when leading its young. The same movement is carried out by Tilapia natalensis males when they have succeeded in bringing a partner to their pit.... Once we saw this movement performed by a female when in the pit.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000906 "\"The diversity of functions the same movement can get in this way is remarkable. in a great number of Cichlids it serves to lead and especially to alarm the young... In Tilapia it serves as a courting activity, probably to stimulate laying. In Pterophyllum we sometimes observed it during frontal fighting and we got the impression that it then served as a threatening activity.\"")
SubClassOf(obo:ACTAN_0000906 obo:ACTAN_0000601)
SubClassOf(obo:ACTAN_0000906 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000139))

# Class: obo:ACTAN_0000907 (catch constraint)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000907 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000907 "2025-10-22T13:56:37.492675Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000907 "Constraint that takes control.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000907 "capturing")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000907 "catching"@en)
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasNarrowSynonym obo:ACTAN_0000907 "restraining")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "ISBN:9781482294347") oboInOwl:hasRelatedSynonym obo:ACTAN_0000907 "controlling")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000907 "taking")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000907 "catch constraint"@en)
AnnotationAssertion(Annotation(dc:source "ISBN:9781482294347") skos:example obo:ACTAN_0000907 "\"Amplexus can prevent other males from controlling the female (Euproctus, Notophthalmus)...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000907 "\"The Tilapia young are already completely developed some days before they leave the mouth of the female... Now and then a young escapes, but immediately the female tries to catch it... This all suggests that the young are trying to get free, but that the female is not yet willing to let them go.\"\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4161407") skos:example obo:ACTAN_0000907 "\"The leading jaeger forced the sandpiper up, and after a quick series of alternate stoops by both jaegers, 1 caught the sandpiper in its bill, just above the grass. The jaeger carried the flapping sandpiper about 20 m, landed on the tundra and then placed the prey under its feet.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:scopeNote obo:ACTAN_0000907 "\"...forced copulation, where a male uses superior speed or strength to catch and physically restrain a female while he copulates with her by force;\"")
SubClassOf(obo:ACTAN_0000907 obo:ACTAN_0000455)
SubClassOf(obo:ACTAN_0000907 ObjectSomeValuesFrom(obo:BFO_0000051 obo:INO_0000057))

# Class: obo:ACTAN_0000908 (forelimb retraction)

