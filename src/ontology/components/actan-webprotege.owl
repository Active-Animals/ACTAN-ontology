AnnotationAssertion(Annotation(oboInOwl:hasDbXref "WBbt:0006929") oboInOwl:hasNarrowSynonym obo:UBERON_0000020 "sensillum")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "BTO:0000202") oboInOwl:hasRelatedSynonym obo:UBERON_0000020 "Sinnesorgan")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:UBERON_0000020 "sensor")
AnnotationAssertion(rdfs:label obo:UBERON_0000020 "sense organ")
SubClassOf(obo:UBERON_0000020 obo:UBERON_0000062)

# Class: obo:UBERON_0000021 (cutaneous appendage)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://orcid.org/0000-0002-6601-2165") obo:IAO_0000115 obo:UBERON_0000021 "Anatomical projection that protrudes from the skin. Examples: hair, nail, feather, claw, hoof, horn, wattle, spur, beak, antler, bristle and some scales.")
AnnotationAssertion(obo:IAO_0000116 obo:UBERON_0000021 "Mammary glands develop by similar mechanisms, and there is an argument for including them here (e.g. http://www.ncbi.nlm.nih.gov/pubmed/20484386), but these structures do not fit the current definition (lactiferous glands are part of the integumentary system in FMA). Note the FMA class is a subdivision of epidermis, which may be too restrictive for our purposes here.")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0000021 "CALOHA:TS-0051")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0000021 "FMA:71012")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0000021 "SCTID:276160000")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:71012") oboInOwl:hasExactSynonym obo:UBERON_0000021 "skin appendage")
AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:UBERON_0000021 "epidermal appendage")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:UBERON_0000021 "epidermal growth")
AnnotationAssertion(rdfs:label obo:UBERON_0000021 "cutaneous appendage")
SubClassOf(obo:UBERON_0000021 obo:UBERON_0002416)

# Class: obo:UBERON_0000022 (feather)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Feather") obo:IAO_0000115 obo:UBERON_0000022 "One of the epidermal growths that form the distinctive outer covering, or plumage, on birds. Feathers are formed in tiny follicles in the epidermis, or outer skin layer, that produce keratin proteins.")
AnnotationAssertion(obo:UBPROP_0000008 obo:UBERON_0000022 "Among the characteristics that distinguish the extant Aves from other living groups. Feathers have also been noticed in those Theropoda which have been termed feathered dinosaurs. Although feathers cover most parts of the body of birds, they arise only from certain well-defined tracts on the skin. They aid in flight, thermal insulation, waterproofing and coloration that helps in communication and protection")
AnnotationAssertion(obo:UBPROP_0000010 obo:UBERON_0000022 "The beta-keratins in feathers, beaks and claws - and the claws, scales and shells of reptiles - are composed of protein strands hydrogen-bonded into beta-pleated sheets, which are then further twisted and crosslinked by disulfide bridges into structures even tougher than the alpha-keratins of mammalian hair, horns and hoof.")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0000022 "BTO:0000447")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0000022 "EFO:0000955")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0000022 "GAID:1214")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0000022 "MAT:0000156")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0000022 "MESH:D005241")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0000022 "SCTID:410027006")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0000022 "Wikipedia:Feather")
AnnotationAssertion(rdfs:label obo:UBERON_0000022 "feather")
AnnotationAssertion(rdfs:seeAlso obo:UBERON_0000022 "http://xkcd.com/1104/"^^xsd:anyURI)
SubClassOf(obo:UBERON_0000022 obo:UBERON_0000021)

