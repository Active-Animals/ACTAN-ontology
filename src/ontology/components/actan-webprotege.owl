AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3354/meps011165") Annotation(skos:scopeNote "\"Supposing all A. plumosa of this swarm had been collected, the volume of the 20 cm sphere (= 0.004 m3) was comparised of 8190 copepods.\"") oboInOwl:hasDefinition obo:ACTAN_0000662 "Dimension that has a volume.")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1140/epjst/e2008-00633-y") rdfs:label obo:ACTAN_0000662 "three dimension")
