AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ece3.6372") oboInOwl:hasExactSynonym obo:ACTAN_0000296 "den emergence")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ece3.6372") oboInOwl:hasExactSynonym obo:ACTAN_0000296 "den emergency")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ece3.6372") oboInOwl:hasExactSynonym obo:ACTAN_0000296 "den exit")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1181774") oboInOwl:hasExactSynonym obo:ACTAN_0000296 "egress"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000296 "egress exit")
AnnotationAssertion(Annotation(dc:source "doi:10.3354/esr01312") skos:example obo:ACTAN_0000296 "\"...C. horridus hibernacula and population... surveys should be conducted on
warmer days (daytime temperatures >15–20°C) during the fall ingress and spring egress periods, when individuals congregate at or near hibernacula habitat...\"")
SubClassOf(obo:ACTAN_0000296 obo:ACTAN_0000028)
