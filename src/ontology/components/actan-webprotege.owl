AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Lead (leading): Returning at least three times to one location in the tank; performed by females during courtship.\"") oboInOwl:hasDefinition obo:ACTAN_0000545 "Ethotype in which a female returns at least three times to one location.")
