AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1676/1559-4491-128.3.628") Annotation(skos:scopeNote "\"In the aggressive posture ‘busking’ of Mute Swans, the wings are arched above the back, with the secondary feathers raised above the head, creating an enlarged circular profile when viewed from the front.\"") oboInOwl:hasDefinition obo:ACTAN_0000810 "Arch that involves the wings in circular profile above the back.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000810 "arch over the back"@en)
