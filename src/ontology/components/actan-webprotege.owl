# Class: obo:UBERON_0002416 (integumental system)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "CARO:0002001") Annotation(oboInOwl:hasDbXref "http://orcid.org/0000-0002-6601-2165") Annotation(oboInOwl:hasDbXref "https://github.com/obophenotype/uberon/issues/29") obo:IAO_0000115 obo:UBERON_0002416 "Connected anatomical system that forms a barrier between an animal and its environment. In vertebrates, the integumental system consists of the epidermis, dermis plus associated glands and adnexa such as hair and scales. In invertebrates, the integumental system may include cuticle.")
AnnotationAssertion(Annotation(oboInOwl:date_retrieved "2012-09-17") Annotation(oboInOwl:external_class "VHOG:0000403") Annotation(oboInOwl:ontology "VHOG") Annotation(oboInOwl:source "DOI:10.1111/j.1469-7580.2008.01043.x Vickaryous MK, Sire JY, The integumentary skeleton of tetrapods: origin, evolution, and development. J Anat (2009)") Annotation(oboInOwl:source "http://bgee.unil.ch/") obo:UBPROP_0000003 obo:UBERON_0002416 "(...) the integument of many tetrapods is reinforced by a morphologically and structurally diverse assemblage of skeletal elements. These elements are widely understood to be derivatives of the once all-encompassing dermal skeleton of stem-gnathostomes (...).[well established][VHOG]")
AnnotationAssertion(dc:contributor obo:UBERON_0002416 <https://github.com/cmungall>)
AnnotationAssertion(dc:contributor obo:UBERON_0002416 <https://github.com/tfhayamizu>)
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:72979") oboInOwl:hasExactSynonym obo:UBERON_0002416 "integumentary system")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:UBERON_0002416 "body surface")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "MIAA:0000033") oboInOwl:hasRelatedSynonym obo:UBERON_0002416 "dermal system")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:UBERON_0002416 "external covering of organism")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Integumentary_system") Annotation(oboInOwl:hasSynonymType obo:OMO_0003011) oboInOwl:hasRelatedSynonym obo:UBERON_0002416 "integumentum commune")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "EHDAA2:0003154") oboInOwl:hasRelatedSynonym obo:UBERON_0002416 "organism surface")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "BILA:0000118") oboInOwl:hasRelatedSynonym obo:UBERON_0002416 "surface")
AnnotationAssertion(rdfs:label obo:UBERON_0002416 "integumental system")
SubClassOf(obo:UBERON_0002416 obo:UBERON_0000467)

