# Class: obo:ACTAN_0000218 (walking-trot gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000218 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000218 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000218 "2024-10-02T06:50:43.229056Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Compositional definition.") oboInOwl:hasDefinition obo:ACTAN_0000218 "Trot gait that realizes a quadrupedal, suspended, walking pattern.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000218 "walking trot"@en)
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000218 "walking-trot gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") skos:scopeNote obo:ACTAN_0000218 "\"Reptiles and amphibians are historically thought to use “walking trots” at slow speeds (trots with a duty factor >0.5) and “running trots” (trots with a duty factor <0.5) at higher speeds.\"")
SubClassOf(obo:ACTAN_0000218 obo:ACTAN_0000203)
