AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/jzo.12455") oboInOwl:hasDefinition obo:ACTAN_0000937 "Retracting that involves the hindlimb.")
AnnotationAssertion(Annotation(dc:date "2017"^^xsd:decimal) Annotation(dc:source "doi:10.1111/jzo.12455") Annotation(skos:scopeNote "\"...on the hind limb... the animal will be able to retract itself...\"") rdfs:label obo:ACTAN_0000937 "hindlimb retracting"@en)
