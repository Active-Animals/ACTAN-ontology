# Class: obo:ACTAN_0000529 (flap pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000529 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000529 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000529 "2025-01-19T18:36:45.1645Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasDefinition obo:ACTAN_0000529 "Gait pattern in which an appendage makes two strokes against a fluid medium.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000529 "flap"@en)
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasExactSynonym obo:ACTAN_0000529 "oscillatory")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000529 "swivelling")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000529 "paddling")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000529 "beating")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000529 "winging")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000529 "flap pattern")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000529 "\"Microgadus tomcod often uses the pectorals to wing its way along in a somewhat labriform manner.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") skos:scopeNote obo:ACTAN_0000529 "\"Alcids are capable of competent aerial locomotion using a typical avian flapping technique, then fold their wings during aquatic operations and perform an oscillating motion of the wings in order to propel themselves... The key point to note here is that the alcids use a lift based propulsion mechanism in air and water, but during the aquatic phase the bird utilizes an active upstroke; that is lift is produced on the up stroke as well as the down stroke. This lift based technique is proven to achieve higher propulsive efficiency than drag based propulsion mechanisms. However, the flapping frequencies during aerial and aquatic operations reduce from approximately 9 to 2.5 Hz in the common guillemot.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.194704") skos:scopeNote obo:ACTAN_0000529 "\"Kinematics research has shown that high AR median fins are associated with oscillatory, flapping balistiform fin kinematics, while low AR median fins are associated with more wave-like, undulatory median fin kinematics.\"")
SubClassOf(Annotation(dc:source "doi:10.1017/jfm.2017.173") Annotation(skos:scopeNote "\"The above study demonstrates many common features and differences between two flapping gaits, pitching and heaving, used by a simple wing.\"") obo:ACTAN_0000529 obo:ACTAN_0000126)
SubClassOf(obo:ACTAN_0000529 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0000026))

# Class: obo:ACTAN_0000530 (unsteady-locomotion pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000530 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000530 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000530 "2025-01-19T18:38:02.198815Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/41.2.137") Annotation(skos:scopeNote "\"We refer to intermittent locomotion when the force an animal exerts to move itself through space is applied discontinuously and the pauses last longer than the nonpowered phase of a single cycle of limb movement.\"") oboInOwl:hasDefinition obo:ACTAN_0000530 "Regime pattern in which the force an animal exerts to move itself through space is applied discontinuously and the pauses last longer than the nonpowered phase of a single cycle of limb movement.

A terrestrial organism engaged in intermittent locomotion typically comes to a complete stop during the non-powered phase, but in air or water the animal may continue to glide forward so that motion is continuous, though variable in speed, while the application of force is intermittent.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000530 "discontinuous locomotion")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.021360") oboInOwl:hasExactSynonym obo:ACTAN_0000530 "unsteady locomotion")
AnnotationAssertion(Annotation(dc:date "1991"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.158.1.369") oboInOwl:hasNarrowSynonym obo:ACTAN_0000530 "intermittent locomotion"@en)
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasNarrowSynonym obo:ACTAN_0000530 "pause-travel")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000530 "saltatory")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasNarrowSynonym obo:ACTAN_0000530 "stop-and-go")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasNarrowSynonym obo:ACTAN_0000530 "stop-go")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") Annotation(skos:scopeNote "\"Swimming locomotion has been classified into... Transient...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000530 "transient locomotion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000530 "unsteady-locomotion pattern"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1002/9781118501153.ch12") skos:example obo:ACTAN_0000530 "\"Metamorphosed flatfishes... When moving in contact with the bottom, locomotion... in this mode usually consists of short movements interspersed with pauses.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.021360") skos:scopeNote obo:ACTAN_0000530 "\"...a diversity of unsteady locomotor behaviors: kick-and-glide swimming, braking and backing maneuvers.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:scopeNote obo:ACTAN_0000530 "\"Transient (or unsteady) movements that include rapid starts, escape maneuvers, and turns. Transient movements last milliseconds and are typically used for catching prey or avoiding predators.\"")
SubClassOf(obo:ACTAN_0000530 obo:ACTAN_0000064)
SubClassOf(obo:ACTAN_0000530 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000690))

# Class: obo:ACTAN_0000531 (undulating-flying regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000531 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000531 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000531 "2025-01-19T21:19:32.415138Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1038/ncomms1350") Annotation(skos:scopeNote "\"Undulating flight is a special form of intermittent locomotion and involves gliding with flexed wings interspersed with active flapping.\"") oboInOwl:hasDefinition obo:ACTAN_0000531 "Flying-regime that involves gliding with flexed wings interspersed with active flapping.

Sufficient lift-production during glides is the main criterion allowing birds to undulate.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000531 "undulatory flight")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000531 "undulating-flying regime"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000531 "\"...on the plains of La Plata, where not a tree grows, there is a woodpecker, which in every essential part of its organisation, even in its colouring, in the harsh tone of its voice, and undulatory flight, told me plainly of its close blood-relationship to our common species; yet it is a woodpecker which never climbs a tree!\"")
SubClassOf(obo:ACTAN_0000531 obo:ACTAN_0000076)
SubClassOf(obo:ACTAN_0000531 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000042))
SubClassOf(obo:ACTAN_0000531 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000152))
SubClassOf(obo:ACTAN_0000531 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000530))
SubClassOf(obo:ACTAN_0000531 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000543))

# Class: obo:ACTAN_0000532 (undulating-swimming regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000532 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000532 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000532 "2025-01-19T21:24:29.941125Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1038/ncomms1350") Annotation(skos:scopeNote "\"All four species performed undulating flight, where passive gliding descents are interspersed with ascents characteristic of active propulsion.\"") oboInOwl:hasDefinition obo:ACTAN_0000532 "Swimming-regime in which passive gliding descents are interspersed with ascents characteristic of active propulsion.

Marine animals appear at times to face the problem of not having enough ‘effective weight’ to undulate.")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1038/ncomms1350") oboInOwl:hasExactSynonym obo:ACTAN_0000532 "undulating flight in water")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1038/ncomms1350") oboInOwl:hasExactSynonym obo:ACTAN_0000532 "undulating swimming"@en)
AnnotationAssertion(Annotation(dc:date "2018"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rsos.170467") oboInOwl:hasExactSynonym obo:ACTAN_0000532 "undulatory swimming")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000532 "undulating-swimming regime")
AnnotationAssertion(Annotation(dc:source "doi:10.1038/ncomms1350") skos:example obo:ACTAN_0000532 "\"We found no evidence of intermittent locomotion by elephant seals at depths shallower than ~15 m, probably as a result of animals being near neutral buoyancy, whereas at deeper depths seals would swim intermittently, likely due to their increased overall density.\"")
SubClassOf(obo:ACTAN_0000532 obo:ACTAN_0000088)
SubClassOf(obo:ACTAN_0000532 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000042))
SubClassOf(obo:ACTAN_0000532 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000152))
SubClassOf(obo:ACTAN_0000532 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000530))
SubClassOf(obo:ACTAN_0000532 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000543))

# Class: obo:ACTAN_0000533 (bounding regime)

