# Class: obo:ACTAN_0000798 (narrowing contracting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000798 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000798 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000798 "2025-08-12T16:42:27.506332Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasDefinition obo:ACTAN_0000798 "Contracting which causes a ring of reducing diameter.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000798 "narrowing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000798 "narrowing contracting"@en)
AnnotationAssertion(Annotation(dc:source "https://www.researchgate.net/profile/Lina-Barrios-2/post/any_idea_about_these_anemones/attachment/59d61dea79197b807797c41b/AS%3A273509083512833%401442221055505/download/Fautin+et+al+2015-+Sea+anemones+of+Singapore.pdf") skos:example obo:ACTAN_0000798 "\"Anemones expand mainly at night. The column commonly is constricted at the point acontia are emitted.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") skos:example obo:ACTAN_0000798 "\"Metridium...
Constriction of the circular muscle fibres narrows the column.\"")
SubClassOf(obo:ACTAN_0000798 obo:ACTAN_0000743)
SubClassOf(obo:ACTAN_0000798 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001713))

