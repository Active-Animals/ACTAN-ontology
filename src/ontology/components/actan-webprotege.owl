SubClassOf(obo:ACTAN_0000818 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000765))
SubClassOf(obo:ACTAN_0000818 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000753))

# Class: obo:ACTAN_0000819 (steaming gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000819 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000819 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000819 "2025-09-07T13:33:34.690338Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.jstor.org/stable/4086543") Annotation(skos:scopeNote "\"We confirmed photographically for T. pteneres that steaming birds use their wings simultanecusly and that the wings are used as oars rather than simply flapped as in a take-off run. Virtually all propulsion and turbulence results from deep alternate strokes of the feet. Often the foot paddles break the surface of the water behind the birds, and the arc of paddle movement sometimes ends above the level of the back, as noted by Reynolds (1934: 351). Oaring of wings and upright posture of the head and neck probably keep the birds from being driven underwater by the powerful thrusts of their feet.\"") oboInOwl:hasDefinition obo:ACTAN_0000819 "Interfacing-gait in which the wings are used simultaneously as oars, with deep alternate strokes of the feet.

Often the foot paddles break the surface of the water. Oaring of wings and upright posture of the head and neck probably keep the birds from being driven underwater by the powerful thrusts of their feet.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000819 "steaming"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000819 "steaming gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000819 "\"I have observed the wing-and-leg-stretch in the post-copulation situation in the male European and Barrow's Goldeneyes, after the characteristic Steaming away from the female.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000819 "\"Preen-back-behind-wing is given by male Goldeneyes and the Hooded Merganser before copulation. It is performed once only, immediately before the male Steams toward the female.\"")
SubClassOf(obo:ACTAN_0000819 obo:ACTAN_0000155)
SubClassOf(obo:ACTAN_0000819 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000150))
SubClassOf(obo:ACTAN_0000819 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000421))
SubClassOf(obo:ACTAN_0000819 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000019))
SubClassOf(obo:ACTAN_0000819 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000529))

# Class: obo:ACTAN_0000820 (prone lie)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000820 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000820 "Ditch Townsend")
