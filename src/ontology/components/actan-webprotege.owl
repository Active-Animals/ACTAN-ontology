AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.ncbi.nlm.nih.gov/books/NBK10991/") Annotation(skos:scopeNote "\"Saccades are rapid, ballistic movements of the eyes that abruptly change the point of fixation.\"") oboInOwl:hasDefinition obo:ACTAN_0000516 "Conjugation in which the eyes rapidly, ballistically, and abruptly change the point of fixation.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000516 "saccade"@en)
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000516 "saccadic eye movement")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000516 "saccade conjugation")
SubClassOf(obo:ACTAN_0000516 obo:ACTAN_0000745)
SubClassOf(obo:ACTAN_0000516 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000690))

# Class: obo:ACTAN_0000517 (C turning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000517 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000517 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000517 "2024-12-31T11:49:00.377526Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000517 "Fast turning in which the body first curves to form a C-shape.

If a start, then the animal quickly propels itself away at an angle from its previous position.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000517 "C-bend"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000517 "C-shape")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"...C-bend/turn...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000517 "C-turn")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000517 "C-start")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasNarrowSynonym obo:ACTAN_0000517 "Mauthner reflex")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000517 "C turning")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000517 "\"In larval zebrafish, head stimulation generally elicits C-starts, while tail stimulation evokes both C- and S-starts.\"")
SubClassOf(obo:ACTAN_0000517 obo:ACTAN_0000569)
SubClassOf(obo:ACTAN_0000517 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0015019))

# Class: obo:ACTAN_0000518 (charge relativity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000518 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000518 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000518 "2024-12-31T21:30:47.895271Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000518 "Relativity that involves acceleration towards a second animal.

It may be a dominating movement.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000518 "charging"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000518 "rushing")
AnnotationAssertion(Annotation(dc:date "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000518 "charge relativity")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000518 "\"Hemichromis bimaculatus...
Sometimes the male... will rush on to the female... The male may even \"demonstratively\" swim away first, in order to perform such a charge.\"")
SubClassOf(obo:ACTAN_0000518 obo:ACTAN_0000288)
SubClassOf(obo:ACTAN_0000518 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000154))
SubClassOf(obo:ACTAN_0000518 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002448))

# Class: obo:ACTAN_0000519 (thermo-taxis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000519 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000519 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000519 "2025-01-01T14:21:23.941531Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1038/s41467-023-38685-1") Annotation(skos:scopeNote "\"Whereas short-lasting processes (second–minutes timescale) underlying temperature-dependent navigation in spatial thermogradient has been extensively studied, we know surprisingly little on temperature-dependent persistent behavioral states and transitions over longer timescales.\"") oboInOwl:hasDefinition obo:ACTAN_0000519 "Taxis that is temperature-dependent.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.1038/s41467-023-38685-1") rdfs:label obo:ACTAN_0000519 "thermo-taxis"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000519 "NBO:0000384")
AnnotationAssertion(Annotation(rdfs:comment "doi:10.1038/s41467-023-38685-1") skos:example obo:ACTAN_0000519 "\"C. elegans senses a wide range of temperature, and execute thermotaxis to stay at a preferred temperature in the ‘innocuous range’ of 13–25 °C, while avoiding extreme ‘noxious’ temperatures.\"")
SubClassOf(obo:ACTAN_0000519 obo:ACTAN_0000368)
SubClassOf(obo:ACTAN_0000519 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0003942))

# Class: obo:ACTAN_0000520 (chemo-taxis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000520 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000520 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000520 "2025-01-01T14:21:34.691476Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/s002850050112") oboInOwl:hasDefinition obo:ACTAN_0000520 "Taxis that has chemical sensitivity.")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s002850050112") oboInOwl:hasNarrowSynonym obo:ACTAN_0000520 "chemoattractant")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s002850050112") rdfs:label obo:ACTAN_0000520 "chemo-taxis"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000520 "NBO:0000377")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000520 "\"... for zebrafish. Chemically-mediated attraction behaviors are diverse and include appetitive olfactory behavior (elicited by L-alanine, food extract and others), chemically mediated kin recognition and sexual aggregating behavior (elicited by sex pheromones). Usually characterized by higher speed as fish follow the increasing concentrations of chemoattractants and by slower speed when fish locate the signal source.\"")
SubClassOf(obo:ACTAN_0000520 obo:ACTAN_0000368)
SubClassOf(obo:ACTAN_0000520 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0005726))

# Class: obo:ACTAN_0000521 (rectilinear pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000521 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000521 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000521 "2025-01-07T10:21:16.555706Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icaa017") Annotation(skos:scopeNote "\"The ventral and ventro-lateral skin of snakes during rectilinear locomotion periodically shortens and lengthens while this portion of the skin oscillates longitudinally relative to the underlying skeleton.\"") oboInOwl:hasDefinition obo:ACTAN_0000521 "Gait pattern in which the skin periodically shortens and lengthens while this portion of the skin oscillates longitudinally relative to the underlying skeleton.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasExactSynonym obo:ACTAN_0000521 "rectilinear mode"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000521 "rectilinear pattern")
SubClassOf(obo:ACTAN_0000521 obo:ACTAN_0000126)
SubClassOf(obo:ACTAN_0000521 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0002097))

# Class: obo:ACTAN_0000522 (jerking movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000522 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000522 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000522 "2025-01-14T09:41:41.228267Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000522 "Movement that is short and intermittent, reducing the smoothness of its trajectory.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000522 "jerking"@en)
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000522 "jerky movement")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000522 "jittery")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000522 "twitch")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000522 "twitching")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1098/rsbl.2019.0534") oboInOwl:hasRelatedSynonym obo:ACTAN_0000522 "jolt")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000522 "jerking movement")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000522 "\"...to remove a branch or reed close to the nest the bird grasps it in its beak and violently jerks it back-and-forth.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000522 "\"The head is bent sideways over a small angle and brought back again. Often this movement is repeated to the left and to the right. The centre of the movement lies close behind the operculae (atlas). As long as the movement was carried out when the fish rests in a horizontal position and the tail made no appreciable lateral movements, we call this action jerking. We observed this jerking regularly among the courtship actions of Cichlasoma, Aequidens, Hemichromis and Astronotus. In Pterphyllum we observed a similar attitude during interterritorial flights.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rsbl.2019.0534") skos:example obo:ACTAN_0000522 "\"cleaner shrimp... eat healthy client tissue (potentially indicated by a sharp twitch or ‘jolt,’ thought to indicate a painful pinch, to which clients may respond by retaliating... \"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000522 "\"Jerking gradually merges into quivering. The position of the fish becomes more vertical (the head downward), the body waves become stronger, and the tail is swept appreciably sideways. In most species a high intensity is marked by the almost vertical position of the longitudinal axis of the fish, and the violent lateral beats of the tail.\"")
SubClassOf(obo:ACTAN_0000522 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000522 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000690))

# Class: obo:ACTAN_0000523 (extension placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000523 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000523 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000523 "2025-01-14T12:16:14.054836Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000523 "Placement that results from extending.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000523 "extended"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000523 "extension")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000523 "aiming")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000523 "erected")
AnnotationAssertion(Annotation(dc:date "1948"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5252&context=wilson_bulletin") oboInOwl:hasNarrowSynonym obo:ACTAN_0000523 "pointing"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasRelatedSynonym obo:ACTAN_0000523 "projected")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000523 "extension placement")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000523 obo:ACTAN_0000624)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.194704") skos:example obo:ACTAN_0000523 "\"Most balistoid fishes possess a mobile ventral keel that can be extended and retracted.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12891") skos:example obo:ACTAN_0000523 "\"Pufferfish (Tetraodontidae) inflate their bodies with the added effect of raising spines, which is assumed to make them more difficult to bite and/or swallow...\"")
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000523 "\"The awkward posturing and strange acrobatics of the oriole were similar to those described for many small species. Always there was some deflection of the tail, even during low intensity anting. Usually the tail was brought sharply around to one side of the feet, or between them, so that the tip pointed forward and the dorsal surface lay largely on the floor.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.194704") skos:scopeNote obo:ACTAN_0000523 "\"...fishes... wedging themselves into corners using their erectable dorsal spines and ventral keels.\"")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") skos:scopeNote obo:ACTAN_0000523 "\"In the special case where the distal segments of a multiply jointed appendage are swung through a dorsal/ventral arc at a proximal joint (e.g. the pectoral girdle of a bird), our terms related to extension and flexion will fit this definition if the whole appendage (e.g the bird's wing) is being referred to. But if a continuation of either ventral or dorsal arc tucks flat against the body in one or other direction, our terms related to abduction and adduction are preferred.

NB: Beware of confusion where sources refer to protraction as extension, alongside the special case of flexion discussed above, i.e. do not assume that flexion is always the opposite of extension: a bird may at times flex or extend the humerus at the pectoral girdle (pointing away from the body) in a protracted OR a retracted wing.

NNB: Beware of confusion where sources refer to our special case of extension as retraction. This can happen where an appendage is moved through a dorsal/ventral arc but parallel to the body (alongside/parasagitally).")
SubClassOf(obo:ACTAN_0000523 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000523 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000726))

# Class: obo:ACTAN_0000524 (feel perception)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000524 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000524 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000524 "2025-01-14T15:53:25.844301Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1038/s41467-023-38685-1") Annotation(skos:scopeNote "\"C. elegans can sense and modulate behavioral states in response to a wide range of sensory and physiological cues such as touch, odors, light, sound, oxygen, CO2, and temperature fromthe environment.\"") oboInOwl:hasDefinition obo:ACTAN_0000524 "Perception which senses touch cues from the environment.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000524 "feeling")
AnnotationAssertion(Annotation(dc:date "1906"^^xsd:decimal) Annotation(dc:source "doi:10.1086/278651") oboInOwl:hasExactSynonym obo:ACTAN_0000524 "tactile sense")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000524 "touching"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000524 "feel perception")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000524 "NBO:0000332")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000524 "\"Hemichromis bimaculatus type...

With the ovipositor the female feels all over the substrate; she usually lays eggs only on the spot cleaned before, and only seldom are the eggs laid upon each other.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000524 "\"In both species of Nocomis.... Observations of nocturnal spawning... suggest that coordination of the spawning act is facilitated, at least in part, by tactile cues between the male, female and spawning substrate.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.130.1.155") skos:scopeNote obo:ACTAN_0000524 "\"In arthropods, the leading legs are frequently used like feelers, as if seeking points of contact.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3190/ac482d") skos:scopeNote obo:ACTAN_0000524 "\"We first induced a dash with an anterior wave by tapping the centipede’s tail. When it approached the boundary and its antenna touched the plastic surface (t ≈ 0.5 s), it rapidly slowed down for a short time, then started crawling at a slower speed (t ≈ 0.75 s).\"")
SubClassOf(obo:ACTAN_0000524 obo:ACTAN_0000335)
SubClassOf(obo:ACTAN_0000524 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000925))
SubClassOf(obo:ACTAN_0000524 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0003942))

# Class: obo:ACTAN_0000525 (tail-nose ethotype)

