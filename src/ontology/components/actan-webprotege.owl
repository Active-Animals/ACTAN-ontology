# Class: obo:ACTAN_0000546 (creep kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000546 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000546 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000546 "2025-01-26T09:35:59.534071Z")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000546 "exceptionally slow movement")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icac125") Annotation(skos:scopeNote "\"A broad category of walking-like locomotion characterized by (1) very slow speeds, (2) minimal excursions of the COM in directions other than the forward direction, (3) three points of contact with the ground at any given time forming a polygonal Support Pattern, (4) the vertical projection of the COM onto the surface that lies within its Support Pattern at the given time, and (5) has static stability at all times,meaning the animal could halt movement and remain stable at any point in time.\"") oboInOwl:hasDefinition obo:ACTAN_0000546 "Kinetics that is characterized by very slow speeds, and static stability at all times.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000546 "creep")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000546 "creep kinetics")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000546 "\"Chimpanzee...
a fearful subordinate tries to creep from the vicinity of a particular higher ranking individual. The subordinate proceeds with extreme caution, moving slowly while keeping a constant sharp watch on the other...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:scopeNote obo:ACTAN_0000546 "\"Zebrafish... creeping... represent passive slow sliding... without use of fins...\"")
SubClassOf(obo:ACTAN_0000546 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000546 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000304))
SubClassOf(obo:ACTAN_0000546 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0015027))

# Class: obo:ACTAN_0000547 (creeping translocation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000547 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000547 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000547 "2025-01-26T09:55:01.679492Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://apps.dtic.mil/sti/html/tr/AD0675256/") oboInOwl:hasDefinition obo:ACTAN_0000547 "Translocation that involves very low speeds.")
AnnotationAssertion(Annotation(dc:date "1968"^^xsd:decimal) Annotation(dc:source "https://apps.dtic.mil/sti/html/tr/AD0675256/") oboInOwl:hasExactSynonym obo:ACTAN_0000547 "creeping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000547 "creeping translocation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000547 "\"Zebrafish... Creeping: Very slow swimming during which only the pectoral fins propel the fish forward;\"")
SubClassOf(obo:ACTAN_0000547 obo:ACTAN_0000752)
SubClassOf(obo:ACTAN_0000547 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000546))

# Class: obo:ACTAN_0000548 (dart sprint)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000548 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000548 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000548 "2025-01-26T12:13:44.97067Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"A single fast acceleration in one direction (e.g., as part of escape behavior) with the use of caudal fin.\"") oboInOwl:hasDefinition obo:ACTAN_0000548 "Sprint which is a single fast acceleration in one direction.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000548 "dart"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000548 "darting")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000548 "dash")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000548 "dart sprint")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/41.2.137") skos:example obo:ACTAN_0000548 "\"As we walk to the edge of a stream, a stickleback freezes, then darts away in a series of rapid zig-zags punctuated by brief pauses.\"")
SubClassOf(obo:ACTAN_0000548 obo:ACTAN_0000150)
SubClassOf(obo:ACTAN_0000548 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001902))

# Class: obo:ACTAN_0000549 (zigzag-swimming regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000549 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000549 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000549 "2025-01-26T13:45:22.345858Z")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasBroadSynonym obo:ACTAN_0000549 "zigzag"@en)
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Stress-induced: erratic movement with multiple darts, during which the direction of movement changes in a seemingly alternating (zigzag-like) manner between the darts.\"") oboInOwl:hasDefinition obo:ACTAN_0000549 "Swimming-regime that involves multiple darts, during which the direction of movement changes between the darts.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1002/jnr.24550") oboInOwl:hasExactSynonym obo:ACTAN_0000549 "erratic swimming")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000549 "jumping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:comment obo:ACTAN_0000549 "We are not putting pathological terms in our ontology, or seizures or drug-induced erratic movements might have fitted alongside here.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000549 "zigzag-swimming regime")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000549 "\"; for instance, the threespined stickleback, which performs the zig-zag dance.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/41.2.137") skos:example obo:ACTAN_0000549 "\"As we walk to the edge of a stream, a stickleback freezes, then darts away in a series of rapid zig-zags punctuated by brief pauses.\"")
SubClassOf(obo:ACTAN_0000549 obo:ACTAN_0000088)
SubClassOf(obo:ACTAN_0000549 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000024))
SubClassOf(obo:ACTAN_0000549 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000548))
SubClassOf(obo:ACTAN_0000549 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000542))
SubClassOf(obo:ACTAN_0000549 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

