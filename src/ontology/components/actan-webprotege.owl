AnnotationAssertion(dc:creator obo:ENVO_01001678 <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(dc:date obo:ENVO_01001678 "2019-07-22T17:35:08Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:ENVO_01001678 "fluid layer"@en)
SubClassOf(obo:ENVO_01001678 obo:ENVO_01000281)

# Class: obo:ENVO_01001684 (interface layer)

AnnotationAssertion(obo:IAO_0000115 obo:ENVO_01001684 "A layer which separates two portions of environmental material which possess 1) differing compositions, 2) a discontinuity of some property, or 3) some derivative of some property in a direction normal to the interface."@en)
AnnotationAssertion(dc:creator obo:ENVO_01001684 <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(dc:date obo:ENVO_01001684 "2019-08-20T09:28:10Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label obo:ENVO_01001684 "interface layer"@en)
SubClassOf(obo:ENVO_01001684 obo:ENVO_01000281)

# Class: obo:ENVO_01001734 (insolation process)

AnnotationAssertion(dc:creator obo:ENVO_01001734 <https://orcid.org/0000-0002-4366-3088>)
AnnotationAssertion(dc:date obo:ENVO_01001734 "2019-09-02T03:42:52Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasBroadSynonym obo:ENVO_01001734 "incoming solar radiation")
AnnotationAssertion(Annotation(rdfs:comment "The broader term can also refer to the amount of radiation received, rather than the process.") oboInOwl:hasBroadSynonym obo:ENVO_01001734 "insolation")
AnnotationAssertion(oboInOwl:hasDefinition obo:ENVO_01001734 "Definition: A process during which direct stellar radiation interacts with a planetary surface.")
AnnotationAssertion(rdfs:label obo:ENVO_01001734 "insolation process"@en)
SubClassOf(obo:ENVO_01001734 obo:ENVO_01001023)

