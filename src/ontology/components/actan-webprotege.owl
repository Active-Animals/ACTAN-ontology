AnnotationAssertion(terms:conformsTo obo:ACTAN_0000217 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000217 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000217 "2024-10-01T08:52:28.182742Z")
