# Class: obo:ACTAN_0000288 (relativity travel)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000288 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000288 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000288 "2024-10-08T07:05:13.648828Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasDefinition obo:ACTAN_0000288 "Travel that adjusts to the movement dynamics of subject and object.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000288 "move relative to")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000288 "relative motion")
AnnotationAssertion(Annotation(dc:date "2016"^^xsd:decimal) Annotation(dc:source "doi:10.1111/1365-2656.12379") oboInOwl:hasExactSynonym obo:ACTAN_0000288 "relative velocity"@en)
AnnotationAssertion(Annotation(dc:date "1917"^^xsd:decimal) Annotation(dc:source "ISBN:9781537076317") oboInOwl:hasExactSynonym obo:ACTAN_0000288 "relativity of motion")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "ISBN:9781482294347") oboInOwl:hasRelatedSynonym obo:ACTAN_0000288 "choreography")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000288 "relativity travel")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.00424") skos:example obo:ACTAN_0000288 "\"The diamond-backed water snake Nerodia rhombifer...
At the beginning of the strike, the head was oriented 90° relative to the prey item. Head angle and segment angle 1 decreased as the head was accelerated to roughly 20°.\"")
AnnotationAssertion(Annotation(dc:source "ISBN:9781537076317") skos:scopeNote obo:ACTAN_0000288 "\"...the Einstein theory takes as its first postulate the idea familiar to Newton of the relativity of all motion. It states that there is nothing out in space in the nature of an ether or of a fixed set of coördinates with regard to which motion can be measured, that there is no such thing as absolute motion, and that all we can speak of is the relative motion of one body with respect to another.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/1365-2656.12379") skos:scopeNote obo:ACTAN_0000288 "\"Clearly, the lack of absolute spatial information is crippling to the purely relative velocity-based methods.\"")
SubClassOf(obo:ACTAN_0000288 obo:ACTAN_0000178)
SubClassOf(obo:ACTAN_0000288 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000149))

# Class: obo:ACTAN_0000289 (reduced-activity pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000289 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000289 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000289 "2024-10-13T13:25:41.207134Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(skos:scopeNote "\"For convenience, the situations evoking suppression of movements may be considered under five groups:\"") oboInOwl:hasDefinition obo:ACTAN_0000289 "Regime pattern in which a situation evokes suppression of movement.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1238167") oboInOwl:hasExactSynonym obo:ACTAN_0000289 "reduced activity"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000289 "reduced-activity pattern"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:example obo:ACTAN_0000289 "\"When satiated, C. elegans stop eating and moving and become quiescent, exhibiting a behavioral sequence of satiety similar to that observed in mammals.\"")
SubClassOf(obo:ACTAN_0000289 obo:ACTAN_0000064)
SubClassOf(obo:ACTAN_0000289 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002630))

# Class: obo:ACTAN_0000290 (localization travel)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000290 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000290 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000290 "2024-10-08T07:06:43.93759Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/1365-2656.12379") Annotation(skos:scopeNote "\"Clearly, the lack of absolute spatial information is crippling to the purely relative velocity-based methods.\"") oboInOwl:hasDefinition obo:ACTAN_0000290 "Travel that involves absolute spatial information.")
AnnotationAssertion(Annotation(dc:date "2016"^^xsd:decimal) Annotation(dc:source "doi:10.1111/1365-2656.12379") oboInOwl:hasExactSynonym obo:ACTAN_0000290 "absolute spatial"@en)
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10071-014-0761-0") oboInOwl:hasExactSynonym obo:ACTAN_0000290 "localisation")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasExactSynonym obo:ACTAN_0000290 "localization")
AnnotationAssertion(Annotation(dc:date "2016"^^xsd:decimal) Annotation(dc:source "doi:10.1111/1365-2656.12379") oboInOwl:hasRelatedSynonym obo:ACTAN_0000290 "locally attracted")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasRelatedSynonym obo:ACTAN_0000290 "navigational")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000290 "place")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000290 "localization travel")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:scopeNote obo:ACTAN_0000290 "\"But in the case of an island, or of a country partly surrounded by barriers, into which new and better adapted forms could not freely enter, we should then have places in the economy of nature which would assuredly be better filled up, if some of the original inhabitants were in some manner modified; for, had the area been open to immigration, these same places would have been seized on by intruders.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ajp.23055") skos:scopeNote obo:ACTAN_0000290 "\"Primates naturally occupy complex, arboreal habitats in which they navigate discontinuous substrates that vary in height, diameter, inclination, and compliance.\"")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") skos:scopeNote obo:ACTAN_0000290 "This class is about locomotion with reference to an external frame. NB: Perching involves minimal locomotion within a reference frame; migrating involves locomotion within a potentially global reference frame.")
SubClassOf(obo:ACTAN_0000290 obo:ACTAN_0000178)
SubClassOf(obo:ACTAN_0000290 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01000739))
SubClassOf(obo:ACTAN_0000290 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002261))

# Class: obo:ACTAN_0000291 (territorialism residence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000291 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000291 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000291 "2024-10-08T07:06:57.377805Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Territorial behavior: Monopolization and aggressive defense of a defined area in a habitat/tank (e.g., spawning sites are a commonly defended territory in zebrafish). Trespassers into the territory may be chased or bitten by the dominant fish, or can ‘fight’ to challenge its dominance.\"") oboInOwl:hasDefinition obo:ACTAN_0000291 "Residence that monopolizes a defined area in a habitat by dominating trespassers.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000291 "territorialism"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000291 "territorialism residence"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000291 "\"...the almost invariable occurrence of wing-flaps, in both chaser and chased bird, immediately after territorial encounters between male Velvet Scoters (Melanitta f. fusca).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1238167") skos:example obo:ACTAN_0000291 "\"For example, young-of-the-year Atlantic salmon defend smaller foraging territories and exhibit reduced reaction distances towards standardised predation threats (i.e. reduced perceived predation risk) in complex versus more homogeneous habitats.\"")
SubClassOf(obo:ACTAN_0000291 obo:ACTAN_0000308)
SubClassOf(Annotation(dc:source "doi:10.1163/156853981X00220") obo:ACTAN_0000291 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000387))
SubClassOf(Annotation(dc:source "doi:10.1163/156853981X00220") obo:ACTAN_0000291 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000414))
SubClassOf(obo:ACTAN_0000291 ObjectSomeValuesFrom(obo:RO_0000057 obo:BFO_0000140))

# Class: obo:ACTAN_0000292 (refuge localization)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000292 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000292 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000292 "2024-10-08T07:07:19.687309Z")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"When the nest is slightly disturbed, the slaves occasionally come out, and like their masters are much agitated and defend the nest: when the nest is much disturbed and the larvæ and pupæ are exposed, the slaves work energetically with their masters in carrying them away to a place of safety.\"") oboInOwl:hasDefinition obo:ACTAN_0000292 "Localization that involves a place of safety.")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasExactSynonym obo:ACTAN_0000292 "refuge"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000292 "cover")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000292 "refuge localization")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000292 "NBO:0020059")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4161407") skos:example obo:ACTAN_0000292 "\"The second and third instances, on 11 August 1977 and 7 August 1979, respectively, both involved chases of Lapland Longspurs (Calcarius lapponicus). In each case the longspur sought refuge near a gravel road and did not flush from the grass despite rapid stoops by both jaegers, who soon gave up the chase.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1231780") skos:scopeNote obo:ACTAN_0000292 "\"For this analysis, vegetation types were classified as ‘grazing’, which were areas dominated by open grassland, ‘cover’, which were areas dominated by trees or shrubs, and ‘grazing-cover’, which were areas with a mixture of grassland and discrete patches of refuge habitat, either woodland edges (obstructive cover) or flooded pans (protective cover into which herbivores can retreat when attacked).\"")
SubClassOf(obo:ACTAN_0000292 obo:ACTAN_0000290)
SubClassOf(obo:ACTAN_0000292 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000576))

# Class: obo:ACTAN_0000293 (protection refuge)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000293 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000293 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000293 "2024-10-08T07:07:34.974726Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/brv.12934") oboInOwl:hasDefinition obo:ACTAN_0000293 "Refuge which provides a risky environment for unwanted interactions.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000293 "protected station"@en)
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasExactSynonym obo:ACTAN_0000293 "protection")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000293 "protection refuge")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000293 obo:ACTAN_0000378)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000293 obo:ACTAN_0000834)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000293 "\"...when a cirripede is parasitic within another and is thus protected, it loses more or less completely its own shell or carapace.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.4236/ojas.2019.91008") skos:example obo:ACTAN_0000293 "\"Another advantage a sharksucker gains from being attached to a shark lays in its protection from other predators.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:example obo:ACTAN_0000293 "\"In feral horses, Equus caballus, females living in nonterritorial harems (where harassment is relatively common) are more frequently disturbed by males while feeding and show lower breeding success than females associated with territorial males where territory holders provide effective protection against other males.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000293 "\"...larger snakes and cooler snakes exhibited more body rubbing behavior, more open-mouth strikes, more tail vibration, more coiled body postures, positioned their tails more lateral to the predator, and had more elevated and protected heads compared with smaller and warmer snakes.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1231780") skos:scopeNote obo:ACTAN_0000293 "\"For this analysis, vegetation types were classified as ‘grazing’, which were areas dominated by open grassland, ‘cover’, which were areas dominated by trees or shrubs, and ‘grazing-cover’, which were areas with a mixture of grassland and discrete patches of refuge habitat, either woodland edges (obstructive cover) or flooded pans (protective cover into which herbivores can retreat when attacked).\"")
SubClassOf(obo:ACTAN_0000293 obo:ACTAN_0000292)
SubClassOf(obo:ACTAN_0000293 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000383))

# Class: obo:ACTAN_0000294 (shelter refuge)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000294 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000294 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000294 "2024-10-08T07:08:00.004332Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "http://researcharchive.vuw.ac.nz/handle/10063/9442") Annotation(skos:scopeNote "\"Some nest sites may be less prone to predation and shield the parents or eggs from harmful environments.\"") oboInOwl:hasDefinition obo:ACTAN_0000294 "Refuge which shields from harmful environments.")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000294 "obstruction")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1231780") oboInOwl:hasExactSynonym obo:ACTAN_0000294 "obstructive cover"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000294 "shelter"@en)
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "http://researcharchive.vuw.ac.nz/handle/10063/9442") oboInOwl:hasExactSynonym obo:ACTAN_0000294 "shield")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000294 "shelter refuge")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000294 obo:ACTAN_0000886)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF01609520") skos:example obo:ACTAN_0000294 "\"...a case of \"resource sharing\" where diurnal and nocturnal water-column foragers replace one another in resting shelters over the 24 hour cycle...\"")
AnnotationAssertion(Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") skos:example obo:ACTAN_0000294 "\"...increased habitat complexity act to reduce predation by placing more visual obstructions in the path opf predators thus increasing the ability of mobile prey to hide, evade and escape. Therefore, gobies on D. gemmacea could take advantage of its complex multiple-branching structure to confuse predators...\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000294 "\"Thalassoma cupido...
When attacked, the wrasses quickly dispersed, seeking refuge under the algae where they remained for about 30 seconds.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00227-014-2403-0") skos:scopeNote obo:ACTAN_0000294 "\"...flow-refuging behaviour in wave-swept habitats.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1231780") skos:scopeNote obo:ACTAN_0000294 "\"For this analysis, vegetation types were classified as ‘grazing’, which were areas dominated by open grassland, ‘cover’, which were areas dominated by trees or shrubs, and ‘grazing-cover’, which were areas with a mixture of grassland and discrete patches of refuge habitat, either woodland edges (obstructive cover) or flooded pans (protective cover into which herbivores can retreat when attacked).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:scopeNote obo:ACTAN_0000294 "\"Hermit crabs are unique animals for locomotion studies. They are specialized to carry snail shells. The addition of this load obviously reduces the crab's speed and manoeuvrability, and increases the energy used for transport, while it provides the advantage of protection from predators and environmental extremes.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.11369/jji1950.34.76") skos:scopeNote obo:ACTAN_0000294 "\"Large boulders, smaller rocks, cliffs, crevices, caves, coral outcroppings, and lush algal meadows provide adequate shelter not only for spawning labrids, but also for piscivores and potential egg predators.\"")
SubClassOf(obo:ACTAN_0000294 obo:ACTAN_0000292)
SubClassOf(obo:ACTAN_0000294 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_00010483))

# Class: obo:ACTAN_0000295 (dorsal-fin extending)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000295 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000295 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000295 "2026-07-20T10:16:34.31925Z")
AnnotationAssertion(Annotation(dc:source "\"Schlesinger points out with a diagram that in turning by means of extending a single pectoral the pressure of the water on the extended dorsal and anal swings the fish around with the pectoral somewhat as a pivot.\"") Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasDefinition obo:ACTAN_0000295 "Extending that involves the dorsal fin.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"...extended dorsal and anal...\"") rdfs:label obo:ACTAN_0000295 "dorsal-fin extending"@en)
SubClassOf(obo:ACTAN_0000295 obo:ACTAN_0000726)
SubClassOf(obo:ACTAN_0000295 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0003097))

