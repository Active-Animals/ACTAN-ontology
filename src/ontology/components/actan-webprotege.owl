# Class: obo:ACTAN_0000590 (suction kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000590 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000590 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000590 "2025-02-09T16:34:33.192936Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasDefinition obo:ACTAN_0000590 "Kinetics that produces negative pressure in a cavity to pump a fluid.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000590 "sucking"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000590 "suction")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000590 "suctorial specialization")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "https://bioengineering.hyperbook.mcgill.ca/functional-mechanics-of-the-elephant-and-butterfly-proboscis/") oboInOwl:hasNarrowSynonym obo:ACTAN_0000590 "sucking pump")
AnnotationAssertion(Annotation(dc:date "1993"^^xsd:decimal) Annotation(dc:source "ISBN:9780226315737") oboInOwl:hasNarrowSynonym obo:ACTAN_0000590 "suction pump")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000590 "suction kinetics")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000590 "\"Achirus fasciatus attaches itself to smooth surfaces by pressing the fringing fins downward and raising the central part of the body thus producing considerable suction.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF01609520") skos:example obo:ACTAN_0000590 "\"In two species, Emmelichthyops and Schultzea, an additional process is found on the premaxilla which apparently serves in giving support to the large resulting gape between the maxilla and the premaxilla; this gape is covered only by integument when the jaw is shot forward. When feeding, these fishes \"shoot\" the jaw forward and downward rapidly; this rapid expansion of the oral cavity creates a suction which draws prey into the cavity.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.4236/ojas.2019.91008") skos:example obo:ACTAN_0000590 "\"Since a sharksucker is attached to its client most of the time, it also saves energy that would otherwise be used to swim.\"")
SubClassOf(obo:ACTAN_0000590 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000590 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001575))

# Class: obo:ACTAN_0000591 (piping buoyancy)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000591 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000591 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000591 "2025-02-09T16:36:49.116475Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Piping: Gulping air at the water surface; can be indicative of distress (e.g., hypoxia or toxicity), but may also be seen during depth-related adjustment of swim bladder volume (during diving).\"") oboInOwl:hasDefinition obo:ACTAN_0000591 "Buoyancy that involves gulping air at the water surface.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000591 "piping"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.198.1.79") Annotation(rdfs:comment "1995"^^xsd:decimal) oboInOwl:hasRelatedSynonym obo:ACTAN_0000591 "air-gulping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000591 "piping buoyancy")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.198.1.79") skos:scopeNote obo:ACTAN_0000591 "\"Buoyancy control during ASR allows fish to optimize their position (benthic species) or swimming mode (midwater species) and to compensate for O2 loss from the swimbladder (which decreases in volume) that occurs during hypoxic stress.\"")
SubClassOf(obo:ACTAN_0000591 obo:ACTAN_0000677)
SubClassOf(obo:ACTAN_0000591 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01001309))

# Class: obo:ACTAN_0000592 (retreat avoidance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000592 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000592 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000592 "2025-02-10T07:42:38.147107Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000592 "Avoidance that is a submissive movement away from a dominant agonist.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000592 "retiring")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000592 "retreat"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000592 "withdrawing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000592 "retreat avoidance"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000592 "NBO:0000127")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") skos:example obo:ACTAN_0000592 "\"In response to the gorilla’s behaviour, an intruder, although discouraged from approaching, may decide not to retreat but to remain in its location.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000592 "\"Nocomis leptocephalus...
Once released, the female continued to rise vertically into the water column, then quickly rolled upright and... retreated downstream...\"")
SubClassOf(Annotation(dc:source "doi:10.1089/zeb.2012.0861") obo:ACTAN_0000592 obo:ACTAN_0000376)
SubClassOf(obo:ACTAN_0000592 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000506))

# Class: obo:ACTAN_0000593 (rheo-taxis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000593 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000593 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000593 "2025-02-10T13:37:25.025516Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Rheotaxis: A common behavior in aquatic species, includes turning towards a current and a tendency to swim upstream;\"") oboInOwl:hasDefinition obo:ACTAN_0000593 "Taxis that responds to a current.")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000593 "rheophilic")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") rdfs:label obo:ACTAN_0000593 "rheo-taxis"@en)
AnnotationAssertion(Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") skos:example obo:ACTAN_0000593 "\"...another reason why colony height is such as important determinant of occupancy is becauae taller colonies reach higher into the water column thus allowing the rheophilic B. amplus better access to zooplankton prey.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000593 "\"In holding a position in a current, fishes head up stream as this minimizes the frictional resistance of the flow against their bodies by reason of their streamline shape; and in this position they are properly orientated for swimming against it.\"")
SubClassOf(obo:ACTAN_0000593 obo:ACTAN_0000368)
SubClassOf(obo:ACTAN_0000593 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002540))

# Class: obo:ACTAN_0000594 (S turning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000594 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000594 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000594 "2025-02-10T14:10:40.213355Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000594 "Fast turning in which the body curves to form an S-shape with simultaneous activity rostrally on one side, and caudally on the other.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000594 "S-bend")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000594 "S-shape")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icq147") oboInOwl:hasNarrowSynonym obo:ACTAN_0000594 "S-start")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(skos:scopeNote "\"Sickle-shape and S-shape are two extremes and all degrees of intermediacy occur.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000594 "sickle-shape")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000594 "S turning"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icq147") skos:example obo:ACTAN_0000594 "\"G. affinis... After extension and pronation of the gonopodium during circumduction, males’ bodies bend in an S-shape (the S-start-like portion of the circumduction of the gonopodium takes [approx] 20 ms) that is similar to the rapid-acceleration S-start type of fast-starts, used by teleost fish during predator–prey interactions.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000594 "\"In larval zebrafish, head stimulation generally elicits C-starts, while tail stimulation evokes both C- and S-starts.\"")
SubClassOf(obo:ACTAN_0000594 obo:ACTAN_0000569)
SubClassOf(obo:ACTAN_0000594 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001878))

# Class: obo:ACTAN_0000595 (routine turning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000595 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000595 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000595 "2025-02-10T14:11:19.544853Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"R-turn(ing): A slow spontaneous turn (20–30 ms) with a large bend angle (60 degrees) resulting in reorientation of the larva before forward swimming, prey capture; lacks the large counter-bend (shown in escape turns), with only a small portion of the tail bending; has a slow angular velocity with relatively slow turning angles.\"") oboInOwl:hasDefinition obo:ACTAN_0000595 "Turning that is spontaneous, resulting in reorientation, with a large bend angle, only a small portion of the tail bending, a slow angular velocity, and relatively slow turning angles.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000595 "R-turn")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1534/genetics.120.303539") oboInOwl:hasExactSynonym obo:ACTAN_0000595 "high-angle turn")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(rdfs:comment "2013"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000595 "slow turning"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") rdfs:label obo:ACTAN_0000595 "routine turning")
SubClassOf(obo:ACTAN_0000595 obo:ACTAN_0000174)
SubClassOf(obo:ACTAN_0000595 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002472))

# Class: obo:ACTAN_0000596 (labriform-drag-based gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000596 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000596 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000596 "2025-02-10T15:45:36.531962Z")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000596 "labriform movement")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1109/48.757275") Annotation(skos:scopeNote "\"Rowing action consists of two phases: the power stroke, when the fins move posteriorly perpendicular to the body at a high attack angle and with a velocity greater than the overall swimming speed, and a recovery stroke, when the fins are “feathered” to reduce resistance and brought forward.\"") oboInOwl:hasDefinition obo:ACTAN_0000596 "Oscillating gait that involves a power stroke, when the fins move posteriorly perpendicular to the body at a high attack angle and with a velocity greater than the overall swimming speed, and a recovery stroke, when the fins are feathered and brought forward.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000596 "drag based labriform mode")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000596 "scoot swimming"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasRelatedSynonym obo:ACTAN_0000596 "creeping")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000596 "rowing")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasRelatedSynonym obo:ACTAN_0000596 "slow swimming")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000596 "labriform-drag-based gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000596 "\"Larval zebrafish slow swimming (scoots) characterized by small bend angles with bend location near the tail. Maximal bending occurs close to the tail; low degree of bending and tail beat frequency; yaw angles are < 3 degrees; pectoral fins are active and alternate right to left between adduction and abduction.\"")
SubClassOf(obo:ACTAN_0000596 obo:ACTAN_0000020)
SubClassOf(obo:ACTAN_0000596 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000069))
SubClassOf(obo:ACTAN_0000596 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000642))
SubClassOf(obo:ACTAN_0000596 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000151))
SubClassOf(Annotation(dc:source "doi:10.1089/zeb.2012.0861") obo:ACTAN_0000596 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000688))

# Class: obo:ACTAN_0000597 (tail dipping)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000597 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000597 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000597 "2025-02-10T17:04:17.390795Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"An agonistic behavior during fighting, when one fish slightly drops its tail for a short period of time, to signal its submission and end the confrontation.\"") oboInOwl:hasDefinition obo:ACTAN_0000597 "Dipping which drops the tail for a short period of time.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000597 "dipping the tail")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000597 "tail dip")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000597 "head upward")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") rdfs:label obo:ACTAN_0000597 "tail dipping"@en)
AnnotationAssertion(Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") skos:example obo:ACTAN_0000597 "\"...Cleaner Wrasse Labroides dimidiatus...
...unusual mode of swimming of the wrasse, which oscillates the posterior part of its body up and down as if to attract attention...\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000597 "\"If badly harassed by another Badis badis, an adult will swim upward as a last resort. Then it usually stands in a corner (head down or up) or among plants (often head up). When a juvenile swims upward or forward in flight, the body normally swings down posteriorly at the end of the flight if the fish is not in contact with the substrate. The body angle, with respect to the bottom, ranges between 45° and 80°.\"")
SubClassOf(obo:ACTAN_0000597 obo:ACTAN_0000598)
SubClassOf(obo:ACTAN_0000597 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002415))

# Class: obo:ACTAN_0000598 (dipping movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000598 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000598 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000598 "2025-02-10T17:26:41.773068Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000598 "Movement that lowers an extremity.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000598 "dip")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000598 "dipping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000598 "dipping movement")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4084834") skos:example obo:ACTAN_0000598 "\"In dipping, a heron flying low above the water catches prey in the water while continuing in direct flight without hovering.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:scopeNote obo:ACTAN_0000598 "\"Tail dip (tail dipping): An agonistic behavior during fighting, when one fish slightly drops its tail for a short period of time, to signal its submission and end the confrontation.\"")
SubClassOf(obo:ACTAN_0000598 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000598 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001689))

# Class: obo:ACTAN_0000599 (thigmo-taxis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000599 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000599 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000599 "2025-02-10T19:38:24.554722Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/j.1365-3032.2009.00697.x") Annotation(skos:scopeNote "\"Thigmotaxis is defined as a locomotory response caused by the stimulus of touch.\"") oboInOwl:hasDefinition obo:ACTAN_0000599 "Taxis that responds to a touch stimulus.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") rdfs:label obo:ACTAN_0000599 "thigmo-taxis")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000599 "NBO:0000381")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1365-3032.2009.00697.x") skos:example obo:ACTAN_0000599 "\"It is clear that thigmotaxis can explain the maintenance of processions of late-instar O. lunifer caterpillars. The findings... reveal that the ability to be followed is more important for the maintenance of processions than the ability to follow.\"")
SubClassOf(obo:ACTAN_0000599 obo:ACTAN_0000368)
SubClassOf(obo:ACTAN_0000599 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000925))
SubClassOf(obo:ACTAN_0000599 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0003942))

# Class: obo:ACTAN_0000600 (size-up antagonism)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000600 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000600 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000600 "2025-02-10T20:06:47.457163Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000600 "Antagonism in which the larger of two adversaries is successful, without any fighting.

By displaying, not only is the size demonstrated but also the readiness to begin a fight.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000600 "size-up"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000600 "size-up antagonism")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000600 obo:ACTAN_0000906)
AnnotationAssertion(skos:broadMatch obo:ACTAN_0000600 "NBO:0020093")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10539-011-9297-8") skos:scopeNote obo:ACTAN_0000600 "\"Spiders confronted by a rival more than 10% bigger than them withdraw without a fight. Spiders signal their size to each other by plucking the web on which the confrontation takes place.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:scopeNote obo:ACTAN_0000600 "\"This behavior is common in fish species, and is likely related to the use of lateral line by fish to size-up the opponent by the waves generated by its movement.\"")
SubClassOf(obo:ACTAN_0000600 obo:ACTAN_0000385)
SubClassOf(obo:ACTAN_0000600 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000334))

# Class: obo:ACTAN_0000601 (hydrodynamics modality)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000601 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000601 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000601 "2025-02-10T20:07:29.164337Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasDefinition obo:ACTAN_0000601 "Modality that uses body movements to stimulate another animal's sensors, by the waves and wakes generated in the water.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"hydrodynamic signal\"") oboInOwl:hasExactSynonym obo:ACTAN_0000601 "hydrodynamics signal")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000601 "hydrodynamics modality")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000601 obo:UBERON_0002540)
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000601 "\"Some hypothesized that hydrodynamic signals in the krill propulsion jet might serve as a communication channel which could organize krill within a school.\"")
SubClassOf(obo:ACTAN_0000601 obo:ACTAN_0000117)
SubClassOf(obo:ACTAN_0000601 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001025))

# Class: obo:ACTAN_0000602 (anal-fin flexing)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000602 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000602 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000602 "2026-07-27T07:59:27.694893Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"Body in a horizontal position, dorsalis, analis and pelvics closed against the body, caudalis closed.\"") oboInOwl:hasDefinition obo:ACTAN_0000602 "Flexing that closes the anal fin against the body.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...analis and pelvics closed...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000602 "anal closing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000602 "anal-fin flexing"@en)
SubClassOf(obo:ACTAN_0000602 obo:ACTAN_0000732)
SubClassOf(obo:ACTAN_0000602 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_4000163))

# Class: obo:ACTAN_0000603 (stabilization look)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000603 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000603 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000603 "2025-02-10T21:23:07.489192Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Vestibulo-ocular reflex (VOR): Compensatory eye movements in zebrafish in response to linear/angular acceleration as well as changes in head position with respect to gravity, in order to stabilize the retinal image.\"") oboInOwl:hasDefinition obo:ACTAN_0000603 "Look in which eye movements compensate for linear and angular acceleration, and changes in head position with respect to gravity.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000603 "vestibulo-ocular-reflex"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000603 "stabilization look"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000603 "NBO:0000416")
AnnotationAssertion(Annotation(dc:source "https://www.ncbi.nlm.nih.gov/books/NBK10991/") skos:scopeNote obo:ACTAN_0000603 "\"For example, if the vestibulo-ocular reflex is tested with continuous rotation and without visual cues about the movement of the image (i.e.,with eyes closed or in the dark), the compensatory eye movements cease after only about 30 seconds of rotation. However, if the same test is performed with visual cues, eye movements persist. The compensatory eye movements in this case are due to the activation of the smooth pursuit system, which relies not on vestibular information but on visual cues indicating motion of the visual field.\"")
SubClassOf(obo:ACTAN_0000603 obo:ACTAN_0000318)
SubClassOf(obo:ACTAN_0000603 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000008))
SubClassOf(obo:ACTAN_0000603 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0002105))

# Class: obo:ACTAN_0000604 (behind-wing-zipping ethotype)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000604 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000604 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000604 "2025-09-03T10:24:31.725184Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000604 "Zipping in which the wing is lifted so that the secondaries are fanned out and the speculum exposed, the head being turned sideways so that the bill moves along the underside of the raised wing.

The bill moved quickly over the inside of the wing feathers may produce a rather loud sound. Usually the performing bird orientates its body side-on to the other bird.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000604 "preen-behind-wing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000604 "behind-wing-zipping ethotype"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000604 "\"In the Tufted Duck and Rosybill, it is the primaries which are rattled with the bill to produce the characteristic noise.\"")
SubClassOf(obo:ACTAN_0000604 obo:ACTAN_0000118)
SubClassOf(obo:ACTAN_0000604 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000083))
SubClassOf(obo:ACTAN_0000604 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000750))
SubClassOf(obo:ACTAN_0000604 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000024))

# Class: obo:ACTAN_0000605 (twisting movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000605 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000605 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000605 "2025-09-01T05:45:29.226251Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/j.1469-185X.2007.00029.x") Annotation(skos:scopeNote "\"We use twist and flexure as proposed by Lamb (1922): the former implies rotation along the longitudinal axis, the latter not.\"") oboInOwl:hasDefinition obo:ACTAN_0000605 "Movement that involves rotation along a longitudinal axis.")
AnnotationAssertion(Annotation(dc:date "2007"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") oboInOwl:hasExactSynonym obo:ACTAN_0000605 "torsion")
AnnotationAssertion(Annotation(dc:date "2007"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") oboInOwl:hasExactSynonym obo:ACTAN_0000605 "twist")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1367395") oboInOwl:hasExactSynonym obo:ACTAN_0000605 "twisting")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000605 "warping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000605 "twisting movement")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/1367395") skos:example obo:ACTAN_0000605 "\"...adult Java Sparrows (Puddu oryzivoru) use headtwisting as an aggressive display in supplanting attacks.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000605 "\"In N. leptocephalus, a female’s run was abrupt (ca. 3—5 cm) and ended as she arched her head upwards and twisted sagittally (strong retroflexure).\"")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(rdfs:comment "Breder (1926) severely criticised his many predecessors in, \"that so much of the work has been in the nature of abstract philosophical discussion and that relatively so little has been based upon actual experiment and study of living fishes.\" Without a source purporting to use actual observation data, I am loathe to enable an assertion of 'caudal/tail twisting' to be more than a narrow synonym of 'twisting movement'.") skos:scopeNote obo:ACTAN_0000605 "\"Pettigrew further writes that the mackerel twists its tail to such a degree as to be “very much after the manner of a screw in a steamship” and thus “to drill the water.” Observation confirms this in no way whatsoever...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000605 "\"the pre-copulatory \"Head-rolling\" of the Common Eider is linked with bathing and is probably derived from washing movements.\"")
SubClassOf(obo:ACTAN_0000605 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000605 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002445))

# Class: obo:ACTAN_0000606 (twist rotation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000606 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000606 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000606 "2025-09-01T05:45:56.900956Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000606 "Rotation that twisting culminates in.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000606 "twist"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000606 "twist rotation")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1469-185X.2007.00029.x") skos:example obo:ACTAN_0000606 "\"In Nabis, a pair of flaps covering the female genitalia may be either left over right (N. flavomarginatus) or right over left (N. limbatus), which is probably correlated with the twisted male abdomen...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000606 "\"What little thrust of a similar nature acts. to press Amiatus downward and Gymnotus upward on account of their dorsal and anal fins (with parallel rays) respectively, is inconsequential because of the difficulty of moving a streamline form at right angles to its intended direction... A slight twist of a fin, practically imperceptible to the eye, would readily offset any such action.\"")
SubClassOf(obo:ACTAN_0000606 obo:ACTAN_0000686)
SubClassOf(obo:ACTAN_0000606 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000605))

# Class: obo:ACTAN_0000607 (service forage)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000607 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000607 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000607 "2025-02-17T15:37:36.773675Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/s10071-014-0761-0") Annotation(skos:scopeNote "\"Cleaner wrasse occupy cleaning stations on coral outcrops and remove parasites and dead skin from the surface of client fish.\"") oboInOwl:hasDefinition obo:ACTAN_0000607 "Forage in which a cleaner cooperatively removes parasites and dead skin from the surface of a client.")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10071-014-0761-0") oboInOwl:hasExactSynonym obo:ACTAN_0000607 "cleaning"@en)
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10071-014-0761-0") oboInOwl:hasExactSynonym obo:ACTAN_0000607 "service")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasNarrowSynonym obo:ACTAN_0000607 "social grooming")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000607 "service forage")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000607 obo:ACTAN_0000582)
AnnotationAssertion(Annotation(dc:contributor "doi:10.1007/s10071-014-0761-0") skos:example obo:ACTAN_0000607 "\"Cleaner wrasse occupy cleaning stations on coral outcrops and remove parasites and dead skin from the surface of client fish.\"")
SubClassOf(obo:ACTAN_0000607 obo:ACTAN_0000353)
SubClassOf(obo:ACTAN_0000607 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000582))

# Class: obo:ACTAN_0000608 (reconciliation influence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000608 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000608 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000608 "2025-02-17T15:39:48.479199Z")
AnnotationAssertion(Annotation(dc:contributor "doi:10.1163/1568539X-00003176") Annotation(skos:scopeNote "\"It is known that friendly reunions of opponents soon after an aggressive interaction (reconciliations) are less likely to occur in the context of feeding.\"") oboInOwl:hasDefinition obo:ACTAN_0000608 "Influence which reunites opponents soon after an aggressive interaction.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000608 "reconciliation"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000608 "reconciliation influence")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000608 "NBO:0000296")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10071-014-0761-0") skos:example obo:ACTAN_0000608 "\"But the cleaner has a mode of reconciliation; they chase after the distraught client and give them a back rub, thus enticing them to come again.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000608 "\"Chimpanzees...
Two adult males embrace ventro-ventrally and bipedally in the context of reassurance or reconciliation, and one of the males may thrust against another.\"")
SubClassOf(obo:ACTAN_0000608 obo:ACTAN_0000438)
SubClassOf(obo:ACTAN_0000608 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000326))

# Class: obo:ACTAN_0000609 (groom comfort)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000609 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000609 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000609 "2025-02-17T15:42:14.186579Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasDefinition obo:ACTAN_0000609 "Comfort which relieves irritation, and removes ectoparasites, debris, and dirt.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000609 "cleaning")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000609 "grooming"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000609 "groom comfort"@en)
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000609 "NBO:0000027")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/41.2.137") skos:scopeNote obo:ACTAN_0000609 "\"Several species were suggested to incorporate unpredictable pauses in their escape movements, including psychodid flies, fleas evading grooming hosts, and gray squirrels confronted by cars (and presumably natural predators)...\"")
SubClassOf(obo:ACTAN_0000609 obo:ACTAN_0000708)
SubClassOf(obo:ACTAN_0000609 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000096))

# Class: obo:ACTAN_0000610 (auto groom)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000610 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000610 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000610 "2025-02-17T15:57:52.927271Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/tops.12554") Annotation(skos:scopeNote "\"Although 80% of the tooling submodes consist of allocentric actions, remarkably the nonprimate mammals, which had a limited number of tooling cases, had a greater proportion of egocentric submodes: self-grooming was their most common purpose for tooling.\"") oboInOwl:hasDefinition obo:ACTAN_0000610 "Groom that is egocentric.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000610 "autogrooming"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000610 "groom self")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000610 "self groom")
AnnotationAssertion(Annotation(dc:date "1948"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5252&context=wilson_bulletin") oboInOwl:hasNarrowSynonym obo:ACTAN_0000610 "preening")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000610 "auto groom"@en)
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000610 "NBO:0000451")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000610 "\"Oiling preening...
Nibbling preening...
Washing: Preening...

...social preening may be functional as a grooming technique...\"\"")
SubClassOf(obo:ACTAN_0000610 obo:ACTAN_0000609)
SubClassOf(obo:ACTAN_0000610 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000398))

# Class: obo:ACTAN_0000611 (invitation groom)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000611 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000611 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000611 "2025-02-17T16:01:36.205702Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/beheco/aru194") oboInOwl:hasDefinition obo:ACTAN_0000611 "Groom in which another is enabled to provide the service.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000611 "invitation")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000611 "presentation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000611 "invitation groom")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000611 obo:ACTAN_0000613)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/beheco/aru194") skos:example obo:ACTAN_0000611 "\"The assumptions of the model were explicitly based on marine cleaning mutualism involving the cleaner wrasse Labroides dimidiatus (the service provider), which feeds on the ectoparasites of other reef fishes (the clients).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000611 "\"Two Whistling Ducks may be preening normally side by side when one will approach the other and either begin nibbling the other's head or present its own head to be nibbled. In the posture of presentation, the eyes are partly or completely closed and the head is stretched out toward the other bird and held rigid in one position.\"")
SubClassOf(obo:ACTAN_0000611 obo:ACTAN_0000609)
SubClassOf(obo:ACTAN_0000611 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000828))

# Class: obo:ACTAN_0000612 (stationing residence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000612 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000612 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000612 "2025-02-17T16:05:07.159769Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/s00227-014-2403-0") oboInOwl:hasDefinition obo:ACTAN_0000612 "Residence that is static, parallel to a surface.

Propulsion is not always required.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000612 "posting")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00227-014-2403-0") oboInOwl:hasExactSynonym obo:ACTAN_0000612 "station-holding")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") Annotation(rdfs:comment "2000"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000612 "stationing"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000612 "headquartering")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000612 "standing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000612 "stationing residence"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000612 obo:ACTAN_0000311)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000612 "\"\"Headquarters\" are also known in other territorial animals;... EVANS found them in the lizard Anolis sagrei, where they chiefly serve as observation-posts.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10071-014-0761-0") skos:example obo:ACTAN_0000612 "\"Cleaner wrasse occupy cleaning stations on coral outcrops...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/41.2.137") skos:example obo:ACTAN_0000612 "\"Intermittent locomotion... occurs in water striders holding station in the current.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/jfb.12866") skos:scopeNote obo:ACTAN_0000612 "\"A fish was determined to be hunkering if it was able to maintain station by adhering to the bottom of the tunnel without body or caudal fin undulation.\"")
SubClassOf(obo:ACTAN_0000612 obo:ACTAN_0000308)
SubClassOf(obo:ACTAN_0000612 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002272))

# Class: obo:ACTAN_0000613 (clean-me ethotype)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000613 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000613 "2025-02-17T16:12:44.835491Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10071-014-0761-0") Annotation(skos:scopeNote "\"The clients present themselves and perform a ‘‘clean me’’ stance which signals to the cleaner that they require a good service.\"") oboInOwl:hasDefinition obo:ACTAN_0000613 "Ethotype in which clients present themselves and perform a stance which signals to the cleaner that they require a service.")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10071-014-0761-0") oboInOwl:hasExactSynonym obo:ACTAN_0000613 "clean-me"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:comment obo:ACTAN_0000613 "If a relevant ontology is developed, this would become a subtype of a maintenance ethotype.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000613 "clean-me ethotype"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000613 obo:ACTAN_0000607)
SubClassOf(obo:ACTAN_0000613 obo:ACTAN_0000118)
SubClassOf(obo:ACTAN_0000613 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000317))

# Class: obo:ACTAN_0000614 (priority assessment)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000614 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000614 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000614 "2025-02-17T16:22:16.695868Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Linguistic inference.") oboInOwl:hasDefinition obo:ACTAN_0000614 "Assessment that involves planning.")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10071-014-0761-0") oboInOwl:hasExactSynonym obo:ACTAN_0000614 "prioritisation"@en)
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1177/1745691610369469") oboInOwl:hasExactSynonym obo:ACTAN_0000614 "prioritization")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasExactSynonym obo:ACTAN_0000614 "priority")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000614 "priority assessment")
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:example obo:ACTAN_0000614 "\"For instance, in mammals, a risk of predation suppresses roaming when well-fed, but extreme hunger overrides danger perception and results in prioritizing food-seeking behavior.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10071-014-0761-0") skos:scopeNote obo:ACTAN_0000614 "\"If there are a number of clients waiting to be serviced, cleaner fish will prioritise transients, knowing that the locals have nowhere else to go.\"")
SubClassOf(obo:ACTAN_0000614 obo:ACTAN_0000334)
SubClassOf(obo:ACTAN_0000614 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MF_0000027))

# Class: obo:ACTAN_0000615 (cheat deception)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000615 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000615 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000615 "2025-02-17T16:23:05.960577Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/beheco/12.5.534") oboInOwl:hasDefinition obo:ACTAN_0000615 "Deception in which trust is broken.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/beheco/12.5.534") oboInOwl:hasExactSynonym obo:ACTAN_0000615 "cheat"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10539-011-9297-8") Annotation(rdfs:comment "2012"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000615 "defection")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000615 "cheat deception")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10071-014-0761-0") skos:example obo:ACTAN_0000615 "\"Cleaners are also partial to cheating and occasionally they nip the skin of clients to obtain a cheap meal. It is perhaps not surprising that they are far less inclined to perform this behaviour if the client is a predator.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10071-014-0761-0") skos:scopeNote obo:ACTAN_0000615 "\"If a pair of fish inspects a predator, they glide back and forth as they advance towards the predator each taking it in turn to lead. If a partner should defect or cheat in any way, perhaps by hanging back, the other fish will refuse to cooperate with that individual on future encounters.\"")
SubClassOf(obo:ACTAN_0000615 obo:ACTAN_0000458)
SubClassOf(obo:ACTAN_0000615 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000553))

# Class: obo:ACTAN_0000616 (adhesion kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000616 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000616 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000616 "2025-02-18T12:34:46.797261Z")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "ISBN:9781482294347") oboInOwl:hasBroadSynonym obo:ACTAN_0000616 "attachment"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000616 "hold fast")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"The head is still fixed to the substrate with the adhesive organs...\"") oboInOwl:hasDefinition obo:ACTAN_0000616 "Kinetics activity which fixes to a substrate.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000616 "adhesion")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasRelatedSynonym obo:ACTAN_0000616 "appress")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000616 "adhesion kinetics")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000616 "\"Aequidens latifrons...
On the foremost part of the head, that lies in this stage closely against the yolk, two adhesive organs are situated one behind the other. They produce a mucoid secrete by which the larva attaches itself to the substrate (sand, plants etc.).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") skos:example obo:ACTAN_0000616 "\"The body wall of Metridium may be divided into three functional regions which are to some extent independent of each other... The region of the pedal disk is concerned with adhesion and locomotion.\"")
SubClassOf(obo:ACTAN_0000616 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000616 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001431))

# Class: obo:ACTAN_0000617 (waiting timing)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000617 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000617 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000617 "2025-02-18T17:05:56.987892Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1098/rspb.2013.2997") oboInOwl:hasDefinition obo:ACTAN_0000617 "Timing that has a pattern related to the predictability of, value of, and competition for, a resource.")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasExactSynonym obo:ACTAN_0000617 "waiting"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000617 "waiting timing")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000617 obo:ACTAN_0000311)
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rspb.2013.2997") skos:example obo:ACTAN_0000617 "\"...predators capable of waiting for long periods (e.g. L. piscatorius...) choose to target active (high-energy density) prey that are encountered less frequently because they are more sparsely distributed, or lower in abundance, but that when captured yield a greater net energy gain than more frequent captures of more numerous but less energy-rich prey.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10071-014-0761-0") skos:example obo:ACTAN_0000617 "\"If there are a number of clients waiting to be serviced, cleaner fish will prioritise transients, knowing that the locals have nowhere else to go.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:example obo:ACTAN_0000617 "\"Thus it is possible that the \"coyness\" of females sometimes represents waiting for a signal that a dominant male's approach will lead to copulation rather than attack...\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000617 "NBO:0000459")
SubClassOf(obo:ACTAN_0000617 obo:ACTAN_0001030)
SubClassOf(obo:ACTAN_0000617 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MF_0000060))
SubClassOf(obo:ACTAN_0000617 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000487))

# Class: obo:ACTAN_0000618 (ambush hunt)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000618 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000618 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000618 "2025-02-18T17:06:19.054679Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/beheco/12.5.534") Annotation(skos:scopeNote "\"Azteca ants not only overpower prey as groups, but they stealthily ambush prey by lining themselves along the underside margin of leaves and waiting for prey to land on the upper side of the leaf.\"") oboInOwl:hasDefinition obo:ACTAN_0000618 "Hunt that involves stealthy waiting.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") oboInOwl:hasExactSynonym obo:ACTAN_0000618 "ambush"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000618 "ambush hunt"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000618 "NBO:0015000")
AnnotationAssertion(Annotation(dc:source "doi:10.11369/jji1950.34.76") skos:example obo:ACTAN_0000618 "\"The four kills (two by Synodus ulae and two by Scorpaenopsis cirrhosa) were from short ambush attacks (2-10cm) on bobbing labrids that approached too close within the algae to the well camouflaged predators.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rspb.2013.2997") skos:scopeNote obo:ACTAN_0000618 "\"In a foraging context, for example, how long an ambush predator waits in a particular location in the absence of prey encounters before energy is expended in moving to a new location will have an important impact on positive energy balance and hence growth rate.\"")
SubClassOf(obo:ACTAN_0000618 obo:ACTAN_0000358)
SubClassOf(obo:ACTAN_0000618 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000617))

# Class: obo:ACTAN_0000619 (hunker stationing)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000619 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000619 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000619 "2025-02-19T21:39:50Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/jfb.12866") oboInOwl:hasDefinition obo:ACTAN_0000619 "Stationing that minimises exposure to current, by streamlined adherence to substrate, without body or appendage movement.")
AnnotationAssertion(Annotation(dc:date "2016"^^xsd:decimal) Annotation(dc:source "doi:10.1111/jfb.12866") oboInOwl:hasExactSynonym obo:ACTAN_0000619 "hunkering")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000619 "clinging")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000619 "hunker stationing")
SubClassOf(obo:ACTAN_0000619 obo:ACTAN_0000612)
SubClassOf(obo:ACTAN_0000619 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000616))
SubClassOf(obo:ACTAN_0000619 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000643))

# Class: obo:ACTAN_0000620 (expansion placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000620 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000620 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000620 "2025-02-24T14:43:19.420526Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000620 "Placement that results from expanding.")
AnnotationAssertion(Annotation(rdfs:comment "Directly inferred.") rdfs:label obo:ACTAN_0000620 "expansion placement"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000620 obo:ACTAN_0000744)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") skos:example obo:ACTAN_0000620 "\"Most burrowing bivalves differ from Divaricella in that their foot is larger and stronger. Their burrowing method consists of a cycle of push-pull movements. At first, the valves resist back-slippage by opening against the sediment while the foot digs downward . Once the foot expands to gain a hold within the sediment, the valves are slightly adducted to release their grip against the substrate, and the pedal retractor muscles contract, dragging the shell downward.\"")
SubClassOf(obo:ACTAN_0000620 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000620 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000744))

# Class: obo:ACTAN_0000621 (retraction placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000621 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000621 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000621 "2025-02-24T14:44:58.249949Z")
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000621 "Placement that results from retracting.")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000621 "retraction")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasRelatedSynonym obo:ACTAN_0000621 "flexed")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000621 "folded")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000621 "pressed down")
AnnotationAssertion(Annotation(rdfs:comment "Directly inferred.") rdfs:label obo:ACTAN_0000621 "retraction placement")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000621 "\"Can we consider the sting of the wasp or of the bee as perfect, which, when used against many attacking animals, cannot be withdrawn, owing to the backward serratures, and so inevitably causes the death of the insect by tearing out its viscera?\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.120.1.283") skos:example obo:ACTAN_0000621 "\"The left appendages are folded over the right at the mouth of the shell forming a 'false operculum'.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:scopeNote obo:ACTAN_0000621 "\"—the manner in which the wings of insects are folded—\"")
SubClassOf(obo:ACTAN_0000621 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000621 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000736))

# Class: obo:ACTAN_0000622 (telescoping expanding)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000622 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000622 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000622 "2025-02-24T14:46:31.558124Z")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1073/pnas.2122563119") oboInOwl:hasBroadSynonym obo:ACTAN_0000622 "telescoping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1073/pnas.2122563119") oboInOwl:hasDefinition obo:ACTAN_0000622 "Expanding which unsheathes one layer stacked inside another resulting in overall lengthening.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1073/pnas.2122563119") oboInOwl:hasExactSynonym obo:ACTAN_0000622 "extend like a telescope")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1073/pnas.2122563119") oboInOwl:hasExactSynonym obo:ACTAN_0000622 "telescopic elongation")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1073/pnas.2122563119") oboInOwl:hasRelatedSynonym obo:ACTAN_0000622 "unsheathe")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000622 "telescoping expanding")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000622 obo:ACTAN_0000741)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000622 obo:ACTAN_0000742)
AnnotationAssertion(Annotation(dc:source "doi:10.1073/pnas.2122563119") skos:example obo:ACTAN_0000622 "\"The chameleon tongue may have evolved telescoping motion to increase the accuracy of striking a target. Chameleons unsheathe the 10 stacked muscle layers in their tongue to reach far-reaching objects.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1073/pnas.2122563119") skos:scopeNote obo:ACTAN_0000622 "\"Telescopic elongation may reduce energy use for elephants because of the trunk’s tapered shape.\"")
SubClassOf(obo:ACTAN_0000622 obo:ACTAN_0000744)
SubClassOf(obo:ACTAN_0000622 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001154))
SubClassOf(obo:ACTAN_0000622 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002313))

# Class: obo:ACTAN_0000623 (shrivelling contracting)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000623 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000623 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000623 "2025-02-24T14:47:38.64406Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasDefinition obo:ACTAN_0000623 "Contracting which temporarily causes extreme fluid loss and firm overlying rugosity.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000623 "shrivelling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000623 "shrivelling contracting"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") skos:example obo:ACTAN_0000623 "\"Metridium...
The maximum rate at which water can be taken in by the siphonoglyph in the intact animal may be hard to measure directly. But a peculiar activity of the anemone permits an indirect estimate to be made. At intervals after feeding, and in a starved animal even at other times for unassignable reasons, the whole body ' shrivels' and empties itself of water.\"")
SubClassOf(obo:ACTAN_0000623 obo:ACTAN_0000743)
SubClassOf(obo:ACTAN_0000623 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001359))

# Class: obo:ACTAN_0000624 (splay placement)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000624 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000624 "2025-03-11T17:51:29.921661Z")
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000624 "Placement that results from splaying.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000624 "fanned")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000624 "more or less spread")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac061") oboInOwl:hasExactSynonym obo:ACTAN_0000624 "splay")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000624 "splayed"@en)
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10228-002-0153-3") oboInOwl:hasNarrowSynonym obo:ACTAN_0000624 "spread wide")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000624 "tautly spread")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000624 "extended")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000624 "splay placement")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/20.1.255") skos:example obo:ACTAN_0000624 "\"...most tetrapods trot (if they run at all), and those with... legs splayed to the side (lizards) have no other running symmetrical gait.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac061") skos:example obo:ACTAN_0000624 "\"Hawkfishes are most often found perching and moving on structures in their environments. During perching, the free ventral rays are in contact with the substrate and splayed.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000624 "\"The [chimpanzee] male sits with thighs splayed and penile erection, looking toward a female in estrus. Sometimes his hair is erect...\"")
SubClassOf(obo:ACTAN_0000624 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000624 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000083))

# Class: obo:ACTAN_0000625 (contraction placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000625 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000625 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000625 "2025-02-24T22:49:44.97863Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000625 "Placement that results from contracting.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.27.3.264") oboInOwl:hasExactSynonym obo:ACTAN_0000625 "contracted"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000625 "contraction placement"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.27.3.264") skos:example obo:ACTAN_0000625 "\"Metridium senile is notable for the variety of shapes which it assumes. It may be fully expanded with a narrow or with a wide column. The same anemone may next day be found contracted down to a mere button-like object. It may indulge in a variety of contortions in which it is laterally bent, or possesses deep transverse constrictions locally or completely embracing the column. The whole anemone may on occasion temporarily assume a shrivelled and contracted condition...\"")
SubClassOf(obo:ACTAN_0000625 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000625 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000743))

# Class: obo:ACTAN_0000626 (deimatism passivity)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000626 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000626 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000626 "2025-03-05T21:36:06.477212Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/brv.12891") Annotation(skos:scopeNote "\"Given the overall lack of clarity, but considering the main conceptual points from previous contributions to the field, we suggest the following hypothesis for what constitutes deimatic behaviour: a behaviour performed by a target different from fleeing and retaliation that is triggered by it perceiving threat from an attacker during approach or subjugation, and which can trigger an unlearned avoidance response in the attacker causing it to slow or stop its attack.\"") oboInOwl:hasDefinition obo:ACTAN_0000626 "Passivity that triggers an unlearned avoidance response in the attacker, causing it to slow or stop its attack.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1111/brv.12891") oboInOwl:hasExactSynonym obo:ACTAN_0000626 "deimatic behaviour")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1111/brv.12891") oboInOwl:hasExactSynonym obo:ACTAN_0000626 "deimatism"@en)
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1111/brv.12891") oboInOwl:hasRelatedSynonym obo:ACTAN_0000626 "startle behaviour")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000626 "deimatism passivity"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12891") skos:example obo:ACTAN_0000626 "\"The ‘unken reflex’, named after the fire-bellied toads ‘Feuerunke’ (Löhner, 1919), is a proximate cause of deimatic behaviour but little is known about its mechanistic underpinnings. Typically only applied to amphibians, it manifests as a rigid arching or lifting of the body, legs, and/or tail in which ventral surfaces become visible and sometimes body parts are ‘hypnotically’ swayed.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000626 "NBO:0020117")
SubClassOf(obo:ACTAN_0000626 obo:ACTAN_0000373)
SubClassOf(obo:ACTAN_0000626 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000428))

# Class: obo:ACTAN_0000627 (substrate-skim regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000627 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000627 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000627 "2025-03-10T20:57:44.268157Z")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasBroadSynonym obo:ACTAN_0000627 "skimming")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/jfb.12866") Annotation(skos:scopeNote "\"Fish that were substratum-skimming (ventrally pressed against the bottom of the lume with active caudal undulation) were not considered to be hunkering.\"") oboInOwl:hasDefinition obo:ACTAN_0000627 "Interfacing-regime that presses against the aqueous-substrate boundary, while actively propelling.")
AnnotationAssertion(Annotation(dc:date "2016"^^xsd:decimal) Annotation(dc:source "doi:10.1111/jfb.12866") oboInOwl:hasExactSynonym obo:ACTAN_0000627 "substratum skimming"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(rdfs:seeAlso obo:ACTAN_0000476) oboInOwl:hasRelatedSynonym obo:ACTAN_0000627 "pseudofertilizing")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(rdfs:seeAlso obo:ACTAN_0000477) oboInOwl:hasRelatedSynonym obo:ACTAN_0000627 "pseudolaying")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000627 "substrate-skim regime")
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0000627 "\"...South American cichlid Laetacara araguaiae...

The female followed a circular path, pressed the belly against the substrate and vibrated the posterior portion of the body when entering in the nest.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000627 "\"Cichlasoma severum...
After having practised some very intensive nipping-off movements, the female for the first time shows an incomplete skimming movement. Then the male too begins \"pseudofertlizing\".\"")
SubClassOf(obo:ACTAN_0000627 obo:ACTAN_0000086)
SubClassOf(obo:ACTAN_0000627 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000104))
SubClassOf(obo:ACTAN_0000627 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000671))
SubClassOf(obo:ACTAN_0000627 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000183))
SubClassOf(obo:ACTAN_0000627 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000893))
SubClassOf(obo:ACTAN_0000627 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

# Class: obo:ACTAN_0000628 (grip kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000628 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000628 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000628 "2025-03-11T09:29:52.293806Z")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000628 "hold fast")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/brv.12010") oboInOwl:hasDefinition obo:ACTAN_0000628 "Kinetics that holds an object using voluntary movements, by exerting force.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000628 "clinging")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000628 "grasping"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000628 "grip")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000628 "grip kinetics")
AnnotationAssertion(Annotation(dc:source "doi:10.1073/pnas.2122563119") skos:example obo:ACTAN_0000628 "\"Penguins have spines only on their dorsal tongue, which allow them to better grip and swallow slippery fish.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac061") skos:example obo:ACTAN_0000628 "\"The benthic longhorn sculpin demonstrates different use of dorsal and ventral fin regions during both station holding and swimming behaviors. During station holding, the ventral pectoral fin rays are splayed and contact the bottom surface of the tank, anterior to the dorsal region of the fin, and are believed to be to be gripping the bottom.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1073/pnas.2122563119") skos:scopeNote obo:ACTAN_0000628 "\"Octopus arms have suction-cup grippers only on the ventral side.\"")
SubClassOf(obo:ACTAN_0000628 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000628 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001035))

# Class: obo:ACTAN_0000629 (perch stationing)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000629 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000629 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000629 "2025-03-11T09:41:03.574286Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/brv.12010") oboInOwl:hasDefinition obo:ACTAN_0000629 "Stationing that holds onto an exposed substrate, without body or appendage movement.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000629 "perch")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000629 "perching"@en)
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000629 "take-off platform")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000629 "perch stationing")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac061") skos:example obo:ACTAN_0000629 "\"Hawkfishes are most often found perching and moving on structures in their environments.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000629 "\"Sicydium salvini and other forms with united ventrals by employing them as a sucker are enabled to remain in one place in a strong flow without active muscular effort.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/ajpa.1330870108") skos:scopeNote obo:ACTAN_0000629 "\"Fruit found in small trees was harvested most often by squatting, perhaps because the trunk itself was the largest and most stable perch from which to feed.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") skos:scopeNote obo:ACTAN_0000629 "\"Thus the lizards are found higher wherever their favored perches are distributed higher in the vegetation.\"")
SubClassOf(obo:ACTAN_0000629 obo:ACTAN_0000612)
SubClassOf(obo:ACTAN_0000629 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001688))

# Class: obo:ACTAN_0000630 (adduction placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000630 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000630 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000630 "2025-03-11T17:51:47.181562Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000630 "Placement that results from adducting.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000630 "adducted"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000630 "clamped down")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000630 "laid against")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasRelatedSynonym obo:ACTAN_0000630 "pressed against")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000630 "tucked")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000630 "adduction placement")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.204.8.1459") skos:scopeNote obo:ACTAN_0000630 "\"Pectoral fin-beat cycles started with the fins pressed against the body (maximally adducted), moving away (abducting) from the body to some maximum point of excursion and returning (adducting) to the original position.\"")
SubClassOf(obo:ACTAN_0000630 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000630 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000739))

# Class: obo:ACTAN_0000631 (labriform-lift-based gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000631 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000631 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000631 "2025-03-17T21:05:19.794934Z")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000631 "labriform movement"@en)
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1109/48.757275") Annotation(skos:scopeNote "\"As a result, in lift-based labriform mode, for the pectoral fins to propel the fish forward, they have to move up and down in a plane that is roughly perpendicular to the main axis of the fish’s body. This implies that no recovery stroke is necessary and lift can be generated during both the upstroke and the downstroke.\"") oboInOwl:hasDefinition obo:ACTAN_0000631 "Oscillating gait in which the pectoral fins move up and down in a plane that is roughly perpendicular to the main axis of the fish’s body.

No recovery stroke is necessary and lift can be generated during both the upstroke and the downstroke.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000631 "lift based labriform mode")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasExactSynonym obo:ACTAN_0000631 "pectoral sculling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000631 "labriform-lift-based gait")
SubClassOf(obo:ACTAN_0000631 obo:ACTAN_0000020)
SubClassOf(obo:ACTAN_0000631 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000069))
SubClassOf(obo:ACTAN_0000631 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000637))
SubClassOf(obo:ACTAN_0000631 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000151))
SubClassOf(obo:ACTAN_0000631 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000695))

# Class: obo:ACTAN_0000632 (balistiform gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000632 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000632 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000632 "2025-03-17T21:25:42.669116Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"That form of localized anguilliform and intermediate undulation found in the dorsal and anal of the Balistidae (Balistes). The angular divergence of the two fins from the horizontal is complementary, reducing the reactance to a horizontal resultant.\"") oboInOwl:hasDefinition obo:ACTAN_0000632 "Ribbon-undulation gait that involves both the dorsal and anal fins.

The angular divergence of the two fins from the horizontal is complementary, reducing the reactance to a horizontal resultant.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000632 "balistiform locomotion")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000632 "balistiform movement"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"Balistiform. That form of localized anguilliform and intermediate undulation...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000632 "balistiform undulation")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000632 "balistiform gait"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000632 obo:ACTAN_0000953)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.194704") skos:example obo:ACTAN_0000632 "\"...the small, short median fins of R. aculeatus are sufficient for slow grazing using balistiform locomotion...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:example obo:ACTAN_0000632 "\"This is seen mainly in the family Balistidae (e.g., the trigger fish). A typical characteristic is that their median fins are usually inclined relative to each other, while the body is usually flat and compressed laterally.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.194704") skos:scopeNote obo:ACTAN_0000632 "\"Species with long, large median fins and wide caudal peduncles used the balistiform gait alone for a larger percentage of their total critical swimming speed...\"")
SubClassOf(obo:ACTAN_0000632 obo:ACTAN_0000016)
SubClassOf(obo:ACTAN_0000632 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0003097))
SubClassOf(obo:ACTAN_0000632 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_4000163))
SubClassOf(obo:ACTAN_0000632 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000695))

# Class: obo:ACTAN_0000633 (tetraodontiform gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000633 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000633 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000633 "2025-03-17T21:26:48.086798Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/s10228-002-0153-3") Annotation(skos:scopeNote "\"As in other puffers, but not as in other multipropulsor swimmers, such as the boxfish Ostracion meleagris, all fins (pectorals, anal and dorsal, and caudal at higher speeds) moved in synchronization at all swimming speeds. This pattern was also observed when puffers hovered slowly in calm water.\"") oboInOwl:hasDefinition obo:ACTAN_0000633 "Oscillating gait in which all fins (pectorals, anal and dorsal, and caudal at higher speeds) move in synchronization at all swimming speeds, including hovering.

Left and right pectoral fins alternate phases; when anal and dorsal fins travel from right to left, the left pectoral fin adducts and the right pectoral fin abducts.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000633 "tetraodontiform movement")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:ACTAN_0000633 "localized ostraciiform motion")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000633 "tetraodontiform gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000633 "\"Lagocephalus laevigatus most frequently fans its dorsal and anal from side to side (localized ostraciiform motion) in unison, but occasionally alternates them.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10228-002-0153-3") skos:example obo:ACTAN_0000633 "\"Tetraodon schoutedeni swim very steadily at all the swimming speeds of their range, with no changes of angle of attack during any given swimming speed. Ranges of angle of attack (0–4°) were smaller than reported for larger puffers (3–10°). Yaw, roll, and pitch were not detectable in T. schoutedeni, similar to other puffers. However, Hove et al. (2001) reported pitch (up to 5°) and yaw (up to 6°) in boxfish. This result suggests that puffers swim more steadily than boxfish, probably because of their highly synchronized fin movements.\"")
SubClassOf(obo:ACTAN_0000633 obo:ACTAN_0000020)
SubClassOf(obo:ACTAN_0000633 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000069))
SubClassOf(obo:ACTAN_0000633 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000151))
SubClassOf(obo:ACTAN_0000633 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0003097))
SubClassOf(obo:ACTAN_0000633 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_4000163))
SubClassOf(obo:ACTAN_0000633 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000695))

# Class: obo:ACTAN_0000634 (pitching gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000634 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000634 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000634 "2025-03-18T08:15:37.103958Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1088/1748-3182/9/1/011001") Annotation(skos:scopeNote "\"This lift based technique is proven to achieve higher propulsive efficiency than drag based propulsion mechanisms.\"") oboInOwl:hasDefinition obo:ACTAN_0000634 "Flying-gait which is lift-based.

This results in smaller variations in speed.")
AnnotationAssertion(Annotation(dc:date "2017"^^xsd:decimal) Annotation(dc:source "doi:10.1017/jfm.2017.173") Annotation(rdfs:comment "Note that this source uses this term in a broader sense (appendages rotating about their leading edge to attain continuous horizontal thrust) although it retains a focus on wings, whereas we are allowing sufficient up and down to allow for vertical thrust.") rdfs:label obo:ACTAN_0000634 "pitching gait")
SubClassOf(obo:ACTAN_0000634 obo:ACTAN_0000075)
SubClassOf(obo:ACTAN_0000634 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000421))
SubClassOf(obo:ACTAN_0000634 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000534))
SubClassOf(obo:ACTAN_0000634 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000068))
SubClassOf(obo:ACTAN_0000634 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000637))

# Class: obo:ACTAN_0000635 (heaving gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000635 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000635 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000635 "2025-03-18T09:00:48.13245Z")
AnnotationAssertion(Annotation(rdfs:comment "NB: The quote is about lift based mechanisms, but in this case we are using its reference to the alternative.") Annotation(rdfs:isDefinedBy "doi:10.1088/1748-3182/9/1/011001") Annotation(skos:scopeNote "\"This lift based technique is proven to achieve higher propulsive efficiency than drag based propulsion mechanisms.\"") oboInOwl:hasDefinition obo:ACTAN_0000635 "Flying-gait which is drag based.

This results in larger variations in speed.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000635 "rowing")
AnnotationAssertion(Annotation(dc:date "2017"^^xsd:decimal) Annotation(dc:source "doi:10.1017/jfm.2017.173") Annotation(rdfs:comment "Note that this source uses this term in a broader sense (appendages going up and down) although it retains a focus on wings, whereas we are adding a measure of rotation (the rowing pattern) to allow for feathering.") rdfs:label obo:ACTAN_0000635 "heaving gait")
SubClassOf(obo:ACTAN_0000635 obo:ACTAN_0000075)
SubClassOf(obo:ACTAN_0000635 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000421))
SubClassOf(obo:ACTAN_0000635 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000535))
SubClassOf(obo:ACTAN_0000635 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000068))
SubClassOf(obo:ACTAN_0000635 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000642))

# Class: obo:ACTAN_0000636 (undulation pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000636 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000636 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000636 "2025-03-18T21:40:45.570303Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasDefinition obo:ACTAN_0000636 "Gait pattern in which alternating bends are propagated along a continuous structure, as all points along it move simultaneously and have sliding contact where they touch their surroundings.

This may involve the entire animal, or a longitudinal structure.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000636 "undulation"@en)
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasNarrowSynonym obo:ACTAN_0000636 "axial undulating")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasNarrowSynonym obo:ACTAN_0000636 "body undulating")
AnnotationAssertion(Annotation(dc:date "2025"^^xsd:decimal) Annotation(dc:source "https://www.academia.edu/145444084/The_Figure_8_Pattern_Across_Natural_Systems_A_Critical_Examination_of_Convergent_Geometry") rdfs:label obo:ACTAN_0000636 "undulation pattern")
SubClassOf(obo:ACTAN_0000636 obo:ACTAN_0000126)
SubClassOf(obo:ACTAN_0000636 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001242))

# Class: obo:ACTAN_0000637 (sculling pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000637 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000637 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000637 "2025-03-23T11:49:33.644243Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1017/jfm.2017.173") Annotation(skos:scopeNote "\"In the pitching gait, the wing is flapped or pivoted about its leading edge.\"") oboInOwl:hasDefinition obo:ACTAN_0000637 "Flap pattern in which the propulsor is pivoted about its leading edge.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000637 "sculling"@en)
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/36.6.555") oboInOwl:hasRelatedSynonym obo:ACTAN_0000637 "oscillating"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasRelatedSynonym obo:ACTAN_0000637 "pitching")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000637 "sculling pattern")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/BF01609520") skos:example obo:ACTAN_0000637 "\"Interestingly, Clepticus, the plankton-picking wrasse, continues to swim like a labrid with \"pectoral sculling\" in normal swimming.\"")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:scopeNote obo:ACTAN_0000637 "\"In slow starting, the fish appears to change the pitch of the sculling pectoral fins slightly, directing the water current to the rear.\"")
SubClassOf(obo:ACTAN_0000637 obo:ACTAN_0000529)
SubClassOf(obo:ACTAN_0000637 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000161))

# Class: obo:ACTAN_0000638 (ostraciiform-MPF gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000638 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000638 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000638 "2025-03-23T21:11:12.432678Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1242/jeb.204.8.1459") oboInOwl:hasDefinition obo:ACTAN_0000638 "Oscillating gait in which propulsion is produced by asynchronous use of the anal fin and each pectoral fin.

At low speeds (Pectoral/anal-fin-dominant, or PA), the pectoral fins move with no apparent pattern, and the anal fin moves at low frequency, with relatively uniform amplitude. Higher speeds (Anal/dorsal-fin-dominant, or AD) reveal an asynchronous equivalent to the tetraodontiform gait.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.204.8.1459") Annotation(rdfs:comment "MPF mode") oboInOwl:hasExactSynonym obo:ACTAN_0000638 "ostraciiform")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") Annotation(rdfs:comment "BCF mode") oboInOwl:hasRelatedSynonym obo:ACTAN_0000638 "ostraciiform"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000638 "ostraciiform-MPF gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.204.8.1459") skos:scopeNote obo:ACTAN_0000638 "\"Interestingly, boxfishes have been the benchmark for classical descriptions of ‘ostraciiform’ locomotion as a BCF mode with minimal body curvature in which a sculling caudal fin is the primary propulsor. Preliminary observations, both in the laboratory and in the field, suggested that boxfishes normally do not swim in this classical mode: they use their median and paired fins as the major propulsors for most of their speed range. Thus, boxfishes should be considered as MPF, not BCF, swimmers.\"")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1109/48.757275") Annotation(rdfs:comment "Boxfishes are the only fishes which can undertake fully oscillatory BCF mode swimming. The 'Ostaciiform' gait term is now preferably applied to asynchronous use of median and pectoral fins. Since both modes are unique to Ostraciiformes, perhaps it would be better to call them 'Ostraciiform BCF' and 'Ostraciiform MPF' gaits?") skos:scopeNote obo:ACTAN_0000638 "\"Ostraciiform locomotion is the only purely oscillatory BCF mode. It is characterized by the pendulum-like oscillation of the (rather stiff) caudal fin, while the body remains essentially rigid. Fish utilizing ostraciiform mode are usually encased in inflexible bodies and forage their (usually complex) habitat using MPF propulsion.\"")
SubClassOf(obo:ACTAN_0000638 obo:ACTAN_0000020)
SubClassOf(obo:ACTAN_0000638 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000069))
SubClassOf(obo:ACTAN_0000638 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000151))
SubClassOf(obo:ACTAN_0000638 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_4000163))
SubClassOf(obo:ACTAN_0000638 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000688))

# Class: obo:ACTAN_0000639 (abduction placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000639 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000639 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000639 "2025-03-24T21:05:27.546437Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000639 "Placement that results from abducting.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000639 "abducted"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000639 "held out")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000639 "abduction placement")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000639 "\"Badis badis...
Movement suppression... The already abducted fins become even more tautly spread.\"")
SubClassOf(obo:ACTAN_0000639 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000639 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000738))

# Class: obo:ACTAN_0000640 (furl placement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000640 <https://github.com/Active-Animals/Ontology/patterns/placement_by_movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000640 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000640 "2025-03-24T21:05:37.183185Z")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(rdfs:comment "doi:10.1163/156853981X00220"^^xsd:decimal) oboInOwl:hasBroadSynonym obo:ACTAN_0000640 "closed")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Directly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000640 "Placement that results from furling.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasNarrowSynonym obo:ACTAN_0000640 "loosely spread")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000640 "moderately spread")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000640 "compressed")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000640 "depressed")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000640 "furl placement"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1242/jeb.204.8.1459") skos:scopeNote obo:ACTAN_0000640 "\"At low swimming speeds, up to approximately 1 TL s-1, boxfish swam using combinations of pectoral and anal fin motions only. The dorsal and caudal fins were typically furled but were occasionally used for single beats.\"")
SubClassOf(obo:ACTAN_0000640 obo:ACTAN_0000081)
SubClassOf(obo:ACTAN_0000640 ObjectSomeValuesFrom(obo:RO_0002404 obo:ACTAN_0000740))

# Class: obo:ACTAN_0000641 (take-off regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000641 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000641 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000641 "2025-08-03T11:27:48.881284Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853951X00214") oboInOwl:hasDefinition obo:ACTAN_0000641 "Interfacing-regime in which upward impetus involves a combination of a forceful propulsor motion into the new medium, and a recoil push off the substrate.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853951X00214") oboInOwl:hasExactSynonym obo:ACTAN_0000641 "flying away")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853951X00214") oboInOwl:hasExactSynonym obo:ACTAN_0000641 "flying up")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853951X00214") oboInOwl:hasExactSynonym obo:ACTAN_0000641 "take off")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853951X00214") oboInOwl:hasExactSynonym obo:ACTAN_0000641 "taking off"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000641 "take-off regime")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000641 obo:ACTAN_0000232)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000641 obo:ACTAN_0000234)
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000641 "\"A. ibis... takeoff... sequence of skeletal movements is as follows: legs begin to bend, neck is partly retracted and forepart of the body lowered until the main body axis is about 30 [degrees] above the horizontal, simultaneously the wings are raised and extended and as they beat down the legs are extended again.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853951X00214") skos:example obo:ACTAN_0000641 "\"Terns, and several Waders (Godwit, Plovers) stretch the wings and point them upward before taking off. In the actual take off the upward impetus is chiefly effected by the forceful down stroke of the wings.\"")
AnnotationAssertion(Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") skos:scopeNote obo:ACTAN_0000641 "\"While the structure and orientation of gorgonians that is adapted for capturing plankton, may also provide gobies a take-off platform to access food in the water column.\"")
SubClassOf(obo:ACTAN_0000641 obo:ACTAN_0000086)
SubClassOf(obo:ACTAN_0000641 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000163))
SubClassOf(obo:ACTAN_0000641 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000173))
SubClassOf(obo:ACTAN_0000641 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

# Class: obo:ACTAN_0000642 (rowing pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000642 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000642 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000642 "2025-03-26T21:03:39.030573Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"Such forms that have comparatively narrow pectorals used to this end, as Abudefduf and Teuthus, may be, in one sense, almost thought of as rowing their way along, in that they bring the fin forward almost edgewise and force it back broadside..\"") oboInOwl:hasDefinition obo:ACTAN_0000642 "Flap pattern in which the propulsor is brought forward edgewise and back broadside.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000642 "rowing"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000642 "striking")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasNarrowSynonym obo:ACTAN_0000642 "stroking")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000642 "alternating")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasRelatedSynonym obo:ACTAN_0000642 "heaving")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasRelatedSynonym obo:ACTAN_0000642 "periodic")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasRelatedSynonym obo:ACTAN_0000642 "recovering"@en)
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.130.1.155") oboInOwl:hasRelatedSynonym obo:ACTAN_0000642 "returning")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") Annotation(rdfs:comment "This is the aerial phase of a step.") oboInOwl:hasRelatedSynonym obo:ACTAN_0000642 "swinging")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000642 "rowing pattern")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") skos:scopeNote obo:ACTAN_0000642 "\"Aerial and aquatic modes of locomotion are similar in nature due to the fact that propulsion mechanisms utilize similar characteristics of aero and hydrodynamics in each medium. The key differences between the two are the increased implications of gravity during aerial operations compared to aquatic operations, and the difference in density of the fluids, being approximately 800 times denser in water than air...

...insects typically do not use the same mechanism for locomotion in the different mediums, although many examples exist that utilize both modes of transport. To achieve this insects typically use their hexapod gaits in a rowing motion, utilizing a drag based strategy, and then subsequently use wings during aerial operations.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000642 "\"Rowing animals with single (𝑛=2) pair of appendages hop and sink as opposed to swimming steadily.\"")
SubClassOf(obo:ACTAN_0000642 obo:ACTAN_0000529)
SubClassOf(obo:ACTAN_0000642 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000999))

# Class: obo:ACTAN_0000643 (streamlining kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000643 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000643 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000643 "2025-03-30T19:32:24.164249Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://search.proquest.com/openview/28072abf0dcabdc270c0235a6fb16211/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"This is a reasonable assumption given that metachronal swimmers bend, collapse, or retract their appendages and recover multiple appendages together in order to reduce drag via streamlining.\"") oboInOwl:hasDefinition obo:ACTAN_0000643 "Kinetics that moves an appendage in order to reduce drag.

Movement may include bending, collapsing, or retracting.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac061") oboInOwl:hasExactSynonym obo:ACTAN_0000643 "streamlining"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000643 "rheomorphism")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000643 "streamlining kinetics"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac061") skos:example obo:ACTAN_0000643 "\"...in the father lasher (Myoxocehpalus scorpius), during station holding against substrate, the ventral fin rays extend and contact the substrate, often forward of the fin base. The more dorsal fin membrane extends back to lay against the side of the body and is thought to provide streamlining.\"")
SubClassOf(obo:ACTAN_0000643 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000643 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001839))

# Class: obo:ACTAN_0000644 (feathering streamlining)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000644 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000644 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000644 "2025-03-30T19:32:56.738551Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(skos:scopeNote "\"On the recovery stroke, the fin is feathered, the superior margin leading.\"") oboInOwl:hasDefinition obo:ACTAN_0000644 "Streamlining that occurs on the recovery stroke.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000644 "feathering"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000644 "feathering streamlining"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac061") skos:example obo:ACTAN_0000644 "\"...the pectoral fins of the boxfish have a temporally asymmetric beat cycle, with fin abduction being significantly slower than the adduction phase. This may indicate that the adducting fin is serving as the power stroke of the fin-beat cycle... feathering the pectoral fins during the lower speed... phase* should minimize resistance. Such propulsor movement patterns are frequently seen in drag-based systems.\"

* In the original, it appears that a typo has labelled this the 'adduction phase' instead of the 'abduction phase'.")
SubClassOf(obo:ACTAN_0000644 obo:ACTAN_0000643)
SubClassOf(obo:ACTAN_0000644 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000026))

# Class: obo:ACTAN_0000645 (steering kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000645 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000645 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000645 "2025-03-31T08:16:22.729708Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1126/science.288.5463.100") oboInOwl:hasDefinition obo:ACTAN_0000645 "Kinetics which voluntarily manages lateral change in an organism’s trajectory.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000645 "steering"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000645 "steering kinetics"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000645 obo:ACTAN_0000174)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000645 "NBO:0000376")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") skos:example obo:ACTAN_0000645 "\"Flying squirrels and flying phalangers also utilize relatively large tails for steering and stabilization in flight.\"")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000645 "\"Usually more than one method is used at a time and in such sharp turns as is seen in Salmo after having risen to a fly it is likely that as many as possible are used in combination.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1126/science.288.5463.100") skos:scopeNote obo:ACTAN_0000645 "\"...mechanically unstable bodies that can easily be blown off course are also very responsive to voluntary steering maneuvers.\"")
SubClassOf(Annotation(dc:source "doi:10.1126/science.288.5463.100") obo:ACTAN_0000645 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000645 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001413))

