AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1537/ase.107.141") Annotation(skos:scopeNote "\"Lie prone (LIP) (Type A): Lie on belly.\"") oboInOwl:hasDefinition obo:ACTAN_0000820 "Lie that is on the belly.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000820 "prone"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000820 "prone lie"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000820 "\"In Mergini, the female frequently reacts at once to the male's pre-copulatory behaviour by assuming the Prone posture and remaining immobile until he mounts.\"")
SubClassOf(obo:ACTAN_0000820 obo:ACTAN_0000242)
SubClassOf(obo:ACTAN_0000820 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0013235))

# Class: obo:ACTAN_0000821 (mount copulation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000821 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000821 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000821 "2025-09-07T14:20:43.073849Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1537/ase.107.141") Annotation(skos:scopeNote "\"Part of the ventral surface of the mounter is in contact with part of the dorsal surface of the other, and the mounter leans forward over the other, usually grasping him/her\".") oboInOwl:hasDefinition obo:ACTAN_0000821 "Copulation in which the ventral surface of the mounter makes contact with the other.

Grasping may be involved.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000821 "mounting"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") rdfs:label obo:ACTAN_0000821 "mount copulation")
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:example obo:ACTAN_0000821 "\"In many ungulates, males sometimes attack mating pairs, trying to dislodge males that are already mounting.\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000821 "\"The most striking feature of copulation in A. ibis is the low frequency and intensity of accompanying displays, which suggests that mutual inhibitions against body contact are minimal. Frequently a male mounts his mate and treads for a few seconds without achieving cloacal contact...\"")
SubClassOf(obo:ACTAN_0000821 obo:ACTAN_0000485)
SubClassOf(obo:ACTAN_0000821 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002501))

# Class: obo:ACTAN_0000822 (dismount copulation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000822 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000822 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000822 "2025-09-07T14:21:13.401549Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/j.1469-185X.2007.00029.x") Annotation(skos:scopeNote "\"In Tephritidae, disengagement of the coupling occurs as the male dismounts and moves away end-to-end, pulling the phallus from the female aculeus.\"") oboInOwl:hasDefinition obo:ACTAN_0000822 "Copulation in which coupling is disengaged.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000822 "dismounting"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000822 "dismount copulation")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000822 "\"Copulation in A. ibis is seldom preceded by displaying by either partner... After dismounting, they both perform body shakes then preen, usually paying no further attention to each other.\"")
SubClassOf(obo:ACTAN_0000822 obo:ACTAN_0000485)
SubClassOf(obo:ACTAN_0000822 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000927))

