AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Indirectly inferred.") oboInOwl:hasDefinition obo:ACTAN_0000562 "Furling that closes a pelvic fin.")
