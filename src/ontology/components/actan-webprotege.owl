AnnotationAssertion(terms:conformsTo obo:ACTAN_0000068 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000068 "Ditch Townsend")
