SubClassOf(obo:ACTAN_0000224 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000221))

# Class: obo:ACTAN_0000225 (creeping gait)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000225 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000225 "2024-10-03T19:17:08.003054Z")
AnnotationAssertion(Annotation(rdfs:comment "\"Creep
A broad category of walking-like locomotion characterized by (1) very slow speeds, (2) minimal excursions of the COM in directions other than the forward direction, (3) three points of contact with the ground at any given time forming a polygonal Support Pattern, (4) the vertical projection of the COM onto the surface that lies within its Support Pattern at the given time, and (5) has static stability at all times,meaning the animal could halt movement and remain stable at any point in time.\"") Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icac125") oboInOwl:hasDefinition obo:ACTAN_0000225 "Traversing-gait that involves minimal excursions of the centre of mass (COM) in directions other than forward, three points of contact with the ground at any given time forming a polygonal support pattern, the vertical projection of the COM onto the surface that lies within its support pattern at the given time, and has static stability at all times.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000225 "creeping"@en)
AnnotationAssertion(Annotation(dc:date "1968"^^xsd:decimal) Annotation(dc:source "https://apps.dtic.mil/sti/html/tr/AD0675256/") rdfs:label obo:ACTAN_0000225 "creeping gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") skos:scopeNote obo:ACTAN_0000225 "\"This form of locomotion has been described in hemichordates, echinoderms, snakes, infant rodents,molluscs, reptiles and amphibians.\"")
SubClassOf(obo:ACTAN_0000225 obo:ACTAN_0000093)
SubClassOf(obo:ACTAN_0000225 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000546))
SubClassOf(obo:ACTAN_0000225 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))

# Class: obo:ACTAN_0000226 (LSDC pattern)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000226 <https://github.com/Active-Animals/Ontology/patterns/disposition_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000226 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000226 "2024-10-02T08:59:26.866685Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icac125") Annotation(skos:scopeNote "\"LSDC walk
A form of true walking characterized by (1) the footfall formula of right hind–right front–(pause)–left hind–left front, and (2) the animal spends most of its time supported on diagonal pairs of limbs (such as the right hind and left front). This is the most common pattern for slow moving mammals, and potentially other tetrapods as well.\"") oboInOwl:hasDefinition obo:ACTAN_0000226 "Contralateral-bipodal pattern that involves the footfall formula of right hind–right front–(pause)–left hind–left front.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000226 "LSDC"@en)
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasExactSynonym obo:ACTAN_0000226 "lateral sequence, diagonal couplet")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000226 "LSDC pattern"@en)
SubClassOf(obo:ACTAN_0000226 obo:ACTAN_0000142)
SubClassOf(obo:ACTAN_0000226 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002035))

# Class: obo:ACTAN_0000227 (DSDC-walk gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000227 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000227 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000227 "2024-10-02T09:55:53.494896Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Compositional definition.") oboInOwl:hasDefinition obo:ACTAN_0000227 "Walk gait that is diagonal-sequence, diagonal-couplet, and vaulting.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000227 "DSDC walk"@en)
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasExactSynonym obo:ACTAN_0000227 "diagonal-sequence, diagonal-couplet walk")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000227 "DSDC-walk gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1023/A:1005565304671") skos:example obo:ACTAN_0000227 "\"Quadrupedal primates are distinguished from other quadrupedal mammals in the common use of diagonal-sequence footfall patterns.\"")
SubClassOf(obo:ACTAN_0000227 obo:ACTAN_0000134)
SubClassOf(obo:ACTAN_0000227 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000211))
SubClassOf(obo:ACTAN_0000227 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000736))
SubClassOf(obo:ACTAN_0000227 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000056))
SubClassOf(obo:ACTAN_0000227 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000221))

# Class: obo:ACTAN_0000228 (crawl gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000228 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000228 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000228 "2024-10-03T19:17:16.891622Z")
AnnotationAssertion(Annotation(dc:source "\"Crawl
A form of creeping locomotion characterized by (1) slow speeds, (2) a prone or sprawling posture, and (3) substantial contact between the supporting surface and contact points other than the distal portions of the limbs (hands or feet), which may include knees, elbows, the belly, or the underside of the tail.\"") Annotation(rdfs:isDefinedBy "doi:10.1093/icb/icac125") oboInOwl:hasDefinition obo:ACTAN_0000228 "Creeping gait that is prone, with substantial contact between the supporting surface and contact points other than the distal portions of the limbs.

This may include knees, elbows, the belly, or the underside of the tail.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000228 "crawl"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000228 "crawl gait")
AnnotationAssertion(Annotation(dc:source "https://apps.dtic.mil/sti/html/tr/AD0675256/") rdfs:seeAlso obo:ACTAN_0000228 obo:ACTAN_0000137)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000228 "\"Aequidens latifrons...
The at first the larvae only crawl along the bottom, ascending in this way the slopes of the pit, but after some hours they are able to swim freely at a llittle distance above the bottom.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000228 "\"The triglids, for example, are able to creep slowly over the bottom by means of the free pectoral rays. The motion is produced by placing the tips of the rays in contact with the bottom and pushing backwards.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000228 "NBO:0000363")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") skos:scopeNote obo:ACTAN_0000228 "\"...crawling, in which potential energy (height) varies little.\"")
SubClassOf(obo:ACTAN_0000228 obo:ACTAN_0000225)
SubClassOf(obo:ACTAN_0000228 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000104))
SubClassOf(Annotation(dc:source "doi:10.1093/icb/icac125") obo:ACTAN_0000228 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000624))
SubClassOf(obo:ACTAN_0000228 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000056))
SubClassOf(obo:ACTAN_0000228 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000169))

# Class: obo:ACTAN_0000229 (flat-concertina gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000229 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000229 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000229 "2024-10-03T19:19:01.788211Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasDefinition obo:ACTAN_0000229 "Traversing-gait in which all normal force contributing to static friction in the anchoring region of the concertina arises passively from the animal’s weight.

Substantial backward slipping can occur in the posterior region of the animal as more anterior regions are sliding forward.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasExactSynonym obo:ACTAN_0000229 "flat-surface concertina"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000229 "flat-concertina gait")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000229 obo:ACTAN_0000100)
SubClassOf(obo:ACTAN_0000229 obo:ACTAN_0000093)
SubClassOf(obo:ACTAN_0000229 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000104))
SubClassOf(obo:ACTAN_0000229 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000925))
SubClassOf(obo:ACTAN_0000229 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000052))
SubClassOf(obo:ACTAN_0000229 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))
SubClassOf(obo:ACTAN_0000229 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000241))

# Class: obo:ACTAN_0000230 (sidewind gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000230 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000230 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000230 "2024-10-03T19:19:47.907346Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasDefinition obo:ACTAN_0000230 "Traversing-gait in which some parts of the animal have static contact with the ground, all points along the length of the animal follow distinctly different but nearly parallel paths, regions of static contact create disconnected tracks that are parallel to each other and oblique to the overall direction of travel, and posterior segments of the animal are consistently in front of more anterior segments within a region of static contact.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasExactSynonym obo:ACTAN_0000230 "sidewinding"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000230 "sidewind gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icaa017") skos:scopeNote obo:ACTAN_0000230 "\"Sidewinding also involves bending from side to side that is posteriorly propagated, but snakes using this mode also arch their back to lift the body between regions of static contact with the ground.\"")
SubClassOf(obo:ACTAN_0000230 obo:ACTAN_0000093)
SubClassOf(obo:ACTAN_0000230 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000727))
SubClassOf(obo:ACTAN_0000230 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000733))
SubClassOf(obo:ACTAN_0000230 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000052))
SubClassOf(obo:ACTAN_0000230 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))
SubClassOf(obo:ACTAN_0000230 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000528))

# Class: obo:ACTAN_0000231 (terrestrial-lateral-undulating gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000231 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000231 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000231 "2024-10-03T19:20:14.062516Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasDefinition obo:ACTAN_0000231 "Traversing-gait in which posteriorly propagated waves of lateral-undulating generate propulsive forces, and the speeds of wave propagation and forward movement are the same as all of the points along the length of the animal more or less follow the same path.")
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icaa017") oboInOwl:hasExactSynonym obo:ACTAN_0000231 "terrestrial-lateral-undulating"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000231 "serpentine")
AnnotationAssertion(Annotation(dc:date "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000231 "terrestrial-lateral-undulating gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") skos:example obo:ACTAN_0000231 "\"In some cases, animals were documented to move using only their axial body; for example, the ropefish Erpetoichthys calabaricus, which moves in terrestrial environments using a lateral undulatory motion of the vertebral column, where there is no contact between the appendages and the ground.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") skos:scopeNote obo:ACTAN_0000231 "\"Undulations aid in the rotation of the pelvic and pectoral girdles and increase the range of motion of the limbs, thereby reducing energetic expenditure.\"")
SubClassOf(obo:ACTAN_0000231 obo:ACTAN_0000093)
SubClassOf(obo:ACTAN_0000231 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000163))
SubClassOf(obo:ACTAN_0000231 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000737))
SubClassOf(obo:ACTAN_0000231 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000052))
SubClassOf(obo:ACTAN_0000231 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))
SubClassOf(obo:ACTAN_0000231 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000528))

# Class: obo:ACTAN_0000232 (body-throw regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000232 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000232 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000232 "2024-10-03T19:21:01.233589Z")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasBroadSynonym obo:ACTAN_0000232 "jump")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000232 "Traversing-regime in which a forceful axial movement is involved in propulsion across a gap requiring an extended period of free flight.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000232 "body throw"@en)
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasNarrowSynonym obo:ACTAN_0000232 "flop")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000232 "body-throw regime")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000232 obo:ACTAN_0000234)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000232 obo:ACTAN_0000327)
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icaa017") skos:example obo:ACTAN_0000232 "\"As gap distances increase, rather than crawling slowly and continuously, some snake species may lunge, jump, or even glide.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:scopeNote obo:ACTAN_0000232 "\"A fish of carangiform locomotor apparatus out of water flops from side to side because in contracting the myomeres of one side as it normally does, the tail hits down smartly and the reaction throws the fish upward.\"")
SubClassOf(obo:ACTAN_0000232 obo:ACTAN_0000089)
SubClassOf(obo:ACTAN_0000232 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000003))
SubClassOf(obo:ACTAN_0000232 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))
SubClassOf(obo:ACTAN_0000232 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000530))
SubClassOf(obo:ACTAN_0000232 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000893))
SubClassOf(obo:ACTAN_0000232 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0013701))

# Class: obo:ACTAN_0000233 (push-pull thrust)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000233 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000233 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000233 "2024-10-03T19:21:25.661167Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1242/jeb.120.1.283") Annotation(skos:scopeNote "\"These walking legs are positioned laterally and appear to provide thrust with both a pulling motion during the early part of the leg cycle as they reach forward, contact the sand and flex, and a pushing motion in the latter phase of the leg cycle when the legs extend to the rear of the crab.\"") oboInOwl:hasDefinition obo:ACTAN_0000233 "Thrust in which an appendage provides both a forceful motion during the early part of its cycle as it reaches forward and flexes, and a forceful motion in the latter phase of its cycle when it extends to the rear.")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000233 "push-pull"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000233 "push-pull thrust"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") skos:scopeNote obo:ACTAN_0000233 "\"Most invertebrates burrow through loose sediments by employing a discontinuous, push-pull sequence of movements that consists of two phases.\"")
SubClassOf(obo:ACTAN_0000233 obo:ACTAN_0000671)
SubClassOf(obo:ACTAN_0000233 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001477))

# Class: obo:ACTAN_0000234 (leap regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000234 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000234 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000234 "2024-10-03T19:22:01.276511Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"Leaping is a gap-crossing movement in which the hindlimbs principally are used as propulsors. The flexed hindlimbs and flexed back are forcefully extended, often aided by the forelimbs. There is an extended period of free flight, distinguishing this mode from bounding.\"") oboInOwl:hasDefinition obo:ACTAN_0000234 "Traversing-regime that is a gap-crossing movement in which the hindlimbs are used as propulsors, the flexed hindlimbs and flexed back are forcefully extended, and there is an extended period of free flight.

It is often aided by the forelimbs.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000234 "jumping")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") oboInOwl:hasExactSynonym obo:ACTAN_0000234 "leap")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000234 "leaping")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000234 "leap regime"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000234 obo:ACTAN_0000232)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000234 obo:ACTAN_0000641)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000234 "NBO:0000360")
SubClassOf(obo:ACTAN_0000234 obo:ACTAN_0000089)
SubClassOf(obo:ACTAN_0000234 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000003))
SubClassOf(obo:ACTAN_0000234 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000188))
