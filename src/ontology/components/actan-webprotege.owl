# Class: obo:ACTAN_0000582 (allogroom cooperation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000582 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000582 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000582 "2025-09-03T09:13:01.983321Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1093/beheco/12.5.534") Annotation(skos:scopeNote "\"When reciprocal altruism is involved, individuals anticipate that the act will be reciprocated. In vampire bat teams, social grooming, which makes up 5% of their day, appears to be an important factor in both roost-mate recognition and as a prelude to regurgitation.\"") oboInOwl:hasDefinition obo:ACTAN_0000582 "Cooperation which grooms another.

It is usually altruistic.")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1093/beheco/aru194") oboInOwl:hasExactSynonym obo:ACTAN_0000582 "allogrooming"@en)
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasExactSynonym obo:ACTAN_0000582 "social grooming")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasNarrowSynonym obo:ACTAN_0000582 "allopreening")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasNarrowSynonym obo:ACTAN_0000582 "mutual preening")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasNarrowSynonym obo:ACTAN_0000582 "social preening")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000582 "allogroom cooperation"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000582 obo:ACTAN_0000607)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000582 "NBO:0000450")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000582 "\"The preening is not confined to members of a pair; occasionally three individuals preen one another simultaneously, and interspecific nibbling has been seen between Cuban and White-faced Whistling Ducks...

Preening of the young has been noted in a female Cereopsis. on several occasions this bird nibbled at the backs of her goslings, which were feathered and about three-quarters adult size.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:scopeNote obo:ACTAN_0000582 "\"The social primates are also characterized by complex activities affecting social competition (e.g., social grooming, play, threat, and the establishment of alliances)...\"")
SubClassOf(obo:ACTAN_0000582 obo:ACTAN_0000463)
SubClassOf(obo:ACTAN_0000582 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000816))

# Class: obo:ACTAN_0000583 (association experience)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000583 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000583 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000583 "2025-02-07T21:23:01.29703Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasDefinition obo:ACTAN_0000583 "Experience which has learned to connect costs and benefits to a specific cue.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000583 "associating"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000583 "association experience")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000583 "NBO:0000171")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000583 "\"An aposematic signal is a form of communication, or advertisement, to a predator or other aggressor that there is a net cost for interference with the signaler. In this way, the predator learns to associate the aposematic cue with a painful experience and will in the future avoid animals that exhibit that signal.\"")
SubClassOf(obo:ACTAN_0000583 obo:ACTAN_0000338)
SubClassOf(obo:ACTAN_0000583 ObjectSomeValuesFrom(obo:BFO_0000051 obo:GO_0008306))

# Class: obo:ACTAN_0000584 (yawn comfort)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000584 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000584 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000584 "2025-05-05T19:33:38.163746Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasDefinition obo:ACTAN_0000584 "Comfort in which gaping precedes the mouth shutting, as the floor of the mouth is depressed and recovered.

In fishes, the operculae are then adducted; the whole sequence is rapid and passes a large volume of water quickly from the mouth out through the gills.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000584 "yawning"@en)
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(skos:scopeNote "\"Intention yawning, consisting of slight gaping... may precede complete yawning.\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000584 "intention yawning")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasRelatedSynonym obo:ACTAN_0000584 "jaw-stretch")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000584 "yawn comfort")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000584 "NBO:0000074")
SubClassOf(obo:ACTAN_0000584 obo:ACTAN_0000708)
SubClassOf(obo:ACTAN_0000584 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000847))

# Class: obo:ACTAN_0000585 (tracking look)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000585 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000585 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000585 "2025-02-08T16:19:02.17755Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"(OKR): Stereotyped tracking eye movements triggered by moving objects across the visual field. Has two components: a smooth pursuit movement following the object, and a fast saccadic movement resetting the eyes after the object has left the visual field.\"") oboInOwl:hasDefinition obo:ACTAN_0000585 "Look in which a moving object across the visual field triggers an eye to have a smooth pursuit movement following the object, and a fast saccadic movement resetting the eyes after the object has left the visual field.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000585 "opto-kinetic-reflex"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000585 "tracking look"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000585 "NBO:0000574")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:example obo:ACTAN_0000585 "\"Even post-larvae, which have been swimming well for only a few days, have been observed to turn the head to one side and fix on tiny moving particles.\"")
SubClassOf(obo:ACTAN_0000585 obo:ACTAN_0000318)
SubClassOf(obo:ACTAN_0000585 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000008))

# Class: obo:ACTAN_0000586 (smooth-pursuit conjugation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000586 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000586 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000586 "2025-02-08T16:48:14.781315Z")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") Annotation(skos:scopeNote "\"...the pursuit phase of eye tracking movements...\"") oboInOwl:hasBroadSynonym obo:ACTAN_0000586 "eye tracking")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "https://core.ac.uk/download/pdf/85255156.pdf") oboInOwl:hasBroadSynonym obo:ACTAN_0000586 "visual tracking")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.ncbi.nlm.nih.gov/books/NBK10991/") Annotation(skos:scopeNote "\"Smooth pursuit movements are much slower tracking movements of the eyes designed to keep a moving stimulus on the fovea.\"") oboInOwl:hasDefinition obo:ACTAN_0000586 "Conjugation in which slower tracking of the eyes keeps a stimulus on the fovea.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "https://www.ncbi.nlm.nih.gov/books/NBK10991/") oboInOwl:hasExactSynonym obo:ACTAN_0000586 "smooth pursuit"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000586 "smooth-pursuit conjugation")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/auk/123.4.967") skos:example obo:ACTAN_0000586 "\"Parotia carolae...
While a male displays below, the female looks on from the main court perch and closely follows the movements of the male.\"")
SubClassOf(obo:ACTAN_0000586 obo:ACTAN_0000745)
SubClassOf(obo:ACTAN_0000586 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000689))

# Class: obo:ACTAN_0000587 (photo-taxis)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000587 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000587 "Ditch Townsend")
