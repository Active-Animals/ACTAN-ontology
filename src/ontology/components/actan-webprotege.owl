# Class: obo:ACTAN_0000412 (shoal swarm)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000412 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000412 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000412 "2024-11-11T17:17:18.033197Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000412 "Swarm that is aquatic.")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasExactSynonym obo:ACTAN_0000412 "shoal"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "The 1950 source does not mention shoaling throughout, but it was typical not to differentiate in ethological literature at the time. It notes, \"It is very typical of these schools that the members continually show a tendency to practice the same actions simultaneously.\" However, these actions do not relate to polarity, but to foraging, floating, or lying on the bottom. Additionally, attention is drawn at one point to a school of fry protected by parents in which, \"the young may move in different directions. But the school as a whole remains near or round the leading fish...\" And elsewhere, \"As long as the female swims quietly, the young, mostly feeding, are swimming criss-cross within the school.\" This seems very like the definition of shoaling. Most likely the term 'school' in this source predominantly relates to the modern 'shoal', but without more certainty, this synonym is being applied to the last mutual ancestor of both terms.") oboInOwl:hasRelatedSynonym obo:ACTAN_0000412 "schooling")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000412 "troop")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000412 "shoal swarm")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000412 obo:ACTAN_0000413)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000412 "NBO:0040001")
SubClassOf(obo:ACTAN_0000412 obo:ACTAN_0000036)
SubClassOf(obo:ACTAN_0000412 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000183))

# Class: obo:ACTAN_0000413 (school aggregation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000413 <https://github.com/Active-Animals/Ontology/patterns/group_behaviour>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000413 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000413 "2024-11-11T17:17:59.425196Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasDefinition obo:ACTAN_0000413 "Aggregation that is 3-dimensional, polarized, maintained and aquatic.")
AnnotationAssertion(Annotation(dc:date "1973"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF01609520") oboInOwl:hasExactSynonym obo:ACTAN_0000413 "schooling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000413 "school aggregation")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000413 obo:ACTAN_0000412)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000413 "NBO:0040002")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/bc60659126ef5c0172c2392d485b0c9b/1?pq-origsite=gscholar&cbl=18750") skos:example obo:ACTAN_0000413 "\"In ecological systems, examples of synchrony include flashing of fireflies for courting behavior, schooling behavior in fishes for predator avoidance and reproduction, flocking of birds, and spawning of gametes by corals for sexual reproduction.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1109/48.757275") skos:scopeNote obo:ACTAN_0000413 "\"As each vortex is shed by individual swimming fish... a fish situated laterally midway between the two fish of the preceding column... avoids having to overcome increased incoming flow... The advantage is greater when fish in the same column swim in antiphase with the neighbors. These requirements point to an elongated diamond-shape pattern as the basic optimum structure in fish schools... Magnuson estimates average energy savings of 10%–20% from schooling.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:scopeNote obo:ACTAN_0000413 "\"School (schooling): Formation of a relatively polarized group (school) in which multiple fish swim together, in a coordinated/synchronous fashion;\"")
SubClassOf(obo:ACTAN_0000413 obo:ACTAN_0000411)
SubClassOf(obo:ACTAN_0000413 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000183))
SubClassOf(obo:ACTAN_0000413 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000406))
SubClassOf(obo:ACTAN_0000413 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000662))

# Class: obo:ACTAN_0000414 (signal interaction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000414 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000414 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000414 "2024-11-12T11:26:34.724781Z")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasBroadSynonym obo:ACTAN_0000414 "communication")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3389/fetho.2022.1066186") Annotation(skos:scopeNote "\"Unlike cues, signals have evolved for the particular communicative function they serve.\"") oboInOwl:hasDefinition obo:ACTAN_0000414 "Interaction that serves a communicative function.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000414 "animal language")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000414 "signal"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000414 "advertisement")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasRelatedSynonym obo:ACTAN_0000414 "display")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000414 "signal interaction")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000414 "\"Alongside territorial signals, which function to keep unwanted intruders at bay, some architecture may function as an attractive signal, by conveying information to potential mates about the quality of the builder. Bowerbirds provide one of the most extravagant examples of built structures functioning as such advertisements. Male bowerbirds construct bowers from interwoven sticks and decorate the fl oor of their courtship arena with all manner of colorful objects, each assembled into discrete piles with great precision, including berries, shells, and even human-made objects, like bottle caps or poker chips.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000414 "NBO:0000612")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2022.1066186") skos:scopeNote obo:ACTAN_0000414 "\"Communication is therefore largely about changes induced in an individual by a perceived action or structure of another individual. It is thus the social behavior that lies at the foundation of all other social behavior and includes individuals producing visual displays that deter the pursuit of a predator, vocalizations that change the movement patterns of others in their midst, volatile chemical compounds that attract potential mates, and vibrational waves that pause the signaling behavior of nearby conspecifics.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000414 "\"Sometimes a noisy Wing-flap occurs instead of the Shake. There is much variation in this display; sometimes the belly feathers are nibbled vigorously or the bill may not touch the body at all merely swinging briefly across above the feet.\"")
SubClassOf(obo:ACTAN_0000414 obo:ACTAN_0000383)
SubClassOf(Annotation(skos:scopeNote "\"...movements in secondary situations which differ in form from their \"normal\" counterparts are considered to have undergone a process of \"ritualization\"; they are referred to as \"displays\"...\"

doi:10.1163/156853965x00138") obo:ACTAN_0000414 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000397))

# Class: obo:ACTAN_0000415 (recruitment development)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000415 <https://github.com/Active-Animals/Ontology/patterns/context_by_life_cycle>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000415 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000415 "2024-11-11T17:19:41.32525Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") oboInOwl:hasDefinition obo:ACTAN_0000415 "Development in which a larva settles into a preferred habitat, transitioning into a juvenile.")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1016/S0169-5347(99)01744-9") Annotation(skos:scopeNote "\"recruitment-limited\"") oboInOwl:hasExactSynonym obo:ACTAN_0000415 "recruitment"@en)
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1016/S0169-5347(99)01744-9") Annotation(skos:scopeNote "\"post-settlement\"") oboInOwl:hasExactSynonym obo:ACTAN_0000415 "settlement")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000415 "recruitment development"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000415 obo:ACTAN_0000402)
AnnotationAssertion(Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") skos:example obo:ACTAN_0000415 "\"...the multiple-branching form of D. gemmacea colonies and their orientation of these branches into the current leads to an increased exposure to drifting plankton, which may in turn increase the chances of fish larvae encountering and eventually settling onto D. gemmacea compared to J. juncea.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/bc60659126ef5c0172c2392d485b0c9b/1?pq-origsite=gscholar&cbl=18750") skos:scopeNote obo:ACTAN_0000415 "\"Conversely, in contrast to investigating control of synchrony, it would be interesting to investigate the effects of variation in spawning synchrony on recruitment for studies related to population connectivity. This work would involve  determining recruitment as a function of three components: 1) the reproductive effort of an individual and the densities of individuals in a given area; 2) the exact time at which spawning occurs; and 3) larval transport after spawning. Hughes and  colleagues reported that colony fecundity explained 49-72% of the variance in larval recruitment of various coral species.\"")
SubClassOf(obo:ACTAN_0000415 obo:ACTAN_0000773)
SubClassOf(obo:ACTAN_0000415 ObjectSomeValuesFrom(obo:BFO_0000051 obo:UBERON_0000069))

# Class: obo:ACTAN_0000416 (semiochemical modality)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000416 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000416 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000416 "2024-11-12T11:28:02.671656Z")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasBroadSynonym obo:ACTAN_0000416 "chemical communication"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasDefinition obo:ACTAN_0000416 "Modality that is transmitted via a substance.")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "ISBN:9781482294347") oboInOwl:hasExactSynonym obo:ACTAN_0000416 "chemical signal")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000416 "chemical stimulus")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2022.06.072") Annotation(skos:scopeNote "\"...communicate, and manipulate each other, via semiochemicals...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000416 "semiochemical communication")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasNarrowSynonym obo:ACTAN_0000416 "pheromone")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000416 "semiochemical modality")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2011.0690") skos:example obo:ACTAN_0000416 "\"In another teleost fish (i.e., tilapia, Oreochromis mossambicus) it has been recently shown that dominant individuals release more urine than subordinates during agonistic encounters...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000416 "\"It has been shown in Lebistes reticulatus (Peters) and in Rhodeus amarus Boch that the males produces hormones which, when absorbed by the females via the surrounding water, promote the ripening of the ovaries.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2022.1066186") skos:scopeNote obo:ACTAN_0000416 "\"Given the prevalence of noise in most every channel of communication – and the increasing presence of human noise in non-human animal communication – more research on signal and cue perception in the contexts of acoustic, chemical, visual noise is needed.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000416 "\"There is also evidence that alarm pheromones found in the discharge might serve to warn conspecifics of a predator threat, parallel to the shreckstoff found in fishes and chemical communication of stress found in larval salamanders and tadpoles.\"")
SubClassOf(obo:ACTAN_0000416 obo:ACTAN_0000117)
SubClassOf(obo:ACTAN_0000416 ObjectSomeValuesFrom(obo:RO_0000057 obo:UBERON_0000463))

# Class: obo:ACTAN_0000417 (musk exudation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000417 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000417 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000417 "2024-11-12T11:28:21.400859Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.\"") oboInOwl:hasDefinition obo:ACTAN_0000417 "Exudation that involves cloacal sac musk discharge.")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.17161/jnah.vi1.11892") oboInOwl:hasExactSynonym obo:ACTAN_0000417 "musking"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000417 "musk exudation"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.17161/jnah.vi1.11892") skos:scopeNote obo:ACTAN_0000417 "\"Musking, or cloacal discharge, is a common defensive behavior across many snake taxa that involves the release of a foul-smelling secretion from the cloacal glands, often accompanied by feces and urates, to render the snake unappetizing to potential predators.\"")
SubClassOf(obo:ACTAN_0000417 obo:ACTAN_0000097)
SubClassOf(obo:ACTAN_0000417 ObjectSomeValuesFrom(obo:RO_0000057 obo:ZFA_0000298))

# Class: obo:ACTAN_0000418 (eavesdrop indirect-sample)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000418 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000418 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000418 "2024-11-12T11:28:58.448228Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3389/fetho.2022.1066186") Annotation(skos:scopeNote "\"We do know that individuals regularly eavesdrop – they perceive and attend to the signals of other species...\"") oboInOwl:hasDefinition obo:ACTAN_0000418 "Indirect-sample that attends to the signals of other species.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2022.1066186") oboInOwl:hasExactSynonym obo:ACTAN_0000418 "eavesdropping"@en)
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.1126/science.239.4847.1525") oboInOwl:hasRelatedSynonym obo:ACTAN_0000418 "social foraging")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000418 "eavesdrop indirect-sample"@en)
SubClassOf(obo:ACTAN_0000418 obo:ACTAN_0000410)
SubClassOf(obo:ACTAN_0000418 ObjectSomeValuesFrom(obo:RO_0000057 obo:PCO_0000029))

# Class: obo:ACTAN_0000419 (touch modality)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000419 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000419 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000419 "2024-11-12T11:31:14.02616Z")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "ISBN:9781482294347") Annotation(skos:scopeNote "\"...communication by... tactile mechanisms...\"") oboInOwl:hasBroadSynonym obo:ACTAN_0000419 "tactile communication")
AnnotationAssertion(Annotation(dc:date "2000"^^xsd:decimal) Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") oboInOwl:hasBroadSynonym obo:ACTAN_0000419 "tactile cue")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1017/S1464793104006700") oboInOwl:hasDefinition obo:ACTAN_0000419 "Modality that is transmitted directly by contact movement.")
AnnotationAssertion(Annotation(dc:date "2026"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2026.123487") oboInOwl:hasExactSynonym obo:ACTAN_0000419 "tactile interaction")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") Annotation(skos:scopeNote "\"...sensory stimuli: tactile...") oboInOwl:hasExactSynonym obo:ACTAN_0000419 "tactile sensory stimulus")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") Annotation(skos:scopeNote "\"...sign stimuli... tactile ones.\"") oboInOwl:hasExactSynonym obo:ACTAN_0000419 "tactile sign stimulus")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "doi:10.1017/S1464793104006700") oboInOwl:hasExactSynonym obo:ACTAN_0000419 "tactile signal"@en)
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000419 "touch signal")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000419 "touch modality")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2026.123487") skos:example obo:ACTAN_0000419 "\"...the territorial Mediterranean rainbow wrasse, Coris julis, which joins producer—scrounger aggregations with a goatfish species, Mullus surmuletus, that disturbs benthic prey during foraging. Wrasse remained within their territories and did not follow producers beyond these boundaries but repeatedly engaged in tactile interactions (brief physical contact using their ventral side and pelvic fins or caudal fin) with goatfish while they were present. Events involving tactile interactions were associated with longer feeding durations of goatfish and therefore, indirectly, a higher overall food uptake for wrasse.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:scopeNote obo:ACTAN_0000419 "\"Elaborate courtship behaviours – often involving visual cues – have been described for various groups of salamanders, mammals, birds and fishes while olfactory and tactile signals are particularly important for many mammal species and songs and calls for the mating behaviour of birds and anurans.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1017/S1464793104006700") skos:scopeNote obo:ACTAN_0000419 "\"One type of tactile signal apparently ubiquitous in spiders is rhythmical movements of the genitalia during copulation, either in the form of repeated insertions and withdrawals or as rhythmic movements during insertion.\"")
SubClassOf(obo:ACTAN_0000419 obo:ACTAN_0000117)
SubClassOf(obo:ACTAN_0000419 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000925))

# Class: obo:ACTAN_0000420 (scent semiochemical)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000420 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000420 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000420 "2024-11-12T11:31:27.756029Z")
AnnotationAssertion(Annotation(dc:date "2003"^^xsd:decimal) Annotation(dc:source "ISBN:9781482294347") Annotation(skos:scopeNote "\"...olfactory mode of delivery...\"") oboInOwl:hasBroadSynonym obo:ACTAN_0000420 "olfactory delivery mode")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") Annotation(skos:scopeNote "\"...sign stimuli... olfactory... ones.\"") oboInOwl:hasBroadSynonym obo:ACTAN_0000420 "olfactory sign stimulus")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") oboInOwl:hasBroadSynonym obo:ACTAN_0000420 "olfactory signal"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1080/01677063.2019.1586898") oboInOwl:hasDefinition obo:ACTAN_0000420 "Semiochemical that involves a volatile compound.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000420 "scent")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000420 "scent semiochemical"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1080/01677063.2019.1586898") skos:example obo:ACTAN_0000420 "\"In addition to olfactory cues emanating from the substrate itself, female D. melanogaster are also attracted and stimulated to lay eggs on particular spots by volatile pheromones deposited on the substrate by other individuals, males or females.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/978-3-319-68576-2_3") skos:scopeNote obo:ACTAN_0000420 "\"In addition to visual displays, many acoustic and olfactory breeding signals are transmitted through the air, including an assortment of vocalizations, stridulations, airborne pheromones, and pollinator attractors.\"")
SubClassOf(obo:ACTAN_0000420 obo:ACTAN_0000416)
SubClassOf(obo:ACTAN_0000420 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000058))

# Class: obo:ACTAN_0000421 (oscillation movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000421 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000421 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000421 "2024-11-12T11:32:33.318292Z")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000421 "vibrating")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasDefinition obo:ACTAN_0000421 "Movement in which a structure swivels repeatedly on its base, with a characteristic frequency and amplitude.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") oboInOwl:hasExactSynonym obo:ACTAN_0000421 "oscillating motion")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000421 "oscillation")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1109/48.757275") oboInOwl:hasExactSynonym obo:ACTAN_0000421 "oscillatory motion")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000421 "oscillatory movement")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000421 "vibration"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000421 "oscillation movement"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:example obo:ACTAN_0000421 "\"...sepsid flies (Diptera: Sepsidae)...
Male repeatedly lowers abdomen to stimulate female using the surstylis, either by vibration or by tapping on dorsal surface of female abdomen.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1088/1748-3182/9/1/011001") skos:example obo:ACTAN_0000421 "\"Alcids are capable of competent aerial locomotion using a typical avian flapping technique, then fold their wings during aquatic operations and perform an oscillating motion of the wings in order to propel themselves.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:scopeNote obo:ACTAN_0000421 "\"Andrew describes \"feather settling with marked wing vibration\" in Emberiza, associated with preening the primaries and oiling after bathing. I have also seen vigorous wing-shaking during oiling in the Semipalmated Plover...\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000421 "\"Tail vibration itself, as a distraction away from the head, is also a plesiomorphic character for pitvipers.\"")
SubClassOf(obo:ACTAN_0000421 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000421 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000044))
SubClassOf(obo:ACTAN_0000421 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000080))

# Class: obo:ACTAN_0000422 (flash exposure)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000422 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000422 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000422 "2024-11-12T11:37:14.133084Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "http://www.nativefishlab.net/library/textpdf/15582.pdf") Annotation(skos:scopeNote "\"As the juveniles, otherwise cryptically colored, move about this white patch with dark borders flashes on and off with the opening and closing of the fin. There probably is a reason for the elaboration of such a striking feature, and the reason may lie in the intraspecific signal value of the structure.\"") oboInOwl:hasDefinition obo:ACTAN_0000422 "Exposure that is strikingly on and off.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000422 "flashing"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000422 "sudden exhibition")
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000422 "flash exposure"@en)
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000422 "\"3) to disorient the predator with a flash display.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/bc60659126ef5c0172c2392d485b0c9b/1?pq-origsite=gscholar&cbl=18750") skos:scopeNote obo:ACTAN_0000422 "\"In ecological systems, examples of synchrony include flashing of fireflies for courting behavior...\"")
SubClassOf(obo:ACTAN_0000422 obo:ACTAN_0000423)
SubClassOf(obo:ACTAN_0000422 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000678))

# Class: obo:ACTAN_0000423 (exposure show)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000423 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000423 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000423 "2024-11-12T11:37:30.010294Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000423 "Show which draws attention to a characteristic morphological feature.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000423 "exposing"@en)
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000423 "exposure")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000423 "exposure show")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000423 obo:ACTAN_0000626)
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000423 "\"...the signal movement of a fully ripe stickleback, which shows her swollen abdomen.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000423 "\"C. pricei had derived tail displays of curling their tails and exposing the ventral surface of the tail to the predator.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000423 "\"Chimpanzees...
the corners of lips are drawn back, exposing the lower, or both upper and lower teeth (or teeth and gums).\"")
SubClassOf(obo:ACTAN_0000423 obo:ACTAN_0000431)
SubClassOf(obo:ACTAN_0000423 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002425))

# Class: obo:ACTAN_0000424 (dance regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000424 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000424 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000424 "2024-11-12T11:37:42.677843Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.2307/4083155") Annotation(skos:scopeNote "\"Changes in the nature of the movement, such as exaggeration, and changes in speed of performance as compared with the precursor also occur. Rhythmic repetition may develop, as in the \"dancing\" movements of estrildine finches. There are also often changes in coordination as, for example, the simultaneous occurrence of a component of the first phase of take-off (crouching) and one from the second (tail lowering).\"") oboInOwl:hasDefinition obo:ACTAN_0000424 "Traversing-regime which changes its precursor movements, including exaggerating their nature, changing its speed of performance, developing rhythmic repetition, and changing its coordination.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000424 "dancing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000424 "dance regime")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/auk/123.4.967") skos:example obo:ACTAN_0000424 "\"Ballerina dance.—The quintessential high intensity Parotia display. Flank plumes are positioned around the body in a manner resembling a ballerina’s tutu as the bird performs an intricate dance. There are 23 elements, five phases, and three versions.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:example obo:ACTAN_0000424 "\"For example, Hammer (1941) observed individuals of Sepsis duplicata performing an elegant minuet-like dance, with males repeatedly angling themselves towards the females and the females responding likewise.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/auk/123.4.967") skos:scopeNote obo:ACTAN_0000424 "\"...a given rendition of the ballerina dance may terminate abruptly before being expressed to completion, but the abrupt end is always at a phase “break.”\"")
SubClassOf(obo:ACTAN_0000424 obo:ACTAN_0000089)
SubClassOf(obo:ACTAN_0000424 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000233))
SubClassOf(obo:ACTAN_0000424 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000645))
SubClassOf(obo:ACTAN_0000424 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000543))
SubClassOf(obo:ACTAN_0000424 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

# Class: obo:ACTAN_0000425 (sound modality)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000425 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000425 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000425 "2024-11-12T11:37:57.931868Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/eth.12882") Annotation(skos:scopeNote "\"In the sand goby (Pomatoschistus minutus), the frequency and temporal pattern of sounds are thought to communicate species identity, whereas call intensity and the visual part of male courtship are more relevant for female choice.\"") oboInOwl:hasDefinition obo:ACTAN_0000425 "Modality that communicates using the frequency, temporal pattern, and intensity of sounds.")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "doi:10.1017/S1464793104006700") oboInOwl:hasExactSynonym obo:ACTAN_0000425 "acoustic signal"@en)
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00265-010-0980-6"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000425 "auditory signal")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000425 "sound")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000425 "sound modality")
AnnotationAssertion(Annotation(dc:source "doi:10.1017/S1464793104006700") skos:example obo:ACTAN_0000425 "\"Most of the evidence for sexual selection acting on spider acoustic signals comes from studies on a lycosid, Hygrolycosa rubrofasciata. Males of this species produce drums by vibrating the abdomen against the ground, preferably on dry leaves. The resulting signal can be heard from a distance of up to several meters (by humans).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/978-3-319-68576-2_3") skos:scopeNote obo:ACTAN_0000425 "\"In addition to visual displays, many acoustic and olfactory breeding signals are transmitted through the air, including an assortment of vocalizations, stridulations, airborne pheromones, and pollinator attractors. Many of these signals evolved characteristics that allow them to travel efficiently through the air to receivers, taking forms that propagate with minimal degradation.\"")
SubClassOf(obo:ACTAN_0000425 obo:ACTAN_0000117)
SubClassOf(obo:ACTAN_0000425 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000094))

# Class: obo:ACTAN_0000426 (rattle sound)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000426 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000426 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000426 "2024-11-12T11:38:14.384672Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/brv.12891") oboInOwl:hasDefinition obo:ACTAN_0000426 "Sound that is produced by the rapid and repeated impact of knocking hard anatomical components against each other.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") Annotation(skos:scopeNote "\"...this snake is furnished with a rattle...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000426 "rattle"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000426 "rattle sound")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000426 "\"In the Tufted Duck and Rosybill, it is the primaries which are rattled with the bill to produce the characteristic noise.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000426 "\"Perhaps one of the most notable derived antipredator adaptations in snakes is the rattle, an epidermal, soundproducing structure found on the tip of the tail in 29 species of rattlesnakes.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000426 "\"Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.\"")
SubClassOf(obo:ACTAN_0000426 obo:ACTAN_0000425)
SubClassOf(obo:ACTAN_0000426 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000421))

# Class: obo:ACTAN_0000427 (resonating nontooling)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000427 <https://github.com/Active-Animals/Ontology/patterns/technical_by_kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000427 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000427 "2024-11-12T14:50:50.629931Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasDefinition obo:ACTAN_0000427 "Nontooling that uses an excavation to alter sound and vibrational properties.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasExactSynonym obo:ACTAN_0000427 "resonating"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000427 "resonating nontooling"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:example obo:ACTAN_0000427 "\"Burrows and other excavated dwellings have been hypothesized to act as potential resonating chambers.\"")
SubClassOf(obo:ACTAN_0000427 obo:ACTAN_0000287)
SubClassOf(obo:ACTAN_0000427 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000094))
SubClassOf(obo:ACTAN_0000427 ObjectSomeValuesFrom(obo:RO_0000057 obo:ENVO_01001813))

# Class: obo:ACTAN_0000428 (cloacal-popping sound)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000428 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000428 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000428 "2024-11-12T11:38:47.316325Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1580/1080-6032(1996)007[0038:USCS]2.3.CO;2") Annotation(skos:scopeNote "\"By raising their tails and writhing, these snakes can expel air from their vents to make a noise called cloacal popping.\"") oboInOwl:hasDefinition obo:ACTAN_0000428 "Sound in which a snake expels air from its vent to make a noise.")
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1580/1080-6032(1996)007[0038:USCS]2.3.CO;2") oboInOwl:hasExactSynonym obo:ACTAN_0000428 "cloacal popping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000428 "cloacal-popping sound"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1580/1080-6032(1996)007[0038:USCS]2.3.CO;2") skos:example obo:ACTAN_0000428 "\"However, there are two species of corals, M.f fulvius and M. euryxanthus, with an additional, unusual defense mechanism. By raising their tails and writhing, these snakes can expel air from their vents to make a noise called cloacal popping. This sound startles would-be predators, presumably giving them additional warning and time to flee.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000428 "\"Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.\"")
SubClassOf(obo:ACTAN_0000428 obo:ACTAN_0000425)
SubClassOf(obo:ACTAN_0000428 ObjectSomeValuesFrom(obo:RO_0000057 obo:ZFA_0000298))

# Class: obo:ACTAN_0000429 (quiver oscillation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000429 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000429 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000429 "2024-11-12T11:39:04.378653Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"Quiver (quivering): High frequency, low amplitude tail oscillation by a male while aligned against the side of a female;\"") oboInOwl:hasDefinition obo:ACTAN_0000429 "Oscillation that is high frequency and low amplitude.")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") oboInOwl:hasExactSynonym obo:ACTAN_0000429 "quiver")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000429 "quivering"@en)
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "doi:10.1093/auk/123.4.967") oboInOwl:hasExactSynonym obo:ACTAN_0000429 "shivering")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000429 "shuddering")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(rdfs:comment "1950"^^xsd:decimal) oboInOwl:hasExactSynonym obo:ACTAN_0000429 "trembling")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000429 "quiver oscillation")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:example obo:ACTAN_0000429 "\"...sepsid flies (Diptera: Sepsidae)...
Quiver (vibration of entire tarsus without movement of tibia or femur).\"")
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000429 "\"Blue Sugarbird (Dacnis cayana)... This species picks up an ant [spraying species] in its bill, and very rapidly it rises in an almost vertical position with spread tail and moves both wings forward so that they touch each other while quivering, and the head is moved downwards among the tips of the wings.”")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000429 "\"Jerking gradually merges into quivering. The position of the fish becomes more vertical (the head downward), the body waves become stronger, and the tail is swept appreciably sideways. In most species a high intensity is marked by the almost vertical position of the longitudinal axis of the fish, and the violent lateral beats of the tail.\"")
SubClassOf(obo:ACTAN_0000429 obo:ACTAN_0000421)
SubClassOf(obo:ACTAN_0000429 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000380))
SubClassOf(obo:ACTAN_0000429 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0055001))

# Class: obo:ACTAN_0000430 (tap hit)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000430 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000430 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000430 "2024-11-12T14:51:02.083568Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") oboInOwl:hasDefinition obo:ACTAN_0000430 "Hit that makes a low-force, small surface contact.")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasExactSynonym obo:ACTAN_0000430 "tapping"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000430 "tap hit")
AnnotationAssertion(skos:example obo:ACTAN_0000430 "\"For example, in the small tortoiseshell butterfly, Aglais urticae, males persistently court females, repeatedly tapping with their antennae until the female drops down into the vegetation, followed by the male who may then achieve a mating.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:example obo:ACTAN_0000430 "\"For instance, in S. neocynipsea, males use their midlegs to tap the female head and thorax...\"")
SubClassOf(obo:ACTAN_0000430 obo:ACTAN_0000860)
SubClassOf(obo:ACTAN_0000430 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0002246))

# Class: obo:ACTAN_0000431 (show modality)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000431 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000431 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000431 "2024-11-12T20:47:54.252607Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1017/S1464793104006700") oboInOwl:hasDefinition obo:ACTAN_0000431 "Modality that involves visually conspicuous movement and posture.

It is not simply a morphological feature providing an unintentional cue.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000431 "showing")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "doi:10.1017/S1464793104006700") oboInOwl:hasExactSynonym obo:ACTAN_0000431 "visual signal")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasRelatedSynonym obo:ACTAN_0000431 "visual display")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000431 "show modality")
AnnotationAssertion(Annotation(dc:source "doi:10.1017/S1464793104006700") skos:example obo:ACTAN_0000431 "\"In Maevia inclemens, an unusual species with two male morphs, experiments suggested that females have no preference for either morph but simply for the male that moves first. Different morphs appear to use alternative strategies to stimulate different fields of the female visual range, using different postures at different distances from the female.\"")
SubClassOf(obo:ACTAN_0000431 obo:ACTAN_0000117)
SubClassOf(obo:ACTAN_0000431 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000463))

# Class: obo:ACTAN_0000432 (vocalization sound)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000432 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000432 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000432 "2024-11-12T11:39:42.69642Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1111/brv.12891") Annotation(skos:scopeNote "\"Sound created by ‘forced air’ is used across animals... Other caterpillars ‘vocalise’ when attacked, by forcing air out of their gut.\"") oboInOwl:hasDefinition obo:ACTAN_0000432 "Sound that is created by forced air.")
AnnotationAssertion(Annotation(dc:date "2019"^^xsd:decimal) Annotation(dc:source "doi:10.1163/1568539X-00003574") oboInOwl:hasExactSynonym obo:ACTAN_0000432 "vocalisation")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10071-014-0761-0") oboInOwl:hasExactSynonym obo:ACTAN_0000432 "vocalising")
AnnotationAssertion(Annotation(dc:date "1955"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/4081601") oboInOwl:hasExactSynonym obo:ACTAN_0000432 "vocalization"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000432 "vocalization sound")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/beheco/12.5.534") skos:example obo:ACTAN_0000432 "\"Alaskan humpback whales (Megaptera novaengliae), when hunting Pacific herring, sometimes work as a team to perform two basic subtasks: prey herding and bubble blowing. Most whales perform the herding subtask and search along the sea bottom for herring schools above them. The group then initiates an attack by rushing the prey while issuing loud calls. The herring swim upward in an attempt to escape, but at the same time another whale, the bubble blower, swims in a circle above the school and deploys a curtain of air which both traps the prey and channels them to the surface, whereupon all the whales feed on the herring. Interestingly, this strategy not only involves precise spatiotemporal coordination between the herders and bubble blower, but the bubble blower, vocalizer(s), and herders all appear to specialize in their subtasks.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/1568539X-00003574") skos:example obo:ACTAN_0000432 "\"Female Lyrebirds exhibit an impressive array of elaborate mimetic and species-specific vocalisations, suspected to play an important role in territory defence...\"")
SubClassOf(obo:ACTAN_0000432 obo:ACTAN_0000425)
SubClassOf(obo:ACTAN_0000432 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000715))

# Class: obo:ACTAN_0000433 (song regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000433 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000433 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000433 "2024-11-12T11:39:54.72575Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/s10988-025-09438-8") oboInOwl:hasDefinition obo:ACTAN_0000433 "Sound-regime that involves an individual composition of acoustic components.

Some may be non-trivial, or involve a different meaning than the simple combination of meanings.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000433 "singing"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000433 "song")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000433 "song regime")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10988-025-09438-8") skos:example obo:ACTAN_0000433 "\"Japanese tits (Parus minor) have ABC calls that raise alarms, D calls that trigger recruitment, and ABC-D calls that are derived from ABC and D by way of non-trivial compositionality, and trigger mobbing of certain predators.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:scopeNote obo:ACTAN_0000433 "\"Here, recent advances in recording and analysis techniques allowed authors to quantify song differences in closely related species and ⁄ or populations and the results suggest that in insects acoustic signals can evolve as quickly as sexually dimorphic structures.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/978-3-319-68576-2_3") skos:scopeNote obo:ACTAN_0000433 "\"This variation can either be an adaptive characteristic of a species- or population-specific signal (e.g., a distinct floral scent) or the result of an individual modulating its signal in real time in response to current acoustic or olfactory “clutter” (e.g., modulating a bird song frequency to avoid overlap with noise.\"")
SubClassOf(obo:ACTAN_0000433 obo:ACTAN_0000131)
SubClassOf(obo:ACTAN_0000433 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000398))
SubClassOf(obo:ACTAN_0000433 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000543))
SubClassOf(obo:ACTAN_0000433 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

# Class: obo:ACTAN_0000434 (call vocalization)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000434 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000434 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000434 "2024-11-12T11:40:08.914113Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasDefinition obo:ACTAN_0000434 "Vocalization that involves the respiratory system.")
AnnotationAssertion(Annotation(dc:date "1965"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853965x00138") oboInOwl:hasExactSynonym obo:ACTAN_0000434 "calling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000434 "call vocalization")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000434 "\"Chimpanzee...
...various calls which are linked by audible inhalations and which may be described as vocalized pant.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000434 "\"Lorenz described the \"going-away call\" of the female Mallard which consisted of a series of \"quacks\" and is given especially before flight...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:scopeNote obo:ACTAN_0000434 "\"Elaborate courtship behaviours – often involving visual cues – have been described for various groups of salamanders, mammals, birds and fishes while olfactory and tactile signals are particularly important for many mammal species and songs and calls for the mating behaviour of birds and anurans.\"")
SubClassOf(obo:ACTAN_0000434 obo:ACTAN_0000432)
SubClassOf(obo:ACTAN_0000434 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000780))

# Class: obo:ACTAN_0000435 (hiss vocalization)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000435 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000435 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000435 "2024-11-12T11:40:21.55518Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/s00265-019-2778-5") Annotation(rdfs:comment "Some information was obtained from the publisher's online supplementary material.") oboInOwl:hasDefinition obo:ACTAN_0000435 "Vocalization that is harsh, atonal (wide frequency bandwidth), and high frequency skewed.")
AnnotationAssertion(Annotation(dc:date "1966"^^xsd:decimal) Annotation(dc:source "doi:10.2307/4083155") oboInOwl:hasExactSynonym obo:ACTAN_0000435 "hissing"@en)
AnnotationAssertion(Annotation(dc:date "2020"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00265-019-2778-5") rdfs:label obo:ACTAN_0000435 "hiss vocalization")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000435 obo:ACTAN_0000779)
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") skos:scopeNote obo:ACTAN_0000435 "\"Hole-nesting birds of different families may exhibit similarities which are adaptive to this mode of life, e.g., gaping of the young at the darkening of the nest hole as occurs when the parents arrive, loud begging calls, and notes resembling the hissing of a snake.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000435 "\"Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.\"")
SubClassOf(obo:ACTAN_0000435 obo:ACTAN_0000432)
SubClassOf(obo:ACTAN_0000435 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000380))
SubClassOf(obo:ACTAN_0000435 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001528))

# Class: obo:ACTAN_0000436 (stroke wipe)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000436 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000436 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000436 "2024-11-12T15:28:07.150649Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") oboInOwl:hasDefinition obo:ACTAN_0000436 "Wipe that moves a body part extensively across an object.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000436 "stroke"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000436 "stroke wipe"@en)
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000436 "\"In Nyctanassa violacea, \"the herons stood side by side and exchanged stroking gestures in which each passed the side of the beak downwards against the primaries of the other's folded wing\".\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:scopeNote obo:ACTAN_0000436 "\"Midleg interaction with female thorax - 0: Absent; 1: Midlegs tap lateral surface (singular movements); 2: Midlegs ‘stroke’ lateral surface (extended rubbing); 3: Midlegs ‘stroke’ dorsal surface (extended rubbing).\"")
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:scopeNote obo:ACTAN_0000436 "\"The bird indulged in five brief, successive periods of anting, between each of which it flew to a bath, where it crouched and turned about in the water, stroking its primaries with the bill and shedding ants into the water.\"")
SubClassOf(obo:ACTAN_0000436 obo:ACTAN_0000784)
SubClassOf(obo:ACTAN_0000436 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000374))
SubClassOf(obo:ACTAN_0000436 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000498))

# Class: obo:ACTAN_0000437 (aerobatics regime)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000437 <https://github.com/Active-Animals/Ontology/patterns/locomotion_realizing_regime>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000437 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000437 "2024-11-12T21:24:42.369963Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1002/bies.202000183") oboInOwl:hasDefinition obo:ACTAN_0000437 "Flying-regime whose exaggerated, vigorous manoeuvres appear to push the animal to its energetic limits.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1002/bies.202000183") oboInOwl:hasExactSynonym obo:ACTAN_0000437 "aerobatic display"@en)
AnnotationAssertion(Annotation(dc:date "2017"^^xsd:decimal) Annotation(dc:source "doi:10.1007/978-3-319-68576-2_3") oboInOwl:hasRelatedSynonym obo:ACTAN_0000437 "song flights")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000437 "aerobatics regime"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/978-3-319-68576-2_3") skos:example obo:ACTAN_0000437 "\"Many birds have song flights and elaborate aerial displays, including the roding display of the Eurasian woodcock (Scolopax rusticola), the dive and shuttle of Anna’s hummingbird (Calypte anna), and the sky dancing of the Montagu’s harrier (Circus pygargus).\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/bies.202000183") skos:scopeNote obo:ACTAN_0000437 "\"The aerobatic dives and high-energy courtship displays of hummingbirds appear to push males towards the limits of flight performance.\"")
SubClassOf(obo:ACTAN_0000437 obo:ACTAN_0000076)
SubClassOf(obo:ACTAN_0000437 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000150))
SubClassOf(obo:ACTAN_0000437 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000645))
SubClassOf(obo:ACTAN_0000437 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000543))
SubClassOf(obo:ACTAN_0000437 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000929))

# Class: obo:ACTAN_0000438 (influence interaction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000438 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000438 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000438 "2024-11-17T11:16:09.991698Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"Tilapia natalensis...
Inviting turns into leading when the intruder does not change its attitude. It apparently has no influence on the behaviour of the male whether the intruder shows the non-reproductive markings or the female reproductive markings.\"") oboInOwl:hasDefinition obo:ACTAN_0000438 "Interaction which attempts to change the behaviour of another.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000438 "influence"@en)
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2022.1066186") oboInOwl:hasNarrowSynonym obo:ACTAN_0000438 "managing")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") Annotation(skos:scopeNote "\"Other kinds of interactions may influence the choice of alternatives.\"") rdfs:label obo:ACTAN_0000438 "influence interaction"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2022.1066186") skos:scopeNote obo:ACTAN_0000438 "\"For some the ‘communication as information’ vs ‘communication as manipulation’ debate is largely one of semantics, for others communication involves both information and manipulation, and for others the debate raises some fundamental ideas about how communicative interactions actually influence behavior and shape interactions and relationships among individuals.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2022.1066186") skos:scopeNote obo:ACTAN_0000438 "\"More complex groups often demand increased social cognition in group members; therefore, in such groups we should expect strong selection for enhanced communicative systems that provide individuals diverse behavioral ways to assess and manage the behavior of others.\"")
SubClassOf(obo:ACTAN_0000438 obo:ACTAN_0000383)
SubClassOf(obo:ACTAN_0000438 ObjectSomeValuesFrom(obo:BFO_0000055 <http://humanbehaviourchange.org/ontology/BCIO_050654>))

# Class: obo:ACTAN_0000439 (warning influence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000439 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000439 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000439 "2024-11-17T11:18:24.420726Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"The earliest and most currently accepted hypothesis is that the rattle evolved as an aposematic signal to warn potential predators and large, grazing ungulates that might step on the otherwise unnoticed snake of its venomousness and potential danger.\"") oboInOwl:hasDefinition obo:ACTAN_0000439 "Influence that signals a potential danger.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000439 "warning"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000439 "warning influence"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000439 obo:ACTAN_0000376)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:scopeNote obo:ACTAN_0000439 "\"It is admitted that the rattlesnake has a poison-fang for its own defence and for the destruction of its prey; but some authors suppose that at the same time this snake is furnished with a rattle for its own injury, namely, to warn its prey to escape. I would almost as soon believe that the cat curls the end of its tail when preparing to spring, in order to warn the doomed mouse.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000439 "\"There is also evidence that alarm pheromones found in the discharge might serve to warn conspecifics of a predator threat...\"")
SubClassOf(obo:ACTAN_0000439 obo:ACTAN_0000438)
SubClassOf(obo:ACTAN_0000439 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000382))
SubClassOf(obo:ACTAN_0000439 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000414))

# Class: obo:ACTAN_0000440 (predator-alarm warning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000440 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000440 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000440 "2024-11-17T11:18:56.782875Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasDefinition obo:ACTAN_0000440 "Warning that signals alarm of a predator threat.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasNarrowSynonym obo:ACTAN_0000440 "conspecific alarm signal")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasRelatedSynonym obo:ACTAN_0000440 "shreckstoff")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"...alarm pheromones found in the discharge might serve to warn conspecifics of a predator threat...\"") rdfs:label obo:ACTAN_0000440 "predator-alarm warning"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000440 "NBO:0020015")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000440 "\"There is also evidence that alarm pheromones found in the discharge might serve to warn conspecifics of a predator threat (Graves and Duvall, 1988), parallel to the shreckstoff (Mathis and Smith, 1993) found in fishes and chemical communication of stress found in larval salamanders and tadpoles.\"")
SubClassOf(obo:ACTAN_0000440 obo:ACTAN_0000439)
SubClassOf(obo:ACTAN_0000440 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000375))

# Class: obo:ACTAN_0000441 (attraction influence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000441 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000441 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000441 "2024-11-17T11:22:19.499717Z")
AnnotationAssertion(Annotation(dc:source "doi:10.2307/4083155") Annotation(skos:scopeNote "\"Distance-reducing displays are particularly important in promoting social bonds between members of a pair, young and parent, etc.\"") oboInOwl:hasDefinition obo:ACTAN_0000441 "Influence which tends to cause another animal to reduce its distance.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000441 "attracting")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000441 "attraction"@en)
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasNarrowSynonym obo:ACTAN_0000441 "advertising")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasNarrowSynonym obo:ACTAN_0000441 "close proximity display")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasNarrowSynonym obo:ACTAN_0000441 "long distance communicative display")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasNarrowSynonym obo:ACTAN_0000441 "short distance display")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasRelatedSynonym obo:ACTAN_0000441 "appetitive"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000441 "attraction influence")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000441 obo:ACTAN_0000326)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000441 obo:ACTAN_0000471)
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000441 "\"...T.bifasciatum \"loopings\" are performed even in the absence of females and apparently serve to announce the presence and location of the territorial male.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") skos:example obo:ACTAN_0000441 "\"A chimpanzee shakes a branch to attract attention or to court.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000441 "\"Amongst birds, the contest is often of a more peaceful character. All those who have attended to the subject, believe that there is the severest rivalry between the males of many species to attract by singing the females. The rock-thrush of Guiana, birds of Paradise, and some others, congregate; and successive males display their gorgeous plumage and perform strange antics before the females, which standing by as spectators, at last choose the most attractive partner.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000441 "NBO:0000280")
AnnotationAssertion(Annotation(dc:source "ISBN:9780226315737") skos:scopeNote obo:ACTAN_0000441 "\"...Diamond (1985) speculated on the possible advantages of luminescent tissue in attracting prey...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00265-010-0980-6") skos:scopeNote obo:ACTAN_0000441 "\"Our results contradict previous ideas that the sexual pheromone of receptive female guppies increases courtship and other mating behaviours in males. We suggest that the main function of this pheromone is to attract males to receptive females rather than to stimulate an increase in their mating effort.\"")
SubClassOf(obo:ACTAN_0000441 obo:ACTAN_0000438)
SubClassOf(obo:ACTAN_0000441 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000414))

# Class: obo:ACTAN_0000442 (skittering gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000442 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000442 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000442 "2026-07-21T08:50:26.753115Z")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasBroadSynonym obo:ACTAN_0000442 "skimming")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5962/p.203769") Annotation(skos:scopeNote "\"Here the pectorals are only sufficient to raise the weight of the head and forepart of the body into the air, leaving the tail submerged. The bulk of the fish being in the air, reduces head resistance considerably, while the tail still has the advantages of operating in the denser medium.\"") oboInOwl:hasDefinition obo:ACTAN_0000442 "Interfacing-gait in which the pectoral fins raise the head and forepart of the body into the air, leaving the tail operating submerged.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000442 "skittering")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000442 "skittering gait"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/p.203769") skos:example obo:ACTAN_0000442 "\"Tylosurus marinus... This genus and its relatives, more especially the hemiramphids, are expert at leaping and skittering over the surface of the sea. Their bodies are held at an angular elevation from the surface of about 30° or even more in an extremely rigid manner and their submerged tail is vibrated rapidly. This is usually alternated with short leaps from which they alight tail first for further activity, or may sometimes plunge head first for submersion.\"")
SubClassOf(obo:ACTAN_0000442 obo:ACTAN_0000155)
SubClassOf(obo:ACTAN_0000442 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000189))
SubClassOf(obo:ACTAN_0000442 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000421))
SubClassOf(obo:ACTAN_0000442 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000026))
SubClassOf(obo:ACTAN_0000442 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000528))

# Class: obo:ACTAN_0000443 (breeding context)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000443 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000443 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000443 "2024-11-17T11:24:38.891715Z")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasBroadSynonym obo:ACTAN_0000443 "reproduction")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasBroadSynonym obo:ACTAN_0000443 "reproductive activity")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasDefinition obo:ACTAN_0000443 "Context in which a reproductive strategy is contested.")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000443 "breeding"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000443 "breeding context"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000443 "\"Even slow-breeding man has doubled in twenty-five years, and at this rate, in a few thousand years, there would literally not be standing room for his progeny.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/bc60659126ef5c0172c2392d485b0c9b/1?pq-origsite=gscholar&cbl=18750") skos:scopeNote obo:ACTAN_0000443 "\"In context of seasonality, the breeding period seems to be a result of differential rates of gamete development.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:scopeNote obo:ACTAN_0000443 "\"It was Darwin (1872) who first pointed out that social competition, like artificial selection, acts as a screening process by which the most successful breeders are chosen from among interacting members of a population. This screening process is mediated by direct interaction—sometimes by overt fighting, but more often by ritualized contests and elaborate displays.\"")
SubClassOf(obo:ACTAN_0000443 obo:ACTAN_0000751)
SubClassOf(obo:ACTAN_0000443 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000077))

# Class: obo:ACTAN_0000444 (pattern hydraulics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000444 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000444 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000444 "2024-11-17T11:25:37.459038Z")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasBroadSynonym obo:ACTAN_0000444 "building in sand"@en)
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.5343/bms.2014.1055") oboInOwl:hasBroadSynonym obo:ACTAN_0000444 "creating sand pattern")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.5343/bms.2014.1055") oboInOwl:hasBroadSynonym obo:ACTAN_0000444 "sand construction")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.5343/bms.2014.1055") Annotation(skos:scopeNote "\"“F” means male stirring up of fine sand particles, creating irregular pattern on the nest;\"") oboInOwl:hasDefinition obo:ACTAN_0000444 "Hydraulics which stirs up particles, creating a pattern.")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000444 "pattern hydraulics"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.5343/bms.2014.1055") skos:example obo:ACTAN_0000444 "\"...males of the pufferfish, Torquigener albomaculosus Matsuura, 2014... constructed a large (approximately 2 m in diameter) geometric circular structure on the seabed. The male dug valleys at various angles in a radial direction, constructing a nest surrounded by radially aligned peaks and valleys...\"")
SubClassOf(obo:ACTAN_0000444 obo:ACTAN_0001034)
SubClassOf(obo:ACTAN_0000444 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000060))

# Class: obo:ACTAN_0000445 (decoration placing)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000445 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000445 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000445 "2024-11-17T11:26:55.783001Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasDefinition obo:ACTAN_0000445 "Placing that aesthetically assembles objects.")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1163/000579509X12512865686555") oboInOwl:hasExactSynonym obo:ACTAN_0000445 "decoration")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1111/tops.12554") oboInOwl:hasExactSynonym obo:ACTAN_0000445 "place decor"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") Annotation(rdfs:comment "1999"^^xsd:decimal) oboInOwl:hasRelatedSynonym obo:ACTAN_0000445 "adorning")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") oboInOwl:hasRelatedSynonym obo:ACTAN_0000445 "ornamenting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000445 "decoration placing")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000445 obo:ACTAN_0000276)
AnnotationAssertion(Annotation(dc:source "doi:10.1111/eth.12882") skos:example obo:ACTAN_0000445 "\"A more sophisticated case of exploitation of a courtship receiver's perception has been suggested in the case of the great bowerbird (Ptilonorhynchus nuchalis), where males place objects in a particular size order when building the court in front of their display avenue, creating a visual illusion which might make the displaying male look larger than he really is.\"")
SubClassOf(obo:ACTAN_0000445 obo:ACTAN_0000395)
SubClassOf(obo:ACTAN_0000445 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001300))

# Class: obo:ACTAN_0000446 (performance signal)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000446 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000446 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000446 "2024-11-17T20:02:19.482711Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:isDefinedBy "doi:10.3389/fetho.2022.1066186") Annotation(skos:scopeNote "\"For some the ‘communication as information’ vs ‘communication as manipulation’ debate is largely one of semantics, for others communication involves both information and manipulation, and for others the debate raises some fundamental ideas about how communicative interactions actually influence behavior and shape interactions and relationships among individuals.\"") oboInOwl:hasDefinition obo:ACTAN_0000446 "Signal in which a communicative interaction iteratively influences a relationship.")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") Annotation(skos:scopeNote "\"...behaviours that mediate the flow of information...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000446 "information flow mediation"@en)
AnnotationAssertion(Annotation(dc:date "1955"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/4081601") oboInOwl:hasExactSynonym obo:ACTAN_0000446 "performance")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000446 "performing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000446 "performance signal"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000446 obo:ACTAN_0000118)
SubClassOf(obo:ACTAN_0000446 obo:ACTAN_0000414)
SubClassOf(obo:ACTAN_0000446 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000438))

# Class: obo:ACTAN_0000447 (social buffering)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000447 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000447 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000447 "2024-11-17T11:34:01.559136Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3389/fetho.2023.1181774") Annotation(skos:scopeNote "\"Social buffering comprises the reduction of stress an organism experiences when in the presence of a companion and has been well documented in highly social animals, such as birds and mammals.\"") oboInOwl:hasDefinition obo:ACTAN_0000447 "Buffering that comprises the reduction of stress an organism experiences when in the presence of a companion.")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") oboInOwl:hasExactSynonym obo:ACTAN_0000447 "stress buffering")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1181774") rdfs:label obo:ACTAN_0000447 "social buffering"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") skos:example obo:ACTAN_0000447 "\"...greylag geese (Anser anser) show both a separation response and stress buffering...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000447 "\"Cichlids...
Older fish also form schools when the conditions are unfavourable to reproduction... The worse the conditions, the denser the school becomes.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") skos:example obo:ACTAN_0000447 "\"Other studies of peer affiliation in female prairie voles found that a same-sex partner could buffer the effects of stress.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:scopeNote obo:ACTAN_0000447 "\"The type of social organization (e.g., mating system and group size), however, can influence both the presence of social buffering and which conspecifics demonstrate the ability to buffer. Many species undergo seasonal shifts in social organization.\"")
SubClassOf(obo:ACTAN_0000447 obo:ACTAN_0000112)
SubClassOf(obo:ACTAN_0000447 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000411))

# Class: obo:ACTAN_0000448 (network participation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000448 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000448 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000448 "2024-11-17T11:35:14.730572Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3389/fetho.2022.1066186") Annotation(skos:scopeNote "\"Recent advances in social network approaches are now putting us in a position to understand better how networks of signaling relate to networks of other social behavior (such as affiliations or agonistic interactions), and this should help us  better understand how social interactions build into the social relationships that create the structure of groups.\"") oboInOwl:hasDefinition obo:ACTAN_0000448 "Participation that involves the structure of a group's relationships.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2022.1066186") oboInOwl:hasExactSynonym obo:ACTAN_0000448 "networking"@en)
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2011.0690") oboInOwl:hasExactSynonym obo:ACTAN_0000448 "social network")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000448 "network participation")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2019.12.009") skos:scopeNote obo:ACTAN_0000448 "\"...territory is socially constructed through interactions among individuals...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2011.0690") skos:scopeNote obo:ACTAN_0000448 "\"Different mechanisms may explain the effect of social isolation on aggressiveness, including an increased sensitivity to external stimuli that may act as releasers of aggressive behavior, or forgetting prior social experiences that are the basis for dominance hierarchies that regulate social interactions in social networks.\"")
SubClassOf(obo:ACTAN_0000448 obo:ACTAN_0000409)
SubClassOf(obo:ACTAN_0000448 ObjectSomeValuesFrom(obo:RO_0000057 obo:PCO_0000000))

# Class: obo:ACTAN_0000449 (mate-guarding courtship)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000449 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000449 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000449 "2024-11-17T11:36:14.405456Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/s00265-014-1841-5") oboInOwl:hasDefinition obo:ACTAN_0000449 "Courtship in which a male remains close to a female for a prolonged period. 

This will usually be when she is receptive, in the context of sperm competition, and may involve fighting encroaching males.")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasExactSynonym obo:ACTAN_0000449 "mate guarding"@en)
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasNarrowSynonym obo:ACTAN_0000449 "harem guarding")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasNarrowSynonym obo:ACTAN_0000449 "post-copulatory mate guarding")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1371/journal.pone.0083116") oboInOwl:hasNarrowSynonym obo:ACTAN_0000449 "post-insemination mate guarding")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10164-009-0176-6") oboInOwl:hasNarrowSynonym obo:ACTAN_0000449 "pre-copulatory mate guarding")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") oboInOwl:hasNarrowSynonym obo:ACTAN_0000449 "precopulatory guarding")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1011074716758") oboInOwl:hasNarrowSynonym obo:ACTAN_0000449 "securing females")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasRelatedSynonym obo:ACTAN_0000449 "dominance")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/beheco/12.5.534") oboInOwl:hasRelatedSynonym obo:ACTAN_0000449 "escorting")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasRelatedSynonym obo:ACTAN_0000449 "mate protection")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000449 "mate-guarding courtship"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000449 obo:ACTAN_0000385)
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") rdfs:seeAlso obo:ACTAN_0000449 obo:ACTAN_0000829)
AnnotationAssertion(Annotation(dc:source "doi:10.1017/S1464793104006700") skos:example obo:ACTAN_0000449 "\"In Metellina segmentata, males assess female quality (size and nearness to moult) before deciding on whether to guard or leave the female. In the congeneric M. mengei, the guarding male adjusts his fight tactics against intruders according to the reproductive value of the female, increasing fight intensity and duration with his mate’s body mass.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/beheco/12.5.534") skos:example obo:ACTAN_0000449 "\"In olive baboons, two lower ranking males sometimes form a team to gain access to estrous females. The troop’s dominant male usually escorts such females.\"")
AnnotationAssertion(Annotation(dc:date "2021"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.yhbeh.2021.105062") skos:example obo:ACTAN_0000449 "\"Male dik-diks are more territorial than their female counterparts: they engage in the majority of territorial scent marking and aggressively guard their mates during estrus.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:example obo:ACTAN_0000449 "\"Male western diamondback rattlesnakes (Crotalus atrox) have been observed mate-guarding females, which likely occurs in other rattlesnake species as well.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:scopeNote obo:ACTAN_0000449 "\"...harems are established and a rigid hierarchy is maintained based on the dominance of a single male over a group of females.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:scopeNote obo:ACTAN_0000449 "\"Yet, these single-species studies imply that the courtship in sepsid flies can be quite elaborate and may include male displays and precopulatory guarding.\"")
SubClassOf(obo:ACTAN_0000449 obo:ACTAN_0000472)
SubClassOf(Annotation(dc:source "doi:10.1089/zeb.2012.0861") Annotation(skos:scopeNote "\"...protecting resources (e.g., females)...\"") obo:ACTAN_0000449 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000924))

# Class: obo:ACTAN_0000450 (mate-choice mating)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000450 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000450 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000450 "2024-11-17T11:38:45.64893Z")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasBroadSynonym obo:ACTAN_0000450 "sexual selection")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"Different authors... have suggested that the crowding together of the territories probably offers the female an opportunity to select her mate after comparison.\"") oboInOwl:hasDefinition obo:ACTAN_0000450 "Mating in which a mate is selected after comparison.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000450 "mate choice")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...select her mate...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000450 "mate selection")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...selecting the right partner...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000450 "partner selection")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasNarrowSynonym obo:ACTAN_0000450 "female choice"@en)
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00265-010-0980-6") oboInOwl:hasRelatedSynonym obo:ACTAN_0000450 "female consent")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasRelatedSynonym obo:ACTAN_0000450 "receptiveness")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasRelatedSynonym obo:ACTAN_0000450 "receptivity")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasRelatedSynonym obo:ACTAN_0000450 "unreceptive")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000450 "mate-choice mating")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000450 "\"...in T.bifasciatum, free female mate choice and the need for males to compete for spawnings has led to the development of specific male sexual displays and coloration, and an active role of males in courtship activities. Females, on the other hand, lack a special sexual color pattern and well-developed sexual displays, and play a quiescent role in courtship.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1674/0003-0031(2000)144[0187:SBITBC]2.0.CO;2") skos:example obo:ACTAN_0000450 "\"Approach... Nocomis leptocephalus... Although a female might swim towards the nest from any direction, she always approached the postured male from downstream.\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:scopeNote obo:ACTAN_0000450 "\"...a bird can recognise whether a member of the opposite sex is ready to pair or not. In most species, sexual receptiveness is signalled by behavioural changes...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2022.1066186") skos:scopeNote obo:ACTAN_0000450 "\"Outside of the realms of studies of mate choice related to signal variation and studies of predator behavior related to prey cue variation, most of the focus of research on animal communication had traditionally been on the sender and the signal it produces.\"")
SubClassOf(obo:ACTAN_0000450 obo:ACTAN_0000471)
SubClassOf(obo:ACTAN_0000450 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000326))

# Class: obo:ACTAN_0000451 (aposematism warning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000451 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000451 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000451 "2024-11-17T12:14:46.960881Z")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasBroadSynonym obo:ACTAN_0000451 "aposematic cue"@en)
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"An aposematic signal is a form of communication, or advertisement, to a predator or other aggressor that there is a net cost for interference with the signaler.\"") oboInOwl:hasDefinition obo:ACTAN_0000451 "Warning that signals to an aggressor that there is a net cost for interference with the signaler.")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000451 "aposematic signal"@en)
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2014.08.051") oboInOwl:hasExactSynonym obo:ACTAN_0000451 "aposematic warning")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasNarrowSynonym obo:ACTAN_0000451 "aposematic display"@en)
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "doi:10.1017/S1464793104006700") oboInOwl:hasRelatedSynonym obo:ACTAN_0000451 "aposematism")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000451 "aposematism warning")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000451 "NBO:0020287")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000451 "\"In this way, the predator learns to associate the aposematic cue with a painful experience and will in the future avoid animals that exhibit that signal. Or, in the case of a lethal cost to the transgressor, a species may evolve an innate avoidance to the aposematic signal. To fit the criteria for function as an aposematic cue, a signal should be conspicuous, it.must be unambiguously associated with the communicator, and there must be a potential cost to the recipient of the signal.\"")
SubClassOf(obo:ACTAN_0000451 obo:ACTAN_0000439)
SubClassOf(Annotation(dc:source "doi:10.1098/rspb.2015.2890") obo:ACTAN_0000451 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000463))

# Class: obo:ACTAN_0000452 (food-detection assistance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000452 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000452 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000452 "2024-11-17T20:02:37.569683Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.3389/fetho.2022.1066186") Annotation(skos:scopeNote "\"Unlike cues, signals have evolved for the particular communicative function they serve. As a few examples consider the anti-predatory alarm signals in vervet monkeys, Chlorocebus pygerythrus, mate attraction signals in stalk-eyed flies, Cyrtodiopsis dalmanni, and food detection signals in ravens, Corvus corax...\"") oboInOwl:hasDefinition obo:ACTAN_0000452 "Assistance that signals the detection of food.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2022.1066186") oboInOwl:hasNarrowSynonym obo:ACTAN_0000452 "food detection signaling"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000452 "food-detection assistance"@en)
AnnotationAssertion(skos:broadMatch obo:ACTAN_0000452 "NBO:0020088")
SubClassOf(obo:ACTAN_0000452 obo:ACTAN_0000878)
SubClassOf(obo:ACTAN_0000452 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000446))

# Class: obo:ACTAN_0000453 (confusion manipulation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000453 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000453 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000453 "2024-11-17T20:22:46.529186Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/brv.12891") oboInOwl:hasDefinition obo:ACTAN_0000453 "Manipulation in which signaling causes sensory overload in another, hindering its subsequent behaviour.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000453 "bewildering")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1111/brv.12891") oboInOwl:hasExactSynonym obo:ACTAN_0000453 "confusion")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000453 "disorienting"@en)
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "ISBN:9789798105975") oboInOwl:hasRelatedSynonym obo:ACTAN_0000453 "confusing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000453 "confusion manipulation")
AnnotationAssertion(Annotation(dc:source "https://www.science.nus.edu.sg/wp-content/uploads/sites/11/2024/05/s22rbz145-157.pdf") skos:example obo:ACTAN_0000453 "\"...gobies on D. gemmacea could take advantage of its complex multiple-branching structure to confuse predators and avoid detection by switching from one branch to another.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000453 "NBO:0020079")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000453 "\"Greene (1973) categorized defensive tail displays of snakes into three major functions: 1) to divert attack toward the tail, 2) to inhibit attack with an aposematic display, and 3) to disorient the predator with a flash display.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/brv.12891") skos:scopeNote obo:ACTAN_0000453 "\"II. What is deimatic behaviour?...
(7) Mechanisms by which predators respond to initial encounters with deimatic behaviour...
(e) Confusion effect\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/bc60659126ef5c0172c2392d485b0c9b/1?pq-origsite=gscholar&cbl=18750") skos:scopeNote obo:ACTAN_0000453 "\"The functional importance of synchrony in these ecological and biological systems varies from optimizing  reproduction, reducing energetic costs, confusing predators, and regulating a density profile.\"")
SubClassOf(obo:ACTAN_0000453 obo:ACTAN_0000464)
SubClassOf(obo:ACTAN_0000453 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000414))

# Class: obo:ACTAN_0000454 (repelling influence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000454 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000454 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000454 "2024-11-17T20:23:06.249145Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1590/S1679-62252011005000018") oboInOwl:hasDefinition obo:ACTAN_0000454 "Influence which causes an intruder to withdraw.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000454 "repelling"@en)
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasRelatedSynonym obo:ACTAN_0000454 "rejecting")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000454 "repelling influence"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000454 obo:ACTAN_0000386)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000454 obo:ACTAN_0000457)
AnnotationAssertion(Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") skos:example obo:ACTAN_0000454 "\"...ants prey upon, and their acids repel, ectoparasites;\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2021.09.082") skos:scopeNote obo:ACTAN_0000454 "\"Costs of architecture can be divided into three main types: construction costs (the original costs of building the structure); maintenance costs (the costs of keeping the structure intact as well as repairing it in the event of damage); and defense costs (the costs of repelling intruders, including conspecifics who may attempt to take possession of the structure without having paid any of the original construction costs).\"")
SubClassOf(obo:ACTAN_0000454 obo:ACTAN_0000438)
SubClassOf(obo:ACTAN_0000454 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000893))

# Class: obo:ACTAN_0000455 (constraint influence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000455 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000455 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000455 "2024-11-17T20:23:32.32715Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasDefinition obo:ACTAN_0000455 "Influence that prevents another from probable activity.")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3389/fetho.2023.1231780") oboInOwl:hasExactSynonym obo:ACTAN_0000455 "constraint"@en)
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasNarrowSynonym obo:ACTAN_0000455 "deterrent")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000455 "inhibition")
AnnotationAssertion(Annotation(dc:date "1976"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1439-0310.1976.tb00970.x") oboInOwl:hasNarrowSynonym obo:ACTAN_0000455 "interference")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000455 "retarding")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasRelatedSynonym obo:ACTAN_0000455 "preventing")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000455 "constraint influence")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000455 "\"Cichlasoma bimaculatum...
...the fact that the mates often know each other personally... is responsible for the inhibition of the hostility in the male.\"")
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000455 "\"In the case of. animals which rely largely on olfaction to locate prey, the dirt and stink of a heronry must be an effective deterrent.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1231780") skos:scopeNote obo:ACTAN_0000455 "\"Prey can reduce the risk of predation by moving to habitats where predators are less likely to detect them, less likely to attack, or less likely to succeed. The interaction of such responses to risk with other ecological processes remains relatively unstudied, but in some cases, changes in habitat use to avoid predation may be constrained by competition: larger, dominant competitors should respond freely to predation risk, but the responses of smaller, subordinate competitors may be constrained by the responses of dominant competitors.\"")
SubClassOf(obo:ACTAN_0000455 obo:ACTAN_0000438)
SubClassOf(obo:ACTAN_0000455 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000553))

# Class: obo:ACTAN_0000456 (distraction manipulation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000456 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000456 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000456 "2024-11-17T20:23:53.769664Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/1568539X-00003176") oboInOwl:hasDefinition obo:ACTAN_0000456 "Manipulation that redirects another's attention and subsequent behaviour.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000456 "distracting")
AnnotationAssertion(Annotation(dc:date "1988"^^xsd:decimal) Annotation(dc:source "doi:10.1126/science.239.4847.1525") oboInOwl:hasExactSynonym obo:ACTAN_0000456 "distraction")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000456 "diverting"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1163/1568539X-00003176") Annotation(rdfs:comment "This class is about redirecting another's behaviour, which should not be confused with the internal mechanism causing an animal to redirect its own behaviour.") Annotation(rdfs:seeAlso obo:ACTAN_0000707) oboInOwl:hasRelatedSynonym obo:ACTAN_0000456 "redirection")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000456 "distraction manipulation")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000456 "\"Mother grooms infant to divert its attention from sucking from nipples during the weaning period. If the infant is male and he throws temper tantrums in response to his mother's refusal, she sometimes allows him to copulate with her.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000456 "NBO:0020219")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000456 "\"Greene (1973) categorized defensive tail displays of snakes into three major functions: 1) to divert attack toward the tail, 2) to inhibit attack with an aposematic display, and 3) to disorient the predator with a flash display.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/1568539X-00003176") skos:scopeNote obo:ACTAN_0000456 "\"Thus, an initial victim may benefit most by performing redirected aggression if doing so reduces its total suffering from renewed aggression. By performing redirection, a victim can change its status from victim to aggressor. The bystanders might then shift their attention to the next victim; thus, the initial victim may be able to avoid renewed aggression from them.\"")
SubClassOf(obo:ACTAN_0000456 obo:ACTAN_0000464)
SubClassOf(obo:ACTAN_0000456 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000414))

# Class: obo:ACTAN_0000457 (threat warning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000457 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000457 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000457 "2024-11-17T20:24:12.823017Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasDefinition obo:ACTAN_0000457 "Warning that represents the potential to attack.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000457 "threat")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000457 "threatening"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000457 "threat warning"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000457 obo:ACTAN_0000386)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000457 "NBO:0020108")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000457 "\"Cichlasoma meeki...
Whenever the fish is threatening, seven black vertical bands appear...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1444-2906.2003.00797.x") skos:example obo:ACTAN_0000457 "\"Red sea bream Pagrus major and crimson sea bream, Evynnis japonica...

The territory holder threatens the invaders by slightly dipping its head.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") skos:scopeNote obo:ACTAN_0000457 "\"Tools can be used to create and mediate influence interactions: a brandished stick might communicate a more effective threat than a bare fist, for example...\"")
SubClassOf(obo:ACTAN_0000457 obo:ACTAN_0000439)
SubClassOf(obo:ACTAN_0000457 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000553))

# Class: obo:ACTAN_0000458 (deception manipulation)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000458 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000458 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000458 "2024-11-17T21:05:10.599718Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasDefinition obo:ACTAN_0000458 "Manipulation that does not reveal a truthful correspondence with a state of motivation.

The evolution of checks on deception requires some time, so that over the long course of evolution there should be oscillations between deception and truthfulness. Small deceptions should persist longest. Ironically, the cleverest deceptions are in the long run the most ineffective, because they most quickly become common among competitors.")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasExactSynonym obo:ACTAN_0000458 "deception"@en)
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasExactSynonym obo:ACTAN_0000458 "poker face")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000458 "deception manipulation")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:example obo:ACTAN_0000458 "\"Some deceptions, e.g., mimicry of females by subordinant male sticklebacks who may thereby be able to sneak some eggs or fertilizations...\"")
SubClassOf(obo:ACTAN_0000458 obo:ACTAN_0000464)
SubClassOf(obo:ACTAN_0000458 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000001))

# Class: obo:ACTAN_0000459 (aggressive mimicry)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000459 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000459 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000459 "2024-11-17T21:05:35.008038Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") Annotation(skos:scopeNote "\"Aggressive mimicry, sometimes known as Peckhamian mimicry (after E.G. Peckham, who discovered it while studying spiders), is used to depict an animal or a part thereof that enables a predator to get closer to its prey or to attract its prey to within striking range.\"") oboInOwl:hasDefinition obo:ACTAN_0000459 "Mimicry which depicts an animal part that enables a predator to attract its prey to within striking range.")
AnnotationAssertion(Annotation(dc:date "2005"^^xsd:decimal) Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000459 "Peckhamian mimicry")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000459 "luring"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") Annotation(skos:scopeNote "\"Sazima... preferred not to regard lures from part of the body of predatory fishes as true examples of aggressive mimicry.\"") rdfs:comment obo:ACTAN_0000459 "For now we are including lures, but...")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "ISBN:9789798105975") rdfs:label obo:ACTAN_0000459 "aggressive mimicry"@en)
AnnotationAssertion(Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") skos:example obo:ACTAN_0000459 "\"...the slender lure from tissue inside the lower jaw of some of the stargazers (Uranoscopus) is enticingly wriggled like a worm from the mouth of an otherwise hidden stargazer.\"")
AnnotationAssertion(Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") skos:example obo:ACTAN_0000459 "\"Perhaps the best-known examples of aggressive mimicry are found in the frogfish family Antennariidae (and other ceratioids) that use a modified 1st dorsal ray as a lure called the illicium.\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:example obo:ACTAN_0000459 "\"The only other case involves one species of assassin bug (S. variegata), which holds termite corpses as lures for other termites); however, recent research has revealed that the feather-legged assassin bug (Ptilocnemus lemur) also uses a lure, though in this case it uses its own leg.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/tops.12554") skos:scopeNote obo:ACTAN_0000459 "\"A more recent suggestion is that the incipient rattle evolved as an improvement for the caudal luring of prey, a behavior exhibited by many pitvipers and a few colubrids.\"")
SubClassOf(obo:ACTAN_0000459 obo:ACTAN_0001010)
SubClassOf(obo:ACTAN_0000459 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000441))

# Class: obo:ACTAN_0000460 (thanatosis deception)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000460 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000460 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000460 "2024-11-17T21:06:06.146705Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.cub.2014.08.051") Annotation(skos:scopeNote "\"Thanatosis is characterised by a number of different features: catalepsy, immobility with a prone but stiff posture maintained by pronounced tonic muscular activity; ‘waxy flexibility’ of the limbs, which if moved by an external force maintain the newly imposed position for long periods; and unresponsiveness to external stimuli, while remaining fully aware of the environment.\"") oboInOwl:hasDefinition obo:ACTAN_0000460 "Deception that is characterised by immobility with a prone but stiff posture maintained by pronounced tonic muscular activity; limbs, which if moved by an external force maintain the newly imposed position for long periods; and unresponsiveness to external stimuli, while remaining fully aware of the environment.")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2014.08.051") oboInOwl:hasExactSynonym obo:ACTAN_0000460 "animal hypnosis")
AnnotationAssertion(Annotation(dc:date "2002"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000460 "death feigning"@en)
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2014.08.051") oboInOwl:hasExactSynonym obo:ACTAN_0000460 "playing possum")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2014.08.051") oboInOwl:hasExactSynonym obo:ACTAN_0000460 "thanatosis")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2014.08.051") oboInOwl:hasExactSynonym obo:ACTAN_0000460 "tonic immobility")
AnnotationAssertion(Annotation(dc:date "2014"^^xsd:decimal) Annotation(dc:source "doi:10.1016/j.cub.2014.08.051") oboInOwl:hasRelatedSynonym obo:ACTAN_0000460 "catatonia")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000460 "thanatosis deception")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000460 "NBO:0020199")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000460 "\"Apomorphic characters were the derived body throwing and tail hiding behavior of H. torquata, R. lecontei, and L. getula, the elevated tail coiling and wriggling of T. marcianus, and the ventral exposure of the head and body by D. punctatus (in death feigning behavior).\"")
AnnotationAssertion(Annotation(dc:source "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") skos:scopeNote obo:ACTAN_0000460 "\"Specialized and stereotyped antipredator behavior in snakes includes death feigning, envenomation, cloacal popping, cloacal sac discharge (musk), coiled tail displays, S-coil defensive postures, body balling and other tightly coiled defensive postures, tail vibration, mouth hissing, and dermal sound production.\"")
SubClassOf(obo:ACTAN_0000460 obo:ACTAN_0000458)
SubClassOf(obo:ACTAN_0000460 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000504))

# Class: obo:ACTAN_0000461 (crypsis deception)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000461 <https://github.com/Active-Animals/Ontology/patterns/context_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000461 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000461 "2024-11-17T21:06:41.398143Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://search.proquest.com/openview/163eedf011944cd2321739b51d33470d/1?pq-origsite=gscholar&cbl=18750&diss=y") Annotation(skos:scopeNote "\"Lastly, I call attention to the fact that all of these snakes rely first on crypsis, the avoidance of detection by predators as an antipredator strategy.\"") oboInOwl:hasDefinition obo:ACTAN_0000461 "Deception that avoids detection.")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.202.6.661") oboInOwl:hasExactSynonym obo:ACTAN_0000461 "crypsis"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000461 "crypsis deception")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:example obo:ACTAN_0000461 "\"These findings constitute the first study of reptile social buffering and add additional support to the growing evidence that rattlesnakes are cryptically social.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000461 "NBO:0020139")
SubClassOf(obo:ACTAN_0000461 obo:ACTAN_0000458)
SubClassOf(obo:ACTAN_0000461 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000464))

# Class: obo:ACTAN_0000462 (camouflaging resemblance)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000462 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000462 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000462 "2024-11-17T21:06:55.936712Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasDefinition obo:ACTAN_0000462 "Resemblance in which changed body colouration matches changed background lighting.")
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1089/zeb.2012.0861") oboInOwl:hasExactSynonym obo:ACTAN_0000462 "background adaptation")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000462 "camouflaging"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000462 "camouflaging resemblance")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000462 "\"Tilapia natalensis...
Vertical bands mostly appear when the fishes no longer feel at ease, for instance the appearance of individuals of other species. it is striking that just in those circumstances in which it might become necessary for the fish to hide itself, the vertical bands are developed, which undoubtedly make the fish less visible between plants because of their camouflaging effect.\"")
AnnotationAssertion(Annotation(dc:source "https://zoolstud.sinica.edu.tw/Journals/44.3/299.pdf") skos:example obo:ACTAN_0000462 "\"We immediately think of flatfishes that match the surrounding substratum and quickly change their pattern as they move over a different colored area...\"")
SubClassOf(obo:ACTAN_0000462 obo:ACTAN_0001009)
SubClassOf(obo:ACTAN_0000462 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000513))

# Class: obo:ACTAN_0000463 (cooperation interaction)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000463 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000463 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000463 "2024-11-17T21:07:21.633891Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.jstor.org/stable/986582") Annotation(skos:scopeNote "\"Thus the evolution of higher levels of social integration can be an \"emergent\" result of selection on competing individuals. As stated in more general terms by Alexander and Borgia (1977), \"To the extent that natural selection has produced coalitions of genetic units or individuals, whose numbers and cooperative interactions toward common interests enible them to deny success to subunits with conflicting interests or abilities to reproduce differentially, the coalitions themselves may be properly described as the units of selection.\"\"") oboInOwl:hasDefinition obo:ACTAN_0000463 "Interaction in which membership of a coalition toward common interests enables it to deny success to those with conflicting interests or abilities.")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasExactSynonym obo:ACTAN_0000463 "cooperative interaction"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000463 "cooperation interaction")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4161407") skos:example obo:ACTAN_0000463 "\"I saw 3 instances of cooperative hunting attack... The first observation, on 1 August 1977, involved 2 dark-phase jaegers and an immature female Pectoral Sandpiper (Calidris melanotos). When first seen, the jaegers were chasing the sandpiper in level flight. The jaegers pursued the sandpiper to a gravel road where it took refuge in the grass. The leading jaeger forced the sandpiper up, and after a quick series of alternate stoops by both jaegers, 1 caught the sandpiper in its bill, just above the grass. The jaeger carried the flapping sandpiper about 20 m, landed on the tundra and then placed the prey under its feet. The jaeger killed the victim by stabbing with its beak at the head and thorax region; both jaegers then plucked the sandpiper. Two min later, the first jaeger (the captor) picked up the sandpiper in its bill and allowed the second jaeger to tear bits of meat from the prey. After a few bites, the jaegers reversed roles and the first jaeger fed while the second jaeger held the sandpiper. After another 4 min and 2 more reversals, the jaegers had effectively divided up the catch.\"")
SubClassOf(obo:ACTAN_0000463 obo:ACTAN_0000383)
SubClassOf(obo:ACTAN_0000463 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000389))

# Class: obo:ACTAN_0000464 (manipulation influence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000464 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000464 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000464 "2024-11-17T21:07:57.163515Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/s10071-014-0761-0") oboInOwl:hasDefinition obo:ACTAN_0000464 "Influence that benefits an animal by managing another's actions.")
AnnotationAssertion(Annotation(dc:date "2025"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10988-025-09438-8") oboInOwl:hasExactSynonym obo:ACTAN_0000464 "coercion")
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10071-014-0761-0") oboInOwl:hasExactSynonym obo:ACTAN_0000464 "manipulation"@en)
AnnotationAssertion(Annotation(dc:date "2015"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10071-014-0761-0") oboInOwl:hasRelatedSynonym obo:ACTAN_0000464 "Machiavellian intelligence")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000464 "manipulation influence")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000464 "NBO:0020063")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2022.1066186") skos:scopeNote obo:ACTAN_0000464 "\"For some the ‘communication as information’ vs ‘communication as manipulation’ debate is largely one of semantics, for others communication involves both information and manipulation, and for others the debate raises some fundamental ideas about how communicative interactions actually influence behavior and shape interactions and relationships among individuals.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s10071-014-0761-0") skos:scopeNote obo:ACTAN_0000464 "\"There are also forms of social intelligence, for example where individuals deliberately manipulate the behaviour of others by deception or reconciliation (i.e. Machiavellian intelligence).\"")
SubClassOf(obo:ACTAN_0000464 obo:ACTAN_0000438)
SubClassOf(obo:ACTAN_0000464 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000270))

# Class: obo:ACTAN_0000465 (acceptance influence)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000465 <https://github.com/Active-Animals/Ontology/patterns/context_by_mental_process>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000465 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000465 "2024-11-17T21:08:50.341699Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1177/1745691610369469") Annotation(skos:scopeNote "\"These analyses are consistent with his suggestion that there are different domain-specific motivational systems for physiological needs, safety (self-protection) needs, esteem (status) needs, and belongingness (affiliation) needs.\"") oboInOwl:hasDefinition obo:ACTAN_0000465 "Influence that promotes a sense of belonging in another.")
AnnotationAssertion(Annotation(dc:date "1967"^^xsd:decimal) Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") oboInOwl:hasExactSynonym obo:ACTAN_0000465 "acceptance")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1537/ase.107.141") oboInOwl:hasExactSynonym obo:ACTAN_0000465 "affiliative relationship"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000465 "acceptance influence"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000465 obo:ACTAN_0000894)
AnnotationAssertion(Annotation(dc:source "https://open.uct.ac.za/handle/11427/13101") skos:example obo:ACTAN_0000465 "\"Ardeola ibis...
...it is disadvantageous for chicks to beg from adults indiscriminately; acceptance could result in inadequate feeding for all.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1537/ase.107.141") skos:example obo:ACTAN_0000465 "\"Chimpanzees...
Newly-immigrated females tend to choose, follow and form affiliative relationship with, one particular resident female by grooming her and caring for her infant.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000465 "NBO:0000281")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1181774") skos:scopeNote obo:ACTAN_0000465 "\"During maternal attendance, neonates may develop sex-specific affiliative behavior with their kin.\"")
SubClassOf(obo:ACTAN_0000465 obo:ACTAN_0000438)
SubClassOf(obo:ACTAN_0000465 ObjectSomeValuesFrom(obo:BFO_0000051 obo:MFOEM_000001))

# Class: obo:ACTAN_0000466 (kill constraint)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000466 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000466 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000466 "2024-11-17T21:09:05.925323Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1186/2041-1480-3-S2-S7") Annotation(skos:scopeNote "The definition is inferred from the original definition of behavior and an imported life cycle stage term.

It is not drawn from the source referenced here. The source is given in order to illustrate the difficulty of ontologically defining a behavioural endpoint in which an entity (the subject) no longer has its original identity (it is now an object) within the ontology.

This means I am also loathe to agree to 'dying' as a behaviour in this ontology.") oboInOwl:hasDefinition obo:ACTAN_0000466 "Constraint that causes another to enter its death stage.")
AnnotationAssertion(Annotation(dc:date "1987"^^xsd:decimal) Annotation(dc:source "doi:10.11369/jji1950.34.76") oboInOwl:hasExactSynonym obo:ACTAN_0000466 "kill")
AnnotationAssertion(Annotation(dc:date "1859"^^xsd:decimal) Annotation(dc:source "doi:10.5962/bhl.title.82303") oboInOwl:hasExactSynonym obo:ACTAN_0000466 "killing"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000466 "kill constraint"@en)
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000466 obo:UBERON_0000071)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000466 "NBO:0020018")
AnnotationAssertion(Annotation(dc:source "doi:10.5962/bhl.title.82303") skos:example obo:ACTAN_0000466 "\"In our own country the larger titmouse (Parus major) may be seen climbing branches, almost like a creeper; it often, like a shrike, kills small birds by blows on the head;\"")
AnnotationAssertion(Annotation(dc:source "doi:10.11369/jji1950.34.76") skos:example obo:ACTAN_0000466 "\"The four kills (two by Synodus ulae and two by Scorpaenopsis cirrhosa) were from short ambush attacks (2-10cm) on bobbing labrids that approached too close within the algae to the well camouflaged predators.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/4161407") skos:example obo:ACTAN_0000466 "\"The jaeger killed the victim by stabbing with its beak at the head and thorax region; both jaegers then plucked the sandpiper. Two min later, the first jaeger (the captor) picked up the sandpiper in its bill and allowed the second jaeger to tear bits of meat from the prey. After a few bites, the jaegers reversed roles and the first jaeger fed while the second jaeger held the sandpiper. After another 4 min and 2 more reversals, the jaegers had effectively divided up the catch.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.3389/fetho.2023.1231780") Annotation(rdfs:comment "2023"^^xsd:decimal) skos:scopeNote obo:ACTAN_0000466 "\"We recorded a kill when it was directly observed or when predator was found feeding on a fresh kill with no other predator species present. Fresh kills were identified by fresh blood and stomach contents, including blood on the carnivore’s face.\"")
SubClassOf(obo:ACTAN_0000466 obo:ACTAN_0000455)
SubClassOf(obo:ACTAN_0000466 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000096))

# Class: obo:ACTAN_0000467 (feigning deception)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000467 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000467 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000467 "2024-11-18T09:37:09.743743Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasDefinition obo:ACTAN_0000467 "Deception that dishonestly displays a readiness to attack.")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1111/brv.12891") oboInOwl:hasExactSynonym obo:ACTAN_0000467 "bluffing")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasExactSynonym obo:ACTAN_0000467 "feigning"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000467 "feigning deception")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000467 "NBO:0020031")
SubClassOf(obo:ACTAN_0000467 obo:ACTAN_0000458)
SubClassOf(obo:ACTAN_0000467 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000553))

# Class: obo:ACTAN_0000468 (probing movement)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000468 <https://github.com/Active-Animals/Ontology/patterns/movement>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000468 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000468 "2024-11-18T14:49:13.753688Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1080/01677063.2019.1586898") oboInOwl:hasDefinition obo:ACTAN_0000468 "Movement that uses an elongated object to detect the contents of a substrate.")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000468 "probe")
AnnotationAssertion(Annotation(dc:date "1957"^^xsd:decimal) Annotation(dc:source "https://digitalcommons.usf.edu/cgi/viewcontent.cgi?article=5800&context=wilson_bulletin") oboInOwl:hasExactSynonym obo:ACTAN_0000468 "probing"@en)
AnnotationAssertion(Annotation(dc:date "1984"^^xsd:decimal) Annotation(dc:source "https://scholarspace.manoa.hawaii.edu/bitstreams/68ddb3b7-6285-4bbf-935d-65630354bdba/download") oboInOwl:hasRelatedSynonym obo:ACTAN_0000468 "poke")
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000468 "probing movement")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/41.2.137") skos:example obo:ACTAN_0000468 "\"...parasitoid wasp species that... use their ovipositors to probe for prey...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/j.anbehav.2007.09.028") skos:example obo:ACTAN_0000468 "\"First, some dolphins wear marine sponges to protect their rostrums while probing for food on the ocean floor; some mother dolphins demonstrate to their female young how to use the sponges.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.13130/biancardi-carlo-massimo_phd2012-01-31") skos:example obo:ACTAN_0000468 "\"Grammostola mollicoma (Ausserer, 1875) (Araneae, Theraphosidae)...
This could be due to the unusual high trajectory of the first pair of feet, probably used also as helper “probes” to detect obstacles.\"")
SubClassOf(obo:ACTAN_0000468 obo:ACTAN_0000082)
SubClassOf(obo:ACTAN_0000468 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000624))

# Class: obo:ACTAN_0000469 (anchor kinetics)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000469 <https://github.com/Active-Animals/Ontology/patterns/kinetics>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000469 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000469 "2024-11-18T15:06:49.941201Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") oboInOwl:hasDefinition obo:ACTAN_0000469 "Kinetics that temporarily fixes an animal's position using an inflexibile component against the substrate.")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasExactSynonym obo:ACTAN_0000469 "anchor")
AnnotationAssertion(Annotation(dc:date "1961"^^xsd:decimal) Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") oboInOwl:hasRelatedSynonym obo:ACTAN_0000469 "fastening")
AnnotationAssertion(Annotation(dc:date "1999"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.202.6.661") oboInOwl:hasRelatedSynonym obo:ACTAN_0000469 "stance")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasRelatedSynonym obo:ACTAN_0000469 "wedge"@en)
AnnotationAssertion(Annotation(dc:source "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000469 "anchor kinetics")
AnnotationAssertion(Annotation(dc:source "http://www.nativefishlab.net/library/textpdf/15582.pdf") skos:scopeNote obo:ACTAN_0000469 "\"...the fish often contacted some firm object, as though using it as an anchor.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1744-7429.2000.tb00506.x") skos:scopeNote obo:ACTAN_0000469 "\"Concertina describes a snake using static points of contact with supports, either by progressing between branches in a series of cantilevers using the tail or hind body, or by wedging its posterior into surface irregularities with short-radius bends, extending its anterior to grasp more irregularities, then pulling up the posterior.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1365-3121.1991.tb00141.x") skos:scopeNote obo:ACTAN_0000469 "\"One part of the organism probes forward, while the rest acts as an anchor that prevents back-slippage.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1023/A:1005565304671") skos:scopeNote obo:ACTAN_0000469 "\"Using lateral stems as horizontal steps, the feet maintained their grasp on the liftoff stem, a lateral stem in this case, as the tail hooked around an even higher lateral stem. Anchored thus, the monkeys dropped downward while reaching with the forelimbs toward the target lateral stem.\"")
SubClassOf(obo:ACTAN_0000469 obo:ACTAN_0000147)
SubClassOf(obo:ACTAN_0000469 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0001545))

# Class: obo:ACTAN_0000470 (search mate-choice)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000470 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000470 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000470 "2024-11-18T16:56:34.977248Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasDefinition obo:ACTAN_0000470 "Mate-choice that attempts to find a potential partner.")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/41.2.137") oboInOwl:hasExactSynonym obo:ACTAN_0000470 "mate search"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...in search of a partner...\"") oboInOwl:hasExactSynonym obo:ACTAN_0000470 "partner search")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"...to find their way, their food or their partner;\"") oboInOwl:hasRelatedSynonym obo:ACTAN_0000470 "partner finding")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000470 "search mate-choice"@en)
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000470 "NBO:0020084")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:example obo:ACTAN_0000470 "\"We are inclined to believe that societies of courting males are easier for females to find than solitary courting males, scattered over the area. CHAPMAN (1935) expressed the same idea with regard to the courting territories of Manacus vitellinus...\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1534/genetics.120.303539") skos:example obo:ACTAN_0000470 "\"When male C. elegans animals are positioned on a bacterial food lawn without potential mating partners... there is a sharp increase in the probability of the animal persisting in a forward run when it encounters the edge of the bacterial food lawn...

Consistent with the notion that animals balance their mate search and food seeking, males that have been starved for three or more hours reduce their lawn-leaving rates.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853981X00220") skos:scopeNote obo:ACTAN_0000470 "\"It seems quite effective that the female possesses such a specific knowledge of the colours of the male, so that she will be able to distinguish her own species quickly from the other fishes she meets when wandering about in search of a partner.\"")
SubClassOf(obo:ACTAN_0000470 obo:ACTAN_0000450)
SubClassOf(obo:ACTAN_0000470 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000301))

# Class: obo:ACTAN_0000471 (mating breeding)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000471 <https://github.com/Active-Animals/Ontology/patterns/context_by_realization>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000471 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000471 "2024-11-18T16:57:55.327493Z")
AnnotationAssertion(Annotation(dc:date "1976"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1439-0310.1976.tb00970.x") oboInOwl:hasBroadSynonym obo:ACTAN_0000471 "sexual behavior")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1163/156853981X00220") Annotation(skos:scopeNote "\"From this we are inclined to believe that the disposition to secure a territory, together with the beginning of the development of the gonads and of the reproductive markings, are characteristics of a pre-mating phase that is concluded by the maturing of the gonads. But just as the reproductive markings are the same before and after the gonads have become mature, so the territorialism will also be the same in the pre-mating and mating phase.\"") oboInOwl:hasDefinition obo:ACTAN_0000471 "Breeding which involves gonad development, and a disposition to phased, characteristic behaviour.")
AnnotationAssertion(Annotation(dc:date "2006"^^xsd:decimal) Annotation(dc:source "doi:10.1093/auk/123.4.967") oboInOwl:hasExactSynonym obo:ACTAN_0000471 "courtship and mating")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000471 "mating"@en)
AnnotationAssertion(Annotation(dc:date "2013"^^xsd:decimal) Annotation(dc:source "doi:10.1086/BBLv224n3p166") oboInOwl:hasNarrowSynonym obo:ACTAN_0000471 "post-mating")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasNarrowSynonym obo:ACTAN_0000471 "pre-mating")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000471 "mating breeding"@en)
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:example obo:ACTAN_0000471 "\"Indeed, it is well known that the displays of courting males often consist of two elements—an aggressive component, presumably involved in the competition with other males which they are potentially disposed to attack; and an appeasement or \"sexual\" component, which is apparently important in \"attracting\" females (or, perhaps more accurately, in assuring them that they will not be attacked).\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000471 "NBO:0000010")
AnnotationAssertion(Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") skos:scopeNote obo:ACTAN_0000471 "\"The importance of non-morphological mating signals and behaviours is also well appreciated in vertebrates. Elaborate courtship behaviours – often involving visual cues – have been described for various groups of salamanders, mammals, birds and fishes while olfactory and tactile signals are particularly important for many mammal species and songs and calls for the mating behaviour of birds and anurans.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstor.org/stable/986582") skos:scopeNote obo:ACTAN_0000471 "\"This process of differential survival Darwin called \"natural selection.\" However, he observed a number of characters which seemed useless with respect to the \"struggle for existence\" in the environment, including especially the secondary sexual characters of males (particularly, in man), and showed with a massive collection of examples that such characters often come into play during mating competition—either in fighting or attracting females.\"")
SubClassOf(obo:ACTAN_0000471 obo:ACTAN_0000443)
SubClassOf(obo:ACTAN_0000471 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000543))

# Class: obo:ACTAN_0000472 (courtship mating)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000472 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000472 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000472 "2024-11-18T16:58:11.16345Z")
AnnotationAssertion(Annotation(dc:date "1998"^^xsd:decimal) Annotation(dc:source "doi:10.1016/S0169-5347(97)01318-9") oboInOwl:hasBroadSynonym obo:ACTAN_0000472 "bourgeois tactic")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "https://www.jstor.org/stable/986582") Annotation(skos:scopeNote "\"Indeed, it is well known that the displays of courting males often consist of two elements—an aggressive component, presumably involved in the competition with other males which they are potentially disposed to attack; and an appeasement or \"sexual\" component, which is apparently important in \"attracting\" females (or, perhaps more accurately, in assuring them that they will not be attacked).\"") oboInOwl:hasDefinition obo:ACTAN_0000472 "Mating which involves a degree of competitive, attractive, and appeasement components.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000472 "amorous maneuvers")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000472 "courting"@en)
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000472 "courtship")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000472 "love play")
AnnotationAssertion(Annotation(dc:date "2009"^^xsd:decimal) Annotation(dc:source "doi:10.1111/j.1420-9101.2009.01826.x") Annotation(skos:scopeNote "\"...mating signals...\"") oboInOwl:hasNarrowSynonym obo:ACTAN_0000472 "mating signaling")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasNarrowSynonym obo:ACTAN_0000472 "pre-spawning behavior")
AnnotationAssertion(Annotation(dc:date "2008"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s10682-007-9183-7") oboInOwl:hasNarrowSynonym obo:ACTAN_0000472 "premating courtship")
AnnotationAssertion(Annotation(dc:date "2010"^^xsd:decimal) Annotation(dc:source "doi:10.1007/s00265-010-0980-6") oboInOwl:hasRelatedSynonym obo:ACTAN_0000472 "mating effort")
AnnotationAssertion(Annotation(dc:date "1979"^^xsd:decimal) Annotation(dc:source "https://www.jstor.org/stable/986582") oboInOwl:hasRelatedSynonym obo:ACTAN_0000472 "sexual competition")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000472 "courtship mating")
AnnotationAssertion(rdfs:seeAlso obo:ACTAN_0000472 obo:ACTAN_0000389)
AnnotationAssertion(Annotation(dc:source "doi:10.1007/s00265-010-0980-6") skos:example obo:ACTAN_0000472 "\"Male bicolour damselfish, Stegastes partitus, for example, show higher courtship effort in the presence of larger, more fecund females, independent of the degree of predation risk; however, males do reduce courtship towards small females in the presence of predators.\"")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000472 "NBO:0000077")
AnnotationAssertion(Annotation(dc:source "doi:10.1002/bies.202000183") skos:scopeNote obo:ACTAN_0000472 "\"Contest and courtship behavior provide some of the clearest examples of high energy expenditure related to sexual selection. The aerobatic dives and high-energy courtship displays of hummingbirds appear to push males towards the limits of flight performance. Other examples include the vigorous courtship displays of swordtail fish, the energetically demanding drumming display of wolf spiders, the calling of frogs and tree-crickets and the vibratory courtship of treehoppers.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1016/S0169-5347(97)01318-9") skos:scopeNote obo:ACTAN_0000472 "\"The male tactic of procuring access to female gametes by monopolization has been called ‘bourgeois’... A bourgeois male invests in primary access to a resource (e.g. a spawning female) and behaves as the ‘owner’.\"")
SubClassOf(obo:ACTAN_0000472 obo:ACTAN_0000471)
SubClassOf(obo:ACTAN_0000472 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000438))

# Class: obo:ACTAN_0000473 (harassment coercion)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000473 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000473 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000473 "2024-11-18T16:58:26.004698Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1006/anbe.1995.0166") Annotation(skos:scopeNote "\"There are three main forms of sexual coercion: ... (2) harassment, where repeated attempts to copulate by males have costs to females which induce them to mate immediately;\"") oboInOwl:hasDefinition obo:ACTAN_0000473 "Coercion where repeated attempts to copulate have costs to mates which induce them to mate immediately.")
AnnotationAssertion(Annotation(dc:date "1995"^^xsd:decimal) Annotation(dc:source "doi:10.1006/anbe.1995.0166") oboInOwl:hasExactSynonym obo:ACTAN_0000473 "sexual harassment")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000473 "harassment coercion")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000473 "NBO:0020254")
AnnotationAssertion(Annotation(dc:source "doi:10.1006/anbe.1995.0166") skos:example obo:ACTAN_0000473 "\"Fallow bucks, Dama dama, for example, persistently court and attempt to mate with females that initially reject their advances.\"")
AnnotationAssertion(Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") skos:example obo:ACTAN_0000473 "\"Thalassoma cupido...
Rarely, pair spawning is not preceded by the typical courtship display. In these instances, the male vigorously chases the female. The chase terminates when the female abruptly ceases to flee, and spawning immediately follows.\"")
SubClassOf(obo:ACTAN_0000473 obo:ACTAN_0001019)
SubClassOf(obo:ACTAN_0000473 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0001017))

# Class: obo:ACTAN_0000474 (incubation caring)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000474 <https://github.com/Active-Animals/Ontology/patterns/context_composite>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000474 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000474 "2024-11-18T16:58:46.942199Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1371/journal.pone.0200048") oboInOwl:hasDefinition obo:ACTAN_0000474 "Caring that regulates development.")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasExactSynonym obo:ACTAN_0000474 "incubation"@en)
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000474 "incubation caring")
AnnotationAssertion(Annotation(dc:source "doi:10.1163/156853965x00138") skos:example obo:ACTAN_0000474 "\"At the time of changing position on the nest incubating Mallards have ten different movements which tend to occur in a certain sequence (e.g. preliminary preening and toying with nest-material, poking among the eggs with the bill, settling movements). A single heard-shake often occurs near the end of the egg-turning sequence, frequently as the final movement.\"")
AnnotationAssertion(skos:narrowMatch obo:ACTAN_0000474 "NBO:0000045")
AnnotationAssertion(Annotation(dc:source "doi:10.1371/journal.pone.0200048") skos:scopeNote obo:ACTAN_0000474 "\"The nest thermoregulation strategies of eusocial insects can be passive (e.g., nest orientation, architecture) or active (e.g., clustering, incubation), depending on the species.\"")
SubClassOf(obo:ACTAN_0000474 obo:ACTAN_0000479)
SubClassOf(obo:ACTAN_0000474 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000381))

# Class: obo:ACTAN_0000475 (spawning gamete-release)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000475 <https://github.com/Active-Animals/Ontology/patterns/context_by_activity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000475 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000475 "2024-11-18T16:59:00.442107Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1111/brv.12018") oboInOwl:hasDefinition obo:ACTAN_0000475 "Gamete-release that is external to at least one participant.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000475 "spawning"@en)
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "https://www.jstage.jst.go.jp/article/jji1950/24/2/24_2_101/_article/-char/ja/") oboInOwl:hasExactSynonym obo:ACTAN_0000475 "spawning act")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000475 "spawning gamete-release")
AnnotationAssertion(skos:closeMatch obo:ACTAN_0000475 "NBO:0020174")
AnnotationAssertion(Annotation(dc:source "doi:10.1089/zeb.2012.0861") skos:example obo:ACTAN_0000475 "\"During breeding, the male zebrafish approaches the female and curves body around, positioning his genital pore next to hers. The male then quivers in an attempt to trigger oviposition in the female; sperm is released simultaneously to fertilize the newly released eggs.\"")
SubClassOf(obo:ACTAN_0000475 obo:ACTAN_0000852)
SubClassOf(obo:ACTAN_0000475 ObjectSomeValuesFrom(obo:BFO_0000051 obo:ACTAN_0000715))

# Class: obo:ACTAN_0000476 (sperm spawning)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000476 <https://github.com/Active-Animals/Ontology/patterns/context_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000476 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000476 "2024-11-18T16:59:16.575278Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "https://search.proquest.com/openview/bc60659126ef5c0172c2392d485b0c9b/1?pq-origsite=gscholar&cbl=18750") oboInOwl:hasDefinition obo:ACTAN_0000476 "Spawning that releases male gametes.")
AnnotationAssertion(Annotation(dc:date "1950"^^xsd:decimal) Annotation(dc:source "doi:10.1163/156853981X00220") oboInOwl:hasExactSynonym obo:ACTAN_0000476 "fertilizing act")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1011074716758") oboInOwl:hasExactSynonym obo:ACTAN_0000476 "insemination")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1011074716758") oboInOwl:hasNarrowSynonym obo:ACTAN_0000476 "free-swimming sperm")
AnnotationAssertion(Annotation(dc:date "2001"^^xsd:decimal) Annotation(dc:source "doi:10.1023/A:1011074716758") oboInOwl:hasNarrowSynonym obo:ACTAN_0000476 "sperm trailing")
AnnotationAssertion(Annotation(dc:date "2011"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/bc60659126ef5c0172c2392d485b0c9b/1?pq-origsite=gscholar&cbl=18750") Annotation(skos:scopeNote "\"...spawning... sperm bundles...\"") rdfs:label obo:ACTAN_0000476 "sperm spawning"@en)
AnnotationAssertion(Annotation(dc:source "doi:10.1590/S1679-62252011005000018") skos:example obo:ACTAN_0000476 "\"...South American cichlid Laetacara araguaiae...

Thereafter, the male entered in the nest performing similar movements to those of the female, but with the body farther from the substrate, passing over of the oocytes, apparently releasing sperm.\"")
AnnotationAssertion(Annotation(dc:source "doi:10.1023/A:1011074716758") skos:example obo:ACTAN_0000476 "\"In gobiids, the accessory gland facilitates sperm to be laid down in a mucous rich ‘sperm trail’ on the spawning substrate allowing insemination to be asynchronous with egg laying and prolonged.\"")
SubClassOf(obo:ACTAN_0000476 obo:ACTAN_0000475)
SubClassOf(obo:ACTAN_0000476 ObjectSomeValuesFrom(obo:RO_0000057 obo:CL_0000019))

