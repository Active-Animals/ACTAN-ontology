# Class: obo:UBERON_0007113 (venom)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "MESH:A12.200.935") Annotation(oboInOwl:hasDbXref "Wikipedia:Venom") obo:IAO_0000115 obo:UBERON_0007113 "Poisonous animal secretions forming fluid mixtures of many different enzymes, toxins, and other substances. These substances are produced in specialized glands and secreted through specialized delivery systems (nematocysts, spines, fangs, etc.) for disabling prey or predator.")
AnnotationAssertion(obo:IAO_0000232 obo:UBERON_0007113 "Note we include a separate class for snake venom")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0007113 "BTO:0001439")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0007113 "MESH:D014688")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0007113 "Wikipedia:Venom")
