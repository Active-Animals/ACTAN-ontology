SubClassOf(obo:ACTAN_0000255 ObjectSomeValuesFrom(obo:BFO_0000055 obo:ACTAN_0000241))

# Class: obo:ACTAN_0000256 (climbing gait)

AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000256 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000256 "2024-10-06T10:07:00.111334Z")
AnnotationAssertion(Annotation(rdfs:isDefinedBy "doi:10.1007/BF02381373") Annotation(skos:scopeNote "\"L8. Vertical climb:
a. Flexed-elbow vertical climb: Ascent on supports angled at >= 45 degrees...
g. Rump-first descent: (1) Symmetrical rump-first descent: vertical quadrupedal descent of a support angled at >= 45 degrees; rather the kinematic reverse of ascent, but often with more abduction of the forelimb...\"") oboInOwl:hasDefinition obo:ACTAN_0000256 "Traversing-gait that involves supports angled at more than 45 degrees.")
AnnotationAssertion(Annotation(dc:date "1986"^^xsd:decimal) Annotation(dc:source "doi:10.1242/jeb.120.1.283") oboInOwl:hasExactSynonym obo:ACTAN_0000256 "climbing"@en)
AnnotationAssertion(Annotation(dc:date "1996"^^xsd:decimal) Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasNarrowSynonym obo:ACTAN_0000256 "vertical climb")
AnnotationAssertion(Annotation(dc:date "1926"^^xsd:decimal) Annotation(dc:source "doi:10.5962/p.203769") oboInOwl:hasRelatedSynonym obo:ACTAN_0000256 "scansorial power")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000256 "climbing gait")
AnnotationAssertion(skos:relatedMatch obo:ACTAN_0000256 "NBO:0000368")
SubClassOf(obo:ACTAN_0000256 obo:ACTAN_0000093)

# Class: obo:ACTAN_0000257 (cling crouch)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000257 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_entity>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000257 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000257 "2024-10-06T10:08:23.484867Z")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(dc:source "doi:10.1007/BF02381373") oboInOwl:hasDefinition obo:ACTAN_0000257 "Crouch that grasps the support with at least one flexed forelimb, which along with the flexed hindlimbs bears more than half the body weight.

Flexed limb posture most common on vertical-subvertical supports.")
AnnotationAssertion(Annotation(dc:date "1992"^^xsd:decimal) Annotation(dc:source "doi:10.1002/ajpa.1330870108") oboInOwl:hasExactSynonym obo:ACTAN_0000257 "cling"@en)
