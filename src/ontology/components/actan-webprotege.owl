# Class: obo:ACTAN_0000201 (canter-gallop gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000201 <https://github.com/Active-Animals/Ontology/patterns/sub_activity_by_quality>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000201 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000201 "2024-10-03T16:28:45.87049Z")
AnnotationAssertion(Annotation(dc:source "doi:10.1098/rspb.1998.0424") Annotation(rdfs:comment "\"The comparison between S and G leads to the observation that the canter stride can be considered to comprise two skipping strides, the first performed by the hind limbs and the second by the fore limbs, with about 25% of the stride period being out-of-phase between each other (at the overall illustrated speed)... Thus, cantering horses could be imitated by two humans performing (unilateral) S with 25% of the stride period being out-of-phase.\"") oboInOwl:hasDefinition obo:ACTAN_0000201 "Gallop gait that involves unilateral skips with 25% of the stride period being out-of-phase.

This has a triple beat.")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasExactSynonym obo:ACTAN_0000201 "canter"@en)
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.2307/1379571") oboInOwl:hasExactSynonym obo:ACTAN_0000201 "slow gallop")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000201 "canter-gallop gait")
SubClassOf(obo:ACTAN_0000201 obo:ACTAN_0000207)
SubClassOf(obo:ACTAN_0000201 ObjectSomeValuesFrom(obo:RO_0000086 obo:PATO_0000304))

# Class: obo:ACTAN_0000202 (amble gait)

AnnotationAssertion(terms:conformsTo obo:ACTAN_0000202 <https://github.com/Active-Animals/Ontology/patterns/gait>)
AnnotationAssertion(oboInOwl:created_by obo:ACTAN_0000202 "Ditch Townsend")
AnnotationAssertion(oboInOwl:creation_date obo:ACTAN_0000202 "2024-09-27T18:49:52.42546Z")
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasBroadSynonym obo:ACTAN_0000202 "accelerated walk")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3390/ani13162557") oboInOwl:hasBroadSynonym obo:ACTAN_0000202 "lateral sequence, ipsilateral couplet")
AnnotationAssertion(Annotation(dc:date "1980"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/20.1.255") oboInOwl:hasBroadSynonym obo:ACTAN_0000202 "lateral sequence, lateral couplet")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") Annotation(rdfs:comment "Compositional definition.") oboInOwl:hasDefinition obo:ACTAN_0000202 "Stepping gait that is ipsilateral-bipodal, bouncing and grounded.")
AnnotationAssertion(Annotation(dc:date "2004"^^xsd:decimal) Annotation(dc:source "https://search.proquest.com/openview/05e81709721939251e9f907889903460/1?pq-origsite=gscholar&cbl=18750&diss=y") oboInOwl:hasExactSynonym obo:ACTAN_0000202 "amble")
AnnotationAssertion(Annotation(dc:date "1977"^^xsd:decimal) Annotation(dc:source "doi:10.1152/ajpregu.1977.233.5.R243") oboInOwl:hasExactSynonym obo:ACTAN_0000202 "ambling"@en)
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(dc:source "doi:10.3390/ani13162557") oboInOwl:hasNarrowSynonym obo:ACTAN_0000202 "broken pace")
AnnotationAssertion(Annotation(dc:date "2023"^^xsd:decimal) Annotation(oboInOwl:hasExactSynonym "doi:10.3390/ani13162557") oboInOwl:hasNarrowSynonym obo:ACTAN_0000202 "stepping pace")
AnnotationAssertion(Annotation(dc:date "2022"^^xsd:decimal) Annotation(dc:source "doi:10.1093/icb/icac125") oboInOwl:hasNarrowSynonym obo:ACTAN_0000202 "walking pace")
AnnotationAssertion(Annotation(dc:contributor "https://orcid.org/0000-0002-4277-2151") rdfs:label obo:ACTAN_0000202 "amble gait")
AnnotationAssertion(Annotation(dc:source "doi:10.1093/icb/icac125") skos:scopeNote obo:ACTAN_0000202 "\"Duty factors in this pattern may be <0.5 and still lack an aerial phase in quadrupeds (amble) if the duty factors of the forelimbs and hindlimbs differ significantly.\"")
SubClassOf(obo:ACTAN_0000202 obo:ACTAN_0000124)
